# Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App credentials. Callback URL:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public repository used by Submit links and GitHub API reads.
NEXT_PUBLIC_GITHUB_REPOSITORY=josusanmartin/riemann

# Optional canonical deployment URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only E2B credential and pinned verifier template. After smoke testing,
# pin E2B_TEMPLATE_ID as riemann-fail-verifier:<build-id>. Never prefix these
# with NEXT_PUBLIC_ or pass them into an untrusted sandbox process.
E2B_API_KEY=
E2B_TEMPLATE_ID=
E2B_WEBHOOK_SECRET=

# Optional one-time bootstrap credential for /api/admin/e2b-template. Remove
# it from the deployed environment after the pinned template has been built.
E2B_TEMPLATE_ADMIN_SECRET=

# Daily Vercel cleanup/promotion backstop for a missed E2B webhook.
CRON_SECRET=

# Fine-grained token used for the opaque queue-control branch and, after a
# successful verification, public evidence. Restrict it to this repository and
# Contents: read and write.
GITHUB_RECORDS_TOKEN=
