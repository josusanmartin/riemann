# Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App credentials. Callback URL:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public repository used by Submit links and GitHub API reads.
NEXT_PUBLIC_GITHUB_REPOSITORY=josusanmartin/riemann

# Optional canonical deployment URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
