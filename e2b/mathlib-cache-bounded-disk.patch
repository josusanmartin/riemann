-
+  -- The E2B build filesystem is intentionally small. Once leantar has closed
+  -- a successful batch, its archives are redundant because the build outputs
+  -- are already present in the pinned package tree.
+  for (path, _) in files do
+    IO.FS.removeFile path
+  -- Riemann.fail elaborates proofs but never compiles Mathlib to native object
+  -- code. Generated C sources exceed the E2B image filesystem; retain Lean IR
+  -- because tactics execute through the interpreter during verification.
+  for (_, mod) in files do
+    if IO.isFromMathlib mod then
+      let modulePath := System.mkFilePath <| mod.components.map toString
+      for path in #[
+          mathlibDepPath / IO.IRDIR / modulePath.withExtension "c",
+          mathlibDepPath / IO.IRDIR / modulePath.withExtension "c.hash"] do
+        if ← path.pathExists then IO.FS.removeFile path
