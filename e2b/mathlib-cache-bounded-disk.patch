--- a/Cache/Requests.lean
+++ b/Cache/Requests.lean
@@ -492,6 +492,32 @@ def decompressBatch (files : Array (FilePath × Lean.Name))
       let preview := files.extract 0 3 |>.map (fun (p, m) => s!"{m} ({p})") |>.toList |> String.intercalate ", "
       s!"{preview}, ... and {files.size - 3} more"
     throw <| IO.userError s!"leantar exited with code {exitCode} on batch of {files.size} files: {firstFew}"
-
+  -- The E2B build filesystem is intentionally small. Once leantar has closed
+  -- a successful batch, its archives are redundant because the build outputs
+  -- are already present in the pinned package tree.
+  for (path, _) in files do
+    IO.FS.removeFile path
+  -- Riemann.fail elaborates proofs but never opens editor indexes or consumes
+  -- generated C. The public cache omits those files, although their trusted
+  -- hashes remain in the trace. Materialize zero-byte sentinels with the trace
+  -- hashes so Lake does not regenerate artifacts the verifier never reads.
+  for (_, mod) in files do
+    if IO.isFromMathlib mod then
+      let modulePath := System.mkFilePath <| mod.components.map toString
+      let tracePath := mathlibDepPath / IO.LIBDIR / modulePath.withExtension "trace"
+      let .ok trace := Lean.Json.parse (← IO.FS.readFile tracePath)
+        | throw <| IO.userError s!"Invalid trusted cache trace: {tracePath}"
+      let .ok outputs := trace.getObjValAs? Lean.Json "outputs"
+        | throw <| IO.userError s!"Missing outputs in trusted cache trace: {tracePath}"
+      for (path, field) in #[
+          (mathlibDepPath / IO.LIBDIR / modulePath.withExtension "ilean", "i"),
+          (mathlibDepPath / IO.IRDIR / modulePath.withExtension "c", "c")] do
+        let .ok outputName := outputs.getObjValAs? String field
+          | throw <| IO.userError s!"Missing {field} hash in trusted cache trace: {tracePath}"
+        let some hash := (System.FilePath.mk outputName).fileStem
+          | throw <| IO.userError s!"Invalid {field} hash in trusted cache trace: {tracePath}"
+        IO.FS.writeFile path ""
+        IO.FS.writeFile (path.addExtension "hash") hash
+
 /-- Configuration for decompression during download -/
