     (Nat.add (Nat.mul (Nat.sub 1024 m) (lo32 (f p))) (Nat.mul m (lo32 (f r)))) (Nat.beq k 3))
   (Nat.add (Nat.mul (Nat.sub 1024 m) (lb top bk L U)) (Nat.mul m (lo32 (f p)))) (Nat.beq k 2))
