lemma hasDerivAt_sinPoly (n : ℕ) (x : ℝ) :
    HasDerivAt (fun y : ℝ => sinPoly y n) (cosPoly x n) x := by
  induction n with
  | zero => exact hasDerivAt_const x (0 : ℝ)
