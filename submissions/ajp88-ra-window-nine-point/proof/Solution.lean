     AccEnc (farAcc n k XL XU (Nat.mul XL XL) (Nat.mul XU XU) L a) (S + DZ * fsum n k x L) := by
 intro L
 induction L with
 | nil => intro _ a S h; simpa [farAcc, fsum] using h
