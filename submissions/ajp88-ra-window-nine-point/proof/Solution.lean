      ((6720783611217598300222065098101767205468 / 10000000000000000000000000000000000000000 - B) / (1 - c) - ε) * (Z.N T (2 * T) : ℝ)
        ≤ (Z.N0s T (2 * T) : ℝ) := by
  intro ε hε
  set k : ℝ := ((n - 1 : ℕ) : ℝ) with hkdef
  have hk1 : (1 : ℝ) ≤ k := by
    rw [hkdef]; exact_mod_cast (by omega : 1 ≤ n - 1)
  have hk0 : 0 < k := by linarith
  have hmu : 0 < 1 - c := sub_pos.mpr hc1
  set C : ℝ := 4 * k + 2 + c + B with hCdef
