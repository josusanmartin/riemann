     = ∑ a : Fin n, ∑ b : Fin n,
         if (a : ℕ) < (b : ℕ) then W.a a b * wfun (Y (i + b) - Y (i + a)) else 0 := by
   refine sum_congr rfl fun a _ => sum_congr rfl fun b _ => ?_
   rw [ptsN_windowGaps, ptsN_windowGaps,
