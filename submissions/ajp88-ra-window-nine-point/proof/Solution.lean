       have : (c.AD : ℝ) / DZ ≤ (c.LLO : ℝ) / DZ := by rw [LLO_div, hAD]; exact hk
       exact_mod_cast (div_le_div_iff_of_pos_right hD).mp this
     have h2 : c.AD ≤ c.UHI := le_trans h1 (by
       have : (c.LLO : ℝ) / DZ ≤ (c.UHI : ℝ) / DZ := xlo.trans xhi
       exact_mod_cast (div_le_div_iff_of_pos_right hD).mp this)
