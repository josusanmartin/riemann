def vConvAM (r : ℝ) : ℝ := ∫ s in (-(1:ℝ)/2)..(1/2 - r), vAM s * vAM (s + r)
def aInf : ℝ := (∫ s in (-(1:ℝ)/2)..(1/2), vAM s) / MAM
