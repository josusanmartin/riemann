   have hsub : (T.filter (fun t => φ t = q)).image ψ
       ⊆ (univ ×ˢ univ).filter fun p : Fin n × Fin n =>
           (p.1 : ℕ) < (p.2 : ℕ) ∧ (p.2 : ℕ) - (p.1 : ℕ) = r := by
     intro p hp
     obtain ⟨t, ht, rfl⟩ := mem_image.mp hp
