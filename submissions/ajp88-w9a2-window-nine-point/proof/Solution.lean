    g u * cos (r * u)
  rw [e, Complex.re_ofReal_mul, Complex.exp_ofReal_mul_I_re]
private lemma VPhiR_eq_integral {v : ℝ → ℝ} {L w c : ℝ}
    (hW : AdmWindow v L w c) (r : ℝ) :
