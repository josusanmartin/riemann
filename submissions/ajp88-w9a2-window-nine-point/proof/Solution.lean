theorem cos_mul_cos_eq (a b t : ℝ) :
   Real.cos (a * t) * Real.cos (b * t) = (Real.cos ((a - b) * t) + Real.cos ((a + b) * t)) / 2 := by
 rw [sub_mul, add_mul, Real.cos_sub, Real.cos_add]; ring
