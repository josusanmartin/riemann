   · have hn : I.hi.v < 0 := by have := (SZ.nonneg_iff I.hi).not.mp (by simp [h]); linarith
     refine le_trans ?_ (div_le_div_of_nonneg_right (SZ.le_v_ce _ he1) hD.le)
