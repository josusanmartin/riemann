theorem vAM_le (s : ℝ) : vAM s ≤ 5 / 4 := by
 rw [vAM_eq]
 have h1 := Real.cos_le_one (Real.sqrt 2 * s)
 have h2 := (abs_le.mp (abs_pAM_le s)).2
