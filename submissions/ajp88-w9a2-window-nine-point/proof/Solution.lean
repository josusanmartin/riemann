   intro hL a S h
   obtain ⟨j, e, sg⟩ := t
   have hj : 1 ≤ j := hL _ (List.mem_cons_self ..)
   have h1 := farJ_enc hn hxl hxu h j e sg hj (hsep j hj).1 (hsep j hj).2
