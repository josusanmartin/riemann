      (∑ i, ∑ j, z i * z j * (L * AdmWindow.VPhiR v (γ i - γ j))) :=
    hasSum_sum fun i _ => hasSum_sum fun j _ =>
      (hW.hasSum_vHatR_mul T (γ i) (γ j)).mul_left (z i * z j)
