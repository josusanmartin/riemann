      Taper.phi_nonneg hP.taper _
    have ht1 : Taper.phi P.ϱ (P.L T) P.w (P.L T * s) ≤ 1 :=
      Taper.phi_le_one hP.taper _
    have hv : 0 ≤ AMW.vAM s := (by norm_num : (0 : ℝ) ≤ 681 / 1000).trans
      (AMW.vAM_ge_core hs)
