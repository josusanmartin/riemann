 intro r h1 h2
 simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h2]
theorem brec_dep {α : Sort _} {P : α → Prop} {a b : α} {c : Bool} (ha : c = false → P a) (hb : c = true → P b) :
   P (Bool.rec (motive := fun _ => α) a b c) := by cases c <;> simp_all
