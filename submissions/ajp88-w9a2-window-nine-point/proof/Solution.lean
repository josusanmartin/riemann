 have hD0 : 0 < DZ := by norm_num [DZ]
 have hc0 : 0 ≤ c := (div_nonneg hC0 hD.le).trans hC.1
 obtain ⟨hc1, hc2⟩ := hC; obtain ⟨ha1, ha2⟩ := hI
 have hc1' := (div_le_iff₀ hD).mp hc1; have hc2' := (le_div_iff₀ hD).mp hc2
