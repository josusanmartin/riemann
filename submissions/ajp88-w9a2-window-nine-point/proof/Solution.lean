   ∫ t in (-(1:ℝ)/2)..(1/2), Real.cos (2 * π * ((m : ℝ) + 1) * t) * Real.cos (2 * π * ((n : ℝ) + 1) * t)
     = if m = n then 1 / 2 else 0 := by
