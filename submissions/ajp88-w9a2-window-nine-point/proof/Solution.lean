   · have hn := (SZ.nonneg_iff I.lo).mp h
     refine (div_le_div_of_nonneg_right (SZ.v_fl_le _ he1) hD.le).trans ?_
     rw [SZ.v_muln, div_div, div_le_div_iff₀ (by positivity) hepos]
