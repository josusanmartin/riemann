lemma KMT_eq_integral (t : ℝ) :
    AMW.KMT t = ∫ s in (-(1 : ℝ) / 2)..(1 / 2),
      cos (sqrt 2 * s) * cos (2 * π * t * s) := by
  have hp : ∀ s : ℝ, cos (sqrt 2 * s) * cos (2 * π * t * s) =
      (cos ((sqrt 2 - 2 * π * t) * s) +
