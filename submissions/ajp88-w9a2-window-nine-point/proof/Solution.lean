    abs_of_pos (inv_pos.mpr hL), ← mul_assoc, mul_inv_cancel₀ hL.ne', one_mul]
theorem scaled_separated_bound (ι : Type) [Fintype ι] (y z : ι → ℝ)
    (w : ℝ → ℝ) (hsep : ∀ i j, i ≠ j → 17 / 20 ≤ |y i - y j|)
