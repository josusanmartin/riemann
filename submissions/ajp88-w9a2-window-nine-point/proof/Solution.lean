theorem forceT_eq {α : Sort _} (a : ℕ) (k : ℕ → α) : forceT a k = k a := by cases a <;> rfl
def gptF (L U jj : ℕ) : ℕ :=
 Bool.rec (motive := fun _ => ℕ)
   (forceR (Bool.rec (motive := fun _ => ℕ) 8 5 (Nat.beq (Nat.land (Nat.shiftRight jj 6) 1) 1)) fun gs =>
