   have e1 : (2 * π * ((m : ℝ) + 1) - 2 * π * ((n : ℝ) + 1)) / 2 = (((m : ℤ) - n : ℤ) : ℝ) * π := by
     push_cast; ring
   have e2 : (2 * π * ((m : ℝ) + 1) + 2 * π * ((n : ℝ) + 1)) / 2 = ((m + n + 2 : ℕ) : ℝ) * π := by
     push_cast; ring
   rw [e1, e2, Real.sin_int_mul_pi, Real.sin_nat_mul_pi]
   simp
