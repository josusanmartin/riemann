    have f2 := div_le_div_of_nonneg_right (le_ndivc (Nat.sub (cosP c.TLZ) (cosN c.TLZ)) CDEN (by norm_num [CDEN, DZ])) hD.le
    have a1 := (abs_le.mp hcu.1).1
