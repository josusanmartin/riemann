  obtain ⟨hr1, hr2, hr0⟩ := hrlo
  have tlo : (c.TLZ : ℝ) / DZ ≤ π * c.roff x := by
    unfold TLZ
    have h1 := ndiv_le (Nat.mul PLN c.RLO) E20 (by norm_num [E20])
    have e : ((Nat.mul PLN c.RLO : ℕ) : ℝ) = (PLN : ℝ) * c.RLO := by rw [Nat.mul_eq]; push_cast; ring
    rw [e] at h1
