    constructor
    · simp only [CI, SZ.v]; rw [sub_div]; linarith
    · simp only [CI, SZ.v, Nat.add_eq]; push_cast; rw [sub_zero, add_div]; linarith
  have hsi : c.SI.Enc (Real.sin (π * c.roff x)) := by
