/-- the expansion point of a gap from its 2-bit mode: the lower end, the upper end or the midpoint, each rounded to a
multiple of `2^8`, else of `16`, when that stays in `[l, u]` (any value is sound: the test checks `l ≤ q ≤ u`) -/
def dec (m l u : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ)
    (Bool.rec (motive := fun _ => ℕ)
      (forceR (Nat.shiftRight (Nat.add l u) 1) fun c =>
        forceR (Nat.shiftLeft (Nat.shiftRight c 8) 8) fun cc =>
          Bool.rec (motive := fun _ => ℕ)
            (forceR (Nat.shiftLeft (Nat.shiftRight c 4) 4) fun c2 => Bool.rec (motive := fun _ => ℕ) c c2 (Nat.ble l c2))
            cc (Nat.ble l cc))
      (forceR (Nat.shiftLeft (Nat.shiftRight u 8) 8) fun mm =>
        Bool.rec (motive := fun _ => ℕ)
          (forceR (Nat.shiftLeft (Nat.shiftRight u 4) 4) fun m2 => Bool.rec (motive := fun _ => ℕ) u m2 (Nat.ble l m2))
          mm (Nat.ble l mm))
      (Nat.beq m 1))
    (forceR (Nat.shiftLeft (Nat.shiftRight (Nat.add l 255) 8) 8) fun mm =>
      Bool.rec (motive := fun _ => ℕ)
        (forceR (Nat.shiftLeft (Nat.shiftRight (Nat.add l 15) 4) 4) fun m2 => Bool.rec (motive := fun _ => ℕ) l m2 (Nat.ble m2 u))
        mm (Nat.ble mm u))
    (Nat.beq m 0)

/-- a slope leaf: modes (bits 3..12), then a flag (bit 13: every term expanded) or the expansion set
(bits 14..) of the walk word `w` -/
def sleaf (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (C : ℕ) (w : ℕ) (l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : Bool :=
  forceB (dec (Nat.land (Nat.shiftRight w 3) 3) l0 u0) fun q0 =>
  forceB (dec (Nat.land (Nat.shiftRight w 5) 3) l1 u1) fun q1 =>
  forceB (dec (Nat.land (Nat.shiftRight w 7) 3) l2 u2) fun q2 =>
  forceB (dec (Nat.land (Nat.shiftRight w 9) 3) l3 u3) fun q3 =>
  forceB (dec (Nat.land (Nat.shiftRight w 11) 3) l4 u4) fun q4 =>
  forceB (Bool.rec (motive := fun _ => ℕ) (Nat.land (Nat.shiftRight w 14) 32767) 32767 (Nat.beq (Nat.land (Nat.shiftRight w 13) 1) 1)) fun T =>
  ctest top bk tD bD (pt3 pb) R l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 q0 q1 q2 q3 q4 T

/-- the expansion point of a gap at a centre leaf: coordinate `r` of the centre `k` (20-bit fields of `C`), clamped to
`[l, u]` rounded inward to multiples of `16` when that is nonempty, else to `[l, u]` -/
def cdec (C k r l u : ℕ) : ℕ :=
  forceR (Nat.land (Nat.shiftRight C (Nat.mul 20 (Nat.add (Nat.mul 6 k) r))) 1048575) fun c =>
  forceR (Nat.shiftLeft (Nat.shiftRight (Nat.add l 15) 4) 4) fun la =>
  forceR (Nat.shiftLeft (Nat.shiftRight u 4) 4) fun ua =>
  Bool.rec (motive := fun _ => ℕ)
    (Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) c u (Nat.ble u c)) l (Nat.ble c l))
    (Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) c ua (Nat.ble ua c)) la (Nat.ble c la))
    (Nat.ble la ua)

/-- a centre leaf: the centre index (bits 3..10), then a flag (bit 11: every term expanded) or the expansion set
(bits 12..) of the walk word `w` -/
def cleaf (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (C : ℕ) (w : ℕ) (l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : Bool :=
  forceB (Nat.land (Nat.shiftRight w 3) 255) fun k =>
  forceB (cdec C k 0 l0 u0) fun q0 =>
  forceB (cdec C k 1 l1 u1) fun q1 =>
  forceB (cdec C k 2 l2 u2) fun q2 =>
  forceB (cdec C k 3 l3 u3) fun q3 =>
  forceB (cdec C k 4 l4 u4) fun q4 =>
  forceB (Bool.rec (motive := fun _ => ℕ) (Nat.land (Nat.shiftRight w 12) 32767) 32767 (Nat.beq (Nat.land (Nat.shiftRight w 11) 1) 1)) fun T =>
  ctest top bk tD bD (pt3 pb) R l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 q0 q1 q2 q3 q4 T

/-- a basin box -/
structure Bx where
  (l0 u0 : ℕ) (l1 u1 : ℕ) (l2 u2 : ℕ) (l3 u3 : ℕ) (l4 u4 : ℕ)

/-- the box lies inside one of the basin boxes -/
def inBas (bas : List Bx) (l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : Bool :=
  bas.any fun b => Nat.ble b.l0 l0 && Nat.ble u0 b.u0 && Nat.ble b.l1 l1 && Nat.ble u1 b.u1 && Nat.ble b.l2 l2 && Nat.ble u2 b.u2 && Nat.ble b.l3 l3 && Nat.ble u3 b.u3 && Nat.ble b.l4 l4 && Nat.ble u4 b.u4

/-- the type of a walk continuation: position and the coordinates to the end position (`0` = failure) -/
abbrev WF : Type := ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ

/-- a split on gap 0: the lower half (`u0 := q`) from `pos + 4`, then the upper half from where it ends -/
def split0 (ih : WF) (pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add l0 u0) 1) fun q =>
  let p := ih (Nat.add pos 4) l0 q l1 u1 l2 u2 l3 u3 l4 u4
  Bool.rec (motive := fun _ => ℕ) (ih p q u0 l1 u1 l2 u2 l3 u3 l4 u4) (0) (Nat.beq p 0)

/-- a split on gap 1: the lower half (`u1 := q`) from `pos + 4`, then the upper half from where it ends -/
def split1 (ih : WF) (pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add l1 u1) 1) fun q =>
  let p := ih (Nat.add pos 4) l0 u0 l1 q l2 u2 l3 u3 l4 u4
  Bool.rec (motive := fun _ => ℕ) (ih p l0 u0 q u1 l2 u2 l3 u3 l4 u4) (0) (Nat.beq p 0)

/-- a split on gap 2: the lower half (`u2 := q`) from `pos + 4`, then the upper half from where it ends -/
def split2 (ih : WF) (pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add l2 u2) 1) fun q =>
  let p := ih (Nat.add pos 4) l0 u0 l1 u1 l2 q l3 u3 l4 u4
  Bool.rec (motive := fun _ => ℕ) (ih p l0 u0 l1 u1 q u2 l3 u3 l4 u4) (0) (Nat.beq p 0)

/-- a split on gap 3: the lower half (`u3 := q`) from `pos + 4`, then the upper half from where it ends -/
def split3 (ih : WF) (pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add l3 u3) 1) fun q =>
  let p := ih (Nat.add pos 4) l0 u0 l1 u1 l2 u2 l3 q l4 u4
  Bool.rec (motive := fun _ => ℕ) (ih p l0 u0 l1 u1 l2 u2 q u3 l4 u4) (0) (Nat.beq p 0)

/-- a split on gap 4: the lower half (`u4 := q`) from `pos + 4`, then the upper half from where it ends -/
def split4 (ih : WF) (pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : ℕ :=
  forceR (Nat.shiftRight (Nat.add l4 u4) 1) fun q =>
  let p := ih (Nat.add pos 4) l0 u0 l1 u1 l2 u2 l3 u3 l4 q
  Bool.rec (motive := fun _ => ℕ) (ih p l0 u0 l1 u1 l2 u2 l3 u3 q u4) (0) (Nat.beq p 0)

/-- a split node: the axis selects the gap -/
def splitAx (ih : WF) (pos ax l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) (split4 ih pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4) (split3 ih pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4) (Nat.beq ax 3)) (split2 ih pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4) (Nat.beq ax 2)) (split1 ih pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4) (Nat.beq ax 1)) (split0 ih pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4) (Nat.beq ax 0)

/-- a leaf (bit 0 clear; bits 1..2 the kind: zero-order, slope with its payload, basin): in the reflected half-space, or
the leaf's own test -/
def leafStep (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (C : ℕ) (bas : List Bx) (pos w l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) (0) (Bool.rec (motive := fun _ => ℕ) (Nat.add pos 27) (Nat.add pos 12) (Nat.beq (Nat.land (Nat.shiftRight w 11) 1) 1)) (cleaf top bk tD bD pb R C w l0 u0 l1 u1 l2 u2 l3 u3 l4 u4)) (Bool.rec (motive := fun _ => ℕ) (0) (Nat.add pos 3) (inBas bas l0 u0 l1 u1 l2 u2 l3 u3 l4 u4)) (Nat.beq (Nat.land (Nat.shiftRight w 1) 3) 2)) (Bool.rec (motive := fun _ => ℕ) (0) (Bool.rec (motive := fun _ => ℕ) (Nat.add pos 29) (Nat.add pos 14) (Nat.beq (Nat.land (Nat.shiftRight w 13) 1) 1)) (sleaf top bk tD bD pb R C w l0 u0 l1 u1 l2 u2 l3 u3 l4 u4)) (Nat.beq (Nat.land (Nat.shiftRight w 1) 3) 1)) (Bool.rec (motive := fun _ => ℕ) (0) (Nat.add pos 3) (leafOK top bk l0 u0 l1 u1 l2 u2 l3 u3 l4 u4)) (Nat.beq (Nat.land (Nat.shiftRight w 1) 3) 0)) (Nat.add pos 3) (Nat.ble (Nat.add u4 1) l0)

/-- the bisection walk (`Nat.rec` on the fuel): the node word is `bits >>> pos` (bit 0 split, bits 1..3 axis) -/
def walk (top : ℕ) (bk : ℕ → ℕ) (tD : ℕ) (bD : ℕ → ℕ) (pb : ℕ → ℕ) (R : ℕ × ℕ × List (List ℕ)) (C : ℕ) (bas : List Bx) (bits : ℕ) (fuel : ℕ) : WF :=
  Nat.rec (motive := fun _ => WF) (fun _ _ _ _ _ _ _ _ _ _ _ => 0)
    (fun _ ih pos l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 =>
      let w := Nat.shiftRight bits pos
      Bool.rec (motive := fun _ => ℕ) (leafStep top bk tD bD pb R C bas pos w l0 u0 l1 u1 l2 u2 l3 u3 l4 u4) (splitAx ih pos (Nat.land (Nat.shiftRight w 1) 7) l0 u0 l1 u1 l2 u2 l3 u3 l4 u4) (Nat.beq (Nat.land w 1) 1))
    fuel

/-- the box `[l_r, u_r] / SC` satisfies the certificate inequality (or lies in the reflected half-space) -/
def Covered (l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 : ℕ) : Prop :=
  ∀ g0 g1 g2 g3 g4 : ℝ, (l0 : ℝ) / SC ≤ g0 → g0 ≤ (u0 : ℝ) / SC → (l1 : ℝ) / SC ≤ g1 → g1 ≤ (u1 : ℝ) / SC → (l2 : ℝ) / SC ≤ g2 → g2 ≤ (u2 : ℝ) / SC → (l3 : ℝ) / SC ≤ g3 → g3 ≤ (u3 : ℝ) / SC → (l4 : ℝ) / SC ≤ g4 → g4 ≤ (u4 : ℝ) / SC → (cN : ℝ) / SA ≤ G g0 g1 g2 g3 g4 ∨ g4 < g0

theorem ee_or {C s : ℕ} {rest : Bool} (h : ee C s rest = true) : C ≤ s ∨ rest = true := by
  unfold ee at h
  cases hc : Nat.ble C s
  · rw [hc] at h; exact Or.inr h
  · exact Or.inl (by rw [← Nat.ble_eq, hc])

