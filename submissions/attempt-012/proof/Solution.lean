  · rw [gamAM, div_le_iff₀ hspos]; nlinarith [hprodu, hs.1]

theorem rhoAM_eq : rhoAM = (Real.sqrt 2 / 2) / Real.sin (Real.sqrt 2 / 2) := by
  have hs : Real.sin (Real.sqrt 2 / 2) ≠ 0 := by linarith [sin_sqrt2_half_bounds'.1]
