def scP (T : ℕ) : ℕ := Nat.add (Nat.add (Nat.mul 39916800 (DZp 10)) (Nat.mul (Nat.mul 332640 (Nat.pow T 4)) (DZp 6))) (Nat.mul (Nat.mul 110 (Nat.pow T 8)) (DZp 2))
