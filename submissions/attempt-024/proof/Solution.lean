   have hsl := sum_lo hg.1 (pI PR k) (pJ PR k - pI PR k) (by omega)
   have hsu := sum_hi hg.1 (pI PR k) (pJ PR k - pI PR k) (by omega)
   rw [hn] at hsl hsu
   exact ⟨lo_nmax (hg.2 k hk).1 hsl, hi_nmin (hg.2 k hk).2 hsu⟩
