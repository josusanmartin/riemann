      * (max (sep - |t|) 0 * cos (π * t) + sin (π * max (sep - |t|) 0) / π) :=
    continuous_const.mul ((hm.mul (by fun_prop)).add
      ((continuous_sin.comp (continuous_const.mul hm)).div_const π))
