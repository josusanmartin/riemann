   exact (by exact_mod_cast h1 : sumR _ 0 Q ≤ Q * KB).trans hW
 · simp only [rootCl]; rw [getD_map_range _ hr, getD_map_range _ hr]
   exact ⟨(hidx r hr).2.1, (hidx r hr).2.2.1⟩
end AMW.Cert.PCell
