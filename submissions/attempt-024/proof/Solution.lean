   · have hn := (SZ.nonneg_iff I.hi).mp h
     refine le_trans ?_ (div_le_div_of_nonneg_right (SZ.le_v_ce _ he0) hD.le)
     rw [SZ.v_muln, div_div, div_le_div_iff₀ hepos (by positivity)]
