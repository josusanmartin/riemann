       have hLN : (⟨a * KB + b, 0⟩ : CellN).LN = a := by
         simp only [CellN.LN]; rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by norm_num [KB]), Nat.div_eq_of_lt hbK, Nat.zero_add]
       have hUN : (⟨a * KB + b, 0⟩ : CellN).UN = b := by
