 constructor
 · cases h : I.lo.nonneg <;> simp only
   · have hn : I.lo.v < 0 := by have := (SZ.nonneg_iff I.lo).not.mp (by simp [h]); linarith
     refine (div_le_div_of_nonneg_right (SZ.v_fl_le _ he0) hD.le).trans ?_
