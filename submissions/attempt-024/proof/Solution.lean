 rcases hk' with hempty | ⟨⟨⟨hlen, hch⟩, hlast⟩⟩
 · omega
 · set c := R.2.2.getD k [] with hc
   have hne : c ≠ [] := by intro h0; rw [h0] at hlen; simp at hlen
   exact chainOk_sound c _ hch hne x hx1 (by rw [hlast]; exact hx2)
