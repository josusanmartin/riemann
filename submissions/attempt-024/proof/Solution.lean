       have hm2 : (aAdj : ℝ) * (((⟨a * KB + b, 0⟩ : CellN).WZ : ℝ) / SW) ≤ (aAdj : ℝ) * wfun v :=
         mul_le_mul_of_nonneg_left hW (by positivity)
