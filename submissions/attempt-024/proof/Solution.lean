     ((badOf (cov.getD r [])).getD i (0, 0)).2 < KB := by
   intro r hr
   obtain ⟨hn, hi, hj⟩ := hadj r hr
   have hsr : gsum g (tI TS (adj r)) (tJ TS (adj r)) = g r := by rw [hi, hj, gsum]; simp
   have hterm := Fg_ge_term (bs := bs) hg hn
