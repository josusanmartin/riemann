      = y * (1 - y ^ 2 / 6 + y ^ 4 / 120) := by
    rw [Meshuggah.Majorant.sinPoly_succ, Meshuggah.Majorant.sinPoly_succ,
      Meshuggah.Majorant.sinPoly_succ, Meshuggah.Majorant.sinPoly_zero]
    norm_num [Nat.factorial]
