   have := mul_le_mul hsk hsk hs0 (hs0.trans hsk)
   rw [show |k1AM x| * DZ * (|k1AM x| * DZ) = |k1AM x| ^ 2 * DZ ^ 2 by ring, sq_abs] at this; exact this
