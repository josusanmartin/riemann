open Real
namespace AMW.G
theorem near_enc {P N : ℕ → ℕ} {Pr Nr f : ℝ → ℝ} {DEN E : ℕ} (hDEN : 0 < DEN)
   (hP : ∀ T : ℕ, (P T : ℝ) / DEN = DZ * Pr ((T : ℝ) / DZ)) (hN : ∀ T : ℕ, (N T : ℝ) / DEN = DZ * Nr ((T : ℝ) / DZ))
   (hPm : ∀ u v : ℝ, 0 ≤ u → u ≤ v → Pr u ≤ Pr v) (hNm : ∀ u v : ℝ, 0 ≤ u → u ≤ v → Nr u ≤ Nr v)
