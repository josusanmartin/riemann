   (hg : ∀ᶠ T in atTop, 0 ≤ g (P.toSetting T) (lfW P W T)) :
   EvBound (fun T => f (P.toSetting T) (lfW P W T)) (fun T => g (P.toSetting T) (lfW P W T)) := by
