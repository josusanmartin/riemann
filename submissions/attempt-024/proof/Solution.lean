 have h := IV.enc_add h1 (IV.enc_add h2 h3)
 unfold K0 SF0
 convert h using 1
 rw [kfunAM_eq hD.ne, sum_T0 hx0 (c.sepx hc hx1 hx2)]
 have hE : 2 * (π * x) ^ 2 - 1 = -mD x := by unfold mD; ring
 rw [hE]
