theorem kernel_limit_uniform (Z : ZeroConfig) :
    ∀ δ > 0, ∀ᶠ T in atTop, ∀ z z' : retained Z (mtParams T) T,
      ‖gram Z (mtParams T) T z z' -
        (Zeta23Ext.Bridge.kfun
          (xret Z (mtParams T) T z - xret Z (mtParams T) T z') : ℂ)‖ ≤ δ := by
