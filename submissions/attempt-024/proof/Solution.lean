theorem rg_conv {R : ℕ × ℕ × List (List ℕ)} (hR : rgOk R = true) {k : ℕ} (hk : k < 16) (hab : rgA R k ≤ rgB R k) :
   ∀ x : ℝ, ((rgA R k : ℕ) : ℝ) / SC ≤ x → x ≤ ((rgB R k : ℕ) : ℝ) / SC → kD x < 0 ∧ 0 ≤ w2 x := by
