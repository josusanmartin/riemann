 rcases le_total M 2000000000 with h | h
 · rw [Nat.sub_eq_zero_of_le h, Nat.cast_sub h]; push_cast; ring
 · rw [Nat.sub_eq_zero_of_le h, Nat.cast_sub h]; push_cast; ring
