def coverChk (cN aAdj : ℕ) : ℕ → ℕ → List (ℕ × ℕ × Bool) → Bool
 | pos, S, [] => decide (S ≤ pos)
 | pos, S, (a, b, cl) :: rest =>
     decide (a = pos) && decide (a ≤ b) && decide (b < KB)
       && (!cl || Nat.ble (cN * SW) (aAdj * CellN.WZ ⟨a * KB + b, 0⟩))
       && coverChk cN aAdj b S rest
def badOf (cover : List (ℕ × ℕ × Bool)) : List (ℕ × ℕ) :=
