theorem cellN_soundWZ (c : CellN) (x : ℝ) (hx1 : (c.LN : ℝ) / SC ≤ x) (hx2 : x ≤ (c.UN : ℝ) / SC) :
   (c.WZ : ℝ) / SW ≤ wfun x := by
