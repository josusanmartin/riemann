   ext r; simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_Ico]; omega
 rw [hf, Finset.sum_sub_distrib, ← Finset.sum_div, gsum, eL0, sumR_eq, show tI TS n + (tJ TS n - tI TS n) = tJ TS n by omega]
