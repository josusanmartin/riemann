 · have h : a.p < a.n := not_le.mp fun hle => by simp [Nat.ble_eq.mpr hle] at h
   have h1 := ndiv_le (Nat.sub a.n a.p) d hd
   have e : ((Nat.sub a.n a.p : ℕ) : ℝ) = (a.n : ℝ) - a.p := by
