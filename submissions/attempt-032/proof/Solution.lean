set_option maxHeartbeats 4000000
noncomputable section

namespace AMW.G.CellA
open AMW.G

theorem w2_lower (c : CellA) (hc : c.ok = true)
    (hE2 : 0 < c.E2L) (hE3 : 0 < c.E3L) {x : ℝ}
    (hx1 : (c.LN : ℝ) / SC ≤ x) (hx2 : x ≤ (c.UN : ℝ) / SC) :
    2 * c.W2L.v / (DZ : ℝ) ^ 2 ≤ AMW.w2AM x := by
  have hD := DZ_pos
  have hK1 := c.K1_enc hc hE2 hx1 hx2
  have hKK := IV.enc_mul (c.K0_enc hc hx1 hx2)
    (c.K2_enc hc hE2 hE3 hx1 hx2)
  have hs0 := mabs_nonneg c.K1
  have hsk := mabs_le hK1
  have hsq : (mabs c.K1).v * (mabs c.K1).v
      ≤ AMW.k1AM x ^ 2 * (DZ : ℝ) ^ 2 := by
    have h := mul_le_mul hsk hsk hs0 (hs0.trans hsk)
    rw [show |AMW.k1AM x| * DZ * (|AMW.k1AM x| * DZ)
      = |AMW.k1AM x| ^ 2 * (DZ : ℝ) ^ 2 by ring, sq_abs] at h
    exact h
  have hq : (c.K0.mul c.K2).lo.v ≤
      (AMW.kfunAM x * AMW.k2AM x) * DZ :=
    (div_le_iff₀ hD).mp hKK.1
  have hkk : (c.K0.mul c.K2).lo.v * DZ ≤
      (AMW.kfunAM x * AMW.k2AM x) * (DZ : ℝ) ^ 2 := by
    have h := mul_le_mul_of_nonneg_right hq hD.le
    nlinarith only [h]
  have hD2 : (0 : ℝ) < (DZ : ℝ) ^ 2 := pow_pos DZ_pos 2
  rw [W2L_eq, SZ.v_add, SZ.v_mul, SZ.v_muln]
  apply (div_le_iff₀ hD2).2
  unfold AMW.w2AM
  nlinarith only [hsq, hkk]

/-- Entirely integer certificate of the rational lower curvature n/den.
The signed numerator is compared without truncated Nat subtraction. -/
def curvatureOk (c : CellA) (n den : ℕ) : Bool :=
  Nat.blt 0 den && c.ok && Nat.blt 0 c.E2L && Nat.blt 0 c.E3L &&
    Nat.ble (n * DZ ^ 2 + 2 * den * c.W2L.n) (2 * den * c.W2L.p)

theorem curvatureOk_sound (c : CellA) (n den : ℕ)
    (h : c.curvatureOk n den = true) {x : ℝ}
    (hx1 : (c.LN : ℝ) / SC ≤ x) (hx2 : x ≤ (c.UN : ℝ) / SC) :
    (n : ℝ) / den ≤ AMW.w2AM x := by
  simp only [curvatureOk, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq] at h
  obtain ⟨⟨⟨⟨hden, hc⟩, hE2⟩, hE3⟩, hnum⟩ := h
  have hd : (0 : ℝ) < den := by exact_mod_cast hden
  have hD2 : (0 : ℝ) < (DZ : ℝ) ^ 2 := pow_pos DZ_pos 2
  have hr := (Nat.cast_le (α := ℝ)).mpr hnum
  push_cast at hr
  have hq : (n : ℝ) / den ≤ 2 * c.W2L.v / (DZ : ℝ) ^ 2 := by
    apply (div_le_div_iff₀ hd hD2).2
    unfold SZ.v
    nlinarith only [hr]
  exact hq.trans (c.w2_lower hc hE2 hE3 hx1 hx2)

/-- The two cells are reused verbatim from REG; no new enclosure search. -/

def curvatureChain (n den : ℕ) : ℕ → List ℕ → Bool
  | _, [] => true
  | a, b :: r => Nat.ble a b && (CellA.mk a b).curvatureOk n den &&
      curvatureChain n den b r

def curvatureLast : ℕ → List ℕ → ℕ
  | a, [] => a
  | _, b :: r => curvatureLast b r

theorem curvatureChain_sound (n den : ℕ) : ∀ (l : List ℕ) (a : ℕ),
    curvatureChain n den a l = true → l ≠ [] →
    ∀ x : ℝ, (a : ℝ) / SC ≤ x → x ≤ (curvatureLast a l : ℝ) / SC →
      (n : ℝ) / den ≤ AMW.w2AM x := by
  intro l
  induction l with
  | nil => intro a _ h; exact absurd rfl h
  | cons b r ih =>
    intro a h _ x hx1 hx2
    have h' : (Nat.ble a b && (CellA.mk a b).curvatureOk n den &&
        curvatureChain n den b r) = true := h
    simp only [Bool.and_eq_true, Nat.ble_eq] at h'
    obtain ⟨⟨_, hcv⟩, hr⟩ := h'
    rcases le_or_gt x ((b : ℝ) / SC) with hxb | hxb
    · exact curvatureOk_sound (CellA.mk a b) n den hcv hx1 hxb
    · cases r with
      | nil =>
        have e : curvatureLast a [b] = b := rfl
        rw [e] at hx2
        linarith
      | cons c r' =>
        have e : curvatureLast a (b :: c :: r') = curvatureLast b (c :: r') := rfl
        rw [e] at hx2
        exact ih b hr (List.cons_ne_nil c r') x hxb.le hx2


end AMW.G.CellA

namespace AMW.Cert.PCell.Var
open AMW.Cert AMW.Cert.Pyr AMW.Cert.PyrD AMW.Cert.PCell

theorem supporting_parabola
    {w v d : ℝ → ℝ} {a b p x lam : ℝ}
    (hw : ∀ t, HasDerivAt w (v t) t)
    (hv : ∀ t, HasDerivAt v (d t) t)
    (hd : ∀ t ∈ Set.Icc a b, lam ≤ d t)
    (hp : p ∈ Set.Icc a b) (hx : x ∈ Set.Icc a b) :
    w p + v p * (x - p) + (lam / 2) * (x - p) ^ 2 ≤ w x := by
  let f : ℝ → ℝ := fun t => w t - (lam / 2) * t ^ 2
  have hf : ∀ t, HasDerivAt f (v t - lam * t) t := by
    intro t
    dsimp only [f]
    convert! (hw t).sub
      (((hasDerivAt_id' t).pow 2).const_mul (lam / 2)) using 1 <;>
      ring
  have hf' : ∀ t,
      HasDerivAt (fun t => v t - lam * t) (d t - lam) t := by
    intro t
    convert! (hv t).sub ((hasDerivAt_id' t).const_mul lam) using 1 <;>
      simp [Pi.sub_apply]
  have hc : ConvexOn ℝ (Set.Icc a b) f :=
    convexOn_of_hasDerivWithinAt2_nonneg
      (f' := fun t => v t - lam * t)
      (f'' := fun t => d t - lam)
      (convex_Icc a b)
      (fun t _ => (hf t).continuousAt.continuousWithinAt)
      (fun t _ => (hf t).hasDerivWithinAt)
      (fun t _ => (hf' t).hasDerivWithinAt)
      (fun t ht => sub_nonneg.mpr (hd t (interior_subset ht)))
  rcases lt_trichotomy p x with hpx | hpx | hxp
  · have hs := hc.le_slope_of_hasDerivAt hp hx hpx (hf p)
    rw [slope_def_field] at hs
    have hh := (le_div_iff₀ (sub_pos.mpr hpx)).mp hs
    dsimp [f] at hh
    nlinarith only [hh]
  · subst x
    simp
  · have hs := hc.slope_le_of_hasDerivAt hx hp hxp (hf p)
    rw [slope_def_field] at hs
    have hh := (div_le_iff₀ (sub_pos.mpr hxp)).mp hs
    dsimp [f] at hh
    nlinarith only [hh]


theorem TVal_curved {f : ℕ → ℕ} {L U p : ℕ} {s a b lam : ℝ}
    (htv : TVal f L U p)
    (hcurv : ∀ t ∈ Set.Icc a b, lam ≤ AMW.w2AM t)
    (hp : (p : ℝ) / SC ∈ Set.Icc a b) (hs : s ∈ Set.Icc a b) :
    (lo32 (f p) : ℝ) / 10000000000
      + w1 ((p : ℝ) / SC) * (s - (p : ℝ) / SC)
      + (lam / 2) * (s - (p : ℝ) / SC) ^ 2 ≤ wfun s := by
  have hSC := SC_pos
  have hv := htv.2.2.2.2 ((p : ℝ) / SC)
    (div_le_div_of_nonneg_right (by exact_mod_cast htv.1) hSC.le)
    (div_le_div_of_nonneg_right (by exact_mod_cast htv.2.1) hSC.le)
  simp only [sub_self, mul_zero, add_zero] at hv
  have ht := supporting_parabola AMW.hasDerivAt_wfunAM
    AMW.hasDerivAt_w1AM hcurv hp hs
  change (lo32 (f p) : ℝ) / 10000000000 ≤ AMW.wfunAM ((p : ℝ) / SC) at hv
  change (lo32 (f p) : ℝ) / 10000000000
    + AMW.w1AM ((p : ℝ) / SC) * (s - (p : ℝ) / SC)
    + (lam / 2) * (s - (p : ℝ) / SC) ^ 2 ≤ AMW.wfunAM s
  linarith only [hv, ht]


theorem mterm_minV_curved {top : ℕ} {bk : ℕ → ℕ} {f : ℕ → ℕ} (hlb : LBSound top bk)
   (L0 L U Uc lc l1 l2 p1 p2 : ℕ) (hL0 : L0 ≤ L) (hUc : U ≤ Uc) (hsum : lc + l1 + l2 = 1024)
   (h1 : l1 = 0 ∨ TVal f L U p1) (h2 : l2 = 0 ∨ TVal f L U p2)
   (s : ℝ) (hs1 : (L : ℝ) / SC ≤ s) (hs2 : s ≤ (U : ℝ) / SC) 
   (q : ℕ → ℝ)
   (hboost : ∀ pk, TVal f L U pk →
     (lo32 (f pk) : ℝ) / 10000000000 + w1 ((pk : ℝ) / SC) * (s - (pk : ℝ) / SC)
       + q pk ≤ wfun s) :
   ∃ D : ℝ, (l1 : ℝ) * ((lo32 (hi32 (f p1)) : ℝ) - 2000000000) + (l2 : ℝ) * ((lo32 (hi32 (f p2)) : ℝ) - 2000000000)
       ≤ 1000000000 * D ∧
     32768 * ((lc : ℝ) * (lb top bk L Uc : ℝ) + (l1 : ℝ) * (lo32 (f p1) : ℝ) + (l2 : ℝ) * (lo32 (f p2) : ℝ))
       + 327680000000000 * (D * (s - (L0 : ℝ) / 32768))
       + 10 * ((l1 : ℝ) * ((hi32 (hi32 (f p1)) : ℝ) - 2000000000) * ((p1 : ℝ) - L0)
         + (l2 : ℝ) * ((hi32 (hi32 (f p2)) : ℝ) - 2000000000) * ((p2 : ℝ) - L0))
       ≤ 327680000000000 * 1024 * (wfun s - ((l1 : ℝ) * q p1 + (l2 : ℝ) * q p2) / 1024) := by
 have hSC : (SC : ℝ) = 32768 := by norm_num [SC]
 have hlbs := hlb L Uc s hs1 (hs2.trans (div_le_div_of_nonneg_right (by exact_mod_cast hUc) (by norm_num [SC])))
 have hlbs' : (lb top bk L Uc : ℝ) ≤ 10000000000 * wfun s := by
   rw [div_le_iff₀ (by norm_num : (0:ℝ) < 10000000000)] at hlbs; linarith
 have tang : ∀ (lk pk : ℕ), (lk = 0 ∨ TVal f L U pk) →
     ∃ dk : ℝ, (lk : ℝ) * ((lo32 (hi32 (f pk)) : ℝ) - 2000000000) ≤ 1000000000 * ((lk : ℝ) * dk) ∧
       32768 * ((lk : ℝ) * (lo32 (f pk) : ℝ)) + 327680000000000 * (((lk : ℝ) * dk) * (s - (L0 : ℝ) / 32768))
         + 10 * ((lk : ℝ) * ((hi32 (hi32 (f pk)) : ℝ) - 2000000000) * ((pk : ℝ) - L0))
         ≤ 327680000000000 * ((lk : ℝ) * (wfun s - q pk)) := by
   intro lk pk hk
   rcases hk with hk | hktv
   · refine ⟨0, by rw [hk]; simp, by rw [hk]; simp⟩
   have htan := hboost pk hktv
   obtain ⟨hLp, hpU, hP, hM, hval⟩ := hktv
   rw [hSC] at htan hM hP
   refine ⟨w1 ((pk : ℝ) / 32768), ?_, ?_⟩
   · have hl0 : (0 : ℝ) ≤ lk := Nat.cast_nonneg _
     nlinarith
   · have hl0 : (0 : ℝ) ≤ lk := Nat.cast_nonneg _
     have hpL : (0 : ℝ) ≤ (pk : ℝ) - L0 := sub_nonneg.mpr (by exact_mod_cast hL0.trans hLp)
     have key : 32768 * (lo32 (f pk) : ℝ) + 327680000000000 * (w1 ((pk : ℝ) / 32768) * (s - (L0 : ℝ) / 32768))
         + 10 * (((hi32 (hi32 (f pk)) : ℝ) - 2000000000) * ((pk : ℝ) - L0)) ≤ 327680000000000 * (wfun s - q pk) := by
       have e1 : 327680000000000 * (w1 ((pk : ℝ) / 32768) * (s - (L0 : ℝ) / 32768))
           = 327680000000000 * (w1 ((pk : ℝ) / 32768) * (s - (pk : ℝ) / 32768))
             + 10000000000 * (w1 ((pk : ℝ) / 32768) * ((pk : ℝ) - L0)) := by ring
       rw [e1]
       have h3 : 10 * (((hi32 (hi32 (f pk)) : ℝ) - 2000000000) * ((pk : ℝ) - L0))
           ≤ -(10000000000 * (w1 ((pk : ℝ) / 32768) * ((pk : ℝ) - L0))) := by
         nlinarith [mul_le_mul_of_nonneg_right hM hpL]
       have h4 : 32768 * (lo32 (f pk) : ℝ) + 327680000000000 * (w1 ((pk : ℝ) / 32768) * (s - (pk : ℝ) / 32768))
           ≤ 327680000000000 * (wfun s - q pk) := by
         have := mul_le_mul_of_nonneg_left htan (by norm_num : (0 : ℝ) ≤ 327680000000000)
         nlinarith [this]
       linarith
     nlinarith [mul_le_mul_of_nonneg_left key hl0]
 obtain ⟨d1, hd1, hb1⟩ := tang l1 p1 h1
 obtain ⟨d2, hd2, hb2⟩ := tang l2 p2 h2
 refine ⟨(l1 : ℝ) * d1 + (l2 : ℝ) * d2, by linarith, ?_⟩
 have hsum' : (lc : ℝ) + l1 + l2 = 1024 := by exact_mod_cast hsum
 have hc0 : (0 : ℝ) ≤ lc := Nat.cast_nonneg _
 have hcl := mul_le_mul_of_nonneg_left hlbs' hc0
 have e2 : (327680000000000 : ℝ) * 1024 *
     (wfun s - ((l1 : ℝ) * q p1 + (l2 : ℝ) * q p2) / 1024)
     = 327680000000000 * ((lc : ℝ) * wfun s) + 327680000000000 * ((l1 : ℝ) * (wfun s - q p1))
       + 327680000000000 * ((l2 : ℝ) * (wfun s - q p2)) := by
   have hsw := congrArg (fun t : ℝ => 327680000000000 * t * wfun s) hsum'
   nlinarith only [hsw]
 rw [e2]
 nlinarith [hb1, hb2, hcl]


end AMW.Cert.PCell.Var


/-! ### the variance term of a kind-3 term (am-cert, 2026-10-14)

A kind-3 term mixes the tangents at `p` (weight `1024 − m`) and `r` (weight `m`).  On a segment where `w″ ≥ μ`, each
tangent gains `(μ/2)(s − anchor)²` (`TVal_curved`), and the weighted sum of the two squares is at least the anchors'
variance `(μ/2) · (1024 − m) m / 1024² · (p − r)² / SC²` (`variance_lower`), whatever `s` is.  The bonus adds the floor
of that bound, in `mvT` units (`10¹⁰ · 1024 · wfun`), to the term's constant. -/

namespace AMW.Cert.PCell.Var
open AMW.Cert AMW.Cert.Pyr AMW.Cert.PyrD AMW.Cert.PCell

/-- the curvature denominator of the segment table -/
def VD : ℕ := 1000000000

/-- the bonus numerator for curvature `μN / VD`: `⌊10¹⁰ μN m (1024 − m) (p − r)² / (2 · 1024 · SC² · VD)⌋` -/
def vbon (μN m p r : ℕ) : ℕ :=
  Nat.div (Nat.mul (Nat.mul (Nat.mul 10000000000 μN) (Nat.mul m (Nat.sub 1024 m)))
      (Nat.mul (Nat.add (Nat.sub p r) (Nat.sub r p)) (Nat.add (Nat.sub p r) (Nat.sub r p))))
    (Nat.mul (Nat.mul 2048 (Nat.mul 32768 32768)) VD)

/-- a segment `(a, b, μN, cells)` contains the term range `[L, U]` and both anchors -/
def vin (a b L U p r : ℕ) : Bool :=
  Nat.ble a L && Nat.ble U b && Nat.ble a p && Nat.ble p b && Nat.ble a r && Nat.ble r b

/-! The curvature table (2026-10-15).  Cell `i` is `[256 i, 256 (i + 1)]` (units `1/SC`).  The table is a list of
clusters `(B0, N, T)` in decreasing `B0`: cell `i` reads the 12-bit field `i − B0` of `T` in the first cluster with
`B0 ≤ i`, and `w″ ≥ field · 2¹⁹ / VD` on the cell (`tbOk`, each nonzero field certified by its cell). -/

/-- the 12-bit field `j` of `T` -/
def fat (T j : ℕ) : ℕ := Nat.land (Nat.shiftRight T (Nat.mul 12 j)) 4095

/-- cell `i`'s field -/
def tfld (TB : List (ℕ × ℕ × ℕ)) (i : ℕ) : ℕ :=
  List.rec (motive := fun _ => ℕ) 0
    (fun e _ ih => Bool.rec (motive := fun _ => ℕ) ih (fat e.2.2 (Nat.sub i e.1)) (Nat.ble e.1 i)) TB

/-- the least field of the cells `i, …, i + n` -/
def cmin (TB : List (ℕ × ℕ × ℕ)) (i n : ℕ) : ℕ :=
  Nat.rec (motive := fun _ => ℕ) (tfld TB i)
    (fun n ih => Bool.rec (motive := fun _ => ℕ) ih (tfld TB (Nat.add i (Nat.succ n)))
      (Nat.ble (tfld TB (Nat.add i (Nat.succ n))) ih)) n

/-- a cluster's nonzero fields, each certified on its cell -/
def cellsOk (B0 T N : ℕ) : Bool :=
  Nat.rec (motive := fun _ => Bool) true
    (fun j ih => ih && (Nat.beq (fat T j) 0 || AMW.G.CellA.curvatureChain (Nat.mul (fat T j) 524288) VD
      (Nat.mul 256 (Nat.add B0 j)) [Nat.mul 256 (Nat.add (Nat.add B0 j) 1)])) N

/-- every cluster holds `N` fields, each certified -/
def tbOk (TB : List (ℕ × ℕ × ℕ)) : Bool :=
  TB.all fun e => Nat.blt e.2.2 (Nat.pow 2 (Nat.mul 12 e.2.1)) && cellsOk e.1 e.2.2 e.2.1

theorem fat_zero {T N j : ℕ} (hT : T < 2 ^ (12 * N)) (hj : N ≤ j) : fat T j = 0 := by
  have h0 : Nat.shiftRight T (Nat.mul 12 j) = 0 := by
    show T >>> (12 * j) = 0
    rw [Nat.shiftRight_eq_div_pow]
    apply Nat.div_eq_of_lt
    exact hT.trans_le (Nat.pow_le_pow_right (by norm_num) (by show 12 * N ≤ 12 * j; omega))
  unfold fat; rw [h0]; rfl

theorem cellsOk_sound {B0 T : ℕ} : ∀ {N : ℕ}, cellsOk B0 T N = true → ∀ {j : ℕ}, j < N → fat T j ≠ 0 →
    AMW.G.CellA.curvatureChain (fat T j * 524288) VD (256 * (B0 + j)) [256 * (B0 + j + 1)] = true := by
  intro N
  induction N with
  | zero => intro _ j hj; omega
  | succ n ih =>
    intro h j hj hf
    have h' : (cellsOk B0 T n && (Nat.beq (fat T n) 0 || AMW.G.CellA.curvatureChain (Nat.mul (fat T n) 524288) VD
        (Nat.mul 256 (Nat.add B0 n)) [Nat.mul 256 (Nat.add (Nat.add B0 n) 1)])) = true := h
    simp only [Bool.and_eq_true, Bool.or_eq_true, Nat.beq_eq] at h'
    rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | hj
    · exact ih h'.1 hj hf
    · subst hj
      rcases h'.2 with h0 | hc
      · exact absurd h0 hf
      · exact hc

theorem tfld_sound {TB : List (ℕ × ℕ × ℕ)} (h : tbOk TB = true) {i : ℕ} (hf : tfld TB i ≠ 0) {x : ℝ}
    (hx1 : ((256 * i : ℕ) : ℝ) / SC ≤ x) (hx2 : x ≤ ((256 * (i + 1) : ℕ) : ℝ) / SC) :
    ((tfld TB i * 524288 : ℕ) : ℝ) / VD ≤ AMW.w2AM x := by
  induction TB with
  | nil => exact absurd rfl hf
  | cons e r ih =>
    unfold tbOk at h
    rw [List.all_cons, Bool.and_eq_true] at h
    have hc : tfld (e :: r) i
        = Bool.rec (motive := fun _ => ℕ) (tfld r i) (fat e.2.2 (Nat.sub i e.1)) (Nat.ble e.1 i) := rfl
    cases hb : Nat.ble e.1 i
    · rw [hb] at hc; rw [hc] at hf ⊢; exact ih h.2 hf
    · rw [hb] at hc; rw [hc] at hf ⊢
      have hei : e.1 ≤ i := Nat.le_of_ble_eq_true hb
      have h1 := h.1
      simp only [Bool.and_eq_true, Nat.blt_eq] at h1
      have hj : Nat.sub i e.1 < e.2.1 := by
        by_contra hj
        exact hf (fat_zero h1.1 (by omega))
      have hcc := cellsOk_sound h1.2 hj hf
      have e1 : e.1 + Nat.sub i e.1 = i := by show e.1 + (i - e.1) = i; omega
      rw [e1] at hcc
      exact AMW.G.CellA.curvatureChain_sound _ VD [256 * (i + 1)] (256 * i) hcc (List.cons_ne_nil _ _) x hx1 hx2

theorem cmin_le (TB : List (ℕ × ℕ × ℕ)) (i n : ℕ) :
    cmin TB i (n + 1) ≤ tfld TB (i + (n + 1)) ∧ cmin TB i (n + 1) ≤ cmin TB i n := by
  have hc : cmin TB i (n + 1) = Bool.rec (motive := fun _ => ℕ) (cmin TB i n) (tfld TB (Nat.add i (Nat.succ n)))
      (Nat.ble (tfld TB (Nat.add i (Nat.succ n))) (cmin TB i n)) := rfl
  have e : Nat.add i (Nat.succ n) = i + (n + 1) := rfl
  rw [e] at hc
  cases hb : Nat.ble (tfld TB (i + (n + 1))) (cmin TB i n)
  · rw [hb] at hc; rw [hc]
    rcases Nat.lt_or_ge (cmin TB i n) (tfld TB (i + (n + 1))) with hlt | hge
    · exact ⟨hlt.le, le_rfl⟩
    · rw [Nat.ble_eq_true_of_le hge] at hb; exact absurd hb (by decide)
  · rw [hb] at hc; rw [hc]; exact ⟨le_rfl, Nat.le_of_ble_eq_true hb⟩

theorem cmin_sound {TB : List (ℕ × ℕ × ℕ)} (h : tbOk TB = true) (i : ℕ) : ∀ n : ℕ, cmin TB i n ≠ 0 → ∀ x : ℝ,
    ((256 * i : ℕ) : ℝ) / SC ≤ x → x ≤ ((256 * (i + n + 1) : ℕ) : ℝ) / SC →
    ((cmin TB i n * 524288 : ℕ) : ℝ) / VD ≤ AMW.w2AM x := by
  have hVD : (0 : ℝ) ≤ VD := Nat.cast_nonneg _
  have mono : ∀ {a b : ℕ}, a ≤ b → ((a * 524288 : ℕ) : ℝ) / VD ≤ ((b * 524288 : ℕ) : ℝ) / VD := fun hab =>
    div_le_div_of_nonneg_right (by exact_mod_cast Nat.mul_le_mul_right _ hab) hVD
  intro n
  induction n with
  | zero => intro hf x hx1 hx2; exact tfld_sound h hf hx1 hx2
  | succ n ih =>
    intro hf x hx1 hx2
    obtain ⟨h1, h2⟩ := cmin_le TB i n
    have hSC : (0 : ℝ) < SC := by norm_num [SC]
    rcases le_or_gt x (((256 * (i + n + 1) : ℕ) : ℝ) / SC) with hx | hx
    · exact (mono h2).trans (ih (fun h0 => hf (Nat.eq_zero_of_le_zero (h0 ▸ h2))) x hx1 hx)
    · refine (mono h1).trans (tfld_sound h (fun h0 => hf (Nat.eq_zero_of_le_zero (h0 ▸ h1))) ?_ ?_)
      · have e : 256 * (i + (n + 1)) = 256 * (i + n + 1) := by ring
        rw [e]; exact hx.le
      · have e : 256 * (i + (n + 1) + 1) = 256 * (i + (n + 1) + 1) := rfl
        exact hx2

/-- the anchors' variance: `α(x − p)² + β(x − r)² ≥ αβ(p − r)²` for `α + β = 1` -/
theorem variance_lower (x p r α β : ℝ) (hsum : α + β = 1) (hα : 0 ≤ α) (hβ : 0 ≤ β) :
    α * β * (p - r) ^ 2 ≤ α * (x - p) ^ 2 + β * (x - r) ^ 2 := by
  have hb : β = 1 - α := by linarith
  subst hb
  nlinarith [sq_nonneg (x - (α * p + (1 - α) * r)), mul_nonneg hα hβ]

end AMW.Cert.PCell.Var


namespace AMW.Cert.PCell.Var
open AMW.Cert AMW.Cert.Pyr AMW.Cert.PyrD AMW.Cert.PCell

theorem vbon_le (μN lam p1 p2 : ℕ) (hl : lam ≤ 1024) :
    (vbon μN lam p1 p2 : ℝ) ≤ 10000000000 * ((μN : ℝ) / VD) * ((1024 : ℝ) - lam) * lam
      * ((p1 : ℝ) - p2) ^ 2 / (2048 * 32768 ^ 2) := by
  have hd : (((Nat.sub p1 p2 + Nat.sub p2 p1 : ℕ) : ℝ)) ^ 2 = ((p1 : ℝ) - p2) ^ 2 := by
    rcases le_total p1 p2 with h | h
    · rw [show Nat.sub p1 p2 = 0 from Nat.sub_eq_zero_of_le h, Nat.zero_add,
        show Nat.sub p2 p1 = p2 - p1 from rfl, Nat.cast_sub h]; ring
    · rw [show Nat.sub p2 p1 = 0 from Nat.sub_eq_zero_of_le h, Nat.add_zero,
        show Nat.sub p1 p2 = p1 - p2 from rfl, Nat.cast_sub h]
  set N : ℕ := Nat.mul (Nat.mul (Nat.mul 10000000000 μN) (Nat.mul lam (Nat.sub 1024 lam)))
      (Nat.mul (Nat.add (Nat.sub p1 p2) (Nat.sub p2 p1)) (Nat.add (Nat.sub p1 p2) (Nat.sub p2 p1))) with hN
  set Dn : ℕ := Nat.mul (Nat.mul 2048 (Nat.mul 32768 32768)) VD with hDn
  have hfl : (vbon μN lam p1 p2 : ℝ) * Dn ≤ N := by
    have := Nat.div_mul_le_self N Dn
    exact_mod_cast this
  have hDnR : (Dn : ℝ) = 2048 * 32768 ^ 2 * 1000000000 := by simp [hDn, VD]; norm_num
  have hNR : (N : ℝ) = 10000000000 * μN * (lam * ((1024 : ℝ) - lam)) * ((p1 : ℝ) - p2) ^ 2 := by
    rw [hN, ← hd]
    simp only [Nat.mul_eq, Nat.add_eq, Nat.cast_mul, Nat.cast_add, Nat.cast_ofNat]
    rw [show Nat.sub 1024 lam = 1024 - lam from rfl, Nat.cast_sub hl]; push_cast; ring
  have hVD : (VD : ℝ) = 1000000000 := by simp [VD]
  rw [hDnR] at hfl; rw [hNR] at hfl; rw [hVD]
  rw [le_div_iff₀ (by norm_num)]
  have e : 10000000000 * ((μN : ℝ) / 1000000000) * ((1024 : ℝ) - lam) * lam * ((p1 : ℝ) - p2) ^ 2
      = (10000000000 * μN * (lam * ((1024 : ℝ) - lam)) * ((p1 : ℝ) - p2) ^ 2) / 1000000000 := by ring
  rw [e, le_div_iff₀ (by norm_num)]
  linarith

end AMW.Cert.PCell.Var


namespace AMW.Cert.PCell.Var
open AMW.Cert AMW.Cert.Pyr AMW.Cert.PyrD AMW.Cert.PCell

/-- a term's constant raised by a bonus `bon L U k m p r` -/
def mvTW (bon : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ) (top : ℕ) (bk : ℕ → ℕ) (f : ℕ → ℕ) (L U k m p r : ℕ) : ℕ :=
  Nat.add (mvT top bk f L (uc L U) k m p r) (bon L U k m p r)

/-- the table bonus of a kind-3 term on `[L, U]`: the cells `L / 256, …, U / 256` (at most five), their least field
as the curvature, both anchors in the cells' span -/
def vbW (TB : List (ℕ × ℕ × ℕ)) (L U k m p r : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ) 0
    (Bool.rec (motive := fun _ => ℕ) 0
      (vbon (Nat.mul (cmin TB (Nat.div L 256) (Nat.sub (Nat.div U 256) (Nat.div L 256))) 524288) m p r)
      (Nat.ble (Nat.sub (Nat.div U 256) (Nat.div L 256)) 4 &&
        vin (Nat.mul 256 (Nat.div L 256)) (Nat.mul 256 (Nat.add (Nat.div U 256) 1)) L U p r))
    (Nat.beq k 3)

theorem vbW_cases (TB : List (ℕ × ℕ × ℕ)) (L U k m p r : ℕ) :
    vbW TB L U k m p r = 0 ∨
      (k = 3 ∧ vin (256 * (L / 256)) (256 * (U / 256 + 1)) L U p r = true ∧
        cmin TB (L / 256) (U / 256 - L / 256) ≠ 0 ∧
        vbW TB L U k m p r = vbon (cmin TB (L / 256) (U / 256 - L / 256) * 524288) m p r) := by
  unfold vbW
  cases hk : Nat.beq k 3
  · left; rfl
  · cases hg : (Nat.ble (Nat.sub (Nat.div U 256) (Nat.div L 256)) 4 &&
        vin (Nat.mul 256 (Nat.div L 256)) (Nat.mul 256 (Nat.add (Nat.div U 256) 1)) L U p r)
    · left; rfl
    · by_cases hc : cmin TB (L / 256) (U / 256 - L / 256) = 0
      · left
        show vbon (Nat.mul (cmin TB (Nat.div L 256) (Nat.sub (Nat.div U 256) (Nat.div L 256))) 524288) m p r = 0
        rw [show Nat.mul (cmin TB (Nat.div L 256) (Nat.sub (Nat.div U 256) (Nat.div L 256))) 524288 = 0 from by
          show cmin TB (L / 256) (U / 256 - L / 256) * 524288 = 0; rw [hc, Nat.zero_mul]]
        simp [vbon]
        exact Nat.zero_div _
      · right
        rw [Bool.and_eq_true] at hg
        exact ⟨Nat.eq_of_beq_eq_true hk, hg.2, hc, rfl⟩

/-- the lever-1 kind-3 term on a certified segment, with the variance bonus -/
theorem mterm_okIV {top : ℕ} {bk : ℕ → ℕ} {g : ℕ → ℕ} (hlb : LBSound top bk) (hg : ∀ x, PVI x (g x))
    {a b μN : ℕ} (hcurv : ∀ t : ℝ, (a : ℝ) / SC ≤ t → t ≤ (b : ℝ) / SC → (μN : ℝ) / VD ≤ AMW.w2AM t)
    (L0 L U Uc lam p1 p2 : ℕ) (hL0 : L0 ≤ L) (hUc : U ≤ Uc) (hl : lam ≤ 1024)
    (hin : vin a b L U p1 p2 = true)
    (hok : ((Nat.beq (mw1 3 lam) 0 || ivIn (g p1) L U p1) && (Nat.beq (mw2 3 lam) 0 || ivIn (g p2) L U p2)) = true)
    (s : ℝ) (hs1 : (L : ℝ) / SC ≤ s) (hs2 : s ≤ (U : ℝ) / SC) :
    ∃ D : ℝ, (msl (tf g) (mw1 3 lam) (mw2 3 lam) p1 p2 : ℝ) - 2000000000 * ((mw1 3 lam : ℝ) + (mw2 3 lam : ℝ))
        ≤ 1000000000 * D ∧
      32768 * ((mval top bk (tf g) L Uc (mwc 3 lam) (mw1 3 lam) (mw2 3 lam) p1 p2 : ℝ) + (vbon μN lam p1 p2 : ℝ))
        + 327680000000000 * (D * (s - (L0 : ℝ) / 32768))
        + 10 * (mcp (tf g) L0 (mw1 3 lam) (mw2 3 lam) p1 p2 : ℝ) - 10 * (mcn (tf g) L0 (mw1 3 lam) (mw2 3 lam) p1 p2 : ℝ)
        ≤ 327680000000000 * 1024 * wfun s := by
  simp only [Bool.and_eq_true, Bool.or_eq_true, Nat.beq_eq] at hok
  unfold vin at hin
  simp only [Bool.and_eq_true, Nat.ble_eq] at hin
  obtain ⟨⟨⟨⟨⟨haL, hUb⟩, hap⟩, hpb⟩, har⟩, hrb⟩ := hin
  have hSCp : (0 : ℝ) < SC := by norm_num [SC]
  have hdiv : ∀ {x y : ℕ}, x ≤ y → (x : ℝ) / SC ≤ (y : ℝ) / SC :=
    fun h => div_le_div_of_nonneg_right (by exact_mod_cast h) hSCp.le
  set μ : ℝ := (μN : ℝ) / VD with hμ
  have hμ0 : 0 ≤ μ := div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  have hsI : s ∈ Set.Icc ((a : ℝ) / SC) ((b : ℝ) / SC) := ⟨(hdiv haL).trans hs1, hs2.trans (hdiv hUb)⟩
  have hcurv' : ∀ t ∈ Set.Icc ((a : ℝ) / SC) ((b : ℝ) / SC), μ ≤ AMW.w2AM t := fun t ht => hcurv t ht.1 ht.2
  classical
  let q : ℕ → ℝ := fun pk => if a ≤ pk ∧ pk ≤ b then μ / 2 * (s - (pk : ℝ) / SC) ^ 2 else 0
  have hboost : ∀ pk, TVal (tf g) L U pk →
      (lo32 ((tf g) pk) : ℝ) / 10000000000 + w1 ((pk : ℝ) / SC) * (s - (pk : ℝ) / SC) + q pk ≤ wfun s := by
    intro pk htv
    by_cases hpk : a ≤ pk ∧ pk ≤ b
    · simp only [q, if_pos hpk]
      exact TVal_curved htv hcurv' ⟨hdiv hpk.1, hdiv hpk.2⟩ hsI
    · simp only [q, if_neg hpk, add_zero]
      exact htv.2.2.2.2 s hs1 hs2
  have tv : ∀ (lk pk : ℕ), (lk = 0 ∨ ivIn (g pk) L U pk = true) → lk = 0 ∨ TVal (tf g) L U pk :=
    fun lk pk h => h.imp id (tval_of_ivIn hg)
  obtain ⟨h1, h2⟩ := hok
  obtain ⟨D, hD1, hb⟩ := mterm_minV_curved hlb L0 L U Uc (mwc 3 lam) (mw1 3 lam) (mw2 3 lam) p1 p2 hL0 hUc
    (mw_sum 3 lam hl) (tv _ _ h1) (tv _ _ h2) s hs1 hs2 q hboost
  have pk : ∀ (lk pk : ℕ), (lk = 0 ∨ TVal (tf g) L U pk) →
      (lk : ℝ) * (((hi32 (hi32 (tf g pk)) - 2000000000 : ℕ) : ℝ) - ((2000000000 - hi32 (hi32 (tf g pk)) : ℕ) : ℝ))
        * ((pk - L0 : ℕ) : ℝ) = (lk : ℝ) * ((hi32 (hi32 (tf g pk)) : ℝ) - 2000000000) * ((pk : ℝ) - L0) := by
    intro lk pk h
    rw [natsub_pair]
    rcases h with h | h
    · rw [h]; simp
    · rw [Nat.cast_sub (hL0.trans h.1)]
  have e1 := pk _ _ (tv _ _ h1)
  have e2 := pk _ _ (tv _ _ h2)
  -- the variance: the bonus is below the two anchors' curvature gains
  have hw1 : (mw1 3 lam : ℝ) = 1024 - lam := by
    show ((Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) (Bool.rec (motive := fun _ => ℕ) 0
      (Nat.sub 1024 lam) (Nat.beq 3 3)) lam (Nat.beq 3 2)) 1024 (Nat.beq 3 1) : ℕ) : ℝ) = 1024 - lam
    simp only [show Nat.beq 3 3 = true from rfl, show Nat.beq 3 2 = false from rfl, show Nat.beq 3 1 = false from rfl]
    rw [show Nat.sub 1024 lam = 1024 - lam from rfl, Nat.cast_sub hl]; norm_num
  have hw2 : (mw2 3 lam : ℝ) = lam := by
    show ((Bool.rec (motive := fun _ => ℕ) 0 lam (Nat.beq 3 3) : ℕ) : ℝ) = lam
    simp only [show Nat.beq 3 3 = true from rfl]
  have hq1 : q p1 = μ / 2 * (s - (p1 : ℝ) / SC) ^ 2 := if_pos ⟨hap, hpb⟩
  have hq2 : q p2 = μ / 2 * (s - (p2 : ℝ) / SC) ^ 2 := if_pos ⟨har, hrb⟩
  have hlr : (0 : ℝ) ≤ lam := Nat.cast_nonneg _
  have hlr' : (lam : ℝ) ≤ 1024 := by exact_mod_cast hl
  have hvar := variance_lower s ((p1 : ℝ) / SC) ((p2 : ℝ) / SC) ((1024 - lam) / 1024) (lam / 1024)
    (by ring) (by linarith) (by positivity)
  have hbon := vbon_le μN lam p1 p2 hl
  have hSC : (SC : ℝ) = 32768 := by norm_num [SC]
  rw [hSC] at hvar hq1 hq2
  have hbon' : (vbon μN lam p1 p2 : ℝ) ≤ 10000000000 * ((mw1 3 lam : ℝ) * q p1 + (mw2 3 lam : ℝ) * q p2) := by
    rw [hw1, hw2, hq1, hq2]
    rw [← hμ] at hbon
    have hk0 : (0 : ℝ) ≤ 10000000000 * μ / 2 * 1024 := by positivity
    have hv2 := mul_le_mul_of_nonneg_left hvar hk0
    have k1 : 10000000000 * μ * (1024 - (lam : ℝ)) * lam * ((p1 : ℝ) - p2) ^ 2 / (2048 * 32768 ^ 2)
        = 10000000000 * μ / 2 * 1024 * ((1024 - lam) / 1024 * (lam / 1024) * ((p1 : ℝ) / 32768 - p2 / 32768) ^ 2) := by
      ring
    have k2 : 10000000000 * μ / 2 * 1024 * ((1024 - lam) / 1024 * (s - (p1 : ℝ) / 32768) ^ 2
        + lam / 1024 * (s - (p2 : ℝ) / 32768) ^ 2)
        = 10000000000 * ((1024 - lam) * (μ / 2 * (s - (p1 : ℝ) / 32768) ^ 2) + lam * (μ / 2 * (s - (p2 : ℝ) / 32768) ^ 2)) := by
      ring
    linarith [hbon, hv2, k1, k2]
  refine ⟨D, ?_, ?_⟩
  · unfold msl; simp only [Nat.add_eq, Nat.mul_eq]; push_cast; linarith
  · unfold mval mcp mcn at *
    simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq] at *
    push_cast at *
    nlinarith [hb, e1, e2, hbon']

/-- `mtermTI` with the table bonus: the per-term bound `mcheckW_sound` consumes -/
theorem mtermTIW {top : ℕ} {bk : ℕ → ℕ} {g : ℕ → ℕ} (hlb : LBSound top bk) (hg : ∀ x, PVI x (g x))
    {TB : List (ℕ × ℕ × ℕ)} (hTB : tbOk TB = true)
    (L0 L U k m p r : ℕ) (hL0 : L0 ≤ L) (hok : mokI g L U k m p r = true)
    (s : ℝ) (hs1 : (L : ℝ) / SC ≤ s) (hs2 : s ≤ (U : ℝ) / SC) :
    ∃ D : ℝ, (mslT (tf g) k m p r : ℝ) - 2000000000 * (mwT k m : ℝ) ≤ 1000000000 * D ∧
      32768 * (mvTW (vbW TB) top bk (tf g) L U k m p r : ℝ) + 327680000000000 * (D * (s - (L0 : ℝ) / 32768))
        + 10 * (mcpT (tf g) L0 k m p r : ℝ) - 10 * (mcnT (tf g) L0 k m p r : ℝ) ≤ 327680000000000 * 1024 * wfun s := by
  unfold mvTW
  rcases vbW_cases TB L U k m p r with h0 | ⟨hk, hv, hc, hb⟩
  · rw [h0]
    obtain ⟨D, h1, h2⟩ := mtermTI hlb hg L0 L U k m p r hL0 hok s hs1 hs2
    exact ⟨D, h1, by simpa using h2⟩
  · subst hk
    rw [hb]
    unfold mokI at hok
    simp only [Bool.and_eq_true, Nat.ble_eq] at hok
    have hcurv : ∀ t : ℝ, ((256 * (L / 256) : ℕ) : ℝ) / SC ≤ t → t ≤ ((256 * (U / 256 + 1) : ℕ) : ℝ) / SC →
        ((cmin TB (L / 256) (U / 256 - L / 256) * 524288 : ℕ) : ℝ) / VD ≤ AMW.w2AM t := by
      intro t ht1 ht2
      refine cmin_sound hTB (L / 256) (U / 256 - L / 256) hc t ht1 (ht2.trans ?_)
      have hSC : (0 : ℝ) ≤ SC := by norm_num [SC]
      exact div_le_div_of_nonneg_right (by exact_mod_cast Nat.mul_le_mul_left 256 (by omega)) hSC
    obtain ⟨D, h1, h2⟩ := mterm_okIV hlb hg (a := 256 * (L / 256)) (b := 256 * (U / 256 + 1))
      (μN := cmin TB (L / 256) (U / 256 - L / 256) * 524288)
      hcurv L0 L U (uc L U) m p r hL0 (le_uc L U) hok.1 hv
      (by simp only [Bool.and_eq_true]; exact hok.2) s hs1 hs2
    refine ⟨D, ?_, ?_⟩
    · simp only [mslT, mwT, Nat.add_eq]; push_cast; linarith
    · simp only [mvT, mcpT, mcnT, Nat.add_eq] at h2 ⊢; push_cast at h2 ⊢; linarith


/-- `mcheckGX` with each term's constant raised by a bonus (`mvTW`) -/
def mcheckW (bon : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ) (ok : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Bool) (top : ℕ) (bk : ℕ → ℕ) (f : ℕ → ℕ) (Q : ℕ) (bs : List ℕ)
    (TS : List Term) (cN : ℕ) (c : Cl) (FS : List Term) (P S : List ℕ) (Cp Cm : ℕ) : Bool :=
  Bool.rec (motive := fun _ => Bool) false
    (Nat.ble
      (Nat.add (Nat.mul 335544320000000000 cN) (Nat.mul 10 (Nat.add (Nat.add (isum (fun n => Nat.mul (tA TS n)
        (mcnT f (eL0 TS c n) (tI FS n) (tJ FS n) (tA FS n) (tK FS n))) TS.length) Cp)
        (isum (fun r => Nat.mul (Nat.sub (c.U.getD r 0) (c.L.getD r 0)) (Ng f bs TS FS P S r)) Q))))
      (Nat.add (Nat.add (Nat.mul 10240000000000 (isum (fun r => Nat.mul (bs.getD r 0) (c.L.getD r 0)) Q))
        (Nat.mul 32768 (isum (fun n => Nat.mul (tA TS n) (mvTW bon top bk f (eL TS c n) (eU TS c n) (tI FS n) (tJ FS n) (tA FS n) (tK FS n))) TS.length)))
        (Nat.mul 10 (Nat.add (isum (fun n => Nat.mul (tA TS n) (mcpT f (eL0 TS c n) (tI FS n) (tJ FS n) (tA FS n) (tK FS n)))
          TS.length) Cm))))
    (Bool.rec (motive := fun _ => Bool) false
      (iall (fun n => ok (eL TS c n) (eU TS c n) (tI FS n) (tJ FS n) (tA FS n) (tK FS n)) TS.length)
      (iall (fun r => Nat.ble (c.L.getD r 0) (c.U.getD r 0)) Q))


end AMW.Cert.PCell.Var

