  exact (continuous_const.mul
    ((hW.continuous.comp (continuous_const.mul continuous_id)).pow 2)).measurable
theorem realizedWeight_le {P : Params} (hP : P.Valid) (T : ℝ)
    (h8 : 8 * P.w ≤ P.L T) (s : ℝ) :
    realizedWeight P T s ≤ AMMajorant.scaledMajorant s := by
