      AdmWindow.vHatR (AMW.WAM P T)
        (γ' - (T + (((k : ℕ) : ℤ) : ℝ) * (2 * π / P.L T)))
theorem realKernel_form_le {P : Params} (hP : P.Valid) (T : ℝ)
    (h8 : 8 * P.w ≤ P.L T) (ha : 0 < (AMW.atAM P T).a T)
    (ι : Type) [Fintype ι] (γ z : ι → ℝ)
    (hsep : ∀ i j, i ≠ j → 17 / 20 ≤
