    (γ z : ι → ℝ) :
    HasSum (fun k : ℤ =>
        (∑ i, z i * AdmWindow.vHatR v (γ i - (T + k * (2 * π / L)))) ^ 2)
      (L * ∑ i, ∑ j, z i * z j * AdmWindow.VPhiR v (γ i - γ j)) := by
