def cAMn : ℕ → ℤ
 | 0 => 1000000000
 | 1 => 14062605
 | 2 => -16219933
 | 3 => 5836910
 | 4 => 6519832
 | 5 => -927202
 | 6 => 4453864
 | 7 => -6483270
 | 8 => 2875651
