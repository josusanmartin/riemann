section

/-! ###### kernel-cheap forms of the leaf's interval test and term decoder (am-cert, 2026-10-20)

`ivIn2` / `mokI2` are `ivIn` / `mokI` written as single `Bool.rec` chains: the kernel reduces `a && b` through `and`, its
match and `Bool.casesOn` on every use, so the chain form takes a quarter of the unfoldings; `mokI2_eq` is the bridge.
`dec4Q` is `dec4FH` with the grid point `gptQ` computed without forcing (the kernel's cache shares the repeated
subterms) and the next offset passed unforced.  A decoded field enters the leaf check only through the interval test, so
the elimination lemma `dec4Q_cov` is the same one-liner as `dec4FH_cov`. ###### -/

noncomputable section

namespace AMW.Cert.PCell

open AMW.Cert AMW.Cert.Pyr AMW.Cert.PyrD

/-- `ivIn` as one `Bool.rec` chain -/
def ivIn2 (v L U p : ℕ) : Bool :=
  Bool.rec (motive := fun _ => Bool) false (Bool.rec (motive := fun _ => Bool) false (Bool.rec (motive := fun _ => Bool) false
    (Bool.rec (motive := fun _ => Bool) false (Nat.ble U (ivB v)) (Nat.ble p U)) (Nat.ble L p)) (Nat.ble (ivA v) L)) (Nat.ble 1 (ivB v))

theorem ivIn2_eq (v L U p : ℕ) : ivIn2 v L U p = ivIn v L U p := by
  unfold ivIn2 ivIn
  generalize Nat.ble 1 (ivB v) = a; generalize Nat.ble (ivA v) L = b; generalize Nat.ble L p = c
  generalize Nat.ble p U = d; generalize Nat.ble U (ivB v) = e
  cases a <;> cases b <;> cases c <;> cases d <;> cases e <;> rfl

/-- `mokI` as one `Bool.rec` chain -/
def mokI2 (g : ℕ → ℕ) (L U k m p r : ℕ) : Bool :=
  Bool.rec (motive := fun _ => Bool) false
    (Bool.rec (motive := fun _ => Bool) false
      (Bool.rec (motive := fun _ => Bool) (ivIn2 (g r) L U r) true (Nat.beq (mw2 k m) 0))
      (Bool.rec (motive := fun _ => Bool) (ivIn2 (g p) L U p) true (Nat.beq (mw1 k m) 0)))
    (Nat.ble m 1024)

theorem mokI2_eq (g : ℕ → ℕ) (L U k m p r : ℕ) : mokI2 g L U k m p r = mokI g L U k m p r := by
  unfold mokI2 mokI
  rw [ivIn2_eq, ivIn2_eq]
  generalize Nat.ble m 1024 = a; generalize Nat.beq (mw1 k m) 0 = b; generalize ivIn (g p) L U p = c
  generalize Nat.beq (mw2 k m) 0 = d; generalize ivIn (g r) L U r = e
  cases a <;> cases b <;> cases c <;> cases d <;> cases e <;> rfl

/-- `gptF`'s clamped grid point for a grid shift `gs`, without forcing -/
def gq (L U jj gs : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ)
    (Bool.rec (motive := fun _ => ℕ) (Nat.shiftLeft (Nat.shiftRight (Nat.add L (Nat.shiftRight (Nat.mul (Nat.sub U L) (Nat.land jj 63)) 5)) gs) gs)
      (Nat.shiftLeft (Nat.shiftRight U gs) gs)
      (Nat.ble (Nat.shiftLeft (Nat.shiftRight U gs) gs) (Nat.shiftLeft (Nat.shiftRight (Nat.add L (Nat.shiftRight (Nat.mul (Nat.sub U L) (Nat.land jj 63)) 5)) gs) gs)))
    (Nat.shiftLeft (Nat.shiftRight (Nat.add L (Nat.sub (Nat.shiftLeft 1 gs) 1)) gs) gs)
    (Nat.ble (Nat.shiftLeft (Nat.shiftRight (Nat.add L (Nat.shiftRight (Nat.mul (Nat.sub U L) (Nat.land jj 63)) 5)) gs) gs)
      (Nat.shiftLeft (Nat.shiftRight (Nat.add L (Nat.sub (Nat.shiftLeft 1 gs) 1)) gs) gs))


/-- `gptQ` with the fine grid shift `fs` a parameter (`2^fs`; the `gptH` / `gptF` grid is `fs = 4`) -/
def gptQG (fs L U jj : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ)
    (Bool.rec (motive := fun _ => ℕ) (gq L U jj (Bool.rec (motive := fun _ => ℕ) 8 fs (Nat.beq (Nat.land (Nat.shiftRight jj 6) 1) 1)))
      U (Nat.beq jj 34))
    L (Nat.beq jj 33)

/-- `dec4Q` on `gptQG fs` (the decoder of a tree sized on the fine grid `2^fs`) -/
def dec4QG (fs lb w o L U : ℕ) (k : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ) : ℕ :=
  forceR (Nat.land (Nat.shiftRight w o) 3) fun a =>
  forceR (Bool.rec (motive := fun _ => ℕ)
      (Bool.rec (motive := fun _ => ℕ) 0 (Nat.land (Nat.shiftRight w (Nat.add o 16)) (Nat.sub (Nat.shiftLeft 1 lb) 1)) (Nat.beq a 3))
      (Nat.land (Nat.shiftRight w (Nat.add o 9)) (Nat.sub (Nat.shiftLeft 1 lb) 1)) (Nat.beq a 2)) fun lam =>
  forceR (Bool.rec (motive := fun _ => ℕ) (gptQG fs L U (Nat.land (Nat.shiftRight w (Nat.add o 2)) 127)) 0 (Nat.beq a 0)) fun p =>
  forceR (Bool.rec (motive := fun _ => ℕ) 0 (gptQG fs L U (Nat.land (Nat.shiftRight w (Nat.add o 9)) 127)) (Nat.beq a 3)) fun r =>
  k a (Nat.shiftLeft lam (Nat.sub 10 lb)) p r (Nat.add o (plenF lb a))


/-! ###### the per-term record (am-cert, 2026-10-20)

`termrec` dispatches once on the term's kind (constant first, then one tangent: the common kinds) and returns every
quantity the leaf check reads from the term: value, the two charges, slope claim, slope weight, side condition.  Each
field equals the separately dispatched function it replaces (`termrec_v` … `termrec_ok`), for every kind. ###### -/


end AMW.Cert.PCell

end

end

section

/-! ###### the reflection half-space as a multiplier row (am-cert, 2026-10-22)

The covering predicate is `Pg cN Q bs TS g = (cN ≤ Fg g ∨ g (Q − 1) < g 0)`: a point with `g (Q − 1) < g 0` is covered by
reflection.  So a leaf may use the half-space `g 0 ≤ g (Q − 1)` as one more Farkas row: its multiplier `Y ≥ 0` multiplies
the slack `32768 (g (Q − 1) − g 0)`, i.e. `P (Q − 1) += Y`, `S 0 += Y`, `Cp += Y (L (Q − 1) ∸ L 0)`, `Cm += Y (L 0 ∸ L (Q − 1))`.
`MulOKgH` is `MulOKg` asked only on the half-space; `mul_stepH` is `mul_step` under it (the same proof), `half_stepH` the
new row; `mcheckGX_soundH` / `mcheckW_soundH` are `mcheckGX_sound` / `mcheckW_sound` (the same proofs) with the
multipliers read at the point, a point with `g (Q − 1) < g 0` covered by the reflection disjunct. ###### -/

noncomputable section

namespace AMW.Cert.PCell

open AMW.Cert AMW.Cert.Pyr AMW.Cert.PyrD

/-- the accumulated multipliers are valid on the cell's half `g 0 ≤ g (Q − 1)` -/
def MulOKgH (Q : ℕ) (PR : List (ℕ × ℕ)) (c : Cl) (P S : List ℕ) (Cp Cm : ℕ) : Prop :=
  ∀ g, InCell Q PR c g → g 0 ≤ g (Q - 1) → 0 ≤ ((Cp : ℝ) - Cm) +
    ∑ r ∈ Finset.range Q, (((P.getD r 0 : ℕ) : ℝ) - (S.getD r 0 : ℕ)) * (32768 * g r - (c.L.getD r 0 : ℕ))


/-- `mul_step` on the half: one pair entry (the same proof) -/
theorem mul_stepH {Q : ℕ} {PR : List (ℕ × ℕ)} (hPR : PRok Q PR) {c : Cl} {P S : List ℕ} {Cp Cm : ℕ}
    (hP : P.length = Q) (hS : S.length = Q) (h : MulOKgH Q PR c P S Cp Cm) {k : ℕ} (hk : k < PR.length) (Ylo Yhi : ℕ) :
    MulOKgH Q PR c (imap (fun r x => Nat.add x (Nat.mul Ylo (ind (inr r (pI PR k) (pJ PR k))))) 0 P)
      (imap (fun r x => Nat.add x (Nat.mul Yhi (ind (inr r (pI PR k) (pJ PR k))))) 0 S)
      (Nat.add (Nat.add Cp (Nat.mul Ylo (Nat.sub (sumR c.L (pI PR k) (pJ PR k - pI PR k)) (c.A.getD k 0))))
        (Nat.mul Yhi (Nat.sub (c.B.getD k 0) (sumR c.L (pI PR k) (pJ PR k - pI PR k)))))
      (Nat.add (Nat.add Cm (Nat.mul Ylo (Nat.sub (c.A.getD k 0) (sumR c.L (pI PR k) (pJ PR k - pI PR k)))))
        (Nat.mul Yhi (Nat.sub (sumR c.L (pI PR k) (pJ PR k - pI PR k)) (c.B.getD k 0)))) := by
  intro g hg hord
  have h0 := h g hg hord
  obtain ⟨hij, hjQ⟩ := hPR k hk
  set i := pI PR k with hi
  set j := pJ PR k with hj
  have hn : i + (j - i) = j := by omega
  have hSCe : (SC : ℝ) = 32768 := by norm_num [SC]
  -- the multiplier sum over the pair's gaps
  have hsum : ∑ r ∈ Finset.range Q, ((ind (inr r i j) : ℕ) : ℝ) * (32768 * g r - (c.L.getD r 0 : ℕ))
      = 32768 * gsum g i j - (sumR c.L i (j - i) : ℕ) := by
    simp only [ind_inr, ite_mul, one_mul, zero_mul]
    rw [← Finset.sum_filter, sumR_eq, hn, gsum, Finset.mul_sum, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr
    · ext r; simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_Ico]; omega
    · intro _ _; rfl
  have hA := (hg.2 k hk).1
  have hB := (hg.2 k hk).2
  rw [hSCe] at hA hB
  have hlo : (0 : ℝ) ≤ Ylo * (32768 * gsum g i j - (c.A.getD k 0 : ℕ)) :=
    mul_nonneg (Nat.cast_nonneg _) (by rw [div_le_iff₀ (by norm_num)] at hA; linarith)
  have hhi : (0 : ℝ) ≤ Yhi * ((c.B.getD k 0 : ℕ) - 32768 * gsum g i j) :=
    mul_nonneg (Nat.cast_nonneg _) (by rw [le_div_iff₀ (by norm_num)] at hB; linarith)
  have hd1 := natsub_diff (sumR c.L i (j - i)) (c.A.getD k 0)
  have hd2 := natsub_diff (c.B.getD k 0) (sumR c.L i (j - i))
  have e : ∑ r ∈ Finset.range Q, ((((imap (fun r x => Nat.add x (Nat.mul Ylo (ind (inr r i j)))) 0 P).getD r 0 : ℕ) : ℝ)
        - (((imap (fun r x => Nat.add x (Nat.mul Yhi (ind (inr r i j)))) 0 S).getD r 0 : ℕ) : ℝ))
        * (32768 * g r - (c.L.getD r 0 : ℕ))
      = ∑ r ∈ Finset.range Q, (((P.getD r 0 : ℕ) : ℝ) - (S.getD r 0 : ℕ)) * (32768 * g r - (c.L.getD r 0 : ℕ))
        + (Ylo - Yhi) * ∑ r ∈ Finset.range Q, ((ind (inr r i j) : ℕ) : ℝ) * (32768 * g r - (c.L.getD r 0 : ℕ)) := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro r hr
    rw [imap_getD _ _ _ _ (by rw [hP]; simpa using hr), imap_getD _ _ _ _ (by rw [hS]; simpa using hr)]
    simp only [Nat.zero_add, Nat.add_eq, Nat.mul_eq]
    push_cast; ring
  rw [e, hsum]
  simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq]
  push_cast
  have e2 : (Ylo : ℝ) * ((sumR c.L i (j - i) - c.A.getD k 0 : ℕ) : ℝ) - Ylo * ((c.A.getD k 0 - sumR c.L i (j - i) : ℕ) : ℝ)
      = Ylo * ((sumR c.L i (j - i) : ℕ) - (c.A.getD k 0 : ℕ)) := by rw [← mul_sub, hd1]
  have e3 : (Yhi : ℝ) * ((c.B.getD k 0 - sumR c.L i (j - i) : ℕ) : ℝ) - Yhi * ((sumR c.L i (j - i) - c.B.getD k 0 : ℕ) : ℝ)
      = Yhi * ((c.B.getD k 0 : ℕ) - (sumR c.L i (j - i) : ℕ)) := by rw [← mul_sub, hd2]
  nlinarith [e2, e3, hlo, hhi, h0]

/-- the half-space row: `Y` on the slack `32768 (g (Q − 1) − g 0) ≥ 0` -/
theorem half_stepH {Q : ℕ} {PR : List (ℕ × ℕ)} {c : Cl} {P S : List ℕ} {Cp Cm : ℕ} (hQ : 1 ≤ Q)
    (hP : P.length = Q) (hS : S.length = Q) (h : MulOKgH Q PR c P S Cp Cm) (Y : ℕ) :
    MulOKgH Q PR c (imap (fun r x => Nat.add x (Nat.mul Y (ind (inr r (Q - 1) Q)))) 0 P)
      (imap (fun r x => Nat.add x (Nat.mul Y (ind (inr r 0 1)))) 0 S)
      (Nat.add Cp (Nat.mul Y (Nat.sub (c.L.getD (Q - 1) 0) (c.L.getD 0 0))))
      (Nat.add Cm (Nat.mul Y (Nat.sub (c.L.getD 0 0) (c.L.getD (Q - 1) 0)))) := by
  intro g hg hord
  have h0 := h g hg hord
  have e : ∑ r ∈ Finset.range Q, ((((imap (fun r x => Nat.add x (Nat.mul Y (ind (inr r (Q - 1) Q)))) 0 P).getD r 0 : ℕ) : ℝ)
        - (((imap (fun r x => Nat.add x (Nat.mul Y (ind (inr r 0 1)))) 0 S).getD r 0 : ℕ) : ℝ))
        * (32768 * g r - (c.L.getD r 0 : ℕ))
      = ∑ r ∈ Finset.range Q, (((P.getD r 0 : ℕ) : ℝ) - (S.getD r 0 : ℕ)) * (32768 * g r - (c.L.getD r 0 : ℕ))
        + (Y : ℝ) * ∑ r ∈ Finset.range Q, ((ind (inr r (Q - 1) Q) : ℕ) : ℝ) * (32768 * g r - (c.L.getD r 0 : ℕ))
        - (Y : ℝ) * ∑ r ∈ Finset.range Q, ((ind (inr r 0 1) : ℕ) : ℝ) * (32768 * g r - (c.L.getD r 0 : ℕ)) := by
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro r hr
    rw [imap_getD _ _ _ _ (by rw [hP]; simpa using hr), imap_getD _ _ _ _ (by rw [hS]; simpa using hr)]
    simp only [Nat.zero_add, Nat.add_eq, Nat.mul_eq]
    push_cast; ring
  have s1 : ∑ r ∈ Finset.range Q, ((ind (inr r (Q - 1) Q) : ℕ) : ℝ) * (32768 * g r - (c.L.getD r 0 : ℕ))
      = 32768 * g (Q - 1) - (c.L.getD (Q - 1) 0 : ℕ) := by
    simp only [ind_inr, ite_mul, one_mul, zero_mul]
    rw [Finset.sum_eq_single (Q - 1)]
    · rw [if_pos ⟨le_refl _, by omega⟩]
    · intro r _ hr; rw [if_neg]; omega
    · intro hn; exact absurd (Finset.mem_range.mpr (by omega)) hn
  have s0 : ∑ r ∈ Finset.range Q, ((ind (inr r 0 1) : ℕ) : ℝ) * (32768 * g r - (c.L.getD r 0 : ℕ))
      = 32768 * g 0 - (c.L.getD 0 0 : ℕ) := by
    simp only [ind_inr, ite_mul, one_mul, zero_mul]
    rw [Finset.sum_eq_single 0]
    · rw [if_pos ⟨le_refl _, by omega⟩]
    · intro r _ hr; rw [if_neg]; omega
    · intro hn; exact absurd (Finset.mem_range.mpr (by omega)) hn
  rw [e, s1, s0]
  simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq]
  push_cast
  have hd := natsub_diff (c.L.getD (Q - 1) 0) (c.L.getD 0 0)
  have hY0 : (0 : ℝ) ≤ Y := Nat.cast_nonneg _
  have hc : (Y : ℝ) * (((c.L.getD (Q - 1) 0 - c.L.getD 0 0 : ℕ) : ℝ)) - Y * (((c.L.getD 0 0 - c.L.getD (Q - 1) 0 : ℕ) : ℝ))
      = Y * ((c.L.getD (Q - 1) 0 : ℕ) - (c.L.getD 0 0 : ℕ)) := by rw [← mul_sub, hd]
  nlinarith [h0, hc, mul_nonneg hY0 (sub_nonneg.mpr hord)]

/-- `mcheckGX_sound` with the half-space row (the same proof; `g (Q − 1) < g 0` is the reflection disjunct) -/
theorem mcheckGX_soundH {ok : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Bool} {top : ℕ} {bk : ℕ → ℕ} {f : ℕ → ℕ}
    (hok : ∀ (L0 L U k m p r : ℕ), L0 ≤ L → ok L U k m p r = true → ∀ s : ℝ, (L : ℝ) / SC ≤ s → s ≤ (U : ℝ) / SC →
      ∃ D : ℝ, (mslT f k m p r : ℝ) - 2000000000 * (mwT k m : ℝ) ≤ 1000000000 * D ∧
        32768 * (mvT top bk f L (uc L U) k m p r : ℝ) + 327680000000000 * (D * (s - (L0 : ℝ) / 32768))
          + 10 * (mcpT f L0 k m p r : ℝ) - 10 * (mcnT f L0 k m p r : ℝ) ≤ 327680000000000 * 1024 * wfun s)
    {Q : ℕ} {PR : List (ℕ × ℕ)} {bs : List ℕ} {TS : List Term} {cN : ℕ} (hPR : PRok Q PR) (hTS : TSok Q PR TS)
    {c : Cl} {FS : List Term} {P S : List ℕ} {Cp Cm : ℕ} (hY : MulOKgH Q PR c P S Cp Cm)
    (h : mcheckGX ok top bk f Q bs TS cN c FS P S Cp Cm = true) : CovBy Q PR (Pg cN Q bs TS) c := by
  intro g hg
  rcases lt_or_ge (g (Q - 1)) (g 0) with hlt | hle
  · exact Or.inr hlt
  left
  unfold mcheckGX at h
  obtain ⟨hpre, hmain⟩ := brec_and h
  obtain ⟨hbox, hterm⟩ := brec_and hpre
  have hbox' := iall_true hbox
  have hterm' := iall_true hterm
  rw [Nat.ble_eq] at hmain
  set NT := TS.length with hNT
  -- the per-term anchored minorants
  have hT : ∀ n, n < NT → ∃ D : ℝ,
      (mslT f (tI FS n) (tJ FS n) (tA FS n) (tK FS n) : ℝ) - 2000000000 * (mwT (tI FS n) (tJ FS n) : ℝ) ≤ 1000000000 * D ∧
      32768 * (mvT top bk f (eL TS c n) (uc (eL TS c n) (eU TS c n)) (tI FS n) (tJ FS n) (tA FS n) (tK FS n) : ℝ)
        + 327680000000000 * (D * (gsum g (tI TS n) (tJ TS n) - (eL0 TS c n : ℝ) / 32768))
        + 10 * (mcpT f (eL0 TS c n) (tI FS n) (tJ FS n) (tA FS n) (tK FS n) : ℝ)
        - 10 * (mcnT f (eL0 TS c n) (tI FS n) (tJ FS n) (tA FS n) (tK FS n) : ℝ)
        ≤ 327680000000000 * 1024 * wfun (gsum g (tI TS n) (tJ TS n)) := by
    intro n hn
    obtain ⟨h0, h1, h2⟩ := term_range hPR hTS hg hn
    exact hok _ _ _ _ _ _ _ h0 (hterm' n hn) _ h1 h2
  choose! D hD1 hD2 using hT
  -- shorthand
  set a : ℕ → ℝ := fun n => ((tA TS n : ℕ) : ℝ) with ha
  set e : ℕ → ℝ := fun r => g r - ((c.L.getD r 0 : ℕ) : ℝ) / 32768 with he
  set ind : ℕ → ℕ → Prop := fun n r => tI TS n ≤ r ∧ r < tJ TS n with hind
  set DD : ℕ → ℝ := fun r => ∑ n ∈ Finset.range NT, if tI TS n ≤ r ∧ r < tJ TS n then a n * D n else 0 with hDD
  have ha0 : ∀ n, 0 ≤ a n := fun n => Nat.cast_nonneg _
  -- (S1) the weighted term bounds
  have S1 : 32768 * ∑ n ∈ Finset.range NT, a n * (mvT top bk f (eL TS c n) (uc (eL TS c n) (eU TS c n)) (tI FS n) (tJ FS n) (tA FS n) (tK FS n) : ℝ)
      + 327680000000000 * ∑ n ∈ Finset.range NT, a n * (D n * (gsum g (tI TS n) (tJ TS n) - (eL0 TS c n : ℝ) / 32768))
      + 10 * ∑ n ∈ Finset.range NT, a n * (mcpT f (eL0 TS c n) (tI FS n) (tJ FS n) (tA FS n) (tK FS n) : ℝ)
      - 10 * ∑ n ∈ Finset.range NT, a n * (mcnT f (eL0 TS c n) (tI FS n) (tJ FS n) (tA FS n) (tK FS n) : ℝ)
      ≤ 327680000000000 * 1024 * ∑ n ∈ Finset.range NT, a n * wfun (gsum g (tI TS n) (tJ TS n)) := by
    have := Finset.sum_le_sum fun n (hn : n ∈ Finset.range NT) =>
      mul_le_mul_of_nonneg_left (hD2 n (Finset.mem_range.mp hn)) (ha0 n)
    simp only [Finset.mul_sum]
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine le_trans (le_of_eq ?_) (this.trans (le_of_eq ?_))
    · apply Finset.sum_congr rfl; intro n _; ring
    · apply Finset.sum_congr rfl; intro n _; ring
  -- (S2) regrouping the slopes by gap
  have S2 : ∑ n ∈ Finset.range NT, a n * (D n * (gsum g (tI TS n) (tJ TS n) - (eL0 TS c n : ℝ) / 32768))
      = ∑ r ∈ Finset.range Q, e r * DD r := by
    have hx : ∀ n ∈ Finset.range NT, a n * (D n * (gsum g (tI TS n) (tJ TS n) - (eL0 TS c n : ℝ) / 32768))
        = ∑ r ∈ Finset.range Q, if tI TS n ≤ r ∧ r < tJ TS n then e r * (a n * D n) else 0 := by
      intro n hn
      obtain ⟨hij, hjQ, -⟩ := hTS n (Finset.mem_range.mp hn)
      rw [span_eq (Q := Q) g hij.le hjQ, Finset.mul_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl; intro r _
      split_ifs <;> ring
    rw [Finset.sum_congr rfl hx, Finset.sum_comm]
    apply Finset.sum_congr rfl; intro r _
    rw [hDD, Finset.mul_sum]
    apply Finset.sum_congr rfl; intro n _
    split_ifs <;> ring
  -- (S3) per gap: the slope charge bounds the slope from below, then `gap_lo`
  have S3 : ∀ r ∈ Finset.range Q, -(10 * (((Ng f bs TS FS P S r : ℕ) : ℝ) * ((c.U.getD r 0 - c.L.getD r 0 : ℕ) : ℝ)))
      ≤ 327680000000000 * ((1024 * ((bs.getD r 0 : ℕ) : ℝ) + DD r - (((P.getD r 0 : ℕ) : ℝ) - (S.getD r 0 : ℕ)) / 1000000000) * e r) := by
    intro r hr
    have hr' := Finset.mem_range.mp hr
    have hlu : c.L.getD r 0 ≤ c.U.getD r 0 := Nat.le_of_ble_eq_true (hbox' r hr')
    have hgr := hg.1 r hr'
    have hSCe : (SC : ℝ) = 32768 := by norm_num [SC]
    rw [hSCe] at hgr
    refine gap_lo (natsub_nonneg _ _) ?_ (by simp only [he]; linarith [hgr.1]) ?_
    · -- `−N_r ≤ 10⁹ E_r`
      refine neg_natsub_le ?_
      simp only [Nat.add_eq, Nat.mul_eq]
      push_cast
      rw [isum_cast, isum_cast]
      simp only [brec0_cast, inr_true]
      have hsum : ∑ n ∈ Finset.range NT, (if tI TS n ≤ r ∧ r < tJ TS n then ((tA TS n * mslT f (tI FS n) (tJ FS n) (tA FS n) (tK FS n) : ℕ) : ℝ) else 0)
          - 2000000000 * ∑ n ∈ Finset.range NT, (if tI TS n ≤ r ∧ r < tJ TS n then ((tA TS n * mwT (tI FS n) (tJ FS n) : ℕ) : ℝ) else 0)
          ≤ 1000000000 * DD r := by
        rw [hDD, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
        apply Finset.sum_le_sum; intro n hn
        split_ifs
        · push_cast
          have := mul_le_mul_of_nonneg_left (hD1 n (Finset.mem_range.mp hn)) (ha0 n)
          simp only [ha] at this; nlinarith [this]
        · simp
      linarith
    · rw [Nat.cast_sub hlu, sub_div]; simp only [he]; linarith [hgr.2]
  -- (S4) the multipliers
  have S4 := hY g hg hle
  have S4' : ∑ r ∈ Finset.range Q, (((P.getD r 0 : ℕ) : ℝ) - (S.getD r 0 : ℕ)) * (32768 * g r - (c.L.getD r 0 : ℕ))
      = 32768 * ∑ r ∈ Finset.range Q, (((P.getD r 0 : ℕ) : ℝ) - (S.getD r 0 : ℕ)) * e r := by
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro r _; simp only [he]; ring
  -- (S5) the main inequality, as reals
  have S5 := (Nat.cast_le (α := ℝ)).mpr hmain
  simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq] at S5
  push_cast at S5
