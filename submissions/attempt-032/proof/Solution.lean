    rw [realizedWeight, hzero, zero_pow (by omega : 2 ≠ 0), mul_zero]
    exact mul_nonneg (by norm_num) (Pantera.gMaj_nonneg s)
def realKernel (P : Params) (T γ γ' : ℝ) : ℝ :=
  ((AMW.atAM P T).a T * P.L T ^ 2)⁻¹ *
