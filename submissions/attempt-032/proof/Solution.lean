      intro i j
      simp only [realKernel, Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun k _ => ?_
      dsimp [F, a, L]
      push_cast
      ring
    rw [Finset.mul_sum]
    calc
      _ = ∑ i, ∑ j, ∑ k : Fin (P.d T), (a * L ^ 2)⁻¹ *
