namespace BHB.MTP
open BHB.MT
theorem _root_.Taper78.BHB.MTP.leadPoly_approx {θ : ℝ} (hθ : 0 < θ) (c : ℝ) : ∃ K : ℝ, 0 ≤ K ∧ ∀ L : ℝ, 1 ≤ L →
    |Taper78.BHB.MTP.leadPoly (L - c) (θ * L) - -(Taper78.BHB.cP θ) / 2 * L ^ 3| ≤ K * L ^ 2 := by
  set a2 : ℝ := -(4 * c * 3007 / (20000 * θ)) - 3 * c / 12 + 21958 * θ * c / 150000 + 3969 * θ ^ 2 * c / 20000
    with ha2
  set a1 : ℝ := 6 * c ^ 2 * 3007 / (20000 * θ) + 3 * c ^ 2 / 12 - 10979 * θ * c ^ 2 / 150000 with ha1
  set a0 : ℝ := -(4 * c ^ 3 * 3007 / (20000 * θ)) - c ^ 3 / 12 with ha0
  set am : ℝ := c ^ 4 * 3007 / (20000 * θ) with ham
  refine ⟨|a2| + |a1| + |a0| + |am|, by positivity, fun L hL => ?_⟩
  have hL0 : 0 < L := by linarith
  have e : Taper78.BHB.MTP.leadPoly (L - c) (θ * L) - -(Taper78.BHB.cP θ) / 2 * L ^ 3 = a2 * L ^ 2 + a1 * L + a0 + am / L := by
    rw [← Taper78.BHB.MTP.leadPoly_diag hθ.ne' hL0.ne']
    unfold Taper78.BHB.MTP.leadPoly
    rw [ha2, ha1, ha0, ham]
    field_simp
    ring
  rw [e]
  have hL2 : L ≤ L ^ 2 := by nlinarith
  have h1L2 : (1 : ℝ) ≤ L ^ 2 := by nlinarith
  have hinv : 1 / L ≤ L ^ 2 := by
    rw [div_le_iff₀ hL0]
    nlinarith
  have b2 : |a2 * L ^ 2| = |a2| * L ^ 2 := by
    rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ L ^ 2)]
  have b1 : |a1 * L| ≤ |a1| * L ^ 2 := by
    rw [abs_mul, abs_of_pos hL0]
    exact mul_le_mul_of_nonneg_left hL2 (abs_nonneg _)
  have b0 : |a0| ≤ |a0| * L ^ 2 := by
    have := mul_le_mul_of_nonneg_left h1L2 (abs_nonneg a0)
    linarith
  have bm : |am / L| ≤ |am| * L ^ 2 := by
    rw [abs_div, abs_of_pos hL0, div_eq_mul_one_div]
    exact mul_le_mul_of_nonneg_left hinv (abs_nonneg _)
