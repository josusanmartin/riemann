theorem _root_.Taper78.BHB.MTP.JJlead_eq (κ θ T : ℝ) :
    Taper78.BHB.MTP.JJlead κ θ T = fun α ν β w => ((κ : ℂ) * (2 * π * I)⁻¹) * sqInt (4 * rhoT T) (fun ε =>
      exp (ε * (L0 T : ℝ)) * (Zl ε α ν β * Taper78.BHB.MTP.SSlead (Real.log (ymol θ T)) ε α ν β w)) := by
  funext α ν β w
  unfold Taper78.BHB.MTP.JJlead
  ring
end BHB.MTP
