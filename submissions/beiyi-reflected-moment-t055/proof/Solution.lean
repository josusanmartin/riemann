open BHB.MT
theorem _root_.Taper78.BHB.MTP.polyCont_JJlead (κ θ : ℝ) {T : ℝ} (hT : 1 < T) : PolyCont (rhoT T) (Taper78.BHB.MTP.JJlead κ θ T) := by
  have hρ := rhoT_pos hT
  rw [Taper78.BHB.MTP.JJlead_eq]
  exact (polyCont_sqInt (by positivity)
    (Taper78.BHB.MTP.continuousOn_Glead_kernel hρ (Real.log (ymol θ T)) (L0 T))).const_mul _
end BHB.MTP
namespace BHB.MTP
open BHB.MT
theorem _root_.Taper78.BHB.MTP.DDc_JJlead (κ : ℝ) {θ : ℝ} (hθ : 0 < θ) {T : ℝ} (hT : 1 < T) :
    DDc (rhoT T) (Taper78.BHB.MTP.JJlead κ θ T) = (κ : ℂ) * (Taper78.BHB.MTP.leadPoly (L0 T) (Real.log (ymol θ T)) : ℂ) := by
  have hρ := rhoT_pos hT
  have hr : (0 : ℝ) < 4 * rhoT T := by positivity
  have hly : 0 < Real.log (ymol θ T) := by
    rw [log_ymol (by linarith) θ]
    exact mul_pos hθ (Real.log_pos hT)
  rw [Taper78.BHB.MTP.JJlead_eq, DDc_const_mul,
    DDc_sqInt hρ hr.le (Taper78.BHB.MTP.continuousOn_Glead_kernel hρ (Real.log (ymol θ T)) (L0 T))]
  have e : sqInt (4 * rhoT T) (fun ε => DDc (rhoT T) (fun α ν β w =>
        exp (ε * (L0 T : ℝ)) * (Zl ε α ν β * Taper78.BHB.MTP.SSlead (Real.log (ymol θ T)) ε α ν β w)))
      = sqInt (4 * rhoT T) (fun ε => exp (ε * (L0 T : ℝ)) * Taper78.BHB.MTP.Xi (Real.log (ymol θ T)) ε) := by
    apply sqInt_congr hr.le
    intro ε hε
    have h4 : 4 * rhoT T ≤ ‖ε‖ := norm_ge_of_mem_sqBdy hε
    rw [DDc_const_mul, Taper78.BHB.MTP.DDc_Glead hly hρ (by linarith)]
  rw [e, mul_assoc, Taper78.BHB.MTP.sqInt_exp_Xi hr hly.ne']
end BHB.MTP
