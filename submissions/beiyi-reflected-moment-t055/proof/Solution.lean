section Src_ReflectedDerivative

noncomputable section
open BHB BHB.Red PrincipalBand ReflectedExplicit
open scoped BigOperators

namespace ReflectedDerivative

/-- The error in replacing the true derivative by minus its Dirichlet
polynomial. The constant is uniform over all twists with the specified norm. -/
theorem perturbation (hRH : RiemannHypothesis) (w : Weight) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {T M : ℝ}, 2 ≤ T → 0 ≤ M → ∀ V : ℂ → ℂ,
      (∀ ρ : Zeta23.zetaZeroConfig.carrier, ‖V ρ‖ ≤ M) →
      ‖zsum w.h T (fun s => (deriv riemannZeta s+Dtr (Xtr T) s)*V s)‖ ≤ C*M := by
  obtain ⟨P,hP,hp⟩ := S2DAux.ptr_bounds
  obtain ⟨E,hE,he⟩ := S2DAux.Etr_bounds
  obtain ⟨Z,hz⟩ := S2DAux.zero_sum_Dfn w
  refine ⟨(P+E)*|Z|,by positivity,fun {T M} hT hM V hV => ?_⟩
  let K := (P+E)*M
  have hK : 0 ≤ K := by dsimp [K]; positivity
  have hT₀ : 0 < T := by linarith
  have hpoint (ρ : Zeta23.zetaZeroConfig.carrier) :
      ‖(deriv riemannZeta ρ+Dtr (Xtr T) ρ)*V ρ‖ ≤ K*S2DAux.Dfn T (ρ:ℂ).im := by
    let t := (ρ:ℂ).im
    have h₁ := (hp T hT t).1
    have h₂ := (he T hT t).1
    rw [show (1/2+(t:ℂ)*Complex.I)=(ρ:ℂ) from (zero_eq hRH ρ).symm] at h₁ h₂
    let A := T^2/(1+|t|)^4
    let B := (1+|t|)/T^3+(1+|t|)^4*(if T^(5/4:ℝ) < |t| then 1 else 0)
    have ha : 0 ≤ A := by dsimp [A]; positivity
    have hb : 0 ≤ B := by dsimp [B]; have := S2DAux.ind_nonneg T t; positivity
    have hu : 1 ≤ 1+|t| := le_add_of_nonneg_right (abs_nonneg _)
    have hv (q : ℂ) : ‖q‖ ≤ (1+|t|)*‖q‖ := le_mul_of_one_le_left (norm_nonneg _) hu
    rw [deriv_zeta_eq,show -Dtr (Xtr T) ρ+ptr (Xtr T) ρ+Etr (Xtr T) ρ+Dtr (Xtr T) ρ=
      ptr (Xtr T) ρ+Etr (Xtr T) ρ by ring,norm_mul]
    apply (mul_le_mul ((norm_add_le ..).trans (add_le_add ((hv _).trans h₁) ((hv _).trans h₂))) (hV ρ)
      (norm_nonneg _) (add_nonneg (mul_nonneg hP ha) (mul_nonneg hE hb))).trans
    have hmain : P*A+E*B ≤ (P+E)*(A+B) := by nlinarith only [mul_nonneg hE ha,mul_nonneg hP hb]
    have hid : S2DAux.Dfn T (ρ:ℂ).im=A+B := by dsimp [S2DAux.Dfn,A,B,t]; ring
    rw [hid]
    exact (mul_le_mul_of_nonneg_right hmain hM).trans_eq (by unfold K; ring)
  have hs := (hz T hT).1
  have hscale (ρ : Zeta23.zetaZeroConfig.carrier) : (Zeta23.zeroMult ρ:ℝ)*
      (K*S2DAux.Dfn T (ρ:ℂ).im)*w.h ((ρ:ℂ).im/T)=
      K*((Zeta23.zeroMult ρ:ℝ)*S2DAux.Dfn T (ρ:ℂ).im*w.h ((ρ:ℂ).im/T)) := by ring
  have hsum := (norm_zsum_le w (F:=fun s => (deriv riemannZeta s+Dtr (Xtr T) s)*V s)
    (g:=fun s => K*S2DAux.Dfn T s.im) hpoint ((hs.mul_left K).congr (fun ρ => (hscale ρ).symm))).2
  rw [tsum_congr hscale,tsum_mul_left] at hsum
  exact hsum.trans ((mul_le_mul_of_nonneg_left ((hz T hT).2.trans (le_abs_self _)) hK).trans_eq (by unfold K; ring))

def poly (r : Finset ℕ) (c : ℕ → ℝ) (s : ℂ) := ∑ n ∈ r, (c n:ℂ)*(n:ℂ)^(-s)
def twist (z T : ℝ) (s : ℂ) :=
  poly (Krange theta T) (mollifier (taper z) (Real.log T)) s*
    (starRingEnd ℂ) (poly (band (Real.log T) (1/2) topExponent) (label topExponent (Real.log T)) s)

private lemma twist_norm (hRH : RiemannHypothesis) {T z : ℝ} (hT : 1 < T) (hz : z ∈ Set.Icc (0:ℝ) 1)
    (ρ : Zeta23.zetaZeroConfig.carrier) : ‖twist z T ρ‖ ≤ 4*T := by
  let L := Real.log T
  have h₀ := zero_lt_one.trans hT
  have hk (k : ℕ) (hk : k ∈ Krange theta T) : |mollifier (taper z) L k| ≤ 1 := by
    have hm : k ∈ ReflectedPrincipal.below (Real.exp (L*theta)) :=
      Finset.mem_Ioc.mpr ⟨(Finset.mem_Icc.mp hk).1,by rw [← Real.rpow_def_of_pos h₀]; exact (Finset.mem_Icc.mp hk).2⟩
    rw [mollifier,abs_mul]
    exact mul_le_one₀ (by exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n:=k))
      (abs_nonneg _) (taper_bound hz _ (ReflectedLogBand.log_mem (Real.log_pos hT) hm))
  have hsub : band L (1/2) topExponent ⊆ Krange topExponent T := by
    intro p hp
    have h := Finset.mem_Ioc.mp (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).1
    exact Finset.mem_Icc.mpr ⟨h.1,by simpa only [ymol,Real.rpow_def_of_pos h₀] using h.2⟩
  have hb := LowBand.BoundsAux.norm_sum_le_of_subset h₀.le zero_le_one subset_rfl _ hk (ρ:ℂ).im
  have hv := LowBand.BoundsAux.norm_sum_le_of_subset h₀.le zero_le_one hsub _
    (fun p hp => ReflectedLogBand.label_bound (Real.log_pos hT) (by norm_num [topExponent]) hp) (ρ:ℂ).im
  rw [← zero_eq hRH ρ] at hb hv
  rw [twist,norm_mul,Complex.norm_conj]
  apply (mul_le_mul hb hv (norm_nonneg _) (by positivity)).trans
  have hex : T^(theta/2)*T^(topExponent/2) ≤ T := by
    rw [← Real.rpow_add h₀]
    exact (Real.rpow_le_rpow_of_exponent_le hT.le (show theta/2+topExponent/2 ≤ 1 by norm_num [theta,topExponent])).trans_eq (Real.rpow_one T)
  linarith only [hex]

/-- Exact identification of the truncated zero sum with the reflected trace. -/
theorem trace_identity (hRH : RiemannHypothesis) (w : Weight) {T : ℝ} (hT : 0 < T) (z : ℝ) :
    zsum w.h T (fun s => Dtr (Xtr T) s*twist z T s)=
      sumRows (taper z) T theta (1/2) topExponent (zeroRow w T) := by
  let K := Krange theta T
  let P := band (Real.log T) (1/2) topExponent
  let D := Mrange (Xtr T)
  let S := K ×ˢ (P ×ˢ D)
  let a := mollifier (taper z) (Real.log T)
  let b := label topExponent (Real.log T)
  let c := dco (Xtr T)
  let coef (i : ℕ × ℕ × ℕ) := ((a i.1*b i.2.1*c i.2.2 : ℝ):ℂ)
  let atom (i : ℕ × ℕ × ℕ) (s : ℂ) := ((i.2.2*i.1:ℕ):ℂ)^(-s)*(starRingEnd ℂ) ((i.2.1:ℂ)^(-s))
  have hfun : (fun s => Dtr (Xtr T) s*twist z T s) = fun s => ∑ i ∈ S, coef i*atom i s := by
    funext s
    unfold Dtr twist poly
    simp only [map_sum,map_mul,Complex.conj_ofReal]
    change (∑ m ∈ D, (c m:ℂ)*(m:ℂ)^(-s))*((∑ k ∈ K,(a k:ℂ)*(k:ℂ)^(-s))*
      (∑ p ∈ P,(b p:ℂ)*(starRingEnd ℂ) ((p:ℂ)^(-s))))=_
    rw [mul_comm,Finset.sum_mul_sum,Finset.sum_mul]
    dsimp only [S]
    rw [Finset.sum_product]
    apply Finset.sum_congr rfl
    intro k _
    rw [Finset.sum_mul,Finset.sum_product]
    apply Finset.sum_congr rfl
    intro p _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro m _
    dsimp [coef,atom]
    rw [Nat.cast_mul,Complex.natCast_mul_natCast_cpow]
    push_cast; ring
  have hpos (i : ℕ × ℕ × ℕ) (hi : i ∈ S) : 1 ≤ i.2.2*i.1 ∧ 1 ≤ i.2.1 := by
    obtain ⟨hk,hp,hm⟩ := Finset.mem_product.mp hi |>.imp_right Finset.mem_product.mp
    exact ⟨Nat.mul_pos (Finset.mem_Icc.mp hm).1 (Finset.mem_Icc.mp hk).1,
      (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).2.pos⟩
  rw [hfun,S1Aux.zsum_finset_sum w.h T S coef atom (fun i hi =>
    (zsum_cpow_mul_conj hRH w hT (hpos i hi).1 (hpos i hi).2).1)]
  dsimp only [S]
  rw [Finset.sum_product]
  unfold sumRows
  apply Finset.sum_congr rfl
  intro k hk
  rw [Finset.sum_product]
  apply Finset.sum_congr rfl
  intro p hp
  unfold zeroRow
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro m hm
  have hi : (k,p,m) ∈ S := Finset.mem_product.mpr ⟨hk,Finset.mem_product.mpr ⟨hp,hm⟩⟩
  dsimp only [atom]
  rw [(zsum_cpow_mul_conj hRH w hT (hpos _ hi).1 (hpos _ hi).2).2]
  dsimp only [coef,a,b,c]
  push_cast; ring

/-- The height-weighted mixed sum with the actual zeta derivative and
the ordinary primes between sqrt(T) and T^.999. -/
def trueTrace (z : ℝ) (w : Weight) (T : ℝ) :=
  zsum w.h T (fun s => deriv riemannZeta s*twist z T s)

private lemma summable_true (hRH : RiemannHypothesis) (w : Weight) {T z : ℝ}
    (hT : 2 ≤ T) (hz : z ∈ Set.Icc (0:ℝ) 1) :
    Summable (fun ρ : Zeta23.zetaZeroConfig.carrier => (Zeta23.zeroMult ρ:ℂ)*
      (deriv riemannZeta ρ*twist z T ρ)*(w.h ((ρ:ℂ).im/T):ℂ)) := by
  have hv := twist_norm hRH (show 1 < T by linarith) hz
  obtain ⟨B,hB⟩ := norm_deriv_zeta_le
  exact summable_zsum_of_poly w hT (F:=fun s => deriv riemannZeta s*twist z T s)
    (M:=B*(4*T)) 1 (fun ρ => by
      have h := hB (ρ:ℂ).im
      rw [← zero_eq hRH ρ] at h
      rw [norm_mul,pow_one]
      exact (mul_le_mul h (hv ρ) (norm_nonneg _) ((norm_nonneg _).trans h)).trans_eq (by ring))

theorem transfer (hRH : RiemannHypothesis) (w : Weight) {z : ℝ} (hz : z ∈ Set.Icc (0:ℝ) 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {T : ℝ}, 2 ≤ T →
      ‖trueTrace z w T + sumRows (taper z) T theta (1/2) topExponent (zeroRow w T)‖ ≤ C*T := by
  obtain ⟨C,hC,hc⟩ := perturbation hRH w
  refine ⟨4*C,by positivity,fun {T} hT => ?_⟩
  have h₁ : 1 < T := by linarith
  have h₀ := zero_lt_one.trans h₁
  have hv := twist_norm hRH h₁ hz
  have hs := summable_true hRH w hT hz
  have hd := summable_zsum_of_poly w hT (F:=fun s => Dtr (Xtr T) s*twist z T s)
    (M:=(∑ m ∈ Mrange (Xtr T), dco (Xtr T) m)*(4*T)) 0 (fun ρ => by
      rw [norm_mul,pow_zero,mul_one]
      exact mul_le_mul (S1Aux.norm_Dtr_le _ (S1Aux.zero_re hRH ρ)) (hv ρ) (norm_nonneg _)
        (Finset.sum_nonneg fun m _ => dco_nonneg _ m))
  rw [← trace_identity hRH w h₀ z,trueTrace,zsum,zsum,← hs.tsum_add hd]
  have hid : (∑' ρ : Zeta23.zetaZeroConfig.carrier,
      ((Zeta23.zeroMult ρ:ℂ)*(deriv riemannZeta ρ*twist z T ρ)*(w.h ((ρ:ℂ).im/T):ℂ)+
      (Zeta23.zeroMult ρ:ℂ)*(Dtr (Xtr T) ρ*twist z T ρ)*(w.h ((ρ:ℂ).im/T):ℂ))) =
      zsum w.h T (fun s => (deriv riemannZeta s+Dtr (Xtr T) s)*twist z T s) :=
    tsum_congr fun ρ => by dsimp only; ring
  rw [hid]
  exact (hc hT (by positivity) _ hv).trans_eq (by ring)

def highPrimes (T : ℝ) := poly (band (Real.log T) (1/2) topExponent) (label topExponent (Real.log T))

theorem high_sum_for (hRH : RiemannHypothesis) (w : Weight) {P : ℝ → ℝ} {z : ℝ}
    (hz : z ∈ Set.Icc (0:ℝ) 1) (hP : ∀ x, P x=(1+z)*x-z*x^2) {T : ℝ} (hT : 2 ≤ T) :
    HasSum (fun ρ : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T ρ*
      (LowBand.molP P theta T ρ*(starRingEnd ℂ) (highPrimes T ρ)).re)
      ((trueTrace z w T).re/Real.log T) := by
  have hfun (s : ℂ) : poly (Krange theta T) (mollifier (taper z) (Real.log T)) s =
      LowBand.BmolP P theta T s := by
    apply Finset.sum_congr rfl
    intro k hk
    have hk₁ : (0:ℝ) < k := by exact_mod_cast (Finset.mem_Icc.mp hk).1
    have ht₀ : 0 < T := by linarith
    have ht : Real.log T ≠ 0 := (Real.log_pos (by linarith)).ne'
    have hθ : theta ≠ 0 := by norm_num [theta]
    have hid : (Real.log (ymol theta T/k)/Real.log (ymol theta T))=1-Real.log k/Real.log T/theta := by
      rw [ymol,Real.log_div (Real.rpow_pos_of_pos ht₀ _).ne' hk₁.ne',Real.log_rpow ht₀]
      field_simp
    have he : mollifier (taper z) (Real.log T) k=LowBand.bcoefP P theta T k := by
      rw [mollifier,LowBand.bcoefP,hid,taper,hP]; ring
    rw [he]
  have h := (Complex.hasSum_re (summable_true hRH w hT hz).hasSum).div_const (Real.log T)
  apply h.congr_fun
  intro ρ
  rw [LowBand.molP]
  change TMA.cw _ _ _*(deriv riemannZeta ρ/(Real.log T:ℂ)*LowBand.BmolP _ theta T ρ*
    (starRingEnd ℂ) (highPrimes T ρ)).re=_
  rw [show deriv riemannZeta ρ/(Real.log T:ℂ)*LowBand.BmolP P theta T ρ*(starRingEnd ℂ) (highPrimes T ρ)=
    (deriv riemannZeta ρ*twist z T ρ)/(Real.log T:ℂ) by rw [twist,hfun]; unfold highPrimes; ring]
  rw [Complex.div_ofReal_re]
  simp only [TMA.cw,Complex.mul_re,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im,
    Complex.natCast_re,Complex.natCast_im,mul_zero,zero_mul,sub_zero]
  ring

private lemma high_sum (hRH : RiemannHypothesis) (w : Weight) {T : ℝ} (hT : 2 ≤ T) :
    HasSum (fun ρ : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T ρ*
      (ShortProbe.RealResidual.mollified T ρ*(starRingEnd ℂ) (highPrimes T ρ)).re)
      ((trueTrace (39/50) w T).re/Real.log T) := by
  rw [← LowBand.molP_taper78]
  exact high_sum_for hRH w (by constructor <;> norm_num : (39/50:ℝ) ∈ Set.Icc 0 1)
    (fun x => by unfold LowBand.taper78; ring) hT

open LowBand ReflectedCovered ShortProbe.RealResidual in
/-- The mixed moment for both covered ranges with the true zeta derivative. -/
theorem actual_mixed (hRH : RiemannHypothesis) (w : Weight) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ T : ℝ in Filter.atTop, ∃ v : ℝ,
      HasSum (fun ρ : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T ρ*
        (mollified T ρ*(starRingEnd ℂ) ((106/25:ℂ)*(probeLow 0.999 lengthExponent T ρ+highPrimes T ρ)-shortPrimes T ρ)).re) v ∧
      |v-w.kap1*coveredCoefficient*TMA.Dsc T| ≤ ε*TMA.Dsc T := by
  let a : ℝ := 106/25
  have ha : 0 < a := by norm_num [a]
  obtain ⟨C,hC,htr⟩ := transfer hRH w (z:=39/50) (by constructor <;> norm_num)
  filter_upwards [covered_mixed hRH w (show 0 < ε/2 by positivity),Filter.eventually_ge_atTop (2:ℝ),
    ReflectedLogBand.scales (by norm_num : (0:ℝ)<1),
    Real.tendsto_log_atTop.eventually_ge_atTop (4*Real.pi*a*C/ε)] with T hmix hT hs hbig
  obtain ⟨v,hv,hm⟩ := hmix
  let t := (trueTrace (39/50) w T).re/Real.log T
  have hL : 0 < Real.log T := by linarith [hs.1]
  have ht := hs.2.2.2
  have hdiff : |t-highTrace w T| ≤ C*T := by
    have h := (Complex.abs_re_le_norm _).trans (htr hT)
    rw [Complex.add_re] at h
    rw [show t-highTrace w T=((trueTrace (39/50) w T).re+
      (sumRows (taper (39/50)) T theta (1/2) topExponent (zeroRow w T)).re)/Real.log T by
      dsimp [t,highTrace]; ring,abs_div,abs_of_pos hL,div_le_iff₀ hL]
    exact h.trans (le_mul_of_one_le_right (mul_nonneg hC ht.le) hs.1)
  refine ⟨v+a*t,(hv.add ((high_sum hRH w hT).mul_left a)).congr_fun ?_,?_⟩
  · intro ρ
    let b := mollified T ρ
    let u := shortPrimes T ρ
    let W := probeLow 0.999 lengthExponent T ρ
    let H := highPrimes T ρ
    let d := TMA.cw w.h T ρ
    change d*(b*(starRingEnd ℂ) ((106/25:ℂ)*(W+H)-u)).re=
      d*(b*(starRingEnd ℂ) ((106/25:ℂ)*W-u)).re+a*(d*(b*(starRingEnd ℂ) H).re)
    have he : (106/25:ℂ)*(W+H)-u=((106/25:ℂ)*W-u)+(a:ℂ)*H := by dsimp [a]; push_cast; ring
    rw [he,map_add,map_mul,Complex.conj_ofReal,mul_add,Complex.add_re,mul_left_comm b (a:ℂ)]
    simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]
    ring
  · have hcharge : a*(C*T) ≤ ε/2*TMA.Dsc T := by
      calc a*(C*T) = (4*Real.pi*a*C)*T/(4*Real.pi) := by field_simp
           _ ≤ (Real.log T*ε)*T/(4*Real.pi) :=
             div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right ((div_le_iff₀ hε).mp hbig) ht.le) (by positivity)
           _ = _ := by dsimp only [TMA.Dsc]; ring
    rw [show v+a*t-w.kap1*coveredCoefficient*TMA.Dsc T=
      (v+(106/25)*highTrace w T-w.kap1*coveredCoefficient*TMA.Dsc T)+a*(t-highTrace w T) by dsimp only [a]; ring]
    apply (abs_add_le ..).trans
    rw [abs_mul,abs_of_pos ha]
    exact (add_le_add hm ((mul_le_mul_of_nonneg_left hdiff ha.le).trans hcharge)).trans_eq (by ring)

end ReflectedDerivative
end
end Src_ReflectedDerivative

section Src_ReflectedStrip

noncomputable section
open LowBand ReflectedDerivative ReflectedCovered ShortProbe.RealResidual PrincipalBand

namespace ReflectedStrip

def profile (x : ℝ) := (1-x/0.999)/0.999
def stripPrimitive (x : ℝ) :=
  let I := (63/100)*theta
  primitive ((1/2+I)/topExponent) ((-1-I)/topExponent-(1/2+I)/topExponent^2)
    ((-1/2)/topExponent+(1+I)/topExponent^2) ((1/2)/topExponent^2) x

def coefficient (r : ℝ) := coveredCoefficient+(106/25)*(stripPrimitive r-stripPrimitive theta)

private def data : LowBand.Data :=
  ⟨taper78,profile,theta,theta,by unfold taper78; fun_prop,by unfold profile; fun_prop,
    by norm_num [theta],by norm_num [theta],by norm_num [theta],by norm_num [theta]⟩

/-- Exact change of the ordinary-prime contribution as the upper low-band
endpoint increases. The density formula agrees at the mollifier endpoint. -/
theorem low_change {r : ℝ} (hr : theta ≤ r) :
    lowConst taper78 profile theta r-lowConst taper78 profile theta theta=stripPrimitive r-stripPrimitive theta := by
  have hc : Continuous profile := by unfold profile; fun_prop
  have hi (a b : ℝ) : IntervalIntegrable (fun x => profile x*LowBand.density taper78 theta x) MeasureTheory.volume a b :=
    (intervalIntegrable_density data a b).continuousOn_mul hc.continuousOn
  unfold lowConst
  rw [← intervalIntegral.integral_add_adjacent_intervals (hi 0 theta) (hi theta r),add_sub_cancel_left]
  let I := (63/100)*theta
  let A := (1/2+I)/topExponent
  let B := (-1-I)/topExponent-(1/2+I)/topExponent^2
  let C := (-1/2)/topExponent+(1+I)/topExponent^2
  let D := (1/2)/topExponent^2
  change _=primitive A B C D r-primitive A B C D theta
  rw [← integrate_cubic A B C D theta r]
  apply intervalIntegral.integral_congr
  intro x hx
  rw [Set.uIcc_of_le hr] at hx
  have hI : Itaper taper78 theta=I := by
    rw [Itaper,LowBand.MainAux.integral_ptaper78]; norm_num [I,theta]
  have hzero : (if x ≤ theta then ptaper taper78 theta x/2+(∫ t in x..theta,ptaper taper78 theta t) else 0)=0 := by
    by_cases he : x=theta
    · subst x
      simp [ptaper,taper78,theta]
    · rw [if_neg (not_le.mpr (lt_of_le_of_ne hx.1 (Ne.symm he)))]
  change profile x*LowBand.density taper78 theta x=A+B*x+C*x^2+D*x^3
  rw [LowBand.density,hI,hzero,sub_zero]
  dsimp only [profile,taper78,A,B,C,D]
  rw [show (0.999:ℝ)=topExponent by norm_num [topExponent]]
  ring

/-- Extend the actual mixed moment to every fixed ordinary-prime cutoff
strictly below sqrt(T). Only the band from that cutoff to sqrt(T) is omitted. -/
theorem interior_mixed (hRH : RiemannHypothesis) (w : BHB.Weight) {r ε : ℝ}
    (hr : theta ≤ r) (hr' : r < 1/2) (hε : 0 < ε) :
    ∀ᶠ T : ℝ in Filter.atTop, ∃ v : ℝ,
      HasSum (fun ρ : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T ρ*
        (mollified T ρ*(starRingEnd ℂ) ((106/25:ℂ)*(probeLow 0.999 r T ρ+highPrimes T ρ)-shortPrimes T ρ)).re) v ∧
      |v-w.kap1*coefficient r*TMA.Dsc T| ≤ ε*TMA.Dsc T := by
  let a : ℝ := 106/25
  have ha : 0 < a := by norm_num [a]
  let δ := ε/(1+2*a)
  have hδ : 0 < δ := by unfold δ; positivity
  have hθ : 0 < theta := by norm_num [theta]
  have low (s : ℝ) (hs : 0 < s) (hs' : s < 1/2) :=
    lowband_cross hRH w data.hP data.hf hθ data.hθ' hs hs' hδ
  filter_upwards [actual_mixed hRH w hδ,low theta hθ data.hθ',low r (hθ.trans_le hr) hr'] with T hm h₀ h₁
  obtain ⟨v,hv,hm⟩ := hm
  obtain ⟨u,hu,h₀⟩ := h₀
  obtain ⟨q,hq,h₁⟩ := h₁
  change |u-w.kap1*lowConst taper78 profile theta theta*TMA.Dsc T| ≤ _ at h₀
  change |q-w.kap1*lowConst taper78 profile theta r*TMA.Dsc T| ≤ _ at h₁
  refine ⟨v+a*(q-u),(hv.add ((hq.sub hu).mul_left a)).congr_fun ?_,?_⟩
  · intro ρ
    change TMA.cw _ _ _*_=TMA.cw _ _ _*_+a*(TMA.cw _ _ _*(molP taper78 theta T ρ*(starRingEnd ℂ) (probeLow 0.999 r T ρ)).re-
      TMA.cw _ _ _*(molP taper78 theta T ρ*(starRingEnd ℂ) (probeLow 0.999 theta T ρ)).re)
    rw [show molP taper78 theta=mollified from molP_taper78]
    let W := probeLow 0.999 r T ρ
    let U := probeLow 0.999 theta T ρ
    let H := highPrimes T ρ
    let b := mollified T ρ
    let f := shortPrimes T ρ
    let d := TMA.cw w.h T ρ
    change d*(b*(starRingEnd ℂ) ((106/25:ℂ)*(W+H)-f)).re=
      d*(b*(starRingEnd ℂ) ((106/25:ℂ)*(U+H)-f)).re+a*(d*(b*(starRingEnd ℂ) W).re-d*(b*(starRingEnd ℂ) U).re)
    have he : (106/25:ℂ)*(W+H)-f=((106/25:ℂ)*(U+H)-f)+(a:ℂ)*(W-U) := by dsimp [a]; push_cast; ring
    rw [he,map_add,map_mul,Complex.conj_ofReal,map_sub,mul_add,Complex.add_re,mul_left_comm b (a:ℂ),mul_sub]
    simp only [map_sub,Complex.mul_re,Complex.sub_re,Complex.sub_im,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]
    ring
  · let X := w.kap1*lowConst taper78 profile theta r*TMA.Dsc T
    let Y := w.kap1*lowConst taper78 profile theta theta*TMA.Dsc T
    have he : v+a*(q-u)-w.kap1*coefficient r*TMA.Dsc T=
        (v-w.kap1*coveredCoefficient*TMA.Dsc T)+a*((q-X)-(u-Y)) := by
      rw [coefficient,← low_change hr]; dsimp only [X,Y,a]; ring
    rw [he]
    apply (abs_add_le ..).trans
    rw [abs_mul,abs_of_pos ha]
    exact (add_le_add hm (mul_le_mul_of_nonneg_left ((abs_sub ..).trans (add_le_add h₁ h₀)) ha.le)).trans_eq (by
      dsimp only [δ,a]; ring)

def nearHalf : ℝ := 49999999999999/100000000000000

theorem strip_constants :
    theta ≤ nearHalf ∧ nearHalf < 1/2 ∧ (1/2)-nearHalf=1/10^14 ∧
    coefficient nearHalf=(-4236069844353080179049781630795428298290236614697328799841/
        29940030000000000000000000000000000000000000000000000000000:ℝ) ∧
    coefficient (1/2)=(-112961862516081588010927348182095255961853073/
      798400800000000000000000000000000000000000000:ℝ) ∧
    coefficient nearHalf+92/1000000 < -141393/1000000 := by
  norm_num [coefficient,coveredCoefficient,nearHalf,stripPrimitive,primitive,theta,topExponent]

end ReflectedStrip
end
end Src_ReflectedStrip

section Src_ReflectedTail

noncomputable section
open Filter Topology Complex FejerPrimeMoments PrincipalBand ReflectedStrip
open scoped BigOperators ArithmeticFunction Real

namespace ReflectedTail

private def primes (r T : ℝ) := (indices (T^r)).filter Nat.Prime
private def powers (T : ℝ) := (indices (T^topExponent)).filter (fun n => ¬n.Prime)
def residualSet (r T : ℝ) := powers T ∪ (primes (1/2) T \ primes r T)
def amplitude (T : ℝ) (n : ℕ) := TMA.lamCoeff n*profile (Real.log n/Real.log T)/Real.log T

private lemma sub_indices {a b T : ℝ} (hab : a ≤ b) (hT : 1 ≤ T) :
    indices (T^a) ⊆ indices (T^b) :=
  Finset.Icc_subset_Icc_right (Nat.floor_mono (Real.rpow_le_rpow_of_exponent_le hT hab))

private lemma support (r : ℝ) {T : ℝ} (hT : 1 ≤ T) :
    residualSet r T ⊆ indices (T^topExponent) := by
  intro n hn
  rcases Finset.mem_union.mp hn with h|h
  · exact (Finset.mem_filter.mp h).1
  · exact sub_indices (by norm_num [topExponent] : (1/2:ℝ)≤topExponent) hT
      (Finset.mem_filter.mp (Finset.mem_sdiff.mp h).1).1

private lemma shape {T : ℝ} (hT : 1 < T) {n : ℕ} (hn : n ∈ indices (T^topExponent)) :
    profile (Real.log n/Real.log T) ∈ Set.Icc (0:ℝ) 2 := by
  have h₀ := zero_lt_one.trans hT
  have hL := Real.log_pos hT
  have h := (Nat.le_floor_iff (Real.rpow_nonneg h₀.le topExponent)).mp (Finset.mem_Icc.mp hn).2
  have hn₀ : (0:ℝ) < n := by exact_mod_cast (show 0 < n from (by have := (Finset.mem_Icc.mp hn).1; omega))
  have h' := Real.log_le_log hn₀ h
  rw [Real.log_rpow h₀] at h'
  have ha : Real.log n/Real.log T ≤ 0.999 := (div_le_iff₀ hL).mpr (by
    rw [show (0.999:ℝ)=topExponent by norm_num [topExponent]]; exact h')
  have hb := div_nonneg (Real.log_natCast_nonneg n) hL.le
  unfold profile
  have hp : (0:ℝ) < 0.999 := by norm_num
  have hx := (div_le_one hp).mpr ha
  exact ⟨div_nonneg (sub_nonneg.mpr hx) hp.le,(div_le_iff₀ hp).mpr
    ((sub_le_self _ (div_nonneg hb hp.le)).trans (by norm_num))⟩

private def mass (r T : ℝ) := (∑ n ∈ primes r T, Λ n^2/n)/Real.log T^2

private lemma mass_limit {r : ℝ} (hr : 0 < r) : Tendsto (mass r) atTop (𝓝 (r^2/2)) := by
  have h := PrimeVariance.prime_diagonal_limit (fun _ => 1) (by fun_prop) hr zero_le_one (fun _ _ => by norm_num)
  unfold mass primes
  simpa [integral_id] using h

/-- The omitted ordinary primes and all proper prime powers have diagonal
energy at most 4 times the unweighted strip integral, with arbitrary slack. -/
theorem diagonal {r ε : ℝ} (hr : 0 < r) (hr' : r ≤ 1/2) (hε : 0 < ε) :
    ∀ᶠ T : ℝ in atTop, ∑ n ∈ residualSet r T, amplitude T n^2 ≤ 4*(1/8-r^2/2)+ε := by
  let c : ℕ → ℝ := fun n => Λ n^2/n
  have hsmall : Tendsto (fun T : ℝ => 1537/Real.log T^2) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop ((tendsto_pow_atTop (by decide : 2≠0)).comp Real.tendsto_log_atTop)
  have h := hsmall.add ((mass_limit (r:=1/2) (by norm_num)).sub (mass_limit hr))
  filter_upwards [eventually_gt_atTop (1:ℝ),h.eventually_le_const
    (show 0+((1/2:ℝ)^2/2-r^2/2) < 1/8-r^2/2+ε/4 by linarith)] with T hT hlim
  have hp := PrimeVariance.proper_power_error (T^topExponent) (fun _ => 1) zero_le_one (fun _ _ => by norm_num)
  simp only [mul_one,one_mul] at hp
  have hsplit := Finset.sum_filter_add_sum_filter_not (indices (T^topExponent)) Nat.Prime c
  have hpow : ∑ n ∈ powers T, c n ≤ 1537 := by
    change (∑ n ∈ primes topExponent T,c n)+(∑ n ∈ powers T,c n)=_ at hsplit
    change |(∑ n ∈ indices (T^topExponent), c n)-(∑ n ∈ primes topExponent T,c n)| ≤ 1537 at hp
    linarith only [hsplit,(le_abs_self _).trans hp]
  have hsub : primes r T ⊆ primes (1/2) T := Finset.filter_subset_filter _ (sub_indices hr' hT.le)
  have hband := Finset.sum_sdiff (f:=c) hsub
  have hdis : Disjoint (powers T) (primes (1/2) T \ primes r T) :=
    Finset.disjoint_left.mpr (fun n hn hm => (Finset.mem_filter.mp hn).2 (Finset.mem_filter.mp (Finset.mem_sdiff.mp hm).1).2)
  have htot : (∑ n ∈ residualSet r T, c n) ≤ 1537+((∑ n ∈ primes (1/2) T,c n)-(∑ n ∈ primes r T,c n)) := by
    rw [residualSet,Finset.sum_union hdis]; linarith only [hpow,hband]
  have hcoef (n : ℕ) (hn : n ∈ residualSet r T) : amplitude T n^2 ≤ 4*c n/Real.log T^2 := by
    have hw := shape hT (support r hT.le hn)
    have hs : TMA.lamCoeff n^2=Λ n^2/n := by simp [TMA.lamCoeff,div_pow,Real.sq_sqrt]
    rw [amplitude,div_pow,mul_pow,hs]
    exact div_le_div_of_nonneg_right ((mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hw.1 hw.2 2)
      (by positivity : 0 ≤ Λ n^2/n)).trans_eq (by dsimp only [c]; ring)) (sq_nonneg _)
  change 1537/Real.log T^2+(mass (1/2) T-mass r T) ≤ _ at hlim
  have hv := div_le_div_of_nonneg_right htot (sq_nonneg (Real.log T))
  rw [add_div,sub_div] at hv
  calc (∑ n ∈ residualSet r T, amplitude T n^2) ≤ ∑ n ∈ residualSet r T, 4*c n/Real.log T^2 := Finset.sum_le_sum hcoef
       _ = 4*((∑ n ∈ residualSet r T,c n)/Real.log T^2) := by rw [← Finset.sum_div,← Finset.mul_sum]; ring
       _ ≤ _ := by dsimp only [mass] at hlim; dsimp only [c] at hv ⊢; linarith only [hv,hlim]

/-- Smoothed zero mean square of the residual prime-phase polynomial. -/
theorem smooth_energy (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {r ε : ℝ}
    (hr : 0 < r) (hr' : r ≤ 1/2) (hε : 0 < ε) :
    ∀ᶠ T : ℝ in atTop, ∃ v : ℝ, HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z*
      ‖polynomial (residualSet r T) (amplitude T) T 1 z‖^2) v ∧
      v ≤ (1+w.kap1)*(4*(1/8-r^2/2)+ε)*TMA.Dsc T := by
  obtain ⟨D,hD,h⟩ := PrimeVariance.smooth_shifted_square hRH w
    (by norm_num [topExponent] : 0 < topExponent) (by norm_num [topExponent])
  filter_upwards [h,diagonal hr hr' hε,eventually_gt_atTop (1:ℝ),
    Real.tendsto_log_atTop.eventually_ge_atTop (D*(2*Real.pi))] with T hw he hT hL
  have h₀ := zero_lt_one.trans hT
  have hd : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg h₀.le (Real.log_pos hT).le) (by positivity)
  have hDT : D*T ≤ TMA.Dsc T := by
    unfold TMA.Dsc
    rw [le_div_iff₀ (by positivity : 0 < 2*Real.pi)]
    linarith only [mul_le_mul_of_nonneg_left hL h₀.le]
  have ha (n : ℕ) (hn : n ∈ residualSet r T) : 0 ≤ amplitude T n := by
    apply div_nonneg _ (Real.log_pos hT).le
    exact mul_nonneg (div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _))
      (shape hT (support r hT.le hn)).1
  obtain ⟨v,hv,hv'⟩ := hw _ (support r hT.le) _ (by simp [amplitude,TMA.lamCoeff]) ha 0
  simp only [Complex.ofReal_zero,sub_zero] at hv
  simp only [zero_pow (by decide : 2≠0),zero_add,mul_zero,zero_mul,add_zero] at hv'
  refine ⟨v,hv,hv'.trans ?_⟩
  have hk := TMA.T12.kap1_nonneg w
  calc
    _ ≤ (TMA.Dsc T+w.kap1*TMA.Dsc T)*(4*(1/8-r^2/2)+ε) :=
      mul_le_mul (add_le_add hDT (le_refl (w.kap1*TMA.Dsc T))) he
        (Finset.sum_nonneg fun n _ => sq_nonneg _) (add_nonneg hd (mul_nonneg hk hd))
    _ = _ := by ring

open BHB LowBand ReflectedDerivative

private def term (T : ℝ) (s : ℂ) (n : ℕ) :=
  ((Λ n/Real.log T*profile (Real.log n/Real.log T):ℝ):ℂ)*(n:ℂ)^(-s)

private lemma primes_eq (r T : ℝ) : primeSet r T=primes r T := by
  ext n
  simp only [primeSet,primes,indices,Krange,ymol,Finset.mem_filter,Finset.mem_Icc]
  constructor
  · rintro ⟨⟨_,hn⟩,hp⟩; exact ⟨⟨hp.two_le,hn⟩,hp⟩
  · rintro ⟨⟨_,hn⟩,hp⟩; exact ⟨⟨hp.pos,hn⟩,hp⟩

private lemma primeAt_eq {T : ℝ} (hT : 0 < T) (r : ℝ) :
    PrimeLabelPrefix.primesAt (Real.log T) r=primes r T := by
  rw [← primes_eq,PrimeLabelPrefix.primesAt,primeSet,ReflectedPrincipal.below,← Real.rpow_def_of_pos hT]
  exact congrArg (Finset.filter Nat.Prime) (Finset.Icc_succ_left_eq_Ioc ..).symm

private lemma split {T r : ℝ} (hT : 1 < T) (hr : r ≤ 1/2) (s : ℂ) :
    FejerMultiplicity.probe 0.999 T s-(probeLow 0.999 r T s+highPrimes T s)=
    ∑ n ∈ residualSet r T, term T s n := by
  have hh : (0.999:ℝ)=topExponent := by norm_num [topExponent]
  let f := term T s
  have hfull : FejerMultiplicity.probe 0.999 T s=∑ n ∈ indices (T^topExponent), f n := by
    unfold FejerMultiplicity.probe
    rw [show Krange 0.999 T=Krange topExponent T by rw [hh]]
    have hid (n : ℕ) : (((Λ n/Real.log T)*(1-Real.log n/(0.999*Real.log T))/0.999:ℝ):ℂ)*(n:ℂ)^(-s)=f n := by
      dsimp only [f,term,profile]; push_cast; ring
    simp only [hid]
    symm
    apply Finset.sum_subset (Finset.Icc_subset_Icc_left (by decide : 1 ≤ 2))
    intro n hn hni
    have hone : n=1 := by
      have ha := Finset.mem_Icc.mp hn
      by_contra he
      exact hni (Finset.mem_Icc.mpr ⟨by omega,ha.2⟩)
    simp [f,term,hone]
  have hlow : probeLow 0.999 r T s=∑ n ∈ primes r T, f n := by
    unfold probeLow primePoly
    rw [primes_eq]
    apply Finset.sum_congr rfl
    intro n hn
    dsimp only [f,term,profile,vcoef]
    rw [ArithmeticFunction.vonMangoldt_apply_prime (Finset.mem_filter.mp hn).2]
  have hhigh : highPrimes T s=∑ n ∈ primes topExponent T \ primes (1/2) T, f n := by
    unfold highPrimes poly band
    rw [primeAt_eq (zero_lt_one.trans hT),primeAt_eq (zero_lt_one.trans hT)]
    apply Finset.sum_congr rfl
    intro n hn
    dsimp only [f,term,profile,label]
    rw [ArithmeticFunction.vonMangoldt_apply_prime (Finset.mem_filter.mp (Finset.mem_sdiff.mp hn).1).2,hh]
    push_cast; ring
  have hsub {a b : ℝ} (hab : a ≤ b) : primes a T ⊆ primes b T :=
    Finset.filter_subset_filter _ (sub_indices hab hT.le)
  have hdis : Disjoint (powers T) (primes (1/2) T \ primes r T) :=
    Finset.disjoint_left.mpr (fun n hn hm => (Finset.mem_filter.mp hn).2 (Finset.mem_filter.mp (Finset.mem_sdiff.mp hm).1).2)
  rw [hfull,hlow,hhigh,residualSet,Finset.sum_union hdis]
  have he₁ := Finset.sum_filter_add_sum_filter_not (indices (T^topExponent)) Nat.Prime f
  change (∑ n ∈ primes topExponent T,f n)+(∑ n ∈ powers T,f n)=_ at he₁
  have he₂ := Finset.sum_sdiff (f:=f) (hsub hr)
  have he₃ := Finset.sum_sdiff (f:=f) (hsub (by norm_num [topExponent] : (1/2:ℝ)≤topExponent))
  change _=(∑ n ∈ powers T,f n)+(∑ n ∈ primes (1/2) T \ primes r T,f n)
  linear_combination -he₁-he₂-he₃

private lemma phase {T r : ℝ} (hT : 1 < T) (hr : r ≤ 1/2) {s : ℂ} (hs : s.re=1/2) :
    (starRingEnd ℂ) (FejerMultiplicity.probe 0.999 T s-(probeLow 0.999 r T s+highPrimes T s))=
      polynomial (residualSet r T) (amplitude T) T 1 s := by
  rw [split hT hr,map_sum,polynomial]
  apply Finset.sum_congr rfl
  intro n hn
  have hn₀ : 0 < n := lt_of_lt_of_le (by decide : 0 < 2) (Finset.mem_Icc.mp (support r hT.le hn)).1
  dsimp only [term]
  rw [FejerMultiplicity.on_line_power hs hn₀,map_mul,map_mul,Complex.conj_ofReal,Complex.conj_ofReal,← Complex.exp_conj]
  have he : TMA.phase T 1 s (TMA.lamOf T 1 n)=
      Complex.exp ((starRingEnd ℂ) (-Complex.I*(s.im:ℂ)*(Real.log n:ℂ))) := by
    unfold TMA.phase TMA.lamOf
    congr 1
    simp only [map_mul,map_neg,Complex.conj_I,neg_neg,Complex.conj_ofReal]
    push_cast
    field_simp [(Real.log_pos hT).ne']
  rw [he,← mul_assoc]
  congr 1
  push_cast [amplitude,TMA.lamCoeff]
  ring

/-- The same bound for the difference of the actual board probe and the
covered ordinary primes, evaluated at the zeros. -/
theorem actual_energy (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {r ε : ℝ}
    (hr : 0 < r) (hr' : r ≤ 1/2) (hε : 0 < ε) :
    ∀ᶠ T : ℝ in atTop, ∃ v : ℝ, HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z*
      ‖FejerMultiplicity.probe 0.999 T z-(probeLow 0.999 r T z+highPrimes T z)‖^2) v ∧
      v ≤ (1+w.kap1)*(4*(1/8-r^2/2)+ε)*TMA.Dsc T := by
  filter_upwards [smooth_energy hRH w hr hr' hε,eventually_gt_atTop (1:ℝ)] with T hv hT
  obtain ⟨v,hs,hv⟩ := hv
  refine ⟨v,hs.congr_fun (fun ρ => ?_),hv⟩
  rw [← phase hT hr' (Zeta23.RH_implies_on_line hRH ρ.2),Complex.norm_conj]

end ReflectedTail
end
end Src_ReflectedTail

section Src_ReflectedFull

noncomputable section
open Filter ShortProbe.RealResidual ReflectedStrip ReflectedDerivative ReflectedTail
open scoped BigOperators

namespace ReflectedFull

/-- A deliberately coarse detector second-moment bound suffices to pass from
the covered ordinary primes to the full probe with its prime powers. -/
theorem full_mixed (hRH : RiemannHypothesis) (w : BHB.Weight) (hw : w.kap1 ≤ 1+1/10^7)
    (hA : ∀ᶠ T : ℝ in atTop, ∃ v : ℝ, HasSum (fun ρ : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T ρ*‖mollified T ρ‖^2) v ∧ v ≤ 100*TMA.Dsc T) :
    ∀ᶠ T : ℝ in atTop, ∃ v : ℝ, HasSum (fun ρ : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T ρ*(mollified T ρ*(starRingEnd ℂ) ((106/25:ℂ)*FejerMultiplicity.probe 0.999 T ρ-shortPrimes T ρ)).re) v ∧
      v ≤ (w.kap1*coefficient nearHalf+11/1000000)*TMA.Dsc T := by
  have hr := strip_constants.1
  have hr' := strip_constants.2.1
  have ha : 0 < nearHalf := by norm_num [nearHalf]
  have hE := actual_energy hRH w.toHeightWeight ha hr'.le (show (0:ℝ)<1/10^15 by norm_num)
  have hM := interior_mixed hRH w hr hr' (show (0:ℝ)<1/10^6 by norm_num)
  filter_upwards [hA,hE,hM,eventually_gt_atTop (1:ℝ)] with T hA hE hM hT
  obtain ⟨A,hA,hA'⟩ := hA
  obtain ⟨E,hE,hE'⟩ := hE
  obtain ⟨V,hV,hV'⟩ := hM
  let ω (ρ : Zeta23.zetaZeroConfig.carrier) := TMA.cw w.h T ρ
  let B (ρ : Zeta23.zetaZeroConfig.carrier) := mollified T ρ
  let H (ρ : Zeta23.zetaZeroConfig.carrier) := LowBand.probeLow 0.999 nearHalf T ρ+highPrimes T ρ
  let R (ρ : Zeta23.zetaZeroConfig.carrier) := FejerMultiplicity.probe 0.999 T ρ-H ρ
  let f (ρ : Zeta23.zetaZeroConfig.carrier) := ω ρ*(B ρ*(starRingEnd ℂ) (R ρ)).re
  let g (ρ : Zeta23.zetaZeroConfig.carrier) :=
    1/10^8*(ω ρ*‖B ρ‖^2)+25000000*(ω ρ*‖R ρ‖^2)
  have hω (ρ) : 0 ≤ ω ρ := mul_nonneg (Nat.cast_nonneg _) (w.h_nonneg _)
  have hfg (ρ) : ‖f ρ‖ ≤ g ρ := by
    change ‖ω ρ*(B ρ*(starRingEnd ℂ) (R ρ)).re‖ ≤ g ρ
    rw [Real.norm_eq_abs,abs_mul,abs_of_nonneg (hω ρ)]
    have h := Complex.abs_re_le_norm (B ρ*(starRingEnd ℂ) (R ρ))
    rw [norm_mul,Complex.norm_conj] at h
    have hy : ‖B ρ‖*‖R ρ‖ ≤ 1/10^8*‖B ρ‖^2+25000000*‖R ρ‖^2 := by
      nlinarith only [sq_nonneg (‖B ρ‖/10000-5000*‖R ρ‖)]
    exact (mul_le_mul_of_nonneg_left (h.trans hy) (hω ρ)).trans_eq (by dsimp only [g]; ring)
  have hg : HasSum g (1/10^8*A+25000000*E) := (hA.mul_left _).add (hE.mul_left _)
  have hs : Summable f := Summable.of_norm_bounded hg.summable hfg
  have hf := hs.tsum_le_tsum (fun ρ => (le_abs_self _).trans (hfg ρ)) hg.summable
  rw [hg.tsum_eq] at hf
  let a : ℝ := 106/25
  have ha' : 0 ≤ a := by norm_num [a]
  refine ⟨V+a*(∑' ρ, f ρ),(hV.add (hs.hasSum.mul_left a)).congr_fun ?_,?_⟩
  · intro ρ
    let p := FejerMultiplicity.probe 0.999 T ρ
    let u := shortPrimes T ρ
    have hid : (106/25:ℂ)*p-u=((106/25:ℂ)*H ρ-u)+(a:ℂ)*R ρ := by
      dsimp only [a,R,p]; push_cast; ring
    change ω ρ*(B ρ*(starRingEnd ℂ) ((106/25:ℂ)*p-u)).re=
      ω ρ*(B ρ*(starRingEnd ℂ) ((106/25:ℂ)*H ρ-u)).re+a*(ω ρ*(B ρ*(starRingEnd ℂ) (R ρ)).re)
    rw [hid,map_add,map_mul,Complex.conj_ofReal,mul_add,Complex.add_re,mul_left_comm (B ρ) (a:ℂ)]
    simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]
    ring
  · have hD : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg (zero_lt_one.trans hT).le (Real.log_pos hT).le) (by positivity)
    have hη : 0 ≤ 4*(1/8-nearHalf^2/2)+(1/10^15:ℝ) := by norm_num [nearHalf]
    have hsmall : E ≤ (5/10^14)*TMA.Dsc T := by
      apply hE'.trans (mul_le_mul_of_nonneg_right _ hD)
      calc (1+w.kap1)*(4*(1/8-nearHalf^2/2)+(1/10^15:ℝ)) ≤
               (1+(1+1/10^7))*(4*(1/8-nearHalf^2/2)+(1/10^15:ℝ)) :=
             mul_le_mul_of_nonneg_right (add_le_add (le_refl 1) hw) hη
           _ ≤ _ := by norm_num [nearHalf]
    have hh := (le_abs_self _).trans hV'
    dsimp only [a]
    linarith only [hf,hA',hsmall,hh,hD]

end ReflectedFull
end
end Src_ReflectedFull

section Src_ReflectedVariance


noncomputable section
open Complex Real Filter Topology MeasureTheory MultiplicityProbe FejerPrimeMoments ShortProbe
open scoped BigOperators

namespace ShortProbe
namespace RealResidual

def pointCost (T : ℝ) (z : ℂ) : ℝ :=
  let y := value (mollified T z) (FejerMultiplicity.probe 0.999 T z)
  MultiplicityProbe.sq y - (1/7.41)*correction y (shortPrimes T z) centerY centerU

/-- Completing the square folds the long and short primes into a single
polynomial with the reflected derivative. The remaining square is real and short. -/
theorem two_squares (y u : ℂ) (b μ : ℝ) :
    MultiplicityProbe.sq y - (1/7.41)*correction y u b μ =
      (8/7.41)*MultiplicityProbe.sq (y+(u-(μ:ℂ)-(0.59*b:ℝ))/8) +
      (1/(8*0.59))*(u.re-μ-0.59*b)^2 := by
  unfold MultiplicityProbe.sq correction
  simp only [Complex.add_re,Complex.add_im,Complex.sub_re,Complex.sub_im,Complex.ofReal_re,
    Complex.ofReal_im,sub_zero,Complex.div_ofNat_re,Complex.div_ofNat_im]
  ring

def combined (T : ℝ) (z : ℂ) : ℂ :=
  value (mollified T z) (FejerMultiplicity.probe 0.999 T z) +
    (shortPrimes T z-(centerU:ℂ)-(0.59*centerY:ℝ))/8

def shortReal (T : ℝ) (z : ℂ) : ℝ := (shortPrimes T z).re-centerU-0.59*centerY

theorem pointCost_nonneg (T : ℝ) (z : ℂ) : 0 ≤ pointCost T z := by
  unfold pointCost MultiplicityProbe.sq
  have h := correction_le (value (mollified T z) (FejerMultiplicity.probe 0.999 T z))
    (shortPrimes T z) centerY centerU
  linarith only [h,sq_nonneg (value (mollified T z) (FejerMultiplicity.probe 0.999 T z)).re]

/-- It suffices to estimate the combined cost on any one smooth majorant.
The signed cross moments need no individual sharp-window estimates. -/
theorem reflected_of_smooth (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    (hc : ∀ᶠ T : ℝ in atTop, ∃ v : ℝ,
      HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z*pointCost T z) v ∧
      v ≤ 0.146091403013*TMA.Dsc T) : Dyadic (85390845089/100000000000) ∧ Cumulative (85390845089/100000000000) := by
  apply reflected_8539 hRH
  filter_upwards [hc,eventually_atTop.mpr (BHB.Final.Dsc_le_Ncount (show (0:ℝ)<1/10^6 by norm_num)),
    eventually_gt_atTop (0:ℝ)] with T ⟨v,hv,hv'⟩ hn hT
  have hs := PrimeVariance.sharp_majorized w hT (pointCost T) (pointCost T)
    (pointCost_nonneg T) (fun _ => le_rfl) hv
  have he : FejerBands.sharp T (pointCost T) = cost T := by
    unfold FejerBands.sharp pointCost cost sumAt
    simp only [Finset.mul_sum,← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro z _
    ring
  rw [he] at hs
  change TMA.Dsc T ≤ (1+1/10^6)*count T at hn
  linarith only [hs,hv',hn,show 0 ≤ count T from Nat.cast_nonneg _]

/-- Numerical thresholds on the two nonnegative moments for the 85.39% entry. -/
theorem reflected_of_two_squares (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    (hy : ∀ᶠ T : ℝ in atTop, ∃ v : ℝ, HasSum (fun z : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T z*MultiplicityProbe.sq (combined T z)) v ∧ v ≤ 0.1252966399530*TMA.Dsc T)
    (hu : ∀ᶠ T : ℝ in atTop, ∃ v : ℝ, HasSum (fun z : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T z*(shortReal T z)^2) v ∧ v ≤ 0.0510627414279*TMA.Dsc T) :
    Dyadic (85390845089/100000000000) ∧ Cumulative (85390845089/100000000000) := by
  apply reflected_of_smooth hRH w
  filter_upwards [hy,hu,eventually_gt_atTop (1:ℝ)] with T ⟨v,hv,hv'⟩ ⟨r,hr,hr'⟩ hT
  refine ⟨_,((hv.mul_left (8/7.41)).add (hr.mul_left (1/(8*0.59)))).congr_fun (fun z => ?_),?_⟩
  · unfold pointCost combined shortReal
    rw [two_squares]
    ring
  · have hd : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg (by linarith) (Real.log_pos hT).le) (by positivity)
    linarith only [hv',hr',hd]

def shortSet (T : ℝ) := (BHB.Krange lengthExponent T).filter Nat.Prime

def shortWeight (x : ℝ) := x*(1-x/5-9*x^2/20)

def shortCoeff (T : ℝ) (n : ℕ) :=
  shortWeight (Real.log n/Real.log T)*(Real.sqrt n)⁻¹

def profile (x : ℝ) := 1-x/5-9*x^2/20

def energyU : ℝ :=
  let t := lengthExponent
  t^2/2-2*t^3/15-(43/50)*t^4/4+(9/50)*t^5/5+(81/400)*t^6/6

theorem short_indices (T : ℝ) :
    shortSet T = (indices (T^lengthExponent)).filter Nat.Prime := by
  ext n
  simp only [shortSet,Finset.mem_filter,indices,BHB.Krange,BHB.ymol,Finset.mem_Icc]
  constructor
  · rintro ⟨⟨_,h⟩,hp⟩; exact ⟨⟨hp.two_le,h⟩,hp⟩
  · rintro ⟨⟨_,h⟩,hp⟩; exact ⟨⟨hp.one_le,h⟩,hp⟩

theorem profile_bounds {x : ℝ} (hx : x ∈ Set.Icc 0 lengthExponent) :
    profile x ∈ Set.Icc 0 1 := by
  have hx₀ := hx.1
  have hx₁ : x ≤ 1 := hx.2.trans (by norm_num [lengthExponent])
  have hu : x^2 ≤ 1 := by nlinarith [mul_nonneg hx₀ (sub_nonneg.mpr hx₁)]
  unfold profile
  constructor <;> nlinarith [sq_nonneg x]

theorem short_coeff_limits :
    Tendsto (fun T => (∑ n ∈ shortSet T, shortCoeff T n*TMA.lamCoeff n)/Real.log T) atTop (𝓝 (-centerU)) ∧
    Tendsto (fun T => ∑ n ∈ shortSet T, shortCoeff T n^2) atTop (𝓝 energyU) := by
  have hprofile : ContDiff ℝ 1 profile := by unfold profile; fun_prop
  have hlo := PrimeVariance.prime_diagonal_limit profile hprofile (r := lengthExponent)
    (by norm_num [lengthExponent]) zero_le_one (fun x hx => by
      rw [abs_of_nonneg (profile_bounds hx).1]; exact (profile_bounds hx).2)
  have hhi := PrimeVariance.prime_diagonal_limit (fun x => profile x^2) (hprofile.pow 2)
    (r := lengthExponent) (by norm_num [lengthExponent]) zero_le_one (fun x hx => by
      rw [abs_of_nonneg (sq_nonneg _)]; exact (pow_le_pow_left₀ (profile_bounds hx).1
        (profile_bounds hx).2 2).trans_eq (one_pow _))
  have hI : (∫ x in (0:ℝ)..lengthExponent, x*profile x) = -centerU := by
    let F := fun x : ℝ => x^2/2-x^3/15-9*x^4/80
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := (0:ℝ)) (b := lengthExponent) (f := F)
      (f' := fun x => x*profile x) (fun x _ => by
        convert! ((((hasDerivAt_pow 2 x).div_const 2).sub ((hasDerivAt_pow 3 x).div_const 15)).sub
          (((hasDerivAt_pow 4 x).const_mul 9).div_const 80)) using 1
        dsimp [F,profile]
        ring)
      ((continuous_id.mul hprofile.continuous).intervalIntegrable ..)
    rw [h]; dsimp [F,centerU]; ring
  have hJ : (∫ x in (0:ℝ)..lengthExponent, x*profile x^2) = energyU := by
    let F := fun x : ℝ => x^2/2-2*x^3/15-(43/50)*x^4/4+(9/50)*x^5/5+(81/400)*x^6/6
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := (0:ℝ)) (b := lengthExponent) (f := F)
      (f' := fun x => x*profile x^2) (fun x _ => by
        convert! ((((((hasDerivAt_pow 2 x).div_const 2).sub (((hasDerivAt_pow 3 x).const_mul 2).div_const 15)).sub
          (((hasDerivAt_pow 4 x).const_mul (43/50)).div_const 4)).add
          (((hasDerivAt_pow 5 x).const_mul (9/50)).div_const 5)).add
          (((hasDerivAt_pow 6 x).const_mul (81/400)).div_const 6)) using 1
        dsimp [F,profile]
        ring)
      ((continuous_id.mul (hprofile.continuous.pow 2)).intervalIntegrable ..)
    simpa [energyU,F] using h
  rw [hI] at hlo
  rw [hJ] at hhi
  have ham (T : ℝ) {n : ℕ} (hp : n.Prime) :
      shortCoeff T n=TMA.lamCoeff n*profile (Real.log n/Real.log T)/Real.log T := by
    simp only [shortCoeff,shortWeight,profile,TMA.lamCoeff,ArithmeticFunction.vonMangoldt_apply_prime hp]
    ring
  have hs (n : ℕ) : TMA.lamCoeff n^2=ArithmeticFunction.vonMangoldt n^2/n := by
    simp [TMA.lamCoeff,div_pow,Real.sq_sqrt]
  constructor
  · apply hlo.congr'
    filter_upwards [eventually_gt_atTop (1:ℝ)] with T hT
    rw [← short_indices,Finset.sum_div,Finset.sum_div]
    apply Finset.sum_congr rfl
    intro n hn
    have hp := (Finset.mem_filter.mp hn).2
    rw [ham T hp,← hs]
    ring
  · apply hhi.congr'
    filter_upwards [eventually_gt_atTop (1:ℝ)] with T hT
    rw [← short_indices,Finset.sum_div]
    apply Finset.sum_congr rfl
    intro n hn
    have hp := (Finset.mem_filter.mp hn).2
    rw [ham T hp,← hs]
    ring

theorem short_on_line {T : ℝ} (hT : 1 < T) {z : ℂ} (hz : z.re=1/2) :
    (starRingEnd ℂ) (shortPrimes T z) = polynomial (shortSet T) (shortCoeff T) T 1 z := by
  unfold shortPrimes polynomial shortSet
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro n hn
  have hnp := (Finset.mem_filter.mp hn).2.pos
  rw [FejerMultiplicity.on_line_power hz hnp,map_mul,map_mul,Complex.conj_ofReal,
    Complex.conj_ofReal,← Complex.exp_conj]
  have hp : TMA.phase T 1 z (TMA.lamOf T 1 n) =
      Complex.exp ((starRingEnd ℂ) (-I*(z.im:ℂ)*(Real.log n:ℂ))) := by
    unfold TMA.phase TMA.lamOf
    congr 1
    simp only [map_mul,map_neg,Complex.conj_I,neg_neg,Complex.conj_ofReal]
    push_cast
    field_simp [(Real.log_pos hT).ne']
  rw [hp,← mul_assoc]
  congr 1
  simp only [shortCoeff,shortWeight,Complex.ofReal_mul]

/-- The unconjugated square of the actual auxiliary prime polynomial has
normalized smooth upper limit at most zero. -/
theorem short_square (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ T : ℝ in atTop, ∃ v : ℝ,
      HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z*((shortPrimes T z)^2).re) v ∧
      v ≤ ε*TMA.Dsc T := by
  let s := lengthExponent+lengthExponent
  obtain ⟨C,hC,h⟩ := PrimeVariance.ordinary_upper hRH w (s := s) (by norm_num [s,lengthExponent])
    (by norm_num [s,lengthExponent])
  filter_upwards [h,Real.tendsto_log_atTop.eventually_ge_atTop (C*(2*π)/ε),
    eventually_gt_atTop (1:ℝ)] with T h hL hT
  have hT₀ : 0 < T := by linarith
  have hlog := Real.log_pos hT
  let S := shortSet T
  let a := shortCoeff T
  have hm (n : ℕ) (hn : n ∈ S) : n.Prime ∧ (n:ℝ) ≤ T^lengthExponent := by
    obtain ⟨h₁,h₂⟩ := Finset.mem_filter.mp hn
    exact ⟨h₂,(Nat.le_floor_iff (Real.rpow_nonneg hT₀.le _)).mp (Finset.mem_Icc.mp h₁).2⟩
  have hc (n : ℕ) (hn : n ∈ S) : 0 < n ∧ a n ∈ Set.Icc 0 1 := by
    obtain ⟨hp,hx⟩ := hm n hn
    have hp₁ : 1 ≤ (n:ℝ) := by exact_mod_cast hp.one_le
    let x := Real.log n/Real.log T
    have hx₀ : 0 ≤ x := div_nonneg (Real.log_nonneg hp₁) hlog.le
    have hx₁ : x ≤ 1 := by
      have hh := Real.log_le_log (by linarith) hx
      rw [Real.log_rpow hT₀] at hh
      apply (div_le_iff₀ hlog).mpr
      norm_num [lengthExponent] at hh
      linarith
    have hu : x^2 ≤ 1 := by nlinarith [mul_nonneg hx₀ (sub_nonneg.mpr hx₁)]
    have hl : 0 ≤ 1-x/5-9*x^2/20 := by linarith
    have hw : shortWeight x ≤ 1 := (mul_le_mul_of_nonneg_left
      (show 1-x/5-9*x^2/20 ≤ 1 by nlinarith [sq_nonneg x]) hx₀).trans (by simpa using hx₁)
    have hsqrt : 1 ≤ Real.sqrt n := by simpa using Real.sqrt_le_sqrt hp₁
    have hi : (Real.sqrt n)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hsqrt
    exact ⟨hp.pos,mul_nonneg (mul_nonneg hx₀ hl) (by positivity),
      (mul_le_mul hw hi (by positivity) zero_le_one).trans_eq (one_mul _)⟩
  have hpr (n : ℕ) (hn : n ∈ S) (m : ℕ) (hm' : m ∈ S) : n*m ∈ indices (T^s) := by
    obtain ⟨hnp,hnl⟩ := hm n hn
    obtain ⟨hmp,hml⟩ := hm m hm'
    apply Finset.mem_Icc.mpr
    refine ⟨hnp.two_le.trans (Nat.le_mul_of_pos_right _ hmp.pos),?_⟩
    apply (Nat.le_floor_iff (Real.rpow_nonneg hT₀.le _)).mpr
    rw [Nat.cast_mul,show T^s=T^lengthExponent*T^lengthExponent from Real.rpow_add hT₀ ..]
    exact mul_le_mul hnl hml (Nat.cast_nonneg _) (Real.rpow_nonneg hT₀.le _)
  have hcard : (S.card:ℝ) ≤ T^lengthExponent := by
    have hfilter := Finset.card_le_card (Finset.filter_subset Nat.Prime (BHB.Krange lengthExponent T))
    simp only [BHB.Krange,BHB.ymol,Nat.card_Icc,Nat.add_sub_cancel] at hfilter
    exact (Nat.cast_le.mpr hfilter).trans (Nat.floor_le (Real.rpow_nonneg hT₀.le _))
  have hsize : (S.card:ℝ)*S.card ≤ T := by
    apply (mul_le_mul hcard hcard (Nat.cast_nonneg _) (Real.rpow_nonneg hT₀.le _)).trans
    rw [← Real.rpow_add hT₀]
    exact (Real.rpow_le_rpow_of_exponent_le hT.le (show lengthExponent+lengthExponent ≤ 1 by
      norm_num [lengthExponent])).trans_eq (Real.rpow_one T)
  have H := PrimeVariance.ordinary_at_zeros hRH w hT₀ S S a a
    (fun n hn => (hc n hn).1) (fun n hn => (hc n hn).1)
  refine ⟨_,H.congr_fun (fun z => ?_),?_⟩
  · have hh := short_on_line hT (Zeta23.RH_implies_on_line hRH z.2)
    change _ = TMA.cw w.h T z*(polynomial S a T 1 z*polynomial S a T 1 z).re
    rw [← hh,← map_mul,Complex.conj_re,pow_two]
  · have hh := h S S a a hc hc hpr hsize
    rw [H.tsum_eq] at hh
    apply hh.trans
    rw [div_le_iff₀ hε] at hL
    unfold TMA.Dsc
    rw [← mul_div_assoc,le_div_iff₀ (by positivity)]
    linarith only [mul_le_mul_of_nonneg_left hL hT₀.le]

/-- Shifted Hermitian energy of the auxiliary prime polynomial, with its
diagonal and its signed first moment evaluated. -/
theorem short_shift (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    (d : ℝ) {η : ℝ} (hη : 0 < η) :
    ∀ᶠ T : ℝ in atTop, ∃ v : ℝ, HasSum (fun z : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T z*‖shortPrimes T z-d‖^2) v ∧
      v ≤ (w.kap1*(d^2+energyU-2*d*centerU)+η)*TMA.Dsc T := by
  obtain ⟨D,hD,h⟩ := PrimeVariance.smooth_shifted_square hRH w (s := lengthExponent)
    (by norm_num [lengthExponent]) (by norm_num [lengthExponent])
  let A (T : ℝ) := ∑ n ∈ shortSet T, shortCoeff T n*TMA.lamCoeff n
  let E (T : ℝ) := ∑ n ∈ shortSet T, shortCoeff T n^2
  obtain ⟨hA,hE⟩ := short_coeff_limits
  have hEV := (tendsto_const_nhds (x := d^2)).add hE
  have hD0 : Tendsto (fun T : ℝ => D*(2*π)/Real.log T) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop Real.tendsto_log_atTop
  have hl := (((hD0.add_const w.kap1).mul hEV).add (hA.const_mul (2*w.kap1*d))).eventually_le_const
    (show (0+w.kap1)*(d^2+energyU)+2*w.kap1*d*(-centerU) <
      w.kap1*(d^2+energyU-2*d*centerU)+η by linarith only [hη])
  filter_upwards [h,hl,eventually_gt_atTop (1:ℝ)] with T h hl hT
  have h₀ : 0 < T := by linarith
  have hL := Real.log_pos hT
  have hpos (n : ℕ) (hn : n ∈ shortSet T) : 0 ≤ shortCoeff T n := by
    obtain ⟨hk,hp⟩ := Finset.mem_filter.mp hn
    have hkn := Finset.mem_Icc.mp hk
    have hn₁ : 1 ≤ (n:ℝ) := by exact_mod_cast hp.one_le
    have hℓ := Real.log_le_log (by linarith) ((Nat.le_floor_iff
      (Real.rpow_nonneg h₀.le lengthExponent)).mp hkn.2)
    rw [Real.log_rpow h₀] at hℓ
    have hx := div_nonneg (Real.log_nonneg hn₁) hL.le
    exact mul_nonneg (mul_nonneg hx (profile_bounds ⟨hx,(div_le_iff₀ hL).mpr hℓ⟩).1) (by positivity)
  obtain ⟨v,hv,hv'⟩ := h (shortSet T) (by rw [short_indices]; exact Finset.filter_subset ..)
    (shortCoeff T) (by simp [shortCoeff,shortWeight]) hpos d
  refine ⟨v,hv.congr_fun (fun z => ?_),?_⟩
  · have hz := short_on_line hT (Zeta23.RH_implies_on_line hRH z.2)
    rw [← hz,← Complex.conj_ofReal d,← map_sub,Complex.norm_conj,Complex.conj_ofReal]
  · change (D*(2*π)/Real.log T+w.kap1)*(d^2+E T)+2*w.kap1*d*(A T/Real.log T) ≤ _ at hl
    have hd : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg h₀.le hL.le) (by positivity)
    apply hv'.trans
    apply le_trans _ (mul_le_mul_of_nonneg_right hl hd)
    apply le_of_eq
    change (D*T+w.kap1*TMA.Dsc T)*(d^2+E T)+2*T*(w.kap1/(2*π))*d*A T = _
    unfold TMA.Dsc
    field_simp [hL.ne',Real.pi_ne_zero]

/-- The short real square in the two-square reduction is fully controlled
under RH for every sufficiently close smooth height majorant. -/
theorem short_real_bound (hRH : RiemannHypothesis) (w : TMA.HeightWeight) (hw : w.kap1 ≤ 1+1/10^7) :
    ∀ᶠ T : ℝ in atTop, ∃ v : ℝ, HasSum (fun z : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T z*(shortReal T z)^2) v ∧ v ≤ 0.0510627414279*TMA.Dsc T := by
  let d := centerU+0.59*centerY
  let η : ℝ := 1/10^8
  have hη : 0 < η := by norm_num [η]
  filter_upwards [short_shift hRH w (2*d) hη,short_square hRH w hη,
    eventually_atTop.mpr (BHB.Final.Dsc_le_Ncount hη),eventually_gt_atTop (1:ℝ)]
    with T ⟨v,hv,hv'⟩ ⟨r,hr,hr'⟩ hN hT
  have hT₀ : 0 < T := by linarith
  let mass := ∑' z : Zeta23.zetaZeroConfig.carrier, TMA.cw w.h T z
  have hm := (TMA.summable_cw hRH w hT₀).hasSum
  have hlo : (Zeta23.Ncount T (2*T):ℝ) ≤ mass := by
    have hh := PrimeVariance.sharp_majorized w hT₀ (fun _ => 1) (fun _ => 1) (fun _ => zero_le_one)
      (fun _ => le_rfl) (show HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z*1) mass
        by simpa only [mul_one] using hm)
    simpa only [FejerBands.sharp,mul_one,ThirdMoment.Ncount_eq] using hh
  refine ⟨_,(((hv.mul_left (1/2)).add (hr.mul_left (1/2))).sub (hm.mul_left (d^2))).congr_fun (fun z => ?_),?_⟩
  · change TMA.cw w.h T z*(shortReal T z)^2 =
      (1/2)*(TMA.cw w.h T z*‖shortPrimes T z-(2*d:ℝ)‖^2)+
      (1/2)*(TMA.cw w.h T z*((shortPrimes T z)^2).re)-d^2*TMA.cw w.h T z
    rw [← Complex.normSq_eq_norm_sq]
    simp only [Complex.normSq_apply,Complex.sub_re,Complex.sub_im,
      Complex.ofReal_re,Complex.ofReal_im,sub_zero,shortReal,pow_two,Complex.mul_re]
    dsimp only [d]
    ring
  · change TMA.Dsc T ≤ (1+η)*(Zeta23.Ncount T (2*T):ℝ) at hN
    have hcount := hN.trans (mul_le_mul_of_nonneg_left hlo (by linarith : 0 ≤ 1+η))
    let E := (2*d)^2+energyU-2*(2*d)*centerU
    have hE : 0 ≤ E := by norm_num [E,d,energyU,centerU,centerY,lengthExponent]
    have hd : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg hT₀.le (Real.log_pos hT).le) (by positivity)
    have hvb := hv'.trans (mul_le_mul_of_nonneg_right (add_le_add (mul_le_mul_of_nonneg_right hw hE) le_rfl) hd)
    change v ≤ ((1+1/10^7)*E+η)*TMA.Dsc T at hvb
    have hconst : (1/2)*((1+1/10^7)*E+η)+(1/2)*η-d^2/(1+η) ≤ 0.0510627414279 := by
      norm_num [E,d,energyU,centerU,centerY,lengthExponent,η]
    have hl := mul_le_mul_of_nonneg_left hcount (show 0 ≤ d^2/(1+η) by positivity)
    have herr : d^2/(1+η)*((1+η)*mass)=d^2*mass := by field_simp [show 1+η≠0 by linarith]
    rw [herr] at hl
    change (1/2)*v+(1/2)*r-d^2*mass ≤ _
    calc
      _ ≤ (1/2)*(((1+1/10^7)*E+η)*TMA.Dsc T)+(1/2)*(η*TMA.Dsc T)-
          (d^2/(1+η))*TMA.Dsc T := sub_le_sub (add_le_add
            (mul_le_mul_of_nonneg_left hvb (by norm_num))
            (mul_le_mul_of_nonneg_left hr' (by norm_num))) hl
      _ = ((1/2)*((1+1/10^7)*E+η)+(1/2)*η-d^2/(1+η))*TMA.Dsc T := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right hconst hd

/-- After evaluation of the short real square, only this one smooth complex
square requires an analytic upper estimate for the proposed 85.39% bound. -/
theorem reflected_of_combined (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    (hw : w.kap1 ≤ 1+1/10^7)
    (hy : ∀ᶠ T : ℝ in atTop, ∃ v : ℝ, HasSum (fun z : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T z*MultiplicityProbe.sq (combined T z)) v ∧ v ≤ 0.1252966399530*TMA.Dsc T) :
    Dyadic (85390845089/100000000000) ∧ Cumulative (85390845089/100000000000) :=
  reflected_of_two_squares hRH w hy (short_real_bound hRH w hw)

