  obtain ⟨B, hB⟩ : ∃ B : ℂ, B = Taper78.BHB.MTP.Lfun ly (ε + w) (DkerB ε α ν w) := ⟨_, rfl⟩
  have e1 : (fun β => Zl ε α ν β * Taper78.BHB.MTP.SSlead ly ε α ν β w)
