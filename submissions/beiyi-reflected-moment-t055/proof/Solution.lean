noncomputable section
open scoped BigOperators
open ArithmeticFunction

namespace ReflectedSmall

def primeTwist {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) : ℂ :=
  if n.Prime then (Real.log n:ℝ)*χ (n:ZMod q) else 0

/-- Uniform prime-only Siegel–Walfisz prefix. The contribution of proper
prime powers is absorbed into the desired logarithmic saving. -/
theorem prime_prefix (A : ℕ) (hA : 0 < A) :
    ∃ C X₀ : ℝ, 0 < C ∧ 3 ≤ X₀ ∧ ∀ x ≥ X₀, ∀ q : ℕ, 0 < q →
      (q:ℝ) ≤ Real.log x^A → ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ‖∑ n ∈ Finset.Icc 1 ⌊x⌋₊, primeTwist χ n‖ ≤ C*x/Real.log x^A := by
  obtain ⟨C,hC,hs⟩ := BHB.siegelWalfisz (A:ℝ) (by exact_mod_cast hA)
  obtain ⟨X₀,hX,he⟩ := BHB.Arith.eventually_rpow_neg_mul_log_pow_le
    (show (0:ℝ) < 1/2 by norm_num) (A+1)
  refine ⟨C+2,X₀,by linarith,hX,?_⟩
  intro x hx q hq hqx χ hχ
  have hx₁ : 1 < x := by linarith
  have hx₀ : 0 < x := by linarith
  have hL := Real.log_pos hx₁
  have hSW := hs x (by linarith) q hq (by simpa only [Real.rpow_natCast] using hqx) χ hχ
  rw [Real.rpow_natCast] at hSW
  let I := Finset.Icc 1 ⌊x⌋₊
  let u := fun n : ℕ => (vonMangoldt n:ℂ)*χ (n:ZMod q)
  have hp : (∑ n ∈ I, primeTwist χ n) = ∑ n ∈ I.filter Nat.Prime, u n := by
    rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro n _
    by_cases hn : n.Prime <;> simp [primeTwist,hn,u,vonMangoldt_apply_prime]
  have hproper := Chebyshev.psi_sub_theta_le (x:=x) hx₁.le
  rw [Chebyshev.psi_sub_theta_eq_sum_not_prime,
    ← show Finset.Icc 1 ⌊x⌋₊ = Finset.Ioc 0 ⌊x⌋₊ from Finset.Icc_succ_left_eq_Ioc ..] at hproper
  have herr : ‖∑ n ∈ I.filter (fun n => ¬n.Prime), u n‖ ≤ 2*Real.sqrt x*Real.log x := by
    apply (norm_sum_le ..).trans
    apply le_trans _ hproper
    apply Finset.sum_le_sum
    intro n _
    simp only [u,norm_mul,Complex.norm_real,Real.norm_of_nonneg vonMangoldt_nonneg]
    exact mul_le_of_le_one_right vonMangoldt_nonneg (χ.norm_le_one _)
  have hsplit := Finset.sum_filter_add_sum_filter_not I Nat.Prime u
  rw [hp,eq_sub_of_add_eq hsplit]
  have he' := he x hx
  rw [Real.rpow_neg hx₀.le,← Real.sqrt_eq_rpow,pow_succ,inv_mul_le_iff₀ (Real.sqrt_pos.mpr hx₀),
    mul_one] at he'
  have hbound : (2*Real.sqrt x*Real.log x)*Real.log x^A ≤ 2*x := by
    have := mul_le_mul_of_nonneg_left he' (Real.sqrt_nonneg x)
    nlinarith only [this,Real.sq_sqrt hx₀.le]
  apply (norm_sub_le ..).trans ((add_le_add hSW herr).trans _)
  rw [le_div_iff₀ (pow_pos hL _),add_mul,div_mul_cancel₀ _ (pow_pos hL _).ne']
  linarith only [hbound]

/-- Summation by parts on a clipped prime dyad. This permits the taper
and a translated height weight to depend on every outside index. -/
theorem prime_weighted_dyad (A : ℕ) (hA : 0 < A) :
    ∃ C X₀ : ℝ, 0 < C ∧ 3 ≤ X₀ ∧ ∀ X ≥ X₀, ∀ q : ℕ, 0 < q →
      (q:ℝ) ≤ Real.log X^A → ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ∀ (a b : ℕ) (f : ℕ → ℝ), X ≤ a → a < b → (b:ℝ) ≤ 2*X →
        ‖∑ n ∈ Finset.Ioc a b, f n • primeTwist χ n‖ ≤
          (|f b|+|f (a+1)|+(∑ i ∈ Finset.Ioc a (b-1), |f (i+1)-f i|))*
            (C*X/Real.log X^A) := by
  obtain ⟨C,X₀,hC,hX₀,h⟩ := prime_prefix A hA
  refine ⟨2*C,X₀,by positivity,hX₀,?_⟩
  intro X hX q hq hqX χ hχ a b f ha hab hb
  have hX₁ : 1 < X := by linarith
  have hL := Real.log_pos hX₁
  let B := 2*C*X/Real.log X^A
  have hpre (i : ℕ) (hai : a ≤ i) (hib : i ≤ b) :
      ‖∑ n ∈ Finset.range (i+1), primeTwist χ n‖ ≤ B := by
    have hi : X ≤ (i:ℝ) := ha.trans (by exact_mod_cast hai)
    have hi₂ : (i:ℝ) ≤ 2*X := le_trans (by exact_mod_cast hib) hb
    have hpow := pow_le_pow_left₀ hL.le (Real.log_le_log (by linarith : 0 < X) hi) A
    have hp := h i (hX.trans hi) q hq (hqX.trans hpow) χ hχ
    rw [Nat.floor_natCast] at hp
    have hr : (∑ n ∈ Finset.Icc 1 i, primeTwist χ n) =
        ∑ n ∈ Finset.range (i+1), primeTwist χ n := by
      rw [Nat.range_succ_eq_Icc_zero]
      apply Finset.sum_subset (Finset.Icc_subset_Icc_left (Nat.zero_le 1))
      intro n hn hn'
      have : n = 0 := by simp only [Finset.mem_Icc,not_and] at hn hn'; omega
      simp [this,primeTwist]
    rw [← hr]
    apply hp.trans
    dsimp [B]
    apply div_le_div₀ (by positivity) _ (pow_pos hL _) hpow
    nlinarith only [mul_le_mul_of_nonneg_left hi₂ hC.le]
  let P := fun i => ∑ n ∈ Finset.range (i+1), primeTwist χ n
  have hprod (t : ℝ) (i : ℕ) (hi : a ≤ i) (hj : i ≤ b) :
      ‖t • P i‖ ≤ |t| * B := by
    rw [norm_smul,Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_left (hpre i hi hj) (abs_nonneg _)
  rw [Finset.sum_Ioc_by_parts f (primeTwist χ) hab]
  have hsum : ‖∑ i ∈ Finset.Ioc a (b-1), (f (i+1)-f i) • P i‖ ≤
      (∑ i ∈ Finset.Ioc a (b-1), |f (i+1)-f i|)*B := by
    rw [Finset.sum_mul]
    apply (norm_sum_le ..).trans
    apply Finset.sum_le_sum
    intro i hi
    have hmem := Finset.mem_Ioc.mp hi
    exact hprod _ i (by omega) (by omega)
  exact (norm_sub_le ..).trans ((add_le_add ((norm_sub_le ..).trans (add_le_add
    (hprod _ b hab.le le_rfl) (hprod _ a le_rfl hab.le))) hsum).trans_eq (by ring))

private theorem variation_on_dyad {X U V : ℝ} {a b : ℕ} (hX : 0 < X) (ha : X ≤ a)
    (hab : a < b) (hb : (b:ℝ) ≤ 2*X) (f f' : ℝ → ℝ)
    (hf : ∀ y ∈ Set.Icc (a:ℝ) b, |f y| ≤ U)
    (hd : ∀ y ∈ Set.Icc (a:ℝ) b, HasDerivAt f (f' y) y)
    (hV : 0 ≤ V) (hv : ∀ y ∈ Set.Icc (a:ℝ) b, |f' y| ≤ V/X) :
    |f b|+|f (a+1)|+(∑ i ∈ Finset.Ioc a (b-1), |f ((i:ℝ)+1)-f i|) ≤ 2*U+V := by
  have hab' : (a:ℝ)+1 ≤ b := by exact_mod_cast hab
  have hv₀ := div_nonneg hV hX.le
  have hsum : (∑ i ∈ Finset.Ioc a (b-1), |f ((i:ℝ)+1)-f i|) ≤ V := by
    have hstep (i : ℕ) (hi : i ∈ Finset.Ioc a (b-1)) : |f ((i:ℝ)+1)-f i| ≤ V/X := by
      have hi' := Finset.mem_Ioc.mp hi
      have hlo : (a:ℝ) ≤ i := by exact_mod_cast hi'.1.le
      have hup : (i:ℝ)+1 ≤ b := by exact_mod_cast (show i+1 ≤ b by omega)
      have hsub := Set.Icc_subset_Icc hlo hup
      have he := norm_image_sub_le_of_norm_deriv_le_segment' (a:=(i:ℝ)) (b:=(i:ℝ)+1)
        (fun y hy => (hd y (hsub hy)).hasDerivWithinAt)
        (fun y hy => (Real.norm_eq_abs _).trans_le (hv y (hsub (Set.Ico_subset_Icc_self hy))))
        ((i:ℝ)+1) ⟨by linarith,le_rfl⟩
      simpa only [Real.norm_eq_abs,add_sub_cancel_left,mul_one] using he
    have hc : ((Finset.Ioc a (b-1)).card:ℝ) ≤ X := by
      rw [Nat.card_Ioc]
      have ha' : a ≤ b-1 := by omega
      rw [Nat.cast_sub ha']
      have hc' : ((b-1:ℕ):ℝ) ≤ b := by exact_mod_cast Nat.sub_le b 1
      linarith
    calc
      _ ≤ ∑ _i ∈ Finset.Ioc a (b-1), V/X := Finset.sum_le_sum hstep
      _ = ((Finset.Ioc a (b-1)).card:ℝ)*(V/X) := by simp
      _ ≤ X*(V/X) := mul_le_mul_of_nonneg_right hc hv₀
      _ = V := by field_simp
  linarith only [hsum,hf b ⟨by linarith,le_rfl⟩,hf ((a:ℝ)+1) ⟨by linarith,hab'⟩]

/-- The small-conductor prime estimate with the actual linear log taper
and translated smooth height profile. The decay is uniform in the outside
frequency v, even when vX is large. On a prime the weight before H is D
times the coefficient of the reflected probe for D=h log T. -/
theorem reflected_prime_dyad (A d : ℕ) (hA : 0 < A) (H : ℝ → ℝ) (hH : BHB.Arith.Adm H) :
    ∃ C X₀ : ℝ, 0 < C ∧ 3 ≤ X₀ ∧ ∀ X ≥ X₀, ∀ q : ℕ, 0 < q →
      (q:ℝ) ≤ Real.log X^A → ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ∀ (a b : ℕ) (D v : ℝ), X ≤ a → a < b → (b:ℝ) ≤ 2*X →
        1 ≤ D → Real.log b ≤ D → 0 ≤ v →
        ‖∑ n ∈ Finset.Ioc a b, ((1-Real.log n/D)*H (v*n)) • primeTwist χ n‖ ≤
          C*(X/Real.log X^A)/(1+v*X)^d := by
  obtain ⟨C,X₀,hC,hX₀,hw⟩ := prime_weighted_dyad A hA
  obtain ⟨C₀,h₀⟩ := hH.decay d
  obtain ⟨H',hd,_,hdec⟩ := hH.deriv
  obtain ⟨C₁,h₁⟩ := hdec (d+1)
  let K := 1+|C₀|+|C₁|
  have hK : 0 < K := by dsimp [K]; positivity
  have hK₀ : C₀ ≤ K := by dsimp [K]; linarith [le_abs_self C₀,abs_nonneg C₁]
  have hK₁ : C₁ ≤ K := by dsimp [K]; linarith [le_abs_self C₁,abs_nonneg C₀]
  refine ⟨4*K*C,X₀,by positivity,hX₀,?_⟩
  intro X hX q hq hqX χ hχ a b D v ha hab hb hD htop hv
  have hX₁ : 1 < X := by linarith
  have hXpos : 0 < X := by linarith
  have hDpos : 0 < D := by linarith
  have hbase : 0 < 1+v*X := by positivity
  let U := K/(1+v*X)^d
  have hU : 0 ≤ U := by dsimp [U]; positivity
  let f := fun y : ℝ => (1-Real.log y/D)*H (v*y)
  let f' := fun y : ℝ => (-(y⁻¹/D))*H (v*y)+(1-Real.log y/D)*(H' (v*y)*v)
  have hpair (y : ℝ) (hy : y ∈ Set.Icc (a:ℝ) b) :
      |f y| ≤ U ∧ HasDerivAt f (f' y) y ∧ |f' y| ≤ (2*U)/X := by
    have hxy := ha.trans hy.1
    have hypos := hXpos.trans_le hxy
    have hbase' : 1+v*X ≤ 1+v*y := by gcongr
    have hp := pow_le_pow_left₀ hbase.le hbase' d
    have hlog := Real.log_nonneg (hX₁.le.trans hxy)
    have hu : Real.log y/D ≤ 1 := (div_le_one hDpos).mpr ((Real.log_le_log hypos hy.2).trans htop)
    have ht : |1-Real.log y/D| ≤ 1 := by rw [abs_of_nonneg (by linarith)]; linarith [div_nonneg hlog hDpos.le]
    have hH₀ : |H (v*y)| ≤ U := (h₀ _ (mul_nonneg hv hypos.le)).trans
      (div_le_div₀ hK.le hK₀ (pow_pos hbase _) hp)
    have hdH : |H' (v*y)| ≤ U/(1+v*X) := by
      dsimp [U]
      rw [div_div,← pow_succ]
      exact (h₁ _ (mul_nonneg hv hypos.le)).trans (div_le_div₀ hK.le hK₁ (pow_pos hbase _)
        (pow_le_pow_left₀ hbase.le hbase' _))
    have hd₀ : |-(y⁻¹/D)| ≤ 1/X := by
      rw [abs_neg,abs_of_nonneg (by positivity)]
      exact (div_le_self (by positivity) hD).trans (by simpa only [one_div] using inv_anti₀ hXpos hxy)
    have hd₁ : U/(1+v*X)*v ≤ U/X := by
      rw [le_div_iff₀ hXpos,mul_assoc,div_mul_eq_mul_div,div_le_iff₀ hbase]
      nlinarith only [hU]
    refine ⟨(abs_mul ..).le.trans (by simpa using mul_le_mul ht hH₀ (abs_nonneg _) zero_le_one),?_,?_⟩
    · have inner : HasDerivAt (fun t : ℝ => v*t) v y := by simpa using (hasDerivAt_id y).const_mul v
      have taper : HasDerivAt (fun t : ℝ => 1-Real.log t/D) (-(y⁻¹/D)) y := by
        exact ((Real.hasDerivAt_log hypos.ne').div_const D).const_sub 1
      exact taper.mul ((hd (v*y)).comp y inner)
    · dsimp [f']
      apply (abs_add_le ..).trans
      simp only [abs_mul,abs_of_nonneg hv]
      have he := mul_le_mul hd₀ hH₀ (abs_nonneg _) (by positivity)
      have hi := mul_le_mul ht ((mul_le_mul_of_nonneg_right hdH hv).trans hd₁) (by positivity) zero_le_one
      exact (add_le_add he hi).trans_eq (by ring)
  have hvsum := variation_on_dyad hXpos ha hab hb f f' (fun y hy => (hpair y hy).1)
    (fun y hy => (hpair y hy).2.1) (by positivity) (fun y hy => (hpair y hy).2.2)
  have hm := hw X hX q hq hqX χ hχ a b (fun i => f i) ha hab hb
  push_cast at hm
  apply hm.trans
  calc
    _ ≤ (2*U+2*U)*(C*X/Real.log X^A) := by
      exact mul_le_mul_of_nonneg_right hvsum (by positivity [Real.log_nonneg hX₁.le])
    _ = _ := by dsimp [U]; ring

/-- After summing the shifted divisor coefficients, the loss for a
clipped prime dyad is a fixed logarithmic factor times XY/(log X)^A.
Here XY is qrT/(2π) in the reflected moment. -/
theorem small_conductor_series (A : ℕ) (hA : 0 < A) (H : ℝ → ℝ) (hH : BHB.Arith.Adm H) :
    ∃ C X₀ : ℝ, 0 < C ∧ 3 ≤ X₀ ∧ ∀ X ≥ X₀, ∀ q : ℕ, 0 < q →
      (q:ℝ) ≤ Real.log X^A → ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ∀ (g r a b : ℕ) (D Y : ℝ), 1 ≤ g → X ≤ a → a < b → (b:ℝ) ≤ 2*X →
        1 ≤ D → Real.log b ≤ D → 1 ≤ Y →
        Summable (fun j : ℕ => (BHB.Arith.rd BHB.MT.kap2 g r j : ℂ)*χ (j:ZMod q)*
          (∑ n ∈ Finset.Ioc a b, ((1-Real.log n/D)*H (j/(X*Y)*n)) • primeTwist χ n)) ∧
        (∑' j : ℕ, ‖(BHB.Arith.rd BHB.MT.kap2 g r j : ℂ)*χ (j:ZMod q)*
          (∑ n ∈ Finset.Ioc a b, ((1-Real.log n/D)*H (j/(X*Y)*n)) • primeTwist χ n)‖) ≤
          C*(1+Real.log g)^2*(X*Y)/Real.log X^A*(1+Real.log Y)^4 := by
  obtain ⟨C,X₀,hC,hX₀,h⟩ := reflected_prime_dyad A 6 hA H hH
  obtain ⟨K,hK,hk⟩ := BHB.Arith.DB.tsum_decay_le 2
  refine ⟨C*K,X₀,mul_pos hC hK,hX₀,?_⟩
  intro X hX q hq hqx χ hχ g r a b D Y hg ha hab hb hD ht hY
  have hx : 0 < X := by linarith
  have hlog := Real.log_pos (show 1 < X by linarith)
  have hy : 0 < Y := by linarith
  let z := BHB.Arith.rd BHB.MT.kap2 g r
  have hz := HighPrime.reduced_kap2_DB hg r
  let B := C*(X/Real.log X^A)
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hs₂ := hz.summable_decay (c:=1/Y) (by positivity)
  have hs : Summable (fun j : ℕ => |z j|/(1+j/Y)^6) := by
    apply Summable.of_nonneg_of_le (fun j => by positivity) _ hs₂
    intro j
    have hbase : 1 ≤ 1+(j:ℝ)/Y := le_add_of_nonneg_right (by positivity)
    rw [show 1+(1/Y)*(j:ℝ)=1+j/Y by ring]
    exact div_le_div_of_nonneg_left (abs_nonneg _) (by positivity)
      (pow_le_pow_right₀ hbase (by decide : 2 ≤ 6))
  have hmajor (j : ℕ) :
      ‖(z j:ℂ)*χ (j:ZMod q)*(∑ n ∈ Finset.Ioc a b,
        ((1-Real.log n/D)*H (j/(X*Y)*n)) • primeTwist χ n)‖ ≤ B*(|z j|/(1+j/Y)^6) := by
    have hp := h X hX q hq hqx χ hχ a b D (j/(X*Y)) ha hab hb hD ht (by positivity)
    rw [show (j:ℝ)/(X*Y)*X=j/Y by field_simp] at hp
    rw [norm_mul,norm_mul,Complex.norm_real,Real.norm_eq_abs]
    exact (mul_le_mul (mul_le_of_le_one_right (abs_nonneg _) (χ.norm_le_one _))
      hp (norm_nonneg _) (abs_nonneg _)).trans_eq (by dsimp [B]; ring)
  have hs' := hs.mul_left B
  have hn := Summable.of_nonneg_of_le (fun j => norm_nonneg _) hmajor hs'
  refine ⟨hn.of_norm,?_⟩
  apply (hn.tsum_le_tsum hmajor hs').trans
  rw [tsum_mul_left]
  have hbd := hk ((1+Real.log g)^2) z (sq_nonneg _) hz Y hY
  exact (mul_le_mul_of_nonneg_left hbd hB).trans_eq (by dsimp [B]; ring)

theorem small_conductor_dyad (A : ℕ) (hA : 0 < A) (H : ℝ → ℝ) (hH : BHB.Arith.Adm H) :
    ∃ C X₀ : ℝ, 0 < C ∧ 3 ≤ X₀ ∧ ∀ X ≥ X₀, ∀ q : ℕ, 0 < q →
      (q:ℝ) ≤ Real.log X^A → ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ∀ (g r a b : ℕ) (D Y : ℝ), 1 ≤ g → X ≤ a → a < b → (b:ℝ) ≤ 2*X →
        1 ≤ D → Real.log b ≤ D → 1 ≤ Y →
        (∑' j : ℕ, ‖(BHB.Arith.rd BHB.MT.kap2 g r j : ℂ)*χ (j:ZMod q)*
          (∑ n ∈ Finset.Ioc a b, ((1-Real.log n/D)*H (j/(X*Y)*n)) • primeTwist χ n)‖) ≤
          C*(1+Real.log g)^2*(X*Y)/Real.log X^A*(1+Real.log Y)^4 := by
  obtain ⟨C,X,hC,hX,he⟩ := small_conductor_series A hA H hH
  exact ⟨C,X,hC,hX,fun x hx q hq hqx χ hχ g r a b D Y hg ha hab hb hD ht hY =>
    (he x hx q hq hqx χ hχ g r a b D Y hg ha hab hb hD ht hY).2⟩

end ReflectedSmall
end
end Src_ReflectedSmall

section Src_ReflectedPackets

noncomputable section
open BHB BHB.Red Complex
open scoped BigOperators ArithmeticFunction Real

namespace ReflectedPackets

private theorem log_spacing {x y : ℝ} (hx : 0 < x) (hy : 0 < y) :
    y-x ≤ y*(Real.log y-Real.log x) := by
  have h := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos (div_pos hx hy)) hy.le
  rw [Real.log_div hx.ne' hy.ne',mul_sub,mul_sub,mul_div_cancel₀ x hy.ne',mul_one] at h
  linarith only [h]

/-- Bound the decaying part of the archimedean transform at a rational
frequency d/p near one, including its square-root coefficient. -/
theorem gamma_near {d p T : ℝ} (hd : 0 < d) (hp : 0 < p) (hT : 0 < T)
    (hpd : p ≤ 2*d) (hdp : d ≤ 2*p) (hne : p ≠ d) :
    T/(Real.sqrt (d*p)*(1+(T*(Real.log d-Real.log p))^2)) ≤ 8*d/(T*(p-d)^2) := by
  let l := Real.log d-Real.log p
  have hl : |p-d| ≤ (2*d)*|l| := by
    rcases le_total p d with h | h
    · have hu := log_spacing hp hd
      have hv : 0 ≤ l := sub_nonneg.mpr (Real.log_le_log hp h)
      rw [abs_of_nonpos (sub_nonpos.mpr h),abs_of_nonneg hv]
      dsimp [l] at *
      nlinarith only [hu,mul_nonneg hd.le hv]
    · have hu := log_spacing hd hp
      have hv : l ≤ 0 := sub_nonpos.mpr (Real.log_le_log hd h)
      rw [abs_of_nonneg (sub_nonneg.mpr h),abs_of_nonpos hv]
      dsimp [l] at *
      nlinarith only [hu,mul_nonneg (sub_nonneg.mpr hpd) (neg_nonneg.mpr hv)]
  have hs := pow_le_pow_left₀ (abs_nonneg _) hl 2
  rw [mul_pow,sq_abs,sq_abs] at hs
  have hroot := Real.sqrt_pos.mpr (mul_pos hd hp)
  have hhalf : d ≤ 2*Real.sqrt (d*p) := by
    by_contra! hn
    have hh := mul_self_lt_mul_self (show 0 ≤ 2*Real.sqrt (d*p) by positivity) hn
    nlinarith only [hh,Real.sq_sqrt (mul_nonneg hd.le hp.le),mul_nonneg hd.le (sub_nonneg.mpr hdp),
      mul_pos hd hp]
  change T/(Real.sqrt (d*p)*(1+(T*l)^2)) ≤ _
  rw [div_le_div_iff₀ (by positivity) (mul_pos hT (sq_pos_of_ne_zero (sub_ne_zero.mpr hne)))]
  calc
    _ ≤ 4*d^2*(1+(T*l)^2) := by nlinarith only [mul_le_mul_of_nonneg_left hs (sq_nonneg T),sq_nonneg d]
    _ ≤ _ := by
      nlinarith only [mul_le_mul_of_nonneg_right hhalf (show 0 ≤ 4*d*(1+(T*l)^2) by positivity)]

/-- The off-diagonal label sum is bounded independently of the integer
product d=mk. Labels may be enlarged from primes to arbitrary integers. -/
theorem inverse_square_labels (d : ℕ) (P : Finset ℕ) :
    ∑ p ∈ P, (1:ℝ)/((p:ℝ)-d)^2 ≤ 18 := by
  let shift := fun p : ℕ => (p:ℤ)-(d:ℤ)
  let F := fun j : ℤ => (1:ℝ)/(1+|(j:ℝ)|+1)^2
  obtain ⟨hs,hb⟩ := zs_sum_int_inv_sq (A:=1) zero_lt_one
  change Summable F at hs
  change ∑' j, F j ≤ 2/1 at hb
  have hi : Function.Injective shift := fun a b hab => by
    dsimp [shift] at hab
    omega
  have hterm (p : ℕ) : (1:ℝ)/((p:ℝ)-d)^2 ≤ 9*F (shift p) := by
    dsimp [F,shift]; push_cast
    by_cases he : p=d
    · subst p; norm_num
    have hl : 1 ≤ |(p:ℝ)-d| := by
      rcases lt_or_gt_of_ne he with ht | ht
      · rw [abs_of_nonpos (by exact_mod_cast (sub_nonpos.mpr (show (p:ℤ) ≤ d by exact_mod_cast ht.le)))]
        have hle : (p:ℝ)+1 ≤ d := by exact_mod_cast ht
        linarith
      · have hle : (d:ℝ)+1 ≤ p := by exact_mod_cast ht
        rw [abs_of_nonneg (by linarith)]
        linarith
    have hpos : 0 < ((p:ℝ)-d)^2 := sq_pos_of_ne_zero (sub_ne_zero.mpr (by exact_mod_cast he))
    have hh := pow_le_pow_left₀ (by positivity : 0 ≤ 1+|(p:ℝ)-d|+1)
      (show 1+|(p:ℝ)-d|+1 ≤ 3*|(p:ℝ)-d| by linarith) 2
    rw [mul_pow,sq_abs] at hh
    rw [mul_one_div,div_le_div_iff₀ hpos (by positivity)]
    linarith only [hh]
  calc
    _ ≤ ∑ p ∈ P, 9*F (shift p) := Finset.sum_le_sum (fun p _ => hterm p)
    _ = 9*∑ j ∈ P.image shift, F j := by rw [← Finset.mul_sum,Finset.sum_image hi.injOn]
    _ ≤ 9*(2/1) := mul_le_mul_of_nonneg_left ((hs.sum_le_tsum _ (fun j _ => by dsimp [F]; positivity)).trans hb) (by norm_num)
    _ = _ := by norm_num

/-- Count all m,k with mk≤M after the off-diagonal labels have been
summed. Summing in this order removes any need for a divisor bound. -/
theorem gamma_spacing_sum (P : Finset ℕ) (K : ℕ) {M T : ℝ} (hM : 0 ≤ M) (hT : 0 < T) :
    ∑ k ∈ Finset.Icc 1 K, ∑ m ∈ Finset.Ioc 0 ⌊M/k⌋₊,
      ((m*k:ℕ):ℝ)/T*∑ p ∈ P, (1:ℝ)/((p:ℝ)-(m*k:ℕ))^2 ≤ 18*M^2/T*(1+Real.log K) := by
  have hkterm (k : ℕ) (hk : k ∈ Finset.Icc 1 K) :
      (∑ m ∈ Finset.Ioc 0 ⌊M/k⌋₊, ((m*k:ℕ):ℝ)/T*∑ p ∈ P, (1:ℝ)/((p:ℝ)-(m*k:ℕ))^2)
        ≤ (18*M^2/T)*(1/k) := by
    have hkpos : 0 < (k:ℝ) := by exact_mod_cast (Finset.mem_Icc.mp hk).1
    have hcard : ((Finset.Ioc 0 ⌊M/k⌋₊).card:ℝ) ≤ M/k := by
      simpa using Nat.floor_le (div_nonneg hM hkpos.le)
    calc
      _ ≤ ∑ _m ∈ Finset.Ioc 0 ⌊M/k⌋₊, M/T*18 := by
        apply Finset.sum_le_sum
        intro m hm
        have hmc := (Nat.le_floor_iff (div_nonneg hM hkpos.le)).mp (Finset.mem_Ioc.mp hm).2
        have hmk : ((m*k:ℕ):ℝ) ≤ M := by simpa only [Nat.cast_mul] using (le_div_iff₀ hkpos).mp hmc
        exact mul_le_mul (div_le_div_of_nonneg_right hmk hT.le) (inverse_square_labels _ P)
          (Finset.sum_nonneg (fun p _ => by positivity)) (div_nonneg hM hT.le)
      _ = ((Finset.Ioc 0 ⌊M/k⌋₊).card:ℝ)*(M/T*18) := by simp
      _ ≤ M/k*(M/T*18) := mul_le_mul_of_nonneg_right hcard (by positivity)
      _ = _ := by ring
  apply (Finset.sum_le_sum hkterm).trans
  rw [← Finset.mul_sum]
  exact mul_le_mul_of_nonneg_left (BHB.Arith.sum_Icc_one_div_le_one_add_log K) (by positivity)

/-- At the exact reciprocal-packet resonance one of its two Dirichlet
coefficients vanishes. -/
theorem reciprocal_resonance {m k n p : ℕ} (hp : p.Prime) (hm : 0 < m)
    (hk : 0 < k) (he : m*k*n=p) (X : ℝ) : Λ n*dco X m=0 := by
  have hn : n ∣ p := ⟨m*k,by rw [← he,Nat.mul_comm n]⟩
  rcases hp.eq_one_or_self_of_dvd n hn with rfl | rfl
  · simp
  · have hm₁ : m*k=1 := by
      apply Nat.eq_of_mul_eq_mul_right hp.pos
      simpa using he
    have hu := Nat.le_mul_of_pos_right m hk
    have hm' : m=1 := by omega
    simp [hm',dco]

/-- Grouping the nonzero linearized modes by |j|n gives this
arithmetic coefficient in front of the signed height profiles. -/
theorem linear_coefficient {k p : ℕ} (hk : 0 < k) (hp : 0 < p) (m : ℕ) :
    ∑ n ∈ m.divisors, Λ n*Real.log ((n:ℝ)*p/k) =
      BHB.MT.kap2 m-Real.log ((k:ℝ)/p)*Real.log m := by
  have hk₀ : (k:ℝ) ≠ 0 := by exact_mod_cast hk.ne'
  have hp₀ : (p:ℝ) ≠ 0 := by exact_mod_cast hp.ne'
  rw [BHB.MT.kap2,← ArithmeticFunction.vonMangoldt_sum (n:=m),Finset.mul_sum,← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro n hn
  have hn₀ : (n:ℝ) ≠ 0 := by exact_mod_cast (Nat.pos_of_mem_divisors hn).ne'
  rw [Real.log_div (mul_ne_zero hn₀ hp₀) hk₀,Real.log_mul hn₀ hp₀,Real.log_div hk₀ hp₀]
  ring

/-- Sum the zero dual mode at nP. The support shortens the n range by
P, leaving a harmonic prime weight in the sum over the labels. -/
theorem zero_mode (w : Weight) :
    ∃ C T₀ : ℝ, 0 < C ∧ ∀ T ≥ T₀, ∀ k p : ℕ, 1 ≤ k → k ≤ p → ∀ N : Finset ℕ,
      (∑ n ∈ N, Λ n*‖Iterm1 w T k (n*p) 0‖) ≤
        C*Xtr T/(p*T)*(1+Real.log (4*Xtr T))^2 := by
  obtain ⟨C,T₁,h₁⟩ := norm_Iterm1_zero_le w
  obtain ⟨T₂,h₂⟩ := Iterm1_eq_zero w
  let K := |C|+1
  have hK : 0 < K := by dsimp [K]; positivity
  have hC : C ≤ K := by dsimp [K]; linarith [le_abs_self C]
  refine ⟨4*K,max 2 (max T₁ T₂),by positivity,?_⟩
  intro T hT k p hk hkp N
  have hTpos : 0 < T := lt_of_lt_of_le (by norm_num : (0:ℝ)<2) ((le_max_left ..).trans hT)
  have hkpos : 0 < (k:ℝ) := by exact_mod_cast hk
  have hppos : 0 < (p:ℝ) := by exact_mod_cast (show 0<p by omega)
  let X := Xtr T
  have hX : 1 ≤ X := Real.one_le_rpow (le_trans (by norm_num : (1:ℝ)≤2) ((le_max_left ..).trans hT))
    (by norm_num : 0 ≤ (3/2:ℝ))
  let R := 4*k*X/p
  let L := 1+Real.log (4*X)
  have hL : 0 ≤ L := by dsimp [L]; linarith [Real.log_nonneg (show 1 ≤ 4*X by linarith)]
  let S := N.filter (fun n : ℕ => n ∈ Finset.Ioc 0 ⌊R⌋₊)
  have hz : ∀ n ∈ N, n ∉ S → Λ n*‖Iterm1 w T k (n*p) 0‖ = 0 := by
    intro n hn hns
    by_cases hn₀ : n=0
    · simp [hn₀]
    have hnR : R < (n:ℝ) := by
      by_contra! hh
      exact hns (Finset.mem_filter.mpr ⟨hn,Finset.mem_Ioc.mpr ⟨Nat.pos_of_ne_zero hn₀,Nat.le_floor hh⟩⟩)
    have he := h₂ T ((le_max_right ..).trans ((le_max_right ..).trans hT)) k (n*p) hk
      (by simpa only [Nat.cast_mul] using (div_lt_iff₀ hppos).mp hnR) 0
    simp [he]
  have hterm (n : ℕ) (hn : n ∈ S) :
      Λ n*‖Iterm1 w T k (n*p) 0‖ ≤ L*(K/(k*T)*L) := by
    have hnr := Finset.mem_Ioc.mp (Finset.mem_filter.mp hn).2
    have hn₀ : 0 < (n:ℝ) := by exact_mod_cast hnr.1
    have hnR : (n:ℝ) ≤ R := (Nat.le_floor_iff (by dsimp [R]; positivity)).mp hnr.2
    have hu : (n*p:ℕ)/ (k:ℝ) ≤ 4*X := by
      rw [div_le_iff₀ hkpos,Nat.cast_mul]
      linarith only [(le_div_iff₀ hppos).mp hnR]
    have hl : (n:ℝ) ≤ ((n*p:ℕ):ℝ)/k := by
      rw [le_div_iff₀ hkpos,Nat.cast_mul]
      exact mul_le_mul_of_nonneg_left (by exact_mod_cast hkp) hn₀.le
    have hlogs := Real.log_le_log (hn₀.trans_le hl) hu
    have hwgt : Λ n ≤ L := ArithmeticFunction.vonMangoldt_le_log.trans
      ((Real.log_le_log hn₀ (hl.trans hu)).trans (by dsimp [L]; linarith))
    have hlog := Real.log_nonneg ((show (1:ℝ)≤n by exact_mod_cast hnr.1).trans hl)
    have he := h₁ T ((le_max_left ..).trans ((le_max_right ..).trans hT)) k (n*p) hk
      (Nat.mul_pos hnr.1 (by omega))
    rw [abs_of_nonneg hlog] at he
    apply mul_le_mul hwgt (he.trans _) (norm_nonneg _) hL
    exact mul_le_mul (div_le_div_of_nonneg_right hC (by positivity)) (by dsimp [L]; linarith)
      (by linarith) (by positivity)
  have hsub : S ⊆ Finset.Ioc 0 ⌊R⌋₊ := fun n hn => (Finset.mem_filter.mp hn).2
  have hcard : (S.card:ℝ) ≤ R := by
    have hh := Finset.card_le_card hsub
    rw [Nat.card_Ioc,Nat.sub_zero] at hh
    exact (show (S.card:ℝ) ≤ ⌊R⌋₊ by exact_mod_cast hh).trans (Nat.floor_le (by dsimp [R]; positivity))
  have hSN : S ⊆ N := Finset.filter_subset ..
  rw [← Finset.sum_subset hSN hz]
  calc
    _ ≤ ∑ _n ∈ S, L*(K/(k*T)*L) := Finset.sum_le_sum hterm
    _ = (S.card:ℝ)*(L*(K/(k*T)*L)) := by simp
    _ ≤ R*(L*(K/(k*T)*L)) := mul_le_mul_of_nonneg_right hcard (by positivity)
    _ = _ := by dsimp [R,L,X]; field_simp

/-- Uniform absolute error for all nonzero dual modes at the actual
integer packet nP. The factor (kT/P)^(1+ε) is summable over prime labels
after dividing by k and summing over the mollifier. -/
theorem linearization (w : Weight) {ε : ℝ} (hε : 0 < ε) (hε' : ε ≤ 1/2) :
    ∃ C T₀ : ℝ, 0 < C ∧ ∀ T ≥ T₀, ∀ k p : ℕ, 1 ≤ k → k ≤ p → (p:ℝ) ≤ T →
      2 ≤ (k:ℝ)*T/p → ∀ (N : Finset ℕ) (J : Finset ℤ), (∀ j ∈ J, j ≠ 0) →
      ∑ n ∈ N, Λ n * ∑ j ∈ J, ‖Iterm1 w T k (n*p) j - Lterm1 w T k (n*p) j‖ ≤
        C/k*T^(-(1/2):ℝ)*(1+Real.log T)*((k:ℝ)*T/p)^(1+ε)*Real.log ((k:ℝ)*T/p) := by
  obtain ⟨C₀,T₀,h₀⟩ := Iterm1_sub_Lterm1_le w
  obtain ⟨C₁,h₁⟩ := major1_le hε hε'
  let K := |C₀|+1
  have hK : 0 < K := by dsimp [K]; positivity
  have hC₀ : C₀ ≤ K := by dsimp [K]; linarith [le_abs_self C₀]
  refine ⟨K*(|C₁|+1),max 2 T₀,by positivity,?_⟩
  intro T hT k p hk hkp hpT hS N J hJ
  have hT₂ : 2 ≤ T := (le_max_left ..).trans hT
  have hTpos : 0 < T := by linarith
  have hkpos : 0 < (k:ℝ) := by exact_mod_cast hk
  have hppos : 0 < (p:ℝ) := by exact_mod_cast (show 0<p by omega)
  have hlog := Real.log_nonneg (by linarith : 1 ≤ T)
  let S := (k:ℝ)*T/p
  have hSpos : 0 < S := by dsimp [S]; positivity
  let v := fun (n : ℕ) (j : ℤ) =>
    if j=0 then (0:ℝ) else (1+|(j:ℝ)| * n/S)^(-(3/2):ℝ)
  have hv (n : ℕ) (j : ℤ) : 0 ≤ v n j := by dsimp [v]; split <;> positivity
  let M := fun n : ℕ => Λ n*(|Real.log n|+1)*∑' j : ℤ, v n j
  have hM₀ (n : ℕ) : 0 ≤ M n := by
    exact mul_nonneg (mul_nonneg ArithmeticFunction.vonMangoldt_nonneg (by positivity)) (tsum_nonneg (hv n))
  obtain ⟨hM,hMb⟩ := h₁ S hS 1 le_rfl (by rw [Nat.cast_one]; linarith : ((1:ℕ):ℝ) ≤ S)
  simp only [Nat.cast_one,one_mul,div_one] at hM hMb
  change Summable M at hM
  change ∑' n, M n ≤ C₁*S^(1+ε)*Real.log S at hMb
  let B := K/k*T^(-(1/2):ℝ)*(1+Real.log T)
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hn (n : ℕ) : Λ n*(∑ j ∈ J, ‖Iterm1 w T k (n*p) j-Lterm1 w T k (n*p) j‖) ≤ B*M n := by
    by_cases hz : n=0
    · simp [hz,M]
    have hnpos := Nat.pos_of_ne_zero hz
    have hn₀ : 0 < (n:ℝ) := by exact_mod_cast hnpos
    have hnlog := Real.log_natCast_nonneg n
    have hpklog : 0 ≤ Real.log ((n*p:ℕ):ℝ)-Real.log k := by
      rw [sub_nonneg]
      apply Real.log_le_log hkpos
      exact_mod_cast le_trans hkp (Nat.le_mul_of_pos_left p hnpos)
    have hl : |Real.log (((n*p:ℕ):ℝ)/k)|+1 ≤ (1+Real.log T)*(|Real.log n|+1) := by
      rw [Real.log_div (by exact_mod_cast (Nat.mul_pos hnpos (show 0<p by omega)).ne') hkpos.ne',abs_of_nonneg hpklog,
        Nat.cast_mul,Real.log_mul hn₀.ne' hppos.ne',abs_of_nonneg hnlog]
      linarith [Real.log_le_log hppos hpT,Real.log_natCast_nonneg k,mul_nonneg hlog hnlog]
    obtain ⟨Cj,hj⟩ := tsum_major_j hε hε'
    have hsj := (hj ((n:ℝ)/S) (div_pos hn₀ hSpos)).1
    have has : Summable (v n) := hsj.congr (fun j => by simp [v,mul_div_assoc])
    have hjbound (j : ℤ) (hjJ : j ∈ J) :
        ‖Iterm1 w T k (n*p) j-Lterm1 w T k (n*p) j‖ ≤ B*(|Real.log n|+1)*v n j := by
      have he := h₀ T ((le_max_right ..).trans hT) k (n*p) hk
        (Nat.mul_pos hnpos (by omega)) j (hJ j hjJ)
      have hv' : 1+|(j:ℝ)| * ((n*p:ℕ):ℝ)/(k*T)=1+|(j:ℝ)| * n/S := by
        dsimp [S]; push_cast; field_simp
      rw [hv'] at he
      have h := mul_le_mul (div_le_div_of_nonneg_right hC₀ hkpos.le) hl (by positivity) (by positivity)
      dsimp [v]
      rw [if_neg (hJ j hjJ)]
      exact he.trans ((mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right h (by positivity))
        (by positivity)).trans_eq (by dsimp [B]; ring))
    have hsum : (∑ j ∈ J, ‖Iterm1 w T k (n*p) j-Lterm1 w T k (n*p) j‖) ≤
        B*(|Real.log n|+1)*∑' j, v n j := (Finset.sum_le_sum hjbound).trans (by
      rw [← Finset.mul_sum]
      exact mul_le_mul_of_nonneg_left (has.sum_le_tsum J (fun j _ => hv n j)) (by positivity))
    exact (mul_le_mul_of_nonneg_left hsum ArithmeticFunction.vonMangoldt_nonneg).trans_eq (by dsimp [M]; ring)
  calc
    _ ≤ ∑ n ∈ N, B*M n := Finset.sum_le_sum (fun n _ => hn n)
    _ ≤ B*(C₁*S^(1+ε)*Real.log S) := by
      rw [← Finset.mul_sum]
      exact mul_le_mul_of_nonneg_left ((hM.sum_le_tsum N (fun n _ => hM₀ n)).trans hMb) hB
    _ ≤ B*((|C₁|+1)*S^(1+ε)*Real.log S) := by
      have hslog := Real.log_nonneg (show 1 ≤ S by linarith)
      gcongr
      linarith [le_abs_self C₁]
    _ = _ := by dsimp [B,S]; ring

end ReflectedPackets
end
end Src_ReflectedPackets

section Src_FejerMultiplicity

/-! The modulated flat taper for a pointwise zero-multiplicity estimate. -/
noncomputable section
open Complex MeasureTheory Real Set Filter Topology Zeta23
open scoped BigOperators ComplexConjugate

namespace FejerMultiplicity

def test (L w t u : ℝ) : ℂ :=
  (Taper.phi Taper.smoothstep L w u : ℂ) * Complex.exp (-I * t * u)

private abbrev profile := Taper.taperProfile_smoothstep

theorem test_regular {L w : ℝ} (hw : 0 < w) (hL : 2*w ≤ L) (t : ℝ) :
    ContDiff ℝ 2 (test L w t) ∧ HasCompactSupport (test L w t) := by
  constructor
  · exact (Taper.phiC_contDiff_two profile hw hL).mul (Complex.contDiff_exp.comp
      (contDiff_const.mul Complex.ofRealCLM.contDiff))
  · exact (Taper.phiC_hasCompactSupport (L := L) profile hw).mul_right

theorem transform_test (L w t : ℝ) (s : ℂ) :
    paperFT (test L w t) s = Taper.phiHat Taper.smoothstep L w (s-t) := by
  unfold paperFT test Taper.phiHat
  congr 1
  funext u
  rw [mul_assoc, ← Complex.exp_add]
  congr 2
  ring

theorem kernel_test (L w t x : ℝ) :
    EF.weilTest (test L w t) (test L w t) x =
      (Taper.Aphi Taper.smoothstep L w x : ℂ) * Complex.exp (-I * t * x) := by
  rw [← Taper.Aphi_even (ϱ := Taper.smoothstep) (L := L) (w := w) x]
  unfold EF.weilTest Taper.Aphi Params.autocorr
  rw [convolution_def, ← integral_complex_ofReal, ← integral_mul_const]
  congr 1
  funext u
  simp only [ContinuousLinearMap.mul_apply', EF.tilde, test, neg_sub, map_mul,
    conj_ofReal, ← Complex.exp_conj, map_neg, Complex.conj_I, neg_neg, ofReal_sub, ofReal_mul, map_sub]
  rw [show u + -x = u-x by ring]
  rw [show ∀ a b c d : ℂ, a*b*(c*d)=(a*c)*(b*d) by intros; ring, ← Complex.exp_add]
  congr 2
  ring

theorem overlap_error {L w : ℝ} (hw : 0 < w) (hL : 2*w ≤ L) (x : ℝ) :
    |Taper.Aphi Taper.smoothstep L w x - max (L-|x|) 0| ≤ 2*w := by
  have h₁ := (Taper.g_ge profile hw hL x).trans (Taper.g_le_Aphi profile hw hL x)
  have h₂ := Taper.Aphi_le profile hw hL x
  rw [abs_of_nonpos (sub_nonpos.mpr h₂)]
  rcases le_total 0 (L-|x|) with h | h
  · rw [max_eq_left h]; linarith [le_max_left (L-2*w-|x|) 0]
  · rw [max_eq_right h]; linarith [le_max_right (L-2*w-|x|) 0]

theorem transform_kernel_real {L w : ℝ} (hw : 0 < w) (hL : 2*w ≤ L) (t r : ℝ) :
    paperFT (EF.weilTest (test L w t) (test L w t)) r =
      ((Taper.phiHatR Taper.smoothstep L w (r-t) ^ 2 : ℝ) : ℂ) := by
  obtain ⟨hc,hs⟩ := test_regular hw hL t
  rw [EF.paperFT_weilTest hc.continuous hc.continuous hs hs, conj_ofReal,
    transform_test, ← Complex.ofReal_sub, Taper.phiHat_ofReal, conj_ofReal, ofReal_pow, pow_two]

theorem local_taper (hRH : RiemannHypothesis) (ρ : zetaZeroConfig.carrier)
    {L w : ℝ} (hw : 0 < w) (hL : 2*w ≤ L) :
    (Zeta23.zeroMult ρ : ℝ)*Taper.phiHatR Taper.smoothstep L w 0 ^ 2 ≤
      (EF.literatureRHS (EF.weilTest (test L w (ρ : ℂ).im) (test L w (ρ : ℂ).im))).re := by
  let t := (ρ : ℂ).im
  obtain ⟨hc,hs⟩ := test_regular hw hL t
  have he := WeilEF.EF_lit_zetaZeroConfig (EF.weilTest (test L w t) (test L w t))
    (EF.weilTest_contDiff hc hc.continuous hs) (EF.weilTest_hasCompactSupport hs hs)
  let v (z : zetaZeroConfig.carrier) := (Zeta23.zeroMult z : ℝ)*
    Taper.phiHatR Taper.smoothstep L w ((z : ℂ).im - t)^2
  have hv (z : zetaZeroConfig.carrier) :
      ((zetaZeroConfig.mult z : ℂ)*paperFT (EF.weilTest (test L w t) (test L w t))
        (gammaOf z)).re = v z := by
    rw [TMA.Kernel.gammaOf_eq_im hRH z.2, transform_kernel_real hw hL, zetaZeroConfig_mult]
    simp [v, -Complex.ofReal_pow]
  have hsum : HasSum v (EF.literatureRHS (EF.weilTest (test L w t) (test L w t))).re := by
    convert Complex.hasSum_re (he.2 ▸ he.1.hasSum) using 1
    exact funext fun z => (hv z).symm
  have h := hsum.summable.sum_le_tsum ({ρ} : Finset zetaZeroConfig.carrier)
    (fun z _ => show 0 ≤ v z from mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _))
  rwa [hsum.tsum_eq, Finset.sum_singleton, show v ρ =
    (Zeta23.zeroMult ρ : ℝ)*Taper.phiHatR Taper.smoothstep L w 0 ^ 2 by simp [v,t]] at h

theorem phiHat_pole_bound {L w : ℝ} (hw : 0 < w) (hL : 2*w ≤ L)
    {t : ℝ} (ht : 0 < t) (z : ℂ) (hre : z.re = -t) (him : |z.im| = 1/2) :
    ‖Taper.phiHat Taper.smoothstep L w z‖ ≤ 2 * Real.exp (L/4) / t := by
  have h := Taper.norm_paperFT_mul_le ((Taper.phiC_contDiff profile hw hL).of_le (by norm_num))
    (Taper.phiC_support profile hw) z
  rw [Taper.deriv_ofReal_comp ((Taper.phi_contDiff profile hw hL).differentiable (by norm_num))] at h
  simp only [Complex.norm_real, Real.norm_eq_abs, Taper.integral_abs_deriv_phi profile hw hL,
    him, show (1/2 : ℝ)*(L/2)=L/4 by ring] at h
  have hh : t ≤ ‖z‖ := by simpa [hre, abs_of_pos ht] using Complex.abs_re_le_norm z
  apply (le_div_iff₀ ht).mpr
  calc _ ≤ ‖Taper.phiHat Taper.smoothstep L w z‖ * ‖z‖ :=
          mul_le_mul_of_nonneg_left hh (norm_nonneg _)
       _ ≤ _ := by simpa [Taper.phiHat, mul_comm] using h

theorem central_gamma :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ T v : ℝ, 1 ≤ T → |v| ≤ 3*T →
      mu v ≤ Real.log T / (2*π) + C := by
  obtain ⟨B,hB⟩ := gammaFacts.stirling
  refine ⟨|B| + |Real.log (3/(2*π))|/(2*π), by positivity, ?_⟩
  intro T v hT hv
  have hpos : 0 < T := by linarith
  have hev : mu v = mu |v| := by
    rcases le_or_gt 0 v with h|h
    · rw [abs_of_nonneg h]
    · rw [abs_of_neg h, gammaFacts.even]
  have hm := gammaFacts.monotoneOn (a := |v|) (b := 3*T) (abs_nonneg v) (show 0 ≤ 3*T by positivity) hv
  have hb := hB (3*T) (by rw [abs_of_pos (by positivity)]; linarith)
  rw [abs_of_pos (show 0 < 3*T by positivity)] at hb
  have hb' : B/(3*T)^2 ≤ |B| := by
    apply (div_le_iff₀ (by positivity)).mpr
    exact (le_abs_self B).trans (le_mul_of_one_le_right (abs_nonneg _) (by nlinarith [sq_nonneg (T-1)]))
  have he : Real.log (3*T/(2*π)) = Real.log T + Real.log (3/(2*π)) := by
    rw [← Real.log_mul hpos.ne' (by positivity)]; congr 1; ring
  rw [he] at hb
  rw [hev]
  have hπ : 0 < 2*π := by positivity
  have hh := (le_abs_self _).trans hb
  have hl := div_le_div_of_nonneg_right (le_abs_self (Real.log (3/(2*π)))) hπ.le
  linarith [show (1/(2*π)) * (Real.log T + Real.log (3/(2*π))) =
    Real.log T/(2*π) + Real.log (3/(2*π))/(2*π) by ring]

theorem arch_density_bound :
    ∃ C K : ℝ, 0 ≤ C ∧ 0 ≤ K ∧ ∀ T t x : ℝ, 1 ≤ T → T ≤ t → t ≤ 2*T →
      mu (t+x) ≤ Real.log T/(2*π) + C +
        (if 1 ≤ |x| then K*(1+|x|)^(1/2 : ℝ) else 0) := by
  obtain ⟨C,hC,hmid⟩ := central_gamma
  obtain ⟨B,hB,hbound⟩ := EF.abs_mu_le_of_gammaFacts gammaFacts
  refine ⟨C,2*B,hC,by positivity,?_⟩
  intro T t x hT ht ht'
  have ht0 : 0 ≤ t := by linarith
  have hx := abs_add_le t x
  rw [abs_of_nonneg ht0] at hx
  by_cases h : |x| ≤ T
  · have hmax := hmid T (t+x) hT (by linarith)
    split_ifs <;> linarith [show 0 ≤ 2*B*(1+|x|)^(1/2 : ℝ) by positivity]
  · rw [if_pos (by linarith : 1 ≤ |x|)]
    have hp : 1+|t+x| ≤ 4*(1+|x|) := by linarith
    have hp' := Real.rpow_le_rpow (by positivity) hp (show 0 ≤ (1/2 : ℝ) by norm_num)
    rw [Real.mul_rpow (by norm_num) (by positivity), show (4 : ℝ)^(1/2 : ℝ) = 2 by rw [← Real.sqrt_eq_rpow]; norm_num] at hp'
    have hb := (le_abs_self _).trans (hbound (t+x))
    have hl : 0 ≤ Real.log T/(2*π) := div_nonneg (Real.log_nonneg hT) (by positivity)
    nlinarith [mul_le_mul_of_nonneg_left hp' hB]

private def envelope (x : ℝ) := (1+‖x‖)^(-(3/2) : ℝ)

private theorem envelope_integrable : Integrable envelope := by
  exact integrable_one_add_norm (by rw [Module.finrank_self]; norm_num)

theorem gamma_integral_bound :
    ∃ C D : ℝ, 0 ≤ C ∧ 0 ≤ D ∧ ∀ T t L w : ℝ, 1 ≤ T → T ≤ t → t ≤ 2*T →
      0 < w → 2*w ≤ L →
      (∫ x : ℝ, Taper.phiHatR Taper.smoothstep L w x ^ 2 * mu (t+x)) ≤
        L*Real.log T + C*L + D := by
  obtain ⟨C,K,hC,hK,hmu⟩ := arch_density_bound
  refine ⟨2*π*C,16*K*∫ x, envelope x,by positivity,?_,?_⟩
  · exact mul_nonneg (by positivity) (integral_nonneg fun x => Real.rpow_nonneg (by positivity) _)
  intro T t L w hT ht h2 hw hL
  let F := Taper.phiHatR Taper.smoothstep L w
  let B := Real.log T/(2*π)+C
  have hB : 0 ≤ B := add_nonneg (div_nonneg (Real.log_nonneg hT) (by positivity)) hC
  have hLP : 0 ≤ L := by linarith
  have hi := Taper.integrable_phiHatR_sq profile hw hL
  have hmain : (∫ x : ℝ, F x^2) ≤ 2*π*L := by
    rw [show (∫ x : ℝ, F x^2) = _ from Taper.integral_phiHatR_sq profile hw hL]
    nlinarith [mul_nonneg (mul_nonneg (show 0 ≤ 2*π by positivity)
      (sub_nonneg.mpr (Taper.aConst_le_one profile hw hL))) hLP]
  have htail (x : ℝ) (hx : 1 ≤ |x|) :
      F x^2 * (1+|x|)^(1/2 : ℝ) ≤ 16*envelope x := by
    have hF := Taper.abs_phiHatR_mul_abs_le profile hw hL x
    change |F x| * |x| ≤ 2 at hF
    have ha : |F x| *(1+|x|) ≤ 4 := by nlinarith [mul_nonneg (abs_nonneg (F x)) (sub_nonneg.mpr hx)]
    have hs := pow_le_pow_left₀ (show 0 ≤ |F x| *(1+|x|) by positivity) ha 2
    rw [mul_pow, sq_abs] at hs
    unfold envelope
    rw [Real.norm_eq_abs, show (1/2 : ℝ) = 2 + (-(3/2)) by norm_num,
      Real.rpow_add (by positivity), Real.rpow_two, ← mul_assoc]
    exact mul_le_mul_of_nonneg_right (by nlinarith : F x ^ 2 * (1+|x|)^2 ≤ 16) (by positivity)
  by_cases hint : Integrable (fun x : ℝ => F x^2 * mu (t+x))
  · have hcomp := integral_mono hint ((hi.mul_const B).add (envelope_integrable.const_mul (16*K)))
        (g := fun x : ℝ => F x^2 * B + 16*K*envelope x) (fun x => by
      have h := mul_le_mul_of_nonneg_left (hmu T t x hT ht h2) (sq_nonneg (F x))
      change F x^2 * mu (t+x) ≤ F x^2 * (B+_) at h
      by_cases hx : 1 ≤ |x|
      · rw [if_pos hx] at h
        nlinarith [mul_le_mul_of_nonneg_left (htail x hx) hK]
      · rw [if_neg hx, add_zero] at h
        exact h.trans (le_add_of_nonneg_right (mul_nonneg (by positivity)
          (Real.rpow_nonneg (by positivity) _))))
    rw [integral_add (hi.mul_const B) (envelope_integrable.const_mul _), integral_mul_const,
      integral_const_mul] at hcomp
    have hb := mul_le_mul_of_nonneg_right hmain hB
    dsimp [B] at hb
    have hcancel : 2*π*L*(Real.log T/(2*π)+C)=L*Real.log T+2*π*C*L := by
      field_simp
    rw [hcancel] at hb
    exact hcomp.trans (add_le_add_left hb _)
  · change (∫ x : ℝ, F x^2 * mu (t+x)) ≤ _
    rw [integral_undef hint]
    have hh := Real.log_nonneg hT
    have hI : 0 ≤ ∫ x, envelope x := integral_nonneg fun x => Real.rpow_nonneg (by positivity) _
    positivity

def band (L : ℝ) := Finset.Ioc 0 ⌊Real.exp L⌋₊
def primeTerm (L t : ℝ) (weight : ℝ → ℝ) : ℝ :=
  ∑ n ∈ band L, (ArithmeticFunction.vonMangoldt n / Real.sqrt n) *
    weight (Real.log n) * (Complex.exp (-I*t*(Real.log n : ℝ))).re

theorem taper_prime {L w : ℝ} (hw : 0 < w) (t : ℝ) :
    (∑' n : ℕ, ((ArithmeticFunction.vonMangoldt n / Real.sqrt n : ℝ) : ℂ) *
      (EF.weilTest (test L w t) (test L w t) (Real.log n) +
       EF.weilTest (test L w t) (test L w t) (-Real.log n))).re =
      2 * primeTerm L t (Taper.Aphi Taper.smoothstep L w) := by
  have hs : tsupport (test L w t) ⊆ Icc (-(L/2)) (L/2) :=
    tsupport_subset_of_support_subset_abs (fun u hu =>
      Taper.phiC_support profile hw u (left_ne_zero_of_mul hu))
  rw [tsum_eq_sum (s := band L) (fun n hn => EF.prime_summand_eq_zero
    (EF.tsupport_weilTest_subset hs hs) hn), Complex.re_sum, primeTerm, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n _
  have hconj (x : ℝ) : Complex.exp (-I*(t : ℂ)*(-x : ℝ)) =
      conj (Complex.exp (-I*(t : ℂ)*x)) := by
    rw [← Complex.exp_conj]
    congr 1
    simp only [map_mul, map_neg, Complex.conj_I, neg_neg, conj_ofReal, ofReal_neg]
    ring
  rw [kernel_test, kernel_test, Taper.Aphi_even, hconj]
  simp only [Complex.mul_re, Complex.add_re, ofReal_re, ofReal_im, zero_mul,
    sub_zero, Complex.conj_re]
  ring

theorem pole_pair {L w t : ℝ} (hw : 0 < w) (hL : 2*w ≤ L) (ht : 0 < t) :
    (paperFT (EF.weilTest (test L w t) (test L w t)) (I/2) +
     paperFT (EF.weilTest (test L w t) (test L w t)) (-I/2)).re ≤
      2*(2*Real.exp (L/4)/t)^2 := by
  obtain ⟨hc,hs⟩ := test_regular hw hL t
  have onePole (z : ℂ) (hr : z.re = 0) (hi : |z.im| = 1/2) :
      (paperFT (EF.weilTest (test L w t) (test L w t)) z).re ≤ (2*Real.exp (L/4)/t)^2 := by
    apply (Complex.re_le_norm _).trans
    rw [EF.paperFT_weilTest hc.continuous hc.continuous hs hs, transform_test, transform_test,
      norm_mul, Complex.norm_conj, pow_two]
    apply mul_le_mul (phiHat_pole_bound hw hL ht _ (by simp [hr]) (by simpa using hi))
      (phiHat_pole_bound hw hL ht _ (by simp [hr]) (by simpa using hi)) (norm_nonneg _) (by positivity)
  rw [Complex.add_re]
  linarith [onePole (I/2) (by norm_num) (by norm_num), onePole (-I/2) (by norm_num) (by norm_num)]

theorem arch_real {L w : ℝ} (hw : 0 < w) (hL : 2*w ≤ L) (t : ℝ) :
    (∫ r : ℝ, paperFT (EF.weilTest (test L w t) (test L w t)) r * (mu r : ℂ)).re =
      ∫ x : ℝ, Taper.phiHatR Taper.smoothstep L w x ^ 2 * mu (t+x) := by
  simp_rw [transform_kernel_real hw hL, ← Complex.ofReal_mul]
  rw [integral_complex_ofReal, Complex.ofReal_re]
  conv_lhs => rw [← integral_add_left_eq_self _ t]
  simp

theorem center_lower {L w : ℝ} (hw : 0 < w) (hL : 2*w ≤ L) :
    L-2*w ≤ Taper.phiHatR Taper.smoothstep L w 0 := by
  have h := (Taper.g_ge profile hw hL 0).trans (Taper.g_le_Aphi profile hw hL 0)
  simp only [abs_zero,sub_zero] at h
  refine ((le_max_left _ _).trans h).trans ?_
  unfold Taper.Aphi Params.autocorr Taper.phiHatR Taper.phiHat
  rw [Complex.ofReal_zero, Taper.paperFT_ofReal_zero, Complex.ofReal_re]
  simp only [add_zero]
  refine integral_mono (by simpa using Taper.integrable_phi_mul_shift profile hw hL 0)
    (Taper.phi_integrable profile hw hL) (fun u => ?_)
  exact mul_le_of_le_one_right (Taper.phi_nonneg profile _) (Taper.phi_le_one profile _)

private theorem taper_eventually {L : ℝ} (hL : 0 < L) :
    ∀ᶠ w in 𝓝[>] (0 : ℝ), 0 < w ∧ 2*w ≤ L := by
  filter_upwards [self_mem_nhdsWithin, eventually_nhdsWithin_of_eventually_nhds
    (eventually_lt_nhds (show (0 : ℝ) < L/2 by positivity))] with w hw hwL
  exact ⟨hw,by linarith⟩

theorem overlap_limit {L : ℝ} (hL : 0 < L) (x : ℝ) :
    Tendsto (fun w => Taper.Aphi Taper.smoothstep L w x) (𝓝[>] (0 : ℝ))
      (𝓝 (max (L-|x|) 0)) := by
  apply tendsto_iff_norm_sub_tendsto_zero.mpr
  apply squeeze_zero' (Eventually.of_forall fun _ => norm_nonneg _)
  · filter_upwards [taper_eventually hL] with w hw
    exact overlap_error hw.1 hw.2 x
  · simpa using (tendsto_const_nhds (x := (2 : ℝ))).mul
      (show Tendsto (fun w : ℝ => w) (𝓝[>] 0) (𝓝 0) from tendsto_id.mono_left nhdsWithin_le_nhds)

theorem triangular_bound (hRH : RiemannHypothesis) :
    ∃ C D : ℝ, 0 ≤ C ∧ 0 ≤ D ∧ ∀ (T L : ℝ) (ρ : zetaZeroConfig.carrier),
      1 ≤ T → T ≤ (ρ : ℂ).im → (ρ : ℂ).im ≤ 2*T → 0 < L →
      (Zeta23.zeroMult ρ : ℝ)*L^2 ≤ 2*(2*Real.exp (L/4)/(ρ : ℂ).im)^2 +
        (L*Real.log T+C*L+D) - 2*primeTerm L (ρ : ℂ).im (fun y => max (L-|y|) 0) := by
  obtain ⟨C,D,hC,hD,hΓ⟩ := gamma_integral_bound
  refine ⟨C,D,hC,hD,?_⟩
  intro T L ρ hT ht ht' hL
  let t := (ρ : ℂ).im
  let B := 2*(2*Real.exp (L/4)/t)^2 + (L*Real.log T+C*L+D)
  have hprime : Tendsto (fun w => primeTerm L t (Taper.Aphi Taper.smoothstep L w))
      (𝓝[>] (0 : ℝ)) (𝓝 (primeTerm L t (fun y => max (L-|y|) 0))) :=
    tendsto_finsetSum _ fun n _ => (tendsto_const_nhds.mul (overlap_limit hL _)).mul_const _
  have hid : Tendsto (fun w : ℝ => w) (𝓝[>] (0 : ℝ)) (𝓝 0) :=
    tendsto_id.mono_left nhdsWithin_le_nhds
  have hleft : Tendsto (fun w => (Zeta23.zeroMult ρ : ℝ)*(L-2*w)^2) (𝓝[>] (0 : ℝ))
      (𝓝 ((Zeta23.zeroMult ρ : ℝ)*L^2)) := by
    simpa using tendsto_const_nhds.mul ((tendsto_const_nhds.sub (hid.const_mul 2)).pow 2)
  apply le_of_tendsto_of_tendsto hleft (tendsto_const_nhds.sub (hprime.const_mul 2))
  filter_upwards [taper_eventually hL] with w hw
  obtain ⟨hw,hwL⟩ := hw
  have hm := local_taper hRH ρ hw hwL
  unfold EF.literatureRHS at hm
  rw [EF.gamma_term, Complex.add_re, Complex.sub_re, taper_prime hw, arch_real hw hwL] at hm
  have h₁ := pole_pair hw hwL (show 0 < t by dsimp [t]; linarith)
  have h₂ := hΓ T t L w hT ht ht' hw hwL
  have h₃ := pow_le_pow_left₀ (sub_nonneg.mpr hwL) (center_lower hw hwL) 2
  change (Zeta23.zeroMult ρ : ℝ)*(L-2*w)^2 ≤ B-2*primeTerm L t (Taper.Aphi Taper.smoothstep L w)
  dsimp [B,t] at *
  linarith [mul_le_mul_of_nonneg_left h₃ (Nat.cast_nonneg (Zeta23.zeroMult ρ) (α := ℝ))]

def probe (b T : ℝ) (ρ : ℂ) : ℂ :=
  ∑ n ∈ BHB.Krange b T,
    (((ArithmeticFunction.vonMangoldt n / Real.log T) *
      (1-Real.log n/(b*Real.log T))/b : ℝ) : ℂ) * (n : ℂ)^(-ρ)

theorem on_line_power {ρ : ℂ} (hr : ρ.re = 1/2) {n : ℕ} (hn : 0 < n) :
    (n : ℂ)^(-ρ) = ((Real.sqrt n)⁻¹ : ℝ) * Complex.exp (-I*ρ.im*(Real.log n : ℝ)) := by
  have hnℝ : (0 : ℝ) < n := by exact_mod_cast hn
  have hnℂ : (n : ℂ) ≠ 0 := by exact_mod_cast hn.ne'
  have h : -ρ = ((-(1/2 : ℝ) : ℝ) : ℂ) + (-I*(ρ.im : ℂ)) := by
    rw [← ρ.re_add_im, hr]
    simp
    ring
  rw [h, Complex.cpow_add _ _ hnℂ]
  have hpow : (n : ℂ)^((-(1/2 : ℝ) : ℝ) : ℂ) = ((Real.sqrt n)⁻¹ : ℝ) := by
    change ((n : ℝ) : ℂ)^_ = _
    rw [← Complex.ofReal_cpow hnℝ.le, Real.rpow_neg hnℝ.le, ← Real.sqrt_eq_rpow]
  rw [hpow, Complex.cpow_def_of_ne_zero hnℂ, ← Complex.natCast_log]
  congr 2
  ring

theorem band_eq {T : ℝ} (hT : 0 < T) (b : ℝ) :
    band (b*Real.log T) = BHB.Krange b T := by
  have hh : Real.exp (b*Real.log T) = T^b := by rw [Real.rpow_def_of_pos hT,mul_comm]
  ext n
  simp only [band, BHB.Krange, BHB.ymol, hh, Finset.mem_Ioc, Finset.mem_Icc, Nat.lt_iff_add_one_le]

theorem prime_normalization {T b : ℝ} (hT : 1 < T) (hb : 0 < b) {ρ : ℂ} (hr : ρ.re=1/2) :
    primeTerm (b*Real.log T) ρ.im (fun y => max (b*Real.log T-|y|) 0) =
      (b*Real.log T)^2 * (probe b T ρ).re := by
  rw [primeTerm, band_eq (by linarith), probe, Complex.re_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun n hn => ?_
  have hh := Finset.mem_Icc.mp hn
  have hn₀ : 0 < n := hh.1
  have hnℝ : 0 < (n : ℝ) := by exact_mod_cast hn₀
  have hn₁ : (1 : ℝ) ≤ n := by exact_mod_cast hh.1
  have hTy : (0 : ℝ) < T := by linarith
  have hlen := (Nat.le_floor_iff (Real.rpow_nonneg hTy.le b)).mp hh.2
  have hnL := Real.log_le_log hnℝ hlen
  rw [Real.log_rpow hTy] at hnL
  rw [abs_of_nonneg (Real.log_nonneg hn₁), max_eq_left (by linarith), on_line_power hr hn₀]
  simp only [Complex.re_ofReal_mul]
  have hs : Real.sqrt n ≠ 0 := (Real.sqrt_pos.mpr hnℝ).ne'
  have hlog := (Real.log_pos hT).ne'
  field_simp [hb.ne',hlog,hs]

/-- Uniform local multiplicity bound for every fixed triangular bandwidth
    up to one, specialized directly to the board's dyadic zero set. -/
theorem local_bound (hRH : RiemannHypothesis) {b ε : ℝ} (hb : 0 < b) (hb' : b ≤ 1)
    (hε : 0 < ε) : ∀ᶠ T : ℝ in atTop, ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult ρ : ℝ) ≤ 1/b - 2*(probe b T ρ).re + ε := by
  obtain ⟨C,D,hC,hD,hbound⟩ := triangular_bound hRH
  have hlen : Tendsto (fun T : ℝ => b*Real.log T) atTop atTop :=
    Real.tendsto_log_atTop.const_mul_atTop hb
  filter_upwards [eventually_gt_atTop (1 : ℝ), hlen.eventually_ge_atTop 1,
    hlen.eventually_ge_atTop ((C+D+8)/ε)] with T hT hL hlarge
  intro ρ hρ
  obtain ⟨hz,ht,ht'⟩ := ThirdMoment.mem_zerosFinset.mp hρ
  let L := b*Real.log T
  have hpos : 0 < L := mul_pos hb (Real.log_pos hT)
  change 1 ≤ L at hL
  change (C+D+8)/ε ≤ L at hlarge
  have h := hbound T L ⟨ρ,hz⟩ hT.le ht.le ht' hpos
  change (Zeta23.zeroMult ρ : ℝ)*L^2 ≤ 2*(2*Real.exp (L/4)/ρ.im)^2+
    (L*Real.log T+C*L+D)-2*primeTerm L ρ.im _ at h
  rw [prime_normalization hT hb (RH_implies_on_line hRH hz)] at h
  have hlog := Real.log_nonneg hT.le
  have he : Real.exp (L/4) ≤ T := by
    rw [← Real.exp_log (show 0 < T by linarith)]
    apply Real.exp_le_exp.mpr
    dsimp [L]
    nlinarith [mul_le_mul_of_nonneg_right hb' hlog]
  have htpos : 0 < ρ.im := by linarith
  have hp : 2*Real.exp (L/4)/ρ.im ≤ 2 := (div_le_iff₀ htpos).mpr (by linarith)
  have hps := pow_le_pow_left₀ (by positivity) hp 2
  have heps := (div_le_iff₀ hε).mp hlarge
  have heps' : C*L+D+8 ≤ ε*L^2 := by
    nlinarith [mul_le_mul_of_nonneg_right heps hpos.le, mul_nonneg (by linarith : 0 ≤ D+8) (sub_nonneg.mpr hL)]
  have hcancel : (1/b)*L^2 = L*Real.log T := by dsimp [L]; field_simp
  apply (le_of_mul_le_mul_right (a := L^2) _ (sq_pos_of_pos hpos))
  nlinarith

end FejerMultiplicity
end
end Src_FejerMultiplicity

section Src_FejerPrimeMoments

/-! Frequencies and diagonal constants of the triangular prime probe. -/
noncomputable section
open Complex Real Filter Topology MeasureTheory
open scoped BigOperators ArithmeticFunction

namespace FejerPrimeMoments

/-- The real coefficient after restricting the Dirichlet polynomial to the critical line.
    X is the actual length, equal to T^b. -/
def coeff (X : ℝ) (n : ℕ) : ℝ :=
  TMA.lamCoeff n * (1-Real.log n/Real.log X) / Real.log X

def indices (X : ℝ) := Finset.Icc 2 ⌊X⌋₊

theorem probe_on_line {b T : ℝ} (hT : 1 < T) {z : ℂ} (hz : z.re = 1/2) :
    FejerMultiplicity.probe b T z = ∑ n ∈ indices (T^b),
      (coeff (T^b) n : ℂ) * Complex.exp (-I*z.im*(Real.log n : ℝ)) := by
  have hT₀ : 0 < T := by linarith
  unfold FejerMultiplicity.probe
  calc
    _ = ∑ n ∈ BHB.Krange b T, (coeff (T^b) n : ℂ) * Complex.exp (-I*z.im*(Real.log n : ℝ)) := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [FejerMultiplicity.on_line_power hz (Finset.mem_Icc.mp hn).1, ← mul_assoc]
      congr 1
      push_cast [coeff,TMA.lamCoeff,Real.log_rpow hT₀]
      ring
    _ = _ := by
      symm
      apply Finset.sum_subset
      · exact Finset.Icc_subset_Icc_left (by decide : 1 ≤ 2)
      · intro n hn hn'
        have h := Finset.mem_Icc.mp hn
        have h' := Finset.mem_Icc.not.mp hn'
        have : n = 1 := by
          change ¬ (2 ≤ n ∧ n ≤ ⌊T^b⌋₊) at h'
          change 1 ≤ n ∧ n ≤ ⌊T^b⌋₊ at h
          omega
        simp [this,coeff,TMA.lamCoeff]

private theorem diagonal_limit (j : ℕ) (v : ℝ)
    (hi : (∫ u in (0:ℝ)..1, u*(1-u)^j) = v) {η : ℝ} (hη : 0 < η) :
    ∀ᶠ X : ℝ in atTop,
      |(∑ n ∈ indices X, Λ n^2 / n * (1-Real.log n/Real.log X)^j)/Real.log X^2 - v| ≤ η := by
  obtain ⟨C,hC⟩ := TMA.primeSum_asymp (fun u : ℝ => (1-u)^j) (by fun_prop)
  filter_upwards [eventually_ge_atTop (2:ℝ),
    Real.tendsto_log_atTop.eventually_ge_atTop (C/η)] with X hX hL
  have hpos := Real.log_pos (show 1 < X by linarith)
  have h := hC X hX
  simp only [hi] at h
  rw [div_le_iff₀ hη] at hL
  rw [div_sub' (ne_of_gt (sq_pos_of_pos hpos)), abs_div, abs_of_pos (sq_pos_of_pos hpos),
    div_le_iff₀ (sq_pos_of_pos hpos)]
  exact h.trans (by nlinarith [mul_le_mul_of_nonneg_right hL hpos.le])

private theorem first_integral : (∫ u in (0:ℝ)..1, u*(1-u)^1) = 1/6 := by
  rw [show (fun u : ℝ => u*(1-u)^1) = fun u => u-u^2 by funext u; ring,
    intervalIntegral.integral_sub (f := fun u : ℝ => u) (g := fun u : ℝ => u^2)
      (continuous_id.intervalIntegrable ..) ((continuous_id.pow 2).intervalIntegrable ..), integral_id, integral_pow]
  norm_num

private theorem second_integral : (∫ u in (0:ℝ)..1, u*(1-u)^2) = 1/12 := by
  have h (k : ℕ) : IntervalIntegrable (fun u : ℝ => u^k) volume 0 1 :=
    (continuous_id.pow k).intervalIntegrable ..
  rw [show (fun u : ℝ => u*(1-u)^2) = fun u => (u-2*u^2)+u^3 by funext u; ring,
    intervalIntegral.integral_add (f := fun u : ℝ => u-2*u^2) (g := fun u : ℝ => u^3)
      (continuous_id.sub (continuous_const.mul (continuous_id.pow 2))
      |>.intervalIntegrable ..) (h 3),
    intervalIntegral.integral_sub (f := fun u : ℝ => u) (g := fun u : ℝ => 2*u^2)
      (continuous_id.intervalIntegrable ..) ((h 2).const_mul 2),
    intervalIntegral.integral_const_mul, integral_id, integral_pow, integral_pow]
  norm_num

theorem coefficient_moments {η : ℝ} (hη : 0 < η) :
    ∀ᶠ X : ℝ in atTop,
      |(∑ n ∈ indices X, coeff X n * TMA.lamCoeff n)/Real.log X-1/6| ≤ η ∧
      |(∑ n ∈ indices X, coeff X n ^ 2)-1/12| ≤ η := by
  filter_upwards [eventually_ge_atTop (2:ℝ), diagonal_limit 1 _ first_integral hη,
    diagonal_limit 2 _ second_integral hη] with X hX h₁ h₂
  have hL := (Real.log_pos (show 1 < X by linarith)).ne'
  have hs (n : ℕ) : TMA.lamCoeff n ^ 2 = Λ n^2/n := by
    simp only [TMA.lamCoeff,div_pow,Real.sq_sqrt (Nat.cast_nonneg _)]
  constructor
  · convert h₁ using 3
    rw [Finset.sum_div,Finset.sum_div]
    refine Finset.sum_congr rfl fun n hn => ?_
    rw [← hs n]
    unfold coeff
    ring
  · convert h₂ using 3
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl fun n hn => ?_
    rw [← hs n]
    unfold coeff
    ring

/-- A sampled frequency log(n/m) is isolated from every log k unless n=m*k.
    Only the numerator needs a length bound. -/
theorem integer_gap {n r : ℕ} (hn : 0 < n) (hr : 0 < r) (hne : n ≠ r) :
    1/((n:ℝ)+1) ≤ |Real.log n-Real.log r| := by
  rcases lt_or_gt_of_ne hne with h | h
  · have hgap := TMA.Packets.one_div_le_log_sub_log hn (Nat.lt_succ_self n)
    have hle := Real.log_le_log (show (0:ℝ) < n+1 by positivity)
      (show (n:ℝ)+1 ≤ r by exact_mod_cast h)
    push_cast at hgap
    linarith [neg_le_abs (Real.log n-Real.log r)]
  · have hgap := TMA.Packets.one_div_le_log_sub_log hr h
    have hp : 0 < (n:ℝ) := by exact_mod_cast hn
    have hle : 1/((n:ℝ)+1) ≤ 1/n := by gcongr; linarith
    linarith [le_abs_self (Real.log n-Real.log r)]

/-- At sub-height integer frequencies a compactly supported packet is sampled either
    at its center or outside its support. The second integer may be arbitrarily large. -/
theorem sample (w : TMA.HeightWeight) {T u : ℝ} {n r : ℕ} (hn : 0 < n) (hr : 0 < r)
    (hT : 0 < T) (hκ : w.kappa*((n:ℝ)+1) < T)
    (hu : |u| = T*|Real.log n - Real.log r|) :
    w.k u = if n = r then w.k 0 else 0 := by
  split_ifs with h
  · subst r
    simp only [sub_self,abs_zero,mul_zero,abs_eq_zero] at hu
    rw [hu]
  · apply TMA.Kernel.k_eq_zero_of_lt
    rw [hu]
    apply lt_of_lt_of_le _ (mul_le_mul_of_nonneg_left (integer_gap hn hr h) hT.le)
    rw [mul_one_div,lt_div_iff₀ (by positivity)]
    exact hκ

/-- Exact prime-side kernel on rational log frequencies. The non-diagonal terms
    involve integer divisibility and carry a minus sign. -/
theorem sampled_K0 (w : TMA.HeightWeight) {T b : ℝ} (hT : 1 < T) (hb : 0 < b)
    {n m : ℕ} (hn : 0 < n) (hm : 0 < m)
    (hκn : w.kappa*((n:ℝ)+1) < T) (hκm : w.kappa*((m:ℝ)+1) < T) :
    TMA.K0 w.k T b (TMA.lamOf T b n - TMA.lamOf T b m) =
      (Real.log (T/(2*π)):ℂ)*((T:ℂ)*(if n=m then w.k 0 else 0)) -
        ∑ k ∈ Finset.Icc 2 (TMA.Nmax T b), (TMA.lamCoeff k : ℂ)*
          ((T:ℂ)*(if n=m*k then w.k 0 else 0) +
           (T:ℂ)*(if m=n*k then w.k 0 else 0)) := by
  have hT₀ : 0 < T := by linarith
  have hL : b*Real.log T ≠ 0 := (mul_pos hb (Real.log_pos hT)).ne'
  unfold TMA.K0 TMA.packet
  congr 1
  · congr 2
    apply sample w hn hm hT₀ hκn
    unfold TMA.Asc TMA.lamOf
    rw [sub_zero, abs_neg, show T*(b*Real.log T)*(Real.log n/(b*Real.log T) -
        Real.log m/(b*Real.log T)) = T*(Real.log n-Real.log m) by field_simp [(Real.log_pos hT).ne',hb.ne']]
    rw [abs_mul,abs_of_pos hT₀]
  · refine Finset.sum_congr rfl fun k hk => ?_
    have hk' : 0 < k := by have := (Finset.mem_Icc.mp hk).1; omega
    have hk₀ : (k:ℝ) ≠ 0 := by positivity
    have hn₀ : (n:ℝ) ≠ 0 := by positivity
    have hm₀ : (m:ℝ) ≠ 0 := by positivity
    congr 1
    apply congrArg₂ (·+·)
    · congr 1
      apply sample w hn (Nat.mul_pos hm hk') hT₀ hκn
      simp only [TMA.Asc,TMA.lamOf,Nat.cast_mul,Real.log_mul hm₀ hk₀,abs_neg]
      rw [show T*(b*Real.log T)*(Real.log n/(b*Real.log T)-Real.log m/(b*Real.log T)-
          Real.log k/(b*Real.log T))=T*(Real.log n-(Real.log m+Real.log k)) by field_simp [(Real.log_pos hT).ne',hb.ne']; ring,
        abs_mul,abs_of_pos hT₀]
    · congr 1
      apply sample w hm (Nat.mul_pos hn hk') hT₀ hκm
      simp only [TMA.Asc,TMA.lamOf,Nat.cast_mul,Real.log_mul hn₀ hk₀,abs_neg,sub_neg_eq_add]
      rw [show T*(b*Real.log T)*(Real.log n/(b*Real.log T)-Real.log m/(b*Real.log T)+
          Real.log k/(b*Real.log T))=T*((Real.log n+Real.log k)-Real.log m) by field_simp [(Real.log_pos hT).ne',hb.ne']; ring,
        abs_mul,abs_of_pos hT₀,abs_sub_comm (Real.log m)]

/-- The integer-frequency spacing controls the gamma remainder by a summable
    difference kernel, including the diagonal. -/
theorem log_distance {n m : ℕ} {T : ℝ} (hn : 0 < n) (hm : 0 < m)
    (hnT : (n:ℝ) ≤ T) (hmT : (m:ℝ) ≤ T) :
    |(n:ℝ)-m| ≤ T*|Real.log n-Real.log m| := by
  have ordered {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) (hT : b ≤ T) :
      b-a ≤ T*(Real.log b-Real.log a) := by
    have hb := lt_of_lt_of_le ha hab
    have h := Real.one_sub_inv_le_log_of_pos (div_pos hb ha)
    rw [Real.log_div hb.ne' ha.ne',inv_div] at h
    have hp := mul_le_mul_of_nonneg_right h hb.le
    have he : (1-a/b)*b = b-a := by field_simp
    rw [he] at hp
    exact hp.trans (by rw [mul_comm]; gcongr; exact sub_nonneg.mpr (Real.log_le_log ha hab))
  have hn' : 0 < (n:ℝ) := by exact_mod_cast hn
  have hm' : 0 < (m:ℝ) := by exact_mod_cast hm
  rcases le_total (m:ℝ) n with h | h
  · rw [abs_of_nonneg (sub_nonneg.mpr h),abs_of_nonneg (sub_nonneg.mpr (Real.log_le_log hm' h))]
    exact ordered hm' h hnT
  · rw [abs_sub_comm,abs_sub_comm (Real.log n),
      abs_of_nonneg (sub_nonneg.mpr h),abs_of_nonneg (sub_nonneg.mpr (Real.log_le_log hn' h))]
    exact ordered hn' h hmT

def weight (k : ℤ) : ℝ := 1/(1+(k:ℝ)^2)

theorem weight_summable : Summable weight := by
  have hs := (Real.summable_one_div_int_pow (p := 2)).mpr (by decide)
  have hz : Summable (fun k : ℤ => if k=0 then (1:ℝ) else 0) := (hasSum_ite_eq 0 (1:ℝ)).summable
  apply Summable.of_nonneg_of_le (fun k => by unfold weight; positivity) _ (hz.add hs)
  intro k
  by_cases hk : k=0
  · simp [hk,weight]
  · simp only [weight,if_neg hk,zero_add]
    have h : (k:ℝ) ≠ 0 := by exact_mod_cast hk
    exact one_div_le_one_div_of_le (sq_pos_of_ne_zero h) (by linarith)

theorem weight_row (S : Finset ℕ) (m : ℕ) :
    ∑ n ∈ S, weight ((n:ℤ)-m) ≤ ∑' k : ℤ, weight k := by
  let e : ℕ ↪ ℤ := ⟨fun n => (n:ℤ)-m,fun a b h => by dsimp at h; omega⟩
  have h := weight_summable.sum_le_tsum (S.map e) (fun k _ => by unfold weight; positivity)
  rw [Finset.sum_map] at h
  exact h

theorem schur (S : Finset ℕ) (a : ℕ → ℝ) :
    ∑ n ∈ S, ∑ m ∈ S, |a n*a m| *weight ((n:ℤ)-m) ≤
      (∑' k : ℤ, weight k)*∑ n ∈ S, (a n)^2 := by
  have he (n m : ℕ) : weight ((n:ℤ)-m) = weight ((m:ℤ)-n) := by
    unfold weight; push_cast; ring
  let B (n m : ℕ) := a n^2*weight ((m:ℤ)-n)
  have hrow (n : ℕ) : ∑ m ∈ S, B n m ≤ a n^2*(∑' k : ℤ, weight k) := by
    simp only [B,← Finset.mul_sum]
    exact mul_le_mul_of_nonneg_left (weight_row S n) (sq_nonneg _)
  have hpt (n m : ℕ) :
      2*(|a n*a m| *weight ((n:ℤ)-m)) ≤ B n m + B m n := by
    dsimp [B]; rw [← he n m,abs_mul,← add_mul]
    have hm := mul_le_mul_of_nonneg_right
      (show 2*(|a n| *|a m|) ≤ a n^2+a m^2 by nlinarith [sq_abs (a n),sq_abs (a m),sq_nonneg (|a n| - |a m|)])
      (show 0 ≤ weight ((n:ℤ)-m) by unfold weight; positivity)
    linarith only [hm]
  have h := Finset.sum_le_sum (s := S) fun n _ => Finset.sum_le_sum (s := S) fun m _ => hpt n m
  simp only [← Finset.mul_sum,Finset.sum_add_distrib] at h
  rw [Finset.sum_comm (f := fun n m => B m n)] at h
  have hx := Finset.sum_le_sum (s := S) fun n _ => hrow n
  rw [← Finset.sum_mul,mul_comm] at hx
  linarith

/-- Pointwise form of the gamma and pole estimates in TMA.Kernel, retained for
    sums over the rational logarithms of the prime polynomial. -/
theorem kernel_decay (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {b : ℝ}
    (hb : 0 < b) (hb' : b ≤ 1) : ∃ C G : ℝ, 0 ≤ C ∧ 0 ≤ G ∧
    ∀ᶠ T : ℝ in atTop, ∀ x : ℝ, |x| ≤ 1 →
      ‖TMA.Kfull w.h T b x - TMA.K0 w.k T b x‖ ≤ C + T*(G/(1+(TMA.Asc T b*x)^2)) := by
  obtain ⟨G,hG⟩ := w.gammaBound
  obtain ⟨R,hR₀,hR⟩ := TMA.Kernel.norm_Rterm_le w
  let P := 2*(w.kappa*∫ u, ‖w.k u‖)
  have hi : 0 ≤ ∫ u, ‖w.k u‖ := integral_nonneg fun _ => norm_nonneg _
  have hP : 0 ≤ P := mul_nonneg (by norm_num) (mul_nonneg w.kappa_pos.le hi)
  refine ⟨2*P+R,max G 0,by positivity,le_max_right _ _,?_⟩
  have hl2 := Real.log_pos (show (1:ℝ)<2 by norm_num)
  filter_upwards [eventually_ge_atTop (2:ℝ),eventually_ge_atTop w.kappa,
    eventually_ge_atTop (w.kappa/Real.log 2),Real.tendsto_log_atTop.eventually_ge_atTop 1]
    with T hT hκ hκ' hL
  rw [div_le_iff₀ hl2] at hκ'
  have hT₁ : 1 < T := by linarith
  have hT₀ : 0 < T := by linarith
  intro x hx
  have h₁ := TMA.Kernel.norm_pole_le w hT₁ hκ hb.le hb' hx (ε := I/2) (by simp)
  have h₂ := TMA.Kernel.norm_pole_le w hT₁ hκ hb.le hb' hx (ε := -I/2) (by simp)
  have h₃ := hR T hT₁.le (TMA.Asc T b*x)
  have h_g := hG T hT (TMA.Asc T b*x)
  change ‖TMA.Kernel.komega w T (TMA.Asc T b*x)‖ ≤ _ at h_g
  have h₄ : ‖(T:ℂ)*TMA.Kernel.komega w T (TMA.Asc T b*x)‖ ≤
      T*(max G 0/(1+(TMA.Asc T b*x)^2)) := by
    rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hT₀]
    exact mul_le_mul_of_nonneg_left (h_g.trans (by gcongr; exact le_max_left ..)) hT₀.le
  have hP' := div_le_self hP hL
  have hR' := div_le_self hR₀ hT₁.le
  change _ ≤ P/Real.log T at h₁ h₂
  rw [TMA.Kernel.E_eq hRH w hT₁ hκ' hb hx]
  exact norm_add₄_le.trans (by linarith only [h₁,h₂,h₃,h₄,hP',hR'])

theorem sampled_error (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {b : ℝ}
    (hb : 0 < b) (hb' : b ≤ 1) : ∃ C G : ℝ, 0 ≤ C ∧ 0 ≤ G ∧
    ∀ᶠ T : ℝ in atTop, ∀ n ∈ BHB.Krange b T, ∀ m ∈ BHB.Krange b T,
      let x := TMA.lamOf T b n - TMA.lamOf T b m
      ‖TMA.Kfull w.h T b x - TMA.K0 w.k T b x‖ ≤ C + T*G*weight ((n:ℤ)-m) := by
  obtain ⟨C,G,hC,hG,h⟩ := kernel_decay hRH w hb hb'
  refine ⟨C,G,hC,hG,?_⟩
  filter_upwards [h,eventually_ge_atTop (2:ℝ)] with T hT hT₂
  have hp : 0 < T := by linarith
  have hl := Real.log_pos (show 1 < T by linarith)
  have hlen : T^b ≤ T := by
    calc _ ≤ T^(1:ℝ) := Real.rpow_le_rpow_of_exponent_le (by linarith) hb'
         _ = T := Real.rpow_one T
  have ht (n : ℕ) (hn : n ∈ BHB.Krange b T) : 0 < n ∧ (n:ℝ) ≤ T ∧ TMA.lamOf T b n ∈ Set.Icc (0:ℝ) 1 := by
    obtain ⟨h₁,h₂⟩ := Finset.mem_Icc.mp hn
    have hn₁ : 1 ≤ (n:ℝ) := by exact_mod_cast h₁
    have h₂' := (Nat.le_floor_iff (Real.rpow_nonneg hp.le b)).mp h₂
    have hln := Real.log_le_log (by linarith : 0 < (n:ℝ)) h₂'
    rw [Real.log_rpow hp] at hln
    exact ⟨h₁,h₂'.trans hlen,div_nonneg (Real.log_nonneg hn₁) (mul_pos hb hl).le,
      (div_le_one (mul_pos hb hl)).mpr hln⟩
  intro n hn m hm
  obtain ⟨hn₁,hnT,hnl,hnu⟩ := ht n hn
  obtain ⟨hm₁,hmT,hml,hmu⟩ := ht m hm
  let x := TMA.lamOf T b n - TMA.lamOf T b m
  have hx : |x| ≤ 1 := by dsimp [x]; exact abs_le.mpr ⟨by linarith,by linarith⟩
  have hscale : TMA.Asc T b*x=T*(Real.log n - Real.log m) := by
    unfold x TMA.Asc TMA.lamOf
    field_simp [hb.ne',hl.ne']
  have hd := log_distance hn₁ hm₁ hnT hmT
  rw [← abs_of_pos hp,← abs_mul] at hd
  have hs := sq_le_sq.mpr hd
  apply (hT x hx).trans
  rw [hscale,mul_assoc]
  unfold weight
  push_cast
  apply add_le_add_right
  apply mul_le_mul_of_nonneg_left _ hp.le
  rw [mul_one_div]
  exact div_le_div_of_nonneg_left hG (by positivity) (by linarith)

def polynomial (S : Finset ℕ) (a : ℕ → ℝ) (T b : ℝ) (z : ℂ) : ℂ :=
  ∑ n ∈ S, (a n:ℂ)*TMA.phase T b z (TMA.lamOf T b n)

def gram (S : Finset ℕ) (a : ℕ → ℝ) (T b : ℝ) (K : ℝ → ℂ) : ℝ :=
  ∑ n ∈ S, ∑ m ∈ S, a n*a m*(K (TMA.lamOf T b n-TMA.lamOf T b m)).re

theorem phase_sub (T b : ℝ) (z : ℂ) (x y : ℝ) :
    TMA.phase T b z (x-y) = TMA.phase T b z x*(starRingEnd ℂ) (TMA.phase T b z y) := by
  unfold TMA.phase
  rw [← Complex.exp_conj,← Complex.exp_add]
  congr 1
  push_cast
  simp only [map_mul,Complex.conj_I,Complex.conj_ofReal]
  ring

private theorem point_gram (S : Finset ℕ) (a : ℕ → ℝ) (T b : ℝ) (z : ℂ) :
    gram S a T b (TMA.phase T b z) = ‖polynomial S a T b z‖^2 := by
  have hc : ∑ n ∈ S, ∑ m ∈ S, ((a n*a m:ℝ):ℂ)*TMA.phase T b z
      (TMA.lamOf T b n-TMA.lamOf T b m) =
      polynomial S a T b z * (starRingEnd ℂ) (polynomial S a T b z) := by
    unfold polynomial
    simp only [map_sum,map_mul,Complex.conj_ofReal,Finset.sum_mul,Finset.mul_sum,
      phase_sub,Complex.ofReal_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro n _
    apply Finset.sum_congr rfl
    intro m _
    ring
  rw [Complex.mul_conj,Complex.normSq_eq_norm_sq] at hc
  have hh := congrArg Complex.re hc
  simpa only [gram,Complex.re_sum,Complex.re_ofReal_mul,Complex.ofReal_re] using hh

theorem gram_at_zeros (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {T : ℝ} (hT : 0 < T)
    (b : ℝ) (S : Finset ℕ) (a : ℕ → ℝ) :
    HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z * ‖polynomial S a T b z‖^2)
      (gram S a T b (TMA.Kfull w.h T b)) := by
  have h (n m : ℕ) := (Complex.hasSum_re (TMA.Kernel.summable_cw_phase hRH w hT b
    (TMA.lamOf T b n-TMA.lamOf T b m)).hasSum).mul_left (a n*a m)
  have hs := hasSum_sum (s := S) fun n _ => hasSum_sum (s := S) fun m _ => h n m
  convert hs using 1 <;> try rfl
  funext z
  rw [← point_gram]
  unfold gram
  simp only [Complex.re_ofReal_mul,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n _
  apply Finset.sum_congr rfl
  intro m _
  ring

/-- The sum of absolute kernel remainders is O(T) times the diagonal energy.
This also controls any subset of the frequency pairs. -/
theorem absolute_gram_error (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {b : ℝ}
    (hb : 0 < b) (hb' : b ≤ 1) : ∃ D : ℝ, 0 ≤ D ∧ ∀ᶠ T : ℝ in atTop,
    ∀ (S : Finset ℕ), S ⊆ BHB.Krange b T → ∀ a : ℕ → ℝ,
      (∑ n ∈ S, ∑ m ∈ S, |a n*a m| * ‖(TMA.Kfull w.h T b - TMA.K0 w.k T b)
        (TMA.lamOf T b n-TMA.lamOf T b m)‖) ≤
        D*T*∑ n ∈ S, a n^2 := by
  obtain ⟨C,G,hC,hG,h⟩ := sampled_error hRH w hb hb'
  let M := ∑' k : ℤ, weight k
  have hM : 0 ≤ M := tsum_nonneg fun k => by unfold weight; positivity
  refine ⟨C+G*M,by positivity,?_⟩
  filter_upwards [h,eventually_ge_atTop (2:ℝ)] with T hT hT₂
  intro S hS a
  have hp : 0 ≤ T := by linarith
  have hcard : (S.card:ℝ) ≤ T := by
    have hcard := Finset.card_le_card hS
    simp only [BHB.Krange,BHB.ymol,Nat.card_Icc,Nat.add_sub_cancel] at hcard
    have hfloor := Nat.floor_le (Real.rpow_nonneg hp b)
    have hbT := Real.rpow_le_rpow_of_exponent_le (by linarith : 1 ≤ T) hb'
    rw [Real.rpow_one] at hbT
    exact (Nat.cast_le.mpr hcard).trans (hfloor.trans hbT)
  have hpt (n : ℕ) (hn : n ∈ S) (m : ℕ) (hm : m ∈ S) :
      let x := TMA.lamOf T b n-TMA.lamOf T b m
      |a n*a m| * ‖(TMA.Kfull w.h T b - TMA.K0 w.k T b) x‖ ≤
        C*(|a n| *|a m|) + T*G*(|a n*a m| * weight ((n:ℤ)-m)) := by
    dsimp only [Pi.sub_apply]
    have h1 := mul_le_mul_of_nonneg_left (hT n (hS hn) m (hS hm))
      (abs_nonneg (a n*a m))
    simp only [abs_mul] at h1 ⊢
    linarith only [h1]
  have hf := Finset.sum_le_sum (s := S) fun n hn => Finset.sum_le_sum (s := S) fun m hm => hpt n hn m hm
  refine hf.trans ?_
  simp only [Finset.sum_add_distrib,← Finset.mul_sum,← Finset.sum_mul]
  have hcs := Finset.sum_mul_sq_le_sq_mul_sq S (fun n => |a n|) (fun _ => (1:ℝ))
  simp only [mul_one,sq_abs,one_pow,Finset.sum_const,nsmul_eq_mul] at hcs
  have he : 0 ≤ ∑ n ∈ S, a n^2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
  have h₁ := mul_le_mul_of_nonneg_left (hcs.trans (mul_le_mul_of_nonneg_left hcard he)) hC
  have h₂ := mul_le_mul_of_nonneg_left (schur S a) (mul_nonneg hp hG)
  dsimp [M]
  nlinarith only [h₁,h₂]

/-- The signed Gram form inherits the same error estimate. -/
theorem gram_error (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {b : ℝ}
    (hb : 0 < b) (hb' : b ≤ 1) : ∃ D : ℝ, 0 ≤ D ∧ ∀ᶠ T : ℝ in atTop,
    ∀ (S : Finset ℕ), S ⊆ BHB.Krange b T → ∀ a : ℕ → ℝ,
      gram S a T b (TMA.Kfull w.h T b) - gram S a T b (TMA.K0 w.k T b) ≤
        D*T*∑ n ∈ S, a n^2 := by
  obtain ⟨D,hD,h⟩ := absolute_gram_error hRH w hb hb'
  refine ⟨D,hD,?_⟩
  filter_upwards [h] with T h
  intro S hS a
  apply le_trans _ (h S hS a)
  unfold gram
  simp only [← Finset.sum_sub_distrib]
  apply Finset.sum_le_sum
  intro n _
  apply Finset.sum_le_sum
  intro m _
  rw [← mul_sub,← Complex.sub_re]
  exact (le_abs_self _).trans ((abs_mul ..).le.trans (mul_le_mul_of_nonneg_left
    (Complex.abs_re_le_norm _) (abs_nonneg _)))

def divisorMass (K n m : ℕ) : ℝ := ∑ k ∈ Finset.Icc 2 K, TMA.lamCoeff k *
  ((if n=m*k then (1:ℝ) else 0) + (if m=n*k then 1 else 0))

theorem divisorMass_nonneg (K n m : ℕ) : 0 ≤ divisorMass K n m := by
  unfold divisorMass
  apply Finset.sum_nonneg
  intro k _
  have h : 0 ≤ TMA.lamCoeff k := div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _)
  split_ifs <;> positivity

theorem divisorMass_comm (K n m : ℕ) : divisorMass K n m = divisorMass K m n := by
  unfold divisorMass
  apply Finset.sum_congr rfl
  intro k _
  rw [add_comm]

theorem divisorMass_at_one (K n : ℕ) (hn : 0 < n) : divisorMass K n 1 =
    if n ∈ Finset.Icc 2 K then TMA.lamCoeff n else 0 := by
  unfold divisorMass
  have h (k : ℕ) (hk : k ∈ Finset.Icc 2 K) : 1 ≠ n*k := by
    have := (Finset.mem_Icc.mp hk).1
    have := Nat.le_mul_of_pos_left k hn
    omega
  calc
    _ = ∑ k ∈ Finset.Icc 2 K, if k=n then TMA.lamCoeff n else 0 := by
      apply Finset.sum_congr rfl
      intro k hk
      simp only [one_mul,if_neg (h k hk),add_zero]
      by_cases he : k=n
      · subst n; simp
      · simp [he,Ne.symm he]
    _ = _ := by simp

theorem divisorMass_one (K n : ℕ) (hn : 0 < n) : divisorMass K n 1 ≤ TMA.lamCoeff n := by
  rw [divisorMass_at_one K n hn]
  split_ifs
  · exact le_rfl
  · exact div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _)

theorem divisorMass_one_exact {K n : ℕ} (hn : 0 < n) (hK : n ≤ K) :
    divisorMass K n 1 = TMA.lamCoeff n := by
  rw [divisorMass_at_one K n hn]
  by_cases h : n=1
  · simp [h,TMA.lamCoeff]
  · rw [if_pos (Finset.mem_Icc.mpr ⟨by omega,hK⟩)]

theorem sampled_real (w : TMA.HeightWeight) {T b : ℝ} (hT : 1 < T) (hb : 0 < b)
    {n m : ℕ} (hn : 0 < n) (hm : 0 < m)
    (hκn : w.kappa*((n:ℝ)+1) < T) (hκm : w.kappa*((m:ℝ)+1) < T) :
    (TMA.K0 w.k T b (TMA.lamOf T b n-TMA.lamOf T b m)).re =
       (if n=m then T*(w.kap1/(2*π))*Real.log (T/(2*π)) else 0)
       - T*(w.kap1/(2*π))*divisorMass (TMA.Nmax T b) n m := by
  rw [sampled_K0 w hT hb hn hm hκn hκm, TMA.T12.k_zero,Complex.sub_re,Complex.re_sum]
  congr 1
  · split_ifs
    · simp only [Complex.re_ofReal_mul,Complex.ofReal_re]; ring
    · simp
  · unfold divisorMass
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k _
    split_ifs <;> simp only [Complex.re_ofReal_mul,Complex.ofReal_re,Complex.add_re,Complex.zero_re,mul_zero,zero_add,add_zero] <;> ring

theorem eventual_sample (w : TMA.HeightWeight) {b : ℝ} (hb : 0 < b) (hb' : b < 1) :
    ∀ᶠ T : ℝ in atTop, ∀ n ∈ BHB.Krange b T, w.kappa*((n:ℝ)+1) < T := by
  filter_upwards [(tendsto_rpow_atTop (by linarith : 0 < 1-b)).eventually_gt_atTop (2*w.kappa),
    eventually_ge_atTop (2:ℝ)] with T hε hT
  have hp : 0 < T := by linarith
  have h₁ : 1 ≤ T^b := Real.one_le_rpow (by linarith) hb.le
  intro n hn
  have h₂ := (Nat.le_floor_iff (Real.rpow_nonneg hp.le b)).mp (Finset.mem_Icc.mp hn).2
  have h := mul_lt_mul_of_pos_right hε (Real.rpow_pos_of_pos hp b)
  rw [← Real.rpow_add hp,sub_add_cancel,Real.rpow_one] at h
  exact (mul_le_mul_of_nonneg_left (by linarith : (n:ℝ)+1 ≤ 2*T^b) w.kappa_pos.le).trans_lt (by linarith)

def shifted (a : ℕ → ℝ) (d : ℝ) (n : ℕ) : ℝ := if n=1 then -d else a n

private theorem coeff_nonneg {X : ℝ} (hX : 1 < X) {n : ℕ} (hn : 0 < n) (hnX : (n:ℝ) ≤ X) :
    0 ≤ coeff X n := by
  have hL := Real.log_pos hX
  have h := Real.log_le_log (by positivity : 0 < (n:ℝ)) hnX
  unfold coeff TMA.lamCoeff
  exact div_nonneg (mul_nonneg (div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _))
    (sub_nonneg.mpr ((div_le_one hL).mpr h))) hL.le

theorem shifted_point {a : ℕ → ℝ} {K n m : ℕ} (hn : 0 < n) (hm : 0 < m)
    (han : 0 ≤ a n) (ham : 0 ≤ a m) {d : ℝ} (hd : 0 ≤ d) :
    -(shifted a d n*shifted a d m)*divisorMass K n m ≤
    (if n=1 then d*a m*TMA.lamCoeff m else 0) +
    (if m=1 then d*a n*TMA.lamCoeff n else 0) := by
  have h := divisorMass_nonneg K n m
  have hl (j : ℕ) : 0 ≤ TMA.lamCoeff j := div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _)
  by_cases hn' : n=1 <;> by_cases hm' : m=1
  · simp only [hn',hm',shifted,if_true]
    subst n; subst m
    exact (mul_nonpos_of_nonpos_of_nonneg (by nlinarith [sq_nonneg d]) h).trans (by simp [TMA.lamCoeff])
  · subst n
    simp only [shifted,if_true,if_neg hm',add_zero,neg_mul,neg_neg]
    rw [divisorMass_comm]
    exact mul_le_mul_of_nonneg_left (divisorMass_one K m hm) (mul_nonneg hd ham)
  · subst m
    simp only [shifted,if_true,if_neg hn',zero_add,mul_neg,neg_neg]
    rw [mul_comm (a n) d]
    exact mul_le_mul_of_nonneg_left (divisorMass_one K n hn) (mul_nonneg hd han)
  · simp only [shifted,if_neg hn',if_neg hm',add_zero]
    exact mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr (mul_nonneg han ham)) h

theorem prime_gram_signed (w : TMA.HeightWeight) {T b d : ℝ} (hT : 1 < T) (hb : 0 < b)
    (S : Finset ℕ) (hsign : 0 ≤ d ∨ ∀ n ∈ S, n ≤ TMA.Nmax T b) (h1 : 1 ∈ S) (hp : ∀ n ∈ S, 0 < n)
    (hκ : ∀ n ∈ S, w.kappa*((n:ℝ)+1) < T) (a : ℕ → ℝ) (ha : ∀ n ∈ S, 0 ≤ a n) :
    gram S (shifted a d) T b (TMA.K0 w.k T b) ≤
      w.kap1*TMA.Dsc T*(∑ n ∈ S, shifted a d n^2) +
      2*T*(w.kap1/(2*π))*d*∑ n ∈ S, a n*TMA.lamCoeff n := by
  let U := T*(w.kap1/(2*π))
  have hT₀ : 0 < T := by linarith
  have hU : 0 ≤ U := mul_nonneg hT₀.le (div_nonneg (TMA.T12.kap1_nonneg w) (by positivity))
  have hlog : Real.log (T/(2*π)) ≤ Real.log T :=
    Real.log_le_log (by positivity) (div_le_self hT₀.le (by linarith [Real.pi_gt_three]))
  let q := shifted a d
  let f (n : ℕ) := d*a n*TMA.lamCoeff n
  have hpt (n : ℕ) (hn : n ∈ S) (m : ℕ) (hm : m ∈ S) :
      q n*q m*(TMA.K0 w.k T b (TMA.lamOf T b n-TMA.lamOf T b m)).re ≤
        (if m=n then w.kap1*TMA.Dsc T*(q n)^2 else 0) +
        U*((if n=1 then f m else 0)+(if m=1 then f n else 0)) := by
    rw [sampled_real w hT hb (hp n hn) (hp m hm) (hκ n hn) (hκ m hm),mul_sub]
    have hprime : -(q n*q m)*divisorMass (TMA.Nmax T b) n m ≤
        (if n=1 then f m else 0)+(if m=1 then f n else 0) := by
      rcases hsign with hd | hcut
      · exact shifted_point (hp n hn) (hp m hm) (ha n hn) (ha m hm) hd
      · by_cases h : n = 1 <;> by_cases h' : m = 1
        · subst n; subst m
          simp [q,f,shifted,divisorMass_one_exact (hp 1 hn) (hcut 1 hn),TMA.lamCoeff]
        · subst n
          rw [divisorMass_comm,divisorMass_one_exact (hp m hm) (hcut m hm)]
          simp [q,f,shifted,h']
        · subst m
          rw [divisorMass_one_exact (hp n hn) (hcut n hn)]
          simp [q,f,shifted,h,mul_comm (a n) d]
        · simp only [q,shifted,if_neg h,if_neg h',add_zero]
          exact mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr (mul_nonneg (ha n hn) (ha m hm)))
            (divisorMass_nonneg ..)
    have hr := mul_le_mul_of_nonneg_left hprime hU
    change U*(-(q n*q m)*_) ≤ U*((if n=1 then f m else 0)+(if m=1 then f n else 0)) at hr
    have hmain : q n*q m*(if n=m then U*Real.log (T/(2*π)) else 0) ≤
        (if m=n then w.kap1*TMA.Dsc T*(q n)^2 else 0) := by
      by_cases h : n=m
      · subst m
        simp only [if_true]
        have h := mul_le_mul_of_nonneg_left hlog (mul_nonneg (sq_nonneg (q n)) hU)
        calc
          _ = (q n^2*U)*Real.log (T/(2*π)) := by ring
          _ ≤ (q n^2*U)*Real.log T := h
          _ = _ := by unfold U TMA.Dsc; ring
      · simp [h,Ne.symm h]
    change q n*q m*(if n=m then U*Real.log (T/(2*π)) else 0) - q n*q m*(U*_) ≤ _
    linarith only [hr,hmain]
  have hf := Finset.sum_le_sum (s := S) fun n hn => Finset.sum_le_sum (s := S) fun m hm => hpt n hn m hm
  refine hf.trans_eq ?_
  simp only [Finset.sum_add_distrib,← Finset.mul_sum]
  have hmain : ∑ n ∈ S, ∑ m ∈ S, (if m=n then w.kap1*TMA.Dsc T*q n^2 else 0) =
      w.kap1*TMA.Dsc T*∑ n ∈ S, q n^2 := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro n hn
    simp [hn]
  rw [hmain]
  have hrow : ∑ n ∈ S, ∑ m ∈ S, (if n=1 then f m else 0) = ∑ m ∈ S, f m := by
    rw [Finset.sum_comm]
    simp [h1]
  rw [hrow]
  simp only [Finset.sum_ite_eq',if_pos h1]
  simp only [f,mul_assoc d,← Finset.mul_sum]
  dsimp [U,q]
  ring

theorem prime_gram (w : TMA.HeightWeight) {T b d : ℝ} (hT : 1 < T) (hb : 0 < b) (hd : 0 ≤ d)
    (S : Finset ℕ) (h1 : 1 ∈ S) (hp : ∀ n ∈ S, 0 < n)
    (hκ : ∀ n ∈ S, w.kappa*((n:ℝ)+1) < T) (a : ℕ → ℝ) (ha : ∀ n ∈ S, 0 ≤ a n) :
    gram S (shifted a d) T b (TMA.K0 w.k T b) ≤
      w.kap1*TMA.Dsc T*(∑ n ∈ S, shifted a d n^2) +
      2*T*(w.kap1/(2*π))*d*∑ n ∈ S, a n*TMA.lamCoeff n :=
  prime_gram_signed w hT hb S (Or.inl hd) h1 hp hκ a ha

private theorem split_range {b T : ℝ} (hT : 1 ≤ T) (hb : 0 ≤ b) :
    BHB.Krange b T = insert 1 (indices (T^b)) := by
  have hfloor : 1 ≤ ⌊T^b⌋₊ := (Nat.le_floor_iff (Real.rpow_nonneg (by linarith) b)).mpr (by simpa using Real.one_le_rpow hT hb)
  ext n
  simp only [BHB.Krange,BHB.ymol,indices,Finset.mem_Icc,Finset.mem_insert]
  omega

private theorem one_out (X : ℝ) : 1 ∉ indices X := by simp [indices]

private theorem shift_energy {b T : ℝ} (hT : 1 ≤ T) (hb : 0 ≤ b) (d : ℝ) :
    (∑ n ∈ BHB.Krange b T, shifted (coeff (T^b)) d n^2) =
      d^2 + ∑ n ∈ indices (T^b), coeff (T^b) n^2 := by
  rw [split_range hT hb,Finset.sum_insert (one_out _)]
  simp only [shifted,if_true,neg_sq]
  congr 1
  exact Finset.sum_congr rfl fun n hn => by
    rw [if_neg (fun h => one_out _ (h ▸ hn))]

private theorem shift_phase {b T : ℝ} (hT : 1 < T) (hb : 0 < b) (d : ℝ)
    {z : ℂ} (hz : z.re=1/2) :
    polynomial (BHB.Krange b T) (shifted (coeff (T^b)) d) T b z =
      (starRingEnd ℂ) (FejerMultiplicity.probe b T z - d) := by
  rw [polynomial,split_range hT.le hb.le,Finset.sum_insert (one_out _),probe_on_line hT hz]
  simp only [shifted,if_true,TMA.lamOf,Nat.cast_one,Real.log_one,zero_div,TMA.Kernel.phase_zero,
    mul_one,Complex.ofReal_neg,map_sub,map_sum,map_mul,Complex.conj_ofReal]
  rw [sub_eq_neg_add]
  congr 1
  apply Finset.sum_congr rfl
  intro n hn
  rw [if_neg (fun he => one_out _ (he ▸ hn)),← Complex.exp_conj]
  congr 1
  unfold TMA.phase
  congr 1
  simp only [map_mul,map_neg,Complex.conj_I,neg_neg,Complex.conj_ofReal]
  push_cast
  field_simp [hb.ne',(Real.log_pos hT).ne']

/-- The sharp shifted square is bounded by the smoothed Gram matrix. -/
theorem sharp_shift_le (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {T b : ℝ}
    (hT : 1 < T) (hb : 0 < b) (d : ℝ) :
    (∑ z ∈ ThirdMoment.zerosFinset T (2*T), (Zeta23.zeroMult z:ℝ)*
      ‖FejerMultiplicity.probe b T z-d‖^2) ≤
    gram (BHB.Krange b T) (shifted (coeff (T^b)) d) T b (TMA.Kfull w.h T b) := by
  have hs := gram_at_zeros hRH w (by linarith : 0 < T) b (BHB.Krange b T) (shifted (coeff (T^b)) d)
  have hwin := BHB.Final.hasSum_window
    (fun z => (Zeta23.zeroMult z:ℝ)*‖FejerMultiplicity.probe b T z-d‖^2) T (2*T)
  apply hasSum_le _ hwin hs
  intro z
  have hzr : (z:ℂ).re = 1/2 := Zeta23.RH_implies_on_line hRH z.2
  rw [shift_phase hT hb d hzr,Complex.norm_conj]
  unfold TMA.cw
  split_ifs with h
  · have hp : 0 < T := by linarith
    exact mul_le_mul_of_nonneg_right (le_mul_of_one_le_right (Nat.cast_nonneg _)
      (w.h_ge_one _ ((one_le_div hp).mpr h.1.le) ((div_le_iff₀ hp).mpr h.2))) (sq_nonneg _)
  · exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (w.h_nonneg _)) (sq_nonneg _)

/-- Smoothed upper estimate for the shifted square on the sharp dyadic interval.
    The bandwidth can approach one from below while remaining fixed as T grows. -/
theorem shifted_moment (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {b d η : ℝ}
    (hb : 0 < b) (hb' : b < 1) (hd : 0 ≤ d) (hη : 0 < η) :
    ∀ᶠ T : ℝ in atTop,
      (∑ z ∈ ThirdMoment.zerosFinset T (2*T), (Zeta23.zeroMult z:ℝ)*
        ‖FejerMultiplicity.probe b T z-d‖^2) ≤
      (w.kap1*(d^2+1/12+η+2*d*b*(1/6+η))+η)*TMA.Dsc T := by
  obtain ⟨D,hD,hgram⟩ := gram_error hRH w hb hb'.le
  let H := d^2+1/12+η
  have hH : 0 ≤ H := by dsimp [H]; positivity
  filter_upwards [hgram,eventual_sample w hb hb',
    (tendsto_rpow_atTop hb).eventually (coefficient_moments hη),
    Real.tendsto_log_atTop.eventually_ge_atTop ((2*π)*D*H/η),
    eventually_ge_atTop (2:ℝ)] with T hG hκ ⟨hP,hE⟩ hL hT
  have hp : 1 < T := by linarith
  have hT₀ : 0 < T := by linarith
  have hX : 1 < T^b := Real.one_lt_rpow hp hb
  let S := BHB.Krange b T
  let a := coeff (T^b)
  let q := shifted a d
  let U := T*(w.kap1/(2*π))
  have hU : 0 ≤ U := mul_nonneg hT₀.le (div_nonneg (TMA.T12.kap1_nonneg w) (by positivity))
  have hA : ∀ n ∈ S, 0 ≤ a n := fun n hn => coeff_nonneg hX (Finset.mem_Icc.mp hn).1
    ((Nat.le_floor_iff (Real.rpow_nonneg hT₀.le b)).mp (Finset.mem_Icc.mp hn).2)
  have h1 : 1 ∈ S := by simp [S,split_range hp.le hb.le]
  have hpr := prime_gram w hp hb hd S h1 (fun n hn => (Finset.mem_Icc.mp hn).1) hκ a hA
  have he := hG S (fun _ h => h) q
  have hsharp := sharp_shift_le hRH w hp hb d
  have henergy : ∑ n ∈ S, q n^2 ≤ H := by
    change ∑ n ∈ BHB.Krange b T, shifted (coeff _) d n ^ 2 ≤ _
    rw [shift_energy hp.le hb.le d]
    dsimp [H]
    linarith [(abs_le.mp hE).2]
  have hpSum : (∑ n ∈ S, a n*TMA.lamCoeff n) ≤ (1/6+η)*(b*Real.log T) := by
    have hp' := (abs_le.mp hP).2
    have hlog := Real.log_pos hX
    have h' : (∑ n ∈ indices (T^b), a n*TMA.lamCoeff n)/Real.log (T^b) ≤ 1/6+η := by
      change (∑ n ∈ indices (T^b), a n*TMA.lamCoeff n)/Real.log (T^b)-1/6 ≤ η at hp'
      linarith only [hp']
    rw [div_le_iff₀ hlog,Real.log_rpow hT₀] at h'
    simpa [S,split_range hp.le hb.le,Finset.sum_insert (one_out _),a,coeff,TMA.lamCoeff] using h'
  rw [div_le_iff₀ hη] at hL
  have hErr : D*T*H ≤ η*TMA.Dsc T := by
    unfold TMA.Dsc
    field_simp [Real.pi_ne_zero]
    linarith only [hL]
  have hDsc : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg hT₀.le (Real.log_pos hp).le) (by positivity)
  have hdiag := mul_le_mul_of_nonneg_left henergy (mul_nonneg (TMA.T12.kap1_nonneg w) hDsc)
  have herr := (mul_le_mul_of_nonneg_left henergy (mul_nonneg hD hT₀.le)).trans hErr
  have hcross := mul_le_mul_of_nonneg_left hpSum (by positivity : 0 ≤ 2*(T*(w.kap1/(2*π)))*d)
  change gram S q T b _ ≤ w.kap1*TMA.Dsc T*(∑ n ∈ S, q n^2) +
    2*T*(w.kap1/(2*π))*d*(∑ n ∈ S, a n*TMA.lamCoeff n) at hpr
  change _ ≤ gram S q T b _ at hsharp
  calc
    _ ≤ w.kap1*TMA.Dsc T*H + (2*(T*(w.kap1/(2*π)))*d)*((1/6+η)*(b*Real.log T)) +
        η*TMA.Dsc T := by linarith only [hsharp,hpr,he,hdiag,herr,hcross]
    _ = _ := by dsimp [H,TMA.Dsc]; ring

end FejerPrimeMoments
end
end Src_FejerPrimeMoments

