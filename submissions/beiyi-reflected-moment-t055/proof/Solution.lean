section Src_ReflectedPrincipal

noncomputable section
open Real MeasureTheory
open scoped BigOperators ArithmeticFunction ArithmeticFunction.Moebius

namespace ReflectedPrincipal

def below (x : ℝ) := Finset.Ioc 0 ⌊x⌋₊

def partialSum (f : ℕ → ℝ) (x : ℝ) := ∑ n ∈ below x, f n

private theorem mem_below {x : ℝ} (hx : 0 ≤ x) {n : ℕ} :
    n ∈ below x ↔ 0 < n ∧ (n:ℝ) ≤ x := by
  simp only [below,Finset.mem_Ioc,Nat.le_floor_iff hx]

private theorem extend {x z : ℝ} (hx : 0 ≤ x) (hz : 0 ≤ z) (hzx : z ≤ x) (u : ℕ → ℝ) :
    (∑ n ∈ below z, u n) = ∑ n ∈ below x, if (n:ℝ) ≤ z then u n else 0 := by
  rw [← Finset.sum_filter]
  congr 1
  ext n
  simp only [Finset.mem_filter,mem_below hx,mem_below hz]
  exact ⟨fun h => ⟨⟨h.1,h.2.trans hzx⟩,h.2⟩,fun h => ⟨h.1.1,h.2⟩⟩

private theorem row (f g : ℕ → ℝ) {x z : ℝ} (hx : 0 < x) (hz : 0 ≤ z) (hzx : z ≤ x) :
    (∑ d ∈ below z, f d*partialSum g (x/d)) =
      ∑ d ∈ below x, ∑ m ∈ below x,
        if (d:ℝ) ≤ z ∧ (d:ℝ)*m ≤ x then f d*g m else 0 := by
  rw [extend hx.le hz hzx]
  apply Finset.sum_congr rfl
  intro d hd
  have hn := ((mem_below hx.le).mp hd).1
  have hdpos : 0 < (d:ℝ) := by exact_mod_cast hn
  have hd1 : 1 ≤ (d:ℝ) := by exact_mod_cast hn
  by_cases hdz : (d:ℝ) ≤ z
  · simp only [hdz,true_and,partialSum,if_true]
    rw [extend hx.le (div_nonneg hx.le hdpos.le) (div_le_self hx.le hd1),Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro m _
    by_cases h : (m:ℝ) ≤ x/d
    · have ht : (d:ℝ)*m ≤ x := by simpa only [mul_comm] using (le_div_iff₀ hdpos).mp h
      simp [h,ht]
    · have ht : ¬(d:ℝ)*m ≤ x := by simpa only [le_div_iff₀ hdpos,mul_comm (m:ℝ) d] using h
      simp [h,ht]
  · simp [hdz]

/-- Exact hyperbola splitting at an arbitrary real cutoff. Endpoints are
included on the first side and excluded from the complementary tail. -/
theorem hyperbola (f g : ArithmeticFunction ℝ) {x z : ℝ} (hz : 1 ≤ z) (hzx : z ≤ x) :
    partialSum (fun n => (f*g : ArithmeticFunction ℝ) n) x = (∑ d ∈ below z, f d*partialSum g (x/d)) +
      ∑ m ∈ below (x/z), g m*(partialSum f (x/m)-partialSum f z) := by
  have hx : 0 < x := by linarith
  have hzpos : 0 < z := by linarith
  have hY := div_nonneg hx.le hzpos.le
  have hYx := div_le_self hx.le hz
  have hall : partialSum (fun n => (f*g : ArithmeticFunction ℝ) n) x = ∑ d ∈ below x, ∑ m ∈ below x,
      if (d:ℝ)*m ≤ x then f d*g m else 0 := by
    unfold partialSum below
    rw [ArithmeticFunction.sum_Ioc_mul_eq_sum_prod_filter,Finset.sum_filter,Finset.sum_product]
    apply Finset.sum_congr rfl
    intro d _
    apply Finset.sum_congr rfl
    intro m _
    simp only [Nat.le_floor_iff hx.le,Nat.cast_mul]
  rw [hall,row f g hx hzpos.le hzx]
  simp_rw [mul_sub,Finset.sum_sub_distrib]
  rw [row g f hx hY hYx]
  have hrect (m : ℕ) : g m*partialSum f z =
      ∑ d ∈ below x, if (d:ℝ) ≤ z then g m*f d else 0 := by
    rw [partialSum,extend hx.le hzpos.le hzx,Finset.mul_sum]
    simp_rw [mul_ite,mul_zero]
  have hrectangle : (∑ m ∈ below (x/z), g m*partialSum f z) =
      ∑ m ∈ below x, ∑ d ∈ below x, if (m:ℝ) ≤ x/z ∧ (d:ℝ) ≤ z then g m*f d else 0 := by
    rw [extend hx.le hY hYx]
    apply Finset.sum_congr rfl
    intro m _
    by_cases hm : (m:ℝ) ≤ x/z <;> simp [hm,hrect]
  rw [hrectangle]
  rw [Finset.sum_comm (s:=below x) (t:=below x) (f:=fun m d =>
    if (m:ℝ) ≤ x/z ∧ (m:ℝ)*d ≤ x then g m*f d else 0)]
  rw [Finset.sum_comm (s:=below x) (t:=below x) (f:=fun m d =>
    if (m:ℝ) ≤ x/z ∧ (d:ℝ) ≤ z then g m*f d else 0)]
  rw [← Finset.sum_sub_distrib,← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro d hd
  rw [← Finset.sum_sub_distrib,← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro m hm
  have hdpos : 0 < (d:ℝ) := by exact_mod_cast ((mem_below hx.le).mp hd).1
  have hmpos : 0 < (m:ℝ) := by exact_mod_cast ((mem_below hx.le).mp hm).1
  simp only [mul_comm (g m) (f d),mul_comm (m:ℝ) d,le_div_iff₀ hzpos]
  by_cases hd' : (d:ℝ) ≤ z <;> by_cases hm' : (m:ℝ)*z ≤ x
  · have hdm : (d:ℝ)*m ≤ x := (mul_comm (d:ℝ) m) ▸ (mul_le_mul_of_nonneg_left hd' hmpos.le).trans hm'
    simp [hd',hm',hdm]
  · simp [hd',hm']
  · simp [hd',hm']
  · have hdm : ¬(d:ℝ)*m ≤ x := by nlinarith [mul_pos (sub_pos.mpr (lt_of_not_ge hd')) hmpos]
    simp [hd',hm',hdm]

private def logPrim (x : ℝ) := x*Real.log x-x

private theorem logPrim_increment {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    (b-a)*Real.log a ≤ logPrim b-logPrim a ∧ logPrim b-logPrim a ≤ (b-a)*Real.log b := by
  have hu := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos (div_pos ha hb)) hb.le
  have hl := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos (div_pos hb ha)) ha.le
  rw [Real.log_div ha.ne' hb.ne',mul_sub,mul_sub,mul_div_cancel₀ _ hb.ne',mul_one] at hu
  rw [Real.log_div hb.ne' ha.ne',mul_sub,mul_sub,mul_div_cancel₀ _ ha.ne',mul_one] at hl
  unfold logPrim
  constructor <;> linarith only [hl,hu]

private theorem log_nat_sum (n : ℕ) (hn : 1 ≤ n) :
    0 ≤ (∑ i ∈ Finset.Ioc 0 n, Real.log i)-logPrim n-1 ∧
    (∑ i ∈ Finset.Ioc 0 n, Real.log i)-logPrim n-1 ≤ Real.log n := by
  induction n, hn using Nat.le_induction with
  | base => norm_num [logPrim]
  | succ n hn ih =>
    have hn' : 0 < (n:ℝ) := by exact_mod_cast hn
    have h := logPrim_increment hn' (show 0 < (n:ℝ)+1 by positivity)
    rw [Finset.sum_Ioc_succ_top (by omega : 0≤n),Nat.cast_succ]
    constructor <;> linarith only [h.1,h.2,ih.1,ih.2]

/-- The first input to the hyperbola sum, uniform between integers. -/
theorem log_sum {x : ℝ} (hx : 1 ≤ x) :
    |partialSum (fun n => Real.log n) x-(x*Real.log x-x)| ≤ 1+Real.log x := by
  let n := ⌊x⌋₊
  have hn : 1 ≤ n := Nat.le_floor (by simpa using hx)
  have hn₀ : 0 < (n:ℝ) := by exact_mod_cast hn
  have hnx : (n:ℝ) ≤ x := Nat.floor_le (by linarith)
  have hxn : x < (n:ℝ)+1 := Nat.lt_floor_add_one x
  have h := log_nat_sum n hn
  have hd := logPrim_increment hn₀ (show 0 < x by linarith)
  have hlx := Real.log_nonneg hx
  have hln := Real.log_nonneg (show (1:ℝ) ≤ n by exact_mod_cast hn)
  change |(∑ i ∈ Finset.Ioc 0 n, Real.log i)-logPrim x| ≤ _
  rw [abs_le]
  constructor <;> nlinarith only [h.1,h.2,hd.1,hd.2,Real.log_le_log hn₀ hnx,
    mul_nonneg (sub_nonneg.mpr hnx) hln,mul_nonneg (sub_nonneg.mpr hxn.le) hlx]

private theorem count_below {x : ℝ} (hx : 0 ≤ x) : ((below x).card:ℝ) ≤ x := by
  simpa [below] using Nat.floor_le hx

private def mob (n : ℕ) : ℝ := μ n

private theorem mob_moment {C : ℝ} (hC : BHB.MT.MobiusHyp C) {x z : ℝ}
    (hz : 1 ≤ z) (hzx : z ≤ x) :
    |(∑ d ∈ below z, mob d/d*(Real.log x-1-Real.log d))-1| ≤
       C*z^(-(1/32):ℝ)*(1025+Real.log x) := by
  have hi : Finset.Icc 1 ⌊z⌋₊ = below z := Finset.Icc_succ_left_eq_Ioc ..
  have hc := hC.2 1 le_rfl z hz
  have he := BHB.MT.MO.mobius_moment_explicit hC (d:=1) le_rfl hz
    (G:=id) contDiff_id (B:=0) (by simp)
  simp only [BHB.mobiusF_one,mul_one,Nat.totient_one,Nat.cast_one,div_one,
    add_zero,id_eq,Nat.coprime_one_right_eq_true,
    Finset.filter_true,hi] at he
  simp only [BHB.mobiusF_one,mul_one] at hc
  have hM : BHB.MT.Mcop 1 z = ∑ d ∈ below z, mob d/d := by simp [BHB.MT.Mcop,mob,hi]
  let E := (∑ d ∈ below z, mob d/d*Real.log d)-(-1+Real.log z*BHB.MT.Mcop 1 z)
  have hE : |E| ≤ 1024*C*z^(-(1/32):ℝ) := by simpa [E,mob] using he
  have hmain : (∑ d ∈ below z, mob d/d*(Real.log x-1-Real.log d))-1 =
      (Real.log x-1-Real.log z)*BHB.MT.Mcop 1 z-E := by
    dsimp [E]; rw [hM]
    simp_rw [mul_sub,Finset.sum_sub_distrib,← Finset.sum_mul]
    ring
  have hlog := Real.log_nonneg hz
  have hlogx := Real.log_le_log (by linarith : 0 < z) hzx
  have ha : |Real.log x-1-Real.log z| ≤ 1+Real.log x := by rw [abs_le]; constructor <;> linarith
  rw [hmain]
  apply (abs_sub ..).trans
  rw [abs_mul]
  calc
    _ ≤ (1+Real.log x)*(C*z^(-(1/32):ℝ))+1024*C*z^(-(1/32):ℝ) :=
      add_le_add (mul_le_mul ha hc (abs_nonneg _) (by linarith)) hE
    _ = _ := by ring

private theorem mob_head {x z : ℝ} (hz : 1 ≤ z) (hzx : z ≤ x) :
    |(∑ d ∈ below z, mob d*partialSum (fun i => Real.log i) (x/d)) -
      x*(∑ d ∈ below z, mob d/d*(Real.log x-1-Real.log d))| ≤ z*(1+Real.log x) := by
  have hx := hz.trans hzx
  have hxpos : 0 < x := by linarith
  rw [Finset.mul_sum,← Finset.sum_sub_distrib]
  apply (Finset.abs_sum_le_sum_abs ..).trans
  calc
    _ ≤ ∑ _d ∈ below z, (1+Real.log x) := by
      apply Finset.sum_le_sum
      intro d hd
      obtain ⟨hd₀,hdz⟩ := (mem_below (by linarith : 0 ≤ z)).mp hd
      have hdpos : 0 < (d:ℝ) := by exact_mod_cast hd₀
      have hd1 : (1:ℝ) ≤ d := by exact_mod_cast hd₀
      have he := log_sum ((one_le_div hdpos).mpr (hdz.trans hzx))
      have hm : |mob d| ≤ 1 := by unfold mob; exact_mod_cast (ArithmeticFunction.abs_moebius_le_one (n:=d))
      have hlog := Real.log_le_log (div_pos hxpos hdpos) (div_le_self hxpos.le hd1)
      have hid : mob d*partialSum (fun i => Real.log i) (x/d)-
          x*(mob d/d*(Real.log x-1-Real.log d)) =
          mob d*(partialSum (fun i => Real.log i) (x/d)-(x/d*Real.log (x/d)-x/d)) := by
        rw [Real.log_div hxpos.ne' hdpos.ne']; ring
      rw [hid,abs_mul]
      simpa only [one_mul] using mul_le_mul hm (he.trans (by linarith : 1+Real.log (x/d) ≤ 1+Real.log x))
        (abs_nonneg _) zero_le_one
    _ = ((below z).card:ℝ)*(1+Real.log x) := by simp; ring
    _ ≤ _ := mul_le_mul_of_nonneg_right (count_below (by linarith)) (by linarith [Real.log_nonneg hx])

private theorem mob_tail {C x z : ℝ} (hC : 0 < C)
    (hM : ∀ u : ℝ, 1 ≤ u → |partialSum mob u| ≤ C*u^(1-1/32:ℝ))
    (hz : 1 ≤ z) (hzx : z ≤ x) :
    |∑ m ∈ below (x/z), Real.log m*(partialSum mob (x/m)-partialSum mob z)| ≤
      (x/z)*(Real.log x*(2*C*x^(1-1/32:ℝ))) := by
  have hx := hz.trans hzx
  have hxpos : 0 < x := by linarith
  have hzpos : 0 < z := by linarith
  have hpow {u : ℝ} (hu : 1 ≤ u) (hux : u ≤ x) :
      |partialSum mob u| ≤ C*x^(1-1/32:ℝ) := (hM u hu).trans
    (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (by linarith) hux (by norm_num)) hC.le)
  apply (Finset.abs_sum_le_sum_abs ..).trans
  calc
    _ ≤ ∑ _m ∈ below (x/z), Real.log x*(2*C*x^(1-1/32:ℝ)) := by
      apply Finset.sum_le_sum
      intro m hm
      obtain ⟨hm₀,hmx⟩ := (mem_below (div_nonneg hxpos.le hzpos.le)).mp hm
      have hmpos : 0 < (m:ℝ) := by exact_mod_cast hm₀
      have hm1 : (1:ℝ) ≤ m := by exact_mod_cast hm₀
      have hmle := hmx.trans (div_le_self hxpos.le hz)
      have ht := hpow ((one_le_div hmpos).mpr hmle) (div_le_self hxpos.le hm1)
      have hs := hpow hz hzx
      rw [abs_mul,abs_of_nonneg (Real.log_nonneg hm1)]
      exact mul_le_mul (Real.log_le_log hmpos hmle)
        ((abs_sub ..).trans (by linarith only [ht,hs])) (abs_nonneg _) (Real.log_nonneg hx)
    _ = ((below (x/z)).card:ℝ)*(Real.log x*(2*C*x^(1-1/32:ℝ))) := by simp
    _ ≤ _ := mul_le_mul_of_nonneg_right (count_below (div_nonneg hxpos.le hzpos.le))
      (by positivity [Real.log_nonneg hx])

/-- A power-saving prime-number estimate under the board's RH premise.
It follows from the board's cancellation bound for the Möbius function. -/
theorem psi_of_RH (hRH : RiemannHypothesis) :
    ∃ K : ℝ, 0 < K ∧ ∀ x : ℝ, 1 ≤ x →
      |partialSum ArithmeticFunction.vonMangoldt x-x| ≤ K*x^(63/64:ℝ)*(1+Real.log x) := by
  obtain ⟨C,hC,hM,_,hM₁⟩ := BHB.mobius_bounds_of_RH hRH
  have hyp : BHB.MT.MobiusHyp C := ⟨hC,hM₁⟩
  have hs (u : ℝ) (hu : 1 ≤ u) : |partialSum mob u| ≤ C*u^(1-1/32:ℝ) := by
    simpa only [partialSum,mob,below,← show Finset.Icc 1 ⌊u⌋₊=Finset.Ioc 0 ⌊u⌋₊ from
      Finset.Icc_succ_left_eq_Ioc ..] using hM u hu
  refine ⟨1+1027*C,by positivity,?_⟩
  intro x hx
  let z := x^(63/64:ℝ)
  have hxpos : 0 < x := by linarith
  have hz : 1 ≤ z := Real.one_le_rpow hx (by norm_num)
  have hzx : z ≤ x := by
    simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hx (show (63/64:ℝ) ≤ 1 by norm_num)
  let V := ∑ d ∈ below z, mob d/d*(Real.log x-1-Real.log d)
  let H := ∑ d ∈ below z, mob d*partialSum (fun n => Real.log n) (x/d)
  let R := ∑ m ∈ below (x/z), Real.log m*(partialSum mob (x/m)-partialSum mob z)
  have he : partialSum ArithmeticFunction.vonMangoldt x = H+R := by
    have h := hyperbola (μ : ArithmeticFunction ℝ) ArithmeticFunction.log hz hzx
    simpa only [ArithmeticFunction.moebius_mul_log_eq_vonMangoldt,H,R,partialSum,mob,
      ArithmeticFunction.log_apply,ArithmeticFunction.intCoe_apply] using h
  have ht := mob_tail hC hs hz hzx
  change |R| ≤ _ at ht
  have hh := mob_head hz hzx
  change |H-x*V| ≤ _ at hh
  have hm := mob_moment hyp hz hzx
  change |V-1| ≤ _ at hm
  have he₁ : x*z^(-(1/32):ℝ) ≤ z := by
    dsimp [z]; rw [← Real.rpow_mul hxpos.le]
    calc
      x*x^((63/64:ℝ)*(-(1/32))) = x^(1+(63/64:ℝ)*(-(1/32))) := by
        rw [Real.rpow_add hxpos,Real.rpow_one]
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hx (by norm_num)
  have he₂ : x/z*x^(1-1/32:ℝ)=z := by
    dsimp [z]
    rw [div_mul_eq_mul_div,div_eq_iff (Real.rpow_pos_of_pos hxpos _).ne',← Real.rpow_add hxpos]
    calc
      x*x^(1-1/32:ℝ) = x^(1+(1-1/32):ℝ) := by rw [Real.rpow_add hxpos,Real.rpow_one]
      _ = _ := by norm_num
  have hlog := Real.log_nonneg hx
  rw [he,show H+R-x=(H-x*V)+x*(V-1)+R by ring]
  have hxm : |x*(V-1)| ≤ x*(C*z^(-(1/32):ℝ)*(1025+Real.log x)) := by
    rw [abs_mul,abs_of_pos hxpos]
    exact mul_le_mul_of_nonneg_left hm hxpos.le
  apply ((abs_add_le ..).trans (add_le_add ((abs_add_le ..).trans (add_le_add hh hxm)) ht)).trans
  change _ ≤ (1+1027*C)*z*(1+Real.log x)
  have hb := mul_le_mul_of_nonneg_right he₁ (show 0 ≤ C*(1025+Real.log x) by positivity)
  have hc := congrArg (fun t => t*(2*C*Real.log x)) he₂
  nlinarith only [hb,hc,mul_nonneg (mul_nonneg hC.le (by linarith : 0 ≤ z)) hlog,
    mul_nonneg hC.le (by linarith : 0 ≤ z)]

private theorem prefix_Icc (f : ℕ → ℝ) (h₀ : f 0 = 0) (x : ℝ) :
    ∑ i ∈ Finset.Icc 0 ⌊x⌋₊, f i = partialSum f x := by
  rw [Finset.Icc_eq_cons_Ioc (Nat.zero_le _),Finset.sum_cons,h₀,zero_add]
  rfl

theorem partial_summation (f : ℕ → ℝ) (hf : f 0 = 0) {w w' : ℝ → ℝ} {x : ℝ}
    (hx : 1 ≤ x) (hd : ∀ u ∈ Set.Icc 1 x, HasDerivAt w (w' u) u)
    (hw : ContinuousOn w' (Set.Icc 1 x)) :
    partialSum (fun n => w n*f n) x = w x*partialSum f x -
      ∫ u in (1:ℝ)..x, w' u*partialSum f u := by
  have hi : IntegrableOn (deriv w) (Set.Icc 1 x) := hw.integrableOn_Icc.congr_fun
    (fun u hu => (hd u hu).deriv.symm) measurableSet_Icc
  have he := sum_mul_eq_sub_integral_mul₀ f hf x (fun u hu => (hd u hu).differentiableAt) hi
  rw [← prefix_Icc (fun n => w n*f n) (by simp [hf]),he,prefix_Icc f hf,
    intervalIntegral.integral_of_le hx]
  congr 1
  exact setIntegral_congr_fun measurableSet_Ioc fun u hu => by
    rw [(hd u ⟨hu.1.le,hu.2⟩).deriv,prefix_Icc f hf]

def weightedMangoldt (n : ℕ) : ℝ := Real.log n * ArithmeticFunction.vonMangoldt n

/-- The summatory function of the coefficient in the principal convolution has a power saving. -/
theorem weighted_mangoldt_of_RH (hRH : RiemannHypothesis) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 1 ≤ x →
      |partialSum weightedMangoldt x - (x*Real.log x-x)| ≤ C*x^(127/128:ℝ) := by
  obtain ⟨K,hK,hψ⟩ := psi_of_RH hRH
  refine ⟨1+2*K*257^2,by positivity,?_⟩
  intro x hx
  let S := partialSum ArithmeticFunction.vonMangoldt
  let D := K*x^(63/64:ℝ)*(1+Real.log x)
  have hxpos : 0 < x := by linarith
  have hlog := Real.log_nonneg hx
  have hD : ∀ u ∈ Set.Icc 1 x, |S u-u| ≤ D := by
    intro u hu
    apply (hψ u hu.1).trans
    apply mul_le_mul
    · exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (by linarith [hu.1]) hu.2 (by norm_num)) hK.le
    · linarith [Real.log_le_log (by linarith [hu.1]) hu.2]
    · linarith [Real.log_nonneg hu.1]
    · positivity
  have hi : ContinuousOn (fun u : ℝ => u⁻¹) (Set.Icc 1 x) :=
    continuousOn_inv₀.mono fun u hu => (lt_of_lt_of_le zero_lt_one hu.1).ne'
  have h0 : ArithmeticFunction.vonMangoldt 0 = 0 := by simp
  have hs := partial_summation _ h0 hx
    (fun u hu => Real.hasDerivAt_log (lt_of_lt_of_le zero_lt_one hu.1).ne') hi
  change partialSum weightedMangoldt x = Real.log x*S x - ∫ u in (1:ℝ)..x, u⁻¹*S u at hs
  have hsi : IntervalIntegrable (fun u : ℝ => u⁻¹*S u) volume 1 x := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le hx]
    have h := integrableOn_mul_sum_Icc ArithmeticFunction.vonMangoldt (m:=0) zero_le_one hi.integrableOn_Icc
    simpa only [prefix_Icc _ h0,S] using h
  have he : (∫ u in (1:ℝ)..x, u⁻¹*(S u-u)) = (∫ u in (1:ℝ)..x, u⁻¹*S u)-(x-1) := by
    rw [← show (∫ _u in (1:ℝ)..x, (1:ℝ))=x-1 by simp,
      ← intervalIntegral.integral_sub hsi intervalIntegrable_const]
    apply intervalIntegral.integral_congr
    intro u hu
    rw [Set.uIcc_of_le hx] at hu
    dsimp only
    rw [mul_sub,inv_mul_cancel₀ (lt_of_lt_of_le zero_lt_one hu.1).ne']
  have hI : |∫ u in (1:ℝ)..x, u⁻¹*(S u-u)| ≤ D*Real.log x := by
    have h := intervalIntegral.norm_integral_le_of_norm_le («μ»:=volume)
      (f:=fun u : ℝ => u⁻¹*(S u-u)) (g:=fun u : ℝ => D*u⁻¹) hx
      (Filter.Eventually.of_forall fun u hu => by
        rw [Real.norm_eq_abs,abs_mul,abs_of_pos (inv_pos.mpr (lt_trans zero_lt_one hu.1)),mul_comm D]
        exact mul_le_mul_of_nonneg_left (hD u ⟨hu.1.le,hu.2⟩) (by positivity [lt_trans zero_lt_one hu.1]))
      (intervalIntegrable_iff_integrableOn_Icc_of_le hx |>.mpr (continuousOn_const.mul hi).integrableOn_Icc)
    simpa only [Real.norm_eq_abs,intervalIntegral.integral_const_mul,integral_inv_of_pos zero_lt_one hxpos,
      div_one] using h
  have h₁ : |Real.log x*(S x-x)| ≤ Real.log x*D := by
    rw [abs_mul,abs_of_nonneg hlog]
    exact mul_le_mul_of_nonneg_left (hD x ⟨hx,le_rfl⟩) hlog
  let J := ∫ u in (1:ℝ)..x, u⁻¹*(S u-u)
  have hid : partialSum weightedMangoldt x - (x*Real.log x-x) = 1+Real.log x*(S x-x)-J := by
    dsimp [J]; rw [hs,he]; ring
  rw [hid]
  apply ((abs_sub ..).trans (add_le_add ((abs_add_le ..).trans (add_le_add (le_of_eq abs_one) h₁)) hI)).trans
  have hε := Real.log_le_rpow_div hxpos.le (show (0:ℝ)<1/256 by norm_num)
  let V := x^(1/256:ℝ)
  have hV : 1 ≤ V := Real.one_le_rpow hx (by norm_num)
  have hv : 1+Real.log x ≤ 257*V := by dsimp [V] at *; linarith
  have hv₂ := mul_self_le_mul_self (by linarith : 0 ≤ 1+Real.log x) hv
  have hp : x^(63/64:ℝ)*(V*V)=x^(127/128:ℝ) := by
    dsimp [V]; rw [← Real.rpow_add hxpos,← Real.rpow_add hxpos]; norm_num
  have hlarge : 1 ≤ x^(127/128:ℝ) := Real.one_le_rpow hx (by norm_num)
  have hb := mul_le_mul_of_nonneg_left hv₂ (show 0 ≤ K*x^(63/64:ℝ) by positivity)
  have ht := congrArg (fun y => K*y) hp
  dsimp [D]
  nlinarith only [hb,ht,hlarge,mul_nonneg (show 0 ≤ K*x^(63/64:ℝ) by positivity)
    (show 0 ≤ 1+Real.log x by linarith)]

private theorem measurable_partialSum (f : ℕ → ℝ) : Measurable (partialSum f) :=
  (measurable_of_countable (f:=fun N : ℕ => ∑ n ∈ Finset.Ioc 0 N, f n)).comp Nat.measurable_floor

/-- A summatory estimate with a power saving determines the harmonic sum up to a
constant, with a power-saving remainder uniform in its real endpoint. -/
theorem harmonic_transfer {f : ℕ → ℝ} (hf : f 0 = 0) {a b K δ : ℝ}
    (hδ : 0 < δ)
    (hS : ∀ u : ℝ, 1 ≤ u → |partialSum f u-u*(a*Real.log u+b)| ≤ K*u^(1-δ)) :
    ∃ c : ℝ, ∀ x : ℝ, 1 ≤ x →
      |partialSum (fun n => f n/n) x -
        (a/2*(Real.log x)^2+(a+b)*Real.log x+c)| ≤ (K+K/δ)*x^(-δ) := by
  let E := fun u : ℝ => partialSum f u-u*(a*Real.log u+b)
  let R := fun u : ℝ => E u/u^2
  have hR : Measurable R := by
    dsimp [R,E]
    exact ((measurable_partialSum f).sub (measurable_id.mul
      ((measurable_const.mul Real.measurable_log).add measurable_const))).div (measurable_id.pow_const 2)
  have hbound (u : ℝ) (hu : 1 ≤ u) : |R u| ≤ K*u^(-δ-1) := by
    have hu₀ : 0 < u := by linarith
    have he : u^(1-δ) / u^2 = u^(-δ-1) := by
      rw [← Real.rpow_natCast u 2,← Real.rpow_sub hu₀]; congr 1; push_cast; ring
    dsimp [R]
    rw [abs_div,abs_of_pos (pow_pos hu₀ _),← he,← mul_div_assoc]
    exact div_le_div_of_nonneg_right (hS u hu) (sq_nonneg u)
  have hneg : -δ-1 < -1 := by linarith
  have hi : IntegrableOn R (Set.Ioi 1) := by
    refine Integrable.mono' ((integrableOn_Ioi_rpow_of_lt hneg zero_lt_one).const_mul K)
      hR.aestronglyMeasurable ?_
    filter_upwards [ae_restrict_mem («μ»:=volume) (measurableSet_Ioi (a:=(1:ℝ)))] with u hu
    exact (Real.norm_eq_abs _).le.trans (hbound u hu.le)
  refine ⟨b+∫ u in Set.Ioi 1, R u,?_⟩
  intro x hx
  have hx₀ : 0 < x := by linarith
  have ht : |∫ u in Set.Ioi x, R u| ≤ K/δ*x^(-δ) := by
    have h := MeasureTheory.norm_integral_le_of_norm_le
      ((integrableOn_Ioi_rpow_of_lt hneg hx₀).const_mul K)
      (f:=R) (by
        filter_upwards [ae_restrict_mem («μ»:=volume) (measurableSet_Ioi (a:=x))] with u hu
        exact (Real.norm_eq_abs _).le.trans (hbound u (hx.trans hu.le)))
    rw [Real.norm_eq_abs,integral_const_mul,integral_Ioi_rpow_of_lt hneg hx₀,
      show -δ-1+1= -δ by ring] at h
    convert h using 1; ring
  have hE : |E x/x| ≤ K*x^(-δ) := by
    rw [abs_div,abs_of_pos hx₀]
    calc
      |E x|/x ≤ (K*x^(1-δ))/x := div_le_div_of_nonneg_right (hS x hx) hx₀.le
      _ = _ := by rw [mul_div_assoc,← Real.rpow_sub_one hx₀.ne']; congr 2; ring
  let P := fun u : ℝ => (a/2)*(Real.log u)^2+b*Real.log u
  let Q := fun u : ℝ => (a*Real.log u+b)/u
  have hcont : ContinuousOn Q (Set.Icc 1 x) := by
    have hn : ∀ u ∈ Set.Icc 1 x, u ≠ 0 := fun u hu => (lt_of_lt_of_le zero_lt_one hu.1).ne'
    exact ((continuousOn_const.mul (Real.continuousOn_log.mono hn)).add continuousOn_const).div continuousOn_id hn
  have hQint : IntervalIntegrable Q volume 1 x :=
    (intervalIntegrable_iff_integrableOn_Icc_of_le hx).mpr hcont.integrableOn_Icc
  have hQ : (∫ u in (1:ℝ)..x, Q u) = P x := by
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt (f:=P) (f':=Q) (a:=1) (b:=x)
      (fun u hu => by
        rw [Set.uIcc_of_le hx] at hu
        have hL := Real.hasDerivAt_log (lt_of_lt_of_le zero_lt_one hu.1).ne'
        exact (((hL.pow 2).const_mul (a/2)).add (hL.const_mul b)).congr_deriv (by dsimp [Q]; ring)) hQint
    simpa [P] using h
  have hRint : IntervalIntegrable R volume 1 x :=
    (intervalIntegrable_iff_integrableOn_Ioc_of_le hx).mpr (hi.mono_set Set.Ioc_subset_Ioi_self)
  have hparts := partial_summation f hf hx (w:=fun u => u⁻¹) (w':=fun u => -(u^2)⁻¹)
    (fun u hu => by
      have hn := (lt_of_lt_of_le zero_lt_one hu.1).ne'
      exact hasDerivAt_inv hn)
    ((continuousOn_inv₀.comp (continuousOn_id.pow 2) fun u hu =>
      pow_ne_zero 2 (lt_of_lt_of_le zero_lt_one hu.1).ne').neg)
  have hparts' : partialSum (fun n => f n/n) x = partialSum f x/x +
      (∫ u in (1:ℝ)..x, Q u)+(∫ u in (1:ℝ)..x, R u) := by
    simp_rw [div_eq_inv_mul] at ⊢
    rw [hparts]
    have he : (∫ u in (1:ℝ)..x, -(u^2)⁻¹*partialSum f u) =
        -(∫ u in (1:ℝ)..x, (Q u+R u)) := by
      rw [← intervalIntegral.integral_neg]
      apply intervalIntegral.integral_congr
      intro u hu
      rw [Set.uIcc_of_le hx] at hu
      dsimp [R,E,Q]
      field_simp [(lt_of_lt_of_le zero_lt_one hu.1).ne']; ring
    rw [he,intervalIntegral.integral_add hQint hRint]; ring
  have htail := intervalIntegral.integral_Ioi_sub_Ioi hi hx
  have hmain : partialSum f x/x = a*Real.log x+b+E x/x := by
    dsimp [E]; field_simp [hx₀.ne']; ring
  rw [hparts',hmain,hQ,← htail]
  dsimp only [P]
  convert (abs_sub (E x/x) (∫ u in Set.Ioi x, R u)).trans (add_le_add hE ht) using 1 <;>
    congr 1 <;> ring

private def ones : ArithmeticFunction ℝ := ArithmeticFunction.zeta

private theorem ones_pos {n : ℕ} (hn : 0 < n) : ones n = 1 := by
  simp [ones,ArithmeticFunction.natCoe_apply,ArithmeticFunction.zeta_apply_ne hn.ne']

private theorem ones_sum (x : ℝ) : partialSum ones x = ⌊x⌋₊ := by
  calc
    _ = ∑ _n ∈ below x, (1:ℝ) := Finset.sum_congr rfl fun n hn => ones_pos (Finset.mem_Ioc.mp hn).1
    _ = _ := by simp [below]

def harmonicSum (x : ℝ) := partialSum (fun n => (1:ℝ)/n) x
def harmonicLog (x : ℝ) := partialSum (fun n => Real.log n/n) x
def harmonicMangoldt (x : ℝ) := partialSum (fun n => weightedMangoldt n/n) x

private theorem floor_error {x : ℝ} (hx : 0 ≤ x) : |(⌊x⌋₊:ℝ)-x| ≤ 1 := by
  rw [abs_of_nonpos (sub_nonpos.mpr (Nat.floor_le hx))]
  linarith [Nat.lt_floor_add_one x]

theorem harmonic_estimates (hRH : RiemannHypothesis) :
    ∃ c₀ c₁ c₂ K : ℝ, 0 < K ∧ ∀ x : ℝ, 1 ≤ x →
      |harmonicSum x-(Real.log x+c₀)| ≤ K*x^(-(1/128):ℝ) ∧
      |harmonicLog x-((Real.log x)^2/2+c₁)| ≤ K*x^(-(1/128):ℝ) ∧
      |harmonicMangoldt x-((Real.log x)^2/2+c₂)| ≤ K*x^(-(1/128):ℝ) := by
  have h₀ := harmonic_transfer (f:=ones) ones.map_zero (a:=0) (b:=1) (K:=1) (δ:=1/128)
    (by norm_num) (fun x hx => by
      simp only [zero_mul,zero_add,mul_one,one_mul,ones_sum]
      exact (floor_error (by linarith)).trans (Real.one_le_rpow hx (by norm_num)))
  obtain ⟨c₀,h₀⟩ := h₀
  have h₁ := harmonic_transfer (f:=fun n => Real.log n) (by simp) (a:=1) (b:= -1)
    (K:=3) (δ:=1/128) (by norm_num) (fun x hx => by
      have he := log_sum hx
      have hx₀ : 0 ≤ x := by linarith
      have hL := Real.log_le_rpow_div hx₀ (show (0:ℝ)<1/2 by norm_num)
      have hp := Real.rpow_le_rpow_of_exponent_le hx (show (1/2:ℝ) ≤ 1-1/128 by norm_num)
      have hlarge := Real.one_le_rpow hx (show (0:ℝ) ≤ 1-1/128 by norm_num)
      rw [one_mul,mul_add,mul_neg_one]
      apply he.trans; linarith)
  obtain ⟨c₁,h₁⟩ := h₁
  obtain ⟨C,hC,hA⟩ := weighted_mangoldt_of_RH hRH
  have h₂ := harmonic_transfer (f:=weightedMangoldt) (by simp [weightedMangoldt])
    (a:=1) (b:= -1) (K:=C) (δ:=1/128) (by norm_num) (fun x hx => by
      simpa only [one_mul,mul_add,mul_neg_one,sub_eq_add_neg,show (1+ -(1/128):ℝ)=127/128 by norm_num]
        using hA x hx)
  obtain ⟨c₂,h₂⟩ := h₂
  refine ⟨c₀,c₁,c₂,387+129*C,by positivity,?_⟩
  intro x hx
  have hp := Real.rpow_nonneg (show 0 ≤ x by linarith) (-(1/128):ℝ)
  have he : partialSum (fun n => ones n/n) x = harmonicSum x := by
    apply Finset.sum_congr rfl
    intro n hn
    simp only [ones_pos (Finset.mem_Ioc.mp hn).1]
  specialize h₀ x hx
  specialize h₁ x hx
  specialize h₂ x hx
  rw [he] at h₀
  norm_num only [zero_div,zero_mul,zero_add,one_mul,add_neg_cancel,mul_zero,add_zero] at h₀ h₁ h₂
  dsimp only [harmonicLog,harmonicMangoldt]
  constructor
  · exact h₀.trans (mul_le_mul_of_nonneg_right (by linarith) hp)
  constructor
  · rw [show (Real.log x)^2/2=(1/2)*(Real.log x)^2 by ring]
    exact h₁.trans (mul_le_mul_of_nonneg_right (show 387 ≤ 387+129*C by linarith) hp)
  · rw [show (Real.log x)^2/2=(1/2)*(Real.log x)^2 by ring]
    exact h₂.trans (mul_le_mul_of_nonneg_right (show C+C/(1/128:ℝ) ≤ 387+129*C by linarith) hp)

private def mangoldtCoeff : ArithmeticFunction ℝ := ⟨weightedMangoldt,by simp [weightedMangoldt]⟩

private theorem mangoldt_nonneg (n : ℕ) : 0 ≤ weightedMangoldt n :=
  mul_nonneg (Real.log_natCast_nonneg _) (ArithmeticFunction.vonMangoldt_nonneg)

/-- Decomposition of the board's actual divisor coefficient at a variable cutoff. -/
theorem kap2_split {x s : ℝ} (hs : 1 ≤ s) (hsx : s ≤ x) :
    partialSum BHB.MT.kap2 x = (∑ j ∈ below s, partialSum weightedMangoldt (x/j)) +
      ∑ d ∈ below (x/s), weightedMangoldt d*((⌊x/d⌋₊:ℝ)-⌊s⌋₊) := by
  have h := hyperbola ones mangoldtCoeff hs hsx
  have hconv (n : ℕ) : (ones*mangoldtCoeff) n = BHB.MT.kap2 n := by
    rw [ones,ArithmeticFunction.coe_zeta_mul_apply]
    simp only [BHB.MT.kap2,mangoldtCoeff,ArithmeticFunction.coe_mk,weightedMangoldt,mul_comm]
  simp only [hconv,ones_sum] at h
  simp only [mangoldtCoeff,ArithmeticFunction.coe_mk] at h
  rw [h]
  congr 1
  apply Finset.sum_congr rfl
  intro j hj
  rw [ones_pos (Finset.mem_Ioc.mp hj).1,one_mul]

private theorem head_estimate {K : ℝ} (hK : 0 ≤ K)
    (hA : ∀ t : ℝ, 1 ≤ t → |partialSum weightedMangoldt t-(t*Real.log t-t)| ≤ K*t^(127/128:ℝ))
    {x s : ℝ} (hs : 1 ≤ s) (hsx : s ≤ x) :
    |(∑ j ∈ below s, partialSum weightedMangoldt (x/j)) -
      x*((Real.log x-1)*harmonicSum s-harmonicLog s)| ≤ s*(K*x^(127/128:ℝ)) := by
  have hx₀ : 0 < x := by linarith
  have he : x*((Real.log x-1)*harmonicSum s-harmonicLog s) =
      ∑ j ∈ below s, ((x/j)*Real.log (x/j)-x/j) := by
    unfold harmonicSum harmonicLog partialSum
    rw [Finset.mul_sum,← Finset.sum_sub_distrib,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j hj
    have hj₀ : 0 < (j:ℝ) := by exact_mod_cast (Finset.mem_Ioc.mp hj).1
    rw [Real.log_div hx₀.ne' hj₀.ne']; ring
  rw [he,← Finset.sum_sub_distrib]
  apply (Finset.abs_sum_le_sum_abs ..).trans
  calc
    _ ≤ ∑ _j ∈ below s, K*x^(127/128:ℝ) := by
      apply Finset.sum_le_sum
      intro j hj
      obtain ⟨hj₀,hjs⟩ := (mem_below (by linarith : 0 ≤ s)).mp hj
      have hjpos : 0 < (j:ℝ) := by exact_mod_cast hj₀
      apply (hA _ ((one_le_div hjpos).mpr (hjs.trans hsx))).trans
      exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (div_nonneg hx₀.le hjpos.le)
        (div_le_self hx₀.le (by exact_mod_cast hj₀)) (by norm_num)) hK
    _ = ((below s).card:ℝ)*(K*x^(127/128:ℝ)) := by simp
    _ ≤ _ := mul_le_mul_of_nonneg_right (count_below (by linarith)) (by positivity)

private theorem floor_estimate {s x : ℝ} (hs : 1 ≤ s) (hsx : s ≤ x) :
    |(∑ d ∈ below (x/s), weightedMangoldt d*((⌊x/d⌋₊:ℝ)-⌊s⌋₊)) -
      (x*harmonicMangoldt (x/s)-s*partialSum weightedMangoldt (x/s))| ≤
      2*partialSum weightedMangoldt (x/s) := by
  unfold harmonicMangoldt partialSum
  rw [Finset.mul_sum,Finset.mul_sum,← Finset.sum_sub_distrib,← Finset.sum_sub_distrib,Finset.mul_sum]
  apply (Finset.abs_sum_le_sum_abs ..).trans
  apply Finset.sum_le_sum
  intro d hd
  have hf := floor_error (x:=x/d) (div_nonneg (by linarith) (Nat.cast_nonneg _))
  have hs' := floor_error (x:=s) (by linarith)
  have he := (abs_sub ((⌊x/d⌋₊:ℝ)-x/d) ((⌊s⌋₊:ℝ)-s)).trans (add_le_add hf hs')
  have hi : weightedMangoldt d*((⌊x/d⌋₊:ℝ)-⌊s⌋₊) -
      (x*(weightedMangoldt d/d)-s*weightedMangoldt d) =
      weightedMangoldt d*(((⌊x/d⌋₊:ℝ)-x/d)-((⌊s⌋₊:ℝ)-s)) := by ring
  rw [hi,abs_mul,abs_of_nonneg (mangoldt_nonneg _),mul_comm (2:ℝ)]
  exact mul_le_mul_of_nonneg_left (by linarith only [he]) (mangoldt_nonneg _)

def hyperbolaMain (x s z : ℝ) := x*((Real.log x-1)*harmonicSum s-harmonicLog s+
  harmonicMangoldt z-Real.log z+1)

/-- Uniform error in the second hyperbola formula, including both floor endpoints. -/
theorem kap2_main_bound {K : ℝ} (hK : 0 ≤ K)
    (hA : ∀ t : ℝ, 1 ≤ t → |partialSum weightedMangoldt t-(t*Real.log t-t)| ≤ K*t^(127/128:ℝ))
    {x s z : ℝ} (hs : 1 ≤ s) (hz : 1 ≤ z) (hsz : s*z=x) :
    |partialSum BHB.MT.kap2 x - hyperbolaMain x s z| ≤
      s*(K*x^(127/128:ℝ))+2*partialSum weightedMangoldt z+s*(K*z^(127/128:ℝ)) := by
  have hs₀ : 0 < s := by linarith
  have hsx : s ≤ x := by nlinarith
  have hzs : x/s=z := (div_eq_iff hs₀.ne').mpr (by linarith only [hsz])
  have hH := head_estimate hK hA hs hsx
  have hF := floor_estimate hs hsx
  rw [hzs] at hF
  have hE : |s*(partialSum weightedMangoldt z-(z*Real.log z-z))| ≤ s*(K*z^(127/128:ℝ)) := by
    rw [abs_mul,abs_of_pos hs₀]; exact mul_le_mul_of_nonneg_left (hA z hz) hs₀.le
  rw [kap2_split hs hsx,hzs]
  let H := ∑ j ∈ below s, partialSum weightedMangoldt (x/j)
  let F := ∑ d ∈ below z, weightedMangoldt d*((⌊x/d⌋₊:ℝ)-⌊s⌋₊)
  change |H+F-hyperbolaMain x s z| ≤ _
  rw [show H+F-hyperbolaMain x s z =
      (H-x*((Real.log x-1)*harmonicSum s-harmonicLog s))+
      (F-(x*harmonicMangoldt z-s*partialSum weightedMangoldt z))-
      s*(partialSum weightedMangoldt z-(z*Real.log z-z)) by unfold hyperbolaMain; rw [← hsz]; ring]
  exact (abs_sub ..).trans (add_le_add ((abs_add_le ..).trans (add_le_add hH hF)) hE)

private theorem main_polynomial {c₀ c₁ c₂ K x s z : ℝ} (hs : 1 ≤ s) (hz : 1 ≤ z) (hprod : s*z=x)
    (h₀ : |harmonicSum s-(Real.log s+c₀)| ≤ K*s^(-(1/128):ℝ))
    (h₁ : |harmonicLog s-((Real.log s)^2/2+c₁)| ≤ K*s^(-(1/128):ℝ))
    (h₂ : |harmonicMangoldt z-((Real.log z)^2/2+c₂)| ≤ K*z^(-(1/128):ℝ)) :
    |hyperbolaMain x s z-x*((Real.log x)^2/2+(c₀-1)*Real.log x+(c₂-c₀-c₁+1))| ≤
      x*(((1+Real.log x)*(K*s^(-(1/128):ℝ))+K*s^(-(1/128):ℝ))+K*z^(-(1/128):ℝ)) := by
  have hsum : Real.log x=Real.log s+Real.log z := by
    rw [← hprod,Real.log_mul (by linarith : s ≠ 0) (by linarith : z ≠ 0)]
  have hx : 1 ≤ x := by nlinarith [mul_le_mul hs hz zero_le_one (by linarith : 0 ≤ s)]
  have hlog := Real.log_nonneg hx
  let e₀ := harmonicSum s-(Real.log s+c₀)
  let e₁ := harmonicLog s-((Real.log s)^2/2+c₁)
  let e₂ := harmonicMangoldt z-((Real.log z)^2/2+c₂)
  have he : hyperbolaMain x s z-x*((Real.log x)^2/2+(c₀-1)*Real.log x+(c₂-c₀-c₁+1)) =
      x*((Real.log x-1)*e₀-e₁+e₂) := by dsimp [hyperbolaMain,e₀,e₁,e₂]; rw [hsum]; ring
  have hL : |Real.log x-1| ≤ 1+Real.log x := by rw [abs_le]; constructor <;> linarith
  rw [he,abs_mul,abs_of_pos (by linarith : 0 < x)]
  apply mul_le_mul_of_nonneg_left _ (by linarith)
  apply (abs_add_le ..).trans
  apply add_le_add _ h₂
  apply (abs_sub ..).trans
  apply add_le_add _ h₁
  rw [abs_mul]
  exact mul_le_mul hL h₀ (abs_nonneg _) (by linarith)

private theorem cut_power {x : ℝ} (hx : 1 ≤ x) {a b c : ℝ} (h : a+b ≤ c) :
    x^a*x^b ≤ x^c := by
  rw [← Real.rpow_add (by linarith : 0 < x)]
  exact Real.rpow_le_rpow_of_exponent_le hx h

/-- The principal divisor coefficient has a quadratic summatory main term with
a power-saving remainder for every real endpoint, conditional only on RH. -/
theorem kap2_summatory_of_RH (hRH : RiemannHypothesis) :
    ∃ b c D : ℝ, 0 < D ∧ ∀ x : ℝ, 1 ≤ x →
      |partialSum BHB.MT.kap2 x-x*((Real.log x)^2/2+b*Real.log x+c)| ≤
        D*x^(1-1/65536:ℝ) := by
  obtain ⟨C,hC,hA⟩ := weighted_mangoldt_of_RH hRH
  obtain ⟨c₀,c₁,c₂,K,hK,hH⟩ := harmonic_estimates hRH
  refine ⟨c₀-1,c₂-c₀-c₁+1,4*C+131072+65539*K,by positivity,?_⟩
  intro x hx
  have hx₀ : 0 < x := by linarith
  let s := x^(1/256:ℝ)
  let z := x^(255/256:ℝ)
  let U := x^(1-1/65536:ℝ)
  let V := x^(1/65536:ℝ)
  have hs : 1 ≤ s := Real.one_le_rpow hx (by norm_num)
  have hz : 1 ≤ z := Real.one_le_rpow hx (by norm_num)
  have hsz : s*z=x := by dsimp [s,z]; rw [← Real.rpow_add hx₀]; norm_num
  have he₁ := kap2_main_bound hC.le hA hs hz hsz
  have he₂ := main_polynomial hs hz hsz (hH s hs).1 (hH s hs).2.1 (hH z hz).2.2
  have hL := Real.log_le_rpow_div hx₀.le (show (0:ℝ)<1/65536 by norm_num)
  have hV : 1 ≤ V := Real.one_le_rpow hx (by norm_num)
  have hlog : 1+Real.log x ≤ 65537*V := by dsimp [V] at *; linarith
  have hsz₁ : s*x^(127/128:ℝ) ≤ U := cut_power hx (by norm_num)
  have hzpow : z^(127/128:ℝ) ≤ U := by
    dsimp [z,U]; rw [← Real.rpow_mul hx₀.le]; exact Real.rpow_le_rpow_of_exponent_le hx (by norm_num)
  have hsz₂ : s*z^(127/128:ℝ) ≤ U := by
    dsimp [s,z,U]; rw [← Real.rpow_mul hx₀.le]; exact cut_power hx (by norm_num)
  have hzV : z*V ≤ U := cut_power hx (by norm_num)
  have hzl : Real.log z ≤ Real.log x := Real.log_le_log (by linarith) (by nlinarith)
  have hA' : partialSum weightedMangoldt z ≤ (65536+C)*U := by
    have ha := (le_abs_self _).trans (hA z hz)
    have hl : Real.log z ≤ 65536*V := by dsimp [V]; linarith
    have hj := mul_le_mul_of_nonneg_left hl (show 0 ≤ z by linarith)
    nlinarith only [ha,hj,hzV,mul_le_mul_of_nonneg_left hzpow hC.le,show 0 ≤ z by linarith]
  have hsp : x*s^(-(1/128):ℝ) ≤ U := by
    dsimp [s,U]; rw [← Real.rpow_mul hx₀.le]
    simpa only [Real.rpow_one] using cut_power hx (a:=1) (by norm_num :
      1+(1/256:ℝ)*(-(1/128)) ≤ 1-1/65536)
  have hzp : x*z^(-(1/128):ℝ) ≤ U := by
    dsimp [z,U]; rw [← Real.rpow_mul hx₀.le]
    simpa only [Real.rpow_one] using cut_power hx (a:=1) (by norm_num :
      1+(255/256:ℝ)*(-(1/128)) ≤ 1-1/65536)
  have hsvp : x*(s^(-(1/128):ℝ)*V) ≤ U := by
    dsimp [s,V,U]; rw [← Real.rpow_mul hx₀.le,← Real.rpow_add hx₀]
    simpa only [Real.rpow_one] using cut_power hx (a:=1) (by norm_num :
      1+((1/256:ℝ)*(-(1/128))+1/65536) ≤ 1-1/65536)
  have hwt : x*((1+Real.log x)*(K*s^(-(1/128):ℝ))) ≤ 65537*K*U := by
    have h₁ := mul_le_mul_of_nonneg_right hlog
      (show 0 ≤ x*(K*s^(-(1/128):ℝ)) by positivity [lt_of_lt_of_le zero_lt_one hs])
    have h₂ := mul_le_mul_of_nonneg_left hsvp (show 0 ≤ 65537*K by positivity)
    nlinarith only [h₁,h₂]
  apply (abs_sub_le (partialSum BHB.MT.kap2 x) (hyperbolaMain x s z) _).trans
  apply (add_le_add he₁ he₂).trans
  change _ ≤ (4*C+131072+65539*K)*U
  nlinarith only [hA',hwt,mul_le_mul_of_nonneg_left hsz₁ hC.le,
    mul_le_mul_of_nonneg_left hsz₂ hC.le,mul_le_mul_of_nonneg_left hsp hK.le,
    mul_le_mul_of_nonneg_left hzp hK.le]

end ReflectedPrincipal
end
end Src_ReflectedPrincipal

