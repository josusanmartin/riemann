theorem _root_.Taper78.BHB.M2.integral_main_le (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) : ∃ C T₀ : ℝ,
    ∀ T : ℝ, T₀ ≤ T →
      |(∫ t : ℝ, H0 w T t * (Real.log (|t| / (2 * π)) ^ 3 * (3007 / 2500) / (3 * Real.log (ymol θ T))
            + Real.log (|t| / (2 * π)) ^ 2 / 2
            + Real.log (|t| / (2 * π)) * Real.log (ymol θ T) * (36271 / 75000)))
          - Taper78.BHB.cM θ * w.kap1 * T * Real.log T ^ 3 / (2 * π)|
        ≤ C * T * Real.log T ^ 2 := by
  obtain ⟨C, T₁, h⟩ := H0_moment w
  refine ⟨|C| * (3007 / (7500 * θ) + 1 / 2 + 36271 * θ / 75000), max T₁ 3, fun T hT => ?_⟩
  have hT1 : T₁ ≤ T := le_trans (le_max_left _ _) hT
  have hT3 : (3 : ℝ) ≤ T := le_trans (le_max_right _ _) hT
  have hT0 : 0 < T := by linarith
  have hL : 1 ≤ Real.log T := one_le_log hT3
  have hL0 : 0 < Real.log T := lt_of_lt_of_le zero_lt_one hL
  have hly : Real.log (ymol θ T) = θ * Real.log T := BHB.MT.log_ymol hT0 θ
  rw [hly]
  have m3 := h T hT1 3 (by norm_num)
  have m2 := h T hT1 2 (by norm_num)
  have m1 := h T hT1 1 (by norm_num)
  have i3 := (integrable_H0_log w hT0 3).const_mul ((3007 / 2500) / (3 * (θ * Real.log T)))
  have i2 := (integrable_H0_log w hT0 2).const_mul (1 / 2)
  have i1 := (integrable_H0_log w hT0 1).const_mul (θ * Real.log T * (36271 / 75000))
  have e : (∫ t : ℝ, H0 w T t * (Real.log (|t| / (2 * π)) ^ 3 * (3007 / 2500) / (3 * (θ * Real.log T))
        + Real.log (|t| / (2 * π)) ^ 2 / 2
        + Real.log (|t| / (2 * π)) * (θ * Real.log T) * (36271 / 75000)))
      = (3007 / 2500) / (3 * (θ * Real.log T)) * (∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 3)
        + 1 / 2 * (∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 2)
        + θ * Real.log T * (36271 / 75000) * (∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 1) := by
    have s2 : (∫ t : ℝ, (3007 / 2500) / (3 * (θ * Real.log T))
            * (H0 w T t * Real.log (|t| / (2 * π)) ^ 3)
          + 1 / 2 * (H0 w T t * Real.log (|t| / (2 * π)) ^ 2))
        = (∫ t : ℝ, (3007 / 2500) / (3 * (θ * Real.log T))
            * (H0 w T t * Real.log (|t| / (2 * π)) ^ 3))
          + ∫ t : ℝ, 1 / 2 * (H0 w T t * Real.log (|t| / (2 * π)) ^ 2) := integral_add i3 i2
    have s1 : (∫ t : ℝ, ((3007 / 2500) / (3 * (θ * Real.log T))
            * (H0 w T t * Real.log (|t| / (2 * π)) ^ 3)
          + 1 / 2 * (H0 w T t * Real.log (|t| / (2 * π)) ^ 2))
          + θ * Real.log T * (36271 / 75000) * (H0 w T t * Real.log (|t| / (2 * π)) ^ 1))
        = (∫ t : ℝ, (3007 / 2500) / (3 * (θ * Real.log T))
            * (H0 w T t * Real.log (|t| / (2 * π)) ^ 3)
          + 1 / 2 * (H0 w T t * Real.log (|t| / (2 * π)) ^ 2))
          + ∫ t : ℝ, θ * Real.log T * (36271 / 75000) * (H0 w T t * Real.log (|t| / (2 * π)) ^ 1) :=
      integral_add (i3.add i2) i1
    rw [← integral_const_mul, ← integral_const_mul, ← integral_const_mul, ← s2, ← s1]
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    show H0 w T t * (Real.log (|t| / (2 * π)) ^ 3 * (3007 / 2500) / (3 * (θ * Real.log T))
        + Real.log (|t| / (2 * π)) ^ 2 / 2
        + Real.log (|t| / (2 * π)) * (θ * Real.log T) * (36271 / 75000))
      = (3007 / 2500) / (3 * (θ * Real.log T)) * (H0 w T t * Real.log (|t| / (2 * π)) ^ 3)
        + 1 / 2 * (H0 w T t * Real.log (|t| / (2 * π)) ^ 2)
        + θ * Real.log T * (36271 / 75000) * (H0 w T t * Real.log (|t| / (2 * π)) ^ 1)
    ring
  rw [e]
  have hθ0 : θ ≠ 0 := hθ.ne'
  have hLne : Real.log T ≠ 0 := hL0.ne'
  have hπ : (2 * π : ℝ) ≠ 0 := by positivity
  have key : (3007 / 2500) / (3 * (θ * Real.log T)) * (∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 3)
        + 1 / 2 * (∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 2)
        + θ * Real.log T * (36271 / 75000) * (∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 1)
        - Taper78.BHB.cM θ * w.kap1 * T * Real.log T ^ 3 / (2 * π)
      = (3007 / 2500) / (3 * (θ * Real.log T))
          * ((∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 3)
            - w.kap1 / (2 * π) * T * Real.log T ^ (3 + 1))
        + 1 / 2 * ((∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 2)
            - w.kap1 / (2 * π) * T * Real.log T ^ (2 + 1))
        + θ * Real.log T * (36271 / 75000) * ((∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 1)
            - w.kap1 / (2 * π) * T * Real.log T ^ (1 + 1)) := by
    unfold Taper78.BHB.cM
    field_simp
    ring
  rw [key]
  have c3 : 0 ≤ (3007 / 2500) / (3 * (θ * Real.log T)) := by positivity
  have c1 : 0 ≤ θ * Real.log T * (36271 / 75000) := by positivity
  have hTL : 0 ≤ T * Real.log T ^ 2 := by positivity
  have b3 : |(3007 / 2500) / (3 * (θ * Real.log T))
        * ((∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 3)
          - w.kap1 / (2 * π) * T * Real.log T ^ (3 + 1))|
      ≤ |C| * (3007 / (7500 * θ)) * (T * Real.log T ^ 2) := by
    rw [abs_mul, abs_of_nonneg c3]
    calc (3007 / 2500) / (3 * (θ * Real.log T))
          * |(∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 3)
            - w.kap1 / (2 * π) * T * Real.log T ^ (3 + 1)|
        ≤ (3007 / 2500) / (3 * (θ * Real.log T)) * (C * T * Real.log T ^ 3) :=
          mul_le_mul_of_nonneg_left m3 c3
      _ = C * (3007 / (7500 * θ) * (T * Real.log T ^ 2)) := by
          field_simp
          ring
      _ ≤ |C| * (3007 / (7500 * θ) * (T * Real.log T ^ 2)) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (by positivity)
      _ = |C| * (3007 / (7500 * θ)) * (T * Real.log T ^ 2) := by ring
  have b2 : |1 / 2 * ((∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 2)
          - w.kap1 / (2 * π) * T * Real.log T ^ (2 + 1))|
      ≤ |C| * (1 / 2) * (T * Real.log T ^ 2) := by
    rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
    calc 1 / 2 * |(∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 2)
            - w.kap1 / (2 * π) * T * Real.log T ^ (2 + 1)|
        ≤ 1 / 2 * (C * T * Real.log T ^ 2) := mul_le_mul_of_nonneg_left m2 (by norm_num)
      _ = C * (1 / 2 * (T * Real.log T ^ 2)) := by ring
      _ ≤ |C| * (1 / 2 * (T * Real.log T ^ 2)) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (by positivity)
      _ = |C| * (1 / 2) * (T * Real.log T ^ 2) := by ring
  have b1 : |θ * Real.log T * (36271 / 75000) * ((∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 1)
          - w.kap1 / (2 * π) * T * Real.log T ^ (1 + 1))|
      ≤ |C| * (36271 * θ / 75000) * (T * Real.log T ^ 2) := by
    rw [abs_mul, abs_of_nonneg c1]
    calc θ * Real.log T * (36271 / 75000) * |(∫ t : ℝ, H0 w T t * Real.log (|t| / (2 * π)) ^ 1)
            - w.kap1 / (2 * π) * T * Real.log T ^ (1 + 1)|
        ≤ θ * Real.log T * (36271 / 75000) * (C * T * Real.log T ^ 1) :=
          mul_le_mul_of_nonneg_left m1 c1
      _ = C * (36271 * θ / 75000 * (T * Real.log T ^ 2)) := by ring
      _ ≤ |C| * (36271 * θ / 75000 * (T * Real.log T ^ 2)) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (by positivity)
      _ = |C| * (36271 * θ / 75000) * (T * Real.log T ^ 2) := by ring
  refine (abs_add_le _ _).trans ?_
  refine (add_le_add (abs_add_le _ _) le_rfl).trans ?_
  calc _ ≤ |C| * (3007 / (7500 * θ)) * (T * Real.log T ^ 2) + |C| * (1 / 2) * (T * Real.log T ^ 2)
          + |C| * (36271 * θ / 75000) * (T * Real.log T ^ 2) := add_le_add (add_le_add b3 b2) b1
    _ = |C| * (3007 / (7500 * θ) + 1 / 2 + 36271 * θ / 75000) * T * Real.log T ^ 2 := by ring


theorem _root_.Taper78.BHB.M2.M2pred_asymp (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) {C₀ : ℝ}
    (hM : MobiusHyp C₀) : ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T →
      |Taper78.BHB.M2.M2pred w θ T - Taper78.BHB.cM θ * w.kap1 * T * Real.log T ^ 3 / (2 * π)| ≤ C * T * Real.log T ^ 2 := by
  obtain ⟨C₁, T₁, h₁⟩ := BHB.M2.Reflected78.BrSum_asymp hM hθ
  obtain ⟨C₂, T₂, h₂⟩ := Taper78.BHB.M2.integral_main_le w hθ hθ1
  obtain ⟨C₃, T₃, h₃⟩ := integral_err_le w hθ hθ1
  refine ⟨|C₁| * |C₃| + |C₂|, max (max T₁ T₂) (max T₃ 3), fun T hT => ?_⟩
  have hT1 : T₁ ≤ T := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hT
  have hT2 : T₂ ≤ T := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hT
  have hT3 : T₃ ≤ T := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hT
  have hT4 : (3 : ℝ) ≤ T := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hT
  have hT0 : 0 < T := by linarith
  have hL0 : 0 ≤ Real.log T := le_trans zero_le_one (one_le_log hT4)
  have hly0 : 0 ≤ Real.log (ymol θ T) :=
    Real.log_nonneg (Real.one_le_rpow (by linarith) hθ.le)
  have hTL : 0 ≤ T * Real.log T ^ 2 := by positivity
  have a2 := h₂ T hT2
  obtain ⟨i3, a3⟩ := h₃ T hT3
  have hI := Taper78.BHB.M2.integrable_H0_BrSum w θ hT0
  have hm : Integrable (fun t : ℝ => H0 w T t
