/- The continuous contribution to the retapered second moment, following BHB.MainT2.Lead. -/
noncomputable section
set_option Elab.async false

def Taper78.BHB.cM (θ : ℝ) : ℝ := 1/2+36271*θ/75000+3007/(7500*θ)

#retaper
