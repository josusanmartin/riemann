namespace RealResidual

def value (a w : ℂ) : ℂ :=
  ⟨0.44238-0.530*w.re-0.397664*a.re, -0.530*w.im-0.397664*a.im⟩

/-- Young's inequality applied separately to the real and imaginary covariances. -/
def correction (y u : ℂ) (b μ : ℝ) : ℝ :=
  -2*((y.re-b)*(u.re-μ)+y.im*u.im)-0.59*((y.re-b)^2+y.im^2)-
    (100/59)*(u.re-μ)^2-u.im^2/8

theorem correction_le (y u : ℂ) (b μ : ℝ) :
    correction y u b μ ≤ 7.41*y.im^2 := by
  unfold correction
  nlinarith only [sq_nonneg (59*(y.re-b)+100*(u.re-μ)), sq_nonneg (8*y.im+u.im)]

private theorem real_score (m : ℕ) (hm : 1 ≤ m) (a w : ℂ)
    (hz : m ≠ 1 → a=0) (hl : (m:ℝ) ≤ 1000/999-2*w.re+1/100000) :
    (m:ℝ)*(1-(value a w).re^2) ≤ 1 := by
  by_cases h₁ : m=1
  · subst m
    simp only [Nat.cast_one,one_mul]
    linarith only [sq_nonneg (value a w).re]
  rw [hz h₁]
  change (m:ℝ)*(1-(0.44238-0.530*w.re-0.397664*(0:ℂ).re)^2) ≤ 1
  simp only [Complex.zero_re,mul_zero,sub_zero]
  by_cases h₂ : m=2
  · subst m
    norm_num only [Nat.cast_ofNat] at hl ⊢
    have he : 0.707107 ≤ 0.44238-0.530*w.re := by linarith
    nlinarith only [mul_self_le_mul_self (by norm_num : (0:ℝ) ≤ 0.707107) he]
  by_cases h₃ : m=3
  · subst m
    norm_num only [Nat.cast_ofNat] at hl ⊢
    have he : 0.9 ≤ 0.44238-0.530*w.re := by linarith
    nlinarith only [mul_self_le_mul_self (by norm_num : (0:ℝ) ≤ 0.9) he]
  have hm4 : (4:ℝ) ≤ m := by exact_mod_cast (show 4 ≤ m by omega)
  have he : 1 ≤ 0.44238-0.530*w.re := by linarith
  have hneg : 1-(0.44238-0.530*w.re)^2 ≤ 0 := by
    nlinarith only [mul_self_le_mul_self zero_le_one he]
  exact (mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg _) hneg).trans zero_le_one

/-- Sufficient limits for both board intervals, using the real residual at each zero. -/
theorem both_intervals (hRH : RiemannHypothesis) (a w u : ℝ → ℂ → ℂ) (b μ : ℝ)
    (hzero : ∀ᶠ T in atTop, ∀ z ∈ ThirdMoment.zerosFinset T (2*T),
      Zeta23.zeroMult z ≠ 1 → a T z=0)
    (hlocal : ∀ᶠ T in atTop, ∀ z ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult z:ℝ) ≤ 1000/999-2*(w T z).re+1/100000)
    (hcost : ∀ᶠ T in atTop, sumAt T (fun z => MultiplicityProbe.sq (value (a T z) (w T z))) -
      (1/7.41)*sumAt T (fun z => correction (value (a T z) (w T z)) (u T z) b μ) ≤
      0.14609154911*count T) :
    Dyadic (85390845089/100000000000) ∧ Cumulative (85390845089/100000000000) := by
  apply intervals
  filter_upwards [hzero,hlocal,hcost] with T hz hl hc
  rw [(Zeta23.RH_implies_all_on_line hRH _ _).2]
  have bound : count T - sumAt T (fun z => MultiplicityProbe.sq (value (a T z) (w T z))) +
      (1/7.41)*sumAt T (fun z => correction (value (a T z) (w T z)) (u T z) b μ) ≤
      (Zeta23.Ndist T (2*T):ℝ) := by
    have one (z : ℂ) (hz' : z ∈ ThirdMoment.zerosFinset T (2*T)) :
        (Zeta23.zeroMult z:ℝ) - (Zeta23.zeroMult z:ℝ)*MultiplicityProbe.sq (value (a T z) (w T z)) +
          (1/7.41)*((Zeta23.zeroMult z:ℝ)*correction (value (a T z) (w T z)) (u T z) b μ) ≤ 1 := by
      have he := correction_le (value (a T z) (w T z)) (u T z) b μ
      have hf := real_score _ (ThirdMoment.one_le_mult_of_mem hz') _ _ (hz z hz') (hl z hz')
      have hp := mul_le_mul_of_nonneg_left he (Nat.cast_nonneg (Zeta23.zeroMult z) : (0:ℝ) ≤ _)
      unfold MultiplicityProbe.sq
      linarith only [hp,hf]
    have hs := Finset.sum_le_sum (s := ThirdMoment.zerosFinset T (2*T)) one
    simpa only [sumAt,count,ThirdMoment.Ncount_eq,ThirdMoment.Ndist_eq,Nat.cast_sum,
      Finset.sum_add_distrib,Finset.sum_sub_distrib,← Finset.mul_sum,
      Finset.sum_const,nsmul_eq_mul,mul_one] using hs
  have hscore : (1-(85390845089/100000000000:ℝ))*count T ≥ 0.14609154911*count T := by
    exact mul_le_mul_of_nonneg_right (by norm_num) (Nat.cast_nonneg _)
  linarith only [bound,hc,hscore]

abbrev lengthExponent : ℝ := 4999999/10000000

def mollified (T : ℝ) (s : ℂ) : ℂ :=
  deriv riemannZeta s / (Real.log T : ℂ) * ∑ k ∈ BHB.Krange lengthExponent T,
    let y := BHB.ymol lengthExponent T
    let v := Real.log (y/k)/Real.log y
    (((ArithmeticFunction.moebius k : ℝ)*(1.78*v-0.78*v^2) : ℝ) : ℂ) * (k:ℂ)^(-s)

def shortPrimes (T : ℝ) (s : ℂ) : ℂ :=
  ∑ k ∈ (BHB.Krange lengthExponent T).filter Nat.Prime,
    let x := Real.log k/Real.log T
    ((x*(1-x/5-9*x^2/20) : ℝ) : ℂ)*(k:ℂ)^(-s)

def centerU : ℝ := -lengthExponent^2/2+lengthExponent^3/15+9*lengthExponent^4/80

def centerY : ℝ :=
  0.44238+0.530*0.999/6-0.398*(1/2+lengthExponent*(1/2+0.78/6))

def cost (T : ℝ) : ℝ :=
  let y := fun z => value (mollified T z) (FejerMultiplicity.probe 0.999 T z)
  sumAt T (fun z => MultiplicityProbe.sq (y z)) -
    (1/7.41)*sumAt T (fun z => correction (y z) (shortPrimes T z) centerY centerU)

/-- The actual mollifier and the two prime statistics need one remaining
analytic estimate. Vanishing at multiple zeros and the local bound follow from RH. -/
theorem reflected_8539 (hRH : RiemannHypothesis)
    (hc : ∀ᶠ T in atTop, cost T ≤ 0.14609154911*count T) :
    Dyadic (85390845089/100000000000) ∧ Cumulative (85390845089/100000000000) := by
  refine both_intervals hRH mollified (FejerMultiplicity.probe 0.999)
    shortPrimes centerY centerU ?_ ?_ hc
  · filter_upwards [] with T
    intro z hz hm
    let ρ : Zeta23.zetaZeroConfig.carrier := ⟨z,(ThirdMoment.mem_zerosFinset.mp hz).1⟩
    have h := BHB.Red.deriv_zeta_eq_zero_of_mult_ne_one ρ hm
    simp [mollified,show deriv riemannZeta z=0 from h]
  · simpa only [show (1:ℝ)/0.999=1000/999 by norm_num] using
      (FejerMultiplicity.local_bound hRH (b := 0.999) (ε := 1/100000)
        (by norm_num) (by norm_num) (by norm_num))

end RealResidual
end ShortProbe
end
