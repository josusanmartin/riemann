/-- Subtract the real difference of the two means before charging the
    Hermitian squares. The shift may be any fixed real number. -/
theorem centered_product (x y : ℂ) (d : ℝ) :
    (x*y).re ≤ (sq x+sq y)/2-d*(x.re-y.re)+d^2/2 := by
  simp only [sq, Complex.mul_re]
  nlinarith only [sq_nonneg (x.re-y.re-d), sq_nonneg (x.im+y.im)]

/-- Sum the integer-multiplicity loss for an arbitrary local prime window. -/
theorem window_residual (T arch a : ℝ) (w : ℂ → ℂ) (ha : 1 ≤ a) (ha' : a < 2)
    (hl : ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T), (Zeta23.zeroMult ρ : ℝ) ≤ arch-2*(w ρ).re) :
    2*(2-a)^2*(count T-(Zeta23.Ndist T (2*T) : ℝ)) ≤
    sumAt T (fun ρ => (arch-2*(w ρ).re-a)^2) := by
  have single (m : ℕ) (hm : 1 ≤ m) (u : ℝ) (hu : (m:ℝ) ≤ u) :
      2*(2-a)^2*((m:ℝ)-1) ≤ (m:ℝ)*(u-a)^2 := by
    rcases eq_or_lt_of_le hm with h|h
    · subst m; simpa using sq_nonneg (u-a)
    by_cases ht : m=2
    · subst m
      have hs : (2-a)^2 ≤ (u-a)^2 := by
        apply sq_le_sq' <;> norm_num at hu <;> linarith
      norm_num at *
      linarith
    have h3 : (3:ℝ) ≤ m := by exact_mod_cast (show 3 ≤ m by omega)
    have hs : (2*(2-a))^2 ≤ (u-a)^2 := by apply sq_le_sq' <;> linarith
    have hm0 : (0:ℝ) ≤ m := Nat.cast_nonneg _
    nlinarith only [mul_le_mul_of_nonneg_left hs hm0,
      mul_nonneg (show 0 ≤ (m:ℝ)+1 by positivity) (sq_nonneg (2-a))]
  have h := Finset.sum_le_sum (s := ThirdMoment.zerosFinset T (2*T)) (fun ρ hρ =>
    single _ (ThirdMoment.one_le_mult_of_mem hρ) _ (hl ρ hρ))
  rw [← Finset.mul_sum, Finset.sum_sub_distrib] at h
  simpa only [ThirdMoment.Ndist_eq, count, ThirdMoment.Ncount_eq, sumAt,
    Finset.sum_const, nsmul_eq_mul, mul_one] using h

theorem residual_expand (T arch a : ℝ) (w : ℂ → ℂ) :
    sumAt T (fun ρ => (arch-2*(w ρ).re-a)^2) =
    (arch-a)^2*count T - 4*(arch-a)*sumAt T (fun ρ => (w ρ).re) +
    2*(sumAt T (fun ρ => sq (w ρ))+sumAt T (fun ρ => ((w ρ)^2).re)) := by
  rw [count, ThirdMoment.Ncount_eq]
  unfold sumAt
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro ρ _
  simp only [sq, pow_two, Complex.mul_re]
  ring

/-- The h=.999 tapered test retaining products through T^1.4319. -/
theorem tapered_finite (T : ℝ) (w : ℂ → ℂ)
    (hl : ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult ρ : ℝ) ≤ 1014136/1000000-2*(w ρ).re)
    (hm : sumAt T (fun ρ => (w ρ).re) ≤ -(157881/1000000)*count T)
    (hv : sumAt T (fun ρ => sq (w ρ)) ≤ (83306/1000000)*count T)
    (hj : sumAt T (fun ρ => ((w ρ)^2).re) ≤ (21943/1000000)*count T) :
    (901/1000)*count T ≤ (Zeta23.Ndist T (2*T) : ℝ) := by
  have h := window_residual T _ (11646/10000) w (by norm_num) (by norm_num) hl
  rw [residual_expand] at h
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  linarith

/-- The rounded tapered constants allow a positive height majorant with
    total mass ratio up to 4001/4000. Only the local inequality on the
    actual dyadic interval is needed. -/
theorem one_height_window (T : ℝ) (w : ℂ → ℂ) (mass loss : ℝ)
    (hl : ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult ρ : ℝ) ≤ 1014136/1000000-2*(w ρ).re)
    (hdom : sumAt T (fun ρ => (1014136/1000000-2*(w ρ).re-11646/10000)^2) ≤ loss)
    (hmass : mass ≤ (4001/4000)*count T)
    (hloss : loss ≤ ((1014136/1000000-11646/10000)^2 -
      4*(1014136/1000000-11646/10000)*(-(157881/1000000)) +
      2*(83306/1000000+21943/1000000))*mass) :
    (901/1000)*count T ≤ (Zeta23.Ndist T (2*T) : ℝ) := by
  have h := (window_residual T _ (11646/10000) w (by norm_num) (by norm_num) hl).trans hdom
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  linarith

#print axioms tapered_finite

/-- The shorter balanced-product candidate. The signed ordinary second
    moment still has to supply the indicated upper bound on the loss. -/
theorem shorter_one_height (T : ℝ) (w : ℂ → ℂ) (mass loss : ℝ)
    (hl : ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult ρ : ℝ) ≤ 1026741/1000000-2*(w ρ).re)
    (hdom : sumAt T (fun ρ => (1026741/1000000-2*(w ρ).re-11258/10000)^2) ≤ loss)
    (hmass : mass ≤ (4001/4000)*count T)
    (hloss : loss ≤ ((1026741/1000000-11258/10000)^2 -
      4*(1026741/1000000-11258/10000)*(-(154279/1000000)) +
      2*(83252/1000000+33996/1000000))*mass) :
    (88/100)*count T ≤ (Zeta23.Ndist T (2*T) : ℝ) := by
  have h := (window_residual T _ (11258/10000) w (by norm_num) (by norm_num) hl).trans hdom
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  linarith

#print axioms shorter_one_height

/-- Charge the missing high-prime square and the two orientations of the
    omitted low/high corner. Optimizing t gives the geometric mean cost. -/
theorem asymmetric_square (h b u : ℂ) (t : ℝ) (ht : 0 < t) :
    t*(h^2+2*b*u).re ≤ t*sq h+t^2*sq b+sq u := by
  rw [show (2:ℂ)*b = b+b by ring]
  simp only [sq, pow_two, Complex.add_re, Complex.add_im, Complex.mul_re]
  nlinarith only [mul_nonneg ht.le (sq_nonneg h.im),
    sq_nonneg (t*b.re-u.re), sq_nonneg (t*b.im+u.im)]

def asymmetricBudget (κ arch μ V J a : ℝ) : Prop :=
  (4001/4000)*((arch-a)^2-4*(arch-a)*μ+2*(V+J)) < 2*(2-a)^2*(1-κ)

theorem asymmetric_budgets :
    asymmetricBudget (90/100) (10078304/10^7) (-1608516/10^7) (833053/10^7)
      (245900/10^7) (11620/10000) ∧
    asymmetricBudget (901/1000) (10087888/10^7) (-1606988/10^7) (833053/10^7)
      (236612/10^7) (11650/10000) ∧
    asymmetricBudget (901/1000) (10087888/10^7) (-1606988/10^7) (833053/10^7)
      (236459/10^7) (11650/10000) ∧
    asymmetricBudget (88/100) (10087888/10^7) (-1606988/10^7) (833053/10^7)
      (391283/10^7) (11190/10000) := by
  norm_num [asymmetricBudget]

theorem asymmetric_one_height (T κ arch μ V J a mass : ℝ) (w : ℂ → ℂ)
    (ha : 1 ≤ a) (ha' : a < 2) (hb : asymmetricBudget κ arch μ V J a)
    (hl : ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T), (Zeta23.zeroMult ρ : ℝ) ≤ arch-2*(w ρ).re)
    (hmass : mass ≤ (4001/4000)*count T)
    (hr : 0 ≤ (arch-a)^2-4*(arch-a)*μ+2*(V+J))
    (hbound : sumAt T (fun ρ => (arch-2*(w ρ).re-a)^2) ≤
        ((arch-a)^2-4*(arch-a)*μ+2*(V+J))*mass) :
    κ*count T ≤ (Zeta23.Ndist T (2*T) : ℝ) := by
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  have h := (window_residual T arch a w ha ha' hl).trans hbound
  have hm := mul_le_mul_of_nonneg_left hmass hr
  have hbudget := mul_le_mul_of_nonneg_right (le_of_lt hb) hn
  have hpos : 0 < 2*(2-a)^2 := by have := sub_pos.mpr ha'; positivity
  have h' : 2*(2-a)^2*(count T-(Zeta23.Ndist T (2*T) : ℝ)) ≤
      2*(2-a)^2*((1-κ)*count T) := by
    unfold asymmetricBudget at hb
    calc
      _ ≤ _ := h.trans hm
      _ = ((4001/4000)*((arch-a)^2-4*(arch-a)*μ+2*(V+J)))*count T := by ring
      _ ≤ _ := by simpa only [mul_assoc] using hbudget
  have := (mul_le_mul_iff_right₀ hpos).mp h'
  linarith

#print axioms asymmetric_square
#print axioms asymmetric_budgets
#print axioms asymmetric_one_height

/-- A pair of real quadratic form witnesses charges all removed ordinary
    products to a single Hermitian form, including overlapping removals. -/
theorem ordinary_matrix_charge {ι : Type*} [Fintype ι] (A Y : ι → ι → ℝ) (z : ι → ℂ)
    (hminus : ∀ v : ι → ℝ, 0 ≤ ∑ i, ∑ j, (Y i j-A i j)*v i*v j)
    (hplus : ∀ v : ι → ℝ, 0 ≤ ∑ i, ∑ j, (Y i j+A i j)*v i*v j) :
    (∑ i, ∑ j, A i j*(z i*z j).re) ≤
      ∑ i, ∑ j, Y i j*(z i*(starRingEnd ℂ) (z j)).re := by
  apply sub_nonneg.mp
  calc
    0 ≤ (∑ i, ∑ j, (Y i j-A i j)*(z i).re*(z j).re) +
        (∑ i, ∑ j, (Y i j+A i j)*(z i).im*(z j).im) :=
      add_nonneg (hminus fun i => (z i).re) (hplus fun i => (z i).im)
    _ = _ := by
      simp only [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro j _
      simp only [Complex.mul_re, Complex.conj_re, Complex.conj_im]
      ring

#print axioms ordinary_matrix_charge
