theorem _root_.Taper78.BHB.MTP.continuousOn_Glead_kernel {ρ : ℝ} (hρ : 0 < ρ) (ly L₀ : ℝ) :
    ContinuousOn (fun x : ℂ × ℂ × ℂ × ℂ × ℂ =>
        exp (x.1 * (L₀ : ℂ)) * (Zl x.1 x.2.1 x.2.2.1 x.2.2.2.1
          * Taper78.BHB.MTP.SSlead ly x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2))
      (sqBdy (4 * ρ) ×ˢ polyD ρ) := by
  have hS : Continuous (fun x : ℂ × ℂ × ℂ × ℂ × ℂ =>
      Taper78.BHB.MTP.SSlead ly x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2) := Taper78.BHB.MTP.continuous_SSlead ly
  have hE : Continuous (fun x : ℂ × ℂ × ℂ × ℂ × ℂ => exp (x.1 * (L₀ : ℂ))) := by fun_prop
  have hZ : ContinuousOn (fun x : ℂ × ℂ × ℂ × ℂ × ℂ => Zl x.1 x.2.1 x.2.2.1 x.2.2.2.1)
      (sqBdy (4 * ρ) ×ˢ polyD ρ) := by
    unfold Zl
    apply ContinuousOn.div (by fun_prop) (by fun_prop)
    intro x hx
    obtain ⟨hε, hp⟩ := hx
    obtain ⟨hα, hν, hβ, -⟩ := hp
    have h4 : 4 * ρ ≤ ‖x.1‖ := norm_ge_of_mem_sqBdy hε
    have hνβ : ‖x.2.2.1 + x.2.2.2.1‖ < ‖x.1‖ :=
      lt_of_le_of_lt (norm_add_le _ _) (by linarith)
    have n1 : x.1 ≠ 0 := by
      intro h0
      rw [h0, norm_zero] at h4
      linarith
    have n2 : x.1 + x.2.1 ≠ 0 := LI.add_ne_zero_of_norm_lt (by linarith)
    have n3 : x.1 + x.2.2.1 + x.2.2.2.1 ≠ 0 := by
      rw [add_assoc]
      exact LI.add_ne_zero_of_norm_lt hνβ
    exact mul_ne_zero (mul_ne_zero n1 n2) n3
  exact hE.continuousOn.mul (hZ.mul hS.continuousOn)
end BHB.MTP
