  have hπ : (2 * π * I : ℂ) ≠ 0 := Complex.two_pi_I_ne_zero
  have hly' : (ly : ℂ) ≠ 0 := by exact_mod_cast hly
  unfold Taper78.BHB.MTP.leadPoly
