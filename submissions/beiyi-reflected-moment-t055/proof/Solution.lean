section Src_ReflectedPrimeSquare


noncomputable section
open Filter Topology MeasureTheory FejerPrimeMoments ShortProbe.RealResidual
open scoped BigOperators Real ArithmeticFunction

namespace ReflectedPrimeSquare

abbrev h : ℝ := PrincipalBand.topExponent

def amplitude (q T : ℝ) (n : ℕ) := q*coeff (T^h) n-(if n ∈ shortSet T then shortCoeff T n else 0)

def pairing : ℝ :=
  let t := lengthExponent
  (t^2/2-t^3/15-9*t^4/80)/h-(t^3/3-t^4/20-9*t^5/100)/h^2

def energy (q : ℝ) := q^2/12-2*q*pairing+energyU
def mean (q : ℝ) := q*h/6+centerU

private lemma coefficient_at {T : ℝ} (hT : 0 < T) (n : ℕ) :
    coeff (T^h) n = TMA.lamCoeff n*((h-Real.log n/Real.log T)/h^2)/Real.log T := by
  rw [coeff,Real.log_rpow hT]; norm_num [h,PrincipalBand.topExponent]; ring

private lemma short_at (T : ℝ) {n : ℕ} (hn : n ∈ shortSet T) :
    shortCoeff T n=TMA.lamCoeff n*profile (Real.log n/Real.log T)/Real.log T := by
  rw [shortCoeff,shortWeight,TMA.lamCoeff,ArithmeticFunction.vonMangoldt_apply_prime (Finset.mem_filter.mp hn).2]
  unfold profile; ring

private lemma subset {T : ℝ} (hT : 1 ≤ T) : shortSet T ⊆ indices (T^h) := by
  rw [short_indices]
  exact (Finset.filter_subset ..).trans (Finset.Icc_subset_Icc_right (Nat.floor_mono
    (Real.rpow_le_rpow_of_exponent_le hT (by norm_num [lengthExponent,h,PrincipalBand.topExponent]))))

private lemma masked {α : Type*} [AddCommMonoid α] {S U : Finset ℕ} (hS : S ⊆ U) (f : ℕ → α) :
    (∑ n ∈ U, if n ∈ S then f n else 0) = ∑ n ∈ S, f n := by
  rw [← Finset.sum_filter]
  exact Finset.sum_congr (by ext n; simp only [Finset.mem_filter]; exact ⟨And.right,fun hn => ⟨hS hn,hn⟩⟩) (by simp)

private lemma pairing_limit : Tendsto (fun T => ∑ n ∈ shortSet T, coeff (T^h) n*shortCoeff T n) atTop (𝓝 pairing) := by
  let F (x : ℝ) := ((h-x)/h^2)*profile x
  have hf : ContDiff ℝ 1 F := by dsimp [F,profile]; fun_prop
  have hr : 0 < lengthExponent := by norm_num [lengthExponent]
  have hg := PrimeVariance.prime_diagonal_limit F hf hr (M:=2) (by norm_num) (fun x hx => by
    have h₁ := profile_bounds hx
    have h₂ : 0 ≤ (h-x)/h^2 := div_nonneg (sub_nonneg.mpr (hx.2.trans (by norm_num [lengthExponent,h,PrincipalBand.topExponent]))) (sq_nonneg _)
    have h₃ : (h-x)/h^2 ≤ 2 := (div_le_iff₀ (by norm_num [h,PrincipalBand.topExponent])).mpr
      ((sub_le_self _ hx.1).trans (by norm_num [h,PrincipalBand.topExponent]))
    rw [abs_of_nonneg (mul_nonneg h₂ h₁.1)]
    exact (mul_le_mul h₃ h₁.2 h₁.1 (by norm_num)).trans_eq (mul_one _))
  let G (x : ℝ) := (x^2/2-x^3/15-9*x^4/80)/h-(x^3/3-x^4/20-9*x^5/100)/h^2
  have hI : (∫ x in (0:ℝ)..lengthExponent, x*F x)=pairing := by
    have hd (x : ℝ) : HasDerivAt G (x*F x) x := by
      apply HasDerivAt.congr_deriv ((((((hasDerivAt_pow 2 x).div_const 2).sub ((hasDerivAt_pow 3 x).div_const 15)).sub
        (((hasDerivAt_pow 4 x).const_mul 9).div_const 80)).div_const h).sub
        (((((hasDerivAt_pow 3 x).div_const 3).sub ((hasDerivAt_pow 4 x).div_const 20)).sub
        (((hasDerivAt_pow 5 x).const_mul 9).div_const 100)).div_const (h^2)))
      dsimp [F,profile,h,PrincipalBand.topExponent]; ring
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hd x) ((continuous_id.mul hf.continuous).intervalIntegrable ..)]
    dsimp [G,pairing]; ring
  rw [hI] at hg
  apply hg.congr'
  filter_upwards [eventually_gt_atTop (0:ℝ)] with T hT
  rw [← short_indices,Finset.sum_div]
  refine Finset.sum_congr rfl fun n hn => ?_
  rw [coefficient_at hT,short_at T hn]
  have hs : TMA.lamCoeff n^2=Λ n^2/n := by simp [TMA.lamCoeff,div_pow,Real.sq_sqrt]
  rw [← hs]; dsimp [F]; ring

theorem limits (q : ℝ) :
    Tendsto (fun T => ∑ n ∈ indices (T^h), amplitude q T n^2) atTop (𝓝 (energy q)) ∧
    Tendsto (fun T => (∑ n ∈ indices (T^h), amplitude q T n*TMA.lamCoeff n)/Real.log T) atTop (𝓝 (mean q)) := by
  have hh : 0 < h := by norm_num [h,PrincipalBand.topExponent]
  have h₁ := PrimePairDiagonal.flat_first hh
  have h₂ := PrimePairDiagonal.flat_second hh
  have hcoef (T : ℝ) (hT : 0 < T) (n : ℕ) : TMA.lamCoeff n^2=Λ n^2/n := by
    simp [TMA.lamCoeff,div_pow,Real.sq_sqrt]
  have he : Tendsto (fun T => ∑ n ∈ indices (T^h), coeff (T^h) n^2) atTop (𝓝 (1/12)) := by
    apply h₂.congr'
    filter_upwards [eventually_gt_atTop (0:ℝ)] with T hT
    rw [PrimePairDiagonal.through,Finset.sum_div]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [coefficient_at hT,← hcoef T hT]; ring
  have hm : Tendsto (fun T => (∑ n ∈ indices (T^h), coeff (T^h) n*TMA.lamCoeff n)/Real.log T) atTop (𝓝 (h/6)) := by
    apply h₁.congr'
    filter_upwards [eventually_gt_atTop (0:ℝ)] with T hT
    rw [PrimePairDiagonal.through,Finset.sum_div,Finset.sum_div]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [coefficient_at hT,← hcoef T hT]; ring
  constructor
  · rw [show energy q=q^2*(1/12)-2*q*pairing+energyU by unfold energy; ring]
    apply (((he.const_mul (q^2)).sub (pairing_limit.const_mul (2*q))).add short_coeff_limits.2).congr'
    filter_upwards [eventually_gt_atTop (1:ℝ)] with T hT
    let S := indices (T^h)
    have hl := masked (subset hT.le) (fun n => coeff (T^h) n*shortCoeff T n)
    have hu := masked (subset hT.le) (fun n => shortCoeff T n^2)
    change q^2*(∑ n ∈ S,coeff (T^h) n^2)-2*q*(∑ n ∈ shortSet T,coeff (T^h) n*shortCoeff T n)+
      (∑ n ∈ shortSet T,shortCoeff T n^2)=_
    rw [← hl,← hu,Finset.mul_sum,Finset.mul_sum,← Finset.sum_sub_distrib,← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun n _ => ?_
    unfold amplitude; split_ifs <;> ring
  · have hh' : q*(h/6)-(-centerU)=mean q := by unfold mean; ring
    rw [← hh']
    apply ((hm.const_mul q).sub short_coeff_limits.1).congr'
    filter_upwards [eventually_gt_atTop (1:ℝ)] with T hT
    have hl := masked (subset hT.le) (fun n => shortCoeff T n*TMA.lamCoeff n)
    change q*(_/Real.log T)-(_/Real.log T)=_
    rw [← hl,← mul_div_assoc,← sub_div,Finset.mul_sum,← Finset.sum_sub_distrib]
    congr 1
    refine Finset.sum_congr rfl fun n _ => ?_
    unfold amplitude; split_ifs <;> ring

private lemma amp_nonneg {q T : ℝ} (hq : 5/2 ≤ q) (hT : 1 < T) {n : ℕ} (hn : n ∈ indices (T^h)) :
    0 ≤ amplitude q T n := by
  have ht := zero_lt_one.trans hT
  have hL := Real.log_pos hT
  let x := Real.log n/Real.log T
  have hn₀ : (0:ℝ) < n := by exact_mod_cast (lt_of_lt_of_le (by decide : 0<2) (Finset.mem_Icc.mp hn).1)
  have hx {u : ℝ} (hn' : n ≤ ⌊T^u⌋₊) : x ≤ u := by
    have ha := Real.log_le_log hn₀ ((Nat.le_floor_iff (Real.rpow_nonneg ht.le u)).mp hn')
    rw [Real.log_rpow ht] at ha
    exact (div_le_iff₀ hL).mpr ha
  have hlam : 0 ≤ TMA.lamCoeff n := div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _)
  have hq₀ : 0 ≤ q := by linarith
  unfold amplitude
  by_cases hs : n ∈ shortSet T
  · rw [if_pos hs,short_at T hs,coefficient_at ht]
    have hxl := hx (Finset.mem_Icc.mp (Finset.mem_filter.mp hs).1).2
    have hxl' : x ≤ lengthExponent := hxl
    have hf := (profile_bounds ⟨div_nonneg (Real.log_natCast_nonneg n) hL.le,hxl'⟩).2
    have hg : (2/5:ℝ) ≤ (h-x)/h^2 := by
      apply (le_div_iff₀ (by norm_num [h,PrincipalBand.topExponent])).mpr
      dsimp [lengthExponent] at hxl'; norm_num [h,PrincipalBand.topExponent]; linarith
    have hprod := mul_le_mul hq hg (by norm_num) hq₀
    have he : 0 ≤ q*((h-x)/h^2)-profile x := by linarith
    exact (show 0 ≤ TMA.lamCoeff n*(q*((h-x)/h^2)-profile x)/Real.log T from
      div_nonneg (mul_nonneg hlam he) hL.le).trans_eq (by dsimp only [x]; ring)
  · rw [if_neg hs,sub_zero,coefficient_at ht]
    exact mul_nonneg hq₀ (div_nonneg (mul_nonneg hlam (div_nonneg (sub_nonneg.mpr (hx (Finset.mem_Icc.mp hn).2)) (sq_nonneg _))) hL.le)

private lemma phase_at {T : ℝ} (hT : 1 < T) (s : ℂ) (n : ℕ) :
    TMA.phase T 1 s (TMA.lamOf T 1 n)=
      Complex.exp ((starRingEnd ℂ) (-Complex.I*(s.im:ℂ)*(Real.log n:ℂ))) := by
  unfold TMA.phase TMA.lamOf
  congr 1
  simp only [map_mul,map_neg,Complex.conj_I,neg_neg,Complex.conj_ofReal]
  push_cast
  field_simp [(Real.log_pos hT).ne']

private lemma polynomial_eq {T : ℝ} (hT : 1 < T) {s : ℂ} (hs : s.re=1/2) (q : ℝ) :
    (starRingEnd ℂ) ((q:ℂ)*FejerMultiplicity.probe h T s-shortPrimes T s)=
      polynomial (indices (T^h)) (amplitude q T) T 1 s := by
  let S := indices (T^h)
  let ph := fun n => TMA.phase T 1 s (TMA.lamOf T 1 n)
  have hW : (starRingEnd ℂ) (FejerMultiplicity.probe h T s)=∑ n ∈ S, (coeff (T^h) n:ℂ)*ph n := by
    rw [probe_on_line hT hs,map_sum]
    exact Finset.sum_congr rfl (fun n _ => by rw [map_mul,Complex.conj_ofReal,← Complex.exp_conj]; dsimp [ph]; rw [phase_at hT])
  rw [map_sub,map_mul,Complex.conj_ofReal,hW,short_on_line hT hs]
  change (q:ℂ)*(∑ n ∈ S,(coeff (T^h) n:ℂ)*ph n)-(∑ n ∈ shortSet T,(shortCoeff T n:ℂ)*ph n)=_
  rw [← masked (subset hT.le) (fun n => (shortCoeff T n:ℂ)*ph n),Finset.mul_sum,← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun n _ => ?_
  dsimp only [polynomial,amplitude,ph]
  split_ifs <;> push_cast <;> ring

/-- A single nonnegative coefficient sequence controls the simultaneous long
and short probes in the completed square, including all prime-power labels. -/
theorem shifted (hRH : RiemannHypothesis) (w : TMA.HeightWeight) {q : ℝ} (hq : 5/2 ≤ q) (d : ℝ) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ T : ℝ in atTop, ∃ v : ℝ, HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z*
      ‖(q:ℂ)*FejerMultiplicity.probe h T z-shortPrimes T z-(d:ℂ)‖^2) v ∧
      v ≤ (w.kap1*(d^2+energy q+2*d*mean q)+ε)*TMA.Dsc T := by
  obtain ⟨C,hC,hS⟩ := PrimeVariance.smooth_shifted_square hRH w (s:=h)
    (by norm_num [h,PrincipalBand.topExponent]) (by norm_num [h,PrincipalBand.topExponent])
  obtain ⟨hE,hM⟩ := limits q
  have h₀ : Tendsto (fun T : ℝ => C*(2*Real.pi)/Real.log T) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop Real.tendsto_log_atTop
  have hbound := (((h₀.add_const w.kap1).mul ((tendsto_const_nhds (x:=d^2)).add hE)).add
    (hM.const_mul (2*w.kap1*d))).eventually_le_const
    (show (0+w.kap1)*(d^2+energy q)+2*w.kap1*d*mean q < w.kap1*(d^2+energy q+2*d*mean q)+ε by linarith)
  filter_upwards [hbound,hS,eventually_gt_atTop (1:ℝ)] with T hb hs hT
  have hL := Real.log_pos hT
  obtain ⟨v,hv,hv'⟩ := hs _ subset_rfl (amplitude q T)
    (by simp [amplitude,coeff,TMA.lamCoeff,shortCoeff,shortWeight]) (fun _ hn => amp_nonneg hq hT hn) d
  refine ⟨v,hv.congr_fun (fun ρ => ?_),hv'.trans ?_⟩
  · rw [← polynomial_eq hT (Zeta23.RH_implies_on_line hRH ρ.2),← Complex.conj_ofReal d,← map_sub,Complex.norm_conj,Complex.conj_ofReal]
  · let E := ∑ n ∈ indices (T^h), amplitude q T n^2
    let M := ∑ n ∈ indices (T^h), amplitude q T n*TMA.lamCoeff n
    change (C*(2*Real.pi)/Real.log T+w.kap1)*(d^2+E)+2*w.kap1*d*(M/Real.log T) ≤ _ at hb
    have hD : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg (zero_lt_one.trans hT).le hL.le) (by positivity)
    apply le_trans _ (mul_le_mul_of_nonneg_right hb hD)
    apply le_of_eq
    change (C*T+w.kap1*TMA.Dsc T)*(d^2+E)+2*T*(w.kap1/(2*Real.pi))*d*M=_
    unfold TMA.Dsc
    field_simp [hL.ne',Real.pi_ne_zero]

end ReflectedPrimeSquare
end
end Src_ReflectedPrimeSquare

section Src_ReflectedMoments


noncomputable section
open Filter ShortProbe ShortProbe.RealResidual ReflectedPrimeSquare

namespace ReflectedMoments

def shift : ℝ := 8*0.44238-centerU-0.59*centerY

/-- Expand the completed square only after the prime and derivative terms
have been paired. This keeps the proven signed mixed moment. -/
theorem expand (a w u : ℂ) :
    MultiplicityProbe.sq (value a w+(u-(centerU:ℂ)-(0.59*centerY:ℝ))/8)=
      (1/64)*‖(106/25:ℂ)*w-u-(shift:ℂ)‖^2+0.397664^2*‖a‖^2-
      (2*0.397664*shift/8)*a.re+(2*0.397664/8)*(a*(starRingEnd ℂ) ((106/25:ℂ)*w-u)).re := by
  rw [← Complex.normSq_eq_norm_sq,← Complex.normSq_eq_norm_sq]
  simp only [MultiplicityProbe.sq,value,shift,Complex.normSq_apply,Complex.add_re,Complex.add_im,
    Complex.sub_re,Complex.sub_im,Complex.ofReal_re,Complex.ofReal_im,Complex.mul_re,Complex.mul_im,
    Complex.div_ofNat_re,Complex.div_ofNat_im,Complex.re_ofNat,Complex.im_ofNat,Complex.conj_re,
    Complex.conj_im,sub_zero]
  ring

/-- The prime contribution and all mixed terms are discharged from RH.
The two hypotheses concern only the first two moments of the .78 taper. -/
theorem score_8539 (hRH : RiemannHypothesis) (w : BHB.Weight) (hw : w.kap1 ≤ 1+1/10^7)
    (h₁ : ∀ᶠ T : ℝ in atTop, ∃ m : ℝ, HasSum (fun ρ : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T ρ*(mollified T ρ).re) m ∧ 0.8149998*TMA.Dsc T ≤ m)
    (h₂ : ∀ᶠ T : ℝ in atTop, ∃ e : ℝ, HasSum (fun ρ : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T ρ*‖mollified T ρ‖^2) e ∧ e ≤ 0.948026*TMA.Dsc T) :
    Dyadic (85390845089/100000000000) ∧ Cumulative (85390845089/100000000000) := by
  have hD : ∀ᶠ T : ℝ in atTop, 0 ≤ TMA.Dsc T := by
    filter_upwards [eventually_gt_atTop (1:ℝ)] with T hT
    exact div_nonneg (mul_nonneg (zero_lt_one.trans hT).le (Real.log_pos hT).le) (by positivity)
  have hcoarse : ∀ᶠ T : ℝ in atTop, ∃ e : ℝ, HasSum (fun ρ : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T ρ*‖mollified T ρ‖^2) e ∧ e ≤ 100*TMA.Dsc T := by
    filter_upwards [h₂,hD] with T ⟨e,he,h⟩ hd
    exact ⟨e,he,h.trans (mul_le_mul_of_nonneg_right (by norm_num) hd)⟩
  have hx := ReflectedFull.full_mixed hRH w hw hcoarse
  have hp := shifted hRH w.toHeightWeight (q:=106/25) (by norm_num) shift (show (0:ℝ)<1/10^7 by norm_num)
  apply reflected_of_combined hRH w.toHeightWeight hw
  filter_upwards [hp,hx,h₁,h₂,hD] with T ⟨p,hp,hp'⟩ ⟨x,hx,hx'⟩ ⟨m,hm,hm'⟩ ⟨e,he,he'⟩ hd
  let Q := shift^2+energy (106/25)+2*shift*mean (106/25)
  have hQ : 0 ≤ Q := by norm_num [Q,shift,energy,mean,pairing,energyU,centerY,centerU,lengthExponent,h,PrincipalBand.topExponent]
  have hp'' := hp'.trans (mul_le_mul_of_nonneg_right (add_le_add (mul_le_mul_of_nonneg_right hw hQ) (le_refl (1/10^7))) hd)
  have hk := BHB.Final.one_le_kap1 w.toHeightWeight
  have hc := ReflectedStrip.strip_constants.2.2.2.1
  rw [hc] at hx'
  have hnum : w.kap1*(-4236069844353080179049781630795428298290236614697328799841/
      29940030000000000000000000000000000000000000000000000000000)+11/1000000 ≤ (-4236069844353080179049781630795428298290236614697328799841 /
      29940030000000000000000000000000000000000000000000000000000 + 11/1000000) := by linarith only [hk]
  have hx'' := hx'.trans (mul_le_mul_of_nonneg_right hnum hd)
  let C : ℝ := 2*0.397664*shift/8
  have hC : 0 ≤ C := by norm_num [C,shift,centerY,centerU,lengthExponent]
  have bound : (1/64)*((1+1/10^7)*Q+1/10^7)+0.397664^2*0.948026-
      C*0.8149998+(2*0.397664/8)*(-4236069844353080179049781630795428298290236614697328799841 /
      29940030000000000000000000000000000000000000000000000000000 + 11/1000000) ≤ 0.1252966399530 := by
    norm_num [C,Q,shift,energy,mean,pairing,energyU,centerY,centerU,lengthExponent,h,PrincipalBand.topExponent]
  refine ⟨_,((((hp.mul_left (1/64)).add (he.mul_left (0.397664^2))).sub (hm.mul_left C)).add
    (hx.mul_left (2*0.397664/8))).congr_fun (fun ρ => ?_),?_⟩
  · rw [combined,expand]
    push_cast
    rw [show h=(0.999:ℝ) by norm_num [h,PrincipalBand.topExponent]]
    dsimp only [C]; ring
  · change (1/64)*p+0.397664^2*e-C*m+(2*0.397664/8)*x ≤ _
    have hneg := mul_le_mul_of_nonneg_left hm' hC
    linarith only [hp'',he',hneg,hx'',mul_le_mul_of_nonneg_right bound hd]

end ReflectedMoments
end
end Src_ReflectedMoments

section Src_Taper78FirstMoment


/- The normalized first moment for the 85.39 percent certificate. -/
noncomputable section
open Filter ShortProbe ShortProbe.RealResidual
#retaper BHB.Red.norm_deriv_mul_Bmol_le BHB.Red.summable_S1 BHB.Red.summable_S2

namespace ReflectedMoments
theorem first_78 (hRH : RiemannHypothesis) (w : BHB.Weight) :
    ∀ᶠ T : ℝ in atTop, ∃ m : ℝ, HasSum (fun z : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T z*(mollified T z).re) m ∧ 0.8149998*TMA.Dsc T ≤ m := by
  let θ := lengthExponent
  have hθ : 0 < θ := by norm_num [θ,lengthExponent]
  have hθ' : θ < 1/2 := by norm_num [θ,lengthExponent]
  let ε : ℝ := 1/10^8
  let δ := ε/(6*Real.pi)
  have hδ : 0 < δ := by dsimp [δ,ε]; positivity
  filter_upwards [eventually_ge_atTop (2:ℝ),
    eventually_atTop.mpr (Taper78.BHB.S1_reduction hRH w hθ hθ' δ hδ),
    eventually_atTop.mpr (Taper78.BHB.Lin1_sub_Main1 w hθ hθ' δ hδ),
    eventually_atTop.mpr (Taper78.BHB.Main1_asymp hRH w hθ hθ' δ hδ)] with T hT h₁ h₂ h₃
  have hL : 0 < Real.log T := Real.log_pos (by linarith)
  have hD : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg (by linarith) hL.le) (by positivity)
  have hπ := Real.pi_pos
  have negRe (z y : ℂ) : y.re-z.re ≤ ‖z-y‖ := by simpa [norm_sub_rev z y] using Complex.re_le_norm (y-z)
  have hm : (Taper78.BHB.c1 θ*w.kap1-ε)*TMA.Dsc T ≤ (Taper78.BHB.S1 w.h θ T).re/Real.log T := by
    have a := (negRe _ _).trans h₁
    have b := (negRe _ _).trans h₂
    have c := (negRe _ _).trans h₃
    rw [Complex.ofReal_re] at c
    apply (le_div_iff₀ hL).mpr
    dsimp [δ] at a b c
    unfold TMA.Dsc
    field_simp at a b c ⊢
    nlinarith
  refine ⟨_,((Complex.hasSum_re (Taper78.BHB.Red.summable_S1 hRH w hθ hT).hasSum).div_const (Real.log T)).congr_fun ?_,
      (mul_le_mul_of_nonneg_right ?_ hD).trans hm⟩
  · intro z
    have det : mollified T z = (deriv riemannZeta z * Taper78.BHB.Bmol θ T z)/(Real.log T:ℂ) := by
      rw [← LowBand.molP_taper78]
      unfold LowBand.molP
      change _ * Taper78.BHB.Bmol θ T z = _
      ring
    rw [det,Complex.div_ofReal_re]
    simp only [TMA.cw,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,Complex.natCast_re,
      Complex.natCast_im,mul_zero,zero_mul,sub_zero]
    ring
  · have hk := BHB.Final.one_le_kap1 w.toHeightWeight
    norm_num [Taper78.BHB.c1,θ,lengthExponent,ε]
    linarith only [hk]

theorem score_of_second_78 (hRH : RiemannHypothesis) (w : BHB.Weight) (hw : w.kap1 ≤ 1+1/10^7)
    (h₂ : ∀ᶠ T : ℝ in atTop, ∃ e : ℝ, HasSum (fun z : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T z*‖mollified T z‖^2) e ∧ e ≤ 0.948026*TMA.Dsc T) :
    Dyadic (85390845089/100000000000) ∧ Cumulative (85390845089/100000000000) :=
  score_8539 hRH w hw (first_78 hRH w) h₂
end ReflectedMoments
#print axioms ReflectedMoments.score_of_second_78
end
end Src_Taper78FirstMoment

section Src_GeneralDiagonal


/-! The Bui–Heath-Brown gcd-diagonal estimate for any twice continuously
differentiable mollifier polynomial (or smooth taper) vanishing at zero.
The arithmetic lemmas are from BHB.MainT2.Diag. The proof of the monomial
asymptotic below adapts that module, with the taper exposed as an argument. -/

noncomputable section
open MeasureTheory
open scoped BigOperators ArithmeticFunction ArithmeticFunction.Moebius Nat Real
namespace BHB.M2.GeneralDiagonal
open BHB.MT

structure Taper where
  val : ℝ → ℝ
  smooth : ContDiff ℝ 2 val
  atZero : val 0 = 0

variable (P : Taper)

def Q (r : ℕ) (x : ℝ) := P.val x*(1-x)^r
def differential (r : ℕ) (u : ℝ) :=
  -(deriv P.val (1-u))*u^r+P.val (1-u)*(r*u^(r-1))
def monomial (θ T : ℝ) (r₁ r₂ r₃ : ℕ) : ℝ :=
  ∑ k₁ ∈ Krange θ T, ∑ k₂ ∈ Krange θ T,
    LowBand.bcoefP P.val θ T k₁ * LowBand.bcoefP P.val θ T k₂ * ((Nat.gcd k₁ k₂ : ℝ) / ((k₁ : ℝ) * k₂))
      * (Real.log k₁ / Real.log (ymol θ T)) ^ r₁ * (Real.log k₂ / Real.log (ymol θ T)) ^ r₂
      * (Real.log (Nat.gcd k₁ k₂) / Real.log (ymol θ T)) ^ r₃

theorem c1_differential (r : ℕ) : ContDiff ℝ 1 (differential P r) := by
  have h1 : ContDiff ℝ 1 P.val := P.smooth.of_le (by norm_num)
  have hd : ContDiff ℝ 1 (deriv P.val) := P.smooth.deriv'
  unfold differential
  fun_prop

theorem derivative_Q (r : ℕ) (x : ℝ) : HasDerivAt (Q P r) (-differential P r (1-x)) x := by
  have h := (P.smooth.differentiable (by norm_num) x).hasDerivAt.mul
    (((hasDerivAt_const x (1:ℝ)).sub (hasDerivAt_id' x)).pow r)
  apply h.congr_deriv
  simp only [differential,sub_sub_cancel,Pi.pow_apply,Pi.sub_apply]
  ring

theorem Q_zero (r : ℕ) : Q P r 0=0 := by simp [Q,P.atZero]

theorem c2_Q (r : ℕ) : ContDiff ℝ 2 (Q P r) := by
  have h := P.smooth
  unfold Q
  fun_prop

theorem derivative (r : ℕ) (x : ℝ) : deriv (Q P r) x = -differential P r (1-x) :=
  (derivative_Q P r x).deriv

theorem Qr_bound : ∃ B : ℝ, 0 ≤ B ∧ ∀ r : ℕ, r ≤ 3 → ∀ x ∈ Set.Icc (0 : ℝ) 1,
    |Q P r x| + |deriv (Q P r) x| + |deriv (deriv (Q P r)) x| ≤ B := by
  obtain ⟨B, hB0, hB⟩ := DG.exists_bound_Icc (Finset.range 4)
    (fun r x => |Q P r x| + |deriv (Q P r) x| + |deriv (deriv (Q P r)) x|) (fun r _ => by
      have h2 := c2_Q P r
      have h1 : ContDiff ℝ 1 (deriv (Q P r)) := h2.deriv'
      have c0 : Continuous (Q P r) := h2.continuous
      have c1 : Continuous (deriv (Q P r)) := h1.continuous
      have c2 : Continuous (deriv (deriv (Q P r))) := h1.continuous_deriv_one
      exact ((continuous_abs.comp c0).add (continuous_abs.comp c1)).add (continuous_abs.comp c2))
  refine ⟨B, hB0, fun r hr x hx => ?_⟩
  exact (le_abs_self _).trans (hB r (Finset.mem_range.mpr (by omega)) x hx)

theorem dF_bound : ∃ B : ℝ, 0 ≤ B ∧ ∀ r₁ r₂ r₃ : ℕ, r₁ ≤ 3 → r₂ ≤ 3 → r₃ ≤ 3 →
    ContDiff ℝ 1 (fun u : ℝ => differential P r₁ u * differential P r₂ u * u ^ r₃) ∧
    ∀ u ∈ Set.Icc (0 : ℝ) 1, |differential P r₁ u| ≤ B ∧
      |deriv (fun u : ℝ => differential P r₁ u * differential P r₂ u * u ^ r₃) u| ≤ B := by
  have hcd : ∀ r₁ r₂ r₃ : ℕ, ContDiff ℝ 1 (fun u : ℝ => differential P r₁ u * differential P r₂ u * u ^ r₃) :=
    fun r₁ r₂ r₃ => ((c1_differential P r₁).mul (c1_differential P r₂)).mul (contDiff_id.pow r₃)
  obtain ⟨B, hB0, hB⟩ := DG.exists_bound_Icc
    (Finset.range 4 ×ˢ Finset.range 4 ×ˢ Finset.range 4)
    (fun i u => |differential P i.1 u| + |deriv (fun u : ℝ => differential P i.1 u * differential P i.2.1 u * u ^ i.2.2) u|)
    (fun i _ => (continuous_abs.comp (c1_differential P i.1).continuous).add
      (continuous_abs.comp (hcd i.1 i.2.1 i.2.2).continuous_deriv_one))
  refine ⟨B, hB0, fun r₁ r₂ r₃ h1 h2 h3 => ⟨hcd r₁ r₂ r₃, fun u hu => ?_⟩⟩
  have hmem : (r₁, r₂, r₃) ∈ Finset.range 4 ×ˢ Finset.range 4 ×ˢ Finset.range 4 := by
    simp only [Finset.mem_product, Finset.mem_range]
    omega
  have h := (le_abs_self _).trans (hB (r₁, r₂, r₃) hmem u hu)
  have ha := abs_nonneg (differential P r₁ u)
  have hb := abs_nonneg (deriv (fun u : ℝ => differential P r₁ u * differential P r₂ u * u ^ r₃) u)
  exact ⟨by linarith, by linarith⟩

theorem bcoef_mul_pow {θ T : ℝ} (hθ : 0 < θ) (hT : 1 < T) {k : ℕ} (hk : k ∈ Krange θ T) (r : ℕ) :
    LowBand.bcoefP P.val θ T k * (Real.log k / Real.log (ymol θ T)) ^ r
      = (μ k : ℝ) * Q P r (Real.log (ymol θ T / k) / Real.log (ymol θ T)) := by
  have hk1 : 1 ≤ k := (mem_Krange.mp hk).1
  have hk0 : (0 : ℝ) < k := by exact_mod_cast hk1
  have hy : 0 < ymol θ T := ymol_pos (by linarith) θ
  have hly : 0 < Real.log (ymol θ T) := by
    rw [log_ymol (by linarith) θ]
    exact mul_pos hθ (Real.log_pos hT)
  have e : 1 - Real.log (ymol θ T / k) / Real.log (ymol θ T)
      = Real.log k / Real.log (ymol θ T) := by
    rw [Real.log_div hy.ne' hk0.ne', sub_div, div_self hly.ne']
    ring
  unfold LowBand.bcoefP Q
  rw [e]
  ring

theorem Smono_eq {θ T : ℝ} (hθ : 0 < θ) (hT : 1 < T) (r₁ r₂ r₃ : ℕ) :
    monomial P θ T r₁ r₂ r₃ = ∑ n ∈ Krange θ T,
      (μ n : ℝ) ^ 2 * psiG (fun d => (Real.log d / Real.log (ymol θ T)) ^ r₃) n / (n : ℝ) ^ 2
        * LLsum (Q P r₁) (ymol θ T) n n 0 * LLsum (Q P r₂) (ymol θ T) n n 0 := by
  have hy : 0 < ymol θ T := ymol_pos (by linarith) θ
  have h := gcd_sum_eq ⌊ymol θ T⌋₊
    (fun k => Q P r₁ (Real.log (ymol θ T / k) / Real.log (ymol θ T)))
    (fun k => Q P r₂ (Real.log (ymol θ T / k) / Real.log (ymol θ T)))
    (fun d => (Real.log d / Real.log (ymol θ T)) ^ r₃)
  have h1 : monomial P θ T r₁ r₂ r₃ = ∑ k₁ ∈ Finset.Icc 1 ⌊ymol θ T⌋₊, ∑ k₂ ∈ Finset.Icc 1 ⌊ymol θ T⌋₊,
      (μ k₁ : ℝ) * (μ k₂ : ℝ) * ((Nat.gcd k₁ k₂ : ℝ) / ((k₁ : ℝ) * k₂))
        * Q P r₁ (Real.log (ymol θ T / k₁) / Real.log (ymol θ T))
        * Q P r₂ (Real.log (ymol θ T / k₂) / Real.log (ymol θ T))
        * (Real.log (Nat.gcd k₁ k₂) / Real.log (ymol θ T)) ^ r₃ := by
    unfold monomial
    refine Finset.sum_congr rfl fun k₁ hk₁ => Finset.sum_congr rfl fun k₂ hk₂ => ?_
    have e1 := bcoef_mul_pow P hθ hT hk₁ r₁
    have e2 := bcoef_mul_pow P hθ hT hk₂ r₂
    linear_combination
      (LowBand.bcoefP P.val θ T k₂ * (Real.log k₂ / Real.log (ymol θ T)) ^ r₂
          * ((Nat.gcd k₁ k₂ : ℝ) / ((k₁ : ℝ) * k₂))
          * (Real.log (Nat.gcd k₁ k₂) / Real.log (ymol θ T)) ^ r₃) * e1
      + ((μ k₁ : ℝ) * Q P r₁ (Real.log (ymol θ T / k₁) / Real.log (ymol θ T))
          * ((Nat.gcd k₁ k₂ : ℝ) / ((k₁ : ℝ) * k₂))
          * (Real.log (Nat.gcd k₁ k₂) / Real.log (ymol θ T)) ^ r₃) * e2
  rw [h1, h]
  refine Finset.sum_congr rfl fun n hn => ?_
  have hn1 : 1 ≤ n := (Finset.mem_Icc.mp hn).1
  rw [Tsum_eq_LLsum (Q P r₁) hy.le hn1, Tsum_eq_LLsum (Q P r₂) hy.le hn1]

theorem LLsum_Qr {C₀ : ℝ} (hM : MobiusHyp C₀) : ∃ A : ℝ, 0 ≤ A ∧ ∀ y : ℝ, 2 ≤ y →
    ∀ n : ℕ, 1 ≤ n → (n : ℝ) ≤ y → ∀ r : ℕ, r ≤ 3 →
      |LLsum (Q P r) y n n 0 + (n : ℝ) / φ n * differential P r (Real.log n / Real.log y) / Real.log y|
        ≤ A * mobiusF (1 / 32) n
          * (((n : ℝ) / y) ^ (1 / 32 : ℝ) / Real.log y + 1 / Real.log y ^ 2) := by
  obtain ⟨A, hA⟩ := LLsum_asymp hM
  obtain ⟨B, hB0, hB⟩ := Qr_bound P
  refine ⟨|A| * B, by positivity, fun y hy n hn hny r hr => ?_⟩
  have hn0 : (0 : ℝ) < n := by exact_mod_cast hn
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hy0 : 0 < y := by linarith
  have hly : 0 < Real.log y := Real.log_pos (by linarith)
  have h := (hA (Q P r) B (c2_Q P r) (Q_zero P r) (hB r hr) y hy n hn1 hny n hn).1
  have e : 1 - Real.log (y / n) / Real.log y = Real.log n / Real.log y := by
    rw [Real.log_div hy0.ne' hn0.ne', sub_div, div_self hly.ne']
    ring
  rw [derivative P, e] at h
  have hF : 0 < mobiusF (1 / 32) n := mobiusF_pos (by norm_num) n
  have hE : 0 ≤ ((n : ℝ) / y) ^ (1 / 32 : ℝ) / Real.log y + 1 / Real.log y ^ 2 :=
    add_nonneg (div_nonneg (Real.rpow_nonneg (div_nonneg hn0.le hy0.le) _) hly.le) (by positivity)
  have e2 : LLsum (Q P r) y n n 0 + n / φ n * differential P r (Real.log n / Real.log y) / Real.log y
      = LLsum (Q P r) y n n 0 - n / φ n * (-differential P r (Real.log n / Real.log y)) / Real.log y := by
    ring
  rw [e2]
  refine h.trans ?_
  have hAB : A * B ≤ |A| * B := mul_le_mul_of_nonneg_right (le_abs_self A) hB0
  exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hAB hF.le) hE

theorem main_sum : ∃ C : ℝ, ∀ y : ℝ, 2 ≤ y → ∀ r₁ r₂ r₃ : ℕ, r₁ ≤ 3 → r₂ ≤ 3 → r₃ ≤ 3 →
    |∑ n ∈ Finset.Icc 1 ⌊y⌋₊, (μ n : ℝ) ^ 2 / φ n
          * (differential P r₁ (Real.log n / Real.log y) * differential P r₂ (Real.log n / Real.log y)
            * (Real.log n / Real.log y) ^ r₃)
        - Real.log y * ∫ u in (0 : ℝ)..1, differential P r₁ u * differential P r₂ u * u ^ r₃| ≤ C := by
  obtain ⟨A, hA0, hA⟩ := sum_sqfree_C1
  obtain ⟨B, hB0, hB⟩ := dF_bound P
  refine ⟨A * (B * B + B), fun y hy r₁ r₂ r₃ h1 h2 h3 => ?_⟩
  have hy0 : 0 < y := by linarith
  have hly : 0 < Real.log y := Real.log_pos (by linarith)
  obtain ⟨hcd, hbd⟩ := hB r₁ r₂ r₃ h1 h2 h3
  obtain ⟨-, hbd2⟩ := hB r₂ r₁ r₃ h2 h1 h3
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ℝ → ℝ, Ψ = fun u : ℝ => differential P r₁ u * differential P r₂ u * u ^ r₃ := ⟨_, rfl⟩
  rw [← hΨ] at hcd hbd
  have hΨa : ∀ u : ℝ, differential P r₁ u * differential P r₂ u * u ^ r₃ = Ψ u := fun u => by rw [hΨ]
  simp only [hΨa]
  have hGc : ContDiff ℝ 1 (fun v : ℝ => Ψ (v / Real.log y)) :=
    hcd.comp (contDiff_id.div_const _)
  have h := hA (fun v : ℝ => Ψ (v / Real.log y)) hGc (Real.log y) hly.le
  rw [Real.exp_log hy0] at h
  -- the integral
  have hint : ∫ s in (0 : ℝ)..Real.log y, Ψ (s / Real.log y)
      = Real.log y * ∫ u in (0 : ℝ)..1, Ψ u := by
    have := intervalIntegral.integral_comp_div (a := 0) (b := Real.log y) (f := Ψ) hly.ne'
    rw [zero_div, div_self hly.ne', smul_eq_mul] at this
    exact this
  -- the value at the endpoint
  have h1m : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
  have hG1 : |Ψ (Real.log y / Real.log y)| ≤ B * B := by
    rw [div_self hly.ne', hΨ]
    show |differential P r₁ 1 * differential P r₂ 1 * 1 ^ r₃| ≤ B * B
    rw [one_pow, mul_one, abs_mul]
    exact mul_le_mul (hbd 1 h1m).1 (hbd2 1 h1m).1 (abs_nonneg _) hB0
  -- the derivative
  have hdG : ∀ s : ℝ, deriv (fun v : ℝ => Ψ (v / Real.log y)) s
      = deriv Ψ (s / Real.log y) / Real.log y := by
    intro s
    have hΨd : HasDerivAt Ψ (deriv Ψ (s / Real.log y)) (s / Real.log y) :=
      (hcd.differentiable one_ne_zero _).hasDerivAt
    have hin : HasDerivAt (fun v : ℝ => v / Real.log y) (1 / Real.log y) s :=
      (hasDerivAt_id' s).div_const _
    have hc := hΨd.comp s hin
    have e : (fun v : ℝ => Ψ (v / Real.log y)) = Ψ ∘ fun v : ℝ => v / Real.log y := rfl
    rw [e, hc.deriv]
    ring
  have hint2 : ∫ s in (0 : ℝ)..Real.log y, |deriv (fun v : ℝ => Ψ (v / Real.log y)) s| ≤ B := by
    have hb : ∀ s ∈ Set.uIoc (0 : ℝ) (Real.log y),
        ‖|deriv (fun v : ℝ => Ψ (v / Real.log y)) s|‖ ≤ B / Real.log y := by
      intro s hs
      rw [Set.uIoc_of_le hly.le] at hs
      rw [Real.norm_eq_abs, abs_abs, hdG, abs_div, abs_of_pos hly]
      have hmem : s / Real.log y ∈ Set.Icc (0 : ℝ) 1 :=
        ⟨div_nonneg hs.1.le hly.le, (div_le_one hly).mpr hs.2⟩
      exact div_le_div_of_nonneg_right (hbd _ hmem).2 hly.le
    have hn := intervalIntegral.norm_integral_le_of_norm_le_const hb
    rw [sub_zero, abs_of_pos hly, div_mul_cancel₀ _ hly.ne', Real.norm_eq_abs] at hn
    exact (le_abs_self _).trans hn
  rw [hint] at h
  calc _ ≤ A * (|Ψ (Real.log y / Real.log y)|
          + ∫ s in (0 : ℝ)..Real.log y, |deriv (fun v : ℝ => Ψ (v / Real.log y)) s|) := h
    _ ≤ A * (B * B + B) := mul_le_mul_of_nonneg_left (add_le_add hG1 hint2) hA0

theorem term_sub_main_le {C₀ : ℝ} (hM : MobiusHyp C₀) : ∃ C : ℝ, ∀ y : ℝ, 3 ≤ y →
    ∀ n : ℕ, Squarefree n → (n : ℝ) ≤ y → ∀ r₁ r₂ r₃ : ℕ, r₁ ≤ 3 → r₂ ≤ 3 → r₃ ≤ 3 →
      |psiG (fun d => (Real.log d / Real.log y) ^ r₃) n / (n : ℝ) ^ 2
            * LLsum (Q P r₁) y n n 0 * LLsum (Q P r₂) y n n 0
          - 1 / (φ n : ℝ) * (differential P r₁ (Real.log n / Real.log y) * differential P r₂ (Real.log n / Real.log y)
              * (Real.log n / Real.log y) ^ r₃) / Real.log y ^ 2|
        ≤ C * (tw n / n) * (((n : ℝ) / y) ^ (1 / 32 : ℝ) / Real.log y ^ 2 + 1 / Real.log y ^ 3
          + 1 / Real.log y ^ 3 * ∑ p ∈ n.primeFactors, Real.log p / p) := by
  obtain ⟨A, hA0, hA⟩ := LLsum_Qr P hM
  obtain ⟨B, hB0, hB⟩ := dF_bound P
  refine ⟨3 * B ^ 2 + 2 * A * B + 2 * A ^ 2, fun y hy n hn hny r₁ r₂ r₃ h1 h2 h3 => ?_⟩
  have hn1 : 1 ≤ n := Nat.pos_of_ne_zero hn.ne_zero
  have hn0 : (0 : ℝ) < n := by exact_mod_cast hn1
  have hy0 : 0 < y := by linarith
  have hly : 1 ≤ Real.log y := one_le_log hy
  have hφ : (0 : ℝ) < φ n := by exact_mod_cast Nat.totient_pos.mpr hn1
  have hw : Real.log n / Real.log y ∈ Set.Icc (0 : ℝ) 1 :=
    ⟨div_nonneg (Real.log_nonneg (by exact_mod_cast hn1)) (by linarith),
      (div_le_one (by linarith)).mpr (Real.log_le_log hn0 hny)⟩
  have ht₁ := ((hB r₁ r₂ r₃ h1 h2 h3).2 _ hw).1
  have ht₂ := ((hB r₂ r₁ r₃ h2 h1 h3).2 _ hw).1
  have hT₁ := hA y (by linarith) n hn1 hny r₁ h1
  have hT₂ := hA y (by linarith) n hn1 hny r₂ h2
  obtain ⟨hρ, hψ⟩ := psi_approx (by linarith : (2 : ℝ) ≤ y) hn hny h3
  have hx0 : 0 ≤ ((n : ℝ) / y) ^ (1 / 32 : ℝ) := Real.rpow_nonneg (div_nonneg hn0.le hy0.le) _
  have hx1 : ((n : ℝ) / y) ^ (1 / 32 : ℝ) ≤ 1 :=
    Real.rpow_le_one (div_nonneg hn0.le hy0.le) ((div_le_one hy0).mpr hny) (by norm_num)
  have hσ : 0 ≤ ∑ d ∈ n.divisors, (d : ℝ) := Finset.sum_nonneg fun d _ => Nat.cast_nonneg d
  have hSp : 0 ≤ ∑ p ∈ n.primeFactors, Real.log p / p := Finset.sum_nonneg fun p _ =>
    div_nonneg (Real.log_natCast_nonneg p) (Nat.cast_nonneg p)
  have hT₁' : |LLsum (Q P r₁) y n n 0
      + (n : ℝ) / φ n * differential P r₁ (Real.log n / Real.log y) / Real.log y|
      ≤ A * mobiusF (1 / 32) n
        * (((n : ℝ) / y) ^ (1 / 32 : ℝ) / Real.log y + 1 / Real.log y ^ 2) := hT₁
  have core := DG.term_core (ψ := psiG (fun d => (Real.log d / Real.log y) ^ r₃) n)
    (w := (Real.log n / Real.log y) ^ r₃) (T₁ := LLsum (Q P r₁) y n n 0)
    (T₂ := LLsum (Q P r₂) y n n 0) hn0 hφ rfl (one_le_div_totient hn1)
    (one_le_mobiusF (by norm_num) n) hσ hly hA0 hB0 ht₁ ht₂ hx0 hx1 rfl hT₁ hT₂ hSp hρ hψ
  have etw : tw n / n = (∑ d ∈ n.divisors, (d : ℝ)) / n * ((n : ℝ) / φ n) ^ 2
      * mobiusF (1 / 32) n ^ 2 / n := by
    unfold tw
    rw [DG.sum_divisors_inv hn1]
  rw [etw]
  exact core

theorem Smono_asymp {C₀ : ℝ} (hM : MobiusHyp C₀) {θ : ℝ} (hθ : 0 < θ) : ∃ C T₀ : ℝ,
    ∀ T : ℝ, T₀ ≤ T → ∀ r₁ r₂ r₃ : ℕ, r₁ ≤ 3 → r₂ ≤ 3 → r₃ ≤ 3 →
      |monomial P θ T r₁ r₂ r₃
          - 1 / Real.log (ymol θ T) * ∫ u in (0 : ℝ)..1, differential P r₁ u * differential P r₂ u * u ^ r₃|
        ≤ C / Real.log (ymol θ T) ^ 2 := by
  obtain ⟨C, hC⟩ := term_sub_main_le P hM
  obtain ⟨C₁, hC₁⟩ := sum_tw_rpow_le
  obtain ⟨C₂, hC₂⟩ := sum_tw_le
  obtain ⟨C₃, hC₃⟩ := sum_tw_additive_le
  obtain ⟨C₄, hC₄⟩ := main_sum P
  refine ⟨|C| * (|C₁| + 2 * |C₂| + 2 * |C₃|) + |C₄|, max 3 ((3 : ℝ) ^ (1 / θ)),
    fun T hT r₁ r₂ r₃ h1 h2 h3 => ?_⟩
  have hT3 : 3 ≤ T := le_trans (le_max_left _ _) hT
  have hT1 : 1 < T := by linarith
  have hy3 : 3 ≤ ymol θ T := by
    unfold ymol
    calc (3 : ℝ) = ((3 : ℝ) ^ (1 / θ)) ^ θ := by
          rw [← Real.rpow_mul (by norm_num), one_div, inv_mul_cancel₀ hθ.ne', Real.rpow_one]
      _ ≤ T ^ θ := Real.rpow_le_rpow (by positivity) (le_trans (le_max_right _ _) hT) hθ.le
  rw [Smono_eq P hθ hT1]
  unfold Krange
  obtain ⟨y, hy⟩ : ∃ y : ℝ, y = ymol θ T := ⟨_, rfl⟩
  rw [← hy] at hy3 ⊢
  have hy2 : (2 : ℝ) ≤ y := by linarith
  have hy0 : 0 < y := by linarith
  have hly : 1 ≤ Real.log y := one_le_log hy3
  have hly0 : 0 < Real.log y := by linarith
  obtain ⟨I, hI⟩ : ∃ I : ℝ, I = ∫ u in (0 : ℝ)..1, differential P r₁ u * differential P r₂ u * u ^ r₃ := ⟨_, rfl⟩
  rw [← hI]
  have hmain := hC₄ y hy2 r₁ r₂ r₃ h1 h2 h3
  rw [← hI] at hmain
  -- the three error sums
  have hS₁ := hC₁ y hy2
  have hS₂ := hC₂ y hy2
  have hS₃ := hC₃ y hy2
  obtain ⟨S₁, hS₁d⟩ : ∃ S : ℝ, S = ∑ n ∈ Finset.Icc 1 ⌊y⌋₊,
      (μ n : ℝ) ^ 2 * tw n / n * ((n : ℝ) / y) ^ (1 / 32 : ℝ) := ⟨_, rfl⟩
  obtain ⟨S₂, hS₂d⟩ : ∃ S : ℝ, S = ∑ n ∈ Finset.Icc 1 ⌊y⌋₊, (μ n : ℝ) ^ 2 * tw n / n := ⟨_, rfl⟩
  obtain ⟨S₃, hS₃d⟩ : ∃ S : ℝ, S = ∑ n ∈ Finset.Icc 1 ⌊y⌋₊,
      (μ n : ℝ) ^ 2 * tw n / n * ∑ p ∈ n.primeFactors, Real.log p / p := ⟨_, rfl⟩
  rw [← hS₁d] at hS₁
  rw [← hS₂d] at hS₂
  rw [← hS₃d] at hS₃
  obtain ⟨Sm, hSmd⟩ : ∃ S : ℝ, S = ∑ n ∈ Finset.Icc 1 ⌊y⌋₊, (μ n : ℝ) ^ 2 / φ n
      * (differential P r₁ (Real.log n / Real.log y) * differential P r₂ (Real.log n / Real.log y)
        * (Real.log n / Real.log y) ^ r₃) := ⟨_, rfl⟩
  rw [← hSmd] at hmain
  -- the difference of the sum and its main part, term by term
  have hterm : ∀ n ∈ Finset.Icc 1 ⌊y⌋₊,
      |(μ n : ℝ) ^ 2 * (psiG (fun d => (Real.log d / Real.log y) ^ r₃) n / (n : ℝ) ^ 2
            * LLsum (Q P r₁) y n n 0 * LLsum (Q P r₂) y n n 0
          - 1 / (φ n : ℝ) * (differential P r₁ (Real.log n / Real.log y) * differential P r₂ (Real.log n / Real.log y)
              * (Real.log n / Real.log y) ^ r₃) / Real.log y ^ 2)|
        ≤ |C| * ((μ n : ℝ) ^ 2 * tw n / n * ((n : ℝ) / y) ^ (1 / 32 : ℝ) / Real.log y ^ 2
          + (μ n : ℝ) ^ 2 * tw n / n / Real.log y ^ 3
          + (μ n : ℝ) ^ 2 * tw n / n * (∑ p ∈ n.primeFactors, Real.log p / p)
            / Real.log y ^ 3) := by
    intro n hn
    have hn1 : 1 ≤ n := (Finset.mem_Icc.mp hn).1
    have hn0 : (0 : ℝ) < n := by exact_mod_cast hn1
    have hny : (n : ℝ) ≤ y := (Nat.le_floor_iff hy0.le).mp (Finset.mem_Icc.mp hn).2
    by_cases hsq : Squarefree n
    · rw [TA.moebius_sq_of_squarefree hsq, one_mul]
      refine (hC y hy3 n hsq hny r₁ r₂ r₃ h1 h2 h3).trans ?_
      have htw0 : 0 ≤ tw n / n := div_nonneg (DG.tw_nonneg n) hn0.le
      have hSp : 0 ≤ ∑ p ∈ n.primeFactors, Real.log p / p := Finset.sum_nonneg fun p _ =>
        div_nonneg (Real.log_natCast_nonneg p) (Nat.cast_nonneg p)
      have hx0 : 0 ≤ ((n : ℝ) / y) ^ (1 / 32 : ℝ) :=
        Real.rpow_nonneg (div_nonneg hn0.le hy0.le) _
      have hE : 0 ≤ ((n : ℝ) / y) ^ (1 / 32 : ℝ) / Real.log y ^ 2 + 1 / Real.log y ^ 3
          + 1 / Real.log y ^ 3 * ∑ p ∈ n.primeFactors, Real.log p / p := by positivity
      calc C * (tw n / n) * (((n : ℝ) / y) ^ (1 / 32 : ℝ) / Real.log y ^ 2 + 1 / Real.log y ^ 3
            + 1 / Real.log y ^ 3 * ∑ p ∈ n.primeFactors, Real.log p / p)
          ≤ |C| * (tw n / n) * (((n : ℝ) / y) ^ (1 / 32 : ℝ) / Real.log y ^ 2
            + 1 / Real.log y ^ 3
            + 1 / Real.log y ^ 3 * ∑ p ∈ n.primeFactors, Real.log p / p) :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self C) htw0) hE
        _ = _ := by ring
    · rw [TA.moebius_sq_of_not_squarefree hsq]
      simp
  have hsum : |∑ n ∈ Finset.Icc 1 ⌊y⌋₊,
        (μ n : ℝ) ^ 2 * (psiG (fun d => (Real.log d / Real.log y) ^ r₃) n / (n : ℝ) ^ 2
            * LLsum (Q P r₁) y n n 0 * LLsum (Q P r₂) y n n 0
          - 1 / (φ n : ℝ) * (differential P r₁ (Real.log n / Real.log y) * differential P r₂ (Real.log n / Real.log y)
              * (Real.log n / Real.log y) ^ r₃) / Real.log y ^ 2)|
      ≤ |C| * (S₁ / Real.log y ^ 2 + S₂ / Real.log y ^ 3 + S₃ / Real.log y ^ 3) := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans ((Finset.sum_le_sum hterm).trans (le_of_eq ?_))
    rw [← Finset.mul_sum, Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.sum_div,
      ← Finset.sum_div, ← Finset.sum_div, ← hS₁d, ← hS₂d, ← hS₃d]
  -- the sum is the difference plus the main part
  have hdecomp : ∑ n ∈ Finset.Icc 1 ⌊y⌋₊,
        (μ n : ℝ) ^ 2 * psiG (fun d => (Real.log d / Real.log y) ^ r₃) n / (n : ℝ) ^ 2
          * LLsum (Q P r₁) y n n 0 * LLsum (Q P r₂) y n n 0
      = ∑ n ∈ Finset.Icc 1 ⌊y⌋₊,
        (μ n : ℝ) ^ 2 * (psiG (fun d => (Real.log d / Real.log y) ^ r₃) n / (n : ℝ) ^ 2
            * LLsum (Q P r₁) y n n 0 * LLsum (Q P r₂) y n n 0
          - 1 / (φ n : ℝ) * (differential P r₁ (Real.log n / Real.log y) * differential P r₂ (Real.log n / Real.log y)
              * (Real.log n / Real.log y) ^ r₃) / Real.log y ^ 2)
        + Sm / Real.log y ^ 2 := by
    rw [hSmd, Finset.sum_div, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun n _ => ?_
    ring
  rw [hdecomp]
  -- sizes
  have hl2 : 0 < Real.log y ^ 2 := by positivity
  have hl3 : 0 < Real.log y ^ 3 := by positivity
  have hb₁ : S₁ / Real.log y ^ 2 ≤ |C₁| / Real.log y ^ 2 :=
    div_le_div_of_nonneg_right (hS₁.trans (le_abs_self _)) hl2.le
  have h1ly : (1 + Real.log y) / Real.log y ^ 3 ≤ 2 / Real.log y ^ 2 := by
    rw [div_le_div_iff₀ hl3 hl2]
    nlinarith [mul_pos hl2 hly0, mul_nonneg hl2.le (by linarith : (0 : ℝ) ≤ Real.log y - 1)]
  have hb₂ : S₂ / Real.log y ^ 3 ≤ 2 * |C₂| / Real.log y ^ 2 := by
    calc S₂ / Real.log y ^ 3 ≤ |C₂| * (1 + Real.log y) / Real.log y ^ 3 :=
          div_le_div_of_nonneg_right (hS₂.trans
            (mul_le_mul_of_nonneg_right (le_abs_self _) (by linarith))) hl3.le
      _ = |C₂| * ((1 + Real.log y) / Real.log y ^ 3) := by ring
      _ ≤ |C₂| * (2 / Real.log y ^ 2) := mul_le_mul_of_nonneg_left h1ly (abs_nonneg _)
      _ = 2 * |C₂| / Real.log y ^ 2 := by ring
  have hb₃ : S₃ / Real.log y ^ 3 ≤ 2 * |C₃| / Real.log y ^ 2 := by
    calc S₃ / Real.log y ^ 3 ≤ |C₃| * (1 + Real.log y) / Real.log y ^ 3 :=
          div_le_div_of_nonneg_right (hS₃.trans
            (mul_le_mul_of_nonneg_right (le_abs_self _) (by linarith))) hl3.le
      _ = |C₃| * ((1 + Real.log y) / Real.log y ^ 3) := by ring
      _ ≤ |C₃| * (2 / Real.log y ^ 2) := mul_le_mul_of_nonneg_left h1ly (abs_nonneg _)
      _ = 2 * |C₃| / Real.log y ^ 2 := by ring
  have hbm : |Sm / Real.log y ^ 2 - 1 / Real.log y * I| ≤ |C₄| / Real.log y ^ 2 := by
    have e : Sm / Real.log y ^ 2 - 1 / Real.log y * I = (Sm - Real.log y * I) / Real.log y ^ 2 := by
      field_simp
    rw [e, abs_div, abs_of_pos hl2]
    exact div_le_div_of_nonneg_right (hmain.trans (le_abs_self _)) hl2.le
  obtain ⟨D, hD⟩ : ∃ D : ℝ, D = ∑ n ∈ Finset.Icc 1 ⌊y⌋₊,
        (μ n : ℝ) ^ 2 * (psiG (fun d => (Real.log d / Real.log y) ^ r₃) n / (n : ℝ) ^ 2
            * LLsum (Q P r₁) y n n 0 * LLsum (Q P r₂) y n n 0
          - 1 / (φ n : ℝ) * (differential P r₁ (Real.log n / Real.log y) * differential P r₂ (Real.log n / Real.log y)
              * (Real.log n / Real.log y) ^ r₃) / Real.log y ^ 2) := ⟨_, rfl⟩
  rw [← hD] at hsum ⊢
  have hfin : |C| * (S₁ / Real.log y ^ 2 + S₂ / Real.log y ^ 3 + S₃ / Real.log y ^ 3)
      ≤ |C| * ((|C₁| + 2 * |C₂| + 2 * |C₃|) / Real.log y ^ 2) := by
    refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
    have e : (|C₁| + 2 * |C₂| + 2 * |C₃|) / Real.log y ^ 2
        = |C₁| / Real.log y ^ 2 + 2 * |C₂| / Real.log y ^ 2 + 2 * |C₃| / Real.log y ^ 2 := by
      ring
    linarith
  have e1 : D + Sm / Real.log y ^ 2 - 1 / Real.log y * I
      = D + (Sm / Real.log y ^ 2 - 1 / Real.log y * I) := by ring
  have e2 : (|C| * (|C₁| + 2 * |C₂| + 2 * |C₃|) + |C₄|) / Real.log y ^ 2
      = |C| * ((|C₁| + 2 * |C₂| + 2 * |C₃|) / Real.log y ^ 2) + |C₄| / Real.log y ^ 2 := by
    ring
  rw [e1, e2]
  exact (abs_add_le _ _).trans (add_le_add (hsum.trans hfin) hbm)

end BHB.M2.GeneralDiagonal
end
end Src_GeneralDiagonal

section Src_ReflectedTaperDiagonal



/-! The evaluated gcd-diagonal bracket for the .78 taper. This specializes
the general monomial estimate and the Bui–Heath-Brown bracket expansion
in BHB.MainT2.DiagLead, retaining the dependence on the logarithmic shift. -/
noncomputable section
open MeasureTheory
open scoped BigOperators ArithmeticFunction ArithmeticFunction.Moebius Nat Real
namespace BHB.M2.Reflected78
open BHB.MT

def taper : GeneralDiagonal.Taper := ⟨LowBand.taper78,by unfold LowBand.taper78; fun_prop,by norm_num [LowBand.taper78]⟩
abbrev bcoef := LowBand.bcoefP LowBand.taper78
abbrev Smono := GeneralDiagonal.monomial taper
abbrev dF := GeneralDiagonal.differential taper
def dP (x : ℝ) := 1.78-1.56*x

theorem diff (x : ℝ) : deriv taper.val x=dP x := by
  have h := ((hasDerivAt_id' x).const_mul (1.78:ℝ)).sub ((hasDerivAt_pow 2 x).const_mul (0.78:ℝ))
  exact h.deriv.trans (by simp only [dP,Nat.cast_ofNat,Nat.reduceSub,pow_one]; ring)

def Dsum (θ T : ℝ) (i j : ℕ) : ℝ :=
  ∑ k₁ ∈ Krange θ T, ∑ k₂ ∈ Krange θ T,
    bcoef θ T k₁ * bcoef θ T k₂ * ((Nat.gcd k₁ k₂ : ℝ) / ((k₁ : ℝ) * k₂))
      * Real.log (qOf k₁ k₂) ^ i * Real.log (aOf k₁ k₂) ^ j

def kap (i j : ℕ) : ℝ :=
  if i = 0 ∧ j = 0 then 3007 / 2500
  else if (i = 1 ∧ j = 0) ∨ (i = 0 ∧ j = 1) then -1 / 2
  else if i = 1 ∧ j = 1 then 36271 / 75000
  else 0

theorem Dsum_eq_Smono {θ T : ℝ} (hθ : 0 < θ) (hT : 1 < T) (i j : ℕ) :
    Dsum θ T i j = Real.log (ymol θ T) ^ (i + j)
      * ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        ((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
          * Smono θ T r₁ r₂ (i - r₂ + (j - r₁)) := by
  have hly : Real.log (ymol θ T) ≠ 0 := (DL.ly_pos hθ hT).ne'
  have hL : Dsum θ T i j = ∑ k₁ ∈ Krange θ T, ∑ k₂ ∈ Krange θ T,
      ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        Real.log (ymol θ T) ^ (i + j)
          * (((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
            * (bcoef θ T k₁ * bcoef θ T k₂ * ((Nat.gcd k₁ k₂ : ℝ) / ((k₁ : ℝ) * k₂))
              * (Real.log k₁ / Real.log (ymol θ T)) ^ r₁
              * (Real.log k₂ / Real.log (ymol θ T)) ^ r₂
              * (Real.log (Nat.gcd k₁ k₂) / Real.log (ymol θ T)) ^ (i - r₂ + (j - r₁)))) := by
    unfold Dsum
    refine Finset.sum_congr rfl fun k₁ hk₁ => Finset.sum_congr rfl fun k₂ hk₂ => ?_
    obtain ⟨eq, ea⟩ := log_qOf (Finset.mem_Icc.mp hk₁).1 (Finset.mem_Icc.mp hk₂).1
    rw [eq, ea]
    exact DL.expand _ _ _ _ _ hly i j
  have hR : Real.log (ymol θ T) ^ (i + j)
      * ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        ((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
          * Smono θ T r₁ r₂ (i - r₂ + (j - r₁))
      = ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        ∑ k₁ ∈ Krange θ T, ∑ k₂ ∈ Krange θ T,
          Real.log (ymol θ T) ^ (i + j)
            * (((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
              * (bcoef θ T k₁ * bcoef θ T k₂ * ((Nat.gcd k₁ k₂ : ℝ) / ((k₁ : ℝ) * k₂))
                * (Real.log k₁ / Real.log (ymol θ T)) ^ r₁
                * (Real.log k₂ / Real.log (ymol θ T)) ^ r₂
                * (Real.log (Nat.gcd k₁ k₂) / Real.log (ymol θ T)) ^ (i - r₂ + (j - r₁)))) := by
    unfold Smono GeneralDiagonal.monomial
    simp only [Finset.mul_sum,taper,bcoef]
  rw [hL, hR]
  exact DL.sum_comm4 _ _ _ _ _

theorem sum_choose_dF (j : ℕ) (hj : j ≤ 3) (u : ℝ) :
    ∑ r ∈ Finset.range (j + 1), (j.choose r : ℝ) * (-u) ^ (j - r) * dF r u
      = if j = 0 then -dP (1 - u) else if j = 1 then LowBand.taper78 (1 - u) else 0 := by
  interval_cases j
  · simp [dF,GeneralDiagonal.differential,diff]
  · simp [Finset.sum_range_succ, dF, GeneralDiagonal.differential, diff]
    dsimp only [taper]
    ring
  · simp [Finset.sum_range_succ, dF, GeneralDiagonal.differential, diff, Nat.choose]
    dsimp only [taper]
    ring
  · simp [Finset.sum_range_succ, dF, GeneralDiagonal.differential, diff, Nat.choose]
    dsimp only [taper]
    ring

theorem integral_dP_sq : (∫ u in (0:ℝ)..1, (-dP (1-u))*(-dP (1-u))) = 3007/2500 := by
  have he (u : ℝ) : (-dP (1-u))*(-dP (1-u))=(121/2500) + (429/625)*u + (1521/625)*u^2 + (0)*u^3 + (0)*u^4 := by dsimp only [dP,LowBand.taper78]; ring
  simp only [he]
  rw [BHB.M2.DL.integral_poly4]; norm_num

theorem integral_dP_P : (∫ u in (0:ℝ)..1, (-dP (1-u))*(LowBand.taper78 (1-u))) = -1/2 := by
  have he (u : ℝ) : (-dP (1-u))*(LowBand.taper78 (1-u))=(-11/50) + (-3779/2500)*u + (1287/2500)*u^2 + (1521/1250)*u^3 + (0)*u^4 := by dsimp only [dP,LowBand.taper78]; ring
  simp only [he]
  rw [BHB.M2.DL.integral_poly4]; norm_num

theorem integral_P_sq : (∫ u in (0:ℝ)..1, (LowBand.taper78 (1-u))*(LowBand.taper78 (1-u))) = 36271/75000 := by
  have he (u : ℝ) : (LowBand.taper78 (1-u))*(LowBand.taper78 (1-u))=(1) + (-11/25)*u + (-3779/2500)*u^2 + (429/1250)*u^3 + (1521/2500)*u^4 := by dsimp only [dP,LowBand.taper78]; ring
  simp only [he]
  rw [BHB.M2.DL.integral_poly4]; norm_num

theorem sum_integral_eq (i j : ℕ) :
    ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        ((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
          * ∫ u in (0 : ℝ)..1, dF r₁ u * dF r₂ u * u ^ (i - r₂ + (j - r₁))
      = ∫ u in (0 : ℝ)..1,
          (∑ r₂ ∈ Finset.range (i + 1), (i.choose r₂ : ℝ) * (-u) ^ (i - r₂) * dF r₂ u)
            * ∑ r₁ ∈ Finset.range (j + 1), (j.choose r₁ : ℝ) * (-u) ^ (j - r₁) * dF r₁ u := by
  have hc : ∀ r : ℕ, Continuous (dF r) := fun r => (GeneralDiagonal.c1_differential taper r).continuous
  simp only [Finset.sum_mul_sum]
  rw [intervalIntegral.integral_finsetSum]
  · refine Finset.sum_congr rfl fun r₂ _ => ?_
    rw [intervalIntegral.integral_finsetSum]
    · refine Finset.sum_congr rfl fun r₁ _ => ?_
      rw [← intervalIntegral.integral_const_mul]
      refine intervalIntegral.integral_congr fun u _ => ?_
      simp only [neg_pow u, pow_add]
      ring
    · intro r₁ _
      exact Continuous.intervalIntegrable (by have := hc r₁; have := hc r₂; fun_prop) _ _
  · intro r₂ _
    refine Continuous.intervalIntegrable ?_ _ _
    refine continuous_finsetSum _ fun r₁ _ => ?_
    have := hc r₁
    have := hc r₂
    fun_prop

theorem sum_integral_dF (i j : ℕ) (hij : i + j ≤ 3) :
    ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        ((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
          * ∫ u in (0 : ℝ)..1, dF r₁ u * dF r₂ u * u ^ (i - r₂ + (j - r₁))
      = kap i j := by
  have hi : i ≤ 3 := by omega
  have hj : j ≤ 3 := by omega
  rw [sum_integral_eq]
  simp only [sum_choose_dF i hi, sum_choose_dF j hj]
  interval_cases i <;> interval_cases j <;> first
    | omega
    | (simp (config := {decide := true}) only [kap, ↓reduceIte, mul_zero, zero_mul,
        intervalIntegral.integral_zero]; done)
    | (simp (config := {decide := true}) only [kap, ↓reduceIte]; first
        | exact integral_dP_sq
        | exact integral_dP_P
        | exact integral_P_sq
        | (simp only [mul_comm (LowBand.taper78 _)]; exact integral_dP_P))

theorem Dsum_asymp {C₀ : ℝ} (hM : MobiusHyp C₀) {θ : ℝ} (hθ : 0 < θ) : ∃ C T₀ : ℝ,
    ∀ T : ℝ, T₀ ≤ T → ∀ i j : ℕ, i + j ≤ 3 →
      |Dsum θ T i j - kap i j * Real.log (ymol θ T) ^ (i + j) / Real.log (ymol θ T)|
        ≤ C * Real.log (ymol θ T) ^ (i + j) / Real.log (ymol θ T) ^ 2 := by
  obtain ⟨C, T₀, h⟩ := GeneralDiagonal.Smono_asymp taper hM hθ
  refine ⟨8 * C, max T₀ 2, fun T hT i j hij => ?_⟩
  have hT0 : T₀ ≤ T := le_trans (le_max_left _ _) hT
  have hT1 : 1 < T := lt_of_lt_of_le (by norm_num) (le_trans (le_max_right _ _) hT)
  have hly : 0 < Real.log (ymol θ T) := DL.ly_pos hθ hT1
  have hCly : 0 ≤ C / Real.log (ymol θ T) ^ 2 :=
    (abs_nonneg _).trans (h T hT0 0 0 0 (by norm_num) (by norm_num) (by norm_num))
  rw [Dsum_eq_Smono hθ hT1, ← sum_integral_dF i j hij]
  have hS := h T hT0
  generalize Real.log (ymol θ T) = ly at hly hCly hS ⊢
  have e : ly ^ (i + j) * ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        ((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
          * Smono θ T r₁ r₂ (i - r₂ + (j - r₁))
      - (∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        ((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
          * ∫ u in (0 : ℝ)..1, dF r₁ u * dF r₂ u * u ^ (i - r₂ + (j - r₁))) * ly ^ (i + j) / ly
      = ly ^ (i + j) * ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        ((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
          * (Smono θ T r₁ r₂ (i - r₂ + (j - r₁))
            - 1 / ly * ∫ u in (0 : ℝ)..1, dF r₁ u * dF r₂ u * u ^ (i - r₂ + (j - r₁))) := by
    have e1 : ∀ c S I : ℝ, c * (S - 1 / ly * I) = c * S - c * I / ly := by
      intro c S I
      ring
    simp only [e1, Finset.sum_sub_distrib, ← Finset.sum_div]
    ring
  rw [e, abs_mul, abs_of_nonneg (pow_nonneg hly.le _)]
  have hsum : |∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        ((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
          * (Smono θ T r₁ r₂ (i - r₂ + (j - r₁))
            - 1 / ly * ∫ u in (0 : ℝ)..1, dF r₁ u * dF r₂ u * u ^ (i - r₂ + (j - r₁)))|
      ≤ ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        (i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (C / ly ^ 2) := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun r₂ hr₂ => ?_)
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun r₁ hr₁ => ?_)
    have h₂ : r₂ ≤ i := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr₂)
    have h₁ : r₁ ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr₁)
    rw [abs_mul, abs_mul, abs_pow, abs_neg, abs_one, one_pow, mul_one, abs_mul, Nat.abs_cast,
      Nat.abs_cast]
    exact mul_le_mul_of_nonneg_left
      (hS r₁ r₂ (i - r₂ + (j - r₁)) (by omega) (by omega) (by omega)) (by positivity)
  have hcount : ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        (i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (C / ly ^ 2) ≤ 8 * (C / ly ^ 2) := by
    have e2 : ∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        (i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (C / ly ^ 2)
        = (2 : ℝ) ^ (i + j) * (C / ly ^ 2) := by
      have s1 : ∑ r₂ ∈ Finset.range (i + 1), (i.choose r₂ : ℝ) = 2 ^ i := by
        exact_mod_cast Nat.sum_range_choose i
      have s2 : ∑ r₁ ∈ Finset.range (j + 1), (j.choose r₁ : ℝ) = 2 ^ j := by
        exact_mod_cast Nat.sum_range_choose j
      simp only [← Finset.sum_mul, ← Finset.mul_sum]
      rw [s1, s2, pow_add]
    rw [e2]
    refine mul_le_mul_of_nonneg_right ?_ hCly
    calc (2 : ℝ) ^ (i + j) ≤ 2 ^ 3 := pow_le_pow_right₀ (by norm_num) hij
      _ = 8 := by norm_num
  calc ly ^ (i + j) * |∑ r₂ ∈ Finset.range (i + 1), ∑ r₁ ∈ Finset.range (j + 1),
        ((i.choose r₂ : ℝ) * (j.choose r₁ : ℝ) * (-1) ^ (i - r₂ + (j - r₁)))
          * (Smono θ T r₁ r₂ (i - r₂ + (j - r₁))
            - 1 / ly * ∫ u in (0 : ℝ)..1, dF r₁ u * dF r₂ u * u ^ (i - r₂ + (j - r₁)))|
      ≤ ly ^ (i + j) * (8 * (C / ly ^ 2)) :=
        mul_le_mul_of_nonneg_left (hsum.trans hcount) (pow_nonneg hly.le _)
    _ = 8 * C * ly ^ (i + j) / ly ^ 2 := by ring

def BrSum (θ T l : ℝ) : ℝ :=
  ∑ k₁ ∈ Krange θ T, ∑ k₂ ∈ Krange θ T,
    bcoef θ T k₁ * bcoef θ T k₂ * ((Nat.gcd k₁ k₂ : ℝ) / ((k₁ : ℝ) * k₂))
      * Br l (Real.log (qOf k₁ k₂)) (Real.log (aOf k₁ k₂))

theorem BrSum_eq (θ T l : ℝ) :
    BrSum θ T l
      = (l ^ 3 / 3 + stj 0 * l ^ 2 - 2 * stj 1 * l + 2 * stj 2) * Dsum θ T 0 0
        - (l ^ 2 / 2 + stj 0 * l - 2 * stj 1) * (Dsum θ T 1 0 + Dsum θ T 0 1)
        + (l + 2 * stj 0) * Dsum θ T 1 1
        + (Dsum θ T 3 0 + Dsum θ T 0 3) / 6 - (Dsum θ T 2 1 + Dsum θ T 1 2) / 2 := by
  unfold BrSum Dsum
  simp only [Finset.mul_sum, Finset.sum_div, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun k₁ _ => Finset.sum_congr rfl fun k₂ _ => ?_
  rw [Br_expand]
  ring

theorem kap_00 : kap 0 0 = 3007 / 2500 := by simp [kap]

theorem kap_10 : kap 1 0 = -1 / 2 := by simp [kap]

theorem kap_01 : kap 0 1 = -1 / 2 := by simp [kap]

theorem kap_11 : kap 1 1 = 36271 / 75000 := by simp [kap]

theorem kap_30 : kap 3 0 = 0 := by simp [kap]

theorem kap_03 : kap 0 3 = 0 := by simp [kap]

theorem kap_21 : kap 2 1 = 0 := by simp [kap]

theorem kap_12 : kap 1 2 = 0 := by simp [kap]

theorem BrSum_asymp {C₀ : ℝ} (hM : MobiusHyp C₀) {θ : ℝ} (hθ : 0 < θ) : ∃ C T₀ : ℝ,
    ∀ T : ℝ, T₀ ≤ T → ∀ l : ℝ,
      |BrSum θ T l - (l ^ 3 * (3007 / 2500) / (3 * Real.log (ymol θ T)) + l ^ 2 / 2
          + l * Real.log (ymol θ T) * (36271 / 75000))|
        ≤ C * (1 + |l| + Real.log (ymol θ T)) ^ 3 / Real.log (ymol θ T) ^ 2 := by
  obtain ⟨C, T₀, h⟩ := Dsum_asymp hM hθ
  refine ⟨(|(1 / 3 : ℝ)| + |stj 0| + |-(2 * stj 1)| + |2 * stj 2|) * |C|
      + (|(1 / 2 : ℝ)| + |stj 0| + |-(2 * stj 1)|) * |C|
      + (|(1 / 2 : ℝ)| + |stj 0| + |-(2 * stj 1)|) * |C|
      + (|(1 : ℝ)| + |2 * stj 0|) * |C|
      + 1 / 6 * |C| + 1 / 6 * |C| + 1 / 2 * |C| + 1 / 2 * |C|
      + (|stj 0| + |-(2 * stj 1)| + |2 * stj 2|) * (3007 / 2500)
      + (|stj 0| + |-(2 * stj 1)|) * 1
      + |2 * stj 0 * (36271 / 75000)| * 1, max T₀ (Real.exp (1 / θ)), fun T hT l => ?_⟩
  have hT0 : T₀ ≤ T := le_trans (le_max_left _ _) hT
  have hTe : Real.exp (1 / θ) ≤ T := le_trans (le_max_right _ _) hT
  have hTpos : 0 < T := lt_of_lt_of_le (Real.exp_pos _) hTe
  have hly1 : 1 ≤ Real.log (ymol θ T) := by
    rw [BHB.MT.log_ymol hTpos θ]
    have h1 : 1 / θ ≤ Real.log T := (Real.le_log_iff_exp_le hTpos).mpr hTe
    calc (1 : ℝ) = θ * (1 / θ) := by field_simp
      _ ≤ θ * Real.log T := mul_le_mul_of_nonneg_left h1 hθ.le
  have hD := h T hT0
  rw [BrSum_eq]
  generalize Real.log (ymol θ T) = ly at hly1 hD ⊢
  have hly0 : 0 < ly := by linarith
  have hlyne : ly ≠ 0 := hly0.ne'
  have hlS : |l| ≤ 1 + |l| + ly := by linarith
  have hlyS : ly ≤ 1 + |l| + ly := by
    have := abs_nonneg l
    linarith
  have hS1 : 1 ≤ 1 + |l| + ly := hly1.trans hlyS
  generalize 1 + |l| + ly = S at hlS hlyS hS1 ⊢
  have hCabs : ∀ i j : ℕ, i + j ≤ 3 →
      |Dsum θ T i j - kap i j * ly ^ (i + j) / ly| ≤ |C| * ly ^ (i + j) / ly ^ 2 := by
    intro i j hij
    refine (hD i j hij).trans ?_
    have h1 : 0 ≤ ly ^ (i + j) / ly ^ 2 := by positivity
    rw [mul_div_assoc, mul_div_assoc]
    exact mul_le_mul_of_nonneg_right (le_abs_self C) h1
  have d00 := hCabs 0 0 (by norm_num)
  have d10 := hCabs 1 0 (by norm_num)
  have d01 := hCabs 0 1 (by norm_num)
  have d11 := hCabs 1 1 (by norm_num)
  have d30 := hCabs 3 0 (by norm_num)
  have d03 := hCabs 0 3 (by norm_num)
  have d21 := hCabs 2 1 (by norm_num)
  have d12 := hCabs 1 2 (by norm_num)
  rw [kap_00] at d00
  rw [kap_10] at d10
  rw [kap_01] at d01
  rw [kap_11] at d11
  rw [kap_30] at d30
  rw [kap_03] at d03
  rw [kap_21] at d21
  rw [kap_12] at d12
  have hC0 : 0 ≤ |C| := abs_nonneg C
  -- the coefficients of the bracket
  have a3 : |l ^ 3 / 3 + stj 0 * l ^ 2 - 2 * stj 1 * l + 2 * stj 2|
      ≤ (|(1 / 3 : ℝ)| + |stj 0| + |-(2 * stj 1)| + |2 * stj 2|) * S ^ 3 := by
    have e : l ^ 3 / 3 + stj 0 * l ^ 2 - 2 * stj 1 * l + 2 * stj 2
        = 1 / 3 * l ^ 3 + stj 0 * l ^ 2 + -(2 * stj 1) * l + 2 * stj 2 := by ring
    rw [e]
    exact DL.abs_cub_le hlS hS1 _ _ _ _
  have a2 : |l ^ 2 / 2 + stj 0 * l - 2 * stj 1|
      ≤ (|(1 / 2 : ℝ)| + |stj 0| + |-(2 * stj 1)|) * S ^ 2 := by
    have e : l ^ 2 / 2 + stj 0 * l - 2 * stj 1 = 1 / 2 * l ^ 2 + stj 0 * l + -(2 * stj 1) := by
      ring
    rw [e]
    exact DL.abs_quad_le hlS hS1 _ _ _
  have a1 : |l + 2 * stj 0| ≤ (|(1 : ℝ)| + |2 * stj 0|) * S ^ 1 := by
    have e : l + 2 * stj 0 = 1 * l + 2 * stj 0 := by ring
    rw [e]
    exact DL.abs_lin_le hlS hS1 _ _
  have r2 : |stj 0 * l ^ 2 - 2 * stj 1 * l + 2 * stj 2|
      ≤ (|stj 0| + |-(2 * stj 1)| + |2 * stj 2|) * S ^ 2 := by
    have e : stj 0 * l ^ 2 - 2 * stj 1 * l + 2 * stj 2
        = stj 0 * l ^ 2 + -(2 * stj 1) * l + 2 * stj 2 := by ring
    rw [e]
    exact DL.abs_quad_le hlS hS1 _ _ _
  have r1 : |stj 0 * l - 2 * stj 1| ≤ (|stj 0| + |-(2 * stj 1)|) * S ^ 1 := by
    have e : stj 0 * l - 2 * stj 1 = stj 0 * l + -(2 * stj 1) := by ring
    rw [e]
    exact DL.abs_lin_le hlS hS1 _ _
  have r0 : |2 * stj 0 * (36271 / 75000)| ≤ |2 * stj 0 * (36271 / 75000)| * S ^ 0 := by
    rw [pow_zero, mul_one]
  have c6 : |(1 / 6 : ℝ)| ≤ 1 / 6 * S ^ 0 := by
    rw [pow_zero, mul_one, abs_of_nonneg (by norm_num)]
  have c2 : |(1 / 2 : ℝ)| ≤ 1 / 2 * S ^ 0 := by
    rw [pow_zero, mul_one, abs_of_nonneg (by norm_num)]
  have e1 : |3007 / 2500 * ly ^ 1 / ly ^ 2| ≤ 3007 / 2500 * ly ^ 1 / ly ^ 2 :=
    le_of_eq (abs_of_nonneg (by positivity))
  have e2 : |1 * ly ^ 2 / ly ^ 2| ≤ 1 * ly ^ 2 / ly ^ 2 :=
    le_of_eq (abs_of_nonneg (by positivity))
  have e3 : |1 * ly ^ 3 / ly ^ 2| ≤ 1 * ly ^ 3 / ly ^ 2 :=
    le_of_eq (abs_of_nonneg (by positivity))
  -- the eleven terms
  have b1 := DL.prod_bound hly1 hlyS (by norm_num) (by positivity) hC0 a3 d00
  have b2 := DL.prod_bound hly1 hlyS (by norm_num) (by positivity) hC0 a2 d10
  have b3 := DL.prod_bound hly1 hlyS (by norm_num) (by positivity) hC0 a2 d01
  have b4 := DL.prod_bound hly1 hlyS (by norm_num) (by positivity) hC0 a1 d11
  have b5 := DL.prod_bound hly1 hlyS (by norm_num) (by norm_num) hC0 c6 d30
  have b6 := DL.prod_bound hly1 hlyS (by norm_num) (by norm_num) hC0 c6 d03
  have b7 := DL.prod_bound hly1 hlyS (by norm_num) (by norm_num) hC0 c2 d21
  have b8 := DL.prod_bound hly1 hlyS (by norm_num) (by norm_num) hC0 c2 d12
  have b9 := DL.prod_bound hly1 hlyS (by norm_num) (by positivity) (by norm_num) r2 e1
  have b10 := DL.prod_bound hly1 hlyS (by norm_num) (by positivity) (by norm_num) r1 e2
  have b11 := DL.prod_bound hly1 hlyS (by norm_num) (by positivity) (by norm_num) r0 e3
  have hid : (l ^ 3 / 3 + stj 0 * l ^ 2 - 2 * stj 1 * l + 2 * stj 2) * Dsum θ T 0 0
        - (l ^ 2 / 2 + stj 0 * l - 2 * stj 1) * (Dsum θ T 1 0 + Dsum θ T 0 1)
        + (l + 2 * stj 0) * Dsum θ T 1 1
        + (Dsum θ T 3 0 + Dsum θ T 0 3) / 6 - (Dsum θ T 2 1 + Dsum θ T 1 2) / 2
        - (l ^ 3 * (3007 / 2500) / (3 * ly) + l ^ 2 / 2 + l * ly * (36271 / 75000))
      = (l ^ 3 / 3 + stj 0 * l ^ 2 - 2 * stj 1 * l + 2 * stj 2)
            * (Dsum θ T 0 0 - 3007 / 2500 * ly ^ (0 + 0) / ly)
        - (l ^ 2 / 2 + stj 0 * l - 2 * stj 1) * (Dsum θ T 1 0 - -1 / 2 * ly ^ (1 + 0) / ly)
        - (l ^ 2 / 2 + stj 0 * l - 2 * stj 1) * (Dsum θ T 0 1 - -1 / 2 * ly ^ (0 + 1) / ly)
        + (l + 2 * stj 0) * (Dsum θ T 1 1 - 36271 / 75000 * ly ^ (1 + 1) / ly)
        + 1 / 6 * (Dsum θ T 3 0 - 0 * ly ^ (3 + 0) / ly)
        + 1 / 6 * (Dsum θ T 0 3 - 0 * ly ^ (0 + 3) / ly)
        - 1 / 2 * (Dsum θ T 2 1 - 0 * ly ^ (2 + 1) / ly)
        - 1 / 2 * (Dsum θ T 1 2 - 0 * ly ^ (1 + 2) / ly)
        + (stj 0 * l ^ 2 - 2 * stj 1 * l + 2 * stj 2) * (3007 / 2500 * ly ^ 1 / ly ^ 2)
        + (stj 0 * l - 2 * stj 1) * (1 * ly ^ 2 / ly ^ 2)
        + 2 * stj 0 * (36271 / 75000) * (1 * ly ^ 3 / ly ^ 2) := by
    field_simp
    ring
  rw [hid]
  refine (DL.abs_sum11_le b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11).trans (le_of_eq ?_)
  ring

end BHB.M2.Reflected78
end
