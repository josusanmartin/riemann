open Filter MultiplicityProbe
open scoped BigOperators

namespace ShortProbe

def band (u v T : ℝ) (z : ℂ) : ℂ := probeThrough v T z-probeThrough u T z

private theorem partial_eq (b T : ℝ) (z : ℂ) :
    FejerBands.partialSum (FejerBands.triangle width) b T z = probeThrough b T z := by
  unfold FejerBands.partialSum probeThrough
  apply Finset.sum_congr rfl
  intro n _
  congr 1
  apply Complex.ofReal_inj.mpr
  unfold FejerBands.triangle width
  simp only [div_eq_mul_inv,mul_inv_rev]
  ring

private theorem sharp_expand (T d : ℝ) (w : ℂ → ℂ) :
    FejerBands.sharp T (fun z => ‖w z-d‖^2) =
      sumAt T (fun z => MultiplicityProbe.sq (w z))-2*d*sumAt T (fun z => (w z).re)+d^2*count T := by
  unfold FejerBands.sharp sumAt
  rw [count,ThirdMoment.Ncount_eq]
  simp only [Finset.mul_sum,← Finset.sum_add_distrib,← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro z _
  rw [← Complex.normSq_eq_norm_sq]
  simp only [Complex.normSq_apply,Complex.sub_re,Complex.sub_im,Complex.ofReal_re,Complex.ofReal_im,sub_zero,MultiplicityProbe.sq]
  ring

private theorem nonneg_square (T : ℝ) (w : ℂ → ℂ) : 0 ≤ sumAt T (fun z => MultiplicityProbe.sq (w z)) := by
  unfold sumAt MultiplicityProbe.sq
  exact Finset.sum_nonneg fun z _ => mul_nonneg (Nat.cast_nonneg _) (by positivity)

/-- Signed upper first moment and Hermitian second moment on any specified band.
The two primitive differences can be evaluated exactly at rational endpoints. -/
theorem band_moments (hRH : RiemannHypothesis) {u v M V : ℝ} (hu : 0 ≤ u) (hv : 0 < v)
    (huv : u ≤ v) (hvw : v ≤ width)
    (hm : FejerBands.firstPrimitive width v-FejerBands.firstPrimitive width u=M)
    (hs : FejerBands.secondPrimitive width v-FejerBands.secondPrimitive width u=V)
    (hM : M ∈ Set.Icc 0 1) (hV : V ∈ Set.Icc 0 1) :
    ∀ᶠ T : ℝ in atTop,
      sumAt T (fun z => (band u v T z).re) ≤ (-M+1/10^6)*count T ∧
      sumAt T (fun z => MultiplicityProbe.sq (band u v T z)) ≤ (V+1/10^6)*count T := by
  let δ : ℝ := 1/10^20
  have one (d : ℝ) (hd : 0 ≤ d^2+V+2*d*M) (hupper : d^2+V+2*d*M ≤ 2*10^12) :=
    FejerBands.triangular_square hRH hu hv huv hvw (lt_of_le_of_lt hvw (by norm_num [width])) d
      (δ := δ) (by norm_num [δ]) (by rw [hm,hs]) hd
      (cap := d^2+V+2*d*M+1/10^6) (by dsimp [δ]; linarith only [hupper])
  have hz := one 0 (by linarith [hV.1]) (by linarith [hV.2])
  have hn := one (-10^6) (by linarith [hV.1,hM.2]) (by linarith [hV.2,hM.1])
  filter_upwards [hz,hn] with T h₀ h₁
  have eqv : FejerBands.value (FejerBands.triangle width) u v T = band u v T := by
    funext z; simp only [FejerBands.value,partial_eq,band]
  rw [eqv,sharp_expand] at h₀ h₁
  have hc : 0 ≤ count T := Nat.cast_nonneg _
  have hx := nonneg_square T (band u v T)
  change _ ≤ ((-10^6)^2+V+2*(-10^6)*M+1/10^6)*count T at h₁
  constructor
  · linarith only [h₁,hx,mul_le_mul_of_nonneg_right hV.2 hc,hc]
  · simpa [count] using h₀

private theorem through_zero (T : ℝ) (z : ℂ) : probeThrough 0 T z=0 := by
  simp [probeThrough,BHB.Krange,BHB.ymol]

/-- RH supplies the full prime probe mean on the upper side as well. -/
theorem prime_upper (hRH : RiemannHypothesis) :
    ∀ᶠ T in atTop, sumAt T (fun z => (probe T z).re) ≤ -(16499/100000)*count T := by
  have h := band_moments hRH (u := 0) (v := width) (M := 33/200) (V := 1/12)
    (by norm_num) (by norm_num [width]) (by norm_num [width]) le_rfl
    (by norm_num [FejerBands.firstPrimitive,width]) (by norm_num [FejerBands.secondPrimitive,width])
    (by constructor <;> norm_num) (by constructor <;> norm_num)
  filter_upwards [h] with T ⟨hm,_⟩
  simp only [band,through_zero,sub_zero] at hm
  have hc : 0 ≤ count T := Nat.cast_nonneg _
  change sumAt T (fun z => (probe T z).re) ≤ _ at hm
  linarith

/-- The ordinary square alone suffices on the prime-only route to 90.1 percent. -/
theorem cumulative_of_prime_square (hRH : RiemannHypothesis)
    (hj : ∀ᶠ T in atTop, sumAt T (fun z => ((probe T z)^2).re) ≤ (247/10000)*count T) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (901/1000-ε)*(Zeta23.Ncount 0 T : ℝ) ≤ Zeta23.N0star 0 T := by
  apply PrimePair.cumulative hRH
  filter_upwards [prime_upper hRH,prime_moments hRH,hj] with T hm ⟨_,hv⟩ hs
  exact ⟨hm,hv,hs⟩

private def localScore (c d s : ℝ) (a w : ℂ) : ℝ :=
  1-(c-2*d*w.re-s*a.re)^2-(2*d*w.im-s*a.im)^2

private theorem occurrence {c d s : ℝ} (hd : 0 ≤ d)
    (h₂ : 707107/1000000 ≤ c+d*(2-1/width-1/100000))
    (h₃ : 1 ≤ c+d*(3-1/width-1/100000)) (m : ℕ) (hm : 1 ≤ m) (a w : ℂ)
    (ha : m ≠ 1 → a=0) (hl : (m:ℝ) ≤ 1/width-2*w.re+1/100000) :
    (m:ℝ)*localScore c d s a w ≤ 1 := by
  by_cases he : m=1
  · subst m
    simp only [Nat.cast_one,one_mul,localScore]
    linarith only [sq_nonneg (c-2*d*w.re-s*a.re),sq_nonneg (2*d*w.im-s*a.im)]
  rw [ha he]
  simp only [localScore,Complex.zero_re,Complex.zero_im,mul_zero,sub_zero]
  have low : c+d*((m:ℝ)-1/width-1/100000) ≤ c-2*d*w.re := by
    linarith only [mul_le_mul_of_nonneg_left hl hd]
  by_cases he₂ : m=2
  · subst m
    norm_num only [Nat.cast_ofNat] at low ⊢
    norm_num [width] at h₂
    have hh := h₂.trans low
    nlinarith only [mul_self_le_mul_self (by norm_num : (0:ℝ) ≤ 707107/1000000) hh,
      sq_nonneg (2*d*w.im)]
  · have h3 : (3:ℝ) ≤ m := by exact_mod_cast (show 3 ≤ m by omega)
    have hh : 1 ≤ c-2*d*w.re := by linarith only [h₃,low,mul_le_mul_of_nonneg_left h3 hd]
    have hneg : 1-(c-2*d*w.re)^2-(2*d*w.im)^2 ≤ 0 := by
      nlinarith only [mul_self_le_mul_self zero_le_one hh,sq_nonneg (2*d*w.im)]
    exact (mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg _) hneg).trans zero_le_one

private theorem finite_score {c d s : ℝ} (hd : 0 ≤ d)
    (h₂ : 707107/1000000 ≤ c+d*(2-1/width-1/100000))
    (h₃ : 1 ≤ c+d*(3-1/width-1/100000)) (T : ℝ)
    (hl : ∀ z ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult z:ℝ) ≤ 1/width-2*(probe T z).re+1/100000) :
    (1-c^2)*count T + 4*c*d*sumAt T (fun z => (probe T z).re)
      -4*d^2*sumAt T (fun z => MultiplicityProbe.sq (probe T z))
      +2*s*c*sumAt T (fun z => (detector T z).re)
      -4*s*d*sumAt T (fun z => (detector T z*probe T z).re)
      -s^2*sumAt T (fun z => MultiplicityProbe.sq (detector T z)) ≤ (Zeta23.Ndist T (2*T):ℝ) := by
  have hh := Finset.sum_le_sum (s := ThirdMoment.zerosFinset T (2*T))
    (f := fun z => (Zeta23.zeroMult z:ℝ)*localScore c d s (detector T z) (probe T z))
    (g := fun _ => (1:ℝ)) (fun z hz => occurrence hd h₂ h₃ _ (ThirdMoment.one_le_mult_of_mem hz) _ _
      (fun hm => by
        let ρ : Zeta23.zetaZeroConfig.carrier := ⟨z,(ThirdMoment.mem_zerosFinset.mp hz).1⟩
        have h := BHB.Red.deriv_zeta_eq_zero_of_mult_ne_one ρ hm
        simp [detector,show deriv riemannZeta z=0 from h]) (hl z hz))
  simp only [Finset.sum_const,nsmul_eq_mul,mul_one] at hh
  rw [ThirdMoment.Ndist_eq,count,ThirdMoment.Ncount_eq]
  unfold sumAt
  simp only [Finset.mul_sum,← Finset.sum_add_distrib,← Finset.sum_sub_distrib]
  refine (Finset.sum_le_sum fun z _ => le_of_eq ?_).trans hh
  simp only [localScore,MultiplicityProbe.sq,Complex.mul_re]
  ring

private theorem tail_cost (T r k : ℝ) (w : ℂ → ℂ) :
    2*r*sumAt T (fun z => (detector T z*w z).re) ≤
      r^2*sumAt T (fun z => MultiplicityProbe.sq (detector T z)) + sumAt T (fun z => MultiplicityProbe.sq (w z))
      -2*r*k*sumAt T (fun z => (detector T z).re) +2*k*sumAt T (fun z => (w z).re)
      +k^2*count T := by
  rw [count,ThirdMoment.Ncount_eq]
  unfold sumAt
  simp only [Finset.mul_sum,← Finset.sum_add_distrib,← Finset.sum_sub_distrib]
  apply Finset.sum_le_sum
  intro z _
  have hh : 2*r*(detector T z*w z).re ≤ r^2*MultiplicityProbe.sq (detector T z)+MultiplicityProbe.sq (w z)
      -2*r*k*(detector T z).re+2*k*(w z).re+k^2 := by
    simp only [Complex.mul_re,MultiplicityProbe.sq]
    nlinarith only [sq_nonneg (r*(detector T z).re-(w z).re-k),sq_nonneg (r*(detector T z).im+(w z).im)]
  linarith only [mul_le_mul_of_nonneg_left hh (Nat.cast_nonneg (α:=ℝ) (Zeta23.zeroMult z))]

def MixedUpper (b q : ℝ) : Prop := ∀ᶠ T in atTop,
  sumAt T (fun z => (detector T z*probeThrough b T z).re) ≤ q*count T

/-- Test a rational certificate using only a signed mixed average with primes up to T^b. -/
theorem shortened (hRH : RiemannHypothesis) {b q κ c d s r k M V price : ℝ} (hf : MixedUpper b q)
    (hb : 0 ≤ b) (hb' : b ≤ width)
    (hm : FejerBands.firstPrimitive width width-FejerBands.firstPrimitive width b=M)
    (hv : FejerBands.secondPrimitive width width-FejerBands.secondPrimitive width b=V)
    (hM : M ∈ Set.Icc 0 1) (hV : V ∈ Set.Icc 0 1)
    (hc : 0 ≤ c) (hd : 0 ≤ d) (hs : 0 ≤ s) (hr : 0 < r) (hk : 0 ≤ k)
    (h₂ : 707107/1000000 ≤ c+d*(2-1/width-1/100000))
    (h₃ : 1 ≤ c+d*(3-1/width-1/100000))
    (hprice : r^2*(89010/100000)+(V+1/10^6)-2*r*k*(79107/100000)
      +2*k*(-M+1/10^6)+k^2 ≤ 2*r*price)
    (htarget : κ ≤ 1-c^2+4*c*d*(-(16501/100000))-4*d^2*(8334/100000)
      +2*s*c*(79107/100000)-4*s*d*(q+price)-s^2*(89010/100000)) :
    ∀ᶠ T in atTop, κ*count T ≤ (Zeta23.N0star T (2*T):ℝ) := by
  filter_upwards [hf,band_moments hRH hb (by norm_num [width]) hb' le_rfl hm hv hM hV,
    local_at_width hRH (ε := 1/100000) (by norm_num),prime_moments hRH,detector_moments hRH]
    with T hshort ⟨hw,hw₂⟩ hl ⟨h₁,h₁'⟩ ⟨ha,ha₂⟩
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  have hcost := tail_cost T r k (band b width T)
  have he : sumAt T (fun z => (detector T z*band b width T z).re) =
      sumAt T (fun z => (detector T z*probe T z).re)-sumAt T (fun z => (detector T z*probeThrough b T z).re) := by
    simp only [sumAt,band,mul_sub,Complex.sub_re,mul_sub,Finset.sum_sub_distrib,probe]
  rw [he] at hcost
  have hmix : sumAt T (fun z => (detector T z*probe T z).re) ≤ (q+price)*count T := by
    apply le_of_mul_le_mul_left (a := 2*r) _ (by positivity)
    linarith only [hcost,hw₂,mul_le_mul_of_nonneg_left ha₂ (sq_nonneg r),
      mul_le_mul_of_nonneg_left ha (show 0 ≤ 2*r*k by positivity),
      mul_le_mul_of_nonneg_left hw (show 0 ≤ 2*k by positivity),
      mul_le_mul_of_nonneg_right hprice hn,mul_le_mul_of_nonneg_left hshort (show 0 ≤ 2*r by positivity)]
  rw [(Zeta23.RH_implies_all_on_line hRH _ _).2]
  have hfin := finite_score (s := s) hd h₂ h₃ T hl
  linarith only [hfin,mul_le_mul_of_nonneg_right htarget hn,
    mul_le_mul_of_nonneg_left h₁ (show 0 ≤ 4*c*d by positivity),
    mul_le_mul_of_nonneg_left h₁' (show 0 ≤ 4*d^2 by positivity),
    mul_le_mul_of_nonneg_left ha (show 0 ≤ 2*s*c by positivity),
    mul_le_mul_of_nonneg_left hmix (show 0 ≤ 4*s*d by positivity),
    mul_le_mul_of_nonneg_left ha₂ (sq_nonneg s)]

def Dyadic (κ : ℝ) : Prop := ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
  (κ-ε)*(Zeta23.Ncount T (2*T):ℝ) ≤ Zeta23.N0star T (2*T)

def Cumulative (κ : ℝ) : Prop := ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
  (κ-ε)*(Zeta23.Ncount 0 T:ℝ) ≤ Zeta23.N0star 0 T

theorem intervals {κ : ℝ} (h : ∀ᶠ T in atTop, κ*count T ≤ (Zeta23.N0star T (2*T):ℝ)) :
    Dyadic κ ∧ Cumulative κ := by
  have hd : Dyadic κ := by
    intro ε hε
    apply eventually_atTop.mp
    filter_upwards [h] with T hT
    change (κ-ε)*count T ≤ _
    linarith only [hT,mul_nonneg hε.le (show 0 ≤ count T from Nat.cast_nonneg _)]
  exact ⟨hd,Zeta23.cumulative_of_dyadic Zeta23.zetaSeam Zeta23.riemannVonMangoldt_zeta
    (fun _ _ _ => Zeta23.N0star_add' Zeta23.zetaSeam) hd⟩

theorem at_495 (hRH : RiemannHypothesis) (hf : MixedUpper (99/200) (-92479/1000000)) :
    Dyadic (22/25) ∧ Cumulative (22/25) := by
