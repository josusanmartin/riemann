namespace Reflected

abbrev c : ℝ := 1219/2500
abbrev d : ℝ := 11/50
abbrev a : ℝ := 429/1000
abbrev h : ℝ := 999/1000

def value (z w : ℂ) : ℝ := 1-(c-2*d*w.re-a*z.re)^2-(-2*d*w.im-a*z.im)^2

theorem occurrence (m : ℕ) (hm : 1 ≤ m) (z w : ℂ)
    (hz : m ≠ 1 → z=0) (hl : (m:ℝ) ≤ 1/h-2*w.re+1/1000) :
    (m:ℝ)*value z w ≤ 1 := by
  rcases eq_or_lt_of_le hm with h1 | h2
  · subst m
    simp only [Nat.cast_one, one_mul, value]
    nlinarith only [sq_nonneg (c-2*d*w.re-a*z.re), sq_nonneg (-2*d*w.im-a*z.im)]
  rw [hz (by omega)]
  simp only [value, Complex.zero_re, Complex.zero_im, mul_zero, sub_zero]
  have hr : (70711/100000:ℝ) ≤ c-2*d*w.re := by
    have hm2 : (2:ℝ) ≤ m := by exact_mod_cast (show 2 ≤ m by omega)
    norm_num [c,d,h] at hl ⊢
    linarith
  by_cases heq : m=2
  · subst m
    norm_num
    nlinarith only [hr, sq_nonneg (c-2*d*w.re-70711/100000), sq_nonneg (-2*d*w.im)]
  by_cases heq' : m=3
  · subst m
    have h3 : (9/10:ℝ) ≤ c-2*d*w.re := by
      norm_num [c,d,h] at hl ⊢
      linarith
    norm_num
    nlinarith only [h3, sq_nonneg (c-2*d*w.re-9/10), sq_nonneg (-2*d*w.im)]
  have hm4 : (4:ℝ) ≤ m := by exact_mod_cast (show 4 ≤ m by omega)
  have h4 : 1 ≤ c-2*d*w.re := by
    norm_num [c,d,h] at hl ⊢
    linarith
  have hn : 1-(c-2*d*w.re)^2-(-2*d*w.im)^2 ≤ 0 := by
    nlinarith only [h4,sq_nonneg (c-2*d*w.re-1),sq_nonneg (-2*d*w.im)]
  exact (mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg m) hn).trans (by norm_num)

/-- All quantities are occurrence-weighted, unnormalized sums. -/
theorem finite_count (T : ℝ) (z w : ℂ → ℂ)
    (hz : ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T), Zeta23.zeroMult ρ ≠ 1 → z ρ=0)
    (hl : ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult ρ:ℝ) ≤ 1/h-2*(w ρ).re+1/1000)
    (hm : (824999/1000000)*count T ≤ sumAt T (fun ρ => (z ρ).re))
    (hg : sumAt T (fun ρ => sq (z ρ)) ≤ (1561/1600)*count T)
    (hu : -(166501/1000000)*count T ≤ sumAt T (fun ρ => (w ρ).re))
    (hv : sumAt T (fun ρ => sq (w ρ)) ≤ (83334/1000000)*count T)
    (hr : sumAt T (fun ρ => (z ρ*(starRingEnd ℂ) (w ρ)).re) ≤ -(344/10000)*count T) :
    (8532/10000)*count T ≤ (Zeta23.Ndist T (2*T) : ℝ) := by
  have hs := Finset.sum_le_sum (s := ThirdMoment.zerosFinset T (2*T))
    (f := fun ρ => (Zeta23.zeroMult ρ : ℝ)*value (z ρ) (w ρ))
    (g := fun _ => (1:ℝ)) (fun ρ hρ => occurrence _ (ThirdMoment.one_le_mult_of_mem hρ) _ _
      (hz ρ hρ) (hl ρ hρ))
  simp only [Finset.sum_const, nsmul_eq_mul, mul_one] at hs
  have hb : (1-c^2)*count T + 4*c*d*sumAt T (fun ρ => (w ρ).re) -
      4*d^2*sumAt T (fun ρ => sq (w ρ)) + 2*a*c*sumAt T (fun ρ => (z ρ).re) -
      4*a*d*sumAt T (fun ρ => (z ρ*(starRingEnd ℂ) (w ρ)).re) -
      a^2*sumAt T (fun ρ => sq (z ρ)) ≤ (Zeta23.Ndist T (2*T) : ℝ) := by
    rw [ThirdMoment.Ndist_eq, count, ThirdMoment.Ncount_eq]
    unfold sumAt
    simp only [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine (Finset.sum_le_sum fun ρ _ => le_of_eq ?_).trans hs
    simp only [value, sq, Complex.mul_re, Complex.conj_re, Complex.conj_im]
    ring
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  unfold a c d at hb
  linarith

/-- The reflected bound uses the local estimate at bandwidth 999/1000. -/
theorem local_at_width (hRH : RiemannHypothesis) :
    ∀ᶠ T : ℝ in atTop, ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult ρ : ℝ) ≤ 1/h-2*(FejerMultiplicity.probe h T ρ).re+1/1000 :=
  FejerMultiplicity.local_bound hRH (b := h) (by norm_num) (by norm_num) (by norm_num)

#print axioms finite_count
end Reflected

namespace PrimePair

private abbrev center : ℝ := 59/50
private abbrev arch : ℝ := 100/99+1/100000
private abbrev coeff : ℝ := 1/(2*(2-center)^2)

def value (w : ℂ) : ℝ := 1-coeff*(arch-2*w.re-center)^2

theorem occurrence (m : ℕ) (hm : 1 ≤ m) (w : ℂ)
    (hl : (m:ℝ) ≤ 100/99-2*w.re+1/100000) :
    (m:ℝ)*value w ≤ 1 := by
  rcases eq_or_lt_of_le hm with h1 | h2
  · subst m
    simp only [Nat.cast_one, one_mul, value]
    nlinarith [sq_nonneg (arch-2*w.re-center),
      mul_nonneg (show 0 ≤ coeff by norm_num) (sq_nonneg (arch-2*w.re-center))]
  by_cases htwo : m=2
  · subst m
    have hs : (2-center)^2 ≤ (arch-2*w.re-center)^2 := by
      apply sq_le_sq' <;> unfold center arch <;> norm_num at hl ⊢ <;> linarith
    unfold value coeff center at *
    norm_num at *
    linarith
  · have h3 : (3:ℝ) ≤ m := by exact_mod_cast (show 3 ≤ m by omega)
    have hs : (3-center)^2 ≤ (arch-2*w.re-center)^2 := by
      apply sq_le_sq' <;> unfold center arch <;> linarith
    have hv : value w ≤ 0 := by
      unfold value coeff center at *
      norm_num at *
      linarith
    exact (mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg _) hv).trans (by norm_num)

theorem finite (T : ℝ)
    (hl : ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult ρ : ℝ) ≤ 100/99-2*(probe T ρ).re+1/100000)
    (hm : sumAt T (fun ρ => (probe T ρ).re) ≤ -(16499/100000)*count T)
    (hv : sumAt T (fun ρ => sq (probe T ρ)) ≤ (8334/100000)*count T)
    (hj : sumAt T (fun ρ => ((probe T ρ)^2).re) ≤ (247/10000)*count T) :
    (901/1000)*count T ≤ (Zeta23.Ndist T (2*T) : ℝ) := by
  have hs := Finset.sum_le_sum (s := ThirdMoment.zerosFinset T (2*T))
    (f := fun ρ => (Zeta23.zeroMult ρ : ℝ)*value (probe T ρ))
    (g := fun _ => (1:ℝ)) (fun ρ hρ =>
      occurrence _ (ThirdMoment.one_le_mult_of_mem hρ) _ (hl ρ hρ))
  simp only [Finset.sum_const, nsmul_eq_mul, mul_one] at hs
  have hu : (1-coeff*(arch-center)^2)*count T +
      (4*coeff*(arch-center))*sumAt T (fun ρ => (probe T ρ).re) -
      (2*coeff)*sumAt T (fun ρ => sq (probe T ρ)) -
      (2*coeff)*sumAt T (fun ρ => ((probe T ρ)^2).re) ≤
      (Zeta23.Ndist T (2*T) : ℝ) := by
    rw [ThirdMoment.Ndist_eq, count, ThirdMoment.Ncount_eq]
    unfold sumAt
    simp only [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine (Finset.sum_le_sum fun ρ _ => le_of_eq ?_).trans hs
    simp only [value, sq, pow_two, Complex.mul_re]
    ring
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  unfold coeff center arch at hu
  linarith

def Moments : Prop := ∀ᶠ T in atTop,
    sumAt T (fun ρ => (probe T ρ).re) ≤ -(16499/100000)*count T ∧
    sumAt T (fun ρ => sq (probe T ρ)) ≤ (8334/100000)*count T ∧
    sumAt T (fun ρ => ((probe T ρ)^2).re) ≤ (247/10000)*count T

theorem dyadic (hRH : RiemannHypothesis) (hb : Moments) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (901/1000-ε)*(Zeta23.Ncount T (2*T) : ℝ) ≤ Zeta23.N0star T (2*T) := by
  intro ε hε
  apply eventually_atTop.mp
  filter_upwards [hb,local_at_width hRH (ε := 1/100000) (by norm_num)] with T ⟨hm,hv,hj⟩ hl
  have h := finite T (by simpa only [show 1/width=(100/99 : ℝ) by norm_num] using hl) hm hv hj
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  rw [(Zeta23.RH_implies_all_on_line hRH _ _).2]
  change (901/1000-ε)*count T ≤ _
  linarith [mul_nonneg hε.le hn]

theorem cumulative (hRH : RiemannHypothesis) (hb : Moments) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (901/1000-ε)*(Zeta23.Ncount 0 T : ℝ) ≤ Zeta23.N0star 0 T :=
  Zeta23.cumulative_of_dyadic Zeta23.zetaSeam Zeta23.riemannVonMangoldt_zeta
    (fun _ _ _ => Zeta23.N0star_add' Zeta23.zetaSeam) (dyadic hRH hb)

abbrev Bin := Fin 12

/-- Upper square roots of the diagonal masses on the last twelve bins, scaled by 10^8. -/
def upper : Bin → ℚ :=
  ![7696339,7354570,6937915,6451720,5900500,5288140,
    4618050,3893318,3116915,2292210,1425221,549888]
def ratio (k : Bin) : ℚ := upper (Fin.rev k)/upper k
def step (k : Bin) : ℚ := ratio k -
  if k.val=0 then 0 else ratio ⟨k.val-1,by omega⟩

theorem step_nonneg : ∀ k, 0 ≤ step k := by decide +kernel

theorem reflected_cost : (∑ k, upper k*upper (Fin.rev k))/(10:ℚ)^16 < 19625/1000000 := by
  decide +kernel

/-- Coefficient of an ordered pair of active bins after the twelve products are removed. -/
def pairWeight (i j : Bin) : ℚ :=
  1 - ∑ k : Bin, if k ≤ i ∧ j ≤ Fin.rev k then step k*ratio j else 0

theorem pairWeight_eq (i j : Bin) : pairWeight i j =
    if 11 ≤ i.val+j.val then 0 else 1-ratio i*ratio j := by
  revert i j
  decide +kernel

theorem support (i j : Bin) (hc : pairWeight i j ≠ 0) :
    (9*((i.val:ℚ)+11)/200)+(9*((j.val:ℚ)+11)/200) ≤ 36/25 := by
  have hh : ¬ 11 ≤ i.val+j.val := by
    intro h
    exact hc (by rw [pairWeight_eq, if_pos h])
  have hs : (i.val:ℚ)+(j.val:ℚ) ≤ 10 := by exact_mod_cast (show i.val+j.val ≤ 10 by omega)
  linarith

def binProbe (i : Bin) (T : ℝ) (ρ : ℂ) : ℂ :=
  probeThrough (9*((i.val:ℝ)+11)/200) T ρ - probeThrough (9*((i.val:ℝ)+10)/200) T ρ

def leftBin (k : Bin) (T : ℝ) (ρ : ℂ) : ℂ :=
  ∑ i : Bin, if k ≤ i then binProbe i T ρ else 0

def rightBin (k : Bin) (T : ℝ) (ρ : ℂ) : ℂ :=
  ∑ i : Bin, if i ≤ Fin.rev k then (ratio i : ℂ)*binProbe i T ρ else 0

def retained (T : ℝ) (ρ : ℂ) : ℝ := ((probe T ρ)^2).re -
  ∑ k : Bin, (step k : ℝ)*(leftBin k T ρ*rightBin k T ρ).re

def normCost (T : ℝ) (ρ : ℂ) : ℝ :=
  ∑ k : Bin, (step k : ℝ)*((sq (leftBin k T ρ)+sq (rightBin k T ρ))/2)

theorem square_bound (T : ℝ) (ρ : ℂ) :
    ((probe T ρ)^2).re ≤ retained T ρ + normCost T ρ := by
  have hxy (z w : ℂ) : (z*w).re ≤ (sq z+sq w)/2 := by
    simp only [sq, Complex.mul_re]
    nlinarith only [sq_nonneg (z.re-w.re), sq_nonneg (z.im+w.im)]
  have h := Finset.sum_le_sum (s := (Finset.univ : Finset Bin))
    (fun k _ => mul_le_mul_of_nonneg_left (hxy (leftBin k T ρ) (rightBin k T ρ))
      (show (0:ℝ) ≤ (step k : ℝ) by exact_mod_cast step_nonneg k))
  unfold retained normCost
  linarith

/-- The remaining analytic estimates are explicit. The cost has a strict
    margin from the computable Hermitian second moments. -/
def BandBackground : Prop := ∀ᶠ T in atTop,
    sumAt T (fun ρ => (probe T ρ).re) ≤ -(16499/100000)*count T ∧
    sumAt T (fun ρ => sq (probe T ρ)) ≤ (8334/100000)*count T ∧
    sumAt T (normCost T) ≤ (1965/100000)*count T

def RetainedBound : Prop := ∀ᶠ T in atTop,
    sumAt T (retained T) ≤ (501/100000)*count T

theorem moments_of_bands (hb : BandBackground) (hr : RetainedBound) : Moments := by
  filter_upwards [hb,hr] with T ⟨hm,hv,hc⟩ hret
  refine ⟨hm,hv,?_⟩
  have hs : sumAt T (fun ρ => ((probe T ρ)^2).re) ≤
      sumAt T (retained T) + sumAt T (normCost T) := by
    unfold sumAt
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_le_sum
    intro ρ _
    rw [← mul_add]
    exact mul_le_mul_of_nonneg_left (square_bound T ρ) (Nat.cast_nonneg _)
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  linarith

theorem dyadic_bands (hRH : RiemannHypothesis) (hb : BandBackground) (hr : RetainedBound) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (901/1000-ε)*(Zeta23.Ncount T (2*T) : ℝ) ≤ Zeta23.N0star T (2*T) :=
  dyadic hRH (moments_of_bands hb hr)

theorem cumulative_bands (hRH : RiemannHypothesis) (hb : BandBackground) (hr : RetainedBound) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (901/1000-ε)*(Zeta23.Ncount 0 T : ℝ) ≤ Zeta23.N0star 0 T :=
  cumulative hRH (moments_of_bands hb hr)

