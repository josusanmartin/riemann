section Src_HighPrime


noncomputable section
open Filter
open scoped BigOperators Real

namespace HighPrime
open BHB.Arith

/-- The primitive character mean for G = 1 * (Λ log), at an arbitrary
    effective height S. The arbitrary log saving is needed when summing
    divisors of the original modulus. -/
theorem conductor_mean {σ : ℝ} (hσ : 0 < σ) (hσ' : σ < 1/2)
    (H : ℝ → ℝ) (hH : Adm H) (V : ℕ) :
    ∃ C S₀ : ℝ, 0 < C ∧ ∀ S ≥ S₀,
      ∑ f ∈ Finset.Icc 2 ⌊S^σ⌋₊,
        Asm.Xq H (seqA delta [0] 1) 1 S f / ((f:ℝ)*Real.sqrt f)
        ≤ C*S/(Real.log S)^V := by
  obtain ⟨Cl,Sl,c,hCl,hl⟩ := LCU_seqA hσ hσ' H hH
  let A : ℝ := 2*((c:ℝ)+V+1)
  let B : ℝ := 2*A+V
  have hA : 1 ≤ A := by dsimp [A]; linarith [Nat.cast_nonneg (α:=ℝ) c, Nat.cast_nonneg (α:=ℝ) V]
  have hB : 0 < B := by dsimp [B]; linarith [Nat.cast_nonneg (α:=ℝ) V]
  obtain ⟨Cs,Ss,hCs,hs⟩ := SCU_seqA hσ hσ' H hH A B (by linarith) hB
  have hε : 0 < eps σ := by unfold eps; linarith
  obtain ⟨Se,_,he⟩ := eventually_rpow_neg_mul_log_pow_le hε (c+V+1)
  refine ⟨6*(Cs+2*Cl), max (max Sl Ss) (max Se (Real.exp 2)), by positivity, ?_⟩
  intro S hS
  have h1 : Sl ≤ S := (le_max_left ..).trans ((le_max_left ..).trans hS)
  have h2 : Ss ≤ S := (le_max_right ..).trans ((le_max_left ..).trans hS)
  have h3 : Se ≤ S := (le_max_left ..).trans ((le_max_right ..).trans hS)
  have h4 : Real.exp 2 ≤ S := (le_max_right ..).trans ((le_max_right ..).trans hS)
  have hSpos := (Real.exp_pos 2).trans_le h4
  have hL2 := (Real.le_log_iff_exp_le hSpos).mpr h4
  have hL : 0 < Real.log S := by linarith
  have hS1 : 1 ≤ S := by linarith [Real.add_one_le_exp (2:ℝ)]
  have hd := SuppLe_delta (Real.one_le_rpow hS1 hσ.le)
  have hsc := hs S h2 delta [0] 1 DB_delta hd (by simp) (by simp) le_rfl
  have hlc := hl S h1 delta [0] 1 DB_delta hd (by simp) (by simp) le_rfl
  have hmain := Asm.inner_q_sum_le hσ hσ' H h4 _ hA (by positivity) (by positivity)
    hsc hlc (g:=1) (r:=1) le_rfl le_rfl
  have hrd : rd (seqA delta [0] 1) 1 1 = seqA delta [0] 1 := by funext n; simp [rd]
  simp only [hrd, wt, dtau_one_right, one_pow, one_mul, Nat.div_one, Nat.cast_one] at hmain
  refine hmain.trans ?_
  have hpowB : Real.log S ^ B = Real.log S ^ (2*A) * (Real.log S)^V := by
    rw [show B = 2*A+(V:ℝ) from rfl, Real.rpow_add hL, Real.rpow_natCast]
  have hpowA : Real.log S ^ (-(A/2)) = ((Real.log S)^c*(Real.log S)^V*Real.log S)⁻¹ := by
    rw [Real.rpow_neg hL.le, show A/2 = ((c+V+1:ℕ):ℝ) by dsimp [A]; push_cast; ring,
      Real.rpow_natCast, pow_succ, pow_add]
  have hE := he S h3
  rw [pow_succ, pow_add] at hE
  have hX := Real.rpow_pos_of_pos hL (2*A)
  have hP := pow_pos hL c
  have hV := pow_pos hL V
  have hfirst : Cs / Real.log S ^ B * Real.log S ^ (2*A) * Real.log S^V = Cs := by
    rw [hpowB]; field_simp
  have hsecond : Real.log S^c * Real.log S ^ (-(A/2)) * Real.log S^V ≤ 1 := by
    rw [hpowA]; field_simp; nlinarith [mul_pos hP hV, mul_nonneg (mul_pos hP hV).le (by linarith : 0 ≤ Real.log S - 1)]
  have hthird : Real.log S^c * (S ^ (-eps σ) * Real.log S) * Real.log S^V ≤ 1 := by
    convert hE using 1; ring
  rw [le_div_iff₀ hV]
  calc
    _ = 6*S*(Cs + Cl*(Real.log S^c*Real.log S^(-(A/2))*Real.log S^V
      + Real.log S^c*(S^(-eps σ)*Real.log S)*Real.log S^V)) := by
        conv_rhs => rw [← hfirst]
        ring
    _ ≤ 6*S*(Cs+Cl*2) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      linarith [mul_le_mul_of_nonneg_left (add_le_add hsecond hthird) hCl.le]
    _ = _ := by ring

/-- Above the Möbius cutoff a divisor of p*h must contain the explicit prime.
    Its complementary cofactor is smaller than p and coprime to the conductor. -/
theorem conductor_factor {p h f : ℕ} (hp : p.Prime) (hh : 0 < h) (hf : h < f)
    (hs : Squarefree h) (hd : f ∣ p*h) :
    ∃ u j : ℕ, f = p*u ∧ h = u*j ∧ j < p ∧ Nat.Coprime j f := by
  have hpf : p ∣ f := by
    by_contra hn
    have hc := (hp.coprime_iff_not_dvd.mpr hn).symm
    have hfh : f ∣ h := hc.dvd_of_dvd_mul_left hd
    exact (Nat.not_le_of_lt hf) (Nat.le_of_dvd hh hfh)
  obtain ⟨u, rfl⟩ := hpf
  obtain ⟨j, rfl⟩ := (Nat.mul_dvd_mul_iff_left hp.pos).mp hd
  have hj : 0 < j := Nat.pos_of_ne_zero fun hz => by simp [hz] at hh
  have hjp : j < p := Nat.lt_of_mul_lt_mul_left (by simpa [Nat.mul_comm p u] using hf : u*j < u*p)
  exact ⟨u,j,rfl,rfl,hjp, (Nat.coprime_of_lt_prime hj.ne' hjp hp).symm.mul_right
    (Nat.coprime_of_squarefree_mul hs).symm⟩

/-- Product coefficients after conjugating the first Dirichlet polynomial. -/
def joinedCoeffs (A B : Finset ℕ) (a b : ℕ → ℂ) (k : ℕ) : ℂ :=
  ∑ t ∈ (A ×ˢ B).filter (fun t => t.1*t.2=k), (starRingEnd ℂ) (a t.1) * b t.2

private theorem joined_norm (A B : Finset ℕ) (a b : ℕ → ℂ) (K : ℕ)
    (hk : ∀ i ∈ A, ∀ j ∈ B, i*j ∈ Finset.Ioc 0 K)
    {q : ℕ} (χ : DirichletCharacter ℂ q) :
    ‖∑ i ∈ A, a i * (starRingEnd ℂ) (χ (i : ZMod q))‖ *
      ‖∑ j ∈ B, b j * χ (j : ZMod q)‖ =
    ‖∑ k ∈ Finset.Ioc 0 K, joinedCoeffs A B a b k * χ (k : ZMod q)‖ := by
  classical
  have hmap : ∀ t ∈ A ×ˢ B, t.1*t.2 ∈ Finset.Ioc 0 K :=
    fun t ht => hk _ (Finset.mem_product.mp ht).1 _ (Finset.mem_product.mp ht).2
  have hc : ‖∑ i ∈ A, a i * (starRingEnd ℂ) (χ (i : ZMod q))‖ =
      ‖∑ i ∈ A, (starRingEnd ℂ) (a i) * χ (i : ZMod q)‖ := by
    rw [← RCLike.norm_conj (∑ i ∈ A, a i * (starRingEnd ℂ) (χ (i : ZMod q)))]
    simp
  rw [hc, ← norm_mul, Finset.sum_mul_sum]
  apply congrArg (fun z : ℂ => ‖z‖)
  rw [← Finset.sum_product (f := fun t : ℕ × ℕ =>
    (starRingEnd ℂ) (a t.1) * χ (t.1 : ZMod q) * (b t.2 * χ (t.2 : ZMod q)))]
  rw [← Finset.sum_fiberwise_of_maps_to hmap]
  apply Finset.sum_congr rfl
  intro k hk'
  unfold joinedCoeffs
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro t ht
  rw [← (Finset.mem_filter.mp ht).2, Nat.cast_mul, map_mul]
  ring

open scoped Classical in
/-- A mixed three-factor character mean with the first two factors grouped
    before the multiplicative large sieve. The bound uses their product length. -/
theorem mixed_large_sieve (Q K M N : ℕ) (A B : Finset ℕ) (a b c : ℕ → ℂ)
    (hk : ∀ i ∈ A, ∀ j ∈ B, i*j ∈ Finset.Ioc 0 K) :
    ∑ q ∈ Finset.Icc 1 Q, ((q:ℝ)/(Nat.totient q:ℝ)) *
      ∑ χ ∈ (Finset.univ : Finset (DirichletCharacter ℂ q)).filter (fun χ => χ.IsPrimitive),
        (‖∑ i ∈ A, a i * (starRingEnd ℂ) (χ (i : ZMod q))‖ *
          ‖∑ j ∈ B, b j * χ (j : ZMod q)‖) *
          ‖∑ n ∈ Finset.Ioc M (M+N), c n * χ (n : ZMod q)‖ ≤
      Real.sqrt ((Real.pi*K+(Q:ℝ)^2)*(Real.pi*N+(Q:ℝ)^2)) *
        Real.sqrt (∑ k ∈ Finset.Ioc 0 K, ‖joinedCoeffs A B a b k‖^2) *
        Real.sqrt (∑ n ∈ Finset.Ioc M (M+N), ‖c n‖^2) := by
  simp_rw [joined_norm A B a b K hk]
  simpa using BHB.large_sieve_bilinear Q 0 K M N (joinedCoeffs A B a b) c

/-- Inclusion-exclusion on the prime divisors, expressed in log coordinates. -/
def divisorDifference (w : ℕ → ℝ) (s : Finset ℕ) (g : ℝ → ℝ) (x : ℝ) : ℝ :=
  ∑ t ∈ s.powerset, (-1:ℝ)^t.card * g (x + ∑ j ∈ t, w j)

private theorem divisorDifference_insert (w : ℕ → ℝ) {s : Finset ℕ} {p : ℕ}
    (hp : p ∉ s) (g : ℝ → ℝ) (x : ℝ) :
    divisorDifference w (insert p s) g x =
      divisorDifference w s (fun v => g v - g (v+w p)) x := by
  classical
  unfold divisorDifference
  rw [Finset.sum_powerset_insert hp, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro t ht
  have hpt : p ∉ t := fun h => hp (Finset.mem_powerset.mp ht h)
  rw [Finset.card_insert_of_notMem hpt, Finset.sum_insert hpt, pow_succ]
  rw [show x + (w p + ∑ j ∈ t, w j) = (x + ∑ j ∈ t, w j) + w p by ring]
  ring

/-- Two distinct prime divisors leave exactly their logarithmic product. -/
theorem class_two_primes {p q : ℕ} (hpq : p ≠ q) (w : ℕ → ℝ) (b c x : ℝ) :
    divisorDifference w {p,q} (fun v => v^2/2+b*v+c) x = w p*w q := by
  rw [divisorDifference_insert w (by simpa using hpq)]
  rw [show ({q} : Finset ℕ) = insert q ∅ by rfl, divisorDifference_insert w (by simp)]
  simp [divisorDifference]
  ring

/-- Any three distinct prime factors cancel the quadratic prime-height integral. -/
theorem class_three_primes {p q r : ℕ} {s : Finset ℕ} (w : ℕ → ℝ)
    (hp : p ∉ insert q (insert r s)) (hq : q ∉ insert r s) (hr : r ∉ s)
    (b c x : ℝ) :
    divisorDifference w (insert p (insert q (insert r s))) (fun v => v^2/2+b*v+c) x = 0 := by
  rw [divisorDifference_insert w hp, divisorDifference_insert w hq, divisorDifference_insert w hr]
  unfold divisorDifference
  apply Finset.sum_eq_zero
  intro t ht
  ring

/-- One divisor-bounded factor lies between sqrt(T) and A₀. Cutting the
    other factor at A₀ gives a Type II sum and a rapidly decaying tail. -/
theorem large_conductor_band {θ : ℝ} (hθ : 0 < θ) (hθ' : θ < 1/2)
    (H : ℝ → ℝ) (hH : Adm H) (s : ℕ) :
    ∃ (C T₀ : ℝ) (c : ℕ), 0 < C ∧ ∀ T ≥ T₀, ∀ (g : ℕ) (B D : ℝ) (p a : ℕ → ℝ),
      1 ≤ g → 0 ≤ B → 0 ≤ D → DB s B p → DB s D a →
      SuppGt (Real.sqrt T / g) p → SuppLe (A0 θ T) p →
      LCB θ H T g (dconv p a) (C*B*D*Real.log T^c) := by
  obtain ⟨C₁,T₁,c,hC₁,h₁⟩ := LCB_typeII hθ hθ' H hH s
  obtain ⟨C₂,T₂,hC₂,h₂⟩ := LCB_tail hθ hθ' H hH (s+s)
  refine ⟨C₁+C₂, max (max T₁ T₂) (Real.exp 1), c, by positivity, ?_⟩
  intro T hT g B D p a hg hB hD hp ha hlow hupp
  have he : Real.exp 1 ≤ T := (le_max_right ..).trans hT
  have hT1 : 1 ≤ T := (by linarith [Real.add_one_le_exp (1:ℝ)] : 1 ≤ Real.exp 1).trans he
  have hT0 : 0 < T := by linarith
  have hL : 1 ≤ Real.log T := by
    rw [← Real.log_exp 1]; exact Real.log_le_log (Real.exp_pos 1) he
  have hg0 : 0 < (g:ℝ) := by exact_mod_cast (by omega : 0 < g)
  have hA : 0 ≤ A0 θ T := by unfold A0; positivity
  have hdb := hp.dconv (ha.cut hD (A0 θ T)) hB hD
  have hdb' := hp.dconv (ha.cutgt hD (A0 θ T)) hB hD
  have hsup : SuppGt (X0 θ T / g) (dconv p (cutgt (A0 θ T) a)) := by
    apply T2.suppGt_mono (hlow.dconv (SuppGt_cutgt (A0 θ T) a) (by positivity) hA)
    rw [div_mul_eq_mul_div, mul_comm (Real.sqrt T)]
    exact div_le_div_of_nonneg_right (T2.X0_le_A0_mul_sqrt hθ' hT1) hg0.le
  have hsmall := h₁ T ((le_max_left T₁ T₂).trans ((le_max_left ..).trans hT)) g B D p
    (cut (A0 θ T) a) hg hB hD hp (ha.cut hD _) hupp (SuppLe_cut _ _)
  have htail := h₂ T ((le_max_right T₁ T₂).trans ((le_max_left ..).trans hT)) g (B*D)
    _ hg (mul_nonneg hB hD) hdb' hsup
  have hh := T2.LCB_add hH hT0 ⟨_,_,hdb⟩ ⟨_,_,hdb'⟩ hsmall htail
  rw [← dconv_add_right, cut_add_cutgt] at hh
  apply LCB.mono hh _ hT0
  have hc := one_le_pow₀ hL (n := c)
  have hpos : 0 ≤ C₂*(B*D) := by positivity
  have hbd := (div_le_self hpos hT1).trans (le_mul_of_one_le_right hpos hc)
  linarith only [hbd]

/-- The distinguished ordinary prime in the long part of the reflected mean. -/
def reflectedBand (h T : ℝ) (n : ℕ) : ℝ :=
  if n.Prime ∧ Real.sqrt T < (n:ℝ) ∧ (n:ℝ) ≤ T^h then
    let u := Real.log n / (h*Real.log T)
    u*(1-u)
  else 0

lemma reflectedBand_DB {h T : ℝ} (hh : 0 < h) (hT : 1 < T) :
    DB 2 1 (reflectedBand h T) := by
  intro n
  unfold reflectedBand
  split_ifs with hn
  · have hn₀ : 0 < (n:ℝ) := by exact_mod_cast hn.1.pos
    have hden := mul_pos hh (Real.log_pos hT)
    have hlog := Real.log_natCast_nonneg n
    have hu : Real.log n/(h*Real.log T) ≤ 1 := by
      rw [div_le_one hden]
      simpa only [Real.log_rpow (by linarith : 0 < T)] using Real.log_le_log hn₀ hn.2.2
    have hl := div_nonneg hlog hden.le
    rw [abs_of_nonneg (mul_nonneg hl (sub_nonneg.mpr hu))]
    calc
      _ ≤ 1 := by nlinarith [sq_nonneg (Real.log n/(h*Real.log T))]
      _ ≤ 1*(1+Real.log n)^2*dtau 2 n := by
        have ha : 1 ≤ (1+Real.log n)^2 := by nlinarith [sq_nonneg (Real.log n)]
        simpa using one_le_mul_of_one_le_of_one_le ha (one_le_dtau (s:=2) (by decide) hn.1.ne_zero)
  · rw [abs_zero]
    positivity [dtau_nonneg 2 n]

theorem reduced_kap2_DB {g : ℕ} (hg : 1 ≤ g) (r : ℕ) :
    DB 2 ((1+Real.log g)^2) (rd BHB.MT.kap2 g r) := by
  intro n
  have hg₀ : (g:ℝ) ≠ 0 := by exact_mod_cast (show g ≠ 0 by omega)
  have hglog := Real.log_natCast_nonneg g
  have hnlog := Real.log_natCast_nonneg n
  by_cases hn : n = 0
  · subst n
    simp [rd,BHB.MT.kap2,dtau]
  unfold rd
  split_ifs
  · have hn₀ : (n:ℝ) ≠ 0 := by exact_mod_cast hn
    rw [abs_of_nonneg (BHB.MT.RE.kap2_nonneg _)]
    have hk := BHB.MT.RE.kap2_le (g*n)
    rw [Nat.cast_mul,Real.log_mul hg₀ hn₀] at hk
    have hu : Real.log g+Real.log n ≤ (1+Real.log g)*(1+Real.log n) := by
      nlinarith [mul_nonneg hglog hnlog]
    have hs := pow_le_pow_left₀ (add_nonneg hglog hnlog) hu 2
    rw [mul_pow] at hs
    exact (hk.trans hs).trans (le_mul_of_one_le_right (by positivity) (one_le_dtau (by decide) hn))
  · rw [abs_zero]
    positivity [dtau_nonneg 2 n]

/-- Large-conductor estimate for the actual tapered prime and shifted
von Mangoldt divisor sum in the reflected mean. The coprimality mask
can be chosen separately for each complementary conductor. -/
theorem reflected_large_conductor {θ h : ℝ} (hθ : 0 < θ) (hθ' : θ < 1/2)
    (hh : 0 < h) (hband : h ≤ 1-3*eps θ) (H : ℝ → ℝ) (hH : Adm H) :
    ∃ (C T₀ : ℝ) (c : ℕ), 0 < C ∧ ∀ T ≥ T₀, ∀ (g r : ℕ), 1 ≤ g →
      LCB θ H T g (dconv (reflectedBand h T) (rd BHB.MT.kap2 g r))
        (C*(1+Real.log g)^2*Real.log T^c) := by
  obtain ⟨C,T₀,c,hC,hlarge⟩ := large_conductor_band hθ hθ' H hH 2
  refine ⟨C,max 2 T₀,c,hC,?_⟩
  intro T hT g r hg
  have hT₂ : 2 ≤ T := (le_max_left ..).trans hT
  have hT₁ : 1 < T := by linarith
  have hg₁ : 1 ≤ (g:ℝ) := by exact_mod_cast hg
  have hlow : SuppGt (Real.sqrt T/g) (reflectedBand h T) := by
    intro n hn
    have hu := hn.trans (div_le_self (Real.sqrt_nonneg T) hg₁)
    simp [reflectedBand,not_lt.mpr hu]
  have hhigh : SuppLe (A0 θ T) (reflectedBand h T) := by
    intro n hn
    have hu : T^h < (n:ℝ) := (Real.rpow_le_rpow_of_exponent_le hT₁.le hband).trans_lt hn
    simp [reflectedBand,not_le.mpr hu]
  simpa only [mul_one] using hlarge T ((le_max_right ..).trans hT) g 1 ((1+Real.log g)^2)
    _ _ hg zero_le_one (sq_nonneg _) (reflectedBand_DB hh hT₁) (reduced_kap2_DB hg r) hlow hhigh

open scoped Classical in
/-- Sum the primitive conductor blocks with their Gauss weights. The
threshold M may grow as any fixed power of log T. -/
theorem reflected_conductor_tail {θ h : ℝ} (hθ : 0 < θ) (hθ' : θ < 1/2)
    (hh : 0 < h) (hband : h ≤ 1-3*eps θ) (H : ℝ → ℝ) (hH : Adm H) :
    ∃ (C T₀ : ℝ) (c : ℕ), 0 < C ∧ ∀ T ≥ T₀, ∀ (g r N : ℕ) (M : ℝ),
      1 ≤ g → 1 ≤ r → 1 ≤ M → ((g*r*N:ℕ):ℝ) ≤ T^θ →
      (∑ q ∈ (Finset.Icc 2 N).filter (fun q : ℕ => M < (q:ℝ)),
        Asm.Xq H (dconv (reflectedBand h T) (rd BHB.MT.kap2 g r)) r T q /
          ((q:ℝ)*Real.sqrt q)) ≤
        C*(1+Real.log g)^2*Real.log T^c*(r*T)*
          (6/Real.sqrt M+((Nat.log 2 N+1:ℕ):ℝ)*T^(-eps θ)) := by
  obtain ⟨C,T₀,c,hC,hl⟩ := reflected_large_conductor hθ hθ' hh hband H hH
  refine ⟨C,max 2 T₀,c,hC,?_⟩
  intro T hT g r N M hg hr hM hN
  have hT₂ : 2 ≤ T := (le_max_left ..).trans hT
  have hT₁ : 1 ≤ T := by linarith
  have hlog := Real.log_nonneg hT₁
  let b := dconv (reflectedBand h T) (rd BHB.MT.kap2 g r)
  let X := fun q : ℕ => if M < (q:ℝ) then Asm.Xq H b r T q else 0
  have hX (q : ℕ) : 0 ≤ X q := by dsimp [X]; split <;> simp [Asm.Xq_nonneg]
  have hlo (q : ℕ) (_ : 2 ≤ q) (_ : q ≤ N) (hq : (q:ℝ) ≤ M) : X q ≤ 0*(q:ℝ)^2 := by
    simp [X,not_lt.mpr hq]
  have hup (Q : ℕ) (hQ : 1 ≤ Q) (hQN : Q < N) :
      (∑ q ∈ Finset.Ioc Q (2*Q), X q) ≤
        (C*(1+Real.log g)^2*Real.log T^c*(r*T))*
          (Q+Q*Real.sqrt Q*T^(-eps θ)) := by
    have hc : ((g*r*Q:ℕ):ℝ) ≤ T^θ :=
      le_trans (by exact_mod_cast Nat.mul_le_mul_left (g*r) hQN.le) hN
    have hb := hl T ((le_max_right ..).trans hT) g r hg r Q hr hQ hc
    rw [Asm.P0_eq_sum_Xq,Asm.rpow_three_halves (by exact_mod_cast (show 0<Q by omega))] at hb
    have hx (q : ℕ) : X q ≤ Asm.Xq H b r T q := by
      dsimp [X]; split <;> simp [Asm.Xq_nonneg]
    exact (Finset.sum_le_sum (fun q _ => hx q)).trans (hb.trans_eq (by ring))
  have ht := Asm.dyadic_sum_le N hM (le_refl 0) (by positivity)
    (Real.rpow_nonneg (by linarith : 0 ≤ T) _) X hX hlo hup
  simpa [X,b,Finset.sum_filter,ite_div] using ht

/-- The logarithmically tapered Möbius sum over squarefree divisors, with
    each prime represented by its scaled logarithm. -/
def taperedMobius (v : ℕ → ℝ) (s : Finset ℕ) : ℝ :=
  ∑ t ∈ s.powerset, (-1:ℝ)^t.card * max (1 - ∑ j ∈ t, v j) 0

/-- Pair divisors that differ in the distinguished prime. Its scaled
    logarithm bounds the change in the taper of each pair. -/
theorem taperedMobius_pair (v : ℕ → ℝ) (s : Finset ℕ) (p : ℕ) (hp : p ∉ s)
    (hv : 0 ≤ v p) : |taperedMobius v (insert p s)| ≤ (2:ℝ)^s.card * v p := by
  classical
  unfold taperedMobius
  rw [Finset.sum_powerset_insert hp, ← Finset.sum_add_distrib]
  calc
    _ ≤ ∑ t ∈ s.powerset, |(-1:ℝ)^t.card * max (1 - ∑ j ∈ t, v j) 0 +
          (-1:ℝ)^(insert p t).card * max (1 - ∑ j ∈ insert p t, v j) 0| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _t ∈ s.powerset, v p := by
      apply Finset.sum_le_sum
      intro t ht
      have hpt : p ∉ t := fun h => hp (Finset.mem_powerset.mp ht h)
      rw [Finset.card_insert_of_notMem hpt, Finset.sum_insert hpt, pow_succ]
      let x := ∑ j ∈ t, v j
      change |(-1:ℝ)^t.card * max (1-x) 0 +
        ((-1:ℝ)^t.card * -1) * max (1-(v p+x)) 0| ≤ v p
      rw [show (-1:ℝ)^t.card * max (1-x) 0 + ((-1:ℝ)^t.card * -1) * max (1-(v p+x)) 0 =
        (-1:ℝ)^t.card * (max (1-x) 0 - max (1-(v p+x)) 0) by ring,
        abs_mul, abs_pow]
      simp only [abs_neg, abs_one, one_pow, one_mul]
      apply abs_le.mpr
      simp only [max_def]
      split_ifs <;> constructor <;> linarith
    _ = _ := by simp

abbrev theta : ℝ := 499/1000
abbrev eta : ℝ := 14/25
abbrev scale : ℝ := 13/12

def detector (T : ℝ) (s : ℂ) : ℂ := deriv riemannZeta s *
  (∑ k ∈ BHB.Krange theta T, ((ArithmeticFunction.moebius k : ℝ) *
    (1 - Real.log k/(theta*Real.log T)) : ℝ) * (k:ℂ)^(-s)) / (Real.log T : ℂ)

def primeTest (T : ℝ) (s : ℂ) : ℂ := ∑ p ∈ BHB.Krange eta T,
  if p.Prime ∧ ((p:ℝ) ≤ T^theta ∨ Real.sqrt T < (p:ℝ)) then
    ((Real.log p/Real.log T * (1-Real.log p/Real.log T)) : ℝ) * (p:ℂ)^(-s) else 0

def normSq (a : ℂ) : ℝ := a.re^2+a.im^2

/-- Bound the signed square using a real short polynomial as a test. -/
theorem negative_square_bound (w : ℂ) (u c : ℝ) :
    -(w*w).re ≤ normSq w - 4*c*w.re*(1+2*u) + 2*c^2*(1+2*u)^2 := by
  simp only [Complex.mul_re, normSq]
  nlinarith only [sq_nonneg (w.re-c*(1+2*u))]

def moment (f : ℂ → ℂ → ℝ) (T : ℝ) : ℝ :=
  ∑ ρ ∈ ThirdMoment.zerosFinset T (2*T), (Zeta23.zeroMult ρ : ℝ) * f (detector T ρ) (primeTest T ρ)

def reverse (a z : ℂ) : ℝ := a.re*z.re+a.im*z.im

def forward (a z : ℂ) : ℝ := (z*(a-z)).re

def squareCost (a z : ℂ) : ℝ := normSq a - 2*reverse a z + 2*normSq z + 2*forward a z

theorem squareCost_eq (a z : ℂ) : squareCost a z = a.re^2+(a.im-2*z.im)^2 := by
  simp [squareCost, normSq, reverse, forward, Complex.mul_re]; ring

theorem support (T : ℝ) : 2*scale * moment (fun a _ => a.re) T - scale^2 *
    (moment (fun a _ => normSq a) T - 2*moment reverse T + 2*moment (fun _ z => normSq z) T
      + 2*moment forward T) ≤ Zeta23.Nsimple T (2*T) := by
  classical
  rw [ThirdMoment.Nsimple_eq]
  have hc : (((ThirdMoment.zerosFinset T (2*T)).filter (fun ρ => Zeta23.zeroMult ρ = 1)).card : ℝ)
      = ∑ ρ ∈ ThirdMoment.zerosFinset T (2*T), (if Zeta23.zeroMult ρ = 1 then (1:ℝ) else 0) := by
    rw [Finset.sum_boole]
  rw [hc]
  simp only [moment, Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro ρ hρ
  let a := detector T ρ
  let z := primeTest T ρ
  have heq := squareCost_eq a z
  unfold squareCost at heq
  by_cases hm : Zeta23.zeroMult ρ = 1
  · simp only [hm, Nat.cast_one, one_mul, if_true]
    change 2*scale*a.re-scale^2*(_-2*reverse a z+2*normSq z+2*forward a z) ≤ 1
    rw [heq]
    nlinarith only [sq_nonneg (1-scale*a.re), sq_nonneg (scale*(a.im-2*z.im))]
  · let v : Zeta23.zetaZeroConfig.carrier := ⟨ρ,(ThirdMoment.mem_zerosFinset.mp hρ).1⟩
    have hd : deriv riemannZeta ρ = 0 := BHB.Red.deriv_zeta_eq_zero_of_mult_ne_one v hm
    have hz : a = 0 := by simp [a, detector, hd]
    have hs : 2*scale*a.re-scale^2*squareCost a z ≤ 0 := by
      rw [squareCost_eq, hz]; simp; positivity
    have hmul := mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg (α:=ℝ) (Zeta23.zeroMult ρ)) hs
    unfold squareCost at hmul
    simp only [hm, if_false]
    dsimp [a,z] at hmul
    linarith only [hmul]

abbrev count (T : ℝ) : ℝ := Zeta23.Ncount T (2*T)

def Background : Prop := ∀ᶠ T in atTop,
  74949/100000*count T ≤ moment (fun a _ => a.re) T ∧
  moment (fun a _ => normSq a) T ≤ 81209/100000*count T ∧
  2212/100000*count T ≤ moment reverse T ∧
  moment (fun _ z => normSq z) T ≤ 6419/100000*count T

def ForwardBound : Prop := ∀ᶠ T in atTop, moment forward T ≤ -(103/1000)*count T

theorem simple (hb : Background) (hf : ForwardBound) : ThirdMoment.SimpleLower (81383/100000) := by
  intro ε hε
  apply eventually_atTop.mp
  filter_upwards [hb,hf] with T ⟨h1,h2,hr,hz⟩ hu
  have hn := Nat.cast_nonneg (α:=ℝ) (Zeta23.Ncount T (2*T))
  have hc := support T
  unfold scale at hc
  unfold count at h1 h2 hr hz hu
  linarith [mul_nonneg hε.le hn]

theorem dyadic (hRH : RiemannHypothesis) (hb : Background) (hf : ForwardBound) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (1801/2000-ε)*(Zeta23.Ncount T (2*T) : ℝ) ≤ Zeta23.N0star T (2*T) := by
  have h := ThirdMoment.distinct_of_budget_simple (t:=9/8) (by norm_num) (by norm_num)
    (TMG.budget_dyadic hRH TMG.W1 (by norm_num)) (simple hb hf)
  have hk : (1801/2000 : ℝ) ≤ ThirdMoment.Ac (9/8)*(81383/100000)+1-ThirdMoment.Ac (9/8)
      -ThirdMoment.Bc (9/8)*TMG.Kt TMG.W1 (9/8) := by
    unfold ThirdMoment.Ac ThirdMoment.Bc TMG.Kt
    rw [TMG.C2_W1,TMG.C3_W1]; norm_num
  intro ε hε
  obtain ⟨T₀,hh⟩ := h ε hε
  refine ⟨T₀, fun T ht => ?_⟩
  rw [(Zeta23.RH_implies_all_on_line hRH _ _).2]
  exact (mul_le_mul_of_nonneg_right (sub_le_sub_right hk _) (Nat.cast_nonneg _)).trans (hh T ht)

theorem cumulative (hRH : RiemannHypothesis) (hb : Background) (hf : ForwardBound) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (1801/2000-ε)*(Zeta23.Ncount 0 T : ℝ) ≤ Zeta23.N0star 0 T :=
  Zeta23.cumulative_of_dyadic Zeta23.zetaSeam Zeta23.riemannVonMangoldt_zeta
    (fun _ _ _ => Zeta23.N0star_add' Zeta23.zetaSeam) (dyadic hRH hb hf)

