  have h3 : ContinuousOn (fun ε : ℂ => (10979 / 75000 : ℂ) * ly * (exp ((L₀ : ℂ) * ε) / ε ^ (2 + 1)))
      (sqBdy r) := continuousOn_const.mul (hc (2 + 1))
  have h4 : ContinuousOn (fun ε : ℂ => (3969 / 20000 : ℂ) * ly ^ 2 * (exp ((L₀ : ℂ) * ε) / ε ^ (1 + 1)))
