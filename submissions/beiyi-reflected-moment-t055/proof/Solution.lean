theorem _root_.Taper78.BHB.MTP.JJ_approx (hRH : RiemannHypothesis) (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ' : θ < 1 / 2) :
    ∃ C T₀ : ℝ, 0 ≤ C ∧ ∀ T ≥ T₀, ∀ α ν β ww : ℂ, ‖α‖ ≤ rhoT T → ‖ν‖ ≤ rhoT T → ‖β‖ ≤ rhoT T →
      ‖ww‖ ≤ rhoT T →
      ‖Taper78.BHB.MTP.JJ w.h θ T α ν β ww - Taper78.BHB.MTP.JJlead w.kap1 θ T α ν β ww‖ ≤ C / Real.log T := by
  obtain ⟨K, T₁, hK, hdiff⟩ := Taper78.BHB.MTP.integrand_diff_le hRH w hθ hθ'
  obtain ⟨T₂, hcont⟩ := Taper78.BHB.MTP.continuousOn_JJ_integrand hRH w θ
  refine ⟨K, max (max T₁ T₂) 2, hK, ?_⟩
  intro T hT α ν β ww hα hν hβ hww
  have hT1 : T₁ ≤ T := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hT
  have hT2 : T₂ ≤ T := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hT
  have hT3 : (1 : ℝ) < T := lt_of_lt_of_le (by norm_num) (le_trans (le_max_right _ _) hT)
  have hL : 0 < Real.log T := Real.log_pos hT3
  have hρ := rhoT_pos hT3
  have hr : (0 : ℝ) ≤ 4 * rhoT T := by positivity
  set f : ℂ → ℂ := fun ε => Ht w.h (1 + ε) * ((T / (2 * π) : ℝ) : ℂ) ^ ε * Zsh α ν β (1 + ε)
    * Taper78.BHB.MTP.SS (ymol θ T) ε α ν β ww with hf
  set g : ℂ → ℂ := fun ε => exp (ε * (L0 T : ℝ))
    * (Zl ε α ν β * Taper78.BHB.MTP.SSlead (Real.log (ymol θ T)) ε α ν β ww) with hg
  have hfc : ContinuousOn f (sqBdy (4 * rhoT T)) := hcont T hT2 α ν β ww hα hν hβ hww
  have hgc : ContinuousOn g (sqBdy (4 * rhoT T)) := Taper78.BHB.MTP.continuousOn_JJlead_integrand θ hT3 hα hν hβ
  have hgc' : ContinuousOn (fun ε => (w.kap1 : ℂ) * g ε) (sqBdy (4 * rhoT T)) :=
    continuousOn_const.mul hgc
  have e : Taper78.BHB.MTP.JJ w.h θ T α ν β ww - Taper78.BHB.MTP.JJlead w.kap1 θ T α ν β ww
      = (2 * π * I)⁻¹ * sqInt (4 * rhoT T) (fun ε => f ε - (w.kap1 : ℂ) * g ε) := by
    rw [sqInt_sub hr hfc hgc', sqInt_const_mul]
    unfold Taper78.BHB.MTP.JJ Taper78.BHB.MTP.JJlead
    ring
  rw [e, norm_mul]
  have h2 : ‖(2 * π * I : ℂ)⁻¹‖ = (2 * π)⁻¹ := by
    rw [norm_inv, norm_mul, norm_mul, Complex.norm_I, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos Real.pi_pos]
    norm_num
  rw [h2]
  have hb : ‖sqInt (4 * rhoT T) (fun ε => f ε - (w.kap1 : ℂ) * g ε)‖ ≤ 8 * (4 * rhoT T) * K :=
    norm_sqInt_le hr fun ε hε => hdiff T hT1 α ν β ww hα hν hβ hww ε hε
  have hπ : (0 : ℝ) < 2 * π := by positivity
  have h3 : (3 : ℝ) < π := Real.pi_gt_three
  calc (2 * π)⁻¹ * ‖sqInt (4 * rhoT T) (fun ε => f ε - (w.kap1 : ℂ) * g ε)‖
      ≤ (2 * π)⁻¹ * (8 * (4 * rhoT T) * K) := mul_le_mul_of_nonneg_left hb (inv_nonneg.mpr hπ.le)
    _ = 16 / (50 * π) * (K / Real.log T) := by
        unfold rhoT
        field_simp
        ring
    _ ≤ 1 * (K / Real.log T) := by
        apply mul_le_mul_of_nonneg_right _ (div_nonneg hK hL.le)
        rw [div_le_one (by positivity)]
        nlinarith
    _ = K / Real.log T := one_mul _
end BHB.MTP
