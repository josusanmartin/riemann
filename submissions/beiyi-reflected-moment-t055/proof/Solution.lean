theorem _root_.Taper78.BHB.MTP.norm_AAm_le {ly : ℝ} (hly : 1 ≤ ly) {lam : ℂ} (hlam : ‖lam‖ * ly ≤ 1) {V : ℝ}
    (hV : V ∈ Set.Icc 0 ly) : ‖Taper78.BHB.MTP.AAm ly lam V‖ ≤ 3 / ly := by
  have hly0 : 0 < ly := by linarith
  obtain ⟨hx0, hx1⟩ := LB.div_mem hly0 hV
  obtain ⟨hd0, hd1⟩ := Taper78.BHB.MT.dPpoly_mem hx0 hx1
  obtain ⟨hp0, hp1⟩ := Taper78.BHB.MT.Ppoly_mem hx0 hx1
  have hlam' : ‖lam‖ ≤ 1 / ly := by
    rw [le_div_iff₀ hly0]
    exact hlam
  have h1 : ‖((Taper78.BHB.MT.dPpoly (V / ly) / ly : ℝ) : ℂ)‖ ≤ 2 / ly := by
    rw [Complex.norm_of_nonneg (div_nonneg hd0 hly0.le)]
    exact div_le_div_of_nonneg_right hd1 hly0.le
  have h2 : ‖lam * ((Taper78.BHB.Ppoly (V / ly) : ℝ) : ℂ)‖ ≤ 1 / ly := by
    rw [norm_mul, Complex.norm_of_nonneg hp0]
    calc ‖lam‖ * Taper78.BHB.Ppoly (V / ly) ≤ 1 / ly * 1 :=
          mul_le_mul hlam' hp1 hp0 (by positivity)
      _ = 1 / ly := mul_one _
  have h3 : (2 : ℝ) / ly + 1 / ly ≤ 3 / ly := by
    rw [← add_div]
    exact div_le_div_of_nonneg_right (by norm_num) hly0.le
  unfold Taper78.BHB.MTP.AAm
  exact (norm_add_le _ _).trans ((add_le_add h1 h2).trans h3)
end BHB.MTP
