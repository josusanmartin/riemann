theorem _root_.Taper78.BHB.MTP.sqInt_exp_Xi {r : ℝ} (hr : 0 < r) {ly : ℝ} (hly : ly ≠ 0) (L₀ : ℝ) :
    (2 * π * I)⁻¹ * sqInt r (fun ε => exp (ε * (L₀ : ℂ)) * Taper78.BHB.MTP.Xi ly ε) = (Taper78.BHB.MTP.leadPoly L₀ ly : ℂ) := by
  have hc := fun n : ℕ => SQ.continuousOn_exp_div_pow_sqBdy hr (L₀ : ℂ) n
