  rw [(Taper78.BHB.MTP.hasDerivAt_AAm ly lam V).deriv]
  have h1 : ‖((-1.56 / ly ^ 2 : ℝ) : ℂ)‖ ≤ 1.56 / ly ^ 2 := by
    rw [Complex.norm_real, Real.norm_eq_abs, neg_div, abs_neg,
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ 1.56 / ly ^ 2)]
  have h2 : ‖lam * ((Taper78.BHB.MT.dPpoly (V / ly) / ly : ℝ) : ℂ)‖ ≤ 2 / ly ^ 2 := by
    rw [norm_mul, Complex.norm_of_nonneg (div_nonneg hd0 hly0.le)]
    calc ‖lam‖ * (Taper78.BHB.MT.dPpoly (V / ly) / ly) ≤ 1 / ly * (2 / ly) :=
          mul_le_mul hlam' (div_le_div_of_nonneg_right hd1 hly0.le)
            (div_nonneg hd0 hly0.le) (by positivity)
