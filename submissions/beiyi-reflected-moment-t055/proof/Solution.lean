open BHB.MT
theorem _root_.Taper78.BHB.MainP_asymp (hRH : RiemannHypothesis) (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ' : θ < 1 / 2) :
    ∀ δ > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      |(Taper78.BHB.MainP w.h θ T).re - Taper78.BHB.cP θ * w.kap1 * T * Real.log T ^ 3 / (2 * π)| ≤ δ * T * Real.log T ^ 3 := by
  intro δ hδ
  obtain ⟨C₁, η, C₂, T₁, hη, hC₂, h1⟩ := Taper78.BHB.MTP.MainP_near hRH w hθ hθ'
  obtain ⟨K, hK, hKb⟩ := Taper78.BHB.MTP.leadPoly_approx hθ (Real.log (2 * π))
  have hπ : (0 : ℝ) < π := Real.pi_pos

  set A : ℝ := (|w.kap1| * K + 500000 * C₂) / π with hA
  have hA0 : 0 ≤ A := by positivity
  set B : ℝ := (1000000 * |C₁| + 1) / δ with hB
  have hB0 : 0 < B := by positivity
  refine ⟨max (max T₁ (Real.exp (2 * A / δ + 1))) (max (B ^ (1 / η)) 3), ?_⟩
  intro T hT
  have hT1 : T₁ ≤ T := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hT
  have hTe : Real.exp (2 * A / δ + 1) ≤ T :=
    le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hT
  have hTB : B ^ (1 / η) ≤ T := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hT
  have hT3 : (3 : ℝ) ≤ T := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hT
  have hT0 : 0 < T := by linarith
  obtain ⟨hT1', hmain⟩ := h1 T hT1
  set L : ℝ := Real.log T with hLdef
  have hL1 : 2 * A / δ + 1 ≤ L := by
    have := Real.log_le_log (Real.exp_pos _) hTe
    rwa [Real.log_exp] at this
  have hLpos : 1 ≤ L := by
    have : 0 ≤ 2 * A / δ := by positivity
    linarith
  have hL0 : 0 < L := by linarith

  have hAL : A / L ≤ δ / 2 := by
    rw [div_le_iff₀ hL0]
    have h2 : 2 * A / δ ≤ L := by linarith
    rw [div_le_iff₀ hδ] at h2
    linarith

  have hTη : B ≤ T ^ η := by
    have h := Real.rpow_le_rpow (Real.rpow_nonneg hB0.le _) hTB hη.le
    rwa [← Real.rpow_mul hB0.le, one_div, inv_mul_cancel₀ hη.ne', Real.rpow_one] at h
  have hTηpos : 0 < T ^ η := Real.rpow_pos_of_pos hT0 η
  have hpow : T ^ (1 - η) = T / T ^ η := by
    rw [Real.rpow_sub hT0, Real.rpow_one]
  have hC1T : 1000000 * |C₁| * T ^ (1 - η) ≤ δ * T := by
    rw [hpow, ← mul_div_assoc, div_le_iff₀ hTηpos]
    have h3 : 1000000 * |C₁| ≤ δ * B := by
      rw [hB]
      field_simp
      linarith [abs_nonneg C₁]
    calc 1000000 * |C₁| * T ≤ δ * B * T := mul_le_mul_of_nonneg_right h3 hT0.le
      _ ≤ δ * T ^ η * T := by
          apply mul_le_mul_of_nonneg_right _ hT0.le
          exact mul_le_mul_of_nonneg_left hTη hδ.le
      _ = δ * T * T ^ η := by ring

  set X : ℂ := ((-2 : ℂ) * ((T / (2 * π) : ℝ) : ℂ))
    * ((w.kap1 : ℂ) * (Taper78.BHB.MTP.leadPoly (L0 T) (Real.log (ymol θ T)) : ℂ)) with hX
  have hXre : X.re = -(T / π) * (w.kap1 * Taper78.BHB.MTP.leadPoly (L - Real.log (2 * π)) (θ * L)) := by
    have e : X = ((-2 * (T / (2 * π)) * (w.kap1 * Taper78.BHB.MTP.leadPoly (L0 T) (Real.log (ymol θ T))) : ℝ) : ℂ) := by
      rw [hX]
      push_cast
      ring
    have e2 : (-2 * (T / (2 * π)) : ℝ) = -(T / π) := by
      field_simp
    rw [e, Complex.ofReal_re, L0_eq hT0, log_ymol hT0 θ, e2]
  have hlead : |X.re - Taper78.BHB.cP θ * w.kap1 * T * L ^ 3 / (2 * π)| ≤ T / π * (|w.kap1| * (K * L ^ 2)) := by
    have e : X.re - Taper78.BHB.cP θ * w.kap1 * T * L ^ 3 / (2 * π)
        = -(T / π) * (w.kap1 * (Taper78.BHB.MTP.leadPoly (L - Real.log (2 * π)) (θ * L) - -(Taper78.BHB.cP θ) / 2 * L ^ 3)) := by
      rw [hXre]
      field_simp
      ring
    rw [e, abs_mul, abs_neg, abs_of_pos (by positivity : 0 < T / π), abs_mul]
    exact mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_left (hKb L hLpos) (abs_nonneg _)) (by positivity)

  have hρ3 : 4 * (C₁ * T ^ (1 - η) + T / π * (C₂ / L)) / rhoT T ^ 3
      = 500000 * C₁ * T ^ (1 - η) * L ^ 3 + T / π * (500000 * C₂ * L ^ 2) := by
    unfold rhoT
    rw [← hLdef]
    field_simp
    ring
  have hre : |(Taper78.BHB.MainP w.h θ T).re - X.re|
      ≤ 500000 * C₁ * T ^ (1 - η) * L ^ 3 + T / π * (500000 * C₂ * L ^ 2) := by
    rw [← hρ3, ← Complex.sub_re]
    exact (Complex.abs_re_le_norm _).trans hmain
  have hTpow : 0 ≤ T ^ (1 - η) := Real.rpow_nonneg hT0.le _
  have hL3 : 0 ≤ L ^ 3 := by positivity
  have h500 : 500000 * C₁ * T ^ (1 - η) * L ^ 3 ≤ δ / 2 * T * L ^ 3 := by
    have h4 : 500000 * C₁ * T ^ (1 - η) ≤ δ / 2 * T := by
      have : C₁ * T ^ (1 - η) ≤ |C₁| * T ^ (1 - η) :=
        mul_le_mul_of_nonneg_right (le_abs_self _) hTpow
      nlinarith
    exact mul_le_mul_of_nonneg_right h4 hL3

  have hTL2 : T / π * (|w.kap1| * (K * L ^ 2)) + T / π * (500000 * C₂ * L ^ 2)
      ≤ δ / 2 * T * L ^ 3 := by
    have e : T / π * (|w.kap1| * (K * L ^ 2)) + T / π * (500000 * C₂ * L ^ 2)
        = A / L * (T * L ^ 3) := by
      rw [hA]
      field_simp
    rw [e]
    calc A / L * (T * L ^ 3) ≤ δ / 2 * (T * L ^ 3) :=
          mul_le_mul_of_nonneg_right hAL (by positivity)
      _ = δ / 2 * T * L ^ 3 := by ring
  calc |(Taper78.BHB.MainP w.h θ T).re - Taper78.BHB.cP θ * w.kap1 * T * L ^ 3 / (2 * π)|
      ≤ |(Taper78.BHB.MainP w.h θ T).re - X.re| + |X.re - Taper78.BHB.cP θ * w.kap1 * T * L ^ 3 / (2 * π)| := by
        have e : (Taper78.BHB.MainP w.h θ T).re - Taper78.BHB.cP θ * w.kap1 * T * L ^ 3 / (2 * π)
            = ((Taper78.BHB.MainP w.h θ T).re - X.re) + (X.re - Taper78.BHB.cP θ * w.kap1 * T * L ^ 3 / (2 * π)) := by
          ring
        rw [e]
        exact abs_add_le _ _
    _ ≤ (500000 * C₁ * T ^ (1 - η) * L ^ 3 + T / π * (500000 * C₂ * L ^ 2))
          + T / π * (|w.kap1| * (K * L ^ 2)) := add_le_add hre hlead
    _ ≤ δ / 2 * T * L ^ 3 + δ / 2 * T * L ^ 3 := by linarith
    _ = δ * T * L ^ 3 := by ring
end BHB.MTP
