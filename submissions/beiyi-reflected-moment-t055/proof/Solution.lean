open BHB.MT
theorem _root_.Taper78.BHB.MTP.MainP_near (hRH : RiemannHypothesis) (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ' : θ < 1 / 2) :
    ∃ C₁ η C₂ T₀ : ℝ, 0 < η ∧ 0 ≤ C₂ ∧ ∀ T ≥ T₀, 1 < T ∧
      ‖Taper78.BHB.MainP w.h θ T - ((-2 : ℂ) * ((T / (2 * π) : ℝ) : ℂ))
          * ((w.kap1 : ℂ) * (Taper78.BHB.MTP.leadPoly (L0 T) (Real.log (ymol θ T)) : ℂ))‖
        ≤ 4 * (C₁ * T ^ (1 - η) + T / π * (C₂ / Real.log T)) / rhoT T ^ 3 := by
  obtain ⟨C₁, η, T₁, hη, h1⟩ := Taper78.BHB.MTP.MainPsh_approx hRH w hθ hθ'
  obtain ⟨C₂, T₂, hC₂, h2⟩ := Taper78.BHB.MTP.JJ_approx hRH w hθ hθ'
  refine ⟨C₁, η, C₂, max (max T₁ T₂) 2, hη, hC₂, ?_⟩
  intro T hT
  have hT1 : T₁ ≤ T := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hT
  have hT2 : T₂ ≤ T := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hT
  have hT3 : (1 : ℝ) < T := lt_of_lt_of_le (by norm_num) (le_trans (le_max_right _ _) hT)
  refine ⟨hT3, ?_⟩
  have hT0 : 0 < T := by linarith
  have hρ := rhoT_pos hT3
  have hL : 0 < Real.log T := Real.log_pos hT3
  set c : ℂ := (-2 : ℂ) * ((T / (2 * π) : ℝ) : ℂ) with hc
  set Lead : ℂ → ℂ → ℂ → ℂ → ℂ := fun α ν β ww => c * Taper78.BHB.MTP.JJlead w.kap1 θ T α ν β ww with hLead
  set Err : ℂ → ℂ → ℂ → ℂ → ℂ := fun α ν β ww => Taper78.BHB.MTP.MainPsh w.h θ T α ν β ww - Lead α ν β ww
    with hErr
  have hcn : ‖c‖ = T / π := by
    rw [hc, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    have : ‖(-2 : ℂ)‖ = 2 := by norm_num
    rw [this]
    field_simp

  have hLeadc : PolyCont (rhoT T) Lead := (Taper78.BHB.MTP.polyCont_JJlead w.kap1 θ hT3).const_mul c
  have hMc : PolyCont (rhoT T) (Taper78.BHB.MTP.MainPsh w.h θ T) := Taper78.BHB.MTP.polyCont_MainPsh w θ hT0 (rhoT T)
  have hErrc : PolyCont (rhoT T) Err := hMc.sub hLeadc

  have hE : ∀ α ν β ww : ℂ, ‖α‖ ≤ rhoT T → ‖ν‖ ≤ rhoT T → ‖β‖ ≤ rhoT T → ‖ww‖ ≤ rhoT T →
      ‖Err α ν β ww‖ ≤ C₁ * T ^ (1 - η) + T / π * (C₂ / Real.log T) := by
    intro α ν β ww hα hν hβ hww
    have a1 := h1 T hT1 α ν β ww hα hν hβ hww
    have a2 := h2 T hT2 α ν β ww hα hν hβ hww
    have e : Err α ν β ww
        = (Taper78.BHB.MTP.MainPsh w.h θ T α ν β ww - (-2) * (((T / (2 * π) : ℝ) : ℂ) * Taper78.BHB.MTP.JJ w.h θ T α ν β ww))
          + c * (Taper78.BHB.MTP.JJ w.h θ T α ν β ww - Taper78.BHB.MTP.JJlead w.kap1 θ T α ν β ww) := by
      rw [hErr, hLead, hc]
      ring
    rw [e]
    refine (norm_add_le _ _).trans (add_le_add a1 ?_)
    rw [norm_mul, hcn]
    exact mul_le_mul_of_nonneg_left a2 (by positivity)

  have hsplit : Taper78.BHB.MTP.MainPsh w.h θ T = fun α ν β ww => Lead α ν β ww + Err α ν β ww := by
    funext α ν β ww
    rw [hErr]
    ring
  have hDD : Taper78.BHB.MainP w.h θ T = DDc (rhoT T) Lead + DDc (rhoT T) Err := by
    rw [Taper78.BHB.MTP.MainP_eq_DDc w θ hT0 hρ]
    conv_lhs => rw [hsplit]
    exact DDc_add hρ hLeadc hErrc
  have hLeadv : DDc (rhoT T) Lead
      = c * ((w.kap1 : ℂ) * (Taper78.BHB.MTP.leadPoly (L0 T) (Real.log (ymol θ T)) : ℂ)) := by
    rw [hLead, DDc_const_mul, Taper78.BHB.MTP.DDc_JJlead w.kap1 hθ hT3]
  rw [hDD, hLeadv, add_sub_cancel_left]
  exact norm_DDc_le hρ hE
end BHB.MTP
