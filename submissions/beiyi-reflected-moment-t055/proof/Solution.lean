namespace ReflectedHighBand

private lemma dev_bound (w : Weight) {y h : ℝ} (hy : 0 < y) (hy' : y < 1/2) (hh : 0 < h)
    (hh₁ : h < 1) (hband : h ≤ 1-3*eps y) {s : ℤ} (hs : s=1 ∨ s= -1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      DevSum w.h y T (dconv (HighPrime.reflectedBand h T) BHB.MT.kap2) s ≤ C*T := by
  have hH := adm_hside w hs
  obtain ⟨M,T₀,j,hM,hdev⟩ := DevSum_le_of_SCU_LCU w hy hy' hs
  obtain ⟨V,c,hV,hlarge⟩ := large_conductors hy hy' hh hband hH
  let n := j+c+1
  let A := 2*n
  let B := 2*A+j
  obtain ⟨U,hU,hsmall⟩ := ReflectedSmallGlobal.small_conductors hy' hh hh₁ hH A B
  have hε : 0 < eps y := by unfold eps; linarith
  obtain ⟨T₁,_,hpow⟩ := eventually_rpow_neg_mul_log_pow_le hε n
  refine ⟨M*(U+2*V),by positivity,?_⟩
  filter_upwards [ReflectedLogBand.scales hh₁,Filter.eventually_ge_atTop T₀,Filter.eventually_ge_atTop T₁,
    hlarge,hsmall] with T hsc ht hT₁ hl hs'
  obtain ⟨hL,_,_,hT₀⟩ := hsc
  let L := Real.log T
  have hL₀ : 0 < L := by dsimp only [L]; linarith
  have ht' : 1 < T := (Real.log_pos_iff hT₀.le).mp hL₀
  have hG : DB 2 1 BHB.MT.kap2 := by
    have hr : rd BHB.MT.kap2 1 1=BHB.MT.kap2 := by funext m; simp [rd]
    simpa [hr] using HighPrime.reduced_kap2_DB (g:=1) (by decide) 1
  have hdb := (HighPrime.reflectedBand_DB hh ht').dconv hG (by norm_num) (by norm_num)
  have hA : 1 ≤ (A:ℝ) := by exact_mod_cast (show 1 ≤ A by dsimp [A,n]; omega)
  have he := hdev T ht _ _ _ A (U/L^B) (V*L^c) hdb hA (by positivity) (by positivity) hs' hl
  apply he.trans
  have hxp : L^(2*(A:ℝ))=L^(2*A) := by rw [← Real.rpow_natCast]; congr 1; push_cast; ring
  have hxn : L^(-((A:ℝ)/2))=(L^n)⁻¹ := by
    rw [Real.rpow_neg hL₀.le,show (A:ℝ)/2=n by dsimp [A]; push_cast; ring,Real.rpow_natCast]
  have he₁ : L^j*(U/L^B*L^(2*A))=U := by dsimp only [B]; rw [pow_add]; field_simp
  have he₂ : L^j*(V*L^c*(L^n)⁻¹)=V/L := by dsimp only [n]; rw [pow_succ,pow_add]; field_simp
  have he₃ : L^j*(V*L^c*(T^(-eps y)*L))=V*(T^(-eps y)*L^n) := by dsimp only [n]; rw [pow_succ,pow_add]; ring
  change M*T*L^j*(U/L^B*L^(2*(A:ℝ))+V*L^c*(L^(-((A:ℝ)/2))+T^(-eps y)*L)) ≤ _
  rw [hxp,hxn]
  calc
    _ = M*T*(L^j*(U/L^B*L^(2*A))+L^j*(V*L^c*(L^n)⁻¹)+L^j*(V*L^c*(T^(-eps y)*L))) := by ring
    _ = M*T*(U+V/L+V*(T^(-eps y)*L^n)) := by rw [he₁,he₂,he₃]
    _ ≤ M*T*(U+V+V) := mul_le_mul_of_nonneg_left
      (add_le_add (add_le_add (le_refl U) (div_le_self hV.le hL)) (mul_le_of_le_one_right hV.le (hpow T hT₁))) (by positivity)
    _ = _ := by ring

theorem nonprincipal_bound (w : Weight) (F : ℝ → ℝ) {y h : ℝ} (hy : 0 < y) (hy' : y < 1/2)
    (hh : 0 < h) (hh₁ : h < 1) (hband : h ≤ 1-3*eps y) (hFb : ∀ u ∈ Set.Icc 0 y, |F u| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop, ‖nonprincipal w F T y (1/2) h‖ ≤ C*T := by
  obtain ⟨A,hA,ha⟩ := dev_bound w hy hy' hh hh₁ hband (Or.inl rfl)
  obtain ⟨B,hB,hb⟩ := dev_bound w hy hy' hh hh₁ hband (Or.inr rfl)
  refine ⟨A+B,by positivity,?_⟩
  filter_upwards [ha,hb,Filter.eventually_gt_atTop (1:ℝ)] with T h₁ h₂ hT
  exact (norm_nonprincipal_le w F hT y h hFb).trans ((add_le_add h₁ h₂).trans_eq (by ring))

private lemma close_trace (w : Weight) {z c : ℝ} (hz : z ∈ Set.Icc (0:ℝ) 1)
    (he : ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖-sumRows (taper z) T theta (1/2) topExponent (zeroRow w T)-
        nonprincipal w (taper z) T theta (1/2) topExponent-((T/(2*Real.pi)*w.kap1*(Real.log T)^2*c:ℝ):ℂ)‖ ≤ C*T*Real.log T) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖-sumRows (taper z) T theta (1/2) topExponent (zeroRow w T)-
        ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*c:ℝ):ℂ)‖ ≤ C*T*Real.log T := by
  obtain ⟨A,hA,ha⟩ := he
  have hh' : topExponent < 1 := by norm_num [topExponent]
  obtain ⟨B,hB,hb⟩ := nonprincipal_bound w (taper z) (by norm_num [theta] : 0 < theta) (by norm_num [theta])
    (by norm_num [topExponent]) hh' (by norm_num [eps,theta,topExponent]) (taper_bound hz)
  refine ⟨A+B,by positivity,?_⟩
  filter_upwards [ha,hb,ReflectedLogBand.scales hh'] with T h₁ h₂ hs
  let m : ℂ := ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*c:ℝ):ℂ)
  let v := -sumRows (taper z) T theta (1/2) topExponent (zeroRow w T)
  let d := nonprincipal w (taper z) T theta (1/2) topExponent
  change ‖v-m‖ ≤ _
  rw [show v-m=(v-d-m)+d by ring]
  apply (norm_add_le ..).trans ((add_le_add h₁ h₂).trans ?_)
  nlinarith only [mul_le_mul_of_nonneg_left hs.1 (mul_nonneg hB hs.2.2.2.le)]

theorem truncated_8539 (hRH : RiemannHypothesis) (w : Weight) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖-sumRows (taper (39/50)) T theta (1/2) topExponent (zeroRow w T)-
        ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*(-216739263388000063/5988006000000000000):ℝ):ℂ)‖ ≤ C*T*Real.log T :=
  close_trace w (by constructor <;> norm_num) (high_trace_8539 hRH w)

theorem truncated_8535 (hRH : RiemannHypothesis) (w : Weight) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖-sumRows (taper (1/2)) T theta (1/2) topExponent (zeroRow w T)-
        ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*(-26706611469780007/718560720000000000):ℝ):ℂ)‖ ≤ C*T*Real.log T :=
  close_trace w (by constructor <;> norm_num) (high_trace_8535 hRH w)

end ReflectedHighBand
end
