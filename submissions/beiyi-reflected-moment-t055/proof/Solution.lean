section Src_ReflectedCovered


noncomputable section
open LowBand ShortProbe.RealResidual PrincipalBand ReflectedExplicit ReflectedInput

namespace ReflectedCovered

def highTrace (w : BHB.Weight) (T : ℝ) :=
  (-sumRows (taper (39/50)) T theta (1/2) topExponent (zeroRow w T)).re/Real.log T

def coveredCoefficient : ℝ :=
  -338885604051204503742089985645389767885559219/2395202400000000000000000000000000000000000000

/-- The true derivative on the low prime range, together with the truncated
derivative on the high prime range, in the exact mixed-moment normalization. -/
theorem covered_mixed (hRH : RiemannHypothesis) (w : BHB.Weight) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ T : ℝ in Filter.atTop, ∃ v : ℝ,
      HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z *
        (mollified T z*(starRingEnd ℂ) ((106/25:ℂ)*probeLow 0.999 lengthExponent T z-shortPrimes T z)).re) v ∧
      |v+(106/25)*highTrace w T-w.kap1*coveredCoefficient*TMA.Dsc T| ≤ ε*TMA.Dsc T := by
  obtain ⟨C,hC,hhigh⟩ := ReflectedHighBand.truncated_8539 hRH w
  let a : ℝ := 106/25
  let c : ℝ := -216739263388000063/5988006000000000000
  have hac : 0 < a := by norm_num [a]
  have hcoef : coveredCoefficient=lowCoefficient+a*c := covered_coefficients.1.symm
  filter_upwards [mixed_low hRH w (show 0 < ε/2 by positivity),hhigh,
    ReflectedLogBand.scales (by norm_num : (0:ℝ)<1),
    Real.tendsto_log_atTop.eventually_ge_atTop (4*Real.pi*a*C/ε)] with T hlow hhi hsc hg
  obtain ⟨v,hv,hl⟩ := hlow
  refine ⟨v,hv,?_⟩
  let L := Real.log T
  have hT₀ := hsc.2.2.2
  have hL₀ : 0 < L := by dsimp [L]; linarith [hsc.1]
  have hraw := (Complex.abs_re_le_norm _).trans hhi
  simp only [Complex.sub_re,Complex.ofReal_re] at hraw
  have hh : |highTrace w T-w.kap1*c*TMA.Dsc T| ≤ C*T := by
    rw [highTrace,div_sub' hL₀.ne',abs_div,abs_of_pos hL₀,div_le_iff₀ hL₀]
    rw [show Real.log T*(w.kap1*c*TMA.Dsc T)=T/(2*Real.pi)*w.kap1*Real.log T^2*c by
      dsimp only [TMA.Dsc]; ring]
    exact hraw
  have hcharge : a*(C*T) ≤ ε/2*TMA.Dsc T := by
    have ht := (div_le_iff₀ hε).mp hg
    calc
      a*(C*T) = (4*Real.pi*a*C)*T/(4*Real.pi) := by field_simp <;> ring
      _ ≤ (Real.log T*ε)*T/(4*Real.pi) :=
        div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right ht hT₀.le) (by positivity)
      _ = ε/2*TMA.Dsc T := by dsimp only [TMA.Dsc]; ring
  rw [hcoef,show v+a*highTrace w T-w.kap1*(lowCoefficient+a*c)*TMA.Dsc T=
    (v-w.kap1*lowCoefficient*TMA.Dsc T)+a*(highTrace w T-w.kap1*c*TMA.Dsc T) by ring]
  apply (abs_add_le ..).trans
  rw [abs_mul,abs_of_pos hac]
  exact (add_le_add hl ((mul_le_mul_of_nonneg_left hh hac.le).trans hcharge)).trans_eq (by ring)

