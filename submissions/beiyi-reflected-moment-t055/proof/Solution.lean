theorem _root_.Taper78.BHB.MTP.LB.hasDerivAt_QQm_aux (ly : ℝ) (ε α ν β w : ℂ) (V : ℝ) :
    HasDerivAt (Taper78.BHB.MTP.QQm ly ε α ν β w)
      ((1 / ly : ℝ) * (((-1.56 / ly : ℝ) : ℂ) + (1.78 : ℂ) * Dker ε α ν β w V
        - ((1.56 / ly : ℝ) : ℂ) * ∫ v in (0 : ℝ)..V, Dker ε α ν β w v)) V := by
  have hD := continuous_Dker ε α ν β w
  have hI0 := hasDerivAt_primitive_Dker ε α ν β w V
  have hD1 : Continuous (fun v : ℝ => (v : ℂ) * Dker ε α ν β w v) :=
    Complex.continuous_ofReal.mul hD
  have hI1 : HasDerivAt (fun V : ℝ => ∫ v in (0 : ℝ)..V, (v : ℂ) * Dker ε α ν β w v)
      ((V : ℂ) * Dker ε α ν β w V) V :=
    (hD1.integral_hasStrictDerivAt 0 V).hasDerivAt
  have hP : HasDerivAt (fun V : ℝ => ((Taper78.BHB.MT.dPpoly (V / ly) : ℝ) : ℂ)) ((-(1.56 / ly) : ℝ) : ℂ) V :=
    (Taper78.BHB.MTP.LB.hasDerivAt_dPpoly_div ly V).ofReal_comp
  have hfun : Taper78.BHB.MTP.QQm ly ε α ν β w = fun V : ℝ => ((1 / ly : ℝ) : ℂ) * (((Taper78.BHB.MT.dPpoly (V / ly) : ℝ) : ℂ)
      + ((Taper78.BHB.MT.dPpoly (V / ly) : ℝ) : ℂ) * (∫ v in (0 : ℝ)..V, Dker ε α ν β w v)
      + ((1.56 / ly : ℝ) : ℂ) * ∫ v in (0 : ℝ)..V, (v : ℂ) * Dker ε α ν β w v) :=
    funext fun V => Taper78.BHB.MTP.LB.QQm_eq ly ε α ν β w V
  rw [hfun]
  have h := ((hP.fun_add (hP.fun_mul hI0)).fun_add
    (hI1.const_mul ((1.56 / ly : ℝ) : ℂ))).const_mul ((1 / ly : ℝ) : ℂ)
  refine h.congr_deriv ?_
  have h32 : ((Taper78.BHB.MT.dPpoly (V / ly) : ℝ) : ℂ) = 1.78 - ((1.56*V / ly : ℝ) : ℂ) := by
    have e : Taper78.BHB.MT.dPpoly (V / ly) = 1.78 - 1.56*V / ly := by linarith [Taper78.BHB.MTP.LB.dPpoly_add_div ly V]
    rw [e]
    push_cast
    ring
  rw [h32]
  push_cast
