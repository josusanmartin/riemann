section Src_MultiplicityProbe

noncomputable section
open Filter
open scoped BigOperators Real

namespace MultiplicityProbe

abbrev theta : ℝ := 499/1000
abbrev width : ℝ := 99/100
abbrev intercept : ℝ := 141/500
abbrev slope : ℝ := 43/100
abbrev scale : ℝ := 5/12

def detector (T : ℝ) (s : ℂ) : ℂ :=
  deriv riemannZeta s * BHB.Bmol theta T s / (Real.log T : ℂ)

/-- The explicit formula uses all prime powers in this triangular weight. -/
def probeThrough (b T : ℝ) (s : ℂ) : ℂ :=
  ∑ n ∈ BHB.Krange b T,
    (((ArithmeticFunction.vonMangoldt n / Real.log T) *
      (1-Real.log n/(width*Real.log T))/width : ℝ) : ℂ) * (n : ℂ)^(-s)

abbrev probe := probeThrough width
abbrev shortProbe := probeThrough (7/10)
def tail (T : ℝ) (s : ℂ) : ℂ := probe T s - shortProbe T s

def sq (z : ℂ) : ℝ := z.re^2+z.im^2
def score (a w : ℂ) : ℝ :=
  1-(intercept-2*slope*w.re-scale*a.re)^2-(2*slope*w.im-scale*a.im)^2

open Zeta23 in
/-- The pinned Weil formula bounds a single multiplicity by its arithmetic
    side for every normalized smooth square test centered on that zero. -/
theorem local_from_weil (hRH : RiemannHypothesis) (ρ : zetaZeroConfig.carrier)
    {f : ℝ → ℂ} (hf : ContDiff ℝ 2 f) (hc : HasCompactSupport f)
    (hcenter : ‖paperFT f ((ρ : ℂ).im : ℂ)‖ = 1) :
    (Zeta23.zeroMult ρ : ℝ) ≤ (EF.literatureRHS (EF.weilTest f f)).re := by
  have he := WeilEF.EF_lit_zetaZeroConfig (EF.weilTest f f)
    (EF.weilTest_contDiff hf hf.continuous hc) (EF.weilTest_hasCompactSupport hc hc)
  let v (z : zetaZeroConfig.carrier) : ℝ := (Zeta23.zeroMult z : ℝ)*‖paperFT f ((z : ℂ).im : ℂ)‖^2
  have ht (z : zetaZeroConfig.carrier) :
      ((zetaZeroConfig.mult z : ℂ)*paperFT (EF.weilTest f f) (gammaOf z)).re = v z := by
    rw [TMA.Kernel.gammaOf_eq_im hRH z.2, EF.paperFT_weilTest hf.continuous hf.continuous hc hc,
      Complex.conj_ofReal, Complex.mul_conj, Complex.normSq_eq_norm_sq, zetaZeroConfig_mult]
    simp [v, -Complex.ofReal_pow]
  have hs : HasSum v (EF.literatureRHS (EF.weilTest f f)).re := by
    have hh := Complex.hasSum_re (he.2 ▸ he.1.hasSum)
    simpa only [ht] using hh
  have h := hs.summable.sum_le_tsum ({ρ} : Finset zetaZeroConfig.carrier)
    (fun z _ => show 0 ≤ v z from mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _))
  rwa [hs.tsum_eq, Finset.sum_singleton, show v ρ = (Zeta23.zeroMult ρ : ℝ) by simp [v,hcenter]] at h

theorem expand_score (a w : ℂ) : score a w =
    1-intercept^2 + 4*intercept*slope*w.re - 4*slope^2*sq w +
      2*scale*intercept*a.re - 4*scale*slope*(a*w).re - scale^2*sq a := by
  simp only [score, sq, Complex.mul_re]
  ring

/-- A double zero costs at least half in the squared residual. For multiplicity
    three or greater the squared residual exceeds one. -/
theorem occurrence_bound (m : ℕ) (hm : 1 ≤ m) (a w : ℂ)
    (ha : m ≠ 1 → a=0) (hlocal : (m:ℝ) ≤ 1/width-2*w.re+1/1000) :
    (m:ℝ)*score a w ≤ 1 := by
  rcases eq_or_lt_of_le hm with h1 | h2
  · subst m
    simp only [Nat.cast_one, one_mul, score]
    nlinarith only [sq_nonneg (intercept-2*slope*w.re-scale*a.re),
      sq_nonneg (2*slope*w.im-scale*a.im)]
  rw [ha (by omega)]
  simp only [score, Complex.zero_re, Complex.zero_im, mul_zero, sub_zero]
  by_cases heq : m=2
  · subst m
    norm_num [width] at hlocal
    norm_num [intercept, slope]
    nlinarith only [hlocal, sq_nonneg (w.im),
      mul_nonneg (show 0 ≤ 141/500-2*(43/100)*w.re-70711/100000 by linarith)
        (show 0 ≤ 141/500-2*(43/100)*w.re+70711/100000 by linarith)]
  · have h3 : (3:ℝ) ≤ m := by exact_mod_cast (show 3 ≤ m by omega)
    have hr : 1 ≤ intercept-2*slope*w.re := by
      norm_num [width] at hlocal
      norm_num [intercept, slope]
      linarith
    have hneg : 1-(intercept-2*slope*w.re)^2-(2*slope*w.im)^2 ≤ 0 := by
      nlinarith only [hr, sq_nonneg (intercept-2*slope*w.re-1), sq_nonneg (2*slope*w.im)]
    exact (mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg m) hneg).trans (by norm_num)

abbrev count (T : ℝ) : ℝ := Zeta23.Ncount T (2*T)

def sumAt (T : ℝ) (v : ℂ → ℝ) : ℝ :=
  ∑ ρ ∈ ThirdMoment.zerosFinset T (2*T), (Zeta23.zeroMult ρ : ℝ)*v ρ

/-- A nonnegative shifted square allows the smoothed BHB moments to
    control a signed first moment on the sharp dyadic interval. -/
theorem sharp_quadratic (hRH : RiemannHypothesis) (w : BHB.Weight) {T : ℝ} (hT : 2 ≤ T) (d : ℝ) :
    sumAt T (fun z => sq (detector T z)) - 2*d*sumAt T (fun z => (detector T z).re) +
      d^2*count T ≤ BHB.S2 w.h theta T / Real.log T^2 -
      2*d*(BHB.S1 w.h theta T).re / Real.log T +
      d^2*(∑' z : Zeta23.zetaZeroConfig.carrier, TMA.cw w.h T z) := by
  have hT0 : 0 < T := by linarith
  have hℓ : 0 < Real.log T := Real.log_pos (by linarith)
  let V (z : ℂ) := sq (detector T z) - 2*d*(detector T z).re + d^2
  have hV (z : ℂ) : 0 ≤ V z := by
    dsimp [V,sq]
    nlinarith only [sq_nonneg ((detector T z).re-d), sq_nonneg (detector T z).im]
  have hnorm (z : ℂ) : sq (detector T z) =
      ‖deriv riemannZeta z * BHB.Bmol theta T z‖^2 / Real.log T^2 := by
    rw [show sq (detector T z) = Complex.normSq (detector T z) by
      simp only [sq,Complex.normSq_apply,pow_two], Complex.normSq_eq_norm_sq, detector,
      norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hℓ, div_pow]
  have hs₁ := (Complex.hasSum_re (BHB.Red.summable_S1 hRH w (θ := theta) (by norm_num) hT).hasSum).mul_right (2*d/Real.log T)
  have hs₂ := (BHB.Red.summable_S2 hRH w (θ := theta) (by norm_num) hT).hasSum.mul_right (1/Real.log T^2)
  have hs₀ := (TMA.summable_cw hRH w.toHeightWeight hT0).hasSum.mul_left (d^2)
  have hs : HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z * V z)
      (BHB.S2 w.h theta T / Real.log T^2 - 2*d*(BHB.S1 w.h theta T).re / Real.log T +
      d^2*(∑' z : Zeta23.zetaZeroConfig.carrier, TMA.cw w.h T z)) := by
    convert (hs₂.sub hs₁).add hs₀ using 1 <;> try rfl
    · funext z
      dsimp [TMA.cw,V]
      rw [hnorm]
      simp only [detector,Complex.div_ofReal_re,
        Complex.mul_re,Complex.natCast_re,Complex.natCast_im,Complex.ofReal_im,zero_mul,mul_zero,
        sub_zero,Complex.ofReal_re]
      ring
    · unfold BHB.S1 BHB.S2; ring
  have hwin := BHB.Final.hasSum_window (fun z => (Zeta23.zeroMult z : ℝ)*V z) T (2*T)
  have hpt (z : Zeta23.zetaZeroConfig.carrier) :
      (if T < (z : ℂ).im ∧ (z : ℂ).im ≤ 2*T then (Zeta23.zeroMult z : ℝ)*V z else 0) ≤
        TMA.cw w.h T z * V z := by
    unfold TMA.cw
    split_ifs with h
    · have hh := w.h_ge_one ((z : ℂ).im/T) ((one_le_div hT0).mpr h.1.le)
        ((div_le_iff₀ hT0).mpr h.2)
      exact mul_le_mul_of_nonneg_right
        (le_mul_of_one_le_right (Nat.cast_nonneg _) hh) (hV _)
    · exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (w.h_nonneg _)) (hV _)
  have h := hasSum_le hpt hwin hs
  rw [show (∑ z ∈ ThirdMoment.zerosFinset T (2*T), (Zeta23.zeroMult z : ℝ)*V z) =
      sumAt T (fun z => sq (detector T z)) - 2*d*sumAt T (fun z => (detector T z).re) +
      d^2*count T by
        rw [count, ThirdMoment.Ncount_eq]
        unfold sumAt
        simp only [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
        apply Finset.sum_congr rfl
        intro z _
        dsimp [V]; ring] at h
  exact h

theorem smoothed_detector_at (hRH : RiemannHypothesis) (w : BHB.Weight) {θ : ℝ} (hθ : 0 < θ) (hθ' : θ < 1/2) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ T : ℝ in atTop,
      (BHB.c1 θ*w.kap1-ε)*TMA.Dsc T ≤ (BHB.S1 w.h θ T).re / Real.log T ∧
      BHB.S2 w.h θ T / Real.log T^2 ≤ (BHB.c2 θ*w.kap1+ε)*TMA.Dsc T := by
  let I := BHB.inputs_of_RH hRH
  let δ := ε/(6*Real.pi)
  have hδ : 0 < δ := by dsimp [δ]; positivity
  filter_upwards [eventually_gt_atTop (1 : ℝ), eventually_atTop.mpr (I.s1red w hθ hθ' δ hδ),
    eventually_atTop.mpr (I.a1 w hθ hθ' δ hδ), eventually_atTop.mpr (I.m1 w hθ hθ' δ hδ),
    eventually_atTop.mpr (I.s2red w hθ hθ' δ hδ), eventually_atTop.mpr (I.aP w hθ hθ' δ hδ),
    eventually_atTop.mpr (I.m2 w hθ hθ' δ hδ)] with T hT h1 h2 h3 h4 h5 h6
  have hL := Real.log_pos hT
  have hπ := Real.pi_pos
  have negRe (z y : ℂ) : y.re-z.re ≤ ‖z-y‖ := by
    simpa [norm_sub_rev z y] using Complex.re_le_norm (y-z)
  have posRe (z y : ℂ) : z.re-y.re ≤ ‖z-y‖ := by
    simpa using Complex.re_le_norm (z-y)
  constructor
  · have a := (negRe _ _).trans h1
    have b := (negRe _ _).trans h2
    have c := (negRe _ _).trans h3
    rw [Complex.ofReal_re] at c
    apply (le_div_iff₀ hL).mpr
    dsimp [δ] at a b c
    unfold TMA.Dsc
    field_simp at a b c ⊢
    nlinarith
  · have a := (abs_le.mp h4).2
    have b := (posRe _ _).trans h5
    have c := (abs_le.mp h6).2
    apply (div_le_iff₀ (sq_pos_of_pos hL)).mpr
    dsimp [δ] at a b c
    unfold TMA.Dsc
    field_simp at a b c ⊢
    nlinarith

theorem detector_moments (hRH : RiemannHypothesis) :
    ∀ᶠ T : ℝ in atTop,
      (79107/100000)*count T ≤ sumAt T (fun z => (detector T z).re) ∧
      sumAt T (fun z => sq (detector T z)) ≤ (89010/100000)*count T := by
  let η : ℝ := 1/10^14
  have hη : 0 < η := by norm_num [η]
  obtain ⟨w,hκ,_⟩ := (BHB.inputs_of_RH hRH).weight η hη
  have hlo := BHB.Final.one_le_kap1 w.toHeightWeight
  filter_upwards [eventually_ge_atTop (2 : ℝ), smoothed_detector_at hRH w (θ:=theta) (by norm_num) (by norm_num) hη,
    eventually_atTop.mpr (BHB.Final.Dsc_le_Ncount hη),
    eventually_atTop.mpr (TMA.t1_upper hRH w.toHeightWeight (σ := 1/2)
      (by norm_num) (by norm_num) η hη)] with T hT ⟨hm,hv⟩ hN hM
  rw [TMA.Kfull_zero,Complex.ofReal_re] at hM
  change TMA.Dsc T ≤ (1+η)*count T at hN
  have hD : 0 ≤ TMA.Dsc T := by
    have h := Real.log_nonneg (show 1 ≤ T by linarith)
    unfold TMA.Dsc; positivity
  have hcount : 0 ≤ count T := Nat.cast_nonneg _
  have h₁ : (BHB.c1 theta-η)*TMA.Dsc T ≤ (BHB.S1 w.h theta T).re / Real.log T := by
    refine le_trans (mul_le_mul_of_nonneg_right ?_ hD) hm
    linarith [le_mul_of_one_le_right (BHB.Final.c1_pos (show 0 < theta by norm_num)).le hlo]
  let Q := BHB.c2 theta*(1+η)+η
  have h₂ : BHB.S2 w.h theta T / Real.log T^2 ≤ Q*TMA.Dsc T := by
    refine hv.trans (mul_le_mul_of_nonneg_right ?_ hD)
    dsimp [Q]
    exact add_le_add_left (mul_le_mul_of_nonneg_left hκ
      (BHB.Final.c2_pos (show 0 < theta by norm_num)).le) η
  have h₀ := hM.trans (mul_le_mul_of_nonneg_right (by linarith : w.kap1+η ≤ 1+2*η) hD)
  have hq := sharp_quadratic hRH w hT 100000
  have hz := sharp_quadratic hRH w hT 0
  simp only [mul_zero,zero_mul,sub_zero,zero_pow (by decide : 2 ≠ 0),add_zero,zero_div] at hz
  have hsq : 0 ≤ sumAt T (fun z => sq (detector T z)) := by
    unfold sumAt sq
    exact Finset.sum_nonneg fun z _ => mul_nonneg (Nat.cast_nonneg _) (by positivity)
  rw [show 2*100000*(BHB.S1 w.h theta T).re / Real.log T =
    (2*100000)*((BHB.S1 w.h theta T).re / Real.log T) by ring] at hq
  let A := Q-200000*(BHB.c1 theta-η)+100000^2*(1+2*η)
  have hA : 0 ≤ A := by norm_num [A,Q,η,theta,BHB.c1,BHB.c2]
  have hb : 100000^2*count T-200000*sumAt T (fun z => (detector T z).re) ≤ A*TMA.Dsc T := by
    calc
      _ ≤ BHB.S2 w.h theta T / Real.log T^2 - 200000*((BHB.S1 w.h theta T).re/Real.log T) +
          100000^2*(∑' z : Zeta23.zetaZeroConfig.carrier, TMA.cw w.h T z) := by
            linarith only [hq,hsq]
      _ ≤ Q*TMA.Dsc T - 200000*((BHB.c1 theta-η)*TMA.Dsc T) +
          100000^2*((1+2*η)*TMA.Dsc T) := by
            apply add_le_add
            · exact sub_le_sub h₂ (mul_le_mul_of_nonneg_left h₁ (by norm_num))
            · exact mul_le_mul_of_nonneg_left h₀ (by norm_num)
      _ = A*TMA.Dsc T := by dsimp only [A]; ring
  have he := hb.trans (mul_le_mul_of_nonneg_left hN hA)
  have he' := (hz.trans h₂).trans (mul_le_mul_of_nonneg_left hN (by norm_num [Q,η,theta,BHB.c2]))
  norm_num [A,Q,η,theta,BHB.c1,BHB.c2] at he he'
  constructor <;> linarith

def LocalBound (T : ℝ) : Prop :=
  ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T),
    (Zeta23.zeroMult ρ : ℝ) ≤ 1/width-2*(probe T ρ).re+1/1000

theorem local_at_width (hRH : RiemannHypothesis) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ T : ℝ in atTop, ∀ ρ ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult ρ : ℝ) ≤ 1/width-2*(probe T ρ).re+ε :=
  FejerMultiplicity.local_bound hRH (b := width) (by norm_num) (by norm_num) hε

def Background : Prop := ∀ᶠ T in atTop,
  -(16501/100000)*count T ≤ sumAt T (fun ρ => (probe T ρ).re) ∧
  sumAt T (fun ρ => sq (probe T ρ)) ≤ (8334/100000)*count T


private theorem shift_sum (T d : ℝ) :
    (∑ z ∈ ThirdMoment.zerosFinset T (2*T), (Zeta23.zeroMult z:ℝ)*‖FejerMultiplicity.probe width T z-d‖^2) =
    sumAt T (fun z => sq (probe T z)) - 2*d*sumAt T (fun z => (probe T z).re) + d^2*count T := by
  unfold sumAt
  rw [count,ThirdMoment.Ncount_eq]
  simp only [Finset.mul_sum,← Finset.sum_add_distrib,← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro z _
  change (Zeta23.zeroMult z:ℝ) * ‖probe T z-(d:ℂ)‖^2 = _
  rw [← Complex.normSq_eq_norm_sq]
  simp only [Complex.normSq_apply,Complex.sub_re,Complex.sub_im,Complex.ofReal_re,Complex.ofReal_im,sub_zero,sq]
  ring

/-- The ordinary mean and Hermitian second moment of the triangular probe on the
    exact board interval, from RH alone. -/
theorem prime_moments (hRH : RiemannHypothesis) : Background := by
  let η : ℝ := 1/10^14
  have hη : 0 < η := by norm_num [η]
  obtain ⟨w,hκ,_⟩ := (BHB.inputs_of_RH hRH).weight η hη
  have hm (d : ℝ) (hd : 0 ≤ d) := FejerPrimeMoments.shifted_moment hRH w.toHeightWeight
    (b := width) (by norm_num) (by norm_num) hd hη
  filter_upwards [hm 0 le_rfl,hm 10000 (by norm_num),
    eventually_atTop.mpr (BHB.Final.Dsc_le_Ncount hη), eventually_ge_atTop (2:ℝ)] with T hv hs hN hT
  rw [shift_sum] at hv hs
  change TMA.Dsc T ≤ (1+η)*count T at hN
  have hP : 0 ≤ TMA.Dsc T := by
    have hl := (Real.log_pos (show 1 < T by linarith)).le
    unfold TMA.Dsc
    positivity
  have he : 0 ≤ sumAt T (fun z => sq (probe T z)) := by
    unfold sumAt sq
    exact Finset.sum_nonneg fun z _ => mul_nonneg (Nat.cast_nonneg _) (by positivity)
  let F (d:ℝ) := d^2+1/12+η+2*d*width*(1/6+η)
  have hpush (d : ℝ) (hd : 0 ≤ d) :
      (w.kap1*F d+η)*TMA.Dsc T ≤ ((1+η)*F d+η)*((1+η)*count T) := by
    have hF : 0 ≤ F d := by unfold F; positivity
    exact mul_le_mul (add_le_add_left (mul_le_mul_of_nonneg_right hκ hF) η) hN hP (by positivity)
  have h₁ := hv.trans (hpush 0 le_rfl)
  have h₂ := hs.trans (hpush 10000 (by norm_num))
  norm_num [F,η,width] at h₁ h₂
  have hN₀ : 0 ≤ count T := Nat.cast_nonneg _
  constructor <;> linarith

def ForwardBound : Prop := ∀ᶠ T in atTop,
  sumAt T (fun ρ => (detector T ρ*probe T ρ).re) ≤ -(127/1000)*count T

def ShortForwardBound : Prop := ∀ᶠ T in atTop,
  sumAt T (fun ρ => (detector T ρ*shortProbe T ρ).re) ≤ -(1377/10000)*count T

def TailBackground : Prop := ∀ᶠ T in atTop,
  sumAt T (fun ρ => (tail T ρ).re) ≤ -(34179/1000000)*count T ∧
  sumAt T (fun ρ => sq (tail T ρ)) ≤ (6539/1000000)*count T

private abbrev lam : ℝ := 143/1000
private abbrev ma : ℝ := 9493/12000
private abbrev mw : ℝ := -200999/5880600
private abbrev shiftConst : ℝ := lam*ma^2/2+mw^2/(2*lam)-ma*mw

theorem centered_product (a w : ℂ) :
    (a*w).re ≤ (lam/2)*sq a + (1/(2*lam))*sq w + (mw-lam*ma)*a.re +
        (ma-mw/lam)*w.re + shiftConst := by
  simp only [Complex.mul_re, sq, shiftConst]
  unfold lam ma mw
  nlinarith only [sq_nonneg ((143/1000)*(a.re-9493/12000)-(w.re+200999/5880600)),
    sq_nonneg ((143/1000)*a.im+w.im)]

theorem tail_bound (T : ℝ) (ha : sumAt T (fun ρ => sq (detector T ρ)) ≤ (89010/100000)*count T)
    (hm : (79107/100000)*count T ≤ sumAt T (fun ρ => (detector T ρ).re))
    (hw : sumAt T (fun ρ => (tail T ρ).re) ≤ -(34179/1000000)*count T)
    (hv : sumAt T (fun ρ => sq (tail T ρ)) ≤ (6539/1000000)*count T) :
    sumAt T (fun ρ => (detector T ρ*tail T ρ).re) ≤ (107/10000)*count T := by
  have h : sumAt T (fun ρ => (detector T ρ*tail T ρ).re) ≤
      (lam/2)*sumAt T (fun ρ => sq (detector T ρ)) +
      (1/(2*lam))*sumAt T (fun ρ => sq (tail T ρ)) +
      (mw-lam*ma)*sumAt T (fun ρ => (detector T ρ).re) +
      (ma-mw/lam)*sumAt T (fun ρ => (tail T ρ).re) + shiftConst*count T := by
    rw [count, ThirdMoment.Ncount_eq]
    unfold sumAt
    simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_le_sum
    intro ρ _
    have h := mul_le_mul_of_nonneg_left (centered_product (detector T ρ) (tail T ρ))
      (Nat.cast_nonneg (α:=ℝ) (Zeta23.zeroMult ρ))
    linarith only [h]
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  unfold shiftConst ma mw lam at h
  linarith

theorem forward_of_short (hRH : RiemannHypothesis) (ht : TailBackground) (hf : ShortForwardBound) :
    ForwardBound := by
  filter_upwards [detector_moments hRH,ht,hf] with T ⟨hm,ha⟩ ⟨hw,hv⟩ hs
  have h := tail_bound T ha hm hw hv
  have he : sumAt T (fun ρ => (detector T ρ*tail T ρ).re) =
      sumAt T (fun ρ => (detector T ρ*probe T ρ).re) -
      sumAt T (fun ρ => (detector T ρ*shortProbe T ρ).re) := by
    simp only [sumAt, tail, mul_sub, Complex.sub_re, Finset.sum_sub_distrib]
  rw [he] at h
  linarith

/-- A geometric route to the forward moment. D is the local zero sum.
    The last hypothesis bounds the weighted explicit-formula error. -/
theorem forward_from_pairs_at (T : ℝ) (D : ℂ → ℝ)
    (ha : sumAt T (fun ρ => (detector T ρ).re) ≤ 79109/100000*count T)
    (hr : -(24405/1000000)*count T ≤
      sumAt T (fun ρ => (detector T ρ*(starRingEnd ℂ) (probe T ρ)).re))
    (hp : (1594/10000)*count T ≤
      sumAt T (fun ρ => (detector T ρ).re*(D ρ - Zeta23.zeroMult ρ)))
    (he : sumAt T (fun ρ => (detector T ρ).re*(D ρ-1/width+2*(probe T ρ).re))
      ≤ (3/1000000)*count T) :
    sumAt T (fun ρ => (detector T ρ*probe T ρ).re) ≤ -(127/1000)*count T := by
  have hid : sumAt T (fun ρ => (detector T ρ*probe T ρ).re) +
      sumAt T (fun ρ => (detector T ρ*(starRingEnd ℂ) (probe T ρ)).re) +
      sumAt T (fun ρ => (detector T ρ).re*(D ρ-Zeta23.zeroMult ρ)) =
      (1/width-1)*sumAt T (fun ρ => (detector T ρ).re) +
      sumAt T (fun ρ => (detector T ρ).re*(D ρ-1/width+2*(probe T ρ).re)) := by
    unfold sumAt
    simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro ρ hρ
    simp only [Complex.mul_re, Complex.conj_re, Complex.conj_im]
    by_cases hm : Zeta23.zeroMult ρ=1
    · rw [hm]
      push_cast
      ring
    · let z : Zeta23.zetaZeroConfig.carrier := ⟨ρ,(ThirdMoment.mem_zerosFinset.mp hρ).1⟩
      have hz := BHB.Red.deriv_zeta_eq_zero_of_mult_ne_one z hm
      simp [detector, show deriv riemannZeta ρ=0 from hz]
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  unfold width at hid
  linarith

theorem finite_bound (T : ℝ) (hb : LocalBound T) :
    (1-intercept^2)*count T + 4*intercept*slope*sumAt T (fun ρ => (probe T ρ).re)
    - 4*slope^2*sumAt T (fun ρ => sq (probe T ρ))
    + 2*scale*intercept*sumAt T (fun ρ => (detector T ρ).re)
    - 4*scale*slope*sumAt T (fun ρ => (detector T ρ*probe T ρ).re)
    - scale^2*sumAt T (fun ρ => sq (detector T ρ)) ≤ (Zeta23.Ndist T (2*T) : ℝ) := by
  have h := Finset.sum_le_sum (s := ThirdMoment.zerosFinset T (2*T))
    (f := fun ρ => (Zeta23.zeroMult ρ : ℝ)*score (detector T ρ) (probe T ρ))
    (g := fun _ => (1:ℝ)) (fun ρ hρ => occurrence_bound _ (ThirdMoment.one_le_mult_of_mem hρ) _ _
      (fun hm => by
        let z : Zeta23.zetaZeroConfig.carrier := ⟨ρ,(ThirdMoment.mem_zerosFinset.mp hρ).1⟩
        have hz := BHB.Red.deriv_zeta_eq_zero_of_mult_ne_one z hm
        simp [detector, show deriv riemannZeta ρ=0 from hz])
      (hb ρ hρ))
  simp only [Finset.sum_const, nsmul_eq_mul, mul_one] at h
  rw [ThirdMoment.Ndist_eq, count, ThirdMoment.Ncount_eq]
  unfold sumAt
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  refine le_trans (Finset.sum_le_sum fun ρ _ => le_of_eq ?_) h
  rw [expand_score]
  ring

/-- An RH-only inequality for the board count retaining the signed mixed moment. -/
theorem forward_tradeoff (hRH : RiemannHypothesis) : ∀ᶠ T : ℝ in atTop,
    (1012714357/1250000000)*count T -
      (43/60)*sumAt T (fun z => (detector T z*probe T z).re) ≤ Zeta23.N0star T (2*T) := by
  filter_upwards [prime_moments hRH,local_at_width hRH (ε := 1/1000) (by norm_num),
    detector_moments hRH] with T ⟨h3,h4⟩ hl ⟨h1,h2⟩
  have h := finite_bound T hl
  rw [(Zeta23.RH_implies_all_on_line hRH _ _).2]
  unfold intercept slope scale at h
  linarith

/-- A limiting upper bound suffices at the exact affine tradeoff. -/
theorem dyadic_of_mean (hRH : RiemannHypothesis) {c : ℝ}
    (hm : ∀ η > 0, ∀ᶠ T in atTop,
      sumAt T (fun z => (detector T z*probe T z).re) ≤ (c+η)*count T) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (1012714357/1250000000-(43/60)*c-ε)*count T ≤ Zeta23.N0star T (2*T) := by
  intro ε hε
  apply eventually_atTop.mp
  filter_upwards [forward_tradeoff hRH,hm ε hε] with T h₁ h₂
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  linarith [mul_nonneg hε.le hn]

theorem cumulative_of_mean (hRH : RiemannHypothesis) {c : ℝ}
    (hm : ∀ η > 0, ∀ᶠ T in atTop,
      sumAt T (fun z => (detector T z*probe T z).re) ≤ (c+η)*count T) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (1012714357/1250000000-(43/60)*c-ε)*(Zeta23.Ncount 0 T : ℝ) ≤ Zeta23.N0star 0 T :=
  Zeta23.cumulative_of_dyadic Zeta23.zetaSeam Zeta23.riemannVonMangoldt_zeta
    (fun _ _ _ => Zeta23.N0star_add' Zeta23.zetaSeam) (dyadic_of_mean hRH hm)

theorem dyadic (hRH : RiemannHypothesis) (hf : ForwardBound) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (901/1000-ε)*(Zeta23.Ncount T (2*T) : ℝ) ≤ Zeta23.N0star T (2*T) := by
  intro ε hε
  apply eventually_atTop.mp
  filter_upwards [forward_tradeoff hRH,hf] with T h₁ h₂
  have hn : 0 ≤ count T := Nat.cast_nonneg _
  linarith [mul_nonneg hε.le hn]

theorem cumulative (hRH : RiemannHypothesis) (hf : ForwardBound) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (901/1000-ε)*(Zeta23.Ncount 0 T : ℝ) ≤ Zeta23.N0star 0 T :=
  Zeta23.cumulative_of_dyadic Zeta23.zetaSeam Zeta23.riemannVonMangoldt_zeta
    (fun _ _ _ => Zeta23.N0star_add' Zeta23.zetaSeam) (dyadic hRH hf)

