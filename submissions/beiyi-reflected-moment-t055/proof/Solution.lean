theorem _root_.Taper78.BHB.MTP.continuous_QQm_joint (ly : ℝ) :
    Continuous (fun x : (ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ =>
      Taper78.BHB.MTP.QQm ly x.1.1 x.1.2.1 x.1.2.2.1 x.1.2.2.2.1 x.1.2.2.2.2 x.2) := by
  have hf : Continuous (Function.uncurry (fun (x : (ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ) (v : ℝ) =>
      ((Taper78.BHB.MT.dPpoly ((x.2 - v) / ly) : ℝ) : ℂ)
        * Dker x.1.1 x.1.2.1 x.1.2.2.1 x.1.2.2.2.1 x.1.2.2.2.2 v)) := by
    have hg1 : Continuous (fun p : ((ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ) × ℝ => (p.1.2 - p.2) / ly) := by
      fun_prop
    have h1 : Continuous (fun p : ((ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ) × ℝ =>
        ((Taper78.BHB.MT.dPpoly ((p.1.2 - p.2) / ly) : ℝ) : ℂ)) :=
      Complex.continuous_ofReal.comp (Taper78.BHB.MTP.LB.continuous_dPpoly.comp hg1)
    have hg : Continuous (fun p : ((ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ) × ℝ =>
        ((p.1.1, p.2) : (ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ)) := by
      fun_prop

    have h2 := continuous_Dker_joint.comp hg
    exact h1.mul h2
  have hI : Continuous (fun x : (ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ =>
      ∫ v in (0 : ℝ)..x.2, ((Taper78.BHB.MT.dPpoly ((x.2 - v) / ly) : ℝ) : ℂ)
        * Dker x.1.1 x.1.2.1 x.1.2.2.1 x.1.2.2.2.1 x.1.2.2.2.2 v) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous hf continuous_snd
  have hg0 : Continuous (fun x : (ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ => x.2 / ly) := by fun_prop
  have h0 : Continuous (fun x : (ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ => ((Taper78.BHB.MT.dPpoly (x.2 / ly) : ℝ) : ℂ)) :=
