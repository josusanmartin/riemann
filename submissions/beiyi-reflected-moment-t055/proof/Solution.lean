theorem _root_.Taper78.BHB.MTP.LB.QQm_eq (ly : ℝ) (ε α ν β w : ℂ) (V : ℝ) :
    Taper78.BHB.MTP.QQm ly ε α ν β w V = ((1 / ly : ℝ) : ℂ) * (((Taper78.BHB.MT.dPpoly (V / ly) : ℝ) : ℂ)
      + ((Taper78.BHB.MT.dPpoly (V / ly) : ℝ) : ℂ) * (∫ v in (0 : ℝ)..V, Dker ε α ν β w v)
      + ((1.56 / ly : ℝ) : ℂ) * ∫ v in (0 : ℝ)..V, (v : ℂ) * Dker ε α ν β w v) := by
  have hD := continuous_Dker ε α ν β w
  have hD1 : Continuous (fun v : ℝ => (v : ℂ) * Dker ε α ν β w v) :=
    Complex.continuous_ofReal.mul hD
  have hi1 : IntervalIntegrable
      (fun v : ℝ => ((Taper78.BHB.MT.dPpoly (V / ly) : ℝ) : ℂ) * Dker ε α ν β w v) volume 0 V :=
    (continuous_const.mul hD).intervalIntegrable _ _
  have hi2 : IntervalIntegrable
      (fun v : ℝ => ((1.56 / ly : ℝ) : ℂ) * ((v : ℂ) * Dker ε α ν β w v)) volume 0 V :=
    (continuous_const.mul hD1).intervalIntegrable _ _
  have hint : (∫ v in (0 : ℝ)..V, ((Taper78.BHB.MT.dPpoly ((V - v) / ly) : ℝ) : ℂ) * Dker ε α ν β w v)
      = ((Taper78.BHB.MT.dPpoly (V / ly) : ℝ) : ℂ) * (∫ v in (0 : ℝ)..V, Dker ε α ν β w v)
        + ((1.56 / ly : ℝ) : ℂ) * ∫ v in (0 : ℝ)..V, (v : ℂ) * Dker ε α ν β w v := by
    calc (∫ v in (0 : ℝ)..V, ((Taper78.BHB.MT.dPpoly ((V - v) / ly) : ℝ) : ℂ) * Dker ε α ν β w v)
        = ∫ v in (0 : ℝ)..V, (((Taper78.BHB.MT.dPpoly (V / ly) : ℝ) : ℂ) * Dker ε α ν β w v
            + ((1.56 / ly : ℝ) : ℂ) * ((v : ℂ) * Dker ε α ν β w v)) := by
          refine intervalIntegral.integral_congr fun v _ => ?_
          show ((Taper78.BHB.MT.dPpoly ((V - v) / ly) : ℝ) : ℂ) * Dker ε α ν β w v
            = ((Taper78.BHB.MT.dPpoly (V / ly) : ℝ) : ℂ) * Dker ε α ν β w v
              + ((1.56 / ly : ℝ) : ℂ) * ((v : ℂ) * Dker ε α ν β w v)
          rw [Taper78.BHB.MTP.LB.dPpoly_sub_div]
          push_cast
          ring
      _ = _ := by
          rw [intervalIntegral.integral_add hi1 hi2, intervalIntegral.integral_const_mul,
            intervalIntegral.integral_const_mul]
  unfold Taper78.BHB.MTP.QQm
  rw [hint]
  ring
