theorem _root_.Taper78.BHB.MTP.continuous_SSlead (ly : ℝ) :
    Continuous (fun x : ℂ × ℂ × ℂ × ℂ × ℂ => Taper78.BHB.MTP.SSlead ly x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2) := by
  have hA : Continuous (fun p : (ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ =>
      Taper78.BHB.MTP.AAm ly (p.1.1 + p.1.2.2.2.2) p.2) := by
    have hg : Continuous (fun p : (ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ => p.2 / ly) := by fun_prop
    have h1 : Continuous (fun p : (ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ =>
        ((Taper78.BHB.MT.dPpoly (p.2 / ly) / ly : ℝ) : ℂ)) :=
      Complex.continuous_ofReal.comp ((Taper78.BHB.MTP.LB.continuous_dPpoly.comp hg).div_const ly)
    have h2 : Continuous (fun p : (ℂ × ℂ × ℂ × ℂ × ℂ) × ℝ => ((Taper78.BHB.Ppoly (p.2 / ly) : ℝ) : ℂ)) :=
      Complex.continuous_ofReal.comp (Taper78.BHB.MTP.LB.continuous_Ppoly.comp hg)
