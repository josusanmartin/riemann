          + Taper78.BHB.MTP.AAm ly (ε + w) (ly - v) * -(deriv (Taper78.BHB.MTP.QQm ly ε α ν β w) (ly - v))‖
        ≤ ‖deriv (Taper78.BHB.MTP.AAm ly (ε + w)) (ly - v)‖ * ‖Taper78.BHB.MTP.QQm ly ε α ν β w (ly - v)‖
          + ‖Taper78.BHB.MTP.AAm ly (ε + w) (ly - v)‖ * ‖deriv (Taper78.BHB.MTP.QQm ly ε α ν β w) (ly - v)‖ := by
          refine (norm_add_le _ _).trans ?_
          rw [norm_mul, norm_mul, norm_neg, norm_neg]
      _ ≤ 4 / ly ^ 2 * (2 / ly) + 3 / ly * (3 / ly ^ 2) :=
          add_le_add (mul_le_mul h3 h2 (norm_nonneg _) (by positivity))
            (mul_le_mul h1 h4 (norm_nonneg _) (by positivity))
      _ = 17 / ly ^ 3 := by
          field_simp
          norm_num
  have key := hC ly ρ hly hρ hρy (tfac ε α ν β) ht ly hV (Taper78.BHB.MTP.SN.Gm ly ε α ν β w)
    (Taper78.BHB.MTP.SN.contDiff_Gm ly ε α ν β w) (6 / ly ^ 2) (17 / ly ^ 3) hG0 hG1
  have hexp : Real.exp ly = y := by
    rw [hlydef, Real.exp_log hy0]
  have hint : ∫ v in (0 : ℝ)..ly, Taper78.BHB.MTP.SN.Gm ly ε α ν β w v = Taper78.BHB.MTP.SSlead ly ε α ν β w :=
    (Taper78.BHB.MTP.SSlead_eq_integral_reflect ly ε α ν β w).symm
  rw [hexp, hint] at key
  have hsum : ∑ n ∈ Finset.Icc 1 ⌊y⌋₊, (((μ n : ℝ) ^ 2 / φ n : ℝ) : ℂ)
        * (∏ p ∈ n.primeFactors, tfac ε α ν β p)
        * (Taper78.BHB.MTP.AAm ly (ε + w) (Real.log (y / n)) * Taper78.BHB.MTP.QQm ly ε α ν β w (Real.log (y / n)))
      = ∑ n ∈ Finset.Icc 1 ⌊y⌋₊, (((μ n : ℝ) ^ 2 / φ n : ℝ) : ℂ)
        * (∏ p ∈ n.primeFactors, tfac ε α ν β p) * Taper78.BHB.MTP.SN.Gm ly ε α ν β w (Real.log n) := by
    refine Finset.sum_congr rfl fun n hn => ?_
    have hn0 : (0 : ℝ) < n := by exact_mod_cast (Finset.mem_Icc.mp hn).1
    unfold Taper78.BHB.MTP.SN.Gm
    rw [Real.log_div hy0.ne' hn0.ne', ← hlydef]
  rw [hsum]
