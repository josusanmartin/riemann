section Src_RetaperProof

open Lean Elab Command
namespace MollifierTransport

/-- Reuse an existing checked proof after replacing the coefficient functions.
The resulting definition or theorem is submitted as an ordinary declaration. -/
private def replaceConstants (env : Environment) (e : Expr) : Expr :=
  e.replace fun
    | .const n ls => if env.contains (`Taper78 ++ n) then some (.const (`Taper78 ++ n) ls) else none
    | _ => none

private partial def transport (selected : NameSet) (n : Name) : CoreM Unit := do
  let name := `Taper78 ++ n
  unless selected.contains n do return
  if (← getEnv).contains name then return
  let src ← getConstInfo n
  for k in src.getUsedConstantsAsSet do
    if k != n then transport selected k
  let env ← getEnv
  let subst := replaceConstants env
  let decl ← match src with
    | .thmInfo t => pure <| Declaration.thmDecl { t with name, type := subst t.type, value := subst t.value, all := [name] }
    | .defnInfo d =>
      if d.safety != .safe then throwError "expected a safe definition at {n}"
      pure <| Declaration.defnDecl { d with name, type := subst d.type, value := subst d.value, all := [name] }
    | _ => throwError "expected a definition or theorem at {n}"
  addDecl decl

elab "#retaper " ns:ident+ : command => do
  let names := ns.map Syntax.getId
  let selected := names.foldl (init:={}) (fun s n => s.insert n)
  liftCoreM <| names.forM (transport selected)
end MollifierTransport

end Src_RetaperProof

