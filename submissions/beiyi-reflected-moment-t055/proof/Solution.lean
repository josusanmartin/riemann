      ≤ |a2 * L ^ 2| + |a1 * L| + |a0| + |am / L| := by
        refine (abs_add_le _ _).trans ?_
        gcongr
        refine (abs_add_le _ _).trans ?_
        gcongr
        exact abs_add_le _ _
    _ ≤ |a2| * L ^ 2 + |a1| * L ^ 2 + |a0| * L ^ 2 + |am| * L ^ 2 := by
        rw [b2]
        linarith
    _ = (|a2| + |a1| + |a0| + |am|) * L ^ 2 := by ring
