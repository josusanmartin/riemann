section Src_ReflectedLog

noncomputable section
open Real MeasureTheory ReflectedPrincipal PrincipalSmoothing
open scoped BigOperators

namespace ReflectedLog

def twist (H : ℝ → ℝ) (Y α : ℝ) : ℂ :=
  ∑' n : ℕ, (H (n/Y)*Real.log n : ℝ) • BHB.e (n*α)

private theorem sharp {α : ℝ} (hα : Real.sin (Real.pi*α) ≠ 0) (N : ℕ) :
    ‖∑ n ∈ Finset.range (N+1), Real.log n • BHB.e (n*α)‖ ≤
      2*(1/|Real.sin (Real.pi*α)|)*Real.log N := by
  let B := 1/|Real.sin (Real.pi*α)|
  have hB : 0 ≤ B := by unfold B; positivity
  have hG (n : ℕ) : ‖∑ k ∈ Finset.range n, BHB.e (k*α)‖ ≤ B := by
    simpa only [zero_add] using BHB.M2.norm_sum_e_le hα 0 n
  have hstep (n : ℕ) : 0 ≤ Real.log (n+1:ℕ)-Real.log n := by
    cases n with
    | zero => norm_num
    | succ n => exact sub_nonneg.mpr (Real.log_le_log (by positivity) (by exact_mod_cast Nat.le_succ _))
  rw [Finset.sum_range_by_parts]
  simp only [Nat.add_sub_cancel]
  apply (norm_sub_le ..).trans
  have h₁ : ‖Real.log N • ∑ i ∈ Finset.range (N+1), BHB.e (i*α)‖ ≤ Real.log N*B := by
    rw [norm_smul,Real.norm_eq_abs,abs_of_nonneg (Real.log_natCast_nonneg _)]
    exact mul_le_mul_of_nonneg_left (hG _) (Real.log_natCast_nonneg _)
  have h₂ : ‖∑ i ∈ Finset.range N, (Real.log (i+1:ℕ)-Real.log i) •
      ∑ k ∈ Finset.range (i+1), BHB.e (k*α)‖ ≤ Real.log N*B := by
    apply (norm_sum_le ..).trans
    calc
      _ ≤ ∑ i ∈ Finset.range N, (Real.log (i+1:ℕ)-Real.log i)*B := by
        apply Finset.sum_le_sum
        intro i _
        rw [norm_smul,Real.norm_eq_abs,abs_of_nonneg (hstep _)]
        exact mul_le_mul_of_nonneg_left (hG _) (hstep _)
      _ = _ := by rw [← Finset.sum_mul,Finset.sum_range_sub (fun i : ℕ => Real.log i)]; simp
  linarith only [h₁,h₂]

private theorem coord_prefix (P : ℂ →L[ℝ] ℝ) (hP : ∀ z, |P z| ≤ ‖z‖)
    {α : ℝ} (hα : Real.sin (Real.pi*α) ≠ 0) {Y v : ℝ} (hY : 1 ≤ Y) (hv : 0 < v) :
    |partialSum (fun n => Real.log n * P (BHB.e (n*α))) (Y*v)| ≤
      2*(1/|Real.sin (Real.pi*α)|)*(1+Real.log Y)*(1+v) := by
  let N := ⌊Y*v⌋₊
  have hproj : partialSum (fun n => Real.log n*P (BHB.e (n*α))) (Y*v) =
      P (∑ n ∈ Finset.range (N+1), Real.log n • BHB.e (n*α)) := by
    rw [map_sum]
    simp only [map_smul,smul_eq_mul]
    rw [Nat.range_succ_eq_Icc_zero,Finset.Icc_eq_cons_Ioc (Nat.zero_le N),Finset.sum_cons]
    simp [partialSum,below,N]
  have hln : Real.log N ≤ (1+Real.log Y)*(1+v) := by
    have hlog := Real.log_nonneg hY
    by_cases hn : N=0
    · rw [hn, Nat.cast_zero, Real.log_zero]; positivity
    have hY₀ : 0 < Y := by linarith
    have hu := Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero hn) (Nat.floor_le (mul_nonneg hY₀.le hv.le))
    rw [Real.log_mul hY₀.ne' hv.ne'] at hu
    nlinarith only [hu,Real.log_le_self hv.le,mul_nonneg hlog hv.le]
  rw [hproj]
  exact ((hP _).trans (sharp hα N)).trans ((mul_le_mul_of_nonneg_left hln (by positivity)).trans_eq (by ring))

private theorem deriv_envelope {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) :
    IntegrableOn (fun t => |deriv H t| * (1+t)^2) (Set.Ioi 0) := by
  obtain ⟨D,hd,hD,hdec⟩ := hH.deriv
  have he : deriv H=D := funext fun x => (hd x).deriv
  rw [he]
  obtain ⟨C,hC⟩ := hdec 4
  have hi := (BHB.MT.SM1.integrableOn_inv_pow 0).const_mul C
  apply Integrable.mono' hi (hD.abs.mul ((continuous_const.add continuous_id).pow 2)).aestronglyMeasurable
  filter_upwards [ae_restrict_mem (μ:=volume) (measurableSet_Ioi (a:=(0:ℝ)))] with t ht
  have ht₀ : 0 < t := ht
  rw [Real.norm_eq_abs,abs_of_nonneg (mul_nonneg (abs_nonneg _) (sq_nonneg _))]
  exact (mul_le_mul_of_nonneg_right (hC t ht₀.le) (sq_nonneg _)).trans_eq (by
    norm_num; field_simp [show (1+t) ≠ 0 by linarith])

private def variation (H : ℝ → ℝ) := ∫ t in Set.Ioi 0, |deriv H t| * (1+t)^2

private theorem discrepancy {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) (f : ℕ → ℝ) (h₀ : f 0=0)
    {C Y K : ℝ} (hC : 0 ≤ C) (hf : ∀ n : ℕ, |f n| ≤ C*(1+n)^2) (hY : 0 < Y)
    (hp : ∀ v : ℝ, 0 < v → |partialSum f (Y*v)| ≤ K*(1+v)^2) :
    |∑' n : ℕ, H (n/Y)*f n| ≤ K*variation H := by
  rw [smooth_abel hH f h₀ hC hf hY,abs_neg]
  have hm := (deriv_envelope hH).const_mul K
  have hh : ∀ᵐ t ∂volume.restrict (Set.Ioi 0), ‖deriv H t*partialSum f (Y*t)‖ ≤ K*(|deriv H t| * (1+t)^2) := by
    filter_upwards [ae_restrict_mem (μ:=volume) (measurableSet_Ioi (a:=(0:ℝ)))] with t ht
    rw [Real.norm_eq_abs,abs_mul]
    exact (mul_le_mul_of_nonneg_left (hp t ht) (abs_nonneg _)).trans_eq (by ring)
  simpa only [Real.norm_eq_abs,integral_const_mul,variation] using norm_integral_le_of_norm_le hm hh

theorem twist_summable {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) {Y : ℝ} (hY : 1 ≤ Y) (α : ℝ) :
    Summable (fun n : ℕ => (H (n/Y)*Real.log n : ℝ) • BHB.e (n*α)) := by
  obtain ⟨A,ha⟩ := hH.decay 3
  have hs := (summable_nat_add_iff 1).mpr (summable_one_div_nat_pow.mpr (by norm_num : 1 < 2))
  have hg : Summable (fun n : ℕ => (|A| * Y^3)*(1/(1+(n:ℝ))^2)) := by
    apply (hs.mul_left (|A| * Y^3)).congr
    intro n; push_cast; ring
  apply Summable.of_norm_bounded hg
  intro n
  have hY₀ : 0 < Y := by linarith
  have hn := Nat.cast_nonneg (α:=ℝ) n
  have hu : 0 < 1+(n:ℝ)/Y := by positivity
  have hw := ha (n/Y) (div_nonneg hn hY₀.le)
  have ha' : |H (n/Y)| ≤ |A| * Y^3/(1+(n:ℝ))^3 := by
    apply hw.trans
    calc
      _ ≤ |A|/(1+(n:ℝ)/Y)^3 := by gcongr; exact le_abs_self _
      _ = |A| * Y^3/(Y+n)^3 := by field_simp [hY₀.ne']
      _ ≤ _ := by gcongr
  rw [norm_smul,BHB.norm_e,mul_one,Real.norm_eq_abs,abs_mul,abs_of_nonneg (Real.log_natCast_nonneg _)]
  have hn' : Real.log n ≤ 1+n := by linarith [Real.log_le_self hn]
  exact (mul_le_mul ha' hn' (Real.log_natCast_nonneg _) (by positivity)).trans_eq (by field_simp)

/-- Uniform in the logarithmic scale and the nonintegral rational frequency. -/
theorem twisted_log {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ Y : ℝ, 1 ≤ Y → ∀ α : ℝ, Real.sin (Real.pi*α) ≠ 0 →
      ‖twist H Y α‖ ≤ C*(1+Real.log Y)/|Real.sin (Real.pi*α)| := by
  have hV : 0 ≤ variation H := setIntegral_nonneg measurableSet_Ioi fun _ _ =>
    mul_nonneg (abs_nonneg _) (sq_nonneg _)
  refine ⟨4*variation H,by positivity,?_⟩
  intro Y hY α hα
  let K := 2*(1/|Real.sin (Real.pi*α)|)*(1+Real.log Y)
  have hK : 0 ≤ K := by dsimp [K]; positivity [Real.log_nonneg hY]
  have hcoord (P : ℂ →L[ℝ] ℝ) (hP : ∀ z, |P z| ≤ ‖z‖) :
      |P (twist H Y α)| ≤ K*variation H := by
    unfold twist
    rw [P.map_tsum (twist_summable hH hY α)]
    simp_rw [map_smul,smul_eq_mul,mul_assoc]
    refine discrepancy hH _ (by simp) (C:=1) (by norm_num) ?_ (by linarith) ?_
    · intro n; rw [abs_mul,abs_of_nonneg (Real.log_natCast_nonneg _)]
      have h := (hP _).trans_eq (BHB.norm_e (n*α))
      nlinarith only [mul_le_mul_of_nonneg_left h (Real.log_natCast_nonneg n),Real.log_le_self (Nat.cast_nonneg (α:=ℝ) n),Nat.cast_nonneg (α:=ℝ) n,sq_nonneg (n:ℝ)]
    · intro v hv
      exact (coord_prefix P hP hα hY hv).trans (mul_le_mul_of_nonneg_left
        (by nlinarith only [hv.le,sq_nonneg v]) hK)
  have h := (Complex.norm_le_abs_re_add_abs_im (twist H Y α)).trans (add_le_add
    (hcoord Complex.reCLM Complex.abs_re_le_norm) (hcoord Complex.imCLM Complex.abs_im_le_norm))
  exact h.trans_eq (by dsimp only [K]; ring)

/-- Each complete nonzero residue block costs at most k(1+log k).
The final partial block is included. The label set can be sparse. -/
theorem label_spacing {k M : ℕ} (hk : 1 ≤ k) (q : Finset ℕ)
    (hq : ∀ p ∈ q, p ≤ M ∧ ¬k ∣ p) :
    ∑ p ∈ q, 1/|Real.sin (Real.pi*((p:ℝ)/k))| ≤ (M+(k:ℝ))*(1+Real.log k) := by
  classical
  let w := fun p : ℕ => if k ∣ p then (0:ℝ) else 1/|Real.sin (Real.pi*((p:ℝ)/k))|
  have hw (p : ℕ) : 0 ≤ w p := by dsimp only [w]; split <;> positivity
  have hblock (i : ℕ) : ∑ p ∈ Finset.Ico (i*k) ((i+1)*k), w p ≤ k*(1+Real.log k) := by
    have hlt : i*k < (i+1)*k := by rw [add_mul]; omega
    rw [← Finset.Ioo_insert_left hlt,Finset.sum_insert Finset.left_notMem_Ioo,
      show w (i*k)=0 by simp [w],zero_add]
    have hb := BHB.M2.sum_block_inv_sin hk (Nat.coprime_one_left k) i
    simp only [Nat.cast_one,mul_one] at hb
    apply le_trans ?_ (hb.le.trans (BHB.M2.sum_inv_sin_le hk))
    apply Finset.sum_le_sum
    intro p _
    dsimp only [w]; split <;> first | positivity | rfl
  have hblocks (n : ℕ) : ∑ p ∈ Finset.range (n*k), w p ≤ (n:ℝ)*(k*(1+Real.log k)) := by
    induction n with
    | zero => simp
    | succ n ih =>
      rw [← Finset.sum_range_add_sum_Ico w (by rw [Nat.succ_mul]; omega : n*k ≤ (n+1)*k)]
      exact (add_le_add ih (hblock n)).trans_eq (by push_cast; ring)
  let n := M/k+1
  have hn : M<n*k := by simpa only [n,mul_comm k] using Nat.lt_mul_div_succ M hk
  calc
    _ = ∑ p ∈ q, w p := Finset.sum_congr rfl fun p hp => by simp [w,(hq p hp).2]
    _ ≤ ∑ p ∈ Finset.range (n*k), w p := Finset.sum_le_sum_of_subset_of_nonneg
      (fun p hp => Finset.mem_range.mpr ((hq p hp).1.trans_lt hn)) (fun p _ _ => hw p)
    _ ≤ (n:ℝ)*(k*(1+Real.log k)) := hblocks n
    _ ≤ _ := by
      rw [← mul_assoc]
      have hd : n*k ≤ M+k := by dsimp [n]; rw [add_mul,one_mul]; exact Nat.add_le_add_right (Nat.div_mul_le_self ..) _
      exact mul_le_mul_of_nonneg_right (by exact_mod_cast hd) (by positivity [Real.log_natCast_nonneg k])

private theorem sign_sine {s : ℝ} (hs : s=1 ∨ s= -1) (v : ℝ) :
    |Real.sin (Real.pi*(s*v))| = |Real.sin (Real.pi*v)| := by
  rcases hs with rfl|rfl <;> simp

/-- The logarithmic packet from every nonunit modulus, with its physical
coefficient and scale. Both signs of the original additive character are allowed. -/
def nonunit (H : ℝ → ℝ) (X sign : ℝ) (s q : Finset ℕ) (a z : ℕ → ℝ) :=
  ∑ k ∈ s, ∑ p ∈ q, (a k*z p*Real.log ((k:ℝ)/p)/k) • twist H (k*X/p) (sign*((p:ℝ)/k))

theorem nonunit_bound {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (M : ℕ) (X σ : ℝ), 1 ≤ M → (M:ℝ) ≤ X → (σ=1 ∨ σ= -1) →
      ∀ (s q : Finset ℕ) (a z : ℕ → ℝ), s ⊆ Finset.Icc 2 M → (∀ p ∈ q, p ≤ M) →
      (∀ k ∈ s, ∀ p ∈ q, k ≤ p ∧ ¬k ∣ p) → (∀ k ∈ s, |a k| ≤ 1) → (∀ p ∈ q, |z p| ≤ 1) →
      ‖nonunit H X σ s q a z‖ ≤ C*M*(1+Real.log M)^3*(1+Real.log X) := by
  obtain ⟨D,hD,hT⟩ := twisted_log hH
  refine ⟨2*D,by positivity,?_⟩
  intro M X σ hM hX hσ s q a z hs hq hkp ha hz
  have hM₁ : (1:ℝ) ≤ M := by exact_mod_cast hM
  have hX₁ := hM₁.trans hX
  let U := 1+Real.log M
  let V := 1+Real.log X
  let W := D*V*U
  have hU : 0 ≤ U := by dsimp [U]; positivity [Real.log_natCast_nonneg M]
  have hV : 0 ≤ V := by dsimp [V]; positivity [Real.log_nonneg hX₁]
  have hW : 0 ≤ W := by dsimp only [W]; positivity
  have hrow (k : ℕ) (hk : k ∈ s) : ‖∑ p ∈ q,
      (a k*z p*Real.log ((k:ℝ)/p)/k) • twist H (k*X/p) (σ*((p:ℝ)/k))‖ ≤ (1/(k:ℝ))*(W*(2*M*U)) := by
    obtain ⟨hk₂,hkM⟩ := Finset.mem_Icc.mp (hs hk)
    have hk₁ : (1:ℝ) ≤ k := by exact_mod_cast (show 1 ≤ k by omega)
    have hk₀ : 0 < (k:ℝ) := lt_of_lt_of_le zero_lt_one hk₁
    apply (norm_sum_le ..).trans
    calc
      _ ≤ ∑ p ∈ q, (W/k)*(1/|Real.sin (Real.pi*((p:ℝ)/k))|) := by
        apply Finset.sum_le_sum
        intro p hp
        obtain ⟨hkp',hnd⟩ := hkp k hk p hp
        have hp₁ := hk₁.trans (Nat.cast_le.mpr hkp')
        have hp₀ : 0 < (p:ℝ) := lt_of_lt_of_le zero_lt_one hp₁
        have hpM : (p:ℝ) ≤ M := by exact_mod_cast hq p hp
        have hY : 1 ≤ (k:ℝ)*X/p := (le_div_iff₀ hp₀).mpr (by nlinarith only [hpM,hX,mul_le_mul_of_nonneg_right hk₁ (by linarith : 0 ≤ X)])
        have hY' : (k:ℝ)*X/p ≤ X := (div_le_iff₀ hp₀).mpr (by nlinarith only [mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hkp') (by linarith : 0 ≤ X)])
        have hθ := BHB.M2.sin_ne_zero_of_not_dvd (show 1≤k by omega) (Nat.coprime_one_left k) hnd
        simp only [Nat.cast_one,mul_one] at hθ
        have hθ' : Real.sin (Real.pi*(σ*((p:ℝ)/k))) ≠ 0 := by apply abs_pos.mp; rw [sign_sine hσ]; exact abs_pos.mpr hθ
        have htw := hT _ hY _ hθ'
        rw [sign_sine hσ] at htw
        have hlog : |Real.log ((k:ℝ)/p)| ≤ U := by
          rw [Real.log_div hk₀.ne' hp₀.ne',abs_of_nonpos (sub_nonpos.mpr (Real.log_le_log hk₀ (Nat.cast_le.mpr hkp')))]
          dsimp only [U]; linarith [Real.log_le_log hp₀ hpM,Real.log_natCast_nonneg k]
        have hc : |a k*z p*Real.log ((k:ℝ)/p)/k| ≤ U/k := by
          rw [abs_div,abs_mul,abs_mul,abs_of_pos hk₀]
          apply div_le_div_of_nonneg_right _ hk₀.le
          exact (mul_le_mul (mul_le_one₀ (ha k hk) (abs_nonneg _) (hz p hp)) hlog (abs_nonneg _) zero_le_one).trans_eq (one_mul _)
        have hu : ‖twist H (k*X/p) (σ*((p:ℝ)/k))‖ ≤ D*V/|Real.sin (Real.pi*((p:ℝ)/k))| :=
          htw.trans (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left
            (add_le_add_right (Real.log_le_log (by linarith) hY') 1) hD) (abs_nonneg _))
        rw [norm_smul,Real.norm_eq_abs]
        exact (mul_le_mul hc hu (norm_nonneg _) (by positivity)).trans_eq (by dsimp [W]; ring)
      _ ≤ _ := by
        rw [← Finset.mul_sum]
        have hsp := label_spacing (show 1≤k by omega) q (fun p hp => ⟨hq p hp,(hkp k hk p hp).2⟩)
        have hsp' : (M+(k:ℝ))*(1+Real.log k) ≤ 2*M*U :=
          mul_le_mul (by linarith [show (k:ℝ) ≤ M by exact_mod_cast hkM]) (add_le_add_right (Real.log_le_log hk₀ (Nat.cast_le.mpr hkM)) _)
            (by positivity [Real.log_natCast_nonneg k]) (by positivity)
        exact (mul_le_mul_of_nonneg_left (hsp.trans hsp') (div_nonneg hW hk₀.le)).trans_eq (by ring)
  apply (norm_sum_le ..).trans ((Finset.sum_le_sum hrow).trans ?_)
  rw [← Finset.sum_mul]
  have hh : (∑ k ∈ s, 1/(k:ℝ)) ≤ U := (Finset.sum_le_sum_of_subset_of_nonneg
    (hs.trans (Finset.Icc_subset_Icc_left (by decide : 1 ≤ 2))) (fun k _ _ => by positivity)).trans
    (BHB.Arith.sum_Icc_one_div_le_one_add_log M)
  exact (mul_le_mul_of_nonneg_right hh (by positivity : 0 ≤ W*(2*M*U))).trans_eq (by dsimp [W,U,V]; ring)

private theorem x_log {v : ℝ} (hv : 0 < v) : |v*Real.log v| ≤ (1+v)^2 := by
  rw [abs_mul,abs_of_pos hv]
  rcases le_or_gt 1 v with h|h
  · rw [abs_of_nonneg (Real.log_nonneg h)]
    nlinarith only [mul_le_mul_of_nonneg_left (Real.log_le_self hv.le) hv.le,hv.le]
  · rw [abs_of_nonpos (Real.log_nonpos hv.le h.le),← Real.log_inv]
    have := mul_le_mul_of_nonneg_left (Real.log_le_self (inv_nonneg.mpr hv.le)) hv.le
    rw [mul_inv_cancel₀ hv.ne'] at this
    nlinarith only [this,hv.le,sq_nonneg v]

private theorem factorial_error {Y v : ℝ} (hY : 1 ≤ Y) (hv : 0 < v) :
    |partialSum (fun n => Real.log n) (Y*v)-(Y*v)*(Real.log (Y*v)-1)| ≤
      (4*(1+Real.log Y))*(1+v)^2 := by
  have hY₀ : 0 < Y := by linarith
  have hl := Real.log_nonneg hY
  have he : 2+Real.log Y+v ≤ (4*(1+Real.log Y))*(1+v)^2 := by
    nlinarith only [hl,hv.le,mul_nonneg hl hv.le,mul_nonneg hl (sq_nonneg v),sq_nonneg v]
  rcases le_or_gt 1 (Y*v) with hu|hu
  · have h := log_sum (x:=Y*v) hu
    rw [← mul_sub_one] at h
    exact h.trans (by rw [Real.log_mul hY₀.ne' hv.ne']; linarith only [he,Real.log_le_self hv.le])
  · have hx := mul_pos hY₀ hv
    rw [partialSum,below,Nat.floor_eq_zero.mpr hu,Finset.Ioc_self,Finset.sum_empty,zero_sub,abs_neg,
      abs_mul,abs_of_pos hx,abs_of_nonpos (by linarith [Real.log_nonpos hx.le hu.le] : Real.log (Y*v)-1 ≤ 0)]
    have h := mul_le_mul_of_nonneg_left (Real.log_le_self (inv_nonneg.mpr hx.le)) hx.le
    rw [Real.log_inv,mul_inv_cancel₀ hx.ne'] at h
    nlinarith only [he,hl,h,hv.le,hu.le]

/-- The unit frequency includes the constant term from the log-weighted profile.
The error is uniform for every scale Y≥1. -/
theorem unit_log {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ Y : ℝ, 1 ≤ Y →
      |(∑' n : ℕ, H (n/Y)*Real.log n)-
        Y*((Real.log Y-1)*(∫ t in Set.Ioi 0, H t)+logMoment H 1)| ≤ C*(1+Real.log Y) := by
  have hV : 0 ≤ variation H := setIntegral_nonneg measurableSet_Ioi fun _ _ =>
    mul_nonneg (abs_nonneg _) (sq_nonneg _)
  refine ⟨4*variation H,by positivity,?_⟩
  intro Y hY
  have hY₀ : 0 < Y := by linarith
  let S := fun t : ℝ => partialSum (fun n => Real.log n) (Y*t)
  let B := fun t : ℝ => (Y*t)*(Real.log (Y*t)-1)
  let E := fun t => deriv H t*(S t-B t)
  let K := 4*(1+Real.log Y)
  have hmS : Measurable S := (measurable_of_countable (f:=fun N : ℕ =>
    ∑ n ∈ Finset.Ioc 0 N, Real.log n)).comp (Nat.measurable_floor.comp (measurable_const.mul measurable_id))
  have hmB : Measurable B := by dsimp [B]; fun_prop
  obtain ⟨D,hd,hD,_⟩ := hH.deriv
  have hmd : Measurable (deriv H) := (hD.congr (fun x => (hd x).deriv.symm)).measurable
  have hmE : Measurable E := hmd.mul (hmS.sub hmB)
  have hh : ∀ᵐ t ∂volume.restrict (Set.Ioi 0), ‖E t‖ ≤ K*(|deriv H t| * (1+t)^2) := by
    filter_upwards [ae_restrict_mem (μ:=volume) (measurableSet_Ioi (a:=(0:ℝ)))] with t ht
    rw [Real.norm_eq_abs,show E t=deriv H t*(S t-B t) from rfl,abs_mul]
    exact (mul_le_mul_of_nonneg_left (factorial_error hY ht) (abs_nonneg _)).trans_eq (by ring)
  have hei := (deriv_envelope hH).const_mul K
  have hiE := Integrable.mono' hei hmE.aestronglyMeasurable hh
  have hErr := norm_integral_le_of_norm_le hei hh
  rw [Real.norm_eq_abs,integral_const_mul] at hErr
  have hlin : IntegrableOn (fun t => deriv H t*t) (Set.Ioi 0) := by
    apply Integrable.mono' (deriv_envelope hH) (hmd.mul measurable_id).aestronglyMeasurable
    filter_upwards [ae_restrict_mem (μ:=volume) (measurableSet_Ioi (a:=(0:ℝ)))] with t ht
    have ht₀ : 0 < t := ht
    change ‖deriv H t*t‖ ≤ _
    rw [Real.norm_eq_abs,abs_mul,abs_of_pos ht₀]
    exact mul_le_mul_of_nonneg_left (by nlinarith only [ht₀.le,sq_nonneg t]) (abs_nonneg _)
  have hlog : IntegrableOn (fun t => deriv H t*(t*Real.log t)) (Set.Ioi 0) := by
    apply Integrable.mono' (deriv_envelope hH) (hmd.mul (measurable_id.mul Real.measurable_log)).aestronglyMeasurable
    filter_upwards [ae_restrict_mem (μ:=volume) (measurableSet_Ioi (a:=(0:ℝ)))] with t ht
    change ‖deriv H t*(t*Real.log t)‖ ≤ _
    rw [Real.norm_eq_abs,abs_mul]
    exact mul_le_mul_of_nonneg_left (x_log ht) (abs_nonneg _)
  have hrep (t : ℝ) : deriv H t*B t = (Y*(Real.log Y-1))*(deriv H t*t)+Y*(deriv H t*(t*Real.log t)) := by
    rcases eq_or_ne t 0 with rfl|ht
    · simp [B]
    · dsimp [B]; rw [Real.log_mul hY₀.ne' ht]; ring
  have hB : IntegrableOn (fun t => (Y*(Real.log Y-1))*(deriv H t*t)+Y*(deriv H t*(t*Real.log t))) (Set.Ioi 0) :=
    (hlin.const_mul (Y*(Real.log Y-1))).add (hlog.const_mul Y)
  have he : (fun t => deriv H t*S t) = fun t => E t+
      ((Y*(Real.log Y-1))*(deriv H t*t)+Y*(deriv H t*(t*Real.log t))) := by
    funext t; rw [← hrep]; dsimp [E]; ring
  have hm := zeroth_logMoment hH
  simp only [logMoment,pow_zero,mul_one] at hm
  rw [smooth_abel hH _ (by simp) (C:=1) (by norm_num) (fun n => by
    rw [abs_of_nonneg (Real.log_natCast_nonneg _)]
    nlinarith only [Real.log_le_self (Nat.cast_nonneg (α:=ℝ) n),Nat.cast_nonneg (α:=ℝ) n,sq_nonneg (n:ℝ)]) hY₀]
  change |-(∫ t in Set.Ioi 0, deriv H t*S t)-_| ≤ _
  rw [he,integral_add hiE hB,integral_add (hlin.const_mul _) (hlog.const_mul _),integral_const_mul,integral_const_mul,
    ← hm]
  simp only [logMoment,pow_one]
  rw [show -( (∫ t in Set.Ioi 0,E t)+_)-_ = -(∫ t in Set.Ioi 0,E t) by ring,abs_neg]
  exact hErr.trans_eq (by dsimp only [K,variation]; ring)

end ReflectedLog
end
end Src_ReflectedLog

section Src_ReflectedLogBand


noncomputable section
open Real MeasureTheory ReflectedPrincipal PrincipalBand ReflectedLog
open scoped BigOperators

namespace ReflectedLogBand

def logPacket (F H : ℝ → ℝ) (L y l h σ : ℝ) : ℂ :=
  ∑ k ∈ below (exp (L*y)), ∑ p ∈ band L l h,
    (-(mollifier F L k*label h L p*Real.log ((k:ℝ)/p)/k)) •
      twist H (k*heightScale L/p) (σ*((p:ℝ)/k))

def unitPacket (H : ℝ → ℝ) (L l h : ℝ) : ℝ :=
  ∑ p ∈ band L l h, label h L p*Real.log p*(∑' n : ℕ, H (n/(heightScale L/p))*Real.log n)

def remaining (F H : ℝ → ℝ) (L y l h σ : ℝ) :=
  nonunit H (heightScale L) σ ((below (exp (L*y))).erase 1) (band L l h) (mollifier F L) (label h L)

private theorem unit_twist (H : ℝ → ℝ) (Y σ : ℝ) (hσ : σ=1 ∨ σ= -1) (p : ℕ) :
    twist H Y (σ*p) = ((∑' n : ℕ, H (n/Y)*Real.log n : ℝ) : ℂ) := by
  have he (n : ℕ) : BHB.e (n*(σ*p))=1 := by
    rcases hσ with rfl|rfl
    · simpa using BHB.e_natCast (n*p)
    · convert BHB.e_intCast (-(n*p:ℕ):ℤ) using 2
      push_cast
      ring
  unfold twist; simp_rw [he,Complex.real_smul,mul_one]
  exact (Complex.ofReal_tsum _).symm

theorem split (F H : ℝ → ℝ) {L y : ℝ} (hL : 0 ≤ L) (hy : 0 ≤ y) (l h σ : ℝ)
    (hσ : σ=1 ∨ σ= -1) : logPacket F H L y l h σ =
      (F 0*unitPacket H L l h : ℝ)-remaining F H L y l h σ := by
  classical
  have h₁ : 1 ∈ below (exp (L*y)) := by simp [below,Nat.le_floor_iff (exp_pos _).le,mul_nonneg hL hy]
  unfold logPacket
  rw [← Finset.add_sum_erase _ _ h₁]
  have he : ∑ p ∈ band L l h, (-(mollifier F L 1*label h L p*Real.log ((1:ℕ)/ (p:ℝ))/1)) •
      twist H ((1:ℕ)*heightScale L/p) (σ*((p:ℝ)/1)) = (F 0*unitPacket H L l h:ℝ) := by
    unfold unitPacket
    push_cast
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro p _
    simp [mollifier,unit_twist H _ σ hσ,one_div,Complex.real_smul,Real.log_inv]
    push_cast; ring
  simp only [Nat.cast_one] at he ⊢
  rw [he]
  simp only [neg_smul,Finset.sum_neg_distrib,sub_eq_add_neg,remaining,nonunit]

lemma log_mem {L y : ℝ} (hL : 0 < L) {n : ℕ} (hn : n ∈ below (exp (L*y))) :
    Real.log n/L ∈ Set.Icc 0 y := by
  obtain ⟨hn₀,hn'⟩ := Finset.mem_Ioc.mp hn
  refine ⟨div_nonneg (Real.log_natCast_nonneg _) hL.le,(div_le_iff₀ hL).mpr ?_⟩
  rw [mul_comm y]; exact (Real.log_le_iff_le_exp (by exact_mod_cast hn₀)).mpr
    ((Nat.le_floor_iff (exp_pos _).le).mp hn')

lemma label_bound {L l h : ℝ} (hL : 0 < L) (hh : 0 < h)
    {p : ℕ} (hp : p ∈ band L l h) : |label h L p| ≤ 1 := by
  have hx := log_mem hL (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).1
  have hu := div_nonneg hx.1 hh.le
  have hu' := (div_le_one hh).mpr hx.2
  rw [label,abs_of_nonneg (mul_nonneg hu (sub_nonneg.mpr hu'))]
  exact mul_le_one₀ hu' (sub_nonneg.mpr hu') (by linarith)

lemma scales {h : ℝ} (hh : h < 1) : ∀ᶠ T : ℝ in Filter.atTop,
    1 ≤ Real.log T ∧ T^h ≤ heightScale (Real.log T) ∧ heightScale (Real.log T) ≤ T ∧ 0 < T := by
  filter_upwards [Filter.eventually_ge_atTop (exp 1),
    (tendsto_rpow_atTop (sub_pos.mpr hh)).eventually_ge_atTop (2*Real.pi)] with T hT hs
  have h₀ : 0 < T := (exp_pos _).trans_le hT
  have hX : heightScale (Real.log T)=T/(2*Real.pi) := by rw [heightScale,Real.exp_log h₀]
  refine ⟨(Real.le_log_iff_exp_le h₀).mpr hT,?_,?_,h₀⟩
  · rw [hX,le_div_iff₀ (by positivity)]
    apply (mul_le_mul_of_nonneg_left hs (Real.rpow_pos_of_pos h₀ h).le).trans_eq
    rw [← Real.rpow_add h₀,add_sub_cancel,Real.rpow_one]
  · rw [hX]; exact div_le_self h₀.le (by linarith [Real.pi_gt_three])

/-- The nonunit part is little-o of T at each fixed upper exponent h<1. -/
theorem remaining_negligible (F : ℝ → ℝ) {H : ℝ → ℝ} (hH : BHB.Arith.Adm H)
    {y l h : ℝ} (_hy : 0 ≤ y) (hyl : y ≤ l) (hlh : l ≤ h) (hh : 0 < h) (hh₁ : h < 1)
    (hFb : ∀ v ∈ Set.Icc 0 y, |F v| ≤ 1) :
    ∀ ε : ℝ, 0 < ε → ∀ᶠ T : ℝ in Filter.atTop, ∀ σ : ℝ, (σ=1 ∨ σ= -1) →
      ‖remaining F H (Real.log T) y l h σ‖ ≤ ε*T := by
  obtain ⟨C,hC,hN⟩ := nonunit_bound hH
  intro ε hε
  let δ := ε/(16*(C+1))
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hb := (isLittleO_log_rpow_rpow_atTop 4 (sub_pos.mpr hh₁)).bound hδ
  filter_upwards [scales hh₁,hb] with T hsc hlog
  intro σ hσ
  obtain ⟨hL,hMX,hXT,hT₀⟩ := hsc
  let L := Real.log T
  let X := heightScale L
  let M := ⌊T^h⌋₊
  let s := (below (exp (L*y))).erase 1
  let q := band L l h
  have hL₀ : 0 < L := by dsimp [L]; linarith
  have hT₁ : 1 ≤ T := by have := (Real.le_log_iff_exp_le hT₀).mp hL; linarith [Real.add_one_le_exp (1:ℝ)]
  have hp (u : ℝ) : exp (L*u)=T^u := (Real.rpow_def_of_pos hT₀ u).symm
  have hM₀ : 1 ≤ M := Nat.le_floor (by simpa using Real.one_le_rpow hT₁ hh.le)
  have hMR : (M:ℝ) ≤ T^h := Nat.floor_le (Real.rpow_pos_of_pos hT₀ h).le
  have hX₀ : 0 < X := by dsimp [X,heightScale]; positivity
  have hss : s ⊆ Finset.Icc 2 M := by
    intro k hk
    obtain ⟨hne,hk'⟩ := Finset.mem_erase.mp hk
    obtain ⟨hk₀,hky⟩ := Finset.mem_Ioc.mp hk'
    refine Finset.mem_Icc.mpr ⟨by omega,hky.trans (Nat.floor_mono ?_)⟩
    rw [hp]; exact Real.rpow_le_rpow_of_exponent_le hT₁ (hyl.trans hlh)
  have hq (p : ℕ) (hp' : p ∈ q) : p ≤ M := by
    have h := (Finset.mem_Ioc.mp (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp').1).1).2
    simpa only [hp] using h
  have hkp (k : ℕ) (hk : k ∈ s) (p : ℕ) (hP : p ∈ q) : k ≤ p ∧ ¬k ∣ p := by
    have hk₂ := (Finset.mem_Icc.mp (hss hk)).1
    have hpr := (Finset.mem_filter.mp (Finset.mem_sdiff.mp hP).1).2
    have hlt : k<p := by
      by_contra! hle
      apply (Finset.mem_sdiff.mp hP).2
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_Ioc.mpr ⟨hpr.pos,hle.trans (((Finset.mem_Ioc.mp (Finset.mem_erase.mp hk).2).2).trans
        (Nat.floor_mono (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hyl hL₀.le))))⟩,hpr⟩
    exact ⟨hlt.le,fun hd => ((Nat.dvd_prime hpr).mp hd).elim (by omega) (by omega)⟩
  have ha (k : ℕ) (hk : k ∈ s) : |mollifier F L k| ≤ 1 := by
    rw [mollifier,abs_mul]
    exact mul_le_one₀ (by exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n:=k))
      (abs_nonneg _) (hFb _ (log_mem hL₀ (Finset.mem_erase.mp hk).2))
  have htotal := hN M X σ hM₀ (hMR.trans hMX) hσ s q _ _ hss hq hkp ha (fun p hp => label_bound hL₀ hh hp)
  have hML : 1+Real.log M ≤ 2*L := by
    have := Real.log_le_log (by exact_mod_cast (show 0<M by omega)) (hMR.trans (hMX.trans hXT))
    dsimp [L]; linarith
  have hXL : 1+Real.log X ≤ 2*L := by dsimp [L]; linarith [Real.log_le_log hX₀ hXT]
  have hX₁ : (1:ℝ) ≤ X := (show (1:ℝ) ≤ M by exact_mod_cast hM₀).trans (hMR.trans hMX)
  have hh' : (L:ℝ)^4 ≤ δ*T^(1-h) := by
    simpa only [Real.norm_eq_abs,Real.rpow_ofNat,abs_of_nonneg (show 0 ≤ (Real.log T)^4 by positivity),
      abs_of_pos (Real.rpow_pos_of_pos hT₀ _),L] using hlog
  calc
    ‖remaining F H L y l h σ‖ ≤ C*M*(1+Real.log M)^3*(1+Real.log X) := htotal
    _ ≤ C*(T^h)*(2*L)^3*(2*L) := by gcongr; positivity [Real.log_nonneg hX₁]
    _ = (16*C)*(T^h*L^4) := by ring
    _ ≤ (16*C)*(T^h*(δ*T^(1-h))) := by gcongr
    _ = (16*C*δ)*T := by
      have he := Real.rpow_add hT₀ h (1-h)
      rw [add_sub_cancel,Real.rpow_one] at he
      linear_combination 16*C*δ*he.symm
    _ ≤ ε*T := by
      apply mul_le_mul_of_nonneg_right _ hT₀.le
      dsimp [δ]; rw [← mul_div_assoc,div_le_iff₀ (by positivity)]; nlinarith only [hε.le]

/-- The unit-modulus limiting integral, including the taper and the log label. -/
def unitIntegral (l h : ℝ) := ∫ v in l..h, (v/h)*(1-v/h)*(1-v)

theorem unit_band (hRH : RiemannHypothesis) {H : ℝ → ℝ} (hH : BHB.Arith.Adm H)
    {l h : ℝ} (hl : 0 ≤ l) (hlh : l ≤ h) (hh : 0 < h) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 1 ≤ L → exp (L*h) ≤ heightScale L →
      |unitPacket H L l h-heightScale L*(∫ t in Set.Ioi 0,H t)*L^2*unitIntegral l h| ≤
        C*heightScale L*L := by
  let m := ∫ t in Set.Ioi 0,H t
  let j := PrincipalSmoothing.logMoment H 1
  let Q := fun v : ℝ => (v/h)*(1-v/h)*(1-v)
  have hQ : ContDiff ℝ 1 Q := by unfold Q; fun_prop
  obtain ⟨K,hK,hS⟩ := band_prefix hRH Q hQ hl hlh
  obtain ⟨B,hB,hM⟩ := band_prefix hRH (fun _ => 1) contDiff_const hl hlh
  obtain ⟨D,hD,hZ⟩ := unit_log hH
  let A := 2*D+|j-(Real.log (2*Real.pi)+1)*m|
  let V := B+(h-l)
  have hA : 0 ≤ A := by unfold A; positivity
  have hV : 0 ≤ V := add_nonneg hB (sub_nonneg.mpr hlh)
  refine ⟨A*V+|m| * K,by positivity,?_⟩
  intro L hL hscale
  have hL₀ : 0 < L := by linarith
  let X := heightScale L
  let s := band L l h
  let v := fun p : ℕ => Real.log p/L
  let Z := fun Y : ℝ => ∑' n : ℕ, H (n/Y)*Real.log n
  have hX : 0 < X := by dsimp [X,heightScale]; positivity
  have hmass : (∑ p ∈ s, Real.log p/p) ≤ V*L := by
    have hm := (abs_le.mp (hM L hL₀)).2
    simp only [mul_one,intervalIntegral.integral_const,smul_eq_mul] at hm
    dsimp [V]; nlinarith only [hm,mul_le_mul_of_nonneg_right hL hB]
  have hloc {p : ℕ} (hp : p ∈ s) : |Z (X/p)-(X/p)*m*L*(1-v p)| ≤ A*(X/p) := by
    obtain ⟨hp',hpr⟩ := Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1
    have hp₀ : 0 < (p:ℝ) := by exact_mod_cast hpr.pos
    have hY : 1 ≤ X/p := (one_le_div hp₀).mpr (((Nat.le_floor_iff (exp_pos _).le).mp (Finset.mem_Ioc.mp hp').2).trans hscale)
    have hy₀ := div_pos hX hp₀
    have hlogY : Real.log (X/p)=L*(1-v p)-Real.log (2*Real.pi) := by
      rw [Real.log_div hX.ne' hp₀.ne']; dsimp only [X,heightScale,v]
      rw [Real.log_div (exp_pos _).ne' (by positivity),Real.log_exp]
      field_simp [hL₀.ne']; ring
    have h := hZ (X/p) hY
    change |Z (X/p)-(X/p)*((Real.log (X/p)-1)*m+j)| ≤ _ at h
    have h₂ : |(X/p)*((Real.log (X/p)-1)*m+j)-(X/p)*m*L*(1-v p)| =
        (X/p)*|j-(Real.log (2*Real.pi)+1)*m| := by
      rw [hlogY,show (X/p)*((L*(1-v p)-Real.log (2*Real.pi)-1)*m+j)-(X/p)*m*L*(1-v p)=
        (X/p)*(j-(Real.log (2*Real.pi)+1)*m) by ring,abs_mul,abs_of_pos hy₀]
    apply ((abs_sub_le _ ((X/p)*((Real.log (X/p)-1)*m+j)) _).trans (add_le_add h h₂.le)).trans
    dsimp only [A]; nlinarith only [mul_le_mul_of_nonneg_left (Real.log_le_self hy₀.le) hD,
      mul_le_mul_of_nonneg_left hY hD]
  let U := ∑ p ∈ s, label h L p*Real.log p*((X/p)*m*L*(1-v p))
  have he : |unitPacket H L l h-U| ≤ A*X*(V*L) := by
    unfold unitPacket; dsimp only [U]; rw [← Finset.sum_sub_distrib]
    apply (Finset.abs_sum_le_sum_abs ..).trans
    calc
      _ ≤ ∑ p ∈ s, (A*X)*(Real.log p/p) := by
        apply Finset.sum_le_sum
        intro p hp
        rw [← mul_sub,abs_mul,abs_mul,abs_of_nonneg (Real.log_natCast_nonneg _)]
        have hb := mul_le_mul_of_nonneg_right (label_bound hL₀ hh hp) (Real.log_natCast_nonneg p)
        exact (mul_le_mul hb (hloc hp) (abs_nonneg _) (by positivity)).trans_eq (by ring)
      _ ≤ _ := by rw [← Finset.mul_sum]; exact mul_le_mul_of_nonneg_left hmass (mul_nonneg hA hX.le)
  have hU : U=(X*m*L)*(∑ p ∈ s, Real.log p/p*Q (v p)) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro p _
    dsimp only [Q,label,v]; ring
  have hf : |U-X*m*L^2*unitIntegral l h| ≤ X*|m| * L*K := by
    rw [hU,show (X*m*L)*(∑ p ∈ s, Real.log p/p*Q (v p))-X*m*L^2*unitIntegral l h =
      (X*m*L)*((∑ p ∈ s, Real.log p/p*Q (v p))-L*unitIntegral l h) by ring,abs_mul,
      abs_mul (X*m) L,abs_mul X m,abs_of_pos hX,abs_of_pos hL₀]
    exact mul_le_mul_of_nonneg_left (hS L hL₀) (by positivity)
  exact ((abs_sub_le _ U _).trans (add_le_add he hf)).trans_eq (by ring)

/-- Both signs of the full physical log packet, after combining the unit term
with the power-saving aggregate at every nonunit modulus. -/
theorem log_packet_asymptotic (hRH : RiemannHypothesis) (F : ℝ → ℝ) {H : ℝ → ℝ}
    (hH : BHB.Arith.Adm H) {y l h : ℝ} (hy : 0 ≤ y) (hyl : y ≤ l) (hlh : l ≤ h)
    (hh : 0 < h) (hh₁ : h < 1) (hFb : ∀ v ∈ Set.Icc 0 y, |F v| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop, ∀ σ : ℝ, (σ=1 ∨ σ= -1) →
      ‖logPacket F H (Real.log T) y l h σ-
        ((F 0*(T/(2*Real.pi))*(∫ t in Set.Ioi 0,H t)*(Real.log T)^2*unitIntegral l h : ℝ):ℂ)‖ ≤ C*T*Real.log T := by
  obtain ⟨K,hK,hU⟩ := unit_band hRH hH (hy.trans hyl) hlh hh
  refine ⟨K+1,by positivity,?_⟩
  filter_upwards [scales hh₁,remaining_negligible F hH hy hyl hlh hh hh₁ hFb 1 zero_lt_one] with T hsc hN
  intro σ hσ
  obtain ⟨hL,hMX,hXT,hT₀⟩ := hsc
  let L := Real.log T
  let X := heightScale L
  have hL₀ : 0 ≤ L := by dsimp [L]; linarith
  have hX : X=T/(2*Real.pi) := by dsimp [X,heightScale,L]; rw [Real.exp_log hT₀]
  have hX₀ : 0 ≤ X := by rw [hX]; positivity
  have he := hU L hL (by simpa only [L,Real.rpow_def_of_pos hT₀] using hMX)
  let V := X*(∫ t in Set.Ioi 0,H t)*L^2*unitIntegral l h
  have hz : |F 0| ≤ 1 := hFb 0 ⟨le_rfl,hy⟩
  have hid : logPacket F H L y l h σ-((F 0*(T/(2*Real.pi))*(∫ t in Set.Ioi 0,H t)*L^2*unitIntegral l h:ℝ):ℂ) =
      ((F 0*(unitPacket H L l h-V):ℝ):ℂ)-remaining F H L y l h σ := by
    rw [split F H hL₀ hy l h σ hσ,← hX]; dsimp only [V]; push_cast; ring
  change ‖logPacket F H L y l h σ-_‖ ≤ (K+1)*T*L
  rw [hid]
  apply (norm_sub_le ..).trans
  rw [Complex.norm_real,Real.norm_eq_abs,abs_mul]
  have hb : |F 0| * |unitPacket H L l h-V| ≤ K*T*L :=
    (mul_le_mul hz he (abs_nonneg _) zero_le_one).trans (by rw [one_mul]; gcongr)
  have hn := hN σ hσ
  rw [one_mul] at hn
  nlinarith only [hb,hn,mul_le_mul_of_nonneg_left hL hT₀.le]

end ReflectedLogBand
end
end Src_ReflectedLogBand

section Src_ReflectedGamma



noncomputable section
open MeasureTheory BHB BHB.Red PrincipalBand ReflectedPrincipal ReflectedLogBand
open scoped BigOperators Real

namespace ReflectedGamma

private theorem expansion (w : Weight) {T : ℝ} (hT : 1 < T) (x : ℝ) :
    Gam w T x=(Real.log (T/(2*Real.pi)) : ℂ)*((T:ℂ)*w.k (T*Real.log x))+
      (T:ℂ)*TMA.Kernel.komega w.toHeightWeight T (-(T*Real.log x))+
      TMA.Kernel.Rterm w.toHeightWeight T (-(T*Real.log x)) := by
  have hT₀ : 0 < T := by linarith
  have hA : TMA.Asc T (-(Real.log x)/Real.log T)*1= -(T*Real.log x) := by
    unfold TMA.Asc; field_simp [(Real.log_pos hT).ne']
  rw [← gamma_Fpk w hT₀ x,Fpk_eq_Fx w hT x,TMA.Kernel.gamma_split w.toHeightWeight hT₀,hA]
  unfold TMA.packet; rw [sub_zero,hA,neg_neg]

theorem gamma_error (w : Weight) : ∃ C : ℝ, 0 ≤ C ∧ ∀ T : ℝ, 2 ≤ T → ∀ x : ℝ,
    ‖Gam w T x-(Real.log (T/(2*Real.pi)) : ℂ)*((T:ℂ)*w.k (T*Real.log x))‖ ≤
      C*(T/(1+(T*Real.log x)^2)+1/T) := by
  obtain ⟨G,hG⟩ := w.gammaBound
  obtain ⟨R,hR,hR'⟩ := TMA.Kernel.norm_Rterm_le w.toHeightWeight
  refine ⟨|G|+R,by positivity,?_⟩
  intro T hT x
  have hT₀ : 0 < T := by linarith
  let v := -(T*Real.log x)
  rw [expansion w (by linarith)]
  have h : ∀ a b c : ℂ, a+b+c-a=b+c := by intros; ring
  rw [h]
  apply (norm_add_le ..).trans
  rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hT₀]
  have hg := hG T hT v
  dsimp only [v] at hg
  rw [neg_sq] at hg
  have hu : 0 ≤ 1/(1+(T*Real.log x)^2) := by positivity
  have h₁ := mul_le_mul_of_nonneg_left (hg.trans ((div_le_div_of_nonneg_right (le_abs_self G) (by positivity)))) hT₀.le
  have h₂ := hR' T (by linarith) v
  apply (add_le_add h₁ h₂).trans
  let U := T/(1+(T*Real.log x)^2)
  have hU : 0 ≤ U := by dsimp [U]; positivity
  calc
    _ = |G| * U + R*(1/T) := by dsimp [U]; ring
    _ ≤ (|G|+R)*U+(|G|+R)*(1/T) := add_le_add
      (mul_le_mul_of_nonneg_right (by linarith) hU)
      (mul_le_mul_of_nonneg_right (by linarith [abs_nonneg G]) (by positivity))
    _ = _ := by dsimp [U]; ring

theorem gamma_one (w : Weight) : ∃ C : ℝ, 0 ≤ C ∧ ∀ T : ℝ, 2 ≤ T →
    ‖Gam w T 1-((T/(2*Real.pi)*w.kap1*Real.log T:ℝ):ℂ)‖ ≤ C*T := by
  obtain ⟨D,hD,h⟩ := gamma_error w
  let V := w.kap1*Real.log (2*Real.pi)/(2*Real.pi)
  refine ⟨2*D+|V|,by positivity,?_⟩
  intro T hT
  have hT₀ : 0 < T := by linarith
  have hp : 0 < 2*Real.pi := by positivity
  have hz := h T hT 1
  simp only [Real.log_one,mul_zero,zero_pow (by decide : 2 ≠ 0),add_zero,div_one] at hz
  rw [TMA.T12.k_zero w.toHeightWeight] at hz
  let B : ℂ := (Real.log (T/(2*Real.pi)):ℂ)*(T*(↑(w.kap1/(2*Real.pi):ℝ):ℂ))
  have hid : B-((T/(2*Real.pi)*w.kap1*Real.log T:ℝ):ℂ)=((-T*V:ℝ):ℂ) := by
    dsimp [B,V]; rw [Real.log_div hT₀.ne' hp.ne']; push_cast; ring
  apply ((norm_sub_le_norm_sub_add_norm_sub _ B _).trans (add_le_add hz (le_of_eq (congrArg norm hid)))).trans
  rw [Complex.norm_real,Real.norm_eq_abs,abs_mul,abs_neg,abs_of_pos hT₀]
  have hh : 1/T ≤ T := (div_le_iff₀ hT₀).mpr (by nlinarith only [hT,sq_nonneg (T-1)])
  nlinarith only [mul_le_mul_of_nonneg_left hh hD]

private theorem log_far {d p : ℝ} (hd : 0 < d) (hp : 0 < p) (hf : ¬(p ≤ 2*d ∧ d ≤ 2*p)) :
    Real.log 2 ≤ |Real.log (d/p)| := by
  rcases le_or_gt p (2*d) with h|h
  · have hdp : 2*p < d := lt_of_not_ge (fun h' => hf ⟨h,h'⟩)
    exact (Real.log_le_log (by norm_num) ((le_div_iff₀ hp).mpr hdp.le)).trans (le_abs_self _)
  · have hr := Real.log_le_log (by norm_num : (0:ℝ)<2) ((le_div_iff₀ hd).mpr h.le)
    rw [Real.log_div hp.ne' hd.ne'] at hr
    rw [Real.log_div hd.ne' hp.ne']
    linarith only [hr,neg_abs_le (Real.log d-Real.log p)]

/-- After removing the compactly supported gamma packet, only the terms with
mk ≤ 2M need the integer-spacing estimate. -/
theorem off_diagonal (w : Weight) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T M : ℝ), 2 ≤ T → w.kappa*(M+1)<T →
      ∀ d p : ℕ, 0 < d → 0 < p → (p:ℝ) ≤ M → d ≠ p →
      ‖Gam w T ((d:ℝ)/p)‖/Real.sqrt ((d:ℝ)*p) ≤
        C*(1/(T*Real.sqrt ((d:ℝ)*p))+(if (d:ℝ) ≤ 2*M then (d:ℝ)/(T*((p:ℝ)-d)^2) else 0)) := by
  obtain ⟨D,hD,hE⟩ := gamma_error w
  let A := 1/(Real.log 2)^2
  have hA : 0 ≤ A := by unfold A; positivity
  refine ⟨D*(9+A),by positivity,?_⟩
  intro T M hT hκ d p hd hp hpM hne
  have hT₀ : 0 < T := by linarith
  have hd₀ : 0 < (d:ℝ) := by exact_mod_cast hd
  have hp₀ : 0 < (p:ℝ) := by exact_mod_cast hp
  have hn : (p:ℝ) ≠ d := by exact_mod_cast hne.symm
  let S := Real.sqrt ((d:ℝ)*p)
  let u := Real.log ((d:ℝ)/p)
  have hS : 0 < S := Real.sqrt_pos.mpr (mul_pos hd₀ hp₀)
  have hgap := FejerPrimeMoments.integer_gap hp hd hne.symm
  rw [abs_sub_comm,← Real.log_div hd₀.ne' hp₀.ne'] at hgap
  have hsup : w.kappa < |T*u| := by
    rw [abs_mul,abs_of_pos hT₀]
    have hκ₀ := w.kappa_pos.le
    have hk : w.kappa < T/((p:ℝ)+1) := (lt_div_iff₀ (by positivity)).mpr
      ((mul_le_mul_of_nonneg_left (by linarith : (p:ℝ)+1 ≤ M+1) hκ₀).trans_lt hκ)
    exact hk.trans_le (by simpa only [mul_one_div,u] using mul_le_mul_of_nonneg_left hgap hT₀.le)
  have he := hE T hT ((d:ℝ)/p)
  rw [TMA.Kernel.k_eq_zero_of_lt w.toHeightWeight hsup,mul_zero,mul_zero,sub_zero] at he
  have base : ‖Gam w T ((d:ℝ)/p)‖/S ≤ D*(T/(S*(1+(T*u)^2))+1/(T*S)) :=
    (div_le_div_of_nonneg_right he hS.le).trans_eq (by dsimp [u]; simp only [div_eq_mul_inv,mul_inv_rev]; ring)
  let R := if (d:ℝ) ≤ 2*M then (d:ℝ)/(T*((p:ℝ)-d)^2) else 0
  have hR : 0 ≤ R := by dsimp [R]; split <;> positivity
  have hB : 0 ≤ 1/(T*S) := by positivity
  have main : T/(S*(1+(T*u)^2)) ≤ 8*R+A*(1/(T*S)) := by
    by_cases hn' : (p:ℝ) ≤ 2*d ∧ (d:ℝ) ≤ 2*p
    · have hnear := ReflectedPackets.gamma_near hd₀ hp₀ hT₀ hn'.1 hn'.2 hn
      dsimp only [R,u]; rw [if_pos (by linarith [hn'.2] : (d:ℝ) ≤ 2*M),Real.log_div hd₀.ne' hp₀.ne']
      apply hnear.trans
      nlinarith only [mul_nonneg hA hB,show 8*(d:ℝ)/(T*((p:ℝ)-d)^2)=8*((d:ℝ)/(T*((p:ℝ)-d)^2)) by ring]
    · have hl : 0 < Real.log 2 := Real.log_pos (by norm_num)
      have hf := log_far hd₀ hp₀ hn'
      have hs := pow_le_pow_left₀ hl.le hf 2
      rw [sq_abs] at hs
      have hden : S*(T*Real.log 2)^2 ≤ S*(1+(T*u)^2) := by
        apply mul_le_mul_of_nonneg_left _ hS.le
        dsimp only [u]; nlinarith only [mul_le_mul_of_nonneg_left hs (sq_nonneg T)]
      have hpos : 0 < S*(T*Real.log 2)^2 := by positivity
      have hdv := div_le_div_of_nonneg_left hT₀.le hpos hden
      have heq : T/(S*(T*Real.log 2)^2)=A*(1/(T*S)) := by dsimp only [A]; field_simp
      exact hdv.trans (heq.le.trans (by linarith))
  change ‖Gam w T ((d:ℝ)/p)‖/S ≤ D*(9+A)*(1/(T*S)+R)
  apply base.trans
  rw [mul_assoc D (9+A)]
  apply mul_le_mul_of_nonneg_left _ hD
  nlinarith only [main,mul_nonneg hA hR,hR,hB]

private def root (d p : ℕ) := Real.sqrt ((d:ℝ)*p)

private theorem flat_sum (K N M : ℕ) (q : Finset ℕ) (hq : q ⊆ Finset.Icc 1 M)
    (T : ℝ) (hT : 0 < T) :
    (∑ k ∈ Finset.Icc 1 K, ∑ m ∈ Finset.Icc 1 N, ∑ p ∈ q, 1/(T*root (m*k) p)) ≤
      8*Real.sqrt K*Real.sqrt N*Real.sqrt M/T := by
  have hf (k m p : ℕ) : 1/(T*root (m*k) p) =
      (1/T)*(1/Real.sqrt k)*((1/Real.sqrt m)*(1/Real.sqrt p)) := by
    simp only [root,Nat.cast_mul,Real.sqrt_mul (Nat.cast_nonneg (α:=ℝ) m),
      Real.sqrt_mul (mul_nonneg (Nat.cast_nonneg (α:=ℝ) m) (Nat.cast_nonneg k)),div_eq_mul_inv,mul_inv_rev]; ring
  have hq' : (∑ p ∈ q, 1/Real.sqrt p) ≤ 2*Real.sqrt M := (Finset.sum_le_sum_of_subset_of_nonneg hq
    (fun p _ _ => by positivity)).trans (BHB.Red.sum_Icc_inv_sqrt_le M)
  simp_rw [hf,← Finset.mul_sum,← Finset.sum_mul]
  have hR := mul_le_mul (mul_le_mul_of_nonneg_left (BHB.Red.sum_Icc_inv_sqrt_le K) (one_div_nonneg.mpr hT.le))
    (mul_le_mul (BHB.Red.sum_Icc_inv_sqrt_le N) hq' (by positivity) (by positivity)) (by positivity) (by positivity)
  rw [← Finset.mul_sum]
  exact hR.trans_eq (by ring)

private def nearCost (M : ℕ) (T : ℝ) (d p : ℕ) :=
  if (d:ℝ) ≤ 2*M then (d:ℝ)/(T*((p:ℝ)-d)^2) else 0

private theorem near_sum (K N M : ℕ) (q : Finset ℕ) (T : ℝ) (hT : 0 < T) :
    (∑ k ∈ Finset.Icc 1 K, ∑ m ∈ Finset.Icc 1 N, ∑ p ∈ q, nearCost M T (m*k) p) ≤
      18*(2*(M:ℝ))^2/T*(1+Real.log K) := by
  apply le_trans ?_ (ReflectedPackets.gamma_spacing_sum q K (M:=2*(M:ℝ)) (by positivity) hT)
  apply Finset.sum_le_sum
  intro k hk
  have hk₀ : 0 < (k:ℝ) := by exact_mod_cast (Finset.mem_Icc.mp hk).1
  let s := (Finset.Icc 1 N).filter (fun m : ℕ => ((m*k:ℕ):ℝ) ≤ 2*M)
  let f := fun m : ℕ => ((m*k:ℕ):ℝ)/T * ∑ p ∈ q, 1/((p:ℝ)-(m*k:ℕ))^2
  have hsub : s ⊆ Finset.Ioc 0 ⌊2*(M:ℝ)/k⌋₊ := by
    intro m hm
    obtain ⟨hm',h⟩ := Finset.mem_filter.mp hm
    exact Finset.mem_Ioc.mpr ⟨(Finset.mem_Icc.mp hm').1,Nat.le_floor ((le_div_iff₀ hk₀).mpr (by simpa only [Nat.cast_mul] using h))⟩
  calc
    _ = ∑ m ∈ s, f m := by
      dsimp only [s]; rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro m _
      by_cases h : ((m*k:ℕ):ℝ) ≤ 2*M
      · simp only [nearCost,h,if_true,f,Finset.mul_sum]
        apply Finset.sum_congr rfl; intros; simp only [div_eq_mul_inv,mul_inv_rev]; ring
      · simp only [nearCost,h,if_false,Finset.sum_const_zero]
    _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg hsub (fun m _ _ => by dsimp only [f]; positivity)

def offSum (w : Weight) (T : ℝ) (K N : ℕ) (q : Finset ℕ) (a : ℕ → ℕ → ℕ → ℝ) :=
  ∑ k ∈ Finset.Icc 1 K, ∑ m ∈ Finset.Icc 1 N, ∑ p ∈ q,
    if m*k=p then (0:ℂ) else (a k m p/root (m*k) p) • Gam w T (((m*k:ℕ):ℝ)/p)

/-- Summed bound with both the residual gamma transform and the near-resonant
denominators, for arbitrary bounded coefficient arrays. -/
theorem off_sum (w : Weight) : ∃ C : ℝ, 0 ≤ C ∧ ∀ (T B : ℝ) (K N M : ℕ) (q : Finset ℕ)
    (a : ℕ → ℕ → ℕ → ℝ), 2 ≤ T → 0 ≤ B → w.kappa*(M+1)<T → q ⊆ Finset.Icc 1 M →
    (∀ k ∈ Finset.Icc 1 K, ∀ m ∈ Finset.Icc 1 N, ∀ p ∈ q, |a k m p| ≤ B) →
    ‖offSum w T K N q a‖ ≤ B*C*(8*Real.sqrt K*Real.sqrt N*Real.sqrt M/T+
      18*(2*(M:ℝ))^2/T*(1+Real.log K)) := by
  obtain ⟨C,hC,h⟩ := off_diagonal w
  refine ⟨C,hC,?_⟩
  intro T B K N M q a hT hB hκ hq ha
  have hT₀ : 0 < T := by linarith
  let r := fun k m p : ℕ => 1/(T*root (m*k) p)
  let u := fun k m p : ℕ => nearCost M T (m*k) p
  have hb {k m p : ℕ} (hk : k ∈ Finset.Icc 1 K) (hm : m ∈ Finset.Icc 1 N) (hp : p ∈ q) :
      ‖if m*k=p then (0:ℂ) else (a k m p/root (m*k) p) • Gam w T (((m*k:ℕ):ℝ)/p)‖ ≤
        (B*C)*(r k m p+u k m p) := by
    have hk₀ := (Finset.mem_Icc.mp hk).1
    have hm₀ := (Finset.mem_Icc.mp hm).1
    have hp' := Finset.mem_Icc.mp (hq hp)
    have hr : 0 ≤ root (m*k) p := Real.sqrt_nonneg _
    by_cases he : m*k=p
    · rw [if_pos he,norm_zero]
      have hnu : 0 ≤ u k m p := by dsimp only [u,nearCost]; split <;> positivity
      dsimp only [r]; positivity
    rw [if_neg he,norm_smul,Real.norm_eq_abs,abs_div,abs_of_nonneg hr]
    have ht := h T M hT hκ (m*k) p (Nat.mul_pos hm₀ hk₀) hp'.1 (Nat.cast_le.mpr hp'.2) he
    have hdiv := div_nonneg (norm_nonneg (Gam w T (((m*k:ℕ):ℝ)/p))) hr
    calc
      _ = |a k m p| * (‖Gam w T (((m*k:ℕ):ℝ)/p)‖/root (m*k) p) := by ring
      _ ≤ B*(C*(r k m p+u k m p)) := mul_le_mul (ha k hk m hm p hp) ht hdiv hB
      _ = _ := by ring
  apply (norm_sum_le ..).trans
  calc
    _ ≤ ∑ k ∈ Finset.Icc 1 K, ∑ m ∈ Finset.Icc 1 N, ∑ p ∈ q, (B*C)*(r k m p+u k m p) := by
      apply Finset.sum_le_sum
      intro k hk
      apply (norm_sum_le ..).trans
      apply Finset.sum_le_sum
      intro m hm
      exact (norm_sum_le ..).trans (Finset.sum_le_sum (fun p hp => hb hk hm hp))
    _ ≤ _ := by
      simp_rw [← Finset.mul_sum,Finset.sum_add_distrib]
      exact mul_le_mul_of_nonneg_left (add_le_add (flat_sum K N M q hq T hT₀) (near_sum K N M q T hT₀)) (mul_nonneg hB hC)

def coefficient (F : ℝ → ℝ) (T h : ℝ) (k m p : ℕ) :=
  mollifier F (Real.log T) k*dco (Xtr T) m*label h (Real.log T) p

def gammaPacket (w : Weight) (F : ℝ → ℝ) (T y l h : ℝ) :=
  ∑ k ∈ Krange y T, ∑ m ∈ Mrange (Xtr T), ∑ p ∈ band (Real.log T) l h,
    (coefficient F T h k m p/root (m*k) p) • Gam w T (((m*k:ℕ):ℝ)/p)

def gammaOff (w : Weight) (F : ℝ → ℝ) (T y l h : ℝ) :=
  offSum w T ⌊T^y⌋₊ ⌊2*Xtr T⌋₊ (band (Real.log T) l h) (coefficient F T h)

def primeMass (L l h : ℝ) := ∑ p ∈ band L l h, Real.log p/p*label h L p

theorem split_gamma (w : Weight) (F : ℝ → ℝ) {T y l h : ℝ} (hT : 1 < T)
    (hy : 0 ≤ y) (hyl : y ≤ l) (hh₁ : h ≤ 1) : gammaPacket w F T y l h =
      (F 0*primeMass (Real.log T) l h) • Gam w T 1+gammaOff w F T y l h := by
  classical
  let L := Real.log T
  let s := Krange y T
  let r := Mrange (Xtr T)
  let q := band L l h
  let v := fun p : ℕ => (F 0*(Real.log p/p*label h L p)) • Gam w T 1
  have hT₀ := zero_lt_one.trans hT
  have hL₀ := Real.log_pos hT
  have hpw (b : ℝ) : Real.exp (L*b)=T^b := (Real.rpow_def_of_pos hT₀ _).symm
  have hmem (p : ℕ) (hp : p ∈ q) : (p:ℝ) ≤ Xtr T := by
    have h := (Nat.le_floor_iff (Real.exp_pos _).le).mp (Finset.mem_Ioc.mp
      (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).1).2
    rw [hpw] at h
    exact h.trans ((Real.rpow_le_rpow_of_exponent_le hT.le hh₁).trans (by rw [Real.rpow_one]; exact le_Xtr hT.le))
  have hrp (p : ℕ) (hp : p ∈ q) : p ∈ r := by
    have hpr := (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).2
    exact Finset.mem_Icc.mpr ⟨hpr.pos,Nat.le_floor (by linarith [hmem p hp,one_le_Xtr hT.le])⟩
  have hs₁ : 1 ∈ s := Finset.mem_Icc.mpr ⟨le_rfl,Nat.le_floor (by simpa [ymol] using Real.one_le_rpow hT.le hy)⟩
  let U := fun k m p : ℕ => (coefficient F T h k m p/root (m*k) p) • Gam w T (((m*k:ℕ):ℝ)/p)
  have hspl (k : ℕ) (hk : k ∈ s) (m : ℕ) (p : ℕ) (hp : p ∈ q) :
      U k m p=(if k=1 then (if m=p then v p else 0) else 0)+(if m*k=p then 0 else U k m p) := by
    by_cases he : m*k=p
    · have hpr := (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).2
      have hkp : k<p := by
        by_contra! hn
        apply (Finset.mem_sdiff.mp hp).2
        apply Finset.mem_filter.mpr
        refine ⟨Finset.mem_Ioc.mpr ⟨hpr.pos,hn.trans ((Finset.mem_Icc.mp hk).2.trans (Nat.floor_mono ?_))⟩,hpr⟩
        rw [hpw]; exact Real.rpow_le_rpow_of_exponent_le hT.le hyl
      have hkd : k ∣ p := he ▸ dvd_mul_left k m
      have hk₁ : k=1 := ((Nat.dvd_prime hpr).mp hkd).resolve_right hkp.ne
      subst k
      simp only [mul_one] at he
      subst m
      have hp₀ : 0 < (p:ℝ) := by exact_mod_cast hpr.pos
      have hX₀ : 0 < Xtr T := (by linarith [one_le_Xtr hT.le])
      have hd : dco (Xtr T) p=Real.log p := by
        have hv : |(p:ℝ)/Xtr T| ≤ 1 := by
          rw [abs_of_nonneg (div_nonneg hp₀.le hX₀.le)]
          exact (div_le_one hX₀).mpr (hmem p hp)
        rw [dco,vcut_of_abs_le_one hv,mul_one]
      simp only [U,v,coefficient,hd,mul_one,ite_true,add_zero,root,Real.sqrt_mul_self (Nat.cast_nonneg _),
        div_self hp₀.ne',mollifier,Nat.cast_one,Real.log_one,zero_div]
      congr 1
      simp [L]
      ring
    · rw [if_neg he]
      by_cases hk₁ : k=1
      · subst k; have hn : m≠p := by simpa using he
        simp [hn]
      · simp [hk₁]
  change (∑ k ∈ s, ∑ m ∈ r, ∑ p ∈ q, U k m p)=_+_
  calc
    _ = (∑ k ∈ s, ∑ m ∈ r, ∑ p ∈ q, if k=1 then (if m=p then v p else 0) else 0)+gammaOff w F T y l h := by
      change _=(∑ k ∈ s, ∑ m ∈ r, ∑ p ∈ q, if k=1 then (if m=p then v p else 0) else 0)+
        ∑ k ∈ s, ∑ m ∈ r, ∑ p ∈ q, if m*k=p then 0 else U k m p
      simp only [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun k hk => Finset.sum_congr rfl fun m _ => Finset.sum_congr rfl fun p hp => hspl k hk m p hp
    _ = _ := by
      congr 1
      simp_rw [Finset.sum_ite_irrel,Finset.sum_const_zero]
      rw [Finset.sum_ite_eq',if_pos hs₁,Finset.sum_comm]
      simp only [Finset.sum_ite_eq']
      have hrow (p : ℕ) (hp : p ∈ q) : (if p ∈ r then v p else 0)=v p := if_pos (hrp p hp)
      rw [Finset.sum_congr rfl hrow]
      dsimp only [primeMass,v]; rw [Finset.mul_sum,Finset.sum_smul]

lemma coefficient_bound (F : ℝ → ℝ) {T y l h : ℝ} (hFb : ∀ u ∈ Set.Icc 0 y, |F u| ≤ 1)
    (hL : 1 ≤ Real.log T) (hT₀ : 0 < T) (hh : 0 < h) :
    ∀ k ∈ Krange y T, ∀ m ∈ Mrange (Xtr T), ∀ p ∈ band (Real.log T) l h,
      |coefficient F T h k m p| ≤ 3*Real.log T := by
  let L := Real.log T
  have hL₀ : 0 < L := by dsimp only [L]; linarith
  have hT₁ := (Real.log_nonneg_iff hT₀).mp hL₀.le
  have he (a : ℝ) : Real.exp (L*a)=T^a := (Real.rpow_def_of_pos hT₀ a).symm
  have hx₀ := one_le_Xtr hT₁
  have hx : Real.log (2*Xtr T) ≤ 3*L := by
    rw [Xtr,Real.log_mul (by norm_num) (Real.rpow_pos_of_pos hT₀ _).ne',Real.log_rpow hT₀]
    dsimp [L]; linarith [Real.log_le_sub_one_of_pos (by norm_num : (0:ℝ)<2)]
  intro k hk m hm p hp
  have hkm : k ∈ below (Real.exp (L*y)) := Finset.mem_Ioc.mpr ⟨(Finset.mem_Icc.mp hk).1,by rw [he]; exact (Finset.mem_Icc.mp hk).2⟩
  have hb : |mollifier F L k| ≤ 1 := by
    rw [mollifier,abs_mul]
    exact mul_le_one₀ (by exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n:=k))
      (abs_nonneg _) (hFb _ (ReflectedLogBand.log_mem hL₀ hkm))
  have hd := (dco_le_log_two_mul (by linarith : 0 ≤ Xtr T) hm).trans hx
  rw [coefficient,abs_mul,abs_mul,abs_of_nonneg (dco_nonneg _ _)]
  exact (mul_le_mul (mul_le_mul hb hd (dco_nonneg _ _) zero_le_one)
    (label_bound hL₀ hh hp) (abs_nonneg _) (by positivity)).trans_eq (by ring)

theorem gamma_off_physical (w : Weight) (F : ℝ → ℝ) {y l h : ℝ} (hyl : y ≤ l) (hlh : l ≤ h)
    (hh : 0 < h) (hh₁ : h < 1) (hFb : ∀ u ∈ Set.Icc 0 y, |F u| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop, ‖gammaOff w F T y l h‖ ≤ C*T*Real.log T := by
  obtain ⟨D,hD,hE⟩ := off_sum w
  refine ⟨3*D*(16+144),by positivity,?_⟩
  have hpow := (tendsto_rpow_atTop (sub_pos.mpr hh₁)).eventually_gt_atTop (2*w.kappa)
  have hslow := (isLittleO_log_rpow_atTop (sub_pos.mpr hh₁)).bound zero_lt_one
  filter_upwards [scales hh₁,hpow,hslow] with T hsc hgap hslow
  obtain ⟨hL,hMX,hXT,hT₀⟩ := hsc
  let L := Real.log T
  let K := ⌊T^y⌋₊
  let N := ⌊2*Xtr T⌋₊
  let M := ⌊T^h⌋₊
  let q := band L l h
  have hT : 2 ≤ T := by have := (Real.le_log_iff_exp_le hT₀).mp hL; linarith [Real.add_one_le_exp (1:ℝ)]
  have hT₁ : 1 ≤ T := by linarith
  have hL₀ : 0 < L := by dsimp [L]; linarith
  have he (a : ℝ) : Real.exp (L*a)=T^a := (Real.rpow_def_of_pos hT₀ a).symm
  have ht : 1 ≤ T^h := Real.one_le_rpow hT₁ hh.le
  have hMt : (M:ℝ) ≤ T^h := Nat.floor_le (Real.rpow_pos_of_pos hT₀ _).le
  have hMT := hMt.trans (hMX.trans hXT)
  have hKT : (K:ℝ) ≤ T := (Nat.floor_le (Real.rpow_pos_of_pos hT₀ _).le).trans
    ((Real.rpow_le_rpow_of_exponent_le hT₁ ((hyl.trans hlh).trans hh₁.le)).trans_eq (Real.rpow_one T))
  have hmul : T^h*T^(1-h)=T := by rw [← Real.rpow_add hT₀,add_sub_cancel,Real.rpow_one]
  have hg : w.kappa*(M+1)<T := by
    apply lt_of_le_of_lt (show w.kappa*(M+1) ≤ (T^h)*(2*w.kappa) by
      nlinarith only [mul_le_mul_of_nonneg_left hMt w.kappa_pos.le,mul_le_mul_of_nonneg_left ht w.kappa_pos.le])
    exact (mul_lt_mul_of_pos_left hgap (Real.rpow_pos_of_pos hT₀ _)).trans_eq hmul
  have hpq : q ⊆ Finset.Icc 1 M := by
    intro p hp
    obtain ⟨hmp,hpr⟩ := Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1
    exact Finset.mem_Icc.mpr ⟨hpr.pos,by simpa only [he,M] using (Finset.mem_Ioc.mp hmp).2⟩
  have ha := coefficient_bound F hFb hL hT₀ hh (l:=l)
  have hsum := hE T (3*L) K N M q (coefficient F T h) hT (by positivity) hg hpq ha
  have hN : (N:ℝ) ≤ 4*T^2 := by
    apply (Nat.floor_le (mul_nonneg (by norm_num) (Xtr_pos hT₀).le)).trans
    have hX : Xtr T ≤ T^2 := by rw [Xtr,← Real.rpow_two]; exact Real.rpow_le_rpow_of_exponent_le hT₁ (by norm_num)
    nlinarith only [hX,sq_nonneg T]
  have hNs : Real.sqrt N ≤ 2*T := by
    apply (Real.sqrt_le_iff).mpr; exact ⟨by positivity,by nlinarith only [hN]⟩
  have hroot : Real.sqrt K*Real.sqrt M ≤ T := (mul_le_mul (Real.sqrt_le_sqrt hKT) (Real.sqrt_le_sqrt hMT)
    (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)).trans_eq (Real.mul_self_sqrt hT₀.le)
  have hf : 8*Real.sqrt K*Real.sqrt N*Real.sqrt M/T ≤ 16*T := by
    rw [div_le_iff₀ hT₀]
    have hz := mul_le_mul hroot hNs (Real.sqrt_nonneg _) hT₀.le
    nlinarith only [hz]
  have hKlog : Real.log K ≤ L := by
    by_cases hk : K=0
    · rw [hk,Nat.cast_zero,Real.log_zero]; exact hL₀.le
    · exact Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero hk) hKT
  have hLt : L ≤ T^(1-h) := by
    simpa only [Real.norm_eq_abs,abs_of_nonneg hL₀.le,abs_of_pos (Real.rpow_pos_of_pos hT₀ _),one_mul,L] using hslow
  have hn : 18*(2*(M:ℝ))^2/T*(1+Real.log K) ≤ 144*T := by
    have hM2 : (M:ℝ)^2/T ≤ M := (div_le_iff₀ hT₀).mpr (by nlinarith only [mul_le_mul_of_nonneg_left hMT (Nat.cast_nonneg (α:=ℝ) M)])
    have hML : (M:ℝ)*L ≤ T := (mul_le_mul hMt hLt hL₀.le (Real.rpow_pos_of_pos hT₀ _).le).trans_eq hmul
    calc
      _ = 72*((M:ℝ)^2/T)*(1+Real.log K) := by ring
      _ ≤ 72*M*(2*L) := mul_le_mul (mul_le_mul_of_nonneg_left hM2 (by norm_num))
        (by dsimp [L] at *; linarith) (by positivity [Real.log_natCast_nonneg K]) (by positivity)
      _ ≤ _ := by nlinarith only [hML]
  exact hsum.trans ((mul_le_mul_of_nonneg_left (add_le_add hf hn) (by positivity : 0 ≤ 3*L*D)).trans_eq (by ring))

def gammaIntegral (l h : ℝ) := ∫ v in l..h, (v/h)*(1-v/h)

theorem gamma_packet_asymptotic (hRH : RiemannHypothesis) (w : Weight) (F : ℝ → ℝ)
    {y l h : ℝ} (hy : 0 ≤ y) (hyl : y ≤ l) (hlh : l ≤ h) (hh : 0 < h) (hh₁ : h < 1)
    (hFb : ∀ u ∈ Set.Icc 0 y, |F u| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop, ‖gammaPacket w F T y l h-
      ((F 0*(T/(2*Real.pi))*w.kap1*(Real.log T)^2*gammaIntegral l h:ℝ):ℂ)‖ ≤ C*T*Real.log T := by
  let J := gammaIntegral l h
  obtain ⟨A,hA,hdiag⟩ := gamma_one w
  obtain ⟨B,hB,hpref⟩ := band_prefix hRH (fun v : ℝ => (v/h)*(1-v/h)) (by fun_prop) (hy.trans hyl) hlh
  obtain ⟨D,hD,hoff⟩ := gamma_off_physical w F hyl hlh hh hh₁ hFb
  refine ⟨(B+|J|)*A+B*|w.kap1|+D,by positivity,?_⟩
  filter_upwards [scales hh₁,hoff,Filter.eventually_ge_atTop (2:ℝ)] with T hsc he hT
  obtain ⟨hL,_,hXT,hT₀⟩ := hsc
  let L := Real.log T
  let S := primeMass L l h
  let X := T/(2*Real.pi)
  let V := X*w.kap1*L
  have hL₀ : 0 < L := by dsimp [L]; linarith
  have hX₀ : 0 ≤ X := by dsimp [X]; positivity
  have hX : X ≤ T := by simpa [X,heightScale,Real.exp_log hT₀] using hXT
  have hz := hFb 0 ⟨le_rfl,hy⟩
  have hS : |S-L*J| ≤ B := hpref L hL₀
  have hS' : |S| ≤ (B+|J|)*L := by
    calc
      |S| = |S-L*J+L*J| := by ring_nf
      _ ≤ B+L*|J| := (abs_add_le ..).trans (add_le_add hS (by rw [abs_mul,abs_of_pos hL₀]))
      _ ≤ _ := by dsimp only [L] at *; nlinarith only [mul_le_mul_of_nonneg_left hL hB]
  have hV : |V| ≤ T*|w.kap1| *L := by
    dsimp [V]; rw [abs_mul,abs_mul,abs_of_nonneg hX₀,abs_of_pos hL₀]
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hX (abs_nonneg _)) hL₀.le
  have hid : gammaPacket w F T y l h-((F 0*X*w.kap1*L^2*J:ℝ):ℂ)=
      ((F 0*S:ℝ):ℂ)*(Gam w T 1-(V:ℂ)) + ((F 0*(S-L*J)*V:ℝ):ℂ) + gammaOff w F T y l h := by
    rw [split_gamma w F (by linarith) hy hyl hh₁.le,Complex.real_smul]
    dsimp only [S,L,V]; push_cast; ring
  change ‖gammaPacket w F T y l h-_‖ ≤ _*T*L
  rw [hid]
  let a := ((F 0*S:ℝ):ℂ)*(Gam w T 1-(V:ℂ))
  let b := ((F 0*(S-L*J)*V:ℝ):ℂ)
  let c := gammaOff w F T y l h
  apply (show ‖a+b+c‖ ≤ ‖a‖+‖b‖+‖c‖ from
    (norm_add_le (a+b) c).trans (add_le_add (norm_add_le a b) (le_refl ‖c‖))).trans
  dsimp only [a,b,c]
  rw [norm_mul,Complex.norm_real,Complex.norm_real,Real.norm_eq_abs,Real.norm_eq_abs,abs_mul,abs_mul,abs_mul]
  have h₁ := mul_le_mul (mul_le_mul hz hS' (abs_nonneg _) zero_le_one) (hdiag T hT)
    (norm_nonneg _) (by positivity)
  have h₂ := mul_le_mul (mul_le_mul hz hS (abs_nonneg _) zero_le_one) hV (abs_nonneg _) (by positivity)
  exact (add_le_add (add_le_add h₁ h₂) he).trans_eq (by ring)

end ReflectedGamma
end
end Src_ReflectedGamma

section Src_ReflectedMain

noncomputable section
open MeasureTheory BHB BHB.Arith PrincipalBand ReflectedLogBand ReflectedGamma

namespace ReflectedMain

def sideMass (w : Weight) (s : ℤ) := ∫ t in Set.Ioi 0, hside w.h s t

theorem side_mass (w : Weight) : sideMass w 1 + sideMass w (-1) = w.kap1 := by
  simp only [sideMass,hside,Int.cast_one,Int.cast_neg,one_mul,neg_one_mul,integral_comp_neg_Ioi,neg_zero]
  rw [add_comm]
  exact intervalIntegral.integral_Iic_add_Ioi w.h_int.integrableOn w.h_int.integrableOn

private def mainScale (T m c : ℝ) : ℂ := ((T/(2*Real.pi)*m*(Real.log T)^2*c:ℝ):ℂ)

private def approximates (a b : ℝ → ℂ) := ∃ C : ℝ, 0 ≤ C ∧
  ∀ᶠ T : ℝ in Filter.atTop, ‖a T-b T‖ ≤ C*T*Real.log T

private lemma add_est {a b q r : ℝ → ℂ} (ha : approximates a q) (hb : approximates b r) :
    approximates (fun T => a T+b T) (fun T => q T+r T) := by
  obtain ⟨A,hA,ha⟩ := ha
  obtain ⟨B,hB,hb⟩ := hb
  refine ⟨A+B,by positivity,?_⟩
  filter_upwards [ha,hb] with T ha hb
  rw [show a T+b T-(q T+r T)=(a T-q T)+(b T-r T) by ring]
  exact (norm_add_le ..).trans ((add_le_add ha hb).trans_eq (by ring))

private lemma neg_est {a q : ℝ → ℂ} (ha : approximates a q) :
    approximates (fun T => -a T) (fun T => -q T) := by
  obtain ⟨A,hA,ha⟩ := ha
  refine ⟨A,hA,?_⟩
  filter_upwards [ha] with T h
  simpa only [neg_sub_neg, norm_sub_rev] using h

def sidePacket (w : Weight) (F : ℝ → ℝ) (T y l h : ℝ) (s : ℤ) : ℂ :=
  (principalPacket F (hside w.h s) (Real.log T) y l h:ℂ) +
    logPacket F (hside w.h s) (Real.log T) y l h s

/-- Sum of both principal and logarithmic packets, less the full gamma packet. -/
def signedPackets (w : Weight) (F : ℝ → ℝ) (T y l h : ℝ) : ℂ :=
  sidePacket w F T y l h 1 + sidePacket w F T y l h (-1) - gammaPacket w F T y l h

private lemma for_taper (hRH : RiemannHypothesis) (w : Weight) {z c : ℝ} (hz : z ∈ Set.Icc (0:ℝ) 1)
    (hd : ∀ {H : ℝ → ℝ}, Adm H → ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      |principalPacket (taper z) H (Real.log T) theta (1/2) topExponent-
      (T/(2*Real.pi))*(∫ t in Set.Ioi 0,H t)*(Real.log T)^2*c| ≤ C*T*Real.log T) :
    approximates (fun T => signedPackets w (taper z) T theta (1/2) topExponent)
      (fun T => mainScale T w.kap1 (c+unitIntegral (1/2) topExponent-gammaIntegral (1/2) topExponent)) := by
  have hf : taper z 0 = 1 := by simp [taper]
  have hy : 0 ≤ theta := by norm_num [theta]
  have hyl : theta ≤ 1/2 := by norm_num [theta]
  have hlh : 1/2 ≤ topExponent := by norm_num [topExponent]
  have hh : 0 < topExponent := by norm_num [topExponent]
  have hh₁ : topExponent < 1 := by norm_num [topExponent]
  let U := unitIntegral (1/2) topExponent
  let V := gammaIntegral (1/2) topExponent
  have side (s : ℤ) (hs : s=1 ∨ s= -1) :
      approximates (fun T => sidePacket w (taper z) T theta (1/2) topExponent s)
        (fun T => mainScale T (sideMass w s) c+mainScale T (sideMass w s) U) := by
    have had := adm_hside w hs
    apply add_est
    · obtain ⟨A,hA,ha⟩ := hd had
      refine ⟨A,hA,?_⟩
      filter_upwards [ha] with T h
      simpa only [mainScale,sideMass,← Complex.ofReal_sub,Complex.norm_real,Real.norm_eq_abs] using h
    · obtain ⟨A,hA,ha⟩ := log_packet_asymptotic hRH (taper z) had hy hyl hlh hh hh₁ (taper_bound hz)
      refine ⟨A,hA,?_⟩
      filter_upwards [ha] with T h
      simpa only [hf,one_mul,mainScale,sideMass,U] using h s (by rcases hs with rfl|rfl <;> norm_num)
  have ga : approximates (fun T => gammaPacket w (taper z) T theta (1/2) topExponent)
      (fun T => mainScale T w.kap1 V) := by
    simpa only [approximates,mainScale,hf,one_mul,V] using
      gamma_packet_asymptotic hRH w (taper z) hy hyl hlh hh hh₁ (taper_bound hz)
  have both := add_est (add_est (side 1 (Or.inl rfl)) (side (-1) (Or.inr rfl))) (neg_est ga)
  obtain ⟨C,hC,he⟩ := both
  refine ⟨C,hC,?_⟩
  filter_upwards [he] with T h
  have heq : (mainScale T (sideMass w 1) c+mainScale T (sideMass w 1) U)+
      (mainScale T (sideMass w (-1)) c+mainScale T (sideMass w (-1)) U) - mainScale T w.kap1 V =
      mainScale T w.kap1 (c+U-V) := by
    rw [← side_mass w]
    dsimp only [mainScale]; push_cast; ring
  change ‖signedPackets w (taper z) T theta (1/2) topExponent-mainScale T w.kap1 (c+U-V)‖ ≤ _
  rw [← heq]
  simpa only [signedPackets,sub_eq_add_neg] using h

theorem packet_integrals :
    unitIntegral (1/2) topExponent=311500001999/11976012000000 ∧
    gammaIntegral (1/2) topExponent=497752999/5988006000 := by
  let h := topExponent
  have hu (v : ℝ) : (v/h)*(1-v/h)*(1-v)=0+(1/h)*v+(-1/h-1/h^2)*v^2+(1/h^2)*v^3 := by ring
  have hg (v : ℝ) : (v/h)*(1-v/h)=0+(1/h)*v+(-1/h^2)*v^2+0*v^3 := by ring
  constructor
  · change (∫ v in (1/2:ℝ)..h, (v/h)*(1-v/h)*(1-v))=_
    simp_rw [hu]; rw [integrate_cubic]; norm_num [primitive,h,topExponent]
  · change (∫ v in (1/2:ℝ)..h, (v/h)*(1-v/h))=_
    simp_rw [hg]; rw [integrate_cubic]; norm_num [primitive,h,topExponent]

theorem signed_packets_8539 (hRH : RiemannHypothesis) (w : Weight) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop, ‖signedPackets w (taper (39/50)) T theta (1/2) topExponent-
      ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*(-216739263388000063/5988006000000000000):ℝ):ℂ)‖ ≤ C*T*Real.log T := by
  have he := for_taper hRH w (z:=39/50) (by constructor <;> norm_num) (divisor_packet_8539 hRH)
  norm_num only [packet_integrals.1,packet_integrals.2] at he
  simpa only [approximates,mainScale,neg_div] using he

theorem signed_packets_8535 (hRH : RiemannHypothesis) (w : Weight) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop, ‖signedPackets w (taper (1/2)) T theta (1/2) topExponent-
      ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*(-26706611469780007/718560720000000000):ℝ):ℂ)‖ ≤ C*T*Real.log T := by
  have he := for_taper hRH w (z:=1/2) (by constructor <;> norm_num) (divisor_packet_8535 hRH)
  norm_num only [packet_integrals.1,packet_integrals.2] at he
  simpa only [approximates,mainScale,neg_div] using he

end ReflectedMain
end
end Src_ReflectedMain

section Src_ReflectedExplicit

noncomputable section
open BHB BHB.Red PrincipalBand ReflectedGamma
open scoped ArithmeticFunction BigOperators Real

namespace ReflectedExplicit

private def kernel (w : Weight) (T : ℝ) (m k p n : ℕ) : ℂ :=
  ((1/Real.sqrt ((m:ℝ)*k*(n*p:ℕ)):ℝ):ℂ)*((T:ℂ)*w.k (T*Real.log ((m:ℝ)*k/(n*p:ℕ))))

def poissonRow (w : Weight) (T : ℝ) (k p : ℕ) : ℂ :=
  (∑' n : ℕ, (Λ n:ℂ)*Iterm1 w T k (n*p) 0) +
    ∑' n : ℕ, (Λ n:ℂ)*∑' j : ℤ, if j=0 then 0 else Iterm1 w T k (n*p) j

private lemma m_sum (w : Weight) {T : ℝ} (hT : 1 ≤ T) {k p : ℕ} (hk : 0 < k) (hp : 0 < p) :
    ∑ m ∈ Mrange (Xtr T), (dco (Xtr T) m:ℂ)*∑' n : ℕ, (Λ n:ℂ)*kernel w T m k p n =
      poissonRow w T k p := by
  have hT₀ := zero_lt_one.trans_le hT
  have hX := Xtr_pos hT₀
  have hk₀ : (0:ℝ) < k := by exact_mod_cast hk
  apply PO.sum_tsum_poisson_split
  · intro m hm
    have hm₀ : (0:ℝ) < m := by exact_mod_cast (Finset.mem_Icc.mp hm).1
    apply summable_of_ne_finset_zero (s:=Finset.range (⌊(m:ℝ)*k*Real.exp (w.kappa/T)⌋₊+1))
    intro n hn
    rw [Finset.mem_range,not_lt] at hn
    have he : (m:ℝ)*k*Real.exp (w.kappa/T) < (n*p:ℕ) := lt_of_lt_of_le (Nat.lt_floor_add_one _)
      (by exact_mod_cast hn.trans (Nat.le_mul_of_pos_right n hp))
    have hnp : (0:ℝ) < (n*p:ℕ) := lt_trans (by positivity) he
    have hz : w.k (T*Real.log ((m:ℝ)*k/(n*p:ℕ)))=0 := by
      apply PO.bump_log_eq_zero (Bump.ofWeight w) hT₀ (by positivity) (Or.inl ?_)
      rw [div_lt_iff₀ hnp,Real.exp_neg, lt_inv_mul_iff₀ (Real.exp_pos _),mul_comm]
      exact he
    simp only [kernel,hz,mul_zero]
  · intro n hn
    have hn₀ : 0 < n := Nat.pos_of_ne_zero (fun he => by subst n; simp at hn)
    exact S1main_inner w hT hk (Nat.mul_pos hn₀ hp)
  · refine ⟨⌊2*Real.exp (w.kappa/T)*(k*Xtr T)⌋₊,fun n hn j => ?_⟩
    have he : 2*Real.exp (w.kappa/T)*(k*Xtr T) < (n*p:ℕ) := lt_of_lt_of_le (Nat.lt_floor_add_one _)
      (by exact_mod_cast hn.trans_le (Nat.le_mul_of_pos_right n hp))
    have hz : Iex w.k T (Real.log (((n*p:ℕ):ℝ)/k)) (((n*p:ℕ):ℝ)/(k*Xtr T))
        (2*Real.pi*j*(n*p:ℕ)/(k*T))=0 := by
      apply Iex_eq_zero (Bump.ofWeight w) hT₀ ?_ _ _
      exact (le_div_iff₀ (by positivity)).mpr he.le
    unfold Iterm1; rw [hz,mul_zero]

private lemma reciprocal_zero (w : Weight) {T : ℝ} (hT : 0 < T) {k m p n : ℕ}
    (hk : 0 < k) (hm : 0 < m) (hp : p.Prime) (hgap : w.kappa*((p:ℝ)+1) < T)
    (hd : dco (Xtr T) m ≠ 0) (hn : (Λ n:ℝ) ≠ 0) :
    Fpk w T (((m:ℝ)*k)/p) (Real.log n)=0 := by
  have hn₀ : 0 < n := Nat.pos_of_ne_zero (fun he => by subst n; simp at hn)
  have hne : m*k*n≠p := fun he => (mul_ne_zero hn hd) (ReflectedPackets.reciprocal_resonance hp hm hk he _)
  have hi := FejerPrimeMoments.integer_gap hp.pos (Nat.mul_pos (Nat.mul_pos hm hk) hn₀) hne.symm
  have hmk : 0 < (m:ℝ)*k := by exact_mod_cast Nat.mul_pos hm hk
  have hn' : 0 < (n:ℝ) := by exact_mod_cast hn₀
  have hp' : 0 < (p:ℝ) := by exact_mod_cast hp.pos
  have hid : Real.log n+Real.log ((m:ℝ)*k/p)=Real.log (m*k*n:ℕ)-Real.log p := by
    push_cast; rw [Real.log_mul hmk.ne' hn'.ne',Real.log_div hmk.ne' hp'.ne']; ring
  rw [Fpk,TMA.Kernel.k_eq_zero_of_lt w.toHeightWeight,mul_zero]
  rw [abs_mul,abs_of_pos hT,hid,abs_sub_comm]
  have hg : w.kappa < T/((p:ℝ)+1) := (lt_div_iff₀ (by positivity)).mpr hgap
  exact hg.trans_le (by simpa only [mul_one_div] using mul_le_mul_of_nonneg_left hi hT.le)

private lemma prime_row (w : Weight) {T : ℝ} (hT : 1 ≤ T) {k p : ℕ} (hk : 0 < k) (hp : p.Prime)
    (hgap : w.kappa*((p:ℝ)+1) < T) :
    ∑ m ∈ Mrange (Xtr T), ((dco (Xtr T) m/Real.sqrt ((m:ℝ)*k*p):ℝ):ℂ)*
      Pside w T ((m:ℝ)*k/p)=poissonRow w T k p := by
  rw [← m_sum w hT hk hp.pos]
  apply Finset.sum_congr rfl
  intro m hm
  have hm' := (Finset.mem_Icc.mp hm).1
  by_cases hd : dco (Xtr T) m=0
  · simp [hd]
  have hT₀ := zero_lt_one.trans_le hT
  have hmk : 0 < (m:ℝ)*k := by exact_mod_cast Nat.mul_pos hm' hk
  have hp' : 0 < (p:ℝ) := by exact_mod_cast hp.pos
  unfold Pside
  rw [← tsum_mul_left,← tsum_mul_left]
  apply tsum_congr
  intro n
  by_cases hn : (Λ n:ℝ)=0
  · simp [hn]
  have hn₀ : (0:ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero (fun he => by subst n; simp at hn)
  rw [reciprocal_zero w hT₀ hk hm' hp hgap hd hn,zero_add]
  have harg : -Real.log n+Real.log ((m:ℝ)*k/p)=Real.log ((m:ℝ)*k/(n*p:ℕ)) := by
    push_cast
    rw [Real.log_div hmk.ne' hp'.ne',Real.log_div hmk.ne' (mul_pos hn₀ hp').ne',Real.log_mul hn₀.ne' hp'.ne']
    ring
  simp only [kernel,Fpk,harg,Nat.cast_mul]
  rw [show (m:ℝ)*k*(n*p)=((m:ℝ)*k*p)*n by ring,Real.sqrt_mul (mul_pos hmk hp').le]
  push_cast; ring

def zeroRow (w : Weight) (T : ℝ) (k p : ℕ) := ∑ m ∈ Mrange (Xtr T),
  ((dco (Xtr T) m/Real.sqrt ((m:ℝ)*k*p):ℝ):ℂ)*Kx w.h T ((m:ℝ)*k/p)

def poleRow (w : Weight) (T : ℝ) (k p : ℕ) := ∑ m ∈ Mrange (Xtr T), (dco (Xtr T) m:ℂ)*
  (Hc w (Complex.I/(2*T))/(p:ℂ)+Hc w (-Complex.I/(2*T))/((m:ℂ)*k))

def gammaRow (w : Weight) (T : ℝ) (k p : ℕ) := ∑ m ∈ Mrange (Xtr T),
  ((dco (Xtr T) m/Real.sqrt ((m:ℝ)*k*p):ℝ):ℂ)*Gam w T ((m:ℝ)*k/p)

theorem zero_row (hRH : RiemannHypothesis) (w : Weight) {T : ℝ} (hT : 1 ≤ T)
    {k p : ℕ} (hk : 0 < k) (hp : p.Prime) (hgap : w.kappa*((p:ℝ)+1) < T) :
    -zeroRow w T k p=poissonRow w T k p-poleRow w T k p-gammaRow w T k p := by
  rw [← prime_row w hT hk hp hgap]
  unfold zeroRow poleRow gammaRow
  rw [← Finset.sum_neg_distrib,← Finset.sum_sub_distrib,← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro m hm
  have hmk : 0 < (m:ℝ)*k := by exact_mod_cast Nat.mul_pos (Finset.mem_Icc.mp hm).1 hk
  have hp' : 0 < (p:ℝ) := by exact_mod_cast hp.pos
  rw [Kx_eq hRH w (zero_lt_one.trans_le hT) (div_pos hmk hp'),Real.sqrt_div hmk.le,Real.sqrt_mul hmk.le]
  have hs : (Real.sqrt ((m:ℝ)*k):ℂ)^2=(m:ℂ)*k := by
    exact_mod_cast Real.sq_sqrt hmk.le
  have ht : (Real.sqrt (p:ℝ):ℂ)^2=(p:ℂ) := by exact_mod_cast Real.sq_sqrt hp'.le
  have h₁ : (Real.sqrt ((m:ℝ)*k):ℂ) ≠ 0 := by exact_mod_cast (Real.sqrt_pos.mpr hmk).ne'
  have h₂ : (Real.sqrt (p:ℝ):ℂ) ≠ 0 := by exact_mod_cast (Real.sqrt_pos.mpr hp').ne'
  push_cast
  rw [← hs,← ht]
  field_simp
  ring

def sumRows (F : ℝ → ℝ) (T y l h : ℝ) (row : ℕ → ℕ → ℂ) := ∑ k ∈ Krange y T,
  ∑ p ∈ band (Real.log T) l h, ((mollifier F (Real.log T) k*label h (Real.log T) p:ℝ):ℂ)*row k p

private lemma gamma_rows (w : Weight) (F : ℝ → ℝ) (T y l h : ℝ) :
    sumRows F T y l h (gammaRow w T)=gammaPacket w F T y l h := by
  unfold sumRows gammaPacket gammaRow
  apply Finset.sum_congr rfl
  intro k _
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro m _
  apply Finset.sum_congr rfl
  intro p _
  change _ = ((coefficient F T h k m p / Real.sqrt (((m*k:ℕ):ℝ)*p):ℝ):ℂ)*Gam w T (((m*k:ℕ):ℝ)/p)
  unfold coefficient
  push_cast; ring

lemma label_gap (w : Weight) {h : ℝ} (hh : 0 < h) (hh₁ : h < 1) :
    ∀ᶠ T : ℝ in Filter.atTop, ∀ l : ℝ, ∀ p ∈ band (Real.log T) l h, w.kappa*((p:ℝ)+1) < T := by
  filter_upwards [Filter.eventually_ge_atTop (1:ℝ),
    (tendsto_rpow_atTop (sub_pos.mpr hh₁)).eventually_gt_atTop (2*w.kappa)] with T hT hg
  intro l p hp
  have hT₀ := zero_lt_one.trans_le hT
  have ht := Real.one_le_rpow hT hh.le
  have hp' := (Nat.le_floor_iff (Real.exp_pos _).le).mp (Finset.mem_Ioc.mp (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).1).2
  rw [← Real.rpow_def_of_pos hT₀] at hp'
  have h₁ : w.kappa*((p:ℝ)+1) ≤ T^h*(2*w.kappa) := by
    nlinarith only [mul_le_mul_of_nonneg_left hp' w.kappa_pos.le,mul_le_mul_of_nonneg_left ht w.kappa_pos.le]
  apply h₁.trans_lt ((mul_lt_mul_of_pos_left hg (Real.rpow_pos_of_pos hT₀ _)).trans_eq ?_)
  rw [← Real.rpow_add hT₀,add_sub_cancel,Real.rpow_one]

/-- Exact decomposition of the finite mollifier and prime sum of the board's
zero trace at mk/p. The Poisson terms have the original integer input np. -/
theorem zero_band (hRH : RiemannHypothesis) (w : Weight) (F : ℝ → ℝ) (y l : ℝ)
    {h : ℝ} (hh : 0 < h) (hh₁ : h < 1) : ∀ᶠ T : ℝ in Filter.atTop,
      -sumRows F T y l h (zeroRow w T)=sumRows F T y l h (poissonRow w T)-
        sumRows F T y l h (poleRow w T)-gammaPacket w F T y l h := by
  filter_upwards [label_gap w hh hh₁,Filter.eventually_ge_atTop (1:ℝ)] with T hg hT
  rw [← gamma_rows]
  unfold sumRows
  simp only [← Finset.sum_neg_distrib,← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro k hk
  apply Finset.sum_congr rfl
  intro p hp
  rw [← mul_sub,← mul_sub,← mul_neg,zero_row hRH w hT (Finset.mem_Icc.mp hk).1
    (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).2 (hg l p hp)]

end ReflectedExplicit
end
end Src_ReflectedExplicit

section Src_ReflectedPoles

noncomputable section
open BHB BHB.Red PrincipalBand ReflectedGamma ReflectedExplicit
open scoped BigOperators Real

namespace ReflectedPoles

private def poleSum (K N : ℕ) (q : Finset ℕ) (a : ℕ → ℕ → ℕ → ℝ) (u v : ℂ) :=
  ∑ k ∈ Finset.Icc 1 K, ∑ p ∈ q, ∑ m ∈ Finset.Icc 1 N, (a k m p:ℂ)*(u/(p:ℂ)+v/((m:ℂ)*k))

private lemma sums (K N M : ℕ) (q : Finset ℕ) (hq : q ⊆ Finset.Icc 1 M) :
    (∑ k ∈ Finset.Icc 1 K, ∑ p ∈ q, ∑ m ∈ Finset.Icc 1 N,
      (1/(p:ℝ)+1/((m:ℝ)*k))) ≤ (K:ℝ)*N*(1+Real.log M)+M*(1+Real.log K)*(1+Real.log N) := by
  have hq' : (∑ p ∈ q, 1/(p:ℝ)) ≤ 1+Real.log M :=
    (Finset.sum_le_sum_of_subset_of_nonneg hq (fun _ _ _ => by positivity)).trans (BHB.Arith.sum_Icc_one_div_le_one_add_log M)
  have hc : (q.card:ℝ) ≤ M := by
    exact_mod_cast ((Finset.card_le_card hq).trans_eq (by simp))
  let A := ∑ k ∈ Finset.Icc 1 K, 1/(k:ℝ)
  let B := ∑ m ∈ Finset.Icc 1 N, 1/(m:ℝ)
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have h₁ : (∑ k ∈ Finset.Icc 1 K, ∑ p ∈ q, ∑ _m ∈ Finset.Icc 1 N, 1/(p:ℝ))=
      (K:ℝ)*N*∑ p ∈ q, 1/(p:ℝ) := by simp [← Finset.mul_sum,mul_assoc]
  have h₂ : (∑ k ∈ Finset.Icc 1 K, ∑ _p ∈ q, ∑ m ∈ Finset.Icc 1 N, 1/((m:ℝ)*k))=
      (q.card:ℝ)*A*B := by
    have he (m k : ℕ) : 1/((m:ℝ)*k)=1/(k:ℝ)*(1/(m:ℝ)) := by ring
    simp_rw [he,← Finset.mul_sum]
    simp only [Finset.sum_const,nsmul_eq_mul,← Finset.mul_sum,← Finset.sum_mul]
    dsimp only [A,B]; ring
  simp only [Finset.sum_add_distrib,h₁,h₂]
  exact add_le_add (mul_le_mul_of_nonneg_left hq' (by positivity))
    (mul_le_mul (mul_le_mul hc (BHB.Arith.sum_Icc_one_div_le_one_add_log K) hA (Nat.cast_nonneg M))
      (BHB.Arith.sum_Icc_one_div_le_one_add_log N) hB (by positivity [Real.log_natCast_nonneg K]))

private lemma pole_bound {K N M : ℕ} {q : Finset ℕ} (hq : q ⊆ Finset.Icc 1 M)
    (a : ℕ → ℕ → ℕ → ℝ) {A D : ℝ} (hA : 0 ≤ A) (hD : 0 ≤ D)
    (ha : ∀ k ∈ Finset.Icc 1 K, ∀ m ∈ Finset.Icc 1 N, ∀ p ∈ q, |a k m p| ≤ A)
    {u v : ℂ} (hu : ‖u‖ ≤ D) (hv : ‖v‖ ≤ D) :
    ‖poleSum K N q a u v‖ ≤ A*D*((K:ℝ)*N*(1+Real.log M)+M*(1+Real.log K)*(1+Real.log N)) := by
  have hb (k : ℕ) (hk : k ∈ Finset.Icc 1 K) (m : ℕ) (hm : m ∈ Finset.Icc 1 N) (p : ℕ) (hp : p ∈ q) :
      ‖(a k m p:ℂ)*(u/(p:ℂ)+v/((m:ℂ)*k))‖ ≤ A*D*(1/(p:ℝ)+1/((m:ℝ)*k)) := by
    rw [norm_mul,Complex.norm_real,Real.norm_eq_abs]
    apply (mul_le_mul (ha k hk m hm p hp) (norm_add_le ..) (norm_nonneg _) hA).trans
    simp only [norm_div,norm_mul,Complex.norm_natCast]
    exact (mul_le_mul_of_nonneg_left (add_le_add (div_le_div_of_nonneg_right hu (by positivity))
      (div_le_div_of_nonneg_right hv (by positivity))) hA).trans_eq (by ring)
  apply (norm_sum_le ..).trans
  calc
    _ ≤ ∑ k ∈ Finset.Icc 1 K, ∑ p ∈ q, ∑ m ∈ Finset.Icc 1 N, A*D*(1/(p:ℝ)+1/((m:ℝ)*k)) := by
      apply Finset.sum_le_sum
      intro k hk
      apply (norm_sum_le ..).trans
      apply Finset.sum_le_sum
      intro p hp
      exact (norm_sum_le ..).trans (Finset.sum_le_sum (fun m hm => hb k hk m hm p hp))
    _ ≤ _ := by
      simp_rw [← Finset.mul_sum]
      exact mul_le_mul_of_nonneg_left (sums K N M q hq) (mul_nonneg hA hD)

private lemma to_rows (w : Weight) (F : ℝ → ℝ) (T y l h : ℝ) :
    sumRows F T y l h (poleRow w T)=poleSum ⌊T^y⌋₊ ⌊2*Xtr T⌋₊ (band (Real.log T) l h)
        (coefficient F T h) (Hc w (Complex.I/(2*T))) (Hc w (-Complex.I/(2*T))) := by
  unfold sumRows poleRow poleSum
  apply Finset.sum_congr rfl
  intro k _
  apply Finset.sum_congr rfl
  intro p _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro m _
  unfold coefficient; push_cast; ring


/-- The two pole evaluations in the explicit formula have a total error of
order T log T throughout the high-prime band. -/
theorem pole_band (w : Weight) (F : ℝ → ℝ) {y l h : ℝ} (hy : y < 1/2) (hh : 0 < h)
    (hh₁ : h < 1) (hFb : ∀ u ∈ Set.Icc 0 y, |F u| ≤ 1) : ∃ C : ℝ, 0 ≤ C ∧
    ∀ᶠ T : ℝ in Filter.atTop, ‖sumRows F T y l h (poleRow w T)‖ ≤ C*T*Real.log T := by
  obtain ⟨D,T₀,hD⟩ := norm_Hc_le w
  refine ⟨36*|D|,by positivity,?_⟩
  have h₁ := (isLittleO_log_rpow_atTop (sub_pos.mpr hy)).bound zero_lt_one
  have h₂ := (isLittleO_log_rpow_atTop (by norm_num : (0:ℝ)<1/2)).bound zero_lt_one
  filter_upwards [ReflectedLogBand.scales hh₁,h₁,h₂,Filter.eventually_ge_atTop T₀] with T hsc h₁ h₂ ht
  obtain ⟨hL,_,_,hT₀⟩ := hsc
  let L := Real.log T
  let K := ⌊T^y⌋₊
  let N := ⌊2*Xtr T⌋₊
  let M := ⌊T^h⌋₊
  let q := band L l h
  have hL₀ : 0 < L := by dsimp [L]; linarith
  have hT := (Real.log_nonneg_iff hT₀).mp hL₀.le
  have hp (a : ℝ) := Real.rpow_pos_of_pos hT₀ a
  have hK : (K:ℝ) ≤ T^y := Nat.floor_le (hp _).le
  have hN : (N:ℝ) ≤ 2*T^(3/2:ℝ) := Nat.floor_le (mul_nonneg (by norm_num) (hp _).le)
  have hM : (M:ℝ) ≤ T := (Nat.floor_le (hp h).le).trans
    ((Real.rpow_le_rpow_of_exponent_le hT hh₁.le).trans_eq (Real.rpow_one T))
  have hKT := hK.trans ((Real.rpow_le_rpow_of_exponent_le hT (by linarith : y ≤ 1)).trans_eq (Real.rpow_one T))
  have hlog (n : ℕ) (hn : (n:ℝ) ≤ T) : Real.log n ≤ L := by
    by_cases he : n=0
    · rw [he,Nat.cast_zero,Real.log_zero]; exact hL₀.le
    · exact Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero he) hn
  have hNlog : Real.log N ≤ 3*L := by
    by_cases hn : N=0
    · rw [hn,Nat.cast_zero,Real.log_zero]; positivity
    · apply (Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero hn) hN).trans
      rw [Real.log_mul (by norm_num) (hp _).ne',Real.log_rpow hT₀]
      dsimp [L]; linarith [Real.log_le_sub_one_of_pos (by norm_num : (0:ℝ)<2)]
  have hL₁ : L ≤ T^(1/2-y) := by
    simpa only [Real.norm_eq_abs,abs_of_nonneg hL₀.le,abs_of_pos (hp _),one_mul,L] using h₁
  have hL₂ : L ≤ T^(1/2:ℝ) := by
    simpa only [Real.norm_eq_abs,abs_of_nonneg hL₀.le,abs_of_pos (hp _),one_mul,L] using h₂
  have hKN : (K:ℝ)*N*(1+Real.log M) ≤ 4*T^2 := by
    have hv : T^y*(2*T^(3/2:ℝ))*(2*T^(1/2-y))=4*T^2 := by
      calc
        _ = 4*(T^y*T^(3/2:ℝ)*T^(1/2-y)) := by ring
        _ = _ := by rw [← Real.rpow_add hT₀,← Real.rpow_add hT₀,show y+3/2+(1/2-y)=2 by ring,Real.rpow_two]
    apply (mul_le_mul (mul_le_mul hK hN (Nat.cast_nonneg _) (hp _).le) _
      (by positivity [Real.log_natCast_nonneg M]) (by positivity)).trans_eq hv
    have := hlog M hM
    dsimp [L] at *; linarith
  have hMN : (M:ℝ)*(1+Real.log K)*(1+Real.log N) ≤ 8*T^2 := by
    have hsq : L*L ≤ T := (mul_le_mul hL₂ hL₂ hL₀.le (hp _).le).trans_eq (by
      rw [← Real.rpow_add hT₀]; norm_num)
    have hklog := hlog K hKT
    have h₁' : 1+Real.log K ≤ 2*L := by dsimp [L] at *; linarith
    have h₂' : 1+Real.log N ≤ 4*L := by dsimp [L] at *; linarith
    apply (mul_le_mul (mul_le_mul hM h₁' (by positivity [Real.log_natCast_nonneg K]) hT₀.le) h₂'
      (by positivity [Real.log_natCast_nonneg N]) (by positivity)).trans
    nlinarith only [mul_le_mul_of_nonneg_left hsq hT₀.le]
  have hq : q ⊆ Finset.Icc 1 M := by
    intro p hp'
    obtain ⟨hm,hpr⟩ := Finset.mem_filter.mp (Finset.mem_sdiff.mp hp').1
    exact Finset.mem_Icc.mpr ⟨hpr.pos,by simpa only [L,M,Real.rpow_def_of_pos hT₀] using (Finset.mem_Ioc.mp hm).2⟩
  have hd := div_le_div_of_nonneg_right (le_abs_self D) hT₀.le
  rw [to_rows]
  apply (pole_bound hq (coefficient F T h) (by positivity : 0 ≤ 3*L) (by positivity : 0 ≤ |D|/T)
    (coefficient_bound F hFb hL hT₀ hh) ((hD T ht).1.trans hd) ((hD T ht).2.trans hd)).trans
  apply (mul_le_mul_of_nonneg_left (add_le_add hKN hMN) (by positivity : 0 ≤ 3*L*(|D|/T))).trans_eq
  dsimp only [L]; field_simp; ring

/-- What remains of the reflected truncated zero trace after Poisson summation
and the gamma term, with the pole contribution absorbed at the error scale. -/
theorem zero_band_error (hRH : RiemannHypothesis) (w : Weight) (F : ℝ → ℝ) {y l h : ℝ}
    (hy : y < 1/2) (hh : 0 < h) (hh₁ : h < 1) (hFb : ∀ u ∈ Set.Icc 0 y, |F u| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop, ‖-sumRows F T y l h (zeroRow w T)-
      (sumRows F T y l h (poissonRow w T)-gammaPacket w F T y l h)‖ ≤ C*T*Real.log T := by
  obtain ⟨C,hC,he⟩ := pole_band w F hy hh hh₁ hFb (l:=l)
  refine ⟨C,hC,?_⟩
  filter_upwards [he,zero_band hRH w F y l hh hh₁] with T he hz
  rw [hz,show ∀ a b c : ℂ, a-b-c-(a-c)= -b by intros; ring,norm_neg]
  exact he

end ReflectedPoles
end
end Src_ReflectedPoles

section Src_ReflectedRemainder

noncomputable section
open BHB BHB.Red PrincipalBand ReflectedGamma ReflectedMain ReflectedExplicit ReflectedLogBand
open scoped ArithmeticFunction BigOperators Real

namespace ReflectedRemainder

def zeroMode (w : Weight) (T : ℝ) (k p : ℕ) := ∑' n : ℕ, (Λ n:ℂ)*Iterm1 w T k (n*p) 0
def otherModes (w : Weight) (T : ℝ) (k p : ℕ) := ∑' n : ℕ, (Λ n:ℂ)*
  ∑' j : ℤ, if j=0 then 0 else Iterm1 w T k (n*p) j

lemma distinct_label {T y l h : ℝ} (hT : 1 ≤ T) (hyl : y ≤ l) {k p : ℕ}
    (hk : k ∈ Krange y T) (hp : p ∈ band (Real.log T) l h) : k < p := by
  by_contra! hn
  apply (Finset.mem_sdiff.mp hp).2
  have hpr := (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).2
  apply Finset.mem_filter.mpr
  refine ⟨Finset.mem_Ioc.mpr ⟨hpr.pos,hn.trans ((Finset.mem_Icc.mp hk).2.trans (Nat.floor_mono ?_))⟩,hpr⟩
  rw [← Real.rpow_def_of_pos (zero_lt_one.trans_le hT)]
  exact Real.rpow_le_rpow_of_exponent_le hT hyl

lemma band_bound (F : ℝ → ℝ) {T y l h B : ℝ} (hT₀ : 0 < T) (hL : 0 < Real.log T)
    (hh : 0 < h) (hB : 0 ≤ B) (hFb : ∀ u ∈ Set.Icc 0 y, |F u| ≤ 1)
    (r : ℕ → ℕ → ℂ) (hr : ∀ k ∈ Krange y T, ∀ p ∈ band (Real.log T) l h, ‖r k p‖ ≤ B/(p:ℝ)) :
    ‖sumRows F T y l h r‖ ≤ T^y*B*(1+Real.log ⌊T^h⌋₊) := by
  let q := band (Real.log T) l h
  let M := ⌊T^h⌋₊
  have hq : q ⊆ Finset.Icc 1 M := by
    intro p hp
    obtain ⟨hm,hpr⟩ := Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1
    exact Finset.mem_Icc.mpr ⟨hpr.pos,by simpa only [M,Real.rpow_def_of_pos hT₀] using (Finset.mem_Ioc.mp hm).2⟩
  have hS := (Finset.sum_le_sum_of_subset_of_nonneg (f:=fun p : ℕ => 1/(p:ℝ)) hq
    (fun _ _ _ => by positivity)).trans (BHB.Arith.sum_Icc_one_div_le_one_add_log M)
  have hb (k : ℕ) (hk : k ∈ Krange y T) (p : ℕ) (hp : p ∈ q) :
      ‖((mollifier F (Real.log T) k*label h (Real.log T) p:ℝ):ℂ)*r k p‖ ≤ B*(1/(p:ℝ)) := by
    have hkm : k ∈ ReflectedPrincipal.below (Real.exp (Real.log T*y)) :=
      Finset.mem_Ioc.mpr ⟨(Finset.mem_Icc.mp hk).1,by rw [← Real.rpow_def_of_pos hT₀]; exact (Finset.mem_Icc.mp hk).2⟩
    have hm : |mollifier F (Real.log T) k| ≤ 1 := by
      rw [mollifier,abs_mul]
      exact mul_le_one₀ (by exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n:=k))
        (abs_nonneg _) (hFb _ (log_mem hL hkm))
    rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_mul]
    exact (mul_le_mul (mul_le_one₀ hm (abs_nonneg _) (label_bound hL hh hp)) (hr k hk p hp)
      (norm_nonneg _) zero_le_one).trans_eq (by ring)
  apply (norm_sum_le ..).trans
  calc
    _ ≤ ∑ _k ∈ Krange y T, ∑ p ∈ q, B*(1/(p:ℝ)) := Finset.sum_le_sum
      (fun k hk => (norm_sum_le ..).trans (Finset.sum_le_sum (fun p hp => hb k hk p hp)))
    _ ≤ _ := by
      simp only [← Finset.mul_sum,Finset.sum_const,nsmul_eq_mul,Krange,ymol,Nat.card_Icc,Nat.add_sub_cancel]
      rw [mul_left_comm B]
      exact (mul_le_mul (Nat.floor_le (Real.rpow_pos_of_pos hT₀ y).le)
        (mul_le_mul_of_nonneg_left hS hB) (by positivity) (Real.rpow_pos_of_pos hT₀ y).le).trans_eq (mul_assoc _ _ _).symm

theorem zero_mode_band (w : Weight) (F : ℝ → ℝ) {y l h : ℝ} (hy : y < 1/2) (hyl : y ≤ l)
    (hh : 0 < h) (hh₁ : h < 1) (hFb : ∀ u ∈ Set.Icc 0 y, |F u| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop, ‖sumRows F T y l h (zeroMode w T)‖ ≤ C*T := by
  obtain ⟨C,T₀,hC,hZ⟩ := ReflectedPackets.zero_mode w
  refine ⟨98*C,by positivity,?_⟩
  have hslow := (isLittleO_log_rpow_rpow_atTop 3 (sub_pos.mpr hy)).bound zero_lt_one
  filter_upwards [scales hh₁,Filter.eventually_ge_atTop T₀,hslow] with T hsc ht hslow
  obtain ⟨hL,_,_,hT₀⟩ := hsc
  let L := Real.log T
  let M := ⌊T^h⌋₊
  have hL₀ : 0 < L := by dsimp [L]; linarith
  have hT := (Real.log_nonneg_iff hT₀).mp hL₀.le
  have hX := Xtr_pos hT₀
  let B := C*(Xtr T/T)*(1+Real.log (4*Xtr T))^2
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have he := band_bound F hT₀ hL₀ hh hB hFb (zeroMode w T) (l:=l) (by
    intro k hk p hp
    have hz := hZ T ht k p (Finset.mem_Icc.mp hk).1 (distinct_label hT hyl hk hp).le
    let f := fun n : ℕ => (Λ n:ℂ)*Iterm1 w T k (n*p) 0
    have hf (n : ℕ) : ‖f n‖=(Λ n:ℝ)*‖Iterm1 w T k (n*p) 0‖ := by
      simp only [f,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg ArithmeticFunction.vonMangoldt_nonneg]
    have H (N : Finset ℕ) : (∑ n ∈ N, ‖f n‖) ≤ B/p := by
      simp_rw [hf]
      exact (hz N).trans_eq (by dsimp [B]; ring)
    exact (norm_tsum_le_tsum_norm (summable_of_sum_le (fun n => norm_nonneg (f n)) H)).trans
      (Real.tsum_le_of_sum_le (fun n => norm_nonneg (f n)) H))
  have hxl : Xtr T/T=T^(1/2:ℝ) := by
    calc
      _ = T^(3/2:ℝ)/T^(1:ℝ) := by rw [Real.rpow_one,Xtr]
      _ = _ := by rw [← Real.rpow_sub hT₀]; norm_num
  have hlog₀ : 0 ≤ 1+Real.log (4*Xtr T) := by
    have h := Real.log_nonneg (show 1 ≤ 4*Xtr T by linarith [one_le_Xtr hT]); linarith
  have hlog : 1+Real.log (4*Xtr T) ≤ 7*L := by
    rw [Xtr,Real.log_mul (by norm_num) (Real.rpow_pos_of_pos hT₀ _).ne',Real.log_rpow hT₀]
    dsimp only [L]; linarith [Real.log_le_sub_one_of_pos (by norm_num : (0:ℝ)<4)]
  have hM₁ : (M:ℝ) ≤ T := (Nat.floor_le (Real.rpow_pos_of_pos hT₀ _).le).trans
    ((Real.rpow_le_rpow_of_exponent_le hT hh₁.le).trans_eq (Real.rpow_one T))
  have hMlog : 1+Real.log M ≤ 2*L := by
    by_cases hm : M=0
    · rw [hm,Nat.cast_zero,Real.log_zero]; dsimp [L]; linarith
    · have := Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero hm) hM₁
      dsimp [L]; linarith
  have hs : L^3 ≤ T^(1/2-y) := by
    simpa only [Real.norm_eq_abs,abs_of_pos (Real.rpow_pos_of_pos hT₀ _),one_mul,
      Real.rpow_ofNat,abs_of_nonneg (show 0 ≤ (Real.log T)^3 by positivity),L] using hslow
  have hpow : T^y*T^(1/2:ℝ)*T^(1/2-y)=T := by
    rw [← Real.rpow_add hT₀,← Real.rpow_add hT₀,show y+1/2+(1/2-y)=1 by ring,Real.rpow_one]
  apply he.trans
  dsimp only [B]; rw [hxl]
  apply (mul_le_mul (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hlog₀ hlog 2)
    (by positivity : 0 ≤ C*T^(1/2:ℝ))) (Real.rpow_pos_of_pos hT₀ _).le) hMlog
    (by positivity [Real.log_natCast_nonneg M]) (by positivity)).trans
  calc
    _ = (98*C*(T^y*T^(1/2:ℝ)))*L^3 := by ring
    _ ≤ _ := (mul_le_mul_of_nonneg_left hs (by positivity)).trans_eq (by rw [mul_assoc (98*C),hpow])

end ReflectedRemainder
end
end Src_ReflectedRemainder

section Src_ReflectedLinear

noncomputable section
open BHB BHB.Red PrincipalBand ReflectedGamma ReflectedExplicit ReflectedRemainder
open scoped ArithmeticFunction BigOperators Real

namespace ReflectedLinear

/-- A uniform estimate on finite rectangles controls both infinite sums. -/
private lemma series_difference (a b : ℕ → ℤ → ℂ) (ha : ∀ n, Summable (a n))
    (hb : ∀ n, Summable (b n)) (hs : Summable (fun n => ∑' j, a n j)) {D : ℝ}
    (he : ∀ (N : Finset ℕ) (J : Finset ℤ), ∑ n ∈ N, ∑ j ∈ J, ‖a n j-b n j‖ ≤ D) :
    ‖(∑' n, ∑' j, a n j)-(∑' n, ∑' j, b n j)‖ ≤ D := by
  let g := fun n j => ‖a n j-b n j‖
  have hu (n : ℕ) : Summable (g n) := summable_of_sum_le (fun _ => norm_nonneg _) (fun J => by
    simpa only [Finset.sum_singleton,g] using he {n} J)
  have hN (N : Finset ℕ) : (∑ n ∈ N, ∑' j, g n j) ≤ D := by
    rw [← Summable.tsum_finsetSum (fun n (_ : n ∈ N) => hu n)]
    apply Real.tsum_le_of_sum_le (fun _ => Finset.sum_nonneg (fun _ _ => norm_nonneg _))
    intro J
    rw [Finset.sum_comm]
    exact he N J
  let d := fun n => (∑' j, a n j)-(∑' j, b n j)
  have hd (n : ℕ) : ‖d n‖ ≤ ∑' j, g n j := by
    dsimp only [d]; rw [← (ha n).tsum_sub (hb n)]
    exact norm_tsum_le_tsum_norm (hu n)
  have hD (N : Finset ℕ) : (∑ n ∈ N, ‖d n‖) ≤ D :=
    (Finset.sum_le_sum (fun n _ => hd n)).trans (hN N)
  have hds := summable_of_sum_le (fun n => norm_nonneg (d n)) hD
  have hbs : Summable (fun n => ∑' j, b n j) := (hs.sub hds.of_norm).congr (fun n => by dsimp [d]; ring)
  rw [← hs.tsum_sub hbs]
  exact (norm_tsum_le_tsum_norm hds).trans (Real.tsum_le_of_sum_le (fun n => norm_nonneg (d n)) hD)

def linearRow (w : Weight) (T : ℝ) (k p : ℕ) := ∑' n : ℕ, (Λ n:ℂ)*
  ∑' j : ℤ, if j=0 then 0 else Lterm1 w T k (n*p) j

theorem row_error (w : Weight) {ε : ℝ} (hε : 0 < ε) (hε' : ε ≤ 1/2) :
    ∃ C T₀ : ℝ, 0 < C ∧ ∀ T ≥ T₀, ∀ k p : ℕ, 1 ≤ k → k ≤ p → (p:ℝ) ≤ T →
      2 ≤ (k:ℝ)*T/p → ‖otherModes w T k p-linearRow w T k p‖ ≤
      C/k*T^(-(1/2):ℝ)*(1+Real.log T)*((k:ℝ)*T/p)^(1+ε)*Real.log ((k:ℝ)*T/p) := by
  obtain ⟨C,T₁,hC,he⟩ := ReflectedPackets.linearization w hε hε'
  obtain ⟨T₂,h₂⟩ := Iterm1_eq_zero w
  refine ⟨C,max 1 (max T₁ T₂),hC,?_⟩
  intro T ht k p hk hkp hpT hS
  have ht₁ := (le_max_left ..).trans ht
  have ht₀ := zero_lt_one.trans_le ht₁
  have hp : 1 ≤ p := hk.trans hkp
  let a := fun (n : ℕ) (j : ℤ) => (Λ n:ℂ)*(if j=0 then 0 else Iterm1 w T k (n*p) j)
  let b := fun (n : ℕ) (j : ℤ) => (Λ n:ℂ)*(if j=0 then 0 else Lterm1 w T k (n*p) j)
  have ha (n : ℕ) : Summable (a n) := by
    rcases Nat.eq_zero_or_pos n with rfl|hn
    · simp [a]
    · exact (Lin1Aux.summable_ite_ne_zero (summable_Iterm1 w ht₁ hk (Nat.mul_pos hn hp))).mul_left _
  have hb (n : ℕ) : Summable (b n) := by
    rcases Nat.eq_zero_or_pos n with rfl|hn
    · simp [b]
    · exact (tsum_Lterm1 w ht₀ hk (Nat.mul_pos hn hp)).1.mul_left _
  have hs : Summable (fun n => ∑' j, a n j) := by
    apply summable_of_ne_finset_zero (s:=Finset.range (⌊4*(k:ℝ)*Xtr T⌋₊+1))
    intro n hn
    rw [Finset.mem_range,not_lt] at hn
    have hx : 4*(k:ℝ)*Xtr T < (n*p:ℕ) := lt_of_lt_of_le (Nat.lt_floor_add_one _)
      (by exact_mod_cast hn.trans (Nat.le_mul_of_pos_right n hp))
    simp [a,h₂ T ((le_max_right ..).trans ((le_max_right ..).trans ht)) k (n*p) hk hx]
  have hrect (N : Finset ℕ) (J : Finset ℤ) :
      (∑ n ∈ N, ∑ j ∈ J, ‖a n j-b n j‖) ≤ _ :=
    calc
      _ = ∑ n ∈ N, Λ n * ∑ j ∈ J.filter (fun j => j≠0), ‖Iterm1 w T k (n*p) j-Lterm1 w T k (n*p) j‖ := by
        apply Finset.sum_congr rfl
        intro n _
        rw [Finset.sum_filter,Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _
        by_cases hj : j=0
        · simp [a,b,hj]
        · simp only [a,b,if_neg hj,if_pos hj,← mul_sub,norm_mul,Complex.norm_real,Real.norm_eq_abs,
            abs_of_nonneg ArithmeticFunction.vonMangoldt_nonneg]
      _ ≤ _ := he T ((le_max_left ..).trans ((le_max_right ..).trans ht)) k p hk hkp hpT hS N _
        (fun j hj => (Finset.mem_filter.mp hj).2)
  simpa only [otherModes,linearRow,a,b,tsum_mul_left] using series_difference a b ha hb hs hrect


theorem linear_band (w : Weight) (F : ℝ → ℝ) {y l h : ℝ} (hy₀ : 0 ≤ y) (hy : y < 1/2)
    (hyl : y ≤ l) (hh : 0 < h) (hh₁ : h < 1) (hFb : ∀ u ∈ Set.Icc 0 y, |F u| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖sumRows F T y l h (otherModes w T)-sumRows F T y l h (linearRow w T)‖ ≤ C*T := by
  let ε := (1/2-y)/2
  have hε : 0 < ε := by dsimp [ε]; linarith
  have hε' : ε ≤ 1/2 := by dsimp [ε]; linarith
  obtain ⟨C,T₀,hC,hE⟩ := row_error w hε hε'
  refine ⟨4*C,by positivity,?_⟩
  have hslow := (isLittleO_log_rpow_rpow_atTop 3 hε).bound zero_lt_one
  filter_upwards [ReflectedLogBand.scales hh₁,Filter.eventually_ge_atTop T₀,hslow] with T hsc ht hslow
  obtain ⟨hL,hMX,_,hT₀⟩ := hsc
  let L := Real.log T
  let M := ⌊T^h⌋₊
  let B := 2*C*T^(1/2+ε)*L^2
  have hL₀ : 0 < L := by dsimp [L]; linarith
  have hT := (Real.log_nonneg_iff hT₀).mp hL₀.le
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hx : 2*T^h ≤ T := by
    rw [heightScale,Real.exp_log hT₀] at hMX
    have he := (le_div_iff₀ (by positivity)).mp hMX
    nlinarith only [he,mul_le_mul_of_nonneg_left Real.pi_gt_three.le (Real.rpow_pos_of_pos hT₀ h).le,
      (Real.rpow_pos_of_pos hT₀ h).le]
  have hMT : (M:ℝ) ≤ T := (Nat.floor_le (Real.rpow_pos_of_pos hT₀ h).le).trans (by linarith [Real.rpow_pos_of_pos hT₀ h])
  have hMlog : 1+Real.log M ≤ 2*L := by
    by_cases hm : M=0
    · rw [hm,Nat.cast_zero,Real.log_zero]; dsimp [L]; linarith
    · have := Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero hm) hMT; dsimp [L]; linarith
  have he := band_bound F hT₀ hL₀ hh hB hFb (fun k p => otherModes w T k p-linearRow w T k p) (l:=l) (by
    intro k hk p hp
    have hk₁ := (Finset.mem_Icc.mp hk).1
    have hk' : 1 ≤ (k:ℝ) := by exact_mod_cast hk₁
    have hk₀ := zero_lt_one.trans_le hk'
    have hkp := (distinct_label hT hyl hk hp).le
    have hp' : 0 < (p:ℝ) := by exact_mod_cast hk₁.trans hkp
    have hpM := (Nat.le_floor_iff (Real.exp_pos _).le).mp (Finset.mem_Ioc.mp (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).1).2
    rw [← Real.rpow_def_of_pos hT₀] at hpM
    have hS : 2 ≤ (k:ℝ)*T/p := (le_div_iff₀ hp').mpr (by
      nlinarith only [hx,hpM,mul_le_mul_of_nonneg_right hk' hT₀.le])
    let S := (k:ℝ)*T/p
    have hs₀ : 0 < S := by dsimp [S]; positivity
    have hsT : S ≤ T := (div_le_iff₀ hp').mpr (by
      have hh : (k:ℝ) ≤ p := by exact_mod_cast hkp
      nlinarith only [mul_le_mul_of_nonneg_right hh hT₀.le])
    have hlog := Real.log_le_log hs₀ hsT
    have hS₀ : 0 ≤ Real.log S := Real.log_nonneg (by dsimp only [S]; linarith)
    have hpT : (p:ℝ) ≤ T := by linarith
    have hz := hE T ht k p hk₁ hkp hpT hS
    change ‖_‖ ≤ C/k*T^(-(1/2):ℝ)*(1+L)*S^(1+ε)*Real.log S at hz
    have hSp : S^(1+ε) ≤ S*T^ε := by rw [Real.rpow_add hs₀,Real.rpow_one]; gcongr
    have hfac : T^(-(1/2):ℝ)*T*T^ε=T^(1/2+ε) := by
      calc
        _ = T^(-(1/2):ℝ)*T^(1:ℝ)*T^ε := by rw [Real.rpow_one]
        _ = _ := by rw [← Real.rpow_add hT₀,← Real.rpow_add hT₀]; congr 1; ring
    apply hz.trans
    apply (mul_le_mul (mul_le_mul (mul_le_mul_of_nonneg_left (show 1+L ≤ 2*L by dsimp [L]; linarith)
      (by positivity : 0 ≤ C/k*T^(-(1/2):ℝ))) hSp (by positivity) (by positivity)) hlog hS₀ (by positivity)).trans_eq
    dsimp only [B,S]; rw [← hfac]; field_simp; ring)
  have hdiff : sumRows F T y l h (otherModes w T)-sumRows F T y l h (linearRow w T)=
      sumRows F T y l h (fun k p => otherModes w T k p-linearRow w T k p) := by
    simp only [sumRows,mul_sub,Finset.sum_sub_distrib]
  rw [hdiff]
  apply he.trans
  have hs : L^3 ≤ T^ε := by
    simpa only [Real.norm_eq_abs,Real.rpow_ofNat,abs_of_nonneg (show 0 ≤ (Real.log T)^3 by positivity),
      abs_of_pos (Real.rpow_pos_of_pos hT₀ _),one_mul,L] using hslow
  have hpow : T^y*T^(1/2+ε)*T^ε=T := by
    rw [← Real.rpow_add hT₀,← Real.rpow_add hT₀,show y+(1/2+ε)+ε=1 by dsimp [ε]; ring,Real.rpow_one]
  apply (mul_le_mul_of_nonneg_left hMlog (by positivity : 0 ≤ T^y*B)).trans
  calc
    _ = (4*C*(T^y*T^(1/2+ε)))*L^3 := by dsimp [B]; ring
    _ ≤ _ := (mul_le_mul_of_nonneg_left hs (by positivity)).trans_eq (by rw [mul_assoc (4*C),hpow])


theorem zero_trace_linear (hRH : RiemannHypothesis) (w : Weight) (F : ℝ → ℝ)
    {y l h : ℝ} (hy₀ : 0 ≤ y) (hy : y < 1/2) (hyl : y ≤ l) (hh : 0 < h) (hh₁ : h < 1)
    (hFb : ∀ u ∈ Set.Icc 0 y, |F u| ≤ 1) : ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
    ‖-sumRows F T y l h (zeroRow w T)-(sumRows F T y l h (linearRow w T)-gammaPacket w F T y l h)‖ ≤
      C*T*Real.log T := by
  obtain ⟨A,hA,hst⟩ := ReflectedPoles.zero_band_error hRH w F hy hh hh₁ hFb (l:=l)
  obtain ⟨B,hB,hz⟩ := zero_mode_band w F hy hyl hh hh₁ hFb
  obtain ⟨D,hD,hd⟩ := linear_band w F hy₀ hy hyl hh hh₁ hFb
  refine ⟨A+B+D,by positivity,?_⟩
  filter_upwards [ReflectedLogBand.scales hh₁,hst,hz,hd] with T hsc ht hz hd
  have hsum : sumRows F T y l h (poissonRow w T)=sumRows F T y l h (zeroMode w T)+
      sumRows F T y l h (otherModes w T) := by
    simp only [sumRows,poissonRow,zeroMode,otherModes,mul_add,Finset.sum_add_distrib]
  let a := -sumRows F T y l h (zeroRow w T)-(sumRows F T y l h (poissonRow w T)-gammaPacket w F T y l h)
  let b := sumRows F T y l h (zeroMode w T)
  let d := sumRows F T y l h (otherModes w T)-sumRows F T y l h (linearRow w T)
  have he : -sumRows F T y l h (zeroRow w T)-(sumRows F T y l h (linearRow w T)-gammaPacket w F T y l h)=
      a+b+d := by dsimp only [a,b,d]; rw [hsum]; ring
  rw [he]
  have hT₀ := hsc.2.2.2
  apply ((norm_add_le (a+b) d).trans (add_le_add (norm_add_le a b) (le_refl ‖d‖))).trans
  apply (add_le_add (add_le_add ht hz) hd).trans
  nlinarith only [mul_le_mul_of_nonneg_left hsc.1 (mul_nonneg hB hT₀.le),
    mul_le_mul_of_nonneg_left hsc.1 (mul_nonneg hD hT₀.le)]

/-- The remaining arithmetic series after subtracting both signed principal
and logarithmic contributions from the nonzero linearized Poisson modes. -/
def remainder (w : Weight) (F : ℝ → ℝ) (T y l h : ℝ) :=
  sumRows F T y l h (linearRow w T)-
    (ReflectedMain.sidePacket w F T y l h 1+ReflectedMain.sidePacket w F T y l h (-1))

private lemma trace_taper (hRH : RiemannHypothesis) (w : Weight) {z c : ℝ}
    (hz : z ∈ Set.Icc (0:ℝ) 1) (hs : ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖ReflectedMain.signedPackets w (taper z) T theta (1/2) topExponent-
        ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*c:ℝ):ℂ)‖ ≤ C*T*Real.log T) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖-sumRows (taper z) T theta (1/2) topExponent (zeroRow w T)-
        remainder w (taper z) T theta (1/2) topExponent-
        ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*c:ℝ):ℂ)‖ ≤ C*T*Real.log T := by
  obtain ⟨A,hA,ha⟩ := hs
  obtain ⟨B,hB,hb⟩ := zero_trace_linear hRH w (taper z) (by norm_num [theta] : 0 ≤ theta)
    (by norm_num [theta]) (by norm_num [theta] : theta ≤ 1/2) (by norm_num [topExponent] : 0 < topExponent)
    (by norm_num [topExponent]) (taper_bound hz)
  refine ⟨B+A,by positivity,?_⟩
  filter_upwards [ha,hb] with T ha hb
  let a := ReflectedMain.signedPackets w (taper z) T theta (1/2) topExponent-
    ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*c:ℝ):ℂ)
  let b := -sumRows (taper z) T theta (1/2) topExponent (zeroRow w T)-
    (sumRows (taper z) T theta (1/2) topExponent (linearRow w T)-gammaPacket w (taper z) T theta (1/2) topExponent)
  have he : -sumRows (taper z) T theta (1/2) topExponent (zeroRow w T)-
      remainder w (taper z) T theta (1/2) topExponent-((T/(2*Real.pi)*w.kap1*(Real.log T)^2*c:ℝ):ℂ)=b+a := by
    dsimp only [a,b,remainder,ReflectedMain.signedPackets]; ring
  rw [he]
  exact (norm_add_le b a).trans ((add_le_add hb ha).trans_eq (by ring))

theorem trace_8539 (hRH : RiemannHypothesis) (w : Weight) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖-sumRows (taper (39/50)) T theta (1/2) topExponent (zeroRow w T)-
        remainder w (taper (39/50)) T theta (1/2) topExponent-
        ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*(-216739263388000063/5988006000000000000):ℝ):ℂ)‖ ≤ C*T*Real.log T :=
  trace_taper hRH w (by constructor <;> norm_num) (ReflectedMain.signed_packets_8539 hRH w)

theorem trace_8535 (hRH : RiemannHypothesis) (w : Weight) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖-sumRows (taper (1/2)) T theta (1/2) topExponent (zeroRow w T)-
        remainder w (taper (1/2)) T theta (1/2) topExponent-
        ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*(-26706611469780007/718560720000000000):ℝ):ℂ)‖ ≤ C*T*Real.log T :=
  trace_taper hRH w (by constructor <;> norm_num) (ReflectedMain.signed_packets_8535 hRH w)

end ReflectedLinear
end
end Src_ReflectedLinear

section Src_ReflectedArithmetic

noncomputable section
open BHB BHB.Red BHB.Arith PrincipalBand ReflectedExplicit ReflectedLinear
open scoped ArithmeticFunction BigOperators Real

namespace ReflectedArithmetic

private def W (w : Weight) (T : ℝ) (k p m : ℕ) := wtwo w.h T ((m:ℝ)*p/k)
private def coeff (k p n : ℕ) : ℂ := ((Λ n*Real.log ((n:ℝ)*p/k):ℝ):ℂ)

private lemma scale_decay (w : Weight) {T : ℝ} (hT : 0 < T) {k p : ℕ}
    (hk : 0 < k) (hp : 0 < p) : ∃ C : ℝ, 0 ≤ C ∧ ∀ m : ℕ, 0 < m → ‖W w T k p m‖ ≤ C/(m:ℝ)^4 := by
  obtain ⟨A,hA,h⟩ := w.h_decay' 4
  let a := 2*Real.pi*p/(k*T)
  have ha : 0 < a := by dsimp [a]; positivity
  refine ⟨2*A/a^4,by positivity,?_⟩
  intro m hm
  have hm₀ : 0 < (m:ℝ) := by exact_mod_cast hm
  have hz : 2*Real.pi*((m:ℝ)*p/k)/T=a*m := by dsimp [a]; ring
  have hs (s : ℝ) (he : |s|=a*m) : |w.h s| ≤ A/(a*m)^4 := by
    have he' := h s
    rw [he] at he'
    apply he'.trans
    apply div_le_div_of_nonneg_left hA (by positivity)
    gcongr
    linarith
  apply (Lin1Aux.norm_wtwo_le ..).trans
  rw [hz]
  have ham := mul_pos ha hm₀
  exact (add_le_add (hs _ (by rw [abs_neg,abs_of_pos ham])) (hs _ (abs_of_pos ham))).trans_eq (by ring)

private lemma summable_coeff (w : Weight) {T : ℝ} (hT : 0 < T) {k p : ℕ} (hk : 0 < k) (hp : 0 < p) :
    Summable (fun b : ℕ × ℕ => ‖coeff k p b.1‖*‖W w T k p ((b.2+1)*b.1)‖) := by
  obtain ⟨A,hA,hW⟩ := scale_decay w hT hk hp
  let C := 1+Real.log p+Real.log k
  have hC : 0 ≤ C := by dsimp [C]; positivity [Real.log_natCast_nonneg k,Real.log_natCast_nonneg p]
  have hf : Summable (fun n : ℕ => ((n:ℝ)^2)⁻¹) := Real.summable_nat_pow_inv.mpr (by norm_num)
  have hg : Summable (fun i : ℕ => (((i+1:ℕ):ℝ)^2)⁻¹) := (summable_nat_add_iff 1).mpr hf
  have hmaj := (hf.mul_of_nonneg hg (fun n => by positivity) (fun i => by positivity)).mul_left (C*A)
  apply Summable.of_nonneg_of_le (fun _ => by positivity) _ hmaj
  intro b
  obtain ⟨n,i⟩ := b
  dsimp
  rcases Nat.eq_zero_or_pos n with rfl|hn
  · simp [coeff]
  have hn' : 1 ≤ (n:ℝ) := by exact_mod_cast hn
  have hn₀ := zero_lt_one.trans_le hn'
  have hi : 1 ≤ ((i+1:ℕ):ℝ) := by exact_mod_cast Nat.succ_pos i
  have hcoef : ‖coeff k p n‖ ≤ (n:ℝ)^2*C := by
    rw [coeff,Complex.norm_real,Real.norm_eq_abs,abs_mul,abs_of_nonneg ArithmeticFunction.vonMangoldt_nonneg]
    have hz : |Real.log ((n:ℝ)*p/k)| ≤ (n:ℝ)*C := by
      have hs := Lin1Aux.abs_log_div_le (Nat.mul_pos hn hp) hk
      rw [Nat.cast_mul,Real.log_mul hn₀.ne' (by exact_mod_cast hp.ne')] at hs
      apply hs.trans
      dsimp only [C]
      nlinarith only [Real.log_le_self hn₀.le,mul_le_mul_of_nonneg_right hn' (Real.log_natCast_nonneg p),
        mul_le_mul_of_nonneg_right hn' (Real.log_natCast_nonneg k)]
    exact (mul_le_mul (ArithmeticFunction.vonMangoldt_le_log.trans (Real.log_le_self hn₀.le)) hz
      (abs_nonneg _) hn₀.le).trans_eq (by ring)
  have hw := hW _ (Nat.mul_pos (Nat.succ_pos i) hn)
  rw [Nat.cast_mul] at hw
  have hpow := pow_le_pow_right₀ hi (by norm_num : 2 ≤ 4)
  have hw' : ‖W w T k p ((i+1)*n)‖ ≤ A/(((i+1:ℕ):ℝ)^2*(n:ℝ)^4) := by
    rw [mul_pow] at hw
    apply hw.trans
    apply div_le_div_of_nonneg_left hA (by positivity)
    exact mul_le_mul_of_nonneg_right hpow (by positivity)
  exact (mul_le_mul hcoef hw' (norm_nonneg _) (by positivity)).trans_eq (by field_simp)

theorem divisor_row (w : Weight) {T : ℝ} (hT : 0 < T) {k p : ℕ} (hk : 0 < k) (hp : 0 < p) :
    linearRow w T k p=((1/(k:ℝ):ℝ):ℂ)*∑' m : ℕ,
      ((BHB.MT.kap2 m-Real.log ((k:ℝ)/p)*Real.log m:ℝ):ℂ)*wtwo w.h T ((m:ℝ)*p/k) := by
  have hc₀ : coeff k p 0=0 := by simp [coeff]
  have he := tsum_divisors_mul (c:=coeff k p) (W:=W w T k p) hc₀ (summable_coeff w hT hk hp)
  have hr (m : ℕ) : (∑ n ∈ m.divisors, coeff k p n)=((BHB.MT.kap2 m-Real.log ((k:ℝ)/p)*Real.log m:ℝ):ℂ) := by
    simpa only [coeff,← Complex.ofReal_sum] using congrArg Complex.ofReal (ReflectedPackets.linear_coefficient hk hp m)
  simp_rw [hr] at he
  change linearRow w T k p=_*∑' m : ℕ, _*W w T k p m
  rw [he,← tsum_mul_left]
  apply tsum_congr
  intro n
  rcases Nat.eq_zero_or_pos n with rfl|hn
  · simp [coeff]
  rw [(tsum_Lterm1 w hT hk (Nat.mul_pos hn hp)).2]
  have hx (i : ℕ) : (((i+1)*(n*p):ℕ):ℝ)/k=(((i+1)*n:ℕ):ℝ)*p/k := by push_cast; ring
  simp_rw [hx]
  unfold coeff W
  push_cast; ring


private def meanRow (H : ℝ → ℝ) (Y : ℝ) (k p : ℕ) :=
  ∑' m : ℕ, H (m/Y)*BHB.MT.kap2 m*rmean k (m*p)

def devRow (H : ℝ → ℝ) (Y : ℝ) (k p : ℕ) (s : ℤ) :=
  ∑' m : ℕ, ((H (m/Y)*BHB.MT.kap2 m:ℝ):ℂ)*cdev k s (m*p)

private def side (H : ℝ → ℝ) (Y : ℝ) (k p : ℕ) (s : ℤ) : ℂ :=
  (meanRow H Y k p:ℂ)+devRow H Y k p s-(Real.log ((k:ℝ)/p):ℂ)*
    ReflectedLog.twist H Y ((s:ℝ)*((p:ℝ)/k))

lemma weighted_G {H : ℝ → ℝ} (hH : Adm H) {Y : ℝ} (hY : 0 < Y)
    (a : ℕ → ℂ) {B : ℝ} (ha : ∀ n, ‖a n‖ ≤ B) :
    Summable (fun n : ℕ => ((H (n/Y)*BHB.MT.kap2 n:ℝ):ℂ)*a n) := by
  obtain ⟨A,hA,h⟩ := PrincipalSmoothing.scaled_decay hY (hH.decay 4)
  have hs := (summable_nat_add_iff 1).mpr (Real.summable_one_div_nat_pow.mpr (by norm_num : 1 < 2))
  have he : Summable (fun n : ℕ => (A*B)/(1+(n:ℝ))^2) := by
    simpa only [Nat.cast_add,Nat.cast_one,add_comm (1:ℝ),mul_one_div] using hs.mul_left (A*B)
  apply Summable.of_norm_bounded he
  intro n
  have hg := PrincipalSmoothing.decay_product (j:=2) (by positivity : 0 < 1+(n:ℝ)) hA
    (h n (Nat.cast_nonneg _)) (B:=1) (by simpa using BHB.MT.abs_kap2_le n)
  rw [norm_mul,Complex.norm_real,Real.norm_eq_abs]
  exact (mul_le_mul hg (ha n) (norm_nonneg _) (by positivity)).trans_eq (by ring)

private lemma side_sum {H : ℝ → ℝ} (hH : Adm H) {Y : ℝ} (hY : 1 ≤ Y) (k p : ℕ) (s : ℤ) :
    HasSum (fun n : ℕ => ((H (n/Y)*(BHB.MT.kap2 n-Real.log ((k:ℝ)/p)*Real.log n):ℝ):ℂ)*
      BHB.e ((s:ℝ)*(n*p:ℕ)/k)) (side H Y k p s) := by
  have hY₀ := zero_lt_one.trans_le hY
  let mean := fun n : ℕ => (rmean k (n*p):ℂ)
  let dev := fun n : ℕ => cdev k s (n*p)
  have hm := weighted_G hH hY₀ mean (B:=1) (fun n => by
    simpa only [mean,Complex.norm_real,Real.norm_eq_abs] using Reduce.abs_rmean_le_one k (n*p))
  have hd := weighted_G hH hY₀ dev (B:=2) (fun n => Reduce.norm_cdev_le k s (n*p))
  have hl := ReflectedLog.twist_summable hH hY ((s:ℝ)*((p:ℝ)/k))
  have hem : (∑' n : ℕ, ((H (n/Y)*BHB.MT.kap2 n:ℝ):ℂ)*mean n)=(meanRow H Y k p:ℂ) := by
    unfold meanRow
    rw [Complex.ofReal_tsum]; apply tsum_congr; intro n; simp only [mean,Complex.ofReal_mul]
  have hs := (hm.hasSum.add hd.hasSum).sub (hl.hasSum.mul_left (Real.log ((k:ℝ)/p):ℂ))
  rw [hem] at hs
  apply hs.congr_fun
  intro n
  dsimp only [dev,mean]
  rw [cdev,Complex.real_smul]
  have he : (n:ℝ)*((s:ℝ)*((p:ℝ)/k))=(s:ℝ)*(n*p:ℕ)/k := by push_cast; ring
  rw [he]; push_cast; ring

private lemma row_split (w : Weight) {T : ℝ} (hT : 0 < T) {k p : ℕ} (hk : 0 < k) (hp : 0 < p)
    {Y : ℝ} (hY : Y=(k:ℝ)*T/(2*Real.pi*p)) (hY₁ : 1 ≤ Y) :
    linearRow w T k p=((1/(k:ℝ):ℝ):ℂ)*
      (side (hside w.h 1) Y k p 1+side (hside w.h (-1)) Y k p (-1)) := by
  rw [divisor_row w hT hk hp]
  congr 1
  have ha := side_sum (adm_hside w (Or.inl rfl)) hY₁ k p 1
  have hb := side_sum (adm_hside w (Or.inr rfl)) hY₁ k p (-1)
  apply ((ha.add hb).congr_fun _).tsum_eq
  intro n
  have hx : (n:ℝ)/Y=2*Real.pi*((n:ℝ)*p/k)/T := by rw [hY]; field_simp
  simp only [hside,Int.cast_one,Int.cast_neg,one_mul,neg_one_mul,hx,Nat.cast_mul,wtwo]
  rw [show -((n:ℝ)*p)/k= -((n:ℝ)*p/k) by ring]
  push_cast; ring


def Y (T : ℝ) (k p : ℕ) := (k:ℝ)*heightScale (Real.log T)/p

/-- Both signs of the genuinely nonprincipal divisor sum. The character
argument is n*p. Its scale k*T/(2πp) varies with both outer indices. -/
def nonprincipal (w : Weight) (F : ℝ → ℝ) (T y l h : ℝ) :=
  sumRows F T y l h (fun k p => ((1/(k:ℝ):ℝ):ℂ)*(devRow (hside w.h 1) (Y T k p) k p 1+
    devRow (hside w.h (-1)) (Y T k p) k p (-1)))

private lemma side_packet_rows (w : Weight) (F : ℝ → ℝ) {T : ℝ} (hT : 0 < T) (y l h : ℝ) (s : ℤ) :
    ReflectedMain.sidePacket w F T y l h s=sumRows F T y l h (fun k p => ((1/(k:ℝ):ℝ):ℂ)*
      (side (hside w.h s) (Y T k p) k p s-devRow (hside w.h s) (Y T k p) k p s)) := by
  have hr : ReflectedPrincipal.below (Real.exp (Real.log T*y))=Krange y T := by
    rw [← Real.rpow_def_of_pos hT]
    exact (Finset.Icc_succ_left_eq_Ioc ..).symm
  unfold ReflectedMain.sidePacket principalPacket ReflectedLogBand.logPacket sumRows
  rw [hr]
  push_cast
  simp only [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k _
  apply Finset.sum_congr rfl
  intro p _
  unfold side
  simp only [Y,meanRow,Complex.real_smul,Complex.ofReal_mul,Complex.ofReal_div,Complex.ofReal_neg]
  push_cast
  ring

theorem remainder_eq (w : Weight) (F : ℝ → ℝ) (y l : ℝ) {h : ℝ} (hh₁ : h < 1) :
    ∀ᶠ T : ℝ in Filter.atTop, remainder w F T y l h=nonprincipal w F T y l h := by
  filter_upwards [ReflectedLogBand.scales hh₁] with T hsc
  obtain ⟨_,hX,_,hT₀⟩ := hsc
  unfold remainder nonprincipal
  rw [side_packet_rows w F hT₀,side_packet_rows w F hT₀]
  simp only [sumRows,← Finset.sum_add_distrib,← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro k hk
  apply Finset.sum_congr rfl
  intro p hp
  have hk₁ := (Finset.mem_Icc.mp hk).1
  obtain ⟨hm,hpr⟩ := Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1
  have hp₀ : 0 < (p:ℝ) := by exact_mod_cast hpr.pos
  have hpX := (Nat.le_floor_iff (Real.exp_pos _).le).mp (Finset.mem_Ioc.mp hm).2
  rw [← Real.rpow_def_of_pos hT₀] at hpX
  have hY : Y T k p=(k:ℝ)*T/(2*Real.pi*p) := by
    unfold Y heightScale; rw [Real.exp_log hT₀]; ring
  have hY₁ : 1 ≤ Y T k p := by
    apply (one_le_div hp₀).mpr
    have hk' : (1:ℝ) ≤ k := by exact_mod_cast hk₁
    exact (hpX.trans hX).trans (le_mul_of_one_le_left (by dsimp [heightScale]; positivity) hk')
  rw [row_split w hT₀ hk₁ hpr.pos hY hY₁]; ring

theorem high_trace_8539 (hRH : RiemannHypothesis) (w : Weight) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖-sumRows (taper (39/50)) T theta (1/2) topExponent (zeroRow w T)-
        nonprincipal w (taper (39/50)) T theta (1/2) topExponent-
        ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*(-216739263388000063/5988006000000000000):ℝ):ℂ)‖ ≤ C*T*Real.log T := by
  obtain ⟨C,hC,he⟩ := trace_8539 hRH w
  refine ⟨C,hC,?_⟩
  filter_upwards [he,remainder_eq w (taper (39/50)) theta (1/2) (by norm_num [topExponent] : topExponent < 1)] with T ht hr
  rwa [← hr]

theorem high_trace_8535 (hRH : RiemannHypothesis) (w : Weight) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      ‖-sumRows (taper (1/2)) T theta (1/2) topExponent (zeroRow w T)-
        nonprincipal w (taper (1/2)) T theta (1/2) topExponent-
        ((T/(2*Real.pi)*w.kap1*(Real.log T)^2*(-26706611469780007/718560720000000000):ℝ):ℂ)‖ ≤ C*T*Real.log T := by
  obtain ⟨C,hC,he⟩ := trace_8535 hRH w
  refine ⟨C,hC,?_⟩
  filter_upwards [he,remainder_eq w (taper (1/2)) theta (1/2) (by norm_num [topExponent] : topExponent < 1)] with T ht hr
  rwa [← hr]

end ReflectedArithmetic
end
end Src_ReflectedArithmetic

section Src_ReflectedConvolution

noncomputable section
open BHB BHB.Arith PrincipalBand ReflectedExplicit ReflectedArithmetic
open scoped BigOperators

namespace ReflectedConvolution

private def spread (p : ℕ) (a : ℕ → ℝ) (u : ℕ) := if p ∣ u then a (u/p) else 0
private def mask (q : Finset ℕ) (z : ℕ → ℝ) (p : ℕ) := if p ∈ q then z p else 0

private lemma coeff_sum (q : Finset ℕ) (z a : ℕ → ℝ) (ha : a 0=0) (u : ℕ) :
    dconv (mask q z) a u = ∑ p ∈ q, z p*spread p a u := by
  classical
  rcases Nat.eq_zero_or_pos u with rfl|hu
  · simp [dconv,spread,ha]
  rw [Asm.dconv_eq_sum_divisors']
  have he : u.divisors.filter (fun p => p ∈ q)=q.filter (fun p => p ∣ u) := by
    ext p; simp [Nat.mem_divisors,hu.ne',and_comm]
  simp only [mask,spread,ite_mul,mul_ite,zero_mul,mul_zero,← Finset.sum_filter,he]

private lemma spread_sum (a : ℕ → ℝ) (f : ℕ → ℂ) {p : ℕ} (hp : 0 < p) {S : ℂ}
    (ha : HasSum (fun m : ℕ => (a m:ℂ)*f (m*p)) S) :
    HasSum (fun u : ℕ => (spread p a u:ℂ)*f u) S := by
  have hi : Function.Injective (fun m : ℕ => m*p) := fun _ _ he => Nat.eq_of_mul_eq_mul_right hp he
  apply (hi.hasSum_iff (fun u hu => ?_)).mp
  · apply ha.congr_fun
    intro m
    simp [Function.comp_def,spread,Nat.mul_div_cancel _ hp]
  · have hd : ¬p ∣ u := by
      rintro ⟨m,rfl⟩
      exact hu ⟨m,Nat.mul_comm ..⟩
    simp [spread,hd]

/-- Group all prime labels before estimating the signed character deviations. -/
theorem convolution_sum (q : Finset ℕ) (z a : ℕ → ℝ) (f : ℕ → ℂ) (S : ℕ → ℂ)
    (ha : a 0=0) (hq : ∀ p ∈ q, 0 < p)
    (hs : ∀ p ∈ q, HasSum (fun m : ℕ => (a m:ℂ)*f (m*p)) (S p)) :
    HasSum (fun u : ℕ => (dconv (mask q z) a u:ℂ)*f u) (∑ p ∈ q, (z p:ℂ)*S p) := by
  have he := hasSum_sum (fun p (hp : p ∈ q) => (spread_sum a f (hq p hp) (hs p hp)).mul_left (z p:ℂ))
  apply he.congr_fun
  intro u
  rw [coeff_sum q z a ha,Complex.ofReal_sum,Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro p _; push_cast; ring

theorem band_mask {T : ℝ} (hT : 0 < T) (h : ℝ) :
    mask (band (Real.log T) (1/2) h) (label h (Real.log T))=HighPrime.reflectedBand h T := by
  funext p
  have he (v : ℝ) : Real.exp (Real.log T*v)=T^v := (Real.rpow_def_of_pos hT v).symm
  have hpw (v : ℝ) : p ∈ PrimeLabelPrefix.primesAt (Real.log T) v ↔ p.Prime ∧ (p:ℝ) ≤ T^v := by
    simp only [PrimeLabelPrefix.primesAt,ReflectedPrincipal.below,Finset.mem_filter,Finset.mem_Ioc,he,
      Nat.le_floor_iff (Real.rpow_pos_of_pos hT _).le]
    exact ⟨fun h => ⟨h.2,h.1.2⟩,fun h => ⟨⟨h.1.pos,h.2⟩,h.1⟩⟩
  have hb : p ∈ band (Real.log T) (1/2) h ↔ p.Prime ∧ Real.sqrt T < (p:ℝ) ∧ (p:ℝ) ≤ T^h := by
    rw [band,Finset.mem_sdiff,hpw,hpw,Real.sqrt_eq_rpow]
    constructor
    · rintro ⟨⟨hpr,hhi⟩,hlo⟩
      exact ⟨hpr,lt_of_not_ge (fun hle => hlo ⟨hpr,hle⟩),hhi⟩
    · rintro ⟨hpr,hlo,hhi⟩
      exact ⟨⟨hpr,hhi⟩,fun he => hlo.not_ge he.2⟩
  unfold mask HighPrime.reflectedBand
  by_cases hm : p ∈ band (Real.log T) (1/2) h
  · rw [if_pos hm,if_pos (hb.mp hm)]; unfold label; ring
  · rw [if_neg hm,if_neg (fun he => hm (hb.mpr he))]

private lemma dev_rows (w : Weight) {T : ℝ} (hT : 0 < T) {k : ℕ} (hk : 0 < k) (h : ℝ) (s : ℤ)
    (hs : s=1 ∨ s= -1) :
    ∑ p ∈ band (Real.log T) (1/2) h, (label h (Real.log T) p:ℂ)*
      devRow (hside w.h s) (Y T k p) k p s =
      Dev w.h T (dconv (HighPrime.reflectedBand h T) BHB.MT.kap2) k s := by
  let q := band (Real.log T) (1/2) h
  let f := fun u : ℕ => cdev k s u*(w.h ((s:ℝ)*(2*Real.pi*((u:ℝ)/k)/T)):ℂ)
  let S := fun p => devRow (hside w.h s) (Y T k p) k p s
  have hq (p : ℕ) (hp : p ∈ q) := (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).2.pos
  have hx : heightScale (Real.log T)=T/(2*Real.pi) := by rw [heightScale,Real.exp_log hT]
  have hS (p : ℕ) (hp : p ∈ q) : HasSum (fun m : ℕ => (BHB.MT.kap2 m:ℂ)*f (m*p)) (S p) := by
    have hp₀ : (0:ℝ) < p := by exact_mod_cast hq p hp
    have hk₀ : (0:ℝ) < k := by exact_mod_cast hk
    have hY : 0 < Y T k p := by dsimp [Y]; rw [hx]; positivity
    have hz := (weighted_G (adm_hside w hs) hY (fun n => cdev k s (n*p)) (fun n => Reduce.norm_cdev_le k s (n*p))).hasSum
    apply hz.congr_fun
    intro m
    have he : (m:ℝ)/Y T k p=2*Real.pi*(((m*p:ℕ):ℝ)/k)/T := by
      unfold Y; rw [hx]; push_cast; field_simp
    simp only [hside,he,Complex.ofReal_mul,f]; ring
  have he := (convolution_sum q (label h (Real.log T)) BHB.MT.kap2 f S (by simp [BHB.MT.kap2]) hq hS).tsum_eq
  dsimp only [q] at he
  rw [band_mask hT] at he
  exact he.symm

/-- The board's original nonprincipal-character mean, now for one explicit
Dirichlet convolution and multiplied by the actual mollifier. -/
theorem nonprincipal_eq (w : Weight) (F : ℝ → ℝ) {T : ℝ} (hT : 0 < T) (y h : ℝ) :
    nonprincipal w F T y (1/2) h =
      ∑ k ∈ Krange y T, ((mollifier F (Real.log T) k/k:ℝ):ℂ)*
        (Dev w.h T (dconv (HighPrime.reflectedBand h T) BHB.MT.kap2) k 1+
        Dev w.h T (dconv (HighPrime.reflectedBand h T) BHB.MT.kap2) k (-1)) := by
  unfold nonprincipal sumRows
  apply Finset.sum_congr rfl
  intro k hk
  have hk₁ := (Finset.mem_Icc.mp hk).1
  rw [← dev_rows w hT hk₁ h 1 (Or.inl rfl),← dev_rows w hT hk₁ h (-1) (Or.inr rfl),
    ← Finset.sum_add_distrib,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro p _
  push_cast; ring

theorem norm_nonprincipal_le (w : Weight) (F : ℝ → ℝ) {T : ℝ} (hT : 1 < T) (y h : ℝ)
    (hFb : ∀ v ∈ Set.Icc 0 y, |F v| ≤ 1) :
    ‖nonprincipal w F T y (1/2) h‖ ≤ DevSum w.h y T (dconv (HighPrime.reflectedBand h T) BHB.MT.kap2) 1+
      DevSum w.h y T (dconv (HighPrime.reflectedBand h T) BHB.MT.kap2) (-1) := by
  have hT₀ := zero_lt_one.trans hT
  rw [nonprincipal_eq w F hT₀]
  unfold DevSum
  rw [← Finset.sum_add_distrib]
  apply (norm_sum_le ..).trans
  apply Finset.sum_le_sum
  intro k hk
  have hk₁ := (Finset.mem_Icc.mp hk).1
  have hkm : k ∈ ReflectedPrincipal.below (Real.exp (Real.log T*y)) :=
    Finset.mem_Ioc.mpr ⟨hk₁,by rw [← Real.rpow_def_of_pos hT₀]; exact (Finset.mem_Icc.mp hk).2⟩
  have hm : |mollifier F (Real.log T) k| ≤ 1 := by
    rw [mollifier,abs_mul]
    exact mul_le_one₀ (by exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n:=k))
      (abs_nonneg _) (hFb _ (ReflectedLogBand.log_mem (Real.log_pos hT) hkm))
  rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_div,abs_of_nonneg (Nat.cast_nonneg (α:=ℝ) k),← mul_add]
  exact mul_le_mul (div_le_div_of_nonneg_right hm (Nat.cast_nonneg _)) (norm_add_le ..) (norm_nonneg _) (by positivity)


/-- A prime label above sqrt(T) divides neither of the factors in g*r.
Consequently the board's gcd decomposition has only its unit divisor. -/
theorem reduce_coeff (T h : ℝ) {g r : ℕ} (hg : 0 < g) (hr : 0 < r)
    (hgr : ((g*r:ℕ):ℝ) ≤ Real.sqrt T) :
    rd (dconv (HighPrime.reflectedBand h T) BHB.MT.kap2) g r =
      dconv (HighPrime.reflectedBand h T) (rd BHB.MT.kap2 g r) := by
  let a := HighPrime.reflectedBand h T
  have hsupport (p : ℕ) (hp : a p ≠ 0) : p.Prime ∧ Real.sqrt T < p := by
    by_contra hn
    apply hp
    unfold a HighPrime.reflectedBand
    rw [if_neg (fun he => hn ⟨he.1,he.2.1⟩)]
  have hunit : rd a 1 (r*g)=a := by
    funext p
    unfold rd
    rw [one_mul]
    by_cases he : a p=0
    · simp [he]
    have hs := hsupport p he
    have hlt : r*g < p := by exact_mod_cast (show ((r*g:ℕ):ℝ) < p by simpa [Nat.mul_comm] using hgr.trans_lt hs.2)
    have hc := hs.1.coprime_iff_not_dvd.mpr (fun hd => hlt.not_ge (Nat.le_of_dvd (Nat.mul_pos hr hg) hd))
    rw [if_pos hc]
  have hz (d : ℕ) (hd : d ∈ g.divisors) (hd' : d≠1) (v : ℕ) : rd a d (r*(g/d)) v=0 := by
    have ha : a (d*v)=0 := by
      by_contra hn
      have hs := hsupport (d*v) hn
      have he := ((Nat.dvd_prime hs.1).mp (dvd_mul_right d v)).resolve_left hd'
      have hle : d ≤ g*r := (Nat.divisor_le hd).trans (Nat.le_mul_of_pos_right g hr)
      have hlt : g*r < d*v := by exact_mod_cast hgr.trans_lt hs.2
      omega
    simp [rd,ha]
  rw [rd_dconv a BHB.MT.kap2 hg r]
  funext m
  change (∑ d ∈ g.divisors, dconv (rd a d (r*(g/d))) (rd BHB.MT.kap2 (g/d) r) m)=_
  rw [Finset.sum_eq_single 1]
  · rw [Nat.div_one,hunit]
  · intro d hd hd'
    unfold dconv
    simp only [hz d hd hd',zero_mul,Finset.sum_const_zero]
  · intro hn
    exact (hn (Nat.one_mem_divisors.mpr hg.ne')).elim

theorem large_conductors {y h : ℝ} (hy : 0 < y) (hy' : y < 1/2) (hh : 0 < h)
    (hband : h ≤ 1-3*eps y) {H : ℝ → ℝ} (hH : Adm H) : ∃ (C : ℝ) (c : ℕ), 0 < C ∧
      ∀ᶠ T : ℝ in Filter.atTop, LCU y H T (dconv (HighPrime.reflectedBand h T) BHB.MT.kap2)
        (C*Real.log T^c) := by
  obtain ⟨C,T₀,c,hC,he⟩ := HighPrime.reflected_large_conductor hy hy' hh hband H hH
  refine ⟨4*C,c+2,by positivity,?_⟩
  filter_upwards [Filter.eventually_ge_atTop T₀,Filter.eventually_ge_atTop (Real.exp 1)] with T ht ht₁
  have hT₀ := (Real.exp_pos _).trans_le ht₁
  have hL := (Real.le_log_iff_exp_le hT₀).mpr ht₁
  have hT : 1 ≤ T := (Real.log_nonneg_iff hT₀).mp (by linarith)
  intro g r Q hg hr hQ hcap
  have hgr : ((g*r:ℕ):ℝ) ≤ Real.sqrt T := by
    apply (show ((g*r:ℕ):ℝ) ≤ (g*r*Q:ℕ) by exact_mod_cast Nat.le_mul_of_pos_right (g*r) hQ).trans
    rw [Real.sqrt_eq_rpow]
    exact hcap.trans (Real.rpow_le_rpow_of_exponent_le hT hy'.le)
  rw [reduce_coeff T h hg hr hgr]
  have hraw := he T ht g r hg r Q hr hQ hcap
  have hgn := (Nat.le_mul_of_pos_right g hr).trans (Nat.le_mul_of_pos_right (g*r) hQ)
  have hgT : (g:ℝ) ≤ T := (show (g:ℝ) ≤ (g*r*Q:ℕ) by exact_mod_cast hgn).trans
      (hcap.trans ((Real.rpow_le_rpow_of_exponent_le hT (by linarith : y ≤ 1)).trans_eq (Real.rpow_one T)))
  have hglog := Real.log_le_log (by exact_mod_cast hg) hgT
  have hfac : (1+Real.log g)^2 ≤ (2*Real.log T)^2 :=
    pow_le_pow_left₀ (by positivity [Real.log_natCast_nonneg g]) (by linarith) _
  have hw : 1 ≤ wt g r := one_le_mul_of_one_le_of_one_le
    (one_le_pow₀ (one_le_dtau (by norm_num : 1 ≤ 2) (Nat.ne_of_gt hg))) (one_le_pow₀ (one_le_dtau (by norm_num : 1 ≤ 2) (Nat.ne_of_gt hr)))
  have h₁ : C*(1+Real.log g)^2*Real.log T^c ≤ 4*C*Real.log T^(c+2) :=
    (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hfac hC.le) (by positivity)).trans_eq (by rw [pow_add]; ring)
  have h₂ := h₁.trans (le_mul_of_one_le_right (by positivity) hw)
  apply hraw.trans
  exact (mul_le_mul_of_nonneg_right h₂ (by positivity)).trans_eq (by ring)

end ReflectedConvolution
end
end Src_ReflectedConvolution

section Src_ReflectedInput


noncomputable section
open LowBand ShortProbe.RealResidual

namespace ReflectedInput

def lowCoefficient : ℝ := 28704186654843603105910014354610232114440781/2395202400000000000000000000000000000000000000

theorem low_coefficient :
    (106/25)*lowConst taper78 (fun x => (1-x/0.999)/0.999) lengthExponent lengthExponent-
      lowConst taper78 (fun x => 1-x/5-9*x^2/20) lengthExponent lengthExponent=lowCoefficient := by
  rw [lowConst_W,lowConst_U]; norm_num [lowCoefficient]

private lemma mixed_re (a w u : ℂ) :
    (a*(starRingEnd ℂ) ((106/25:ℂ)*w-u)).re =
    (106/25)*(a*(starRingEnd ℂ) w).re-(a*(starRingEnd ℂ) u).re := by
  have he (r : ℝ) : (a*(starRingEnd ℂ) ((r:ℂ)*w-u)).re=
      r*(a*(starRingEnd ℂ) w).re-(a*(starRingEnd ℂ) u).re := by
    rw [map_sub,map_mul,Complex.conj_ofReal,mul_sub,mul_left_comm a,Complex.sub_re]
    simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]
  simpa only [Complex.ofReal_div,Complex.ofReal_ofNat] using he (106/25)

/-- The covered-prime part of the exact mixed moment in the 85.39% candidate.
Both prime polynomials extend to the mollifier cutoff T^0.4999999. -/
theorem mixed_low (hRH : RiemannHypothesis) (w : BHB.Weight) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ T : ℝ in Filter.atTop, ∃ v : ℝ,
      HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z *
        (mollified T z*(starRingEnd ℂ) ((106/25:ℂ)*probeLow 0.999 lengthExponent T z-shortPrimes T z)).re) v ∧
      |v-w.kap1*lowCoefficient*TMA.Dsc T| ≤ ε*TMA.Dsc T := by
  let δ := ε/(106/25+1)
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hθ : 0 < lengthExponent := by norm_num [lengthExponent]
  have hθ' : lengthExponent < 1/2 := by norm_num [lengthExponent]
  have hP : ContDiff ℝ 1 taper78 := by unfold taper78; fun_prop
  let W : ℝ → ℝ := fun x => (1-x/0.999)/0.999
  let U : ℝ → ℝ := fun x => 1-x/5-9*x^2/20
  have hw := lowband_cross hRH w hP (f:=W) (by dsimp [W]; fun_prop) hθ hθ' hθ hθ' hδ
  have hu := lowband_cross hRH w hP (f:=U) (by dsimp [U]; fun_prop) hθ hθ' hθ hθ' hδ
  filter_upwards [hw,hu] with T hw hu
  obtain ⟨v,hv,hw⟩ := hw
  obtain ⟨u,hu',hu⟩ := hu
  let a : ℝ := 106/25
  have ha : 0 ≤ a := by norm_num [a]
  refine ⟨a*v-u,((hv.mul_left a).sub hu').congr_fun ?_,?_⟩
  · intro z
    rw [mixed_re]
    change _=a*(TMA.cw w.h T z*(molP taper78 lengthExponent T z*(starRingEnd ℂ) (primePoly W lengthExponent T z)).re)-
      TMA.cw w.h T z*(molP taper78 lengthExponent T z*(starRingEnd ℂ) (primePoly U lengthExponent T z)).re
    rw [molP_taper78]
    change _=a*(TMA.cw w.h T z*(mollified T z*(starRingEnd ℂ) (probeLow 0.999 lengthExponent T z)).re)-
      TMA.cw w.h T z*(mollified T z*(starRingEnd ℂ) (shortPrimes T z)).re
    dsimp only [a]; ring
  · let Wc := lowConst taper78 W lengthExponent lengthExponent
    let Uc := lowConst taper78 U lengthExponent lengthExponent
    have hc : a*Wc-Uc=lowCoefficient := low_coefficient
    rw [← hc,show a*v-u-w.kap1*(a*Wc-Uc)*TMA.Dsc T=
      a*(v-w.kap1*Wc*TMA.Dsc T)-(u-w.kap1*Uc*TMA.Dsc T) by ring]
    apply (abs_sub ..).trans
    rw [abs_mul,abs_of_nonneg ha]
    exact (add_le_add (mul_le_mul_of_nonneg_left hw ha) hu).trans_eq (by dsimp [δ,a]; ring)

/-- Exact arithmetic for the two disjoint covered ranges. The thin intervening
strip and the outstanding high-band error are retained by the trace theorem. -/
theorem covered_coefficients :
    lowCoefficient+(106/25)*(-216739263388000063/5988006000000000000)=
      (-338885604051204503742089985645389767885559219/2395202400000000000000000000000000000000000000:ℝ) ∧
    lowCoefficient+(106/25)*(-216739263388000063/5988006000000000000)+92/1000000 < -141393/1000000 := by
  constructor <;> norm_num [lowCoefficient]

end ReflectedInput
end
end Src_ReflectedInput

section Src_ReflectedSmallGlobal

noncomputable section
open BHB BHB.Arith ReflectedSmall ReflectedConvolution PrincipalBand
open scoped BigOperators Real

namespace ReflectedSmallGlobal

private def block (H : ℝ → ℝ) {q : ℕ} (χ : DirichletCharacter ℂ q) (g r : ℕ)
    (D S : ℝ) (a b j : ℕ) : ℂ :=
  (rd BHB.MT.kap2 g r j:ℂ)*χ (j:ZMod q)*
    ∑ p ∈ Finset.Ioc a b, ((1-Real.log p/D)*H ((j:ℝ)/S*p)) • primeTwist χ p

private lemma add_block (H : ℝ → ℝ) {q : ℕ} (χ : DirichletCharacter ℂ q) (g r : ℕ)
    (D S : ℝ) {a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c) (j : ℕ) :
    block H χ g r D S a c j=block H χ g r D S a b j+block H χ g r D S b c j := by
  unfold block
  rw [← Finset.Ioc_union_Ioc_eq_Ioc hab hbc,Finset.sum_union (Finset.Ioc_disjoint_Ioc_of_le le_rfl),mul_add]

/-- Bound a sharp prime interval by at most log₂ U+1 dyadic blocks. The two
sums over j are combined only after proving absolute convergence. -/
private lemma blocks (H : ℝ → ℝ) {q : ℕ} (χ : DirichletCharacter ℂ q) (g r : ℕ)
    (D S : ℝ) {b U : ℕ} (hb : 0 < b) {E : ℝ} (hE : 0 ≤ E)
    (he : ∀ a u : ℕ, b ≤ a → a < u → u ≤ U → u ≤ 2*a →
      Summable (block H χ g r D S a u) ∧ ‖∑' j, block H χ g r D S a u j‖ ≤ E) :
    Summable (block H χ g r D S b U) ∧ ‖∑' j, block H χ g r D S b U j‖ ≤ (Nat.log 2 U+1:ℕ)*E := by
  have empty {x : ℕ} (hx : x ≤ b) : block H χ g r D S b x=0 := by
    funext j; simp [block,Finset.Ioc_eq_empty_of_le hx]
  have hi (n x : ℕ) (hx : x ≤ U) (hn : x ≤ 2^n*b) :
      Summable (block H χ g r D S b x) ∧ ‖∑' j, block H χ g r D S b x j‖ ≤ (n:ℝ)*E := by
    induction n generalizing x with
    | zero =>
      rw [empty (by simpa using hn)]
      exact ⟨summable_zero,by simp⟩
    | succ n ih =>
      let a := 2^n*b
      by_cases hh : x ≤ a
      · obtain ⟨hs,hh'⟩ := ih x hx hh
        exact ⟨hs,hh'.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast Nat.le_succ n) hE)⟩
      have hax := lt_of_not_ge hh
      have hba : b ≤ a := by
        dsimp [a]; exact Nat.le_mul_of_pos_left b (by positivity)
      have hxn : x ≤ 2*a := by simpa only [a,pow_succ,mul_assoc,mul_left_comm,mul_comm] using hn
      obtain ⟨ha,ha'⟩ := ih a (hax.le.trans hx) le_rfl
      obtain ⟨hc,hc'⟩ := he a x hba hax hx hxn
      have hf := (ha.hasSum.add hc.hasSum).congr_fun (fun j => add_block H χ g r D S hba hax.le j)
      exact ⟨hf.summable,hf.tsum_eq ▸ (norm_add_le ..).trans ((add_le_add ha' hc').trans_eq (by push_cast; ring))⟩
  exact hi (Nat.log 2 U+1) U le_rfl ((Nat.lt_pow_succ_log_self (by decide : 1 < 2) U).le.trans
    (Nat.le_mul_of_pos_right _ hb))

/-- Exact physical character sum for the full prime interval, including the
factor 1/(h log T) in the board taper. -/
theorem twisted_window {H : ℝ → ℝ} (hH : Adm H) {T h S : ℝ} (hT : 1 < T) (hh : 0 < h)
    (hS : 0 < S) {g r q : ℕ} (hg : 0 < g) (χ : DirichletCharacter ℂ q) :
    TW0 H (dconv (HighPrime.reflectedBand h T) (rd BHB.MT.kap2 g r)) (1/S) χ =
      ((1/(h*Real.log T):ℝ):ℂ)*
      ∑' j : ℕ, block H χ g r (h*Real.log T) S ⌊Real.sqrt T⌋₊ ⌊T^h⌋₊ j := by
  let a := rd BHB.MT.kap2 g r
  let z := HighPrime.reflectedBand h T
  let D := h*Real.log T
  let I := Finset.Ioc ⌊Real.sqrt T⌋₊ ⌊T^h⌋₊
  have hz := HighPrime.reflectedBand_DB hh hT
  have ha := HighPrime.reduced_kap2_DB hg r
  have hD := mul_pos hh (Real.log_pos hT)
  have hc : 0 < 1/S := by positivity
  rw [dconv_comm]
  obtain ⟨hs,he⟩ := TW0_dconv hH ha hz hc χ
  rw [he]
  let f := fun (v : ℕ × ℕ) => (a v.1:ℂ)*(z v.2:ℂ)*χ (v.1:ZMod q)*χ (v.2:ZMod q)*(H ((1/S)*v.1*v.2):ℂ)
  have hf : Summable f := by
    apply Summable.of_norm_bounded hs
    intro v
    simp only [f,norm_mul,Complex.norm_real,Real.norm_eq_abs]
    have h := mul_le_mul (χ.norm_le_one (v.1:ZMod q)) (χ.norm_le_one (v.2:ZMod q))
      (norm_nonneg _) zero_le_one
    calc
      _ = (|a v.1| *|z v.2| *|H ((1/S)*v.1*v.2)|)*(‖χ (v.1:ZMod q)‖*‖χ (v.2:ZMod q)‖) := by ring
      _ ≤ _ := by apply mul_le_of_le_one_right (by positivity); simpa using h
  change (∑' v, f v)=_
  rw [hf.tsum_prod,← tsum_mul_left]
  apply tsum_congr
  intro j
  have hi (p : ℕ) : p ∈ I ↔ Real.sqrt T < (p:ℝ) ∧ (p:ℝ) ≤ T^h := by
    simp only [I,Finset.mem_Ioc,lt_iff_not_ge,Nat.le_floor_iff (Real.sqrt_nonneg T),
      Nat.le_floor_iff (Real.rpow_pos_of_pos (zero_lt_one.trans hT) h).le]
  have hzero (p : ℕ) (hp : p ∉ I) : f (j,p)=0 := by
    have hnp : ¬(p.Prime ∧ Real.sqrt T < (p:ℝ) ∧ (p:ℝ) ≤ T^h) := fun he => hp ((hi p).mpr he.2)
    simp [f,z,HighPrime.reflectedBand,hnp]
  rw [tsum_eq_sum hzero]
  unfold block
  rw [← mul_assoc,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro p hp
  have hmem := (hi p).mp hp
  by_cases hpr : p.Prime
  · simp only [f,z,HighPrime.reflectedBand,if_pos (show p.Prime ∧ Real.sqrt T < (p:ℝ) ∧ (p:ℝ) ≤ T^h from ⟨hpr,hmem⟩),primeTwist,if_pos hpr,Complex.real_smul,
      Complex.ofReal_mul,Complex.ofReal_div,Complex.ofReal_sub,Complex.ofReal_one,a]
    rw [show (1/S)*(j:ℝ)*p=(j:ℝ)/S*p by ring]; ring
  · simp [f,z,HighPrime.reflectedBand,primeTwist,hpr]


/-- The full small-conductor estimate for the actual reflected prime band,
uniform in the complementary divisors and every primitive character. -/
theorem small_conductors {y h : ℝ} (hy : y < 1/2) (hh : 0 < h) (hh₁ : h < 1)
    {H : ℝ → ℝ} (hH : Adm H) (A B : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      SCU y H T A (dconv (HighPrime.reflectedBand h T) BHB.MT.kap2) (C/(Real.log T)^B) := by
  let P := A+B+8
  have hP : 0 < P := by dsimp [P]; omega
  obtain ⟨C,X₀,hC,hX₀,hdy⟩ := small_conductor_series P hP H hH
  let K := 324*4^P*C
  have hK : 0 < K := by dsimp [K]; positivity
  refine ⟨3*K,by positivity,?_⟩
  filter_upwards [ReflectedLogBand.scales hh₁,Real.tendsto_log_atTop.eventually_ge_atTop (max (4^P) (1/h)),
    (tendsto_rpow_atTop (by norm_num : (0:ℝ) < 1/4)).eventually_ge_atTop X₀] with T hsc hbig hx
  obtain ⟨hL,hX,hXT,hT₀⟩ := hsc
  let L := Real.log T
  let D := h*L
  let b := ⌊Real.sqrt T⌋₊
  let U := ⌊T^h⌋₊
  have hL₀ : 0 < L := by dsimp [L]; linarith
  have hT := (Real.log_nonneg_iff hT₀).mp hL₀.le
  have hT₁ : 1 < T := (Real.log_pos_iff hT₀.le).mp hL₀
  have h4L : (4:ℝ)^P ≤ L := (le_max_left ..).trans hbig
  have hD : 1 ≤ D := (div_le_iff₀ hh).mp ((le_max_right ..).trans hbig) |>.trans_eq (mul_comm ..)
  have hX' : T^h ≤ T/(2*Real.pi) := by simpa [heightScale,Real.exp_log hT₀] using hX
  have hU : (U:ℝ) ≤ T^h := Nat.floor_le (Real.rpow_pos_of_pos hT₀ _).le
  have hUT := hU.trans (hX.trans hXT)
  have hbs : T^(1/4:ℝ) ≤ (b:ℝ) := by
    have he : T^(1/4:ℝ)*T^(1/4:ℝ)=Real.sqrt T := by
      rw [← Real.rpow_add hT₀,Real.sqrt_eq_rpow]; norm_num
    have h₁ : 2 ≤ T^(1/4:ℝ) := by linarith
    have hf := Nat.lt_floor_add_one (Real.sqrt T)
    change T^(1/4:ℝ) ≤ (⌊Real.sqrt T⌋₊:ℝ)
    nlinarith only [he,h₁,hf,mul_nonneg (by linarith : 0 ≤ T^(1/4:ℝ)-1) (by linarith : 0 ≤ T^(1/4:ℝ)-2)]
  have hb : 0 < b := by exact_mod_cast (Real.rpow_pos_of_pos hT₀ (1/4:ℝ)).trans_le hbs
  have hJ : ((Nat.log 2 U+1:ℕ):ℝ) ≤ 3*L := by
    rcases Nat.eq_zero_or_pos U with hu|hu
    · rw [hu]; simp; dsimp [L]; linarith
    · have hv : (2:ℝ)^(Nat.log 2 U) ≤ T := (show (2:ℝ)^(Nat.log 2 U) ≤ U by exact_mod_cast Nat.pow_log_le_self 2 hu.ne').trans hUT
      have hl := Real.log_le_log (by positivity) hv
      rw [Real.log_pow] at hl
      have ht := mul_le_mul_of_nonneg_left Real.log_two_gt_d9.le (Nat.cast_nonneg (α:=ℝ) (Nat.log 2 U))
      push_cast; dsimp [L]; linarith
  intro g r q χ hg hr hq hqL hcap hχ
  have hR : ((g*r*q:ℕ):ℝ) ≤ T := hcap.trans ((Real.rpow_le_rpow_of_exponent_le hT (by linarith : y ≤ 1)).trans_eq (Real.rpow_one T))
  have hgr : ((g*r:ℕ):ℝ) ≤ Real.sqrt T := by
    apply (show ((g*r:ℕ):ℝ) ≤ (g*r*q:ℕ) by exact_mod_cast Nat.le_mul_of_pos_right (g*r) (by omega : 0 < q)).trans
    rw [Real.sqrt_eq_rpow]; exact hcap.trans (Real.rpow_le_rpow_of_exponent_le hT hy.le)
  have hgT : (g:ℝ) ≤ T := (show (g:ℝ) ≤ (g*r*q:ℕ) by exact_mod_cast
    ((Nat.le_mul_of_pos_right g hr).trans (Nat.le_mul_of_pos_right (g*r) (by omega : 0 < q)))).trans hR
  have hqr : (q:ℝ)*r ≤ T := by
    have hn : q*r ≤ g*r*q := by simpa [Nat.mul_comm,Nat.mul_assoc,Nat.mul_left_comm] using Nat.le_mul_of_pos_left (q*r) hg
    exact (show (q:ℝ)*r ≤ (g*r*q:ℕ) by exact_mod_cast hn).trans hR
  let S := (q:ℝ)*r*T/(2*Real.pi)
  have hq₀ : 0 < (q:ℝ) := by exact_mod_cast (by omega : 0 < q)
  have hr₀ : 0 < (r:ℝ) := by exact_mod_cast hr
  have hS : 0 < S := by dsimp [S]; positivity
  have hS₁ : S ≤ (q:ℝ)*r*T := div_le_self (by positivity) (by linarith [Real.pi_gt_three])
  have hS₂ : S ≤ T^2 := hS₁.trans (by nlinarith only [mul_le_mul_of_nonneg_right hqr hT₀.le])
  have hUS : (U:ℝ) ≤ S := by
    have hqr₁ : (1:ℝ) ≤ (q:ℝ)*r := by exact_mod_cast Nat.mul_pos (by omega : 0 < q) hr
    exact hU.trans (hX'.trans (div_le_div_of_nonneg_right (le_mul_of_one_le_left hT₀.le hqr₁) (by positivity)))
  let E := K*((q:ℝ)*r*T)/L^(B+1)
  have hE : 0 ≤ E := by dsimp [E]; positivity
  have hlocal (a u : ℕ) (hba : b ≤ a) (hau : a < u) (hu : u ≤ U) (hua : u ≤ 2*a) :
      Summable (block H χ g r D S a u) ∧ ‖∑' j, block H χ g r D S a u j‖ ≤ E := by
    have hax : T^(1/4:ℝ) ≤ (a:ℝ) := hbs.trans (by exact_mod_cast hba)
    have ha₀ : (0:ℝ) < a := (Real.rpow_pos_of_pos hT₀ _).trans_le hax
    have ha₁ : (1:ℝ) ≤ a := by linarith
    have hla := Real.log_le_log (Real.rpow_pos_of_pos hT₀ _) hax
    rw [Real.log_rpow hT₀] at hla
    have hl : L ≤ 4*Real.log a := by dsimp [L]; linarith
    have hla₀ : 0 < Real.log a := by linarith
    have hq' : (q:ℝ) ≤ Real.log a^P := by
      rw [Real.rpow_natCast] at hqL
      have he : L^A*4^P ≤ L^P := (mul_le_mul_of_nonneg_left h4L (pow_nonneg hL₀.le A)).trans
        (by rw [← pow_succ]; exact pow_le_pow_right₀ hL (by dsimp [P]; omega))
      have hpow := pow_le_pow_left₀ hL₀.le hl P
      rw [mul_pow] at hpow
      apply hqL.trans
      exact (le_of_mul_le_mul_right (he.trans (hpow.trans_eq (mul_comm ..))) (by positivity : 0 < (4:ℝ)^P))
    have hYu : 1 ≤ S/a := (one_le_div ha₀).mpr ((show (a:ℝ) ≤ U by exact_mod_cast hau.le.trans hu).trans hUS)
    have hlogu : Real.log u ≤ D := by
      have hu' : (u:ℝ) ≤ T^h := (show (u:ℝ) ≤ U by exact_mod_cast hu).trans hU
      have hz := Real.log_le_log (by exact_mod_cast (hb.trans_le (hba.trans hau.le))) hu'
      simpa only [D,L,Real.log_rpow hT₀] using hz
