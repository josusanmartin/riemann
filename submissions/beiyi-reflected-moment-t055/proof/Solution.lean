theorem _root_.Taper78.BHB.MTP.norm_deriv_AAm_le {ly : ℝ} (hly : 1 ≤ ly) {lam : ℂ} (hlam : ‖lam‖ * ly ≤ 1) {V : ℝ}
    (hV : V ∈ Set.Icc 0 ly) : ‖deriv (Taper78.BHB.MTP.AAm ly lam) V‖ ≤ 4 / ly ^ 2 := by
  have hly0 : 0 < ly := by linarith
