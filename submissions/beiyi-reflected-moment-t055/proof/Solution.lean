section Src_PrimePairDiagonal

open MeasureTheory Filter
open scoped BigOperators ArithmeticFunction Topology

noncomputable section

namespace PrimePairDiagonal

/-- The diagonal of a zero-sampled prime polynomial, with logarithmic scale
fixed at log T even when its endpoint is changed. -/
def through (r : ℝ) (f : ℝ → ℝ) (T : ℝ) : ℝ :=
  (∑ n ∈ Finset.Icc 2 ⌊T ^ r⌋₊,
    Λ n ^ 2 / n * f (Real.log n / Real.log T)) / Real.log T ^ 2

theorem through_limit (f : ℝ → ℝ) (hf : ContDiff ℝ 1 f) {r : ℝ} (hr : 0 < r) :
    Tendsto (through r f) atTop (𝓝 (∫ x in (0 : ℝ)..r, x * f x)) := by
  have hs : ContDiff ℝ 1 (fun y : ℝ => f (r*y)) :=
    hf.comp (contDiff_const.mul contDiff_id)
  obtain ⟨C,hC⟩ := TMA.primeSum_asymp _ hs
  have hI : r^2 * (∫ y in (0:ℝ)..1, y*f (r*y)) = ∫ x in (0:ℝ)..r, x*f x := by
    have h := intervalIntegral.smul_integral_comp_mul_left
      (a := (0:ℝ)) (b := 1) (fun x : ℝ => x*f x) r
    simp only [smul_eq_mul, mul_zero, mul_one, mul_assoc, intervalIntegral.integral_const_mul] at h
    linear_combination h
  have hlim : Tendsto (fun T : ℝ => C*r / Real.log T) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop Real.tendsto_log_atTop
  apply tendsto_iff_norm_sub_tendsto_zero.mpr
  apply squeeze_zero' (Eventually.of_forall fun _ => norm_nonneg _) _ hlim
  filter_upwards [eventually_gt_atTop (1 : ℝ),
    (tendsto_rpow_atTop hr).eventually_ge_atTop 2] with T hT hX
  have hT0 : 0 < T := by linarith
  have hL := Real.log_pos hT
  have hb := hC (T^r) hX
  rw [Real.log_rpow hT0 r] at hb
  simp only [show ∀ z : ℝ, r*(z/(r*Real.log T))=z/Real.log T by
    intro z; field_simp] at hb
  rw [Real.norm_eq_abs, through, ← hI]
  have heq (a b : ℝ) : a / Real.log T ^ 2 - r^2*b =
      (a-(r*Real.log T)^2*b)/Real.log T^2 := by field_simp
  rw [heq, abs_div, abs_of_pos (sq_pos_of_pos hL), div_le_iff₀ (sq_pos_of_pos hL)]
  exact hb.trans_eq (by field_simp)

/-- Each open-left, closed-right bin is a difference of endpoint sums. -/
theorem bin_limit (f : ℝ → ℝ) (hf : ContDiff ℝ 1 f) {a b : ℝ}
    (ha : 0 < a) (hb : 0 < b) :
    Tendsto (fun T => through b f T - through a f T) atTop
      (𝓝 (∫ x in a..b, x*f x)) := by
  have hc : Continuous (fun x => x*f x) := continuous_id.mul hf.continuous
  have h := (through_limit f hf hb).sub (through_limit f hf ha)
  have hI := intervalIntegral.integral_add_adjacent_intervals (μ := volume)
    (hc.intervalIntegrable (0:ℝ) a) (hc.intervalIntegrable a b)
  convert h using 2
  linarith

theorem flat_first {h : ℝ} (hh : 0 < h) :
    Tendsto (through h (fun x => (h-x)/h^2)) atTop (𝓝 (h/6)) := by
  have hi := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := (0:ℝ)) (b := h)
    (f := fun x : ℝ => (h*x^2/2-x^3/3)/h^2) (f' := fun x => x*((h-x)/h^2))
  have hd (x : ℝ) : HasDerivAt (fun x : ℝ => (h*x^2/2-x^3/3)/h^2)
      (x*((h-x)/h^2)) x := by
    convert! ((((hasDerivAt_pow 2 x).const_mul h).div_const 2).sub
      ((hasDerivAt_pow 3 x).div_const 3) |>.div_const (h^2)) using 1
    norm_num
    ring
  have hc : Continuous (fun x : ℝ => x*((h-x)/h^2)) := by fun_prop
  have hI := hi (fun x _ => hd x) (hc.intervalIntegrable _ _)
  convert through_limit (fun x => (h-x)/h^2) (by fun_prop) hh using 2
  rw [hI]
  field_simp
  ring

theorem flat_second {h : ℝ} (hh : 0 < h) :
    Tendsto (through h (fun x => ((h-x)/h^2)^2)) atTop (𝓝 (1/12)) := by
  let F := fun x : ℝ => (h^2*x^2/2-2*h*x^3/3+x^4/4)/h^4
  let f := fun x : ℝ => x*((h-x)/h^2)^2
  have hd (x : ℝ) : HasDerivAt F (f x) x := by
    unfold F f
    convert! (((((hasDerivAt_pow 2 x).const_mul (h^2)).div_const 2).sub
      (((hasDerivAt_pow 3 x).const_mul (2*h)).div_const 3)).add
      ((hasDerivAt_pow 4 x).div_const 4) |>.div_const (h^4)) using 1
    norm_num
    ring
  have hc : Continuous f := by unfold f; fun_prop
  have hI := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := (0:ℝ)) (b := h)
    (fun x _ => hd x) (hc.intervalIntegrable _ _)
  convert through_limit (fun x => ((h-x)/h^2)^2) (by fun_prop) hh using 2
  change 1/12 = ∫ x in (0:ℝ)..h, f x
  rw [hI]
  unfold F
  field_simp
  ring

#print axioms through_limit
#print axioms bin_limit
#print axioms flat_first
#print axioms flat_second

end PrimePairDiagonal
end
end Src_PrimePairDiagonal

section Src_FejerBands


/-! Sharp zero averages for a prime polynomial restricted to a logarithmic band. -/
noncomputable section
open Complex Real Filter Topology MeasureTheory FejerPrimeMoments
open scoped BigOperators ArithmeticFunction

namespace FejerBands

def support (u v T : ℝ) : Finset ℕ :=
  indices (T^v) \ indices (T^u)

def amplitude (f : ℝ → ℝ) (T : ℝ) (n : ℕ) : ℝ :=
  TMA.lamCoeff n * f (Real.log n/Real.log T) / Real.log T

def partialSum (f : ℝ → ℝ) (b T : ℝ) (z : ℂ) : ℂ :=
  ∑ n ∈ BHB.Krange b T, ((Λ n / Real.log T * f (Real.log n/Real.log T) : ℝ) : ℂ) * (n:ℂ)^(-z)

def value (f : ℝ → ℝ) (u v T : ℝ) (z : ℂ) : ℂ := partialSum f v T z - partialSum f u T z

private theorem split {b T : ℝ} (hT : 1 ≤ T) (hb : 0 ≤ b) :
    BHB.Krange b T = insert 1 (indices (T^b)) := by
  have hfloor : 1 ≤ ⌊T^b⌋₊ := (Nat.le_floor_iff (Real.rpow_nonneg (by linarith) b)).mpr
    (by simpa using Real.one_le_rpow hT hb)
  ext n
  simp only [BHB.Krange,BHB.ymol,indices,Finset.mem_Icc,Finset.mem_insert]
  omega

private theorem nested {u v T : ℝ} (hT : 1 ≤ T) (huv : u ≤ v) :
    indices (T^u) ⊆ indices (T^v) :=
  Finset.Icc_subset_Icc_right (Nat.floor_mono (Real.rpow_le_rpow_of_exponent_le hT huv))

private theorem not_one (u v T : ℝ) : 1 ∉ support u v T := by simp [support,indices]

private theorem partial_on_line (f : ℝ → ℝ) {b v T : ℝ} (hT : 1 < T) (hb : 0 ≤ b)
    (hv : 0 < v) {z : ℂ} (hz : z.re=1/2) :
    (starRingEnd ℂ) (partialSum f b T z) = polynomial (indices (T^b)) (amplitude f T) T v z := by
  rw [partialSum,split hT.le hb,Finset.sum_insert (by simp [indices]),polynomial]
  simp only [ArithmeticFunction.vonMangoldt_apply_one,zero_div,zero_mul,Complex.ofReal_zero,zero_add,map_sum]
  apply Finset.sum_congr rfl
  intro n hn
  have hn' : 0 < n := by have := (Finset.mem_Icc.mp hn).1; omega
  rw [FejerMultiplicity.on_line_power hz hn',map_mul,map_mul,Complex.conj_ofReal,
    Complex.conj_ofReal,← Complex.exp_conj]
  have hphase : TMA.phase T v z (TMA.lamOf T v n) =
      Complex.exp ((starRingEnd ℂ) (-I * (z.im:ℂ) * (Real.log n:ℂ))) := by
    unfold TMA.phase TMA.lamOf
    congr 1
    simp only [map_mul,map_neg,Complex.conj_I,neg_neg,Complex.conj_ofReal]
    push_cast
    field_simp [hv.ne',(Real.log_pos hT).ne']
  rw [hphase,← mul_assoc]
  congr 1
  push_cast [amplitude,TMA.lamCoeff]
  ring

private theorem poly_shift (f : ℝ → ℝ) {u v T : ℝ} (hT : 1 < T) (hu : 0 ≤ u)
    (hv : 0 < v) (huv : u ≤ v) (d : ℝ) {z : ℂ} (hz : z.re=1/2) :
    polynomial (insert 1 (support u v T)) (shifted (amplitude f T) d) T v z =
      (starRingEnd ℂ) (value f u v T z-d) := by
  rw [value,map_sub,map_sub,Complex.conj_ofReal,partial_on_line f hT hv.le hv hz,
    partial_on_line f hT hu hv hz]
  have hs := Finset.sum_sdiff (nested hT.le huv) (f := fun n => (amplitude f T n:ℂ)*TMA.phase T v z (TMA.lamOf T v n))
  unfold polynomial
  rw [Finset.sum_insert (not_one u v T)]
  simp only [shifted,if_true,TMA.lamOf,Nat.cast_one,Real.log_one,zero_div,TMA.Kernel.phase_zero,
    mul_one,Complex.ofReal_neg]
  have he : ∑ n ∈ support u v T, ((if n=1 then -d else amplitude f T n : ℝ):ℂ)*
      TMA.phase T v z (Real.log n/(v*Real.log T)) =
      ∑ n ∈ support u v T, (amplitude f T n:ℂ)*TMA.phase T v z (Real.log n/(v*Real.log T)) := by
    exact Finset.sum_congr rfl fun n hn => by rw [if_neg (fun (h : n = 1) => not_one u v T (h ▸ hn))]
  rw [he]
  change (∑ n ∈ support u v T, _) + _ = _ at hs
  simp only [TMA.lamOf] at hs
  linear_combination hs

private theorem limits (f : ℝ → ℝ) (hf : ContDiff ℝ 1 f) {u v : ℝ}
    (hu : 0 ≤ u) (hv : 0 < v) (huv : u ≤ v) :
    Tendsto (fun T => (∑ n ∈ support u v T, amplitude f T n * TMA.lamCoeff n)/Real.log T)
      atTop (𝓝 (∫ x in u..v, x*f x)) ∧
    Tendsto (fun T => ∑ n ∈ support u v T, amplitude f T n^2) atTop (𝓝 (∫ x in u..v, x*(f x)^2)) := by
  have base (g : ℝ → ℝ) (hg : ContDiff ℝ 1 g) : Tendsto (fun T : ℝ =>
      (∑ n ∈ support u v T, Λ n^2/n * g (Real.log n/Real.log T))/Real.log T^2) atTop
      (𝓝 (∫ x in u..v, x*g x)) := by
    have lim : Tendsto (fun T => PrimePairDiagonal.through v g T - PrimePairDiagonal.through u g T)
        atTop (𝓝 (∫ x in u..v, x*g x)) := by
      rcases hu.eq_or_lt with h | h
      · subst u
        have hz (T : ℝ) : PrimePairDiagonal.through 0 g T = 0 := by simp [PrimePairDiagonal.through]
        simpa only [hz,sub_zero] using PrimePairDiagonal.through_limit g hg hv
      · exact PrimePairDiagonal.bin_limit g hg h hv
    apply lim.congr' 
    filter_upwards [eventually_ge_atTop (1:ℝ)] with T hT
    unfold PrimePairDiagonal.through support
    rw [← sub_div]
    congr 1
    exact (eq_sub_of_add_eq (Finset.sum_sdiff (nested hT huv))).symm
  have hs (n : ℕ) : TMA.lamCoeff n ^ 2 = Λ n^2/n := by simp [TMA.lamCoeff,div_pow,Real.sq_sqrt]
  constructor
  · apply (base f hf).congr
    intro T
    rw [Finset.sum_div,Finset.sum_div]
    exact Finset.sum_congr rfl fun n _ => by rw [← hs n]; unfold amplitude; ring
  · apply (base (fun x => f x^2) (hf.pow 2)).congr
    intro T
    rw [Finset.sum_div]
    exact Finset.sum_congr rfl fun n _ => by rw [← hs n]; unfold amplitude; ring

def sharp (T : ℝ) (g : ℂ → ℝ) : ℝ :=
  ∑ z ∈ ThirdMoment.zerosFinset T (2*T), (Zeta23.zeroMult z:ℝ)*g z

/-- A smooth height window bounds the sharp square with any fixed real shift.
    The mixed term has its sign on both sides of zero. -/
theorem shifted_band (hRH : RiemannHypothesis) (w : TMA.HeightWeight) (f : ℝ → ℝ)
    (hf : ContDiff ℝ 1 f) {u v : ℝ} (hu : 0 ≤ u) (hv : 0 < v) (huv : u ≤ v) (hv' : v < 1)
    (hpos : ∀ x ∈ Set.Icc 0 v, 0 ≤ f x) (d : ℝ) {η : ℝ} (hη : 0 < η) :
    ∀ᶠ T : ℝ in atTop, sharp T (fun z => ‖value f u v T z-d‖^2) ≤
      (w.kap1*(d^2+(∫ x in u..v, x*f x^2)+2*d*(∫ x in u..v, x*f x))+η)*TMA.Dsc T := by
  obtain ⟨D,hD,hgram⟩ := gram_error hRH w hv hv'.le
  let S (T : ℝ) := support u v T
  let A (T : ℝ) := ∑ n ∈ S T, amplitude f T n * TMA.lamCoeff n
  let V (T : ℝ) := ∑ n ∈ S T, amplitude f T n ^ 2
  let V₀ := ∫ x in u..v, x*f x^2
  let M₀ := ∫ x in u..v, x*f x
  have hlim := limits f hf hu hv huv
  have hmu : Tendsto (fun T => A T/Real.log T) atTop (𝓝 M₀) := hlim.1
  have hV : Tendsto V atTop (𝓝 V₀) := hlim.2
  have hE := (tendsto_const_nhds (x := d^2)).add hV
  have hr : Tendsto (fun T : ℝ => D*(2*π)/Real.log T) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop Real.tendsto_log_atTop
  have hl := ((hE.const_mul w.kap1).add (hmu.const_mul (2*w.kap1*d))).add (hr.mul hE)
  have hbound := hl.eventually_le_const (show
      w.kap1*(d^2+V₀)+(2*w.kap1*d)*M₀+0*(d^2+V₀) <
      w.kap1*(d^2+V₀+2*d*M₀)+η by linarith only [hη])
  filter_upwards [hbound,hgram,eventual_sample w hv hv',eventually_gt_atTop (1:ℝ)] with T hn hG hκ hT
  let J := insert 1 (S T)
  let a := amplitude f T
  let q := shifted a d
  have hT₀ : 0 < T := by linarith
  have hL := Real.log_pos hT
  have hsubset : J ⊆ BHB.Krange v T := by
    rw [split hT.le hv.le]
    exact Finset.insert_subset_insert _ Finset.sdiff_subset
  have hk (n : ℕ) (hn : n ∈ J) := Finset.mem_Icc.mp (hsubset hn)
  have hX := Real.rpow_nonneg hT₀.le v
  have hmax (n : ℕ) (hn : n ∈ J) : n ≤ TMA.Nmax T v :=
    (hk n hn).2.trans (Nat.floor_mono (show T^v ≤ 2*T^v by linarith))
  have ha (n : ℕ) (hn : n ∈ J) : 0 ≤ a n := by
    have hn₀ := (hk n hn).1
    have hn₁ : 1 ≤ (n:ℝ) := by exact_mod_cast hn₀
    have hnf := Real.log_le_log (by linarith : (0:ℝ) < n) ((Nat.le_floor_iff hX).mp (hk n hn).2)
    rw [Real.log_rpow hT₀] at hnf
    exact div_nonneg (mul_nonneg (div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _))
      (hpos _ ⟨div_nonneg (Real.log_nonneg hn₁) hL.le,(div_le_iff₀ hL).mpr hnf⟩)) hL.le
  have hp := prime_gram_signed w hT hv J (Or.inr hmax) (Finset.mem_insert_self ..)
    (fun n hn => (hk n hn).1) (fun n hn => hκ n (hsubset hn)) a ha (d := d)
  have he := hG J hsubset q
  have hgs := gram_at_zeros hRH w hT₀ v J q
  have hwin := BHB.Final.hasSum_window
    (fun z => (Zeta23.zeroMult z:ℝ)*‖value f u v T z-d‖^2) T (2*T)
  have hsharp : sharp T (fun z => ‖value f u v T z-d‖^2) ≤ gram J q T v (TMA.Kfull w.h T v) := by
    apply hasSum_le _ hwin hgs
    intro z
    rw [show polynomial J q T v z = (starRingEnd ℂ) (value f u v T z-d) from
      poly_shift f hT hu hv huv d (Zeta23.RH_implies_on_line hRH z.2),Complex.norm_conj]
    unfold TMA.cw
    split_ifs with h
    · exact mul_le_mul_of_nonneg_right (le_mul_of_one_le_right (Nat.cast_nonneg _)
        (w.h_ge_one _ ((one_le_div hT₀).mpr h.1.le) ((div_le_iff₀ hT₀).mpr h.2))) (sq_nonneg _)
    · exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (w.h_nonneg _)) (sq_nonneg _)
  have hs : ∑ n ∈ J, q n^2 = d^2+V T := by
    unfold J
    rw [Finset.sum_insert (not_one u v T)]
    simp only [q,shifted,if_true,neg_sq]
    congr 1
    exact Finset.sum_congr rfl fun n hn => by rw [if_neg (fun (h : n = 1) => not_one u v T (h ▸ hn))]
  have ham : ∑ n ∈ J, a n*TMA.lamCoeff n = A T := by
    unfold J
    rw [Finset.sum_insert (not_one u v T)]
    change a 1*TMA.lamCoeff 1+A T=A T
    simp [TMA.lamCoeff]
  change gram J q T v _ ≤ _*(∑ n ∈ J, q n^2)+_*∑ n ∈ J, a n*TMA.lamCoeff n at hp
  rw [hs,ham] at hp
  rw [hs] at he
  have hDsc : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg hT₀.le hL.le) (by positivity)
  change w.kap1*(d^2+V T)+(2*w.kap1*d)*(A T/Real.log T)+
      D*(2*π)/Real.log T*(d^2+V T) ≤ _ at hn
  refine hsharp.trans ?_
  have htop := mul_le_mul_of_nonneg_right hn hDsc
  calc
    _ ≤ D*T*(d^2+V T) + (w.kap1*TMA.Dsc T*(d^2+V T)+
          2*T*(w.kap1/(2*π))*d*A T) := by linarith only [hp,he]
    _ = (w.kap1*(d^2+V T)+(2*w.kap1*d)*(A T/Real.log T)+
        D*(2*π)/Real.log T*(d^2+V T))*TMA.Dsc T := by
      unfold TMA.Dsc
      field_simp [hL.ne',Real.pi_ne_zero]
      ring
    _ ≤ _ := htop

def triangle (h x : ℝ) : ℝ := (h-x)/h^2

def firstPrimitive (h x : ℝ) : ℝ := (h*x^2/2-x^3/3)/h^2

def secondPrimitive (h x : ℝ) : ℝ := (h^2*x^2/2-2*h*x^3/3+x^4/4)/h^4

theorem triangular_integrals (h u v : ℝ) :
    (∫ x in u..v, x*triangle h x) = firstPrimitive h v-firstPrimitive h u ∧
    (∫ x in u..v, x*(triangle h x)^2) = secondPrimitive h v-secondPrimitive h u := by
  constructor
  · apply intervalIntegral.integral_eq_sub_of_hasDerivAt
    · intro x _
      unfold firstPrimitive triangle
      convert! ((((hasDerivAt_pow 2 x).const_mul h).div_const 2).sub
        ((hasDerivAt_pow 3 x).div_const 3) |>.div_const (h^2)) using 1
      norm_num
      ring
    · exact (show Continuous (fun x => x*triangle h x) by unfold triangle; fun_prop).intervalIntegrable _ _
  · apply intervalIntegral.integral_eq_sub_of_hasDerivAt
    · intro x _
      unfold secondPrimitive triangle
      convert! (((((hasDerivAt_pow 2 x).const_mul (h^2)).div_const 2).sub
        (((hasDerivAt_pow 3 x).const_mul (2*h)).div_const 3)).add
        ((hasDerivAt_pow 4 x).div_const 4) |>.div_const (h^4)) using 1
      norm_num
      ring
    · exact (show Continuous (fun x => x*(triangle h x)^2) by unfold triangle; fun_prop).intervalIntegrable _ _

/-- A sharp block of zeros counted with multiplicity. The slack allows rational rounding. -/
theorem triangular_square (hRH : RiemannHypothesis) {u v h : ℝ} (hu : 0 ≤ u) (hv : 0 < v)
    (huv : u ≤ v) (hvh : v ≤ h) (hv' : v < 1) (d : ℝ) {δ B cap : ℝ} (hδ : 0 < δ)
    (hB : d^2+(secondPrimitive h v-secondPrimitive h u)+
      2*d*(firstPrimitive h v-firstPrimitive h u) = B) (hB₀ : 0 ≤ B)
    (hcap : ((1+δ)*B+δ)*(1+δ) ≤ cap) :
    ∀ᶠ T : ℝ in atTop, sharp T (fun z => ‖value (triangle h) u v T z-d‖^2) ≤
      cap*(Zeta23.Ncount T (2*T):ℝ) := by
  obtain ⟨w,hκ,_⟩ := (BHB.inputs_of_RH hRH).weight δ hδ
  have hs := shifted_band hRH w.toHeightWeight (triangle h) (by unfold triangle; fun_prop)
    hu hv huv hv' (fun x hx => div_nonneg (sub_nonneg.mpr (hx.2.trans hvh)) (sq_nonneg _)) d hδ
  rcases triangular_integrals h u v with ⟨hi,hj⟩
  filter_upwards [hs,eventually_atTop.mpr (BHB.Final.Dsc_le_Ncount hδ),
    eventually_gt_atTop (1:ℝ)] with T hs hN hT
  rw [hi,hj,hB] at hs
  change TMA.Dsc T ≤ (1+δ)*(Zeta23.Ncount T (2*T):ℝ) at hN
  have hD : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg (by linarith) (Real.log_pos hT).le) (by positivity)
  have hK : w.toHeightWeight.kap1*B+δ ≤ (1+δ)*B+δ :=
    add_le_add_left (mul_le_mul_of_nonneg_right hκ hB₀) δ
  have hx := hs.trans (mul_le_mul hK hN hD (by positivity))
  rw [← mul_assoc] at hx
  exact hx.trans (mul_le_mul_of_nonneg_right hcap (Nat.cast_nonneg _))

end FejerBands
end
end Src_FejerBands

section Src_PrimeVariance

/-! Ordinary products of nonnegative prime bands in the zero-sampled variance. -/
noncomputable section
open Complex Real Filter Topology MeasureTheory FejerPrimeMoments
open scoped BigOperators ArithmeticFunction

namespace PrimeVariance

/-- Dirichlet coefficient of the absolutely convergent product on the
right contour for the reflected derivative mean. -/
def rightCoefficient (n : ℕ) : ℝ :=
  ∑ d ∈ n.divisors, Λ d * Real.log (n/d : ℕ)

private theorem right_at_prime {p : ℕ} (hp : p.Prime) : rightCoefficient p = 0 := by
  apply Finset.sum_eq_zero
  intro d hd
  rcases hp.eq_one_or_self_of_dvd d (Nat.dvd_of_mem_divisors hd) with rfl | rfl
  · simp
  · simp [hp.ne_zero]

/-- Every right-line frequency in the reflected prime sum vanishes after
the compact Fourier cutoff. There is no length assumption on n or k. -/
theorem right_contour_terms (w : TMA.HeightWeight) {s : ℝ} (hs : 0 < s) (hs' : s < 1)
    (ψ : ℝ → ℂ) (hsupp : ∀ x, ψ x ≠ 0 → |x| ≤ w.kappa) :
    ∀ᶠ T : ℝ in atTop, ∀ p ∈ BHB.Krange s T, p.Prime → ∀ n k : ℕ, 0 < n → 0 < k →
      (rightCoefficient n:ℂ)*ψ (T*(Real.log (n*k:ℕ)-Real.log p)) = 0 := by
  filter_upwards [eventual_sample w hs hs',eventually_gt_atTop (0:ℝ)] with T h hT
  intro p hp hprime n k hn hk
  by_cases he : n*k=p
  · have hdiv : n ∣ p := ⟨k,he.symm⟩
    rcases hprime.eq_one_or_self_of_dvd n hdiv with rfl | rfl
    · simp [rightCoefficient]
    · simp [right_at_prime hprime]
  · have hgap := integer_gap hprime.pos (Nat.mul_pos hn hk) (Ne.symm he)
    rw [abs_sub_comm] at hgap
    have hsep := (lt_div_iff₀ (by positivity : 0 < (p:ℝ)+1)).mpr (h p hp)
    have hx := mul_le_mul_of_nonneg_left hgap hT.le
    have hzero : ψ (T*(Real.log (n*k:ℕ)-Real.log p)) = 0 := by
      by_contra hh
      have hbound := hsupp _ hh
      rw [abs_mul,abs_of_pos hT] at hbound
      rw [one_div,← div_eq_mul_inv] at hx
      linarith only [hsep,hx,hbound]
    rw [hzero,mul_zero]

/-- The explicit formula at a nonconstant integer frequency below the height.
The error is uniform, including at prime powers. -/
theorem integer_frequency (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    {s : ℝ} (hs : 0 < s) (hs' : s < 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in atTop, ∀ n ∈ indices (T^s),
      |(TMA.Kfull w.h T 1 (TMA.lamOf T 1 n)).re +
        T*(w.kap1/(2*π))*TMA.lamCoeff n| ≤ C := by
  obtain ⟨C,G,hC,hG,h⟩ := kernel_decay hRH w (b := 1) zero_lt_one le_rfl
  refine ⟨C+G,add_nonneg hC hG,?_⟩
  filter_upwards [h,eventual_sample w hs hs',eventually_ge_atTop (2:ℝ),
    eventually_ge_atTop (1/(Real.log 2)^2)] with T h hκ hT hlog
  intro n hn
  have hT₁ : 1 < T := by linarith
  have hT₀ : 0 < T := by linarith
  have hL := Real.log_pos hT₁
  have hn₂ := (Finset.mem_Icc.mp hn).1
  have hn₀ : 0 < n := by omega
  have hn₂' : (2:ℝ) ≤ n := by exact_mod_cast hn₂
  have hnR : 0 < (n:ℝ) := by positivity
  have hnX := (Nat.le_floor_iff (Real.rpow_nonneg hT₀.le s)).mp (Finset.mem_Icc.mp hn).2
  have hnK : n ∈ BHB.Krange s T :=
    Finset.mem_Icc.mpr ⟨by omega,(Finset.mem_Icc.mp hn).2⟩
  have hOne : 1 ∈ BHB.Krange s T :=
    Finset.mem_Icc.mpr ⟨le_rfl,(show 1 ≤ n by omega).trans (Finset.mem_Icc.mp hn).2⟩
  have hsamp := sampled_real w hT₁ (b := 1) zero_lt_one hn₀ (m := 1) Nat.one_pos
    (hκ n hnK) (hκ 1 hOne)
  have hcap : n ≤ TMA.Nmax T 1 := by
    apply (Nat.le_floor_iff (by positivity : 0 ≤ 2*T^(1:ℝ))).mpr
    exact hnX.trans ((Real.rpow_le_rpow_of_exponent_le hT₁.le hs'.le).trans
      (by rw [Real.rpow_one]; linarith))
  have hk : (TMA.K0 w.k T 1 (TMA.lamOf T 1 n)).re =
      -(T*(w.kap1/(2*π))*TMA.lamCoeff n) := by
    simp only [show TMA.lamOf T 1 1=0 by simp [TMA.lamOf], sub_zero,
      if_neg (show n ≠ 1 by omega), zero_sub] at hsamp
    simpa only [divisorMass_one_exact hn₀ hcap] using hsamp
  have hnl : Real.log 2 ≤ Real.log n := Real.log_le_log (by norm_num) hn₂'
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hx : |TMA.lamOf T 1 n| ≤ 1 := by
    unfold TMA.lamOf
    rw [one_mul,abs_of_nonneg (div_nonneg (by linarith) hL.le),div_le_iff₀ hL,one_mul]
    exact Real.log_le_log hnR (hnX.trans ((Real.rpow_le_rpow_of_exponent_le hT₁.le hs'.le).trans_eq
      (Real.rpow_one T)))
  have hden : T ≤ 1+(TMA.Asc T 1*TMA.lamOf T 1 n)^2 := by
    have hscale : TMA.Asc T 1*TMA.lamOf T 1 n = T*Real.log n := by
      unfold TMA.Asc TMA.lamOf
      field_simp
    rw [hscale,mul_pow]
    rw [div_le_iff₀ (sq_pos_of_pos hl2)] at hlog
    have hh := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hl2.le hnl 2) hT₀.le
    nlinarith [mul_le_mul_of_nonneg_left (hlog.trans hh) hT₀.le]
  have herr := (Complex.abs_re_le_norm _).trans (h _ hx)
  rw [Complex.sub_re,hk,sub_neg_eq_add] at herr
  have hfrac : T*(G/(1+(TMA.Asc T 1*TMA.lamOf T 1 n)^2)) ≤ G := by
    rw [← mul_div_assoc, div_le_iff₀ (by positivity)]
    linarith only [mul_le_mul_of_nonneg_left hden hG]
  linarith only [herr,hfrac]

/-- For positive coefficients the arithmetic main term can be discarded. -/
theorem positive_frequency (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    {s : ℝ} (hs : 0 < s) (hs' : s < 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in atTop, ∀ n ∈ indices (T^s),
      (TMA.Kfull w.h T 1 (TMA.lamOf T 1 n)).re ≤ C := by
  obtain ⟨C,hC,h⟩ := integer_frequency hRH w hs hs'
  refine ⟨C,hC,?_⟩
  filter_upwards [h,eventually_gt_atTop (0:ℝ)] with T h hT
  intro n hn
  have hmain : 0 ≤ T*(w.kap1/(2*π))*TMA.lamCoeff n := mul_nonneg (mul_nonneg hT.le (div_nonneg (TMA.T12.kap1_nonneg w)
    (by positivity))) (show 0 ≤ TMA.lamCoeff n from
    div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _))
  linarith only [(le_abs_self _).trans (h n hn),hmain]

private theorem phase_product {T : ℝ} (z : ℂ) {n m : ℕ} (hn : 0 < n) (hm : 0 < m) :
    TMA.phase T 1 z (TMA.lamOf T 1 (n*m)) =
      TMA.phase T 1 z (TMA.lamOf T 1 n)*TMA.phase T 1 z (TMA.lamOf T 1 m) := by
  unfold TMA.phase TMA.lamOf
  rw [Nat.cast_mul,Real.log_mul (by positivity) (by positivity),← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- Exact ordinary (unconjugated) cross term for two integer-frequency
polynomials on the RH zero measure, with all multiplicities retained. -/
theorem ordinary_at_zeros (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    {T : ℝ} (hT : 0 < T) (S U : Finset ℕ) (a b : ℕ → ℝ)
    (hS : ∀ n ∈ S, 0 < n) (hU : ∀ m ∈ U, 0 < m) :
    HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z *
      (polynomial S a T 1 z * polynomial U b T 1 z).re)
      (∑ n ∈ S, ∑ m ∈ U, a n*b m*(TMA.Kfull w.h T 1 (TMA.lamOf T 1 (n*m))).re) := by
  have h (n m : ℕ) := (Complex.hasSum_re (TMA.Kernel.summable_cw_phase hRH w hT 1
    (TMA.lamOf T 1 (n*m))).hasSum).mul_left (a n*b m)
  have hsum := hasSum_sum (s := S) fun n _ => hasSum_sum (s := U) fun m _ => h n m
  convert hsum using 1 <;> try rfl
  funext z
  simp only [polynomial,Finset.sum_mul,Finset.mul_sum,Complex.re_sum]
  rw [Finset.sum_comm (s := U) (t := S)]
  apply Finset.sum_congr rfl
  intro n hn
  apply Finset.sum_congr rfl
  intro m hm
  rw [phase_product _ (hS _ hn) (hU _ hm)]
  simp only [Complex.mul_re,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im]
  ring

/-- Uniform one-sided O(T) contribution when every product index stays
below T^s, the coefficients are between zero and one, and there are at most
T pairs. The board moments have normalization of order T log T. -/
theorem ordinary_upper (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    {s : ℝ} (hs : 0 < s) (hs' : s < 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in atTop, ∀ (S U : Finset ℕ) (a b : ℕ → ℝ),
      (∀ n ∈ S, 0 < n ∧ a n ∈ Set.Icc 0 1) →
      (∀ m ∈ U, 0 < m ∧ b m ∈ Set.Icc 0 1) →
      (∀ n ∈ S, ∀ m ∈ U, n*m ∈ indices (T^s)) → (S.card:ℝ)*U.card ≤ T →
      (∑' z : Zeta23.zetaZeroConfig.carrier, TMA.cw w.h T z *
        (polynomial S a T 1 z * polynomial U b T 1 z).re) ≤ C*T := by
  obtain ⟨C,hC,h⟩ := positive_frequency hRH w hs hs'
  refine ⟨C,hC,?_⟩
  filter_upwards [h,eventually_gt_atTop (0:ℝ)] with T h hT
  intro S U a b ha hb hsu hsize
  rw [(ordinary_at_zeros hRH w hT S U a b (fun n hn => (ha n hn).1)
    (fun m hm => (hb m hm).1)).tsum_eq]
  calc
    _ ≤ ∑ _n ∈ S, ∑ _m ∈ U, C := by
      apply Finset.sum_le_sum
      intro n hn
      apply Finset.sum_le_sum
      intro m hm
      have hab := mul_nonneg (ha n hn).2.1 (hb m hm).2.1
      have hle : a n*b m ≤ 1 := (mul_le_mul (ha n hn).2.2 (hb m hm).2.2
        (hb m hm).2.1 zero_le_one).trans (by norm_num)
      exact (mul_le_mul_of_nonneg_left (h _ (hsu n hn m hm)) hab).trans
        ((mul_le_mul_of_nonneg_right hle hC).trans_eq (one_mul C))
    _ = C*((S.card:ℝ)*U.card) := by simp; ring
    _ ≤ C*T := mul_le_mul_of_nonneg_left hsize hC

/-- The mixed Hermitian moment, allowing arbitrary overlapping frequency sets. -/
theorem hermitian_at_zeros (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    {T : ℝ} (hT : 0 < T) (S U : Finset ℕ) (a b : ℕ → ℝ) :
    HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z *
      (polynomial S a T 1 z * (starRingEnd ℂ) (polynomial U b T 1 z)).re)
      (∑ n ∈ S, ∑ m ∈ U, a n*b m*(TMA.Kfull w.h T 1
        (TMA.lamOf T 1 n-TMA.lamOf T 1 m)).re) := by
  have h (n m : ℕ) := (Complex.hasSum_re (TMA.Kernel.summable_cw_phase hRH w hT 1
    (TMA.lamOf T 1 n-TMA.lamOf T 1 m)).hasSum).mul_left (a n*b m)
  have hsum := hasSum_sum (s := S) fun n _ => hasSum_sum (s := U) fun m _ => h n m
  convert hsum using 1 <;> try rfl
  funext z
  simp only [polynomial,map_sum,map_mul,Complex.conj_ofReal,Finset.sum_mul,Finset.mul_sum,Complex.re_sum]
  rw [Finset.sum_comm (s := U) (t := S)]
  apply Finset.sum_congr rfl
  intro n _
  apply Finset.sum_congr rfl
  intro m _
  rw [phase_sub]
  simp only [Complex.mul_re,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im]
  ring

/-- A bounded nonnegative weight on each ordered pair of integer frequencies
retains the diagonal upper bound. The separate constant-frequency terms give
the signed first moment when the weight pairs a band with index 1. -/
theorem weighted_hermitian (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    {s : ℝ} (hs : 0 < s) (hs' : s < 1) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ᶠ T : ℝ in atTop,
    ∀ (S : Finset ℕ), S ⊆ BHB.Krange s T → ∀ (a : ℕ → ℝ) (p : ℕ → ℕ → ℝ) (M : ℝ),
      0 ≤ M → (∀ n ∈ S, 0 ≤ a n) → (∀ n ∈ S, ∀ m ∈ S, p n m ∈ Set.Icc 0 M) →
      (∑ n ∈ S, ∑ m ∈ S, p n m*(a n*a m)*
        (TMA.Kfull w.h T 1 (TMA.lamOf T 1 n-TMA.lamOf T 1 m)).re) ≤
        M*(D*T*∑ n ∈ S, a n^2) + w.kap1*TMA.Dsc T*(∑ n ∈ S, p n n*a n^2) -
        T*(w.kap1/(2*π))*(∑ n ∈ S, ∑ m ∈ S, p n m*(a n*a m)*
          (if n=1 then TMA.lamCoeff m else if m=1 then TMA.lamCoeff n else 0)) := by
  obtain ⟨D,hD,h⟩ := absolute_gram_error hRH w (b := 1) zero_lt_one le_rfl
  refine ⟨D,hD,?_⟩
  filter_upwards [h,eventual_sample w hs hs',eventually_gt_atTop (1:ℝ)] with T he hκ hT
  intro S hS a p M hM ha hp
  have hT₀ : 0 < T := by linarith
  have hsub : BHB.Krange s T ⊆ BHB.Krange 1 T := Finset.Icc_subset_Icc_right
    (Nat.floor_mono (Real.rpow_le_rpow_of_exponent_le hT.le hs'.le))
  have hcut (n : ℕ) (hn : n ∈ S) : n ≤ TMA.Nmax T 1 :=
    (Finset.mem_Icc.mp (hsub (hS hn))).2.trans (Nat.floor_mono
      (show T^(1:ℝ) ≤ 2*T^(1:ℝ) by rw [Real.rpow_one]; linarith))
  let U := T*(w.kap1/(2*π))
  have hU : 0 ≤ U := mul_nonneg hT₀.le (div_nonneg (TMA.T12.kap1_nonneg w) (by positivity))
  let freq (n m : ℕ) := TMA.lamOf T 1 n - TMA.lamOf T 1 m
  let loss (n m : ℕ) := if n=1 then TMA.lamCoeff m else if m=1 then TMA.lamCoeff n else 0
  have hlo (n : ℕ) (hn : n ∈ S) (m : ℕ) (hm : m ∈ S) :
      loss n m ≤ divisorMass (TMA.Nmax T 1) n m := by
    by_cases hn' : n=1
    · subst n
      simp [loss,divisorMass_comm _ 1 m,divisorMass_one_exact (Finset.mem_Icc.mp (hS hm)).1 (hcut m hm)]
    · by_cases hm' : m=1
      · subst m
        simp [loss,hn',divisorMass_one_exact (Finset.mem_Icc.mp (hS hn)).1 (hcut n hn)]
      · simpa [loss,hn',hm'] using divisorMass_nonneg (TMA.Nmax T 1) n m
  have hlog := Real.log_le_log (by positivity : 0 < T/(2*π))
    (div_le_self hT₀.le (by linarith [Real.pi_gt_three]))
  have hbase : U*Real.log (T/(2*π)) ≤ w.kap1*TMA.Dsc T := by
    exact (mul_le_mul_of_nonneg_left hlog hU).trans_eq (by unfold U TMA.Dsc; ring)
  have point (n : ℕ) (hn : n ∈ S) (m : ℕ) (hm : m ∈ S) :
      p n m*(a n*a m)*(TMA.Kfull w.h T 1 (freq n m)).re ≤
      M*(|a n*a m| * ‖(TMA.Kfull w.h T 1-TMA.K0 w.k T 1) (freq n m)‖) +
      (if m=n then w.kap1*TMA.Dsc T*(p n n*a n^2) else 0) -
      U*(p n m*(a n*a m)*loss n m) := by
    have han := mul_nonneg (ha n hn) (ha m hm)
    have hpn := mul_nonneg (hp n hn m hm).1 han
    have hx := (Complex.re_le_norm (TMA.Kfull w.h T 1 (freq n m) -
        TMA.K0 w.k T 1 (freq n m)))
    rw [Complex.sub_re] at hx
    have herr := (mul_le_mul_of_nonneg_left hx hpn).trans
      (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (hp n hn m hm).2 han) (norm_nonneg _))
    rw [abs_of_nonneg han]
    simp only [Pi.sub_apply]
    have hk := sampled_real w hT zero_lt_one (Finset.mem_Icc.mp (hS hn)).1
      (Finset.mem_Icc.mp (hS hm)).1 (hκ _ (hS hn)) (hκ _ (hS hm))
    change (TMA.K0 w.k T 1 (freq n m)).re = (if n=m then U*Real.log (T/(2*π)) else 0) -
      U*divisorMass (TMA.Nmax T 1) n m at hk
    have hneg := mul_le_mul_of_nonneg_left (hlo n hn m hm) (mul_nonneg hU hpn)
    rw [hk] at herr
    by_cases hnm : n=m
    · subst m
      simp only [if_true] at herr ⊢
      linarith only [herr,hneg,mul_le_mul_of_nonneg_left hbase hpn]
    · simp only [if_neg hnm,if_neg (Ne.symm hnm),zero_sub,add_zero] at herr ⊢
      linarith only [herr,hneg]
  have total := Finset.sum_le_sum (s := S) fun n hn =>
    Finset.sum_le_sum (s := S) fun m hm => point n hn m hm
  simp only [Finset.sum_sub_distrib,Finset.sum_add_distrib,← Finset.mul_sum] at total
  have hdia : (∑ n ∈ S, ∑ m ∈ S, if m=n then w.kap1*TMA.Dsc T*(p n n*a n^2) else 0) =
      w.kap1*TMA.Dsc T*(∑ n ∈ S, p n n*a n^2) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun n hn => by simp [hn]
  rw [hdia] at total
  exact total.trans (sub_le_sub (add_le_add (mul_le_mul_of_nonneg_left
    (he S (hS.trans hsub) a) hM) le_rfl) le_rfl)

/-- Two primes never give a proper integer ratio that contributes to the
von Mangoldt term of the explicit formula. This includes the diagonal. -/
theorem prime_divisor_mass (K : ℕ) {n m : ℕ} (hn : n.Prime) (hm : m.Prime) :
    divisorMass K n m = 0 := by
  have hne {p q k : ℕ} (hp : p.Prime) (hq : q.Prime) (hk : 2 ≤ k) : p ≠ q*k := by
    intro he
    rcases hp.eq_one_or_self_of_dvd q ⟨k,he⟩ with H | H
    · exact hq.ne_one H
    · rw [← H] at he
      exact (lt_mul_of_one_lt_right hq.pos (by omega : 1 < k)).ne he
  apply Finset.sum_eq_zero
  intro k hk
  simp only [if_neg (hne hn hm (Finset.mem_Icc.mp hk).1),
    if_neg (hne hm hn (Finset.mem_Icc.mp hk).1),add_zero,mul_zero]

/-- The smoothed Hermitian product of any two real polynomials supported on
primes of length below T has its exact diagonal as main term. Both signs of
the coefficients and of the cross moment are allowed. -/
theorem prime_hermitian (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    {s : ℝ} (hs : 0 < s) (hs' : s < 1) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ᶠ T : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ BHB.Krange s T →
    (∀ n ∈ S, n.Prime) → ∀ a b : ℕ → ℝ, ∃ v : ℝ,
    HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z *
      (polynomial S a T 1 z * (starRingEnd ℂ) (polynomial S b T 1 z)).re) v ∧
    |v-T*(w.kap1/(2*π))*Real.log (T/(2*π))*(∑ n ∈ S, a n*b n)| ≤
      D*T*∑ n ∈ S, (|a n| + |b n|)^2 := by
  obtain ⟨D,hD,h⟩ := absolute_gram_error hRH w (b := 1) zero_lt_one le_rfl
  refine ⟨D,hD,?_⟩
  filter_upwards [h,eventual_sample w hs hs',eventually_gt_atTop (1:ℝ)] with T he hκ hT
  intro S hS hp a b
  have hsub : BHB.Krange s T ⊆ BHB.Krange 1 T := Finset.Icc_subset_Icc_right
    (Nat.floor_mono (Real.rpow_le_rpow_of_exponent_le hT.le hs'.le))
  let freq (n m : ℕ) := TMA.lamOf T 1 n - TMA.lamOf T 1 m
  let c := T*(w.kap1/(2*π))*Real.log (T/(2*π))
  let e (n : ℕ) := |a n| + |b n|
  have em (n : ℕ) : 0 ≤ e n := add_nonneg (abs_nonneg _) (abs_nonneg _)
  have hz := hermitian_at_zeros hRH w (lt_trans zero_lt_one hT) S S a b
  refine ⟨_,hz,?_⟩
  have main : c*(∑ n ∈ S, a n*b n) = ∑ n ∈ S, ∑ m ∈ S,
      a n*b m*(TMA.K0 w.k T 1 (freq n m)).re := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro n hn
    calc
      c*(a n*b n) = ∑ m ∈ S, if m=n then c*(a n*b n) else 0 := by simp [hn]
      _ = _ := by
        apply Finset.sum_congr rfl
        intro m hm
        dsimp only [freq]
        rw [sampled_real w hT zero_lt_one (hp n hn).pos (hp m hm).pos (hκ _ (hS hn))
          (hκ _ (hS hm)),prime_divisor_mass _ (hp n hn) (hp m hm),mul_zero,sub_zero]
        by_cases hnm : m=n
        · subst m; simp [c,mul_comm]
        · simp [hnm,Ne.symm hnm]
  change |(∑ n ∈ S, ∑ m ∈ S, a n*b m*(TMA.Kfull w.h T 1 (freq n m)).re) - c*(∑ n ∈ S, a n*b n)| ≤ _
  rw [main]
  simp only [← Finset.sum_sub_distrib,← mul_sub,← Complex.sub_re]
  apply (Finset.abs_sum_le_sum_abs ..).trans
  apply le_trans _ (he S (hS.trans hsub) e)
  apply Finset.sum_le_sum
  intro n _
  apply (Finset.abs_sum_le_sum_abs ..).trans
  apply Finset.sum_le_sum
  intro m _
  rw [abs_mul,abs_mul,abs_of_nonneg (mul_nonneg (em n) (em m))]
  exact mul_le_mul (mul_le_mul (by dsimp [e]; linarith [abs_nonneg (b n)])
    (by dsimp [e]; linarith [abs_nonneg (a m)]) (abs_nonneg _) (em n))
    (Complex.abs_re_le_norm _) (abs_nonneg _) (mul_nonneg (em n) (em m))

/-- The board's Chebyshev defect bounds the entire proper-prime-power
contribution to every bounded coefficient profile, independently of length. -/
theorem proper_power_error (X : ℝ) (f : ℕ → ℝ) {M : ℝ} (hM : 0 ≤ M)
    (hf : ∀ n ∈ indices X, |f n| ≤ M) :
    |(∑ n ∈ indices X, Λ n^2/n*f n) -
      (∑ n ∈ (indices X).filter Nat.Prime, Λ n^2/n*f n)| ≤ M*1537 := by
  let d (n : ℕ) := Λ n*(Real.log n-Λ n)/n
  have hd (n : ℕ) : 0 ≤ d n := div_nonneg (mul_nonneg ArithmeticFunction.vonMangoldt_nonneg
    (sub_nonneg.mpr ArithmeticFunction.vonMangoldt_le_log)) (Nat.cast_nonneg _)
  have hpp {n : ℕ} (hn : ¬n.Prime) : Λ n^2/n ≤ d n := by
    by_cases hΛ : Λ n = 0
    · simp only [hΛ,zero_pow (by decide : 2≠0),zero_div]; exact hd _
    obtain ⟨p,k,hp,hk,rfl⟩ := (isPrimePow_nat_iff _).mp (ArithmeticFunction.vonMangoldt_ne_zero_iff.mp hΛ)
    have h2 : 2 ≤ k := by
      by_contra! hl
      have : k=1 := by omega
      simp [this,hp] at hn
    have h₂ : (2:ℝ) ≤ k := by exact_mod_cast h2
    have h₀ : 0 ≤ Real.log p := Real.log_nonneg (by exact_mod_cast hp.one_le)
    unfold d
    rw [ArithmeticFunction.vonMangoldt_apply_pow (by omega : k≠0),
      ArithmeticFunction.vonMangoldt_apply_prime hp,Nat.cast_pow,Real.log_pow]
    apply div_le_div_of_nonneg_right _ (by positivity)
    nlinarith only [mul_le_mul_of_nonneg_right h₂ (sq_nonneg (Real.log p))]
  have heq := Finset.sum_filter_add_sum_filter_not (indices X) Nat.Prime (fun n => Λ n^2/n*f n)
  rw [show (∑ n ∈ indices X, Λ n^2/n*f n) - (∑ n ∈ (indices X).filter Nat.Prime, Λ n^2/n*f n) =
    ∑ n ∈ (indices X).filter (fun n => ¬ n.Prime), Λ n^2/n*f n by linarith only [heq]]
  apply (Finset.abs_sum_le_sum_abs ..).trans
  calc
    _ ≤ ∑ n ∈ (indices X).filter (fun n => ¬n.Prime), M*d n := by
      apply Finset.sum_le_sum
      intro n hn
      have hkn := Finset.mem_filter.mp hn
      rw [abs_mul,abs_of_nonneg (by positivity : 0 ≤ Λ n^2/n),mul_comm M]
      exact mul_le_mul (hpp hkn.2) (hf n hkn.1) (abs_nonneg _) (hd n)
    _ ≤ ∑ n ∈ indices X, M*d n := Finset.sum_le_sum_of_subset_of_nonneg
      (Finset.filter_subset ..) (fun n _ _ => mul_nonneg hM (hd n))
    _ ≤ M*1537 := by
      rw [← Finset.mul_sum]
      apply mul_le_mul_of_nonneg_left _ hM
      rw [indices,← TMA.PrimeSum.sum_Ioc_zero_eq_sum_Icc_two d (by simp [d])]
      exact Zeta23.Cheb.defect_bounded_explicit X

/-- The diagonal asymptotic for primes alone, with the same logarithmic
profile and the same normalization as the all-prime-power diagonal. -/
theorem prime_diagonal_limit (f : ℝ → ℝ) (hf : ContDiff ℝ 1 f) {r : ℝ} (hr : 0 < r)
    {M : ℝ} (hM : 0 ≤ M) (hb : ∀ x ∈ Set.Icc 0 r, |f x| ≤ M) :
    Tendsto (fun T : ℝ => (∑ n ∈ (indices (T^r)).filter Nat.Prime,
      Λ n^2/n*f (Real.log n/Real.log T))/Real.log T^2) atTop (𝓝 (∫ x in (0:ℝ)..r, x*f x)) := by
  let P (T : ℝ) := (∑ n ∈ (indices (T^r)).filter Nat.Prime,
      Λ n^2/n*f (Real.log n/Real.log T))/Real.log T^2
  have he : Tendsto (fun T => PrimePairDiagonal.through r f T - P T) atTop (𝓝 0) := by
    apply squeeze_zero_norm'
    · filter_upwards [eventually_gt_atTop (1:ℝ)] with T hT
      have h₀ : 0 < T := by linarith
      have hL := Real.log_pos hT
      have hbound := proper_power_error (T^r) (fun n => f (Real.log n/Real.log T)) hM
        (fun n hn => by
          have hkn := Finset.mem_Icc.mp hn
          have hn₁ : 1 ≤ (n:ℝ) := by exact_mod_cast (show 1 ≤ n by omega)
          have hx := Real.log_le_log (by linarith) ((Nat.le_floor_iff (Real.rpow_nonneg h₀.le r)).mp hkn.2)
          rw [Real.log_rpow h₀] at hx
          exact hb _ ⟨div_nonneg (Real.log_nonneg hn₁) hL.le,(div_le_iff₀ hL).mpr hx⟩)
      simp only [Real.norm_eq_abs,PrimePairDiagonal.through,P,← sub_div,abs_div,
        abs_of_nonneg (sq_nonneg (Real.log T))]
      exact div_le_div_of_nonneg_right hbound (sq_nonneg _)
    · exact tendsto_const_nhds.div_atTop ((tendsto_pow_atTop (by decide : 2≠0)).comp Real.tendsto_log_atTop)
  simpa only [sub_zero,sub_sub_cancel] using (PrimePairDiagonal.through_limit f hf hr).sub he

/-- A smooth shifted-square bound before taking diagonal limits. It applies
to either prime-only or prime-power supports, including incomplete bands. -/
theorem smooth_shifted_square (hRH : RiemannHypothesis) (w : TMA.HeightWeight)
    {s : ℝ} (hs : 0 < s) (hs' : s < 1) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ᶠ T : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ indices (T^s) →
    ∀ (a : ℕ → ℝ), a 1=0 → (∀ n ∈ S, 0 ≤ a n) → ∀ d : ℝ, ∃ v : ℝ,
      HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z *
        ‖polynomial S a T 1 z-d‖^2) v ∧
      v ≤ (D*T+w.kap1*TMA.Dsc T)*(d^2+∑ n ∈ S, a n^2) +
        2*T*(w.kap1/(2*π))*d*(∑ n ∈ S, a n*TMA.lamCoeff n) := by
  obtain ⟨D,hD,h⟩ := gram_error hRH w (b := 1) zero_lt_one le_rfl
  refine ⟨D,hD,?_⟩
  filter_upwards [h,eventual_sample w hs hs',eventually_gt_atTop (1:ℝ)] with T he hκ hT
  intro S hS a ha hpos d
  let J := insert 1 S
  let q := shifted a d
  have hT₀ : 0 < T := by linarith
  have hOne : 1 ∉ S := fun H => by have := (Finset.mem_Icc.mp (hS H)).1; omega
  have hJ : J ⊆ BHB.Krange s T := by
    intro n hn
    rcases Finset.mem_insert.mp hn with rfl | hn
    · exact Finset.mem_Icc.mpr ⟨le_rfl,(Nat.le_floor_iff (Real.rpow_nonneg hT₀.le _)).mpr
        (by simpa using Real.one_le_rpow hT.le hs.le)⟩
    · exact Finset.mem_Icc.mpr ⟨by have := (Finset.mem_Icc.mp (hS hn)).1; omega,(Finset.mem_Icc.mp (hS hn)).2⟩
  have hsub : BHB.Krange s T ⊆ BHB.Krange 1 T := Finset.Icc_subset_Icc_right
    (Nat.floor_mono (Real.rpow_le_rpow_of_exponent_le hT.le hs'.le))
  have hcut (n : ℕ) (hn : n ∈ J) : n ≤ TMA.Nmax T 1 :=
    (Finset.mem_Icc.mp (hsub (hJ hn))).2.trans (Nat.floor_mono
      (show T^(1:ℝ) ≤ 2*T^(1:ℝ) by rw [Real.rpow_one]; linarith))
  have hnn (n : ℕ) (hn : n ∈ S) : q n = a n := if_neg (fun (h : n=1) => hOne (h ▸ hn))
  have hp := prime_gram_signed w hT zero_lt_one J (Or.inr hcut) (Finset.mem_insert_self ..)
    (fun n hn => (Finset.mem_Icc.mp (hJ hn)).1) (fun n hn => hκ n (hJ hn)) a (fun n hn => by
      rcases Finset.mem_insert.mp hn with rfl | hmem
      · exact ha.ge
      · exact hpos n hmem) (d := d)
  have he' := he J (hJ.trans hsub) q
  have hsum := gram_at_zeros hRH w hT₀ 1 J q
  refine ⟨_,hsum.congr_fun (fun z => ?_),?_⟩
  · have eqv : polynomial J q T 1 z = polynomial S a T 1 z-d := by
      unfold polynomial J
      rw [Finset.sum_insert hOne]
      have := Finset.sum_congr (s₁ := S) (s₂ := S) rfl (fun n hn =>
        congrArg (fun t : ℝ => (t:ℂ)*TMA.phase T 1 z (TMA.lamOf T 1 n)) (hnn n hn))
      simp only [q,shifted,if_true,TMA.lamOf,Nat.cast_one,Real.log_one,zero_div,TMA.Kernel.phase_zero,
        mul_one,Complex.ofReal_neg] at ⊢
      dsimp only [TMA.lamOf,q,shifted] at this
      rw [this]
      ring
    rw [eqv]
  · have hd : (∑ n ∈ J, q n^2) = d^2+∑ n ∈ S, a n^2 := by
      rw [show J=insert 1 S from rfl,Finset.sum_insert hOne]
      simp only [q,shifted,if_true,neg_sq]
      exact congrArg (d^2+·) (Finset.sum_congr rfl fun n hn => congrArg (·^2) (hnn n hn))
    have hl : (∑ n ∈ J, a n*TMA.lamCoeff n) = ∑ n ∈ S, a n*TMA.lamCoeff n := by
      simp [J,Finset.sum_insert hOne,ha]
    change gram J q T 1 _ ≤ _*(∑ n ∈ J, q n^2)+_*∑ n ∈ J, a n*TMA.lamCoeff n at hp
    rw [hd,hl] at hp
    rw [hd] at he'
    linarith only [he',hp]

/-- A pointwise majorant of a nonnegative cost can be summed on the smooth
height window before passing to the board's sharp counting interval. -/
theorem sharp_majorized (w : TMA.HeightWeight) {T v : ℝ} (hT : 0 < T)
    (f g : ℂ → ℝ) (hf : ∀ z, 0 ≤ f z) (hfg : ∀ z : Zeta23.zetaZeroConfig.carrier, f z ≤ g z)
    (hg : HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z*g z) v) :
    FejerBands.sharp T f ≤ v := by
  apply hasSum_le _ (BHB.Final.hasSum_window (fun z => (Zeta23.zeroMult z:ℝ)*f z) T (2*T)) hg
  intro z
  have hw := mul_nonneg (Nat.cast_nonneg (Zeta23.zeroMult z) : (0:ℝ) ≤ _) (w.h_nonneg (z.val.im/T))
  apply le_trans _ (mul_le_mul_of_nonneg_left (hfg z) hw)
  split_ifs with h
  · exact mul_le_mul_of_nonneg_right (le_mul_of_one_le_right (Nat.cast_nonneg _)
      (w.h_ge_one _ ((one_le_div hT).mpr h.1.le) ((div_le_iff₀ hT).mpr h.2))) (hf _)
  · exact mul_nonneg hw (hf _)

