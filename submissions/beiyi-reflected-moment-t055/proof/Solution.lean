section Src_Taper78FirstBasic

/- Exact primitives and bounds of the retapered first main term. -/
noncomputable section
set_option Elab.async false

namespace Taper78.BHB
def c1 (θ : ℝ) : ℝ := 1/2+63*θ/100
namespace MT
def dPpoly (x : ℝ) : ℝ := 1.78-1.56*x
def PPpoly (x : ℝ) : ℝ := 0.89*x^2-0.26*x^3

theorem Ppoly_zero : Ppoly 0 = 0 := by norm_num [Ppoly,LowBand.taper78]
theorem Ppoly_one : Ppoly 1 = 1 := by norm_num [Ppoly,LowBand.taper78]
theorem PPpoly_zero : PPpoly 0 = 0 := by norm_num [PPpoly]
theorem PPpoly_one : PPpoly 1 = 63/100 := by norm_num [PPpoly]

theorem hasDerivAt_Ppoly (x : ℝ) : HasDerivAt Ppoly (dPpoly x) x := by
  have h := ((hasDerivAt_id' x).const_mul (1.78:ℝ)).sub ((hasDerivAt_pow 2 x).const_mul (0.78:ℝ))
  exact h.congr_deriv (by norm_num [dPpoly]; ring)

theorem hasDerivAt_dPpoly (x : ℝ) : HasDerivAt dPpoly (-1.56) x := by
  have h := (hasDerivAt_const x (1.78:ℝ)).sub ((hasDerivAt_id' x).const_mul (1.56:ℝ))
  exact h.congr_deriv (by norm_num)

theorem hasDerivAt_PPpoly (x : ℝ) : HasDerivAt PPpoly (Ppoly x) x := by
  have h := ((hasDerivAt_pow 2 x).const_mul (0.89:ℝ)).sub ((hasDerivAt_pow 3 x).const_mul (0.26:ℝ))
  exact h.congr_deriv (by norm_num [Ppoly,LowBand.taper78]; ring)

theorem deriv_Ppoly : deriv Ppoly = dPpoly := funext fun x => (hasDerivAt_Ppoly x).deriv
theorem deriv_dPpoly : deriv dPpoly = fun _ => (-1.56 : ℝ) := funext fun x => (hasDerivAt_dPpoly x).deriv
theorem contDiff_Ppoly : ContDiff ℝ 2 Ppoly := by unfold Ppoly LowBand.taper78; fun_prop

theorem Ppoly_mem {x : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 1) : 0 ≤ Ppoly x ∧ Ppoly x ≤ 1 :=
  Red.BD.Ppoly_mem_Icc h0 h1
theorem dPpoly_mem {x : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 1) : 0 ≤ dPpoly x ∧ dPpoly x ≤ 2 := by
  unfold dPpoly
  constructor <;> linarith
theorem PPpoly_mem {x : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 1) : 0 ≤ PPpoly x ∧ PPpoly x ≤ 1 := by
  unfold PPpoly
  constructor <;> nlinarith [mul_nonneg (sq_nonneg x) (sub_nonneg.mpr h1),
    mul_nonneg h0 (sub_nonneg.mpr h1),pow_nonneg h0 3,sq_nonneg x]

end MT
end Taper78.BHB

#retaper BHB.MT.Ik BHB.MT.T4 BHB.MT.Wmain BHB.MT.Wprim
  BHB.MT.Ik_eq BHB.MT.Main1_eq BHB.MT.Main1_eq_ofReal BHB.MT.sum_l_dvd_prime
end
end Src_Taper78FirstBasic

section Src_Taper78FirstPerK

/- Adapted from BHB.MainT1.PerK by Kristian Muri Knausgård with Claude.
The bounds and polynomial identities here use LowBand.taper78. -/
noncomputable section
open MeasureTheory 
open scoped BigOperators ArithmeticFunction ArithmeticFunction.Moebius Nat Real

namespace BHB.MT.PK
theorem _root_.Taper78.BHB.MT.PK.term2_alg {θ L ly X kR n N F s1 r ρ : ℝ} (W : Wt θ L ly X kR n N F s1 r ρ)
    {κ Hm Lam v dP P S1 LL0 LL1 C1 A A' : ℝ} (hC1 : 0 ≤ C1) (hA : 0 ≤ A) (hA' : 0 ≤ A')
    (hLam : |Lam| ≤ 2 * L) (hv0 : 0 ≤ v) (hv1 : v ≤ ly)
    (hdP : |dP| ≤ 2) (hP : |P| ≤ 1)
    (h1 : |S1 - n * X * (κ * Lam + Hm)| ≤ C1 * kR)
    (h0 : |LL0 - N * dP / ly| ≤ A * F * (r / ly + 1 / ly ^ 2))
    (h0' : |LL1 + N * P| ≤ A * F * (r + 1 / ly))
    (hb0 : |LL0| ≤ A' * N * F / ly) (hb1 : |LL1| ≤ A' * N * F) :
    |S1 * (v * LL0 + LL1) - κ * X * (Lam * (v * dP / ly - P))|
      ≤ (2 * C1 * A' + 3 * |Hm| + 4 * A * (|κ| / θ + |Hm|)) * X * ρ := by
  have hρ1 := W.rho_ge_NF
  have hρ2 := W.rho_ge_F
  have hρ3 := W.one_le_rho
  obtain ⟨hθ, hθ1, hL, hly, hly1, hX, hk0, hkX, hkLX, hn0, hn1, hnN, hN, hF, hs, hr0, hr1, hρ⟩ := W
  have hL0 : 0 < L := by linarith
  have hN0 : 0 < N := by linarith
  have hF0 : 0 < F := by linarith
  have hly0 : 0 < ly := by linarith
  have hκ : 0 ≤ |κ| := abs_nonneg κ
  have hHm : 0 ≤ |Hm| := abs_nonneg Hm
  have hvly : v / ly ≤ 1 := (div_le_one hly0).mpr hv1
  have hvly0 : 0 ≤ v / ly := div_nonneg hv0 hly0.le
  have hinv : 1 / ly ≤ 1 := by
    rw [div_le_one hly0]
    exact hly1
  have hinv0 : 0 ≤ 1 / ly := by positivity
  have e : S1 * (v * LL0 + LL1) - κ * X * (Lam * (v * dP / ly - P))
      = (S1 - n * X * (κ * Lam + Hm)) * (v * LL0 + LL1)
        + X * Hm * (v * dP / ly - P)
        + n * X * (κ * Lam + Hm) * (v * (LL0 - N * dP / ly) + (LL1 + N * P)) := by
    linear_combination (X * (κ * Lam + Hm) * (v * dP / ly - P)) * hnN
  rw [e]

  have hB : |v * LL0 + LL1| ≤ 2 * A' * N * F := by
    have h3 : |v * LL0| ≤ A' * N * F := by
      rw [abs_mul, abs_of_nonneg hv0]
      calc v * |LL0| ≤ v * (A' * N * F / ly) := mul_le_mul_of_nonneg_left hb0 hv0
        _ = (v / ly) * (A' * N * F) := by ring
        _ ≤ 1 * (A' * N * F) := mul_le_mul_of_nonneg_right hvly (by positivity)
        _ = A' * N * F := one_mul _
    have := abs_add_le (v * LL0) LL1
    linarith
  have p1 : |(S1 - n * X * (κ * Lam + Hm)) * (v * LL0 + LL1)| ≤ 2 * C1 * A' * X * ρ := by
    calc |(S1 - n * X * (κ * Lam + Hm)) * (v * LL0 + LL1)|
        ≤ (C1 * kR) * (2 * A' * N * F) := abs_mul_le_mul h1 hB
      _ ≤ (C1 * X) * (2 * A' * N * F) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hkX hC1) (by positivity)
      _ = 2 * C1 * A' * X * (N * F) := by ring
      _ ≤ 2 * C1 * A' * X * ρ := mul_le_mul_of_nonneg_left hρ1 (by positivity)

  have hm : |v * dP / ly - P| ≤ 3 := by
    have h3 : |v * dP / ly| ≤ 2 := by
      have e3 : v * dP / ly = (v / ly) * dP := by ring
      rw [e3, abs_mul, abs_of_nonneg hvly0]
      calc v / ly * |dP| ≤ 1 * (2) := mul_le_mul hvly hdP (abs_nonneg _) zero_le_one
        _ = 2 := one_mul _
    have := abs_sub (v * dP / ly) P
    linarith
  have p2 : |X * Hm * (v * dP / ly - P)| ≤ 3 * |Hm| * X * ρ := by
    have h3 : |X * Hm| ≤ X * |Hm| := by
      rw [abs_mul, abs_of_nonneg hX]
    calc |X * Hm * (v * dP / ly - P)| ≤ (X * |Hm|) * (3) := abs_mul_le_mul h3 hm
      _ = 3 * |Hm| * X * 1 := by ring
      _ ≤ 3 * |Hm| * X * ρ := mul_le_mul_of_nonneg_left hρ3 (by positivity)

  have hεB : |v * (LL0 - N * dP / ly) + (LL1 + N * P)| ≤ 2 * A * F * (r + 1 / ly) := by
    have h3 : |v * (LL0 - N * dP / ly)| ≤ A * F * (r + 1 / ly) := by
      rw [abs_mul, abs_of_nonneg hv0]
      calc v * |LL0 - N * dP / ly| ≤ v * (A * F * (r / ly + 1 / ly ^ 2)) :=
            mul_le_mul_of_nonneg_left h0 hv0
        _ = (v / ly) * (A * F * (r + 1 / ly)) := by
            field_simp
        _ ≤ 1 * (A * F * (r + 1 / ly)) := mul_le_mul_of_nonneg_right hvly (by positivity)
        _ = A * F * (r + 1 / ly) := one_mul _
    have := abs_add_le (v * (LL0 - N * dP / ly)) (LL1 + N * P)
    linarith
  have hS : |n * X * (κ * Lam + Hm)| ≤ X * (2 * |κ| * L + |Hm|) := by
    have h3 : |κ * Lam + Hm| ≤ 2 * |κ| * L + |Hm| := by
      have h4 := abs_add_le (κ * Lam) Hm
      have h5 : |κ * Lam| ≤ |κ| * (2 * L) := by
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_left hLam hκ
      linarith
    rw [abs_mul, abs_mul, abs_of_nonneg hn0, abs_of_nonneg hX]
    calc n * X * |κ * Lam + Hm| ≤ 1 * X * (2 * |κ| * L + |Hm|) :=
          mul_le_mul (mul_le_mul_of_nonneg_right hn1 hX) h3 (abs_nonneg _) (by positivity)
      _ = X * (2 * |κ| * L + |Hm|) := by ring
  have hθinv : 1 ≤ 1 / θ := by
    rw [le_div_iff₀ hθ]
    linarith
  have hLly : L / ly = 1 / θ := by
    rw [hly]
    field_simp
  have hkey : (2 * |κ| * L + |Hm|) * (r + 1 / ly) ≤ 2 * (|κ| / θ + |Hm|) * (1 + L * r) := by
    have hLr : 0 ≤ L * r := mul_nonneg hL0.le hr0
    have t3 : |κ| * (L * r) ≤ |κ| / θ * (L * r) := by
      have : |κ| * 1 ≤ |κ| * (1 / θ) := mul_le_mul_of_nonneg_left hθinv hκ
      have h9 : |κ| / θ = |κ| * (1 / θ) := by ring
      rw [h9]
      exact mul_le_mul_of_nonneg_right (by linarith) hLr
    have t4 : |Hm| * r ≤ |Hm| * 1 := mul_le_mul_of_nonneg_left hr1 hHm
    have t5 : |Hm| * (1 / ly) ≤ |Hm| * 1 := mul_le_mul_of_nonneg_left hinv hHm
    have t6 : 0 ≤ |Hm| * (L * r) := mul_nonneg hHm hLr
    have e1 : (2 * |κ| * L + |Hm|) * (r + 1 / ly)
        = 2 * (|κ| * (L * r)) + 2 * |κ| * (L / ly) + |Hm| * r + |Hm| * (1 / ly) := by ring
    have e2 : 2 * (|κ| / θ + |Hm|) * (1 + L * r)
        = 2 * (|κ| / θ * (L * r)) + 2 * |κ| * (1 / θ) + 2 * |Hm| + 2 * (|Hm| * (L * r)) := by ring
    rw [e1, e2, hLly]
    linarith
  have p3 : |n * X * (κ * Lam + Hm) * (v * (LL0 - N * dP / ly) + (LL1 + N * P))|
      ≤ 4 * A * (|κ| / θ + |Hm|) * X * ρ := by
    calc |n * X * (κ * Lam + Hm) * (v * (LL0 - N * dP / ly) + (LL1 + N * P))|
        ≤ (X * (2 * |κ| * L + |Hm|)) * (2 * A * F * (r + 1 / ly)) := abs_mul_le_mul hS hεB
      _ = 2 * A * X * F * ((2 * |κ| * L + |Hm|) * (r + 1 / ly)) := by ring
      _ ≤ 2 * A * X * F * (2 * (|κ| / θ + |Hm|) * (1 + L * r)) :=
          mul_le_mul_of_nonneg_left hkey (by positivity)
      _ = 4 * A * (|κ| / θ + |Hm|) * X * (F * (1 + L * r)) := by ring
      _ ≤ 4 * A * (|κ| / θ + |Hm|) * X * ρ := mul_le_mul_of_nonneg_left hρ2 (by positivity)
  calc |(S1 - n * X * (κ * Lam + Hm)) * (v * LL0 + LL1) + X * Hm * (v * dP / ly - P)
        + n * X * (κ * Lam + Hm) * (v * (LL0 - N * dP / ly) + (LL1 + N * P))|
      ≤ |(S1 - n * X * (κ * Lam + Hm)) * (v * LL0 + LL1)| + |X * Hm * (v * dP / ly - P)|
        + |n * X * (κ * Lam + Hm) * (v * (LL0 - N * dP / ly) + (LL1 + N * P))| :=
        abs_add_three _ _ _
    _ ≤ 2 * C1 * A' * X * ρ + 3 * |Hm| * X * ρ + 4 * A * (|κ| / θ + |Hm|) * X * ρ :=
        add_le_add (add_le_add p1 p2) p3
    _ = (2 * C1 * A' + 3 * |Hm| + 4 * A * (|κ| / θ + |Hm|)) * X * ρ := by ring
end BHB.MT.PK

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.LL_Ppoly {C₀ : ℝ} (hM : MobiusHyp C₀) : ∃ A : ℝ, 0 ≤ A ∧ ∀ y : ℝ, 2 ≤ y → ∀ kk : ℝ,
    1 ≤ kk → kk ≤ y → ∀ d : ℕ, 1 ≤ d →
      |LLsum Taper78.BHB.Ppoly y kk d 0
          - (d : ℝ) / φ d * Taper78.BHB.MT.dPpoly (1 - Real.log kk / Real.log y) / Real.log y|
        ≤ A * mobiusF (1 / 32) d * ((kk / y) ^ (1 / 32 : ℝ) / Real.log y + 1 / Real.log y ^ 2) ∧
      |LLsum Taper78.BHB.Ppoly y kk d 1 + (d : ℝ) / φ d * Taper78.BHB.Ppoly (1 - Real.log kk / Real.log y)|
        ≤ A * mobiusF (1 / 32) d * ((kk / y) ^ (1 / 32 : ℝ) + 1 / Real.log y) ∧
      |LLsum Taper78.BHB.Ppoly y kk d 2| ≤ A * mobiusF (1 / 32) d := by
  obtain ⟨A, hA⟩ := LLsum_asymp hM
  have hB : ∀ x ∈ Set.Icc (0 : ℝ) 1,
      |Taper78.BHB.Ppoly x| + |deriv Taper78.BHB.Ppoly x| + |deriv (deriv Taper78.BHB.Ppoly) x| ≤ 5 := by
    intro x hx
    rw [Taper78.BHB.MT.deriv_Ppoly, Taper78.BHB.MT.deriv_dPpoly]
    obtain ⟨h1, h2⟩ := Taper78.BHB.MT.Ppoly_mem hx.1 hx.2
    obtain ⟨h3, h4⟩ := Taper78.BHB.MT.dPpoly_mem hx.1 hx.2
    rw [abs_of_nonneg h1, abs_of_nonneg h3]
    norm_num
    linarith
  refine ⟨|A| * (5), by positivity, fun y hy kk hk1 hky d hd => ?_⟩
  obtain ⟨a0, a1, a2⟩ := hA Taper78.BHB.Ppoly (5) Taper78.BHB.MT.contDiff_Ppoly Taper78.BHB.MT.Ppoly_zero hB y hy kk hk1 hky d hd
  have hy0 : 0 < y := by linarith
  have hk0 : 0 < kk := by linarith
  have hly : 0 < Real.log y := Real.log_pos (by linarith)
  have hx : Real.log (y / kk) / Real.log y = 1 - Real.log kk / Real.log y := by
    rw [Real.log_div hy0.ne' hk0.ne']
    field_simp
  rw [hx, Taper78.BHB.MT.deriv_Ppoly] at a0
  rw [hx] at a1
  have hF : 0 ≤ mobiusF (1 / 32) d := (mobiusF_pos (by norm_num) d).le
  have hr : 0 ≤ (kk / y) ^ (1 / 32 : ℝ) := Real.rpow_nonneg (by positivity) _
  have hmono : ∀ t : ℝ, 0 ≤ t → A * (5) * mobiusF (1 / 32) d * t
      ≤ |A| * (5) * mobiusF (1 / 32) d * t := by
    intro t ht
    have : A ≤ |A| := le_abs_self A
    have h2 : 0 ≤ 5 * mobiusF (1 / 32) d * t := by positivity
    nlinarith
  refine ⟨le_trans a0 (hmono _ (by positivity)), le_trans a1 (hmono _ (by positivity)), ?_⟩
  have := hmono 1 zero_le_one
  simp only [mul_one] at this
  exact le_trans a2 this
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.LL_Ppoly_bound {C₀ : ℝ} (hM : MobiusHyp C₀) : ∃ A : ℝ, 0 ≤ A ∧ ∀ y : ℝ, 2 ≤ y → ∀ kk : ℝ,
    1 ≤ kk → kk ≤ y → ∀ d : ℕ, 1 ≤ d →
      |LLsum Taper78.BHB.Ppoly y kk d 0| ≤ A * ((d : ℝ) / φ d) * mobiusF (1 / 32) d / Real.log y ∧
      |LLsum Taper78.BHB.Ppoly y kk d 1| ≤ A * ((d : ℝ) / φ d) * mobiusF (1 / 32) d ∧
      |LLsum Taper78.BHB.Ppoly y kk d 2| ≤ A * mobiusF (1 / 32) d := by
  obtain ⟨A, hA0, hA⟩ := Taper78.BHB.MT.LL_Ppoly hM
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = 1 / Real.log 2 := ⟨_, rfl⟩
  have hc0 : 0 < c := by
    rw [hc]
    positivity
  refine ⟨2 + A * (1 + c), by positivity, fun y hy kk hk1 hky d hd => ?_⟩
  obtain ⟨a0, a1, a2⟩ := hA y hy kk hk1 hky d hd
  have hy0 : 0 < y := by linarith
  have hk0 : 0 < kk := by linarith
  have hly : 0 < Real.log y := Real.log_pos (by linarith)
  have hlyc : 1 / Real.log y ≤ c := by
    rw [hc]
    exact one_div_le_one_div_of_le hlog2 (Real.log_le_log (by norm_num) hy)
  have hN1 : 1 ≤ (d : ℝ) / φ d := one_le_div_totient hd
  have hF1 : 1 ≤ mobiusF (1 / 32) d := one_le_mobiusF (by norm_num) d
  have hlk0 : 0 ≤ Real.log kk := Real.log_nonneg hk1
  have hlk1 : Real.log kk ≤ Real.log y := Real.log_le_log hk0 hky
  have hx0 : 0 ≤ 1 - Real.log kk / Real.log y := by
    rw [sub_nonneg, div_le_one hly]
    exact hlk1
  have hx1 : 1 - Real.log kk / Real.log y ≤ 1 := by
    have : 0 ≤ Real.log kk / Real.log y := div_nonneg hlk0 hly.le
    linarith
  obtain ⟨hd0, hd1⟩ := Taper78.BHB.MT.dPpoly_mem hx0 hx1
  obtain ⟨hP0, hP1⟩ := Taper78.BHB.MT.Ppoly_mem hx0 hx1
  have hr0 : 0 ≤ (kk / y) ^ (1 / 32 : ℝ) := Real.rpow_nonneg (by positivity) _
  have hr1 : (kk / y) ^ (1 / 32 : ℝ) ≤ 1 :=
    Real.rpow_le_one (by positivity) ((div_le_one hy0).mpr hky) (by norm_num)
  generalize (d : ℝ) / φ d = N at *
  generalize mobiusF (1 / 32) d = F at *
  generalize 1 - Real.log kk / Real.log y = x at *
  generalize (kk / y) ^ (1 / 32 : ℝ) = r at *
  generalize Real.log y = ly at *
  have hN0 : 0 < N := by linarith
  have hF0 : 0 < F := by linarith
  have hNF : F ≤ N * F := by
    have := mul_le_mul_of_nonneg_right hN1 hF0.le
    linarith
  have hAF : A * F ≤ A * (N * F) := mul_le_mul_of_nonneg_left hNF hA0
  have hc1 : 0 ≤ A * (1 + c) := by positivity
  refine ⟨?_, ?_, ?_⟩
  · have h1 : |LLsum Taper78.BHB.Ppoly y kk d 0| ≤ |LLsum Taper78.BHB.Ppoly y kk d 0 - N * Taper78.BHB.MT.dPpoly x / ly|
        + |N * Taper78.BHB.MT.dPpoly x / ly| := by
      have := abs_add_le (LLsum Taper78.BHB.Ppoly y kk d 0 - N * Taper78.BHB.MT.dPpoly x / ly) (N * Taper78.BHB.MT.dPpoly x / ly)
      rwa [sub_add_cancel] at this
    have h2 : |N * Taper78.BHB.MT.dPpoly x / ly| ≤ 2 * (N * F / ly) := by
      rw [abs_of_nonneg (by positivity)]
      have h4 : Taper78.BHB.MT.dPpoly x ≤ 2 * F := by nlinarith
      calc N * Taper78.BHB.MT.dPpoly x / ly = N / ly * Taper78.BHB.MT.dPpoly x := by ring
        _ ≤ N / ly * (2 * F) := mul_le_mul_of_nonneg_left h4 (by positivity)
        _ = 2 * (N * F / ly) := by ring
    have h3 : A * F * (r / ly + 1 / ly ^ 2) ≤ A * (1 + c) * (N * F / ly) := by
      have e1 : r / ly + 1 / ly ^ 2 = (r + 1 / ly) * (1 / ly) := by
        field_simp
      have e2 : (r + 1 / ly) * (1 / ly) ≤ (1 + c) * (1 / ly) :=
        mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      calc A * F * (r / ly + 1 / ly ^ 2) = A * F * ((r + 1 / ly) * (1 / ly)) := by rw [e1]
        _ ≤ A * F * ((1 + c) * (1 / ly)) := mul_le_mul_of_nonneg_left e2 (by positivity)
        _ = A * (1 + c) * (1 / ly) * F := by ring
        _ ≤ A * (1 + c) * (1 / ly) * (N * F) := mul_le_mul_of_nonneg_left hNF (by positivity)
        _ = A * (1 + c) * (N * F / ly) := by ring
    calc |LLsum Taper78.BHB.Ppoly y kk d 0| ≤ A * F * (r / ly + 1 / ly ^ 2) + 2 * (N * F / ly) := by
          linarith
      _ ≤ A * (1 + c) * (N * F / ly) + 2 * (N * F / ly) := by linarith
      _ = (2 + A * (1 + c)) * N * F / ly := by ring
  · have h1 : |LLsum Taper78.BHB.Ppoly y kk d 1| ≤ |LLsum Taper78.BHB.Ppoly y kk d 1 + N * Taper78.BHB.Ppoly x|
        + |N * Taper78.BHB.Ppoly x| := by
      have := abs_sub (LLsum Taper78.BHB.Ppoly y kk d 1 + N * Taper78.BHB.Ppoly x) (N * Taper78.BHB.Ppoly x)
      rwa [add_sub_cancel_right] at this
    have h2 : |N * Taper78.BHB.Ppoly x| ≤ 2 * (N * F) := by
      rw [abs_of_nonneg (by positivity)]
      have h4 : Taper78.BHB.Ppoly x ≤ 2 * F := by nlinarith
      calc N * Taper78.BHB.Ppoly x ≤ N * (2 * F) := mul_le_mul_of_nonneg_left h4 hN0.le
        _ = 2 * (N * F) := by ring
    have h3 : A * F * (r + 1 / ly) ≤ A * (1 + c) * (N * F) := by
      calc A * F * (r + 1 / ly) ≤ A * F * (1 + c) :=
            mul_le_mul_of_nonneg_left (by linarith) (by positivity)
        _ = A * (1 + c) * F := by ring
        _ ≤ A * (1 + c) * (N * F) := mul_le_mul_of_nonneg_left hNF hc1
    calc |LLsum Taper78.BHB.Ppoly y kk d 1| ≤ A * F * (r + 1 / ly) + 2 * (N * F) := by linarith
      _ ≤ A * (1 + c) * (N * F) + 2 * (N * F) := by linarith
      _ = (2 + A * (1 + c)) * N * F := by ring
  · refine le_trans a2 ?_
    have h5 : A * 1 ≤ A * (1 + c) := mul_le_mul_of_nonneg_left (by linarith) hA0
    have h6 : A * F ≤ (2 + A * (1 + c)) * F :=
      mul_le_mul_of_nonneg_right (by linarith) hF0.le
    exact h6
end BHB.MT

namespace BHB.MT.PK
theorem _root_.Taper78.BHB.MT.PK.abs_dPpoly_le {θ T : ℝ} {k : ℕ} (st : Setup θ T k) : |Taper78.BHB.MT.dPpoly (xk θ T k)| ≤ 2 := by
  obtain ⟨h0, h1⟩ := Taper78.BHB.MT.dPpoly_mem st.hx0 st.hx1
  rw [abs_of_nonneg h0]
  exact h1
end BHB.MT.PK

namespace BHB.MT.PK
theorem _root_.Taper78.BHB.MT.PK.abs_Ppoly_le {θ T : ℝ} {k : ℕ} (st : Setup θ T k) : |Taper78.BHB.Ppoly (xk θ T k)| ≤ 1 := by
  obtain ⟨h0, h1⟩ := Taper78.BHB.MT.Ppoly_mem st.hx0 st.hx1
  rw [abs_of_nonneg h0]
  exact h1
end BHB.MT.PK

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.term1 (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) {C₀ : ℝ} (hM : MobiusHyp C₀) :
    ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T → ∀ k ∈ Krange θ T,
      |S2 w T k * LLsum Taper78.BHB.Ppoly (ymol θ T) k k 0
          - w.kap1 * Xk T k
            * ((L0 T + Real.log k) ^ 2 / 2 * Taper78.BHB.MT.dPpoly (xk θ T k) / Real.log (ymol θ T))|
        ≤ C * Xk T k * rho θ T k := by
  obtain ⟨C₂, T₂, h2⟩ := S2_asymp w
  obtain ⟨A, hA0, hA⟩ := Taper78.BHB.MT.LL_Ppoly hM
  obtain ⟨A', hA'0, hA'⟩ := Taper78.BHB.MT.LL_Ppoly_bound hM
  refine ⟨|C₂| * A' / θ + 2 * |w.kap1| * A / θ ^ 2, max T₂ (PK.T0 θ), fun T hT k hk => ?_⟩
  have st := PK.setup hθ hθ1 (le_trans (le_max_right _ _) hT) hk
  have W := st.wt hθ hθ1
  have a2 := h2 T (le_trans (le_max_left _ _) hT) k st.hk1 st.hkT
  rw [log_Xk st.hT0 st.hk1] at a2
  have hk1R : (1 : ℝ) ≤ k := by exact_mod_cast st.hk1
  obtain ⟨b0, -, -⟩ := hA (ymol θ T) st.hy2 k hk1R st.hky k st.hk1
  obtain ⟨c0, -, -⟩ := hA' (ymol θ T) st.hy2 k hk1R st.hky k st.hk1
  have a2' : |S2 w T k - (φ k : ℝ) / k * w.kap1 * Xk T k * (L0 T + Real.log k) ^ 2 / 2|
      ≤ |C₂| * Xk T k * Real.log T * s1 k := by
    refine le_trans a2 ?_
    have h0 : 0 ≤ Xk T k * Real.log T * s1 k :=
      mul_nonneg (mul_nonneg st.hX.le (by linarith [st.hL1])) (by linarith [st.hs])
    have := PK.le_abs_mul C₂ h0
    calc C₂ * Xk T k * Real.log T * s1 k = C₂ * (Xk T k * Real.log T * s1 k) := by ring
      _ ≤ |C₂| * (Xk T k * Real.log T * s1 k) := this
      _ = |C₂| * Xk T k * Real.log T * s1 k := by ring
  exact PK.term1_alg W (abs_nonneg _) hA0 hA'0 (PK.abs_Lam_le st) a2' b0 c0
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.term2 (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) {C₀ : ℝ} (hM : MobiusHyp C₀) :
    ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T → ∀ k ∈ Krange θ T,
      |S1 w T k * (Real.log k * LLsum Taper78.BHB.Ppoly (ymol θ T) k k 0 + LLsum Taper78.BHB.Ppoly (ymol θ T) k k 1)
          - w.kap1 * Xk T k
            * ((L0 T + Real.log k)
                * (Real.log k * Taper78.BHB.MT.dPpoly (xk θ T k) / Real.log (ymol θ T) - Taper78.BHB.Ppoly (xk θ T k)))|
        ≤ C * Xk T k * rho θ T k := by
  obtain ⟨C₁, T₁, h1⟩ := S1_asymp w
  obtain ⟨A, hA0, hA⟩ := Taper78.BHB.MT.LL_Ppoly hM
  obtain ⟨A', hA'0, hA'⟩ := Taper78.BHB.MT.LL_Ppoly_bound hM
  refine ⟨2 * |C₁| * A' + 3 * |mom1 (Hsym w.h)|
      + 4 * A * (|w.kap1| / θ + |mom1 (Hsym w.h)|), max T₁ (PK.T0 θ), fun T hT k hk => ?_⟩
  have st := PK.setup hθ hθ1 (le_trans (le_max_right _ _) hT) hk
  have W := st.wt hθ hθ1
  have a1 := h1 T (le_trans (le_max_left _ _) hT) k st.hk1 st.hkT
  rw [log_Xk st.hT0 st.hk1] at a1
  have hk1R : (1 : ℝ) ≤ k := by exact_mod_cast st.hk1
  obtain ⟨b0, b1, -⟩ := hA (ymol θ T) st.hy2 k hk1R st.hky k st.hk1
  obtain ⟨c0, Taper78.BHB.c1, -⟩ := hA' (ymol θ T) st.hy2 k hk1R st.hky k st.hk1
  have a1' : |S1 w T k - (φ k : ℝ) / k * Xk T k
        * (w.kap1 * (L0 T + Real.log k) + mom1 (Hsym w.h))| ≤ |C₁| * k :=
    le_trans a1 (PK.le_abs_mul C₁ (Nat.cast_nonneg k))
  exact Taper78.BHB.MT.PK.term2_alg W (abs_nonneg _) hA0 hA'0 (PK.abs_Lam_le st) st.hv0 st.hv1
    (Taper78.BHB.MT.PK.abs_dPpoly_le st) (Taper78.BHB.MT.PK.abs_Ppoly_le st) a1' b0 b1 c0 Taper78.BHB.c1
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.term3 (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) {C₀ : ℝ} (hM : MobiusHyp C₀) :
    ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T → ∀ k ∈ Krange θ T,
      |S0 w T k * (Real.log k * LLsum Taper78.BHB.Ppoly (ymol θ T) k k 1 + LLsum Taper78.BHB.Ppoly (ymol θ T) k k 2)
          + w.kap1 * Xk T k * (Real.log k * Taper78.BHB.Ppoly (xk θ T k))|
        ≤ C * Xk T k * rho θ T k := by
  obtain ⟨C₀', h0⟩ := S0_asymp w
  obtain ⟨A, hA0, hA⟩ := Taper78.BHB.MT.LL_Ppoly hM
  obtain ⟨A', hA'0, hA'⟩ := Taper78.BHB.MT.LL_Ppoly_bound hM
  refine ⟨7 * |C₀'| * (A' + A) + 2 * |w.kap1| * A, PK.T0 θ, fun T hT k hk => ?_⟩
  have st := PK.setup hθ hθ1 hT hk
  have W := st.wt hθ hθ1
  have a0 := h0 T st.hT0 k st.hk1
  have hk1R : (1 : ℝ) ≤ k := by exact_mod_cast st.hk1
  obtain ⟨-, b1, b2⟩ := hA (ymol θ T) st.hy2 k hk1R st.hky k st.hk1
  obtain ⟨-, Taper78.BHB.c1, -⟩ := hA' (ymol θ T) st.hy2 k hk1R st.hky k st.hk1
  have a0' : |S0 w T k - (φ k : ℝ) / k * w.kap1 * Xk T k| ≤ |C₀'| * k :=
    le_trans a0 (PK.le_abs_mul C₀' (Nat.cast_nonneg k))
  exact PK.term3_alg W (abs_nonneg _) hA0 hA'0 st.hv0 st.hv1 a0' b1 b2 Taper78.BHB.c1
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.term4a (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) {C₀ : ℝ} (hM : MobiusHyp C₀) :
    ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T → ∀ k ∈ Krange θ T,
      |Taper78.BHB.MT.T4 w θ T k + w.kap1 * Xk T k / Real.log (ymol θ T)
          * ∑ p ∈ (Finset.Icc 1 ⌊ymol θ T / k⌋₊).filter (fun p => p.Prime ∧ ¬ p ∣ k),
              vp p * Taper78.BHB.MT.dPpoly (xk θ T k - Real.log p / Real.log (ymol θ T))|
        ≤ C * Xk T k * rho θ T k := by
  obtain ⟨C0, h0⟩ := S0_asymp w
  obtain ⟨Cp, hCp⟩ := Sp_asymp w
  obtain ⟨A, hA0, hA⟩ := Taper78.BHB.MT.LL_Ppoly hM
  obtain ⟨A', hA'0, hA'⟩ := Taper78.BHB.MT.LL_Ppoly_bound hM
  obtain ⟨As, hAs⟩ := sum_primes_log_sq_div_le
  refine ⟨168 * (|C0| + |Cp|) * A' * |As| + 36 * |w.kap1| * A * |As|, PK.T0 θ,
    fun T hT k hk => ?_⟩
  have st := PK.setup hθ hθ1 hT hk
  have W := st.wt hθ hθ1
  have hk1 := st.hk1
  have hk0 : (0 : ℝ) < k := by exact_mod_cast hk1
  have hk1R : (1 : ℝ) ≤ k := by exact_mod_cast hk1
  have hy0 : 0 < ymol θ T := by linarith [st.hy2]
  have hly0 : 0 < Real.log (ymol θ T) := by linarith [st.hly1]
  have hCs : 0 ≤ |C0| + |Cp| := by positivity
  have hF0 : 0 < mobiusF (1 / 32) k := mobiusF_pos (by norm_num) k
  have hz1 : 1 ≤ ymol θ T / k := by
    rw [le_div_iff₀ hk0]
    linarith [st.hky]

  have hterm : ∀ p ∈ (Finset.Icc 1 ⌊ymol θ T / k⌋₊).filter (fun p => p.Prime ∧ ¬ p ∣ k),
      |Real.log p ^ 2 * (S0 w T k + Sp w T k p)
          * (-(1 / (p : ℝ)) * LLsum Taper78.BHB.Ppoly (ymol θ T) ((k : ℝ) * p) (k * p) 0)
        + w.kap1 * Xk T k / Real.log (ymol θ T)
          * (vp p * Taper78.BHB.MT.dPpoly (xk θ T k - Real.log p / Real.log (ymol θ T)))|
      ≤ Real.log p ^ 2 / p
          * (6 * (|C0| + |Cp|) * A' * ((k : ℝ) / φ k) * mobiusF (1 / 32) k * k
            / Real.log (ymol θ T))
        + (Real.log p ^ 2 / p * ((p : ℝ) / (ymol θ T / k)) ^ (1 / 32 : ℝ))
          * (6 * |w.kap1| * A * Xk T k * mobiusF (1 / 32) k / Real.log (ymol θ T))
        + Real.log p ^ 2 / p
          * (6 * |w.kap1| * A * Xk T k * mobiusF (1 / 32) k / Real.log (ymol θ T) ^ 2) := by
    intro p hpP
    obtain ⟨hpI, hpp, hpk⟩ := Finset.mem_filter.mp hpP
    have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hpp.two_le
    have hp0 : (0 : ℝ) < p := by linarith
    have hp1 : (0 : ℝ) < (p : ℝ) - 1 := by linarith
    have hpz : (p : ℝ) ≤ ymol θ T / k :=
      le_trans (Nat.cast_le.mpr (Finset.mem_Icc.mp hpI).2) (Nat.floor_le (by positivity))
    have hkpy : (k : ℝ) * p ≤ ymol θ T := by
      rw [le_div_iff₀ hk0] at hpz
      linarith
    have hkp1 : (1 : ℝ) ≤ (k : ℝ) * p := by nlinarith
    have hkpn : 1 ≤ k * p :=
      Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) hpp.ne_zero)
    obtain ⟨b0, -, -⟩ := hA (ymol θ T) st.hy2 ((k : ℝ) * p) hkp1 hkpy (k * p) hkpn
    obtain ⟨c0, -, -⟩ := hA' (ymol θ T) st.hy2 ((k : ℝ) * p) hkp1 hkpy (k * p) hkpn
    rw [div_totient_mul_prime hk1 hpp hpk] at b0 c0
    have hxp : 1 - Real.log ((k : ℝ) * p) / Real.log (ymol θ T)
        = xk θ T k - Real.log p / Real.log (ymol θ T) := by
      unfold xk
      rw [Real.log_mul hk0.ne' hp0.ne']
      ring
    have hrp : (k : ℝ) * p / ymol θ T = (p : ℝ) / (ymol θ T / k) := by
      field_simp
    rw [hxp, hrp] at b0
    have hFp := mobiusF_mul_prime_le hk1 hpp hpk
    have hrp0 : 0 ≤ ((p : ℝ) / (ymol θ T / k)) ^ (1 / 32 : ℝ) :=
      Real.rpow_nonneg (by positivity) _
    have hNq : 0 ≤ (k : ℝ) / φ k * ((p : ℝ) / ((p : ℝ) - 1)) := by positivity
    have b0' : |LLsum Taper78.BHB.Ppoly (ymol θ T) ((k : ℝ) * p) (k * p) 0
          - (k : ℝ) / φ k * ((p : ℝ) / ((p : ℝ) - 1))
            * Taper78.BHB.MT.dPpoly (xk θ T k - Real.log p / Real.log (ymol θ T)) / Real.log (ymol θ T)|
        ≤ A * (3 * mobiusF (1 / 32) k)
          * (((p : ℝ) / (ymol θ T / k)) ^ (1 / 32 : ℝ) / Real.log (ymol θ T)
            + 1 / Real.log (ymol θ T) ^ 2) := by
      refine le_trans b0 ?_
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hFp hA0) (by positivity)
    have c0' : |LLsum Taper78.BHB.Ppoly (ymol θ T) ((k : ℝ) * p) (k * p) 0|
        ≤ A' * ((k : ℝ) / φ k * ((p : ℝ) / ((p : ℝ) - 1))) * (3 * mobiusF (1 / 32) k)
          / Real.log (ymol θ T) := by
      refine le_trans c0 ?_
      exact div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_left hFp (mul_nonneg hA'0 hNq)) hly0.le
    have hq1 : 1 ≤ (p : ℝ) / ((p : ℝ) - 1) := by
      rw [le_div_iff₀ hp1]
      linarith
    have hq2 : (p : ℝ) / ((p : ℝ) - 1) ≤ 2 := by
      rw [div_le_iff₀ hp1]
      linarith
    have hS : |S0 w T k + Sp w T k p
          - (φ k : ℝ) / k * w.kap1 * Xk T k * ((p : ℝ) / ((p : ℝ) - 1))|
        ≤ (|C0| + |Cp|) * k := by
      have e : S0 w T k + Sp w T k p
            - (φ k : ℝ) / k * w.kap1 * Xk T k * ((p : ℝ) / ((p : ℝ) - 1))
          = (S0 w T k - (φ k : ℝ) / k * w.kap1 * Xk T k)
            + (Sp w T k p - (φ k : ℝ) / k * w.kap1 * Xk T k / ((p : ℝ) - 1)) := by
        field_simp
        ring
      rw [e]
      have a0 := le_trans (h0 T st.hT0 k hk1) (PK.le_abs_mul C0 hk0.le)
      have ap := le_trans (hCp T st.hT0 k hk1 p hpp hpk) (PK.le_abs_mul Cp hk0.le)
      have := abs_add_le (S0 w T k - (φ k : ℝ) / k * w.kap1 * Xk T k)
        (Sp w T k p - (φ k : ℝ) / k * w.kap1 * Xk T k / ((p : ℝ) - 1))
      linarith
    have hvp : vp p = Real.log p ^ 2 * ((p : ℝ) / ((p : ℝ) - 1)) ^ 2 / p := by
      unfold vp
      field_simp
    exact PK.term4a_alg W hCs hA0 hA'0 hp0 hq1 hq2 (sq_nonneg _) hrp0 hvp hS b0' c0'

  unfold Taper78.BHB.MT.T4
  rw [Finset.mul_sum, ← Finset.sum_add_distrib]
  refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
  refine le_trans (Finset.sum_le_sum hterm) ?_
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.sum_mul,
    ← Finset.sum_mul]
  have hsub : (Finset.Icc 1 ⌊ymol θ T / k⌋₊).filter (fun p => p.Prime ∧ ¬ p ∣ k)
      ⊆ (Finset.Icc 1 ⌊ymol θ T / k⌋₊).filter Nat.Prime := by
    intro p hp
    rw [Finset.mem_filter] at hp ⊢
    exact ⟨hp.1, hp.2.1⟩
  obtain ⟨s1', s2'⟩ := hAs (ymol θ T / k) hz1
  have hlz0 : 0 ≤ Real.log (ymol θ T / k) := Real.log_nonneg hz1
  have hlz : Real.log (ymol θ T / k) ≤ Real.log (ymol θ T) := by
    apply Real.log_le_log (by positivity)
    rw [div_le_iff₀ hk0]
    nlinarith
  have hSa : ∑ p ∈ (Finset.Icc 1 ⌊ymol θ T / k⌋₊).filter (fun p => p.Prime ∧ ¬ p ∣ k),
        Real.log p ^ 2 / p ≤ |As| * (1 + Real.log (ymol θ T / k)) ^ 2 := by
    refine le_trans (Finset.sum_le_sum_of_subset_of_nonneg hsub ?_)
      (le_trans s1' (PK.le_abs_mul As (sq_nonneg _)))
    intro p _ _
    positivity
  have hSb : ∑ p ∈ (Finset.Icc 1 ⌊ymol θ T / k⌋₊).filter (fun p => p.Prime ∧ ¬ p ∣ k),
        Real.log p ^ 2 / p * ((p : ℝ) / (ymol θ T / k)) ^ (1 / 32 : ℝ)
      ≤ |As| * (1 + Real.log (ymol θ T / k)) := by
    refine le_trans (Finset.sum_le_sum_of_subset_of_nonneg hsub ?_)
      (le_trans s2' (PK.le_abs_mul As (by linarith)))
    intro p _ _
    have : 0 ≤ ((p : ℝ) / (ymol θ T / k)) ^ (1 / 32 : ℝ) := Real.rpow_nonneg (by positivity) _
    positivity
  exact PK.term4a_sum_alg W hCs hA0 hA'0 (abs_nonneg As) hlz0 hlz hSa hSb
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.term4b {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) :
    ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T → ∀ k ∈ Krange θ T,
      |∑ p ∈ (Finset.Icc 1 ⌊ymol θ T / k⌋₊).filter (fun p => p.Prime ∧ ¬ p ∣ k),
            vp p * Taper78.BHB.MT.dPpoly (xk θ T k - Real.log p / Real.log (ymol θ T))
          - Real.log (ymol θ T) ^ 2 * Taper78.BHB.MT.PPpoly (xk θ T k)|
        ≤ C * Real.log (ymol θ T) := by
  obtain ⟨A, hA⟩ := sum_prime_weight
  refine ⟨6 * |A|, PK.T0 θ, fun T hT k hk => ?_⟩
  have st := PK.setup hθ hθ1 hT hk
  have hk1 := st.hk1
  have hk0 : (0 : ℝ) < k := by exact_mod_cast hk1
  have hy0 : 0 < ymol θ T := by linarith [st.hy2]
  have hly1 := st.hly1
  have hv0 := st.hv0
  have hv1 := st.hv1
  set ly := Real.log (ymol θ T) with hly
  set v := Real.log (k : ℝ) with hv
  set x := xk θ T k with hx
  have hxdef : x = 1 - v / ly := rfl
  set V := Real.log (ymol θ T / k) with hV
  have hVdef : V = ly - v := Real.log_div hy0.ne' hk0.ne'
  have hly0 : 0 < ly := by linarith
  have hVx : V = x * ly := by
    rw [hVdef, hxdef]
    field_simp
  have hV0 : 0 ≤ V := by
    rw [hVdef]
    linarith
  have hexp : Real.exp V = ymol θ T / k := Real.exp_log (by positivity)

  have hGc : ContDiff ℝ 1 (fun s : ℝ => Taper78.BHB.MT.dPpoly (x - s / ly)) := by
    unfold Taper78.BHB.MT.dPpoly
    fun_prop
  have hGd : ∀ s : ℝ, HasDerivAt (fun s : ℝ => Taper78.BHB.MT.dPpoly (x - s / ly)) (1.56 / ly) s := by
    intro s
    have h1 : HasDerivAt (fun s : ℝ => x - s / ly) (-(1 / ly)) s :=
      ((hasDerivAt_id' s).div_const ly).const_sub x
    have h2 := (Taper78.BHB.MT.hasDerivAt_dPpoly (x - s / ly)).comp s h1
    have h3 : HasDerivAt (Taper78.BHB.MT.dPpoly ∘ fun s : ℝ => x - s / ly) (1.56 / ly) s :=
      h2.congr_deriv (by ring)
    exact h3
  have hM : ∀ s ∈ Set.Icc 0 V, |Taper78.BHB.MT.dPpoly (x - s / ly)| ≤ 2 := by
    intro s hs
    have h1 : 0 ≤ x - s / ly := by
      rw [sub_nonneg, div_le_iff₀ hly0, ← hVx]
      exact hs.2
    have h2 : x - s / ly ≤ 1 := by
      have h3 : 0 ≤ s / ly := div_nonneg hs.1 hly0.le
      have h4 : x ≤ 1 := st.hx1
      linarith
    obtain ⟨h3, h4⟩ := Taper78.BHB.MT.dPpoly_mem h1 h2
    rw [abs_of_nonneg h3]
    exact h4
  have hM1 : ∀ s ∈ Set.Icc 0 V, |deriv (fun s : ℝ => Taper78.BHB.MT.dPpoly (x - s / ly)) s| ≤ 1.56 / ly := by
    intro s _
    rw [(hGd s).deriv, abs_of_nonneg (by positivity)]
  have h := hA k hk1 (fun s : ℝ => Taper78.BHB.MT.dPpoly (x - s / ly)) hGc V (2) (1.56 / ly) hV0 hM hM1
  rw [hexp] at h

  have hint : ∫ s in (0 : ℝ)..V, s * Taper78.BHB.MT.dPpoly (x - s / ly) = ly ^ 2 * Taper78.BHB.MT.PPpoly x := by
    have hΦ : ∀ s ∈ Set.uIcc 0 V,
        HasDerivAt (fun s : ℝ => (1.78 - 1.56*x) / 2 * s ^ 2 + s ^ 3 / (3 * ly / 1.56))
          (s * Taper78.BHB.MT.dPpoly (x - s / ly)) s := by
      intro s _
      have h1 := ((hasDerivAt_pow 2 s).const_mul ((1.78 - 1.56*x) / 2)).fun_add
        ((hasDerivAt_pow 3 s).div_const (3 * ly / 1.56))
      refine h1.congr_deriv ?_
      unfold Taper78.BHB.MT.dPpoly
      norm_num
      field_simp
      ring
    have hcont : Continuous (fun s : ℝ => s * Taper78.BHB.MT.dPpoly (x - s / ly)) := by
      unfold Taper78.BHB.MT.dPpoly
      fun_prop
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hΦ (hcont.intervalIntegrable _ _)]
    rw [hVx]
    unfold Taper78.BHB.MT.PPpoly
    field_simp
    ring
  rw [hint] at h
  have hbound : A * (2 * (1 + V + v) + 1.56 / ly * V ^ 2) ≤ 6 * |A| * ly := by
    have h2 : V ≤ ly := by
      rw [hVdef]
      linarith
    have h3 : 1.56 / ly * V ^ 2 ≤ 1.56*ly := by
      rw [div_mul_eq_mul_div, div_le_iff₀ hly0]
      nlinarith
    have h4 : V + v = ly := by
      rw [hVdef]
      ring
    have h1 : 2 * (1 + V + v) + 1.56 / ly * V ^ 2 ≤ 6 * ly := by linarith
    have h0 : 0 ≤ 2 * (1 + V + v) + 1.56 / ly * V ^ 2 := by positivity
    calc A * (2 * (1 + V + v) + 1.56 / ly * V ^ 2)
        ≤ |A| * (2 * (1 + V + v) + 1.56 / ly * V ^ 2) := PK.le_abs_mul A h0
      _ ≤ |A| * (6 * ly) := mul_le_mul_of_nonneg_left h1 (abs_nonneg _)
      _ = 6 * |A| * ly := by ring
  exact le_trans h hbound
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.term4 (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) {C₀ : ℝ} (hM : MobiusHyp C₀) :
    ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T → ∀ k ∈ Krange θ T,
      |Taper78.BHB.MT.T4 w θ T k + w.kap1 * Xk T k * (Real.log (ymol θ T) * Taper78.BHB.MT.PPpoly (xk θ T k))|
        ≤ C * Xk T k * rho θ T k := by
  obtain ⟨C₁, T₁, h1⟩ := Taper78.BHB.MT.term4a w hθ hθ1 hM
  obtain ⟨C₂, T₂, h2⟩ := Taper78.BHB.MT.term4b hθ hθ1
  refine ⟨C₁ + |w.kap1| * |C₂|, max (max T₁ T₂) (Real.exp (1 / θ)), fun T hT k hk => ?_⟩
  have hT1 : T₁ ≤ T := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hT
  have hT2 : T₂ ≤ T := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hT
  have hTe : Real.exp (1 / θ) ≤ T := le_trans (le_max_right _ _) hT
  have hT0 : 0 < T := lt_of_lt_of_le (Real.exp_pos _) hTe
  have hTone : 1 ≤ T := le_trans (Real.one_le_exp (by positivity)) hTe

  have hly : 1 ≤ Real.log (ymol θ T) := by
    rw [log_ymol hT0]
    have h : 1 / θ ≤ Real.log T := by
      rw [Real.le_log_iff_exp_le hT0]
      exact hTe
    calc (1 : ℝ) = θ * (1 / θ) := by field_simp
      _ ≤ θ * Real.log T := mul_le_mul_of_nonneg_left h hθ.le
  have hly0 : Real.log (ymol θ T) ≠ 0 := by linarith
  have hk1 : 1 ≤ k := (mem_Krange.mp hk).1
  have hX : 0 ≤ Xk T k := (Xk_pos hT0 hk1).le
  have hρ : 1 ≤ rho θ T k := one_le_rho hTone hk1
  have a := h1 T hT1 k hk
  have b := h2 T hT2 k hk
  set Sg := ∑ p ∈ (Finset.Icc 1 ⌊ymol θ T / k⌋₊).filter (fun p => p.Prime ∧ ¬ p ∣ k),
    vp p * Taper78.BHB.MT.dPpoly (xk θ T k - Real.log p / Real.log (ymol θ T)) with hSg
  set ly := Real.log (ymol θ T) with hlydef
  have e : Taper78.BHB.MT.T4 w θ T k + w.kap1 * Xk T k * (ly * Taper78.BHB.MT.PPpoly (xk θ T k))
      = (Taper78.BHB.MT.T4 w θ T k + w.kap1 * Xk T k / ly * Sg)
        - w.kap1 * Xk T k / ly * (Sg - ly ^ 2 * Taper78.BHB.MT.PPpoly (xk θ T k)) := by
    field_simp
    ring
  rw [e]
  have hb' : |w.kap1 * Xk T k / ly * (Sg - ly ^ 2 * Taper78.BHB.MT.PPpoly (xk θ T k))|
      ≤ |w.kap1| * |C₂| * Xk T k := by
    rw [abs_mul, abs_div, abs_mul, abs_of_nonneg hX, abs_of_pos (by linarith : (0 : ℝ) < ly)]
    have hb2 : |Sg - ly ^ 2 * Taper78.BHB.MT.PPpoly (xk θ T k)| ≤ |C₂| * ly :=
      le_trans b (mul_le_mul_of_nonneg_right (le_abs_self _) (by linarith))
    calc |w.kap1| * Xk T k / ly * |Sg - ly ^ 2 * Taper78.BHB.MT.PPpoly (xk θ T k)|
        ≤ |w.kap1| * Xk T k / ly * (|C₂| * ly) :=
          mul_le_mul_of_nonneg_left hb2 (by positivity)
      _ = |w.kap1| * |C₂| * Xk T k := by
          field_simp
  have hC₂ : 0 ≤ |w.kap1| * |C₂| * Xk T k := by positivity
  calc |(Taper78.BHB.MT.T4 w θ T k + w.kap1 * Xk T k / ly * Sg)
        - w.kap1 * Xk T k / ly * (Sg - ly ^ 2 * Taper78.BHB.MT.PPpoly (xk θ T k))|
      ≤ |Taper78.BHB.MT.T4 w θ T k + w.kap1 * Xk T k / ly * Sg|
        + |w.kap1 * Xk T k / ly * (Sg - ly ^ 2 * Taper78.BHB.MT.PPpoly (xk θ T k))| := abs_sub _ _
    _ ≤ C₁ * Xk T k * rho θ T k + |w.kap1| * |C₂| * Xk T k := add_le_add a hb'
    _ ≤ C₁ * Xk T k * rho θ T k + |w.kap1| * |C₂| * Xk T k * rho θ T k := by
        have := mul_le_mul_of_nonneg_left hρ hC₂
        rw [mul_one] at this
        linarith
    _ = (C₁ + |w.kap1| * |C₂|) * Xk T k * rho θ T k := by ring
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.Ik_asymp (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) {C₀ : ℝ} (hM : MobiusHyp C₀) :
    ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T → ∀ k ∈ Krange θ T,
      |Taper78.BHB.MT.Ik w θ T k
          - w.kap1 * Xk T k * Taper78.BHB.MT.Wmain (L0 T) (Real.log (ymol θ T)) (Real.log k)|
        ≤ C * Xk T k * rho θ T k := by
  obtain ⟨C₁, T₁, h1⟩ := Taper78.BHB.MT.term1 w hθ hθ1 hM
  obtain ⟨C₂, T₂, h2⟩ := Taper78.BHB.MT.term2 w hθ hθ1 hM
  obtain ⟨C₃, T₃, h3⟩ := Taper78.BHB.MT.term3 w hθ hθ1 hM
  obtain ⟨C₄, T₄, h4⟩ := Taper78.BHB.MT.term4 w hθ hθ1 hM
  refine ⟨C₁ + C₂ + C₃ + C₄, max (max (max T₁ T₂) (max T₃ T₄)) 1, fun T hT k hk => ?_⟩
  have hT1 : T₁ ≤ T :=
    le_trans (le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) (le_max_left _ _)) hT
  have hT2 : T₂ ≤ T :=
    le_trans (le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) (le_max_left _ _)) hT
  have hT3 : T₃ ≤ T :=
    le_trans (le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) (le_max_left _ _)) hT
  have hT4 : T₄ ≤ T :=
    le_trans (le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) (le_max_left _ _)) hT
  have hT0 : 0 < T := lt_of_lt_of_le one_pos (le_trans (le_max_right _ _) hT)
  have hk1 : 1 ≤ k := (mem_Krange.mp hk).1
  have a1 := h1 T hT1 k hk
  have a2 := h2 T hT2 k hk
  have a3 := h3 T hT3 k hk
  have a4 := h4 T hT4 k hk
  rw [Taper78.BHB.MT.Ik_eq w θ hT0 hk1]
  set y := ymol θ T with hy
  set ly := Real.log y with hly
  set v := Real.log (k : ℝ) with hv
  set X := Xk T k with hXdef
  set κ := w.kap1 with hκ
  set t1 := S2 w T k * LLsum Taper78.BHB.Ppoly y k k 0 with ht1
  set t2 := S1 w T k * (v * LLsum Taper78.BHB.Ppoly y k k 0 + LLsum Taper78.BHB.Ppoly y k k 1) with ht2
  set t3 := S0 w T k * (v * LLsum Taper78.BHB.Ppoly y k k 1 + LLsum Taper78.BHB.Ppoly y k k 2) with ht3
  set t4 := Taper78.BHB.MT.T4 w θ T k with ht4
  have hx : xk θ T k = 1 - v / ly := rfl
  rw [hx] at a1 a2 a3 a4
  have e : t1 - t2 - t3 + t4 - κ * X * Taper78.BHB.MT.Wmain (L0 T) ly v
      = (t1 - κ * X * ((L0 T + v) ^ 2 / 2 * Taper78.BHB.MT.dPpoly (1 - v / ly) / ly))
        - (t2 - κ * X * ((L0 T + v) * (v * Taper78.BHB.MT.dPpoly (1 - v / ly) / ly - Taper78.BHB.Ppoly (1 - v / ly))))
        - (t3 + κ * X * (v * Taper78.BHB.Ppoly (1 - v / ly)))
        + (t4 + κ * X * (ly * Taper78.BHB.MT.PPpoly (1 - v / ly))) := by
    unfold Taper78.BHB.MT.Wmain
    ring
  rw [e]
  have tri : ∀ a b c d : ℝ, |a - b - c + d| ≤ |a| + |b| + |c| + |d| := by
    intro a b c d
    calc |a - b - c + d| ≤ |a - b - c| + |d| := abs_add_le _ _
      _ ≤ |a - b| + |c| + |d| := by
          have := abs_sub (a - b) c
          linarith
      _ ≤ |a| + |b| + |c| + |d| := by
          have := abs_sub a b
          linarith
  refine le_trans (tri _ _ _ _) ?_
  have : (C₁ + C₂ + C₃ + C₄) * X * rho θ T k
      = C₁ * X * rho θ T k + C₂ * X * rho θ T k + C₃ * X * rho θ T k + C₄ * X * rho θ T k := by
    ring
  rw [this]
  exact add_le_add (add_le_add (add_le_add a1 a2) a3) a4
end BHB.MT
end
end Src_Taper78FirstPerK

section Src_Taper78FirstSumK

/- Adapted from BHB.MainT1.SumK by Kristian Muri Knausgård with Claude.
The bounds and polynomial identities here use LowBand.taper78. -/
noncomputable section
open MeasureTheory 
open scoped BigOperators ArithmeticFunction ArithmeticFunction.Moebius Nat Real

namespace BHB.MT.SK
def _root_.Taper78.BHB.MT.SK.Wder (L₀ ly v : ℝ) : ℝ :=
  -v * Taper78.BHB.MT.dPpoly (1 - v / ly) / ly + 1.56 * ((L₀ ^ 2 - v ^ 2) / 2 / ly ^ 2) + 3 * Taper78.BHB.Ppoly (1 - v / ly)
    - (L₀ + 2 * v) * Taper78.BHB.MT.dPpoly (1 - v / ly) / ly
end BHB.MT.SK

namespace BHB.MT.SK
theorem _root_.Taper78.BHB.MT.SK.hasDerivAt_Wmain (L₀ : ℝ) {ly : ℝ} (hly : ly ≠ 0) (v : ℝ) :
    HasDerivAt (Taper78.BHB.MT.Wmain L₀ ly) (Taper78.BHB.MT.SK.Wder L₀ ly v) v := by
  have hx : HasDerivAt (fun v : ℝ => 1 - v / ly) (-(1 / ly)) v := by
    have h := ((hasDerivAt_id' v).div_const ly).const_sub 1
    exact h.congr_deriv (by ring)
  have hdP : HasDerivAt (fun v : ℝ => Taper78.BHB.MT.dPpoly (1 - v / ly)) (-1.56 * -(1 / ly)) v := by
    have := (Taper78.BHB.MT.hasDerivAt_dPpoly (1 - v / ly)).comp v hx
    exact this
  have hP : HasDerivAt (fun v : ℝ => Taper78.BHB.Ppoly (1 - v / ly)) (Taper78.BHB.MT.dPpoly (1 - v / ly) * -(1 / ly)) v := by
    have := (Taper78.BHB.MT.hasDerivAt_Ppoly (1 - v / ly)).comp v hx
    exact this
  have hPP : HasDerivAt (fun v : ℝ => Taper78.BHB.MT.PPpoly (1 - v / ly)) (Taper78.BHB.Ppoly (1 - v / ly) * -(1 / ly)) v := by
    have := (Taper78.BHB.MT.hasDerivAt_PPpoly (1 - v / ly)).comp v hx
    exact this
  have hsq : HasDerivAt (fun v : ℝ => v ^ 2) ((2 : ℕ) * v ^ (2 - 1) * 1) v :=
    (hasDerivAt_id' v).pow 2
  have hA : HasDerivAt (fun v : ℝ => (1 / (2 * ly) : ℝ) * (L₀ ^ 2 - v ^ 2))
      ((1 / (2 * ly) : ℝ) * (0 - (2 : ℕ) * v ^ (2 - 1) * 1)) v :=
    ((hasDerivAt_const v (L₀ ^ 2)).fun_sub hsq).const_mul _
  have hB : HasDerivAt (fun v : ℝ => L₀ + 2 * v) (2 * 1) v :=
    ((hasDerivAt_id' v).const_mul 2).const_add L₀
  have h := ((hA.fun_mul hdP).fun_add (hB.fun_mul hP)).fun_sub (hPP.const_mul ly)
  have e : Taper78.BHB.MT.Wmain L₀ ly = fun v : ℝ =>
      (1 / (2 * ly) : ℝ) * (L₀ ^ 2 - v ^ 2) * Taper78.BHB.MT.dPpoly (1 - v / ly)
        + (L₀ + 2 * v) * Taper78.BHB.Ppoly (1 - v / ly) - ly * Taper78.BHB.MT.PPpoly (1 - v / ly) := by
    funext v
    unfold Taper78.BHB.MT.Wmain
    field_simp
    ring
  rw [e]
  refine h.congr_deriv ?_
  unfold Taper78.BHB.MT.SK.Wder
  field_simp
  ring
end BHB.MT.SK

namespace BHB.MT.SK
theorem _root_.Taper78.BHB.MT.SK.Wmain_Wder_abs_le {θ L L₀ v : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) (hL : 1 / θ ≤ L)
    (hL0 : 0 ≤ L₀) (hL0L : L₀ ≤ L) (hv0 : 0 ≤ v) (hv1 : v ≤ θ * L) :
    |Taper78.BHB.MT.Wmain L₀ (θ * L) v| ≤ (10 + 10 / θ + 1 / θ ^ 2) * L ∧
      |Taper78.BHB.MT.SK.Wder L₀ (θ * L) v| ≤ 10 + 10 / θ + 1 / θ ^ 2 := by
  have hr0 : 0 < 1 / θ := by positivity
  have hLpos : 0 < L := lt_of_lt_of_le hr0 hL
  obtain ⟨ly, hly⟩ : ∃ ly : ℝ, ly = θ * L := ⟨_, rfl⟩
  rw [← hly] at hv1 ⊢
  have hly0 : 0 < ly := by rw [hly]; positivity
  have hlyL : ly ≤ L := by rw [hly]; nlinarith
  have hvL : v ≤ L := le_trans hv1 hlyL

  have hq0 : 0 ≤ v / ly := div_nonneg hv0 hly0.le
  have hq1 : v / ly ≤ 1 := (div_le_one hly0).mpr hv1
  obtain ⟨hP0, hP1⟩ := Taper78.BHB.MT.Ppoly_mem (sub_nonneg.mpr hq1) (by linarith : 1 - v / ly ≤ 1)
  obtain ⟨hD0, hD1⟩ := Taper78.BHB.MT.dPpoly_mem (sub_nonneg.mpr hq1) (by linarith : 1 - v / ly ≤ 1)
  obtain ⟨hQ0, hQ1⟩ := Taper78.BHB.MT.PPpoly_mem (sub_nonneg.mpr hq1) (by linarith : 1 - v / ly ≤ 1)

  have hLly : L / ly = 1 / θ := by
    rw [hly]
    field_simp
  have hLly2 : L ^ 2 / ly ^ 2 = 1 / θ ^ 2 := by
    rw [hly]
    field_simp
  have hL0ly : L₀ / ly ≤ 1 / θ := by
    rw [← hLly]
    exact div_le_div_of_nonneg_right hL0L hly0.le
  have hL0ly0 : 0 ≤ L₀ / ly := div_nonneg hL0 hly0.le

  have ha : |(L₀ ^ 2 - v ^ 2) / 2| ≤ L ^ 2 / 2 := by
    rw [abs_le]
    constructor <;> nlinarith
  have hD : |Taper78.BHB.MT.dPpoly (1 - v / ly)| ≤ 2 := by
    rw [abs_of_nonneg hD0]
    exact hD1
  constructor
  ·
    have e : Taper78.BHB.MT.Wmain L₀ ly v = (L₀ ^ 2 - v ^ 2) / 2 * Taper78.BHB.MT.dPpoly (1 - v / ly) / ly
        + (L₀ + 2 * v) * Taper78.BHB.Ppoly (1 - v / ly) - ly * Taper78.BHB.MT.PPpoly (1 - v / ly) := by
      unfold Taper78.BHB.MT.Wmain
      ring
    have t1 : |(L₀ ^ 2 - v ^ 2) / 2 * Taper78.BHB.MT.dPpoly (1 - v / ly) / ly| ≤ 1 * (1 / θ) * L := by
      rw [abs_div, abs_mul, abs_of_pos hly0]
      calc |(L₀ ^ 2 - v ^ 2) / 2| * |Taper78.BHB.MT.dPpoly (1 - v / ly)| / ly
          ≤ L ^ 2 / 2 * (2) / ly := by
            apply div_le_div_of_nonneg_right _ hly0.le
            exact mul_le_mul ha hD (abs_nonneg _) (by positivity)
        _ = 1 * (L / ly) * L := by ring
        _ = 1 * (1 / θ) * L := by rw [hLly]
    have t2a : 0 ≤ (L₀ + 2 * v) * Taper78.BHB.Ppoly (1 - v / ly) := mul_nonneg (by linarith) hP0
    have t2b : (L₀ + 2 * v) * Taper78.BHB.Ppoly (1 - v / ly) ≤ 3 * L := by
      calc (L₀ + 2 * v) * Taper78.BHB.Ppoly (1 - v / ly) ≤ (3 * L) * 1 :=
            mul_le_mul (by linarith) hP1 hP0 (by linarith)
        _ = 3 * L := by ring
    have t3a : 0 ≤ ly * Taper78.BHB.MT.PPpoly (1 - v / ly) := mul_nonneg hly0.le hQ0
    have t3b : ly * Taper78.BHB.MT.PPpoly (1 - v / ly) ≤ L := by
      calc ly * Taper78.BHB.MT.PPpoly (1 - v / ly) ≤ L * 1 := mul_le_mul hlyL hQ1 hQ0 hLpos.le
        _ = L := by ring
    have hC : 1 * (1 / θ) * L + 3 * L + L ≤ (10 + 10 / θ + 1 / θ ^ 2) * L := by
      have h1 : 0 ≤ 1 / θ ^ 2 := by positivity
      have h2 : 1 * (1 / θ) + 3 + 1 ≤ 10 + 10 / θ + 1 / θ ^ 2 := by
        have : 10 / θ = 10 * (1 / θ) := by ring
        rw [this]
        linarith
      calc 1 * (1 / θ) * L + 3 * L + L = (1 * (1 / θ) + 3 + 1) * L := by ring
        _ ≤ (10 + 10 / θ + 1 / θ ^ 2) * L := mul_le_mul_of_nonneg_right h2 hLpos.le
    rw [e]
    have t1' := abs_le.mp t1
    rw [abs_le]
    constructor <;> linarith [t1'.1, t1'.2]
  ·
    have e : Taper78.BHB.MT.SK.Wder L₀ ly v = -(v / ly) * Taper78.BHB.MT.dPpoly (1 - v / ly) + 1.56 * ((L₀ ^ 2 - v ^ 2) / 2 / ly ^ 2)
        + 3 * Taper78.BHB.Ppoly (1 - v / ly) - (L₀ / ly + 2 * (v / ly)) * Taper78.BHB.MT.dPpoly (1 - v / ly) := by
      unfold Taper78.BHB.MT.SK.Wder
      ring
    have t1a : 0 ≤ v / ly * Taper78.BHB.MT.dPpoly (1 - v / ly) := mul_nonneg hq0 hD0
    have t1b : v / ly * Taper78.BHB.MT.dPpoly (1 - v / ly) ≤ 2 := by
      calc v / ly * Taper78.BHB.MT.dPpoly (1 - v / ly) ≤ 1 * (2) := mul_le_mul hq1 hD1 hD0 zero_le_one
        _ = 2 := by ring
    have t2 : |(L₀ ^ 2 - v ^ 2) / 2 / ly ^ 2| ≤ 1 / 2 * (1 / θ ^ 2) := by
      rw [abs_div, abs_of_pos (by positivity : (0 : ℝ) < ly ^ 2)]
      calc |(L₀ ^ 2 - v ^ 2) / 2| / ly ^ 2 ≤ L ^ 2 / 2 / ly ^ 2 :=
            div_le_div_of_nonneg_right ha (by positivity)
        _ = 1 / 2 * (L ^ 2 / ly ^ 2) := by ring
        _ = 1 / 2 * (1 / θ ^ 2) := by rw [hLly2]
    have t4a : 0 ≤ (L₀ / ly + 2 * (v / ly)) * Taper78.BHB.MT.dPpoly (1 - v / ly) :=
      mul_nonneg (by linarith) hD0
    have t4b : (L₀ / ly + 2 * (v / ly)) * Taper78.BHB.MT.dPpoly (1 - v / ly) ≤ (1 / θ + 2) * (2) :=
      mul_le_mul (by linarith) hD1 hD0 (by linarith)
    have h1 : 0 ≤ 1 / θ ^ 2 := by positivity
    have h10 : 10 / θ = 10 * (1 / θ) := by ring
    rw [e, h10]
    have t2' := abs_le.mp t2
    rw [abs_le]
    constructor <;> linarith [t2'.1, t2'.2]
end BHB.MT.SK

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.hasDerivAt_Wprim (L₀ : ℝ) {ly : ℝ} (hly : ly ≠ 0) (v : ℝ) :
    HasDerivAt (Taper78.BHB.MT.Wprim L₀ ly) (Taper78.BHB.MT.Wmain L₀ ly v) v := by
  have hx : HasDerivAt (fun v : ℝ => 1 - v / ly) (-(1 / ly)) v := by
    have h := ((hasDerivAt_id' v).div_const ly).const_sub 1
    exact h.congr_deriv (by ring)
  have hP : HasDerivAt (fun v : ℝ => Taper78.BHB.Ppoly (1 - v / ly)) (Taper78.BHB.MT.dPpoly (1 - v / ly) * -(1 / ly)) v := by
    have := (Taper78.BHB.MT.hasDerivAt_Ppoly (1 - v / ly)).comp v hx
    exact this
  have hPP : HasDerivAt (fun v : ℝ => Taper78.BHB.MT.PPpoly (1 - v / ly)) (Taper78.BHB.Ppoly (1 - v / ly) * -(1 / ly)) v := by
    have := (Taper78.BHB.MT.hasDerivAt_PPpoly (1 - v / ly)).comp v hx
    exact this
  have hsq : HasDerivAt (fun v : ℝ => v ^ 2) ((2 : ℕ) * v ^ (2 - 1) * 1) v :=
    (hasDerivAt_id' v).pow 2
  have hA : HasDerivAt (fun v : ℝ => (-(1 / 2 : ℝ)) * (L₀ ^ 2 - v ^ 2))
      ((-(1 / 2 : ℝ)) * (0 - (2 : ℕ) * v ^ (2 - 1) * 1)) v :=
    ((hasDerivAt_const v (L₀ ^ 2)).fun_sub hsq).const_mul _
  have hB : HasDerivAt (fun v : ℝ => ly * (L₀ + v)) (ly * 1) v :=
    ((hasDerivAt_id' v).const_add L₀).const_mul ly
  have h := (hA.fun_mul hP).fun_sub (hB.fun_mul hPP)
  have e : Taper78.BHB.MT.Wprim L₀ ly = fun v : ℝ =>
      (-(1 / 2 : ℝ)) * (L₀ ^ 2 - v ^ 2) * Taper78.BHB.Ppoly (1 - v / ly)
        - ly * (L₀ + v) * Taper78.BHB.MT.PPpoly (1 - v / ly) := by
    funext v
    unfold Taper78.BHB.MT.Wprim
    ring
  rw [e]
  refine h.congr_deriv ?_
  unfold Taper78.BHB.MT.Wmain
  field_simp
  ring
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.continuous_Wmain (L₀ ly : ℝ) : Continuous (Taper78.BHB.MT.Wmain L₀ ly) := by
  unfold Taper78.BHB.MT.Wmain Taper78.BHB.MT.dPpoly Taper78.BHB.Ppoly LowBand.taper78 Taper78.BHB.MT.PPpoly
  fun_prop
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.integral_Wmain (L₀ : ℝ) {ly : ℝ} (hly : ly ≠ 0) :
    ∫ v in (0 : ℝ)..ly, Taper78.BHB.MT.Wmain L₀ ly v = L₀ ^ 2 / 2 + ly * L₀ * (63 / 100) := by
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun v _ => Taper78.BHB.MT.hasDerivAt_Wprim L₀ hly v)
    ((Taper78.BHB.MT.continuous_Wmain L₀ ly).intervalIntegrable _ _)]
  unfold Taper78.BHB.MT.Wprim
  rw [div_self hly, sub_self, zero_div, sub_zero, Taper78.BHB.MT.Ppoly_zero, Taper78.BHB.MT.PPpoly_zero, Taper78.BHB.MT.Ppoly_one, Taper78.BHB.MT.PPpoly_one]
  ring
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.contDiff_Wmain (L₀ ly : ℝ) : ContDiff ℝ 1 (Taper78.BHB.MT.Wmain L₀ ly) := by
  unfold Taper78.BHB.MT.Wmain Taper78.BHB.MT.dPpoly Taper78.BHB.Ppoly Taper78.BHB.MT.PPpoly LowBand.taper78
  fun_prop
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.Wmain_bound {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) : ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T →
    ∀ v ∈ Set.Icc 0 (Real.log (ymol θ T)),
      |Taper78.BHB.MT.Wmain (L0 T) (Real.log (ymol θ T)) v| ≤ C * Real.log T ∧
      |deriv (Taper78.BHB.MT.Wmain (L0 T) (Real.log (ymol θ T))) v| ≤ C := by
  refine ⟨10 + 10 / θ + 1 / θ ^ 2, max (2 * π) (Real.exp (1 / θ)), fun T hT v hv => ?_⟩
  have hT2 : 2 * π ≤ T := le_trans (le_max_left _ _) hT
  have hTe : Real.exp (1 / θ) ≤ T := le_trans (le_max_right _ _) hT
  have hT0 : 0 < T := lt_of_lt_of_le (Real.exp_pos _) hTe
  have hL : 1 / θ ≤ Real.log T := by
    rw [Real.le_log_iff_exp_le hT0]
    exact hTe
  have hLpos : 0 < Real.log T := lt_of_lt_of_le (by positivity) hL
  have h2pi : 0 ≤ Real.log (2 * π) := Real.log_nonneg (by linarith [Real.pi_gt_three])
  have hL0 : 0 ≤ L0 T := by
    unfold L0
    apply Real.log_nonneg
    rw [le_div_iff₀ (by positivity)]
    linarith
  have hL0L : L0 T ≤ Real.log T := by
    rw [L0_eq hT0]
    linarith
  have hly : Real.log (ymol θ T) = θ * Real.log T := log_ymol hT0 θ
  rw [hly] at hv ⊢
  have hne : θ * Real.log T ≠ 0 := (mul_pos hθ hLpos).ne'
  rw [(Taper78.BHB.MT.SK.hasDerivAt_Wmain (L0 T) hne v).deriv]
  exact Taper78.BHB.MT.SK.Wmain_Wder_abs_le hθ hθ1 hL hL0 hL0L hv.1 hv.2
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.sum_Wmain {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) : ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T →
    |∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / φ k * Taper78.BHB.MT.Wmain (L0 T) (Real.log (ymol θ T)) (Real.log k)
        - (L0 T ^ 2 / 2 + Real.log (ymol θ T) * L0 T * (63 / 100))| ≤ C * Real.log T := by
  obtain ⟨A, hA0, hA⟩ := sum_sqfree_C1
  obtain ⟨C, T₁, hC⟩ := Taper78.BHB.MT.Wmain_bound hθ hθ1
  refine ⟨A * (|C| + |C|), max T₁ (Real.exp (1 / θ)), fun T hT => ?_⟩
  have hT1 : T₁ ≤ T := le_trans (le_max_left _ _) hT
  have hTe : Real.exp (1 / θ) ≤ T := le_trans (le_max_right _ _) hT
  have hT0 : 0 < T := lt_of_lt_of_le (Real.exp_pos _) hTe
  have hL : 1 / θ ≤ Real.log T := by
    rw [Real.le_log_iff_exp_le hT0]
    exact hTe
  have hL0 : 0 < Real.log T := lt_of_lt_of_le (by positivity) hL
  have hb := hC T hT1
  have hK : Krange θ T = Finset.Icc 1 ⌊Real.exp (Real.log (ymol θ T))⌋₊ := by
    unfold Krange
    rw [exp_log_ymol hT0]
  have hly1 : 1 ≤ Real.log (ymol θ T) := by
    rw [log_ymol hT0]
    calc (1 : ℝ) = θ * (1 / θ) := by field_simp
      _ ≤ θ * Real.log T := mul_le_mul_of_nonneg_left hL hθ.le
  have hlyL : Real.log (ymol θ T) ≤ Real.log T := by
    rw [log_ymol hT0]
    nlinarith
  set ly := Real.log (ymol θ T) with hly
  have key := hA (Taper78.BHB.MT.Wmain (L0 T) ly) (Taper78.BHB.MT.contDiff_Wmain _ _) ly (by linarith)
  rw [Taper78.BHB.MT.integral_Wmain (L0 T) (by linarith : ly ≠ 0)] at key
  rw [hK]
  refine le_trans key ?_
  have h1 : |Taper78.BHB.MT.Wmain (L0 T) ly ly| ≤ |C| * Real.log T :=
    le_trans (hb ly ⟨by linarith, le_rfl⟩).1
      (mul_le_mul_of_nonneg_right (le_abs_self C) hL0.le)
  have h2 : ∫ s in (0 : ℝ)..ly, |deriv (Taper78.BHB.MT.Wmain (L0 T) ly) s| ≤ |C| * Real.log T := by
    have hmono : ∫ s in (0 : ℝ)..ly, |deriv (Taper78.BHB.MT.Wmain (L0 T) ly) s| ≤ ∫ _s in (0 : ℝ)..ly, |C| := by
      apply intervalIntegral.integral_mono_on (by linarith)
      · exact (((Taper78.BHB.MT.contDiff_Wmain (L0 T) ly).continuous_deriv le_rfl).abs).intervalIntegrable _ _
      · exact intervalIntegrable_const
      · intro s hs
        exact le_trans (hb s hs).2 (le_abs_self C)
    rw [intervalIntegral.integral_const, smul_eq_mul, sub_zero] at hmono
    calc ∫ s in (0 : ℝ)..ly, |deriv (Taper78.BHB.MT.Wmain (L0 T) ly) s| ≤ ly * |C| := hmono
      _ ≤ Real.log T * |C| := mul_le_mul_of_nonneg_right hlyL (abs_nonneg _)
      _ = |C| * Real.log T := mul_comm _ _
  calc A * (|Taper78.BHB.MT.Wmain (L0 T) ly ly| + ∫ s in (0 : ℝ)..ly, |deriv (Taper78.BHB.MT.Wmain (L0 T) ly) s|)
      ≤ A * (|C| * Real.log T + |C| * Real.log T) :=
        mul_le_mul_of_nonneg_left (add_le_add h1 h2) hA0
    _ = A * (|C| + |C|) * Real.log T := by ring
end BHB.MT
end
end Src_Taper78FirstSumK

section Src_Taper78FirstMain


/- Adapted from BHB.MainT1.Main by Kristian Muri Knausgård with Claude.
The bounds and polynomial identities here use LowBand.taper78. -/
noncomputable section
open MeasureTheory Complex
open scoped BigOperators ArithmeticFunction ArithmeticFunction.Moebius Nat Real

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.lead_diff {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) {T : ℝ} (hT : Real.exp 1 ≤ T) :
    |(L0 T ^ 2 / 2 + Real.log (ymol θ T) * L0 T * (63 / 100)) - Taper78.BHB.c1 θ * Real.log T ^ 2|
      ≤ 8 * Real.log T := by
  have hT0 : 0 < T := lt_of_lt_of_le (Real.exp_pos _) hT
  have hL : 1 ≤ Real.log T := by
    rw [Real.le_log_iff_exp_le hT0]
    exact hT
  obtain ⟨hc0, hc2⟩ := log_two_pi_mem
  rw [log_ymol hT0, L0_eq hT0]
  set L := Real.log T with hLdef
  set c := Real.log (2 * π) with hcdef
  unfold Taper78.BHB.c1
  have e : (L - c) ^ 2 / 2 + θ * L * (L - c) * (63 / 100) - (1 / 2 + 63 * θ / 100) * L ^ 2
      = c ^ 2 / 2 - c * L * (1 + 63 * θ / 100) := by ring
  rw [e, abs_le]
  have h1 : 0 ≤ c * L := mul_nonneg hc0 (by linarith)
  have h2 : c * L ≤ 2 * L := mul_le_mul_of_nonneg_right hc2 (by linarith)
  have h3 : c ^ 2 ≤ 4 := by nlinarith
  have h4 : 0 ≤ c ^ 2 := sq_nonneg c
  have h5 : c * L * (1 + 63 * θ / 100) ≤ 2 * L * 2 := by
    apply mul_le_mul h2 (by linarith) (by positivity) (by linarith)
  have h6 : 0 ≤ c * L * (1 + 63 * θ / 100) := mul_nonneg h1 (by positivity)
  constructor <;> nlinarith
end BHB.MT

namespace BHB.MT
theorem _root_.Taper78.BHB.MT.Main1_asymp_O (w : Weight) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) {C₀ : ℝ}
    (hM : MobiusHyp C₀) : ∃ C T₀ : ℝ, ∀ T : ℝ, T₀ ≤ T →
      ‖Taper78.BHB.Main1 w.h θ T - ((Taper78.BHB.c1 θ * w.kap1 * T * Real.log T ^ 2 / (2 * π) : ℝ) : ℂ)‖
        ≤ C * T * Real.log T := by
  obtain ⟨C₁, T₁, h1⟩ := Taper78.BHB.MT.Ik_asymp w hθ hθ1 hM
  obtain ⟨C₂, T₂, h2⟩ := sum_rho_le hθ hθ1
  obtain ⟨C₃, T₃, h3⟩ := Taper78.BHB.MT.sum_Wmain hθ hθ1
  refine ⟨(|C₁| * |C₂| + |w.kap1| * |C₃| + |w.kap1| * 8) / (2 * π),
    max (max T₁ T₂) (max T₃ (Real.exp 1)), fun T hT => ?_⟩
  have hT1 : T₁ ≤ T := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hT
  have hT2 : T₂ ≤ T := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hT
  have hT3 : T₃ ≤ T := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hT
  have hTe : Real.exp 1 ≤ T := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hT
  have hT0 : 0 < T := lt_of_lt_of_le (Real.exp_pos _) hTe
  have hTone : 1 ≤ T := le_trans (Real.one_le_exp zero_le_one) hTe
  have hL : 1 ≤ Real.log T := by
    rw [Real.le_log_iff_exp_le hT0]
    exact hTe
  have hπ : (0 : ℝ) < 2 * π := by positivity
  have hTπ : 0 ≤ T / (2 * π) := by positivity
  rw [Taper78.BHB.MT.Main1_eq w θ hT0, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
  set κ := w.kap1 with hκ
  set ly := Real.log (ymol θ T) with hly
  set L := Real.log T with hLdef
  set I0 := L0 T ^ 2 / 2 + ly * L0 T * (63 / 100) with hI0

  have hA : ∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k) * Taper78.BHB.MT.Ik w θ T k
      = ∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k)
            * (Taper78.BHB.MT.Ik w θ T k - κ * Xk T k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k))
        + κ * (T / (2 * π))
            * ∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / φ k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k) := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun k hk => ?_
    have hk1 : 1 ≤ k := (mem_Krange.mp hk).1
    have hw := weight_mul_Xk T hk1
    have e1 : (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k) * Taper78.BHB.MT.Ik w θ T k
        = (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k)
            * (Taper78.BHB.MT.Ik w θ T k - κ * Xk T k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k))
          + κ * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k) * ((μ k : ℝ) ^ 2 / ((k : ℝ) * φ k) * Xk T k) := by
      ring
    rw [e1, hw]
    ring
  have hsplit : (∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k) * Taper78.BHB.MT.Ik w θ T k)
        - Taper78.BHB.c1 θ * κ * T * L ^ 2 / (2 * π)
      = ∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k)
            * (Taper78.BHB.MT.Ik w θ T k - κ * Xk T k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k))
        + κ * (T / (2 * π))
            * (∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / φ k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k) - I0)
        + κ * (T / (2 * π)) * (I0 - Taper78.BHB.c1 θ * L ^ 2) := by
    rw [hA]
    ring
  rw [hsplit]

  have hB1 : |∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k)
        * (Taper78.BHB.MT.Ik w θ T k - κ * Xk T k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k))|
      ≤ |C₁| * |C₂| * (T / (2 * π)) * L := by
    have hterm : ∀ k ∈ Krange θ T, |(μ k : ℝ) ^ 2 / ((k : ℝ) * φ k)
          * (Taper78.BHB.MT.Ik w θ T k - κ * Xk T k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k))|
        ≤ |C₁| * (T / (2 * π)) * ((μ k : ℝ) ^ 2 / φ k * rho θ T k) := by
      intro k hk
      have hk1 : 1 ≤ k := (mem_Krange.mp hk).1
      have hw := weight_mul_Xk T hk1
      have ha0 : 0 ≤ (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k) := by positivity
      have hX : 0 ≤ Xk T k := (Xk_pos hT0 hk1).le
      have hρ : 0 ≤ rho θ T k := le_trans zero_le_one (one_le_rho hTone hk1)
      have hb := h1 T hT1 k hk
      have hb' : |Taper78.BHB.MT.Ik w θ T k - κ * Xk T k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k)|
          ≤ |C₁| * Xk T k * rho θ T k :=
        le_trans hb (mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right (le_abs_self _) hX) hρ)
      rw [abs_mul, abs_of_nonneg ha0]
      calc (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k)
            * |Taper78.BHB.MT.Ik w θ T k - κ * Xk T k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k)|
          ≤ (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k) * (|C₁| * Xk T k * rho θ T k) :=
            mul_le_mul_of_nonneg_left hb' ha0
        _ = |C₁| * rho θ T k * ((μ k : ℝ) ^ 2 / ((k : ℝ) * φ k) * Xk T k) := by ring
        _ = |C₁| * (T / (2 * π)) * ((μ k : ℝ) ^ 2 / φ k * rho θ T k) := by
            rw [hw]
            ring
    have hsum := h2 T hT2
    have hC₁ : 0 ≤ |C₁| * (T / (2 * π)) := by positivity
    calc |∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / ((k : ℝ) * φ k)
            * (Taper78.BHB.MT.Ik w θ T k - κ * Xk T k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k))|
        ≤ ∑ k ∈ Krange θ T, |(μ k : ℝ) ^ 2 / ((k : ℝ) * φ k)
            * (Taper78.BHB.MT.Ik w θ T k - κ * Xk T k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k))| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ k ∈ Krange θ T, |C₁| * (T / (2 * π)) * ((μ k : ℝ) ^ 2 / φ k * rho θ T k) :=
          Finset.sum_le_sum hterm
      _ = |C₁| * (T / (2 * π)) * ∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / φ k * rho θ T k := by
          rw [Finset.mul_sum]
      _ ≤ |C₁| * (T / (2 * π)) * (C₂ * L) := mul_le_mul_of_nonneg_left hsum hC₁
      _ ≤ |C₁| * (T / (2 * π)) * (|C₂| * L) := by
          apply mul_le_mul_of_nonneg_left _ hC₁
          exact mul_le_mul_of_nonneg_right (le_abs_self _) (by linarith)
      _ = |C₁| * |C₂| * (T / (2 * π)) * L := by ring

  have hB2 : |κ * (T / (2 * π))
        * (∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / φ k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k) - I0)|
      ≤ |κ| * |C₃| * (T / (2 * π)) * L := by
    have hb := h3 T hT3
    have hb' : |∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / φ k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k) - I0|
        ≤ |C₃| * L := le_trans hb (mul_le_mul_of_nonneg_right (le_abs_self _) (by linarith))
    rw [abs_mul, abs_mul, abs_of_nonneg hTπ]
    calc |κ| * (T / (2 * π))
          * |∑ k ∈ Krange θ T, (μ k : ℝ) ^ 2 / φ k * Taper78.BHB.MT.Wmain (L0 T) ly (Real.log k) - I0|
        ≤ |κ| * (T / (2 * π)) * (|C₃| * L) :=
          mul_le_mul_of_nonneg_left hb' (by positivity)
      _ = |κ| * |C₃| * (T / (2 * π)) * L := by ring

  have hB3 : |κ * (T / (2 * π)) * (I0 - Taper78.BHB.c1 θ * L ^ 2)| ≤ |κ| * 8 * (T / (2 * π)) * L := by
    have hb := Taper78.BHB.MT.lead_diff hθ hθ1 hTe
    rw [abs_mul, abs_mul, abs_of_nonneg hTπ]
    calc |κ| * (T / (2 * π)) * |I0 - Taper78.BHB.c1 θ * L ^ 2|
        ≤ |κ| * (T / (2 * π)) * (8 * L) := mul_le_mul_of_nonneg_left hb (by positivity)
      _ = |κ| * 8 * (T / (2 * π)) * L := by ring
  have tri : ∀ a b c : ℝ, |a + b + c| ≤ |a| + |b| + |c| := by
    intro a b c
    calc |a + b + c| ≤ |a + b| + |c| := abs_add_le _ _
      _ ≤ |a| + |b| + |c| := by
          have := abs_add_le a b
          linarith
  refine le_trans (tri _ _ _) ?_
  have hfin : (|C₁| * |C₂| + |κ| * |C₃| + |κ| * 8) / (2 * π) * T * L
      = |C₁| * |C₂| * (T / (2 * π)) * L + |κ| * |C₃| * (T / (2 * π)) * L
        + |κ| * 8 * (T / (2 * π)) * L := by
    field_simp
  rw [hfin]
  exact add_le_add (add_le_add hB1 hB2) hB3
end BHB.MT
#retaper BHB.Main1_asymp
#print axioms Taper78.BHB.Main1_asymp
end
end Src_Taper78FirstMain

section Src_RamanujanPrincipal

noncomputable section
open ReflectedPrincipal Real
open scoped BigOperators ArithmeticFunction ArithmeticFunction.Moebius

namespace RamanujanPrincipal

private theorem digit_bound (l : List ℕ) (m : ℕ) (h : ∀ t ∈ l, t ≤ m) :
    l.sum ≤ m*l.length := by
  induction l with
  | nil => simp
  | cons v l ih =>
    have hv := h v (by simp)
    have hl := ih (fun t ht => h t (by simp [ht]))
    simp only [List.sum_cons,List.length_cons,Nat.mul_succ]
    omega

private theorem sum_val_factorial {p : ℕ} (hp : p.Prime) (N : ℕ) :
    ∑ n ∈ Finset.Ioc 0 N, (padicValNat p n:ℝ) = padicValNat p N.factorial := by
  let : Fact p.Prime := ⟨hp⟩
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_Ioc_succ_top (by omega),ih,Nat.factorial_succ,
      padicValNat.mul (Nat.succ_ne_zero _) (Nat.factorial_ne_zero _),Nat.cast_add,add_comm]

/-- The valuation correction in a squarefree shift has a uniform logarithmic
error, obtained from Legendre's exact base-p digit formula for the factorial. -/
theorem valuation_sum {p : ℕ} (hp : p.Prime) {x : ℝ} (hx : 1 ≤ x) :
    |partialSum (fun n => (padicValNat p n:ℝ)) x-x/((p:ℝ)-1)| ≤
      2+Real.log x/Real.log 2 := by
  let : Fact p.Prime := ⟨hp⟩
  let N := ⌊x⌋₊
  have hN : 1 ≤ N := (Nat.one_le_floor_iff _).mpr hx
  have hn : N ≠ 0 := by omega
  have hNx : (N:ℝ) ≤ x := Nat.floor_le (by linarith)
  have hxN : x < (N:ℝ)+1 := Nat.lt_floor_add_one x
  have hpR : (2:ℝ) ≤ p := by exact_mod_cast hp.two_le
  have hp₀ : (0:ℝ)<p-1 := by linarith
  have hval := sub_one_mul_padicValNat_factorial (p:=p) N
  have hle := Nat.digit_sum_le p N
  have heq : ((p:ℝ)-1)*(padicValNat p N.factorial:ℝ) = (N:ℝ)-((p.digits N).sum:ℝ) := by
    have h := congrArg (fun n : ℕ => (n:ℝ)) hval
    simpa only [Nat.cast_mul,Nat.cast_sub hp.one_le,Nat.cast_one,Nat.cast_sub hle] using h
  have hdigits := digit_bound (p.digits N) (p-1) (fun t ht => by
    have := Nat.digits_lt_base hp.one_lt ht; omega)
  rw [Nat.length_digits p N hp.one_lt hn] at hdigits
  have hsize : ((p.digits N).sum:ℝ) ≤ ((p:ℝ)-1)*((Nat.log p N:ℝ)+1) := by
    have h : ((p.digits N).sum:ℝ) ≤ ((p-1:ℕ):ℝ)*(↑(Nat.log p N + 1 : ℕ):ℝ) := by
      rw [← Nat.cast_mul]; exact Nat.cast_le.mpr hdigits
    simpa only [Nat.cast_sub hp.one_le,Nat.cast_one,Nat.cast_add] using h
  have hlog₂ : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlogp := Real.log_le_log (by norm_num : (0:ℝ)<2) hpR
  have hlogN := Real.log_le_log (show 0 < (N:ℝ) by exact_mod_cast hN) hNx
  have hnat : (Nat.log p N:ℝ) ≤ Real.log x/Real.log 2 := by
    have h := Real.natLog_le_logb N p
    rw [Real.logb] at h
    apply h.trans
    exact div_le_div₀ (Real.log_nonneg hx) hlogN hlog₂ hlogp
  change |(∑ n ∈ Finset.Ioc 0 N, (padicValNat p n:ℝ))-x/((p:ℝ)-1)| ≤ _
  rw [sum_val_factorial hp,abs_le]
  constructor
  · have ha : ((p:ℝ)-1)*(padicValNat p N.factorial:ℝ)+
        ((p:ℝ)-1)*(2+Real.log x/Real.log 2) ≥ x := by
      nlinarith only [heq,hsize,hxN,hpR,mul_le_mul_of_nonneg_left hnat hp₀.le]
    rw [le_sub_iff_add_le,← le_sub_iff_add_le',sub_neg_eq_add]
    apply (div_le_iff₀ hp₀).mpr
    linarith only [ha]
  · have hsum : 0 ≤ ((p.digits N).sum:ℝ) := Nat.cast_nonneg _
    have hleft : (padicValNat p N.factorial:ℝ) ≤ x/((p:ℝ)-1) :=
      (le_div_iff₀ hp₀).mpr (by linarith only [heq,hNx,hsum])
    have hlog := Real.log_nonneg hx
    linarith [div_nonneg hlog hlog₂.le]

def shiftFactor (d : ℕ) := ∑ p ∈ d.primeFactors, (1+1/((p:ℝ)-1))*(Real.log p)^2

/-- Sharp shifted sums have one additive correction for each prime dividing d.
The constants in the error are independent of d. -/
theorem shift_estimate {d : ℕ} (hd : Squarefree d) {x : ℝ} (hx : 1 ≤ x) :
    |partialSum (fun j => BHB.MT.kap2 (d*j)) x-partialSum BHB.MT.kap2 x-x*shiftFactor d| ≤
      (3+Real.log x/Real.log 2)*(Real.log d)^2 := by
  have harith : partialSum (fun j => BHB.MT.kap2 (d*j)) x =
      partialSum BHB.MT.kap2 x+∑ p ∈ d.primeFactors,
        ((⌊x⌋₊:ℝ)+partialSum (fun j => (padicValNat p j:ℝ)) x)*(Real.log p)^2 := by
    unfold partialSum
    calc
      _ = ∑ j ∈ below x, (BHB.MT.kap2 j+∑ p ∈ d.primeFactors,
          (1+(padicValNat p j:ℝ))*(Real.log p)^2) :=
        Finset.sum_congr rfl fun j hj => BHB.MT.kap2_mul_sqfree hd (Finset.mem_Ioc.mp hj).1
      _ = _ := by
        rw [Finset.sum_add_distrib,Finset.sum_comm (s:=below x) (t:=d.primeFactors)]
        congr 1
        apply Finset.sum_congr rfl
        intro p hp
        rw [← Finset.sum_mul,Finset.sum_add_distrib]; simp [below]
  rw [harith,add_sub_cancel_left,shiftFactor,Finset.mul_sum,← Finset.sum_sub_distrib]
  have hround : |(⌊x⌋₊:ℝ)-x| ≤ 1 := by
    rw [abs_of_nonpos (sub_nonpos.mpr (Nat.floor_le (by linarith)))]
    linarith [Nat.lt_floor_add_one x]
  have hpos : 0 ≤ 3+Real.log x/Real.log 2 := by positivity [Real.log_nonneg hx,Real.log_pos (by norm_num : (1:ℝ)<2)]
  apply (Finset.abs_sum_le_sum_abs ..).trans
  calc
    _ ≤ ∑ p ∈ d.primeFactors, (3+Real.log x/Real.log 2)*(Real.log p)^2 := by
      apply Finset.sum_le_sum
      intro p hp
      have hv := valuation_sum (Nat.prime_of_mem_primeFactors hp) hx
      let S := partialSum (fun j => (padicValNat p j:ℝ)) x
      change |((⌊x⌋₊:ℝ)+S)*(Real.log p)^2-x*((1+1/((p:ℝ)-1))*(Real.log p)^2)| ≤ _
      rw [show ((⌊x⌋₊:ℝ)+S)*(Real.log p)^2-x*((1+1/((p:ℝ)-1))*(Real.log p)^2) =
          (((⌊x⌋₊:ℝ)-x)+(S-x/((p:ℝ)-1)))*(Real.log p)^2 by ring,abs_mul,abs_of_nonneg (sq_nonneg (Real.log p))]
      apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
      apply (abs_add_le ..).trans
      linarith only [add_le_add hround hv]
    _ ≤ _ := by
      rw [← Finset.mul_sum,BHB.MT.SK.log_eq_sum_primeFactors hd]
      exact mul_le_mul_of_nonneg_left
        (Finset.sum_sq_le_sq_sum_of_nonneg (fun p _ => Real.log_natCast_nonneg p)) hpos

private def logWeight (f : ArithmeticFunction ℝ) : ArithmeticFunction ℝ :=
  ⟨fun n => Real.log n*f n,by simp⟩

private theorem log_product (f g : ArithmeticFunction ℝ) :
    logWeight (f*g) = logWeight f*g + f*logWeight g := by
  ext n
  change Real.log n*(f*g) n=(logWeight f*g) n+(f*logWeight g) n
  simp only [ArithmeticFunction.mul_apply,Finset.mul_sum,← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro t ht
  have h := Nat.mem_divisorsAntidiagonal.mp ht
  have ha : (t.1:ℝ) ≠ 0 := by exact_mod_cast Nat.left_ne_zero_of_mem_divisorsAntidiagonal ht
  have hb : (t.2:ℝ) ≠ 0 := by exact_mod_cast Nat.right_ne_zero_of_mem_divisorsAntidiagonal ht
  change Real.log n*(f t.1*g t.2)=Real.log t.1*f t.1*g t.2+f t.1*(Real.log t.2*g t.2)
  rw [← h.1,Nat.cast_mul,Real.log_mul ha hb]
  ring

private abbrev Z : ArithmeticFunction ℝ := ArithmeticFunction.zeta
private abbrev M : ArithmeticFunction ℝ := μ
private abbrev L : ArithmeticFunction ℝ := ArithmeticFunction.log
private abbrev V : ArithmeticFunction ℝ := ArithmeticFunction.vonMangoldt

private theorem log_ones : logWeight Z=L := by
  ext n
  rcases eq_or_ne n 0 with rfl | hn
  · simp
  · simp [logWeight,Z,L,ArithmeticFunction.natCoe_apply,hn]

/-- The second logarithmic difference is Selberg's convolution identity. -/
theorem second_log_difference : M*logWeight L = logWeight V+V*V := by
  have hv : Z*V=L := ArithmeticFunction.zeta_mul_vonMangoldt
  have hm : M*Z=1 := ArithmeticFunction.coe_moebius_mul_coe_zeta
  have hl : M*L=V := ArithmeticFunction.moebius_mul_log_eq_vonMangoldt
  calc
    M*logWeight L = M*(logWeight Z*V + Z*logWeight V) := by rw [← log_product,hv]
    _ = _ := by rw [log_ones,mul_add,← mul_assoc,hl,← mul_assoc,hm,one_mul,add_comm]

private def primeCorrection : ArithmeticFunction ℝ :=
  ⟨fun p => if p.Prime then (1+1/((p:ℝ)-1))*(Real.log p)^2 else 0,by simp⟩

private theorem shift_as_convolution (d : ℕ) : shiftFactor d=(Z*primeCorrection) d := by
  rw [Z,ArithmeticFunction.coe_zeta_mul_apply,shiftFactor,Nat.primeFactors_eq_to_filter_divisors_prime,
    Finset.sum_filter]
  rfl

private theorem mob_transform (f : ArithmeticFunction ℝ) (k : ℕ) :
    (∑ d ∈ k.divisors, (μ (k/d):ℝ)*f d)=(M*f) k := by
  rw [ArithmeticFunction.mul_apply,Nat.sum_divisorsAntidiagonal' fun i j => M i*f j]
  rfl

def quadratic (b c t : ℝ) := t^2/2+b*t+c

def principalPolynomial (k : ℕ) (b c t : ℝ) :=
  ∑ d ∈ k.divisors, (μ (k/d):ℝ)*(quadratic b c (t-Real.log d)+shiftFactor d)

/-- Exact Möbius cancellation of the complete quadratic and its prime-shift correction. -/
theorem principal_polynomial (k : ℕ) (b c t : ℝ) :
    principalPolynomial k b c t = quadratic b c t*(1:ArithmeticFunction ℝ) k -
      (t+b)*ArithmeticFunction.vonMangoldt k +
      (weightedMangoldt k+(V*V) k)/2+primeCorrection k := by
  have m₀ := mob_transform Z k
  rw [show M*Z=1 from ArithmeticFunction.coe_moebius_mul_coe_zeta] at m₀
  have m₁ := mob_transform L k
  rw [show M*L=V from ArithmeticFunction.moebius_mul_log_eq_vonMangoldt] at m₁
  have m₂ := mob_transform (logWeight L) k
  rw [second_log_difference,ArithmeticFunction.add_apply] at m₂
  have m₃ := mob_transform (Z*primeCorrection) k
  rw [← mul_assoc,show M*Z=1 from ArithmeticFunction.coe_moebius_mul_coe_zeta,one_mul] at m₃
  change _=quadratic b c t*(1:ArithmeticFunction ℝ) k-(t+b)*V k+((logWeight V) k+(V*V) k)/2+primeCorrection k
  rw [← m₀,← m₁,← m₂,← m₃]
  unfold principalPolynomial
  rw [Finset.mul_sum,Finset.mul_sum,Finset.sum_div,← Finset.sum_sub_distrib,
    ← Finset.sum_add_distrib,← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro d hd
  have hz : Z d=1 := by
    simp [Z,ArithmeticFunction.natCoe_apply,ArithmeticFunction.zeta_apply_ne (Nat.pos_of_mem_divisors hd).ne']
  rw [hz,shift_as_convolution]
  change (μ (k/d):ℝ)*(quadratic b c (t-Real.log d)+(Z*primeCorrection) d) =
    quadratic b c t*((μ (k/d):ℝ)*1)-(t+b)*((μ (k/d):ℝ)*Real.log d)+
    ((μ (k/d):ℝ)*(Real.log d*Real.log d))/2+(μ (k/d):ℝ)*(Z*primeCorrection) d
  unfold quadratic
  ring

private theorem squarefree_von {d : ℕ} (hd : Squarefree d) :
    V d = if d.Prime then Real.log d else 0 := by
  split_ifs with hp
  · exact ArithmeticFunction.vonMangoldt_apply_prime hp
  · exact ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr fun h => hp
      (Nat.squarefree_and_prime_pow_iff_prime.mp ⟨hd,h⟩)

private theorem prime_pair_sum {k : ℕ} (hk : Squarefree k) :
    (V*V) k = ∑ p ∈ k.primeFactors, Real.log p*V (k/p) := by
  rw [ArithmeticFunction.mul_apply,Nat.sum_divisorsAntidiagonal fun i j => V i*V j,
    Nat.primeFactors_eq_to_filter_divisors_prime,Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro d hd
  rw [squarefree_von (hk.squarefree_of_dvd (Nat.dvd_of_mem_divisors hd))]
  split_ifs <;> simp

theorem principal_one (b c t : ℝ) : principalPolynomial 1 b c t=quadratic b c t := by
  simp [principal_polynomial,V,primeCorrection,weightedMangoldt]

theorem principal_prime {p : ℕ} (hp : p.Prime) (b c t : ℝ) :
    principalPolynomial p b c t = -(t+b)*Real.log p+(Real.log p)^2/2+
      (1+1/((p:ℝ)-1))*(Real.log p)^2 := by
  rw [principal_polynomial,prime_pair_sum hp.squarefree,hp.primeFactors]
  simp [weightedMangoldt,ArithmeticFunction.one_apply_ne hp.ne_one,primeCorrection,
    hp,Nat.div_self hp.pos,V,ArithmeticFunction.vonMangoldt_apply_prime hp]
  ring

theorem principal_two {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hne : p ≠ q)
    (b c t : ℝ) : principalPolynomial (p*q) b c t=Real.log p*Real.log q := by
  have hc := hp.coprime_iff_not_dvd.mpr (fun h => hne ((Nat.prime_dvd_prime_iff_eq hp hq).mp h))
  have hsq : Squarefree (p*q) := squarefree_mul_iff.mpr ⟨Nat.coprime_iff_isRelPrime.mp hc,hp.squarefree,hq.squarefree⟩
  have hnp : ¬(p*q).Prime := Nat.not_prime_mul hp.ne_one hq.ne_one
  have hv : ArithmeticFunction.vonMangoldt (p*q) = 0 := by simpa only [if_neg hnp] using squarefree_von hsq
  have hone : p*q ≠ 1 := by have := hp.one_lt; have := hq.one_lt; nlinarith
  rw [principal_polynomial,prime_pair_sum hsq,Nat.primeFactors_mul hp.ne_zero hq.ne_zero,
    hp.primeFactors,hq.primeFactors,Finset.singleton_union,Finset.sum_insert (by simpa using hne),
    Finset.sum_singleton,Nat.mul_div_cancel_left _ hp.pos,Nat.mul_div_cancel _ hq.pos]
  simp [weightedMangoldt,ArithmeticFunction.one_apply_ne hone,primeCorrection,hnp,hv,V,
    ArithmeticFunction.vonMangoldt_apply_prime hp,ArithmeticFunction.vonMangoldt_apply_prime hq]
  ring

theorem principal_vanish {k : ℕ} (hk : Squarefree k) (h₁ : k ≠ 1) (h₂ : ¬k.Prime)
    (h₃ : ∀ p q : ℕ, p.Prime → q.Prime → p*q ≠ k) (b c t : ℝ) : principalPolynomial k b c t=0 := by
  have hv : V k=0 := by simpa only [if_neg h₂] using squarefree_von hk
  have hpairs : (V*V) k=0 := by
    rw [prime_pair_sum hk]
    apply Finset.sum_eq_zero
    intro p hp
    have hpk := Nat.dvd_of_mem_primeFactors hp
    have ha := Nat.div_dvd_of_dvd hpk
    have hnp : ¬(k/p).Prime := fun hq => h₃ _ _ (Nat.prime_of_mem_primeFactors hp) hq (Nat.mul_div_cancel' hpk)
    rw [squarefree_von (hk.squarefree_of_dvd ha),if_neg hnp,mul_zero]
  rw [principal_polynomial,hpairs]
  change _*(1:ArithmeticFunction ℝ) k-_*V k+(Real.log k*V k+0)/2+primeCorrection k=0
  simp [ArithmeticFunction.one_apply_ne h₁,hv,primeCorrection,h₂]

/-- The real Ramanujan weight in its divisor expansion. -/
def ramanujanWeight (k n : ℕ) : ℝ :=
  ∑ d ∈ k.divisors, if d ∣ n then (μ (k/d):ℝ)*d else 0

private theorem multiple_sum (f : ℕ → ℝ) {d : ℕ} (hd : 0 < d) {x : ℝ} :
    (∑ n ∈ (below x).filter (d ∣ ·), f n)=partialSum (fun j => f (d*j)) (x/d) := by
  have hf : ⌊x/(d:ℝ)⌋₊=⌊x⌋₊/d := Nat.floor_div_natCast ..
  unfold partialSum below
  rw [hf]
  refine Finset.sum_bij' (fun n _ => n/d) (fun j _ => d*j) ?_ ?_ ?_ ?_ ?_
  · intro n hn
    obtain ⟨hm,hnd⟩ := Finset.mem_filter.mp hn
    obtain ⟨hn₀,hnx⟩ := Finset.mem_Ioc.mp hm
    exact Finset.mem_Ioc.mpr ⟨Nat.div_pos (Nat.le_of_dvd hn₀ hnd) hd,Nat.div_le_div_right hnx⟩
  · intro j hj
    obtain ⟨hj₀,hjx⟩ := Finset.mem_Ioc.mp hj
    refine Finset.mem_filter.mpr ⟨Finset.mem_Ioc.mpr ⟨Nat.mul_pos hd hj₀,?_⟩,dvd_mul_right ..⟩
    simpa only [mul_comm d j] using (Nat.le_div_iff_mul_le hd).mp hjx
  · intro n hn
    exact Nat.mul_div_cancel' (Finset.mem_filter.mp hn).2
  · intro j _
    exact Nat.mul_div_cancel_left j hd
  · intro n hn
    rw [Nat.mul_div_cancel' (Finset.mem_filter.mp hn).2]

theorem twisted_prefix (f : ℕ → ℝ) (k : ℕ) (x : ℝ) :
    partialSum (fun n => ramanujanWeight k n*f n) x =
      ∑ d ∈ k.divisors, ((μ (k/d):ℝ)*d)*partialSum (fun j => f (d*j)) (x/d) := by
  unfold partialSum ramanujanWeight
  simp_rw [Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro d hd
  change _ = _*partialSum (fun j => f (d*j)) (x/d)
  rw [← multiple_sum f (Nat.pos_of_mem_divisors hd),Finset.mul_sum,Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro n _
  split_ifs <;> simp

/-- The principal character's sharp summatory asymptotic, uniform for squarefree k
and real x ≥ k. The quadratic is explicitly supported on 1, primes and prime pairs. -/
theorem twisted_kap2_of_RH (hRH : RiemannHypothesis) :
    ∃ b c D : ℝ, 0 < D ∧ ∀ k : ℕ, Squarefree k → ∀ x : ℝ, (k:ℝ) ≤ x →
      |partialSum (fun n => ramanujanWeight k n*BHB.MT.kap2 n) x -
        x*principalPolynomial k b c (Real.log x)| ≤
        (k.divisors.card:ℝ)*x*(x/k)^(-(1/65536):ℝ)*
          (D+(3+Real.log x/Real.log 2)*(Real.log k)^2) := by
  obtain ⟨b,c,D,hD,hG⟩ := kap2_summatory_of_RH hRH
  refine ⟨b,c,D,hD,?_⟩
  intro k hk x hkx
  have hk₀ : 0 < k := Nat.pos_of_ne_zero hk.ne_zero
  have hkR : 0 < (k:ℝ) := by exact_mod_cast hk₀
  have hx₀ : 0 < x := hkR.trans_le hkx
  have hx₁ : 1 ≤ x := (show (1:ℝ) ≤ k by exact_mod_cast hk₀).trans hkx
  have hlog₂ : 0 < Real.log 2 := Real.log_pos (by norm_num)
  let B := (3+Real.log x/Real.log 2)*(Real.log k)^2
  have hB : 0 ≤ B := by dsimp [B]; positivity [Real.log_nonneg hx₁]
  rw [twisted_prefix,principalPolynomial,Finset.mul_sum,← Finset.sum_sub_distrib]
  apply (Finset.abs_sum_le_sum_abs ..).trans
  calc
    _ ≤ ∑ _d ∈ k.divisors, x*(x/k)^(-(1/65536):ℝ)*(D+B) := by
      apply Finset.sum_le_sum
      intro d hd
      have hd₀ : 0 < d := Nat.pos_of_mem_divisors hd
      have hdR : 0 < (d:ℝ) := by exact_mod_cast hd₀
      have hdk : (d:ℝ) ≤ k := by exact_mod_cast Nat.le_of_dvd hk₀ (Nat.dvd_of_mem_divisors hd)
      have hd₁ : (1:ℝ) ≤ d := by exact_mod_cast hd₀
      let u := x/d
      have hu : 1 ≤ u := (one_le_div hdR).mpr (hdk.trans hkx)
      have hup : 0 < u := by linarith
      have hux : u ≤ x := div_le_self hx₀.le hd₁
      have hdu : (d:ℝ)*u=x := by dsimp [u]; field_simp
      have hlog : Real.log u=Real.log x-Real.log d := Real.log_div hx₀.ne' hdR.ne'
      have h₁ := shift_estimate (hk.squarefree_of_dvd (Nat.dvd_of_mem_divisors hd)) hu
      have h₂ := hG u hu
      have hsq := mul_self_le_mul_self (Real.log_natCast_nonneg d) (Real.log_le_log hdR hdk)
      have hB' : (3+Real.log u/Real.log 2)*(Real.log d)^2 ≤ B := by
        apply mul_le_mul _ (by nlinarith only [hsq]) (sq_nonneg _) (by positivity [Real.log_nonneg hx₁])
        exact add_le_add_right (div_le_div_of_nonneg_right (Real.log_le_log hup hux) hlog₂.le) _
      have hlarge := Real.one_le_rpow hu (show (0:ℝ) ≤ 1-1/65536 by norm_num)
      let A := partialSum (fun j => BHB.MT.kap2 (d*j)) u
      let P := quadratic b c (Real.log u)
      have hA : |A-u*(P+shiftFactor d)| ≤ u^(1-1/65536:ℝ)*(D+B) := by
        rw [show A-u*(P+shiftFactor d) = (A-partialSum BHB.MT.kap2 u-u*shiftFactor d)+
          (partialSum BHB.MT.kap2 u-u*P) by ring]
        apply ((abs_add_le ..).trans (add_le_add (h₁.trans hB') h₂)).trans
        nlinarith only [mul_le_mul_of_nonneg_right hlarge hB]
      have hcut : u^(-(1/65536):ℝ) ≤ (x/k)^(-(1/65536):ℝ) :=
        Real.rpow_le_rpow_of_nonpos (div_pos hx₀ hkR) (div_le_div_of_nonneg_left hx₀.le hdR hdk) (by norm_num)
      have hxcut : (d:ℝ)*u^(1-1/65536:ℝ) ≤ x*(x/k)^(-(1/65536):ℝ) := by
        rw [sub_eq_add_neg,Real.rpow_add hup,Real.rpow_one,← mul_assoc,hdu]
        exact mul_le_mul_of_nonneg_left hcut hx₀.le
      have hm : |(μ (k/d):ℝ)| ≤ 1 := by exact_mod_cast (ArithmeticFunction.abs_moebius_le_one (n:=k/d))
      rw [← hlog]
      change |((μ (k/d):ℝ)*d)*A-x*((μ (k/d):ℝ)*(P+shiftFactor d))| ≤ _
      rw [show ((μ (k/d):ℝ)*d)*A-x*((μ (k/d):ℝ)*(P+shiftFactor d)) =
        (μ (k/d):ℝ)*(d*(A-u*(P+shiftFactor d))) by rw [← hdu]; ring,abs_mul,abs_mul,abs_of_pos hdR]
      calc
        _ ≤ 1*((d:ℝ)*(u^(1-1/65536:ℝ)*(D+B))) := mul_le_mul hm
          (mul_le_mul_of_nonneg_left hA hdR.le) (mul_nonneg hdR.le (abs_nonneg _)) zero_le_one
        _ ≤ _ := by rw [one_mul,← mul_assoc]; exact mul_le_mul_of_nonneg_right hxcut (by linarith)
    _ = _ := by simp [B]; ring

end RamanujanPrincipal
end
end Src_RamanujanPrincipal

section Src_PrincipalSmoothing

noncomputable section
open ReflectedPrincipal RamanujanPrincipal MeasureTheory Real
open scoped BigOperators ArithmeticFunction.Moebius Asymptotics

namespace PrincipalSmoothing

private abbrev δ : ℝ := 1/65536

private theorem shift_bound {d : ℕ} (hd : Squarefree d) :
    0 ≤ shiftFactor d ∧ shiftFactor d ≤ 2*(Real.log d)^2 := by
  have hpR {p : ℕ} (hp : p ∈ d.primeFactors) : (2:ℝ) ≤ p := by
    exact_mod_cast (Nat.prime_of_mem_primeFactors hp).two_le
  constructor
  · exact Finset.sum_nonneg fun p hp => mul_nonneg
      (by have := hpR hp; positivity [show 0 < (p:ℝ)-1 by linarith]) (sq_nonneg _)
  · unfold shiftFactor
    calc
      _ ≤ ∑ p ∈ d.primeFactors, 2*(Real.log p)^2 := by
        apply Finset.sum_le_sum
        intro p hp
        apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
        have hp₀ := hpR hp
        have := (div_le_one (by linarith : 0 < (p:ℝ)-1)).mpr (show 1 ≤ (p:ℝ)-1 by linarith)
        linarith
      _ ≤ _ := by
        rw [← Finset.mul_sum,BHB.MT.SK.log_eq_sum_primeFactors hd]
        exact mul_le_mul_of_nonneg_left
          (Finset.sum_sq_le_sq_sum_of_nonneg (fun p _ => Real.log_natCast_nonneg p)) (by norm_num)

private theorem small_argument (b c : ℝ) {d : ℕ} (hd : Squarefree d) {u : ℝ}
    (hu : 0 < u) (hu₁ : u < 1) :
    |partialSum (fun j => BHB.MT.kap2 (d*j)) u-u*(quadratic b c (Real.log u)+shiftFactor d)| ≤
      (131072^2+131072*|b|+|c|+2)*(1+(Real.log d)^2)*u^(1-δ) := by
  have hempty : below u=∅ := by simp [below,Nat.floor_eq_zero.mpr hu₁]
  simp only [partialSum,hempty,Finset.sum_empty,zero_sub,abs_neg,abs_mul,abs_of_pos hu]
  let W := u^(-(1/131072):ℝ)
  have hW : 1 ≤ W := by
    dsimp [W]; rw [Real.rpow_neg_eq_inv_rpow]
    exact Real.one_le_rpow ((one_le_inv₀ hu).mpr hu₁.le) (by norm_num)
  have hW₂ : W ≤ W*W := by nlinarith only [mul_le_mul_of_nonneg_left hW (by linarith : 0 ≤ W)]
  have hlog : |Real.log u| ≤ 131072*W := by
    rw [abs_of_nonpos (Real.log_nonpos hu.le hu₁.le),← Real.log_inv]
    have h := Real.log_le_rpow_div (inv_nonneg.mpr hu.le) (show (0:ℝ)<1/131072 by norm_num)
    dsimp [W]; rw [Real.rpow_neg_eq_inv_rpow]; linarith
  have huW : u*(W*W)=u^(1-δ) := by
    dsimp [W,δ]; rw [← Real.rpow_add hu]
    nth_rw 1 [← Real.rpow_one u]; rw [← Real.rpow_add hu]; norm_num
  obtain ⟨hshift₀,hshift⟩ := shift_bound hd
  have hq : |quadratic b c (Real.log u)+shiftFactor d| ≤
      (131072^2+131072*|b|+|c|+2)*(1+(Real.log d)^2)*(W*W) := by
    have h₂ := mul_self_le_mul_self (abs_nonneg _) hlog
    have hb := mul_le_mul_of_nonneg_left (hlog.trans (mul_le_mul_of_nonneg_left hW₂ (by norm_num))) (abs_nonneg b)
    have hc := mul_le_mul_of_nonneg_left (hW.trans hW₂) (abs_nonneg c)
    have hs := mul_le_mul_of_nonneg_left (hW.trans hW₂) (sq_nonneg (Real.log d))
    have ha := (abs_add_le (quadratic b c (Real.log u)) (shiftFactor d)).trans (add_le_add
      ((abs_add_le ..).trans (add_le_add_left (abs_add_le ..) _)) (le_refl _))
    unfold quadratic at ha
    rw [abs_of_nonneg hshift₀,abs_of_nonneg (by positivity : 0 ≤ (Real.log u)^2/2),abs_mul] at ha
    rw [← sq, sq_abs] at h₂
    have hz : 0 ≤ (131072^2+131072*|b|+|c|)*((Real.log d)^2*(W*W)) := by positivity
    unfold quadratic
    nlinarith only [ha,h₂,hb,hc,hs,hshift,hz,show 0 ≤ W*W from mul_self_nonneg _]
  have h := mul_le_mul_of_nonneg_left hq hu.le
  rw [← huW]
  linarith only [h]

/-- A bound valid down to zero permits smoothing without a moving lower cutoff.
All constants are independent of the squarefree shift. -/
theorem shifted_all_scales (hRH : RiemannHypothesis) :
    ∃ b c C : ℝ, 0 < C ∧ ∀ d : ℕ, Squarefree d → ∀ u : ℝ, 0 < u →
      |partialSum (fun j => BHB.MT.kap2 (d*j)) u-u*(quadratic b c (Real.log u)+shiftFactor d)| ≤
        C*(1+(Real.log d)^2)*u^(1-δ) := by
  obtain ⟨b,c,D,hD,hG⟩ := kap2_summatory_of_RH hRH
  let A := 131072^2+131072*|b|+|c|+2
  let B := 3+2/Real.log 2
  have hL : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hB : 0 ≤ B := by dsimp [B]; positivity
  refine ⟨b,c,A+B+D,by linarith,?_⟩
  intro d hd u hu
  have hpow := Real.rpow_nonneg hu.le (1-δ)
  by_cases hu₁ : u < 1
  · exact (small_argument b c hd hu hu₁).trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right (show A ≤ A+B+D by linarith) (by positivity)) hpow)
  have hu₁ := le_of_not_gt hu₁
  let U := u^(1-δ)
  have hU : 1 ≤ U := Real.one_le_rpow hu₁ (by norm_num [δ])
  have hlog : Real.log u ≤ 2*U := by
    have h := Real.log_le_rpow_div hu.le (show (0:ℝ)<1/2 by norm_num)
    have hp : u^(1/2:ℝ) ≤ U := Real.rpow_le_rpow_of_exponent_le hu₁ (by norm_num [δ])
    linarith
  have hcost : 3+Real.log u/Real.log 2 ≤ B*U := by
    have h := div_le_div_of_nonneg_right hlog hL.le
    rw [show 2*U/Real.log 2=2/Real.log 2*U by ring] at h
    dsimp [B]; linarith only [h,hU]
  have he := (abs_add_le (partialSum (fun j => BHB.MT.kap2 (d*j)) u-partialSum BHB.MT.kap2 u-u*shiftFactor d)
    (partialSum BHB.MT.kap2 u-u*quadratic b c (Real.log u))).trans
      (add_le_add (shift_estimate hd hu₁) (hG u hu₁))
  rw [show partialSum (fun j => BHB.MT.kap2 (d*j)) u-u*(quadratic b c (Real.log u)+shiftFactor d) =
    (partialSum (fun j => BHB.MT.kap2 (d*j)) u-partialSum BHB.MT.kap2 u-u*shiftFactor d)+
    (partialSum BHB.MT.kap2 u-u*quadratic b c (Real.log u)) by ring]
  apply he.trans
  change (3+Real.log u/Real.log 2)*(Real.log d)^2+D*U ≤ (A+B+D)*(1+(Real.log d)^2)*U
  have hc := mul_le_mul_of_nonneg_right hcost (sq_nonneg (Real.log d))
  nlinarith only [hc,mul_nonneg hB (show 0 ≤ U by linarith),mul_nonneg hA (show 0 ≤ U by linarith),
    mul_nonneg (add_nonneg hA hD.le) (mul_nonneg (sq_nonneg (Real.log d)) (show 0 ≤ U by linarith))]

private theorem prefix_zero (f : ℕ → ℝ) (h₀ : f 0=0) (x : ℝ) :
    ∑ n ∈ Finset.Icc 0 ⌊x⌋₊, f n = partialSum f x := by
  rw [Finset.Icc_eq_cons_Ioc (Nat.zero_le _),Finset.sum_cons,h₀,zero_add]; rfl

private theorem prefix_growth {f : ℕ → ℝ} {C : ℝ} (hC : 0 ≤ C)
    (hf : ∀ n : ℕ, |f n| ≤ C*(1+n)^2) {t : ℝ} (ht : 0 ≤ t) :
    |partialSum f t| ≤ C*(1+t)^3 := by
  apply (Finset.abs_sum_le_sum_abs ..).trans
  calc
    _ ≤ ∑ _n ∈ below t, C*(1+t)^2 := by
      apply Finset.sum_le_sum
      intro n hn
      apply (hf n).trans
      have hn' := (Nat.le_floor_iff ht).mp (Finset.mem_Ioc.mp hn).2
      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) (by linarith) _) hC
    _ = (⌊t⌋₊:ℝ)*(C*(1+t)^2) := by simp [below]
    _ ≤ _ := by
      have h := mul_le_mul_of_nonneg_right (Nat.floor_le ht) (show 0 ≤ C*(1+t)^2 by positivity)
      nlinarith only [h,mul_nonneg hC (sq_nonneg (1+t))]

lemma scaled_decay {F : ℝ → ℝ} {Y : ℝ} (hY : 0 < Y) {j : ℕ}
    (hF : ∃ A : ℝ, ∀ u : ℝ, 0 ≤ u → |F u| ≤ A/(1+u)^j) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ t : ℝ, 0 ≤ t → |F (t/Y)| ≤ B/(1+t)^j := by
  obtain ⟨A,hA⟩ := hF
  let m := max 1 Y
  have h₁ : 1 ≤ m := le_max_left .. 
  have h₂ : Y ≤ m := le_max_right ..
  refine ⟨|A| * m^j,by positivity [show 0 ≤ m by linarith],?_⟩
  intro t ht
  have hu := div_nonneg ht hY.le
  apply (hA _ hu).trans
  have he : 1+t ≤ m*(1+t/Y) := by
    have h := mul_le_mul_of_nonneg_right h₂ hu
    have : Y*(t/Y)=t := by field_simp
    nlinarith only [h,this,h₁]
  have hj := pow_le_pow_left₀ (by linarith : 0 ≤ 1+t) he j
  rw [mul_pow] at hj
  apply (div_le_div_of_nonneg_right (le_abs_self A) (by positivity)).trans
  rw [div_le_div_iff₀ (by positivity) (by positivity)]
  nlinarith only [mul_le_mul_of_nonneg_left hj (abs_nonneg A)]

lemma decay_product {f g A B z : ℝ} {j : ℕ} (hz : 0 < z) (hA : 0 ≤ A)
    (hf : |f| ≤ A/z^(j+2)) (hg : |g| ≤ B*z^j) : |f*g| ≤ A*B/z^2 := by
  rw [abs_mul]
  apply (mul_le_mul hf hg (abs_nonneg _) (by positivity)).trans
  exact le_of_eq (by rw [pow_add]; field_simp)

/-- Exact scaled partial summation for the actual one-sided board weights.
The quadratic coefficient-growth constant may depend on the arithmetic sequence. -/
theorem smooth_abel {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) (f : ℕ → ℝ) (h₀ : f 0=0)
    {C : ℝ} (hC : 0 ≤ C) (hf : ∀ n : ℕ, |f n| ≤ C*(1+n)^2) {Y : ℝ} (hY : 0 < Y) :
    (∑' n : ℕ, H (n/Y)*f n) = -(∫ v in Set.Ioi 0, deriv H v*partialSum f (Y*v)) := by
  obtain ⟨H',hd,hcont,hdec⟩ := hH.deriv
  obtain ⟨A,hA,hA'⟩ := scaled_decay hY (hH.decay 5)
  obtain ⟨A₄,hA₄,hA₄'⟩ := scaled_decay hY (hH.decay 4)
  obtain ⟨B,hB,hB'⟩ := scaled_decay hY (hdec 5)
  let F := fun t : ℝ => H (t/Y)
  have hFd (t : ℝ) : HasDerivAt F (H' (t/Y)/Y) t := by
    exact ((hd (t/Y)).comp t ((hasDerivAt_id t).div_const Y)).congr_deriv (by ring)
  have hc : Continuous (deriv F) := by
    have h : Continuous (fun t : ℝ => H' (t/Y)/Y) := (hcont.comp (continuous_id.div_const Y)).div_const Y
    exact h.congr fun t => (hFd t).deriv.symm
  have hlim₁ : Filter.Tendsto (fun n : ℕ => A*C/(1+(n:ℝ))^2) Filter.atTop (nhds 0) := by
    have h : Filter.Tendsto (fun n : ℕ => (1+(n:ℝ))^2) Filter.atTop Filter.atTop :=
      (Filter.tendsto_pow_atTop (by norm_num : 2 ≠ 0)).comp
        (Filter.tendsto_atTop_add_const_left _ _ tendsto_natCast_atTop_atTop)
    exact Filter.Tendsto.div_atTop tendsto_const_nhds h
  have hlim : Filter.Tendsto (fun n : ℕ => F n*∑ k ∈ Finset.Icc 0 n, f k) Filter.atTop (nhds 0) := by
    apply squeeze_zero_norm _ hlim₁
    intro n
    rw [Real.norm_eq_abs,← Nat.floor_natCast (R:=ℝ) (n:=n),prefix_zero f h₀,Nat.floor_natCast]
    exact decay_product (by positivity) hA (hA' n (Nat.cast_nonneg n))
      (prefix_growth hC hf (Nat.cast_nonneg n))
  let g := fun t : ℝ => (B*C/Y)/(1+t)^2
  have hg : IntegrableOn g (Set.Ioi 1) := by
    simpa only [div_one,one_mul,g] using
      (BHB.Arith.SC9.integral_decay_sq (X:=1) zero_lt_one (K:=B*C/Y) (by positivity)).1
  have hdom : (fun t : ℝ => deriv F t*∑ k ∈ Finset.Icc 0 ⌊t⌋₊, f k) =O[Filter.atTop] g := by
    apply Asymptotics.IsBigO.of_bound 1
    filter_upwards [Filter.eventually_ge_atTop (0:ℝ)] with t ht
    rw [Real.norm_eq_abs,one_mul,(hFd t).deriv,prefix_zero f h₀,Real.norm_eq_abs]
    apply le_trans _ (le_abs_self _)
    have h := div_le_div_of_nonneg_right (decay_product (by positivity) hB (hB' t ht)
      (prefix_growth hC hf ht)) hY.le
    dsimp [g]; rw [div_mul_eq_mul_div,abs_div,abs_of_pos hY]; convert h using 1; ring
  have he := tendsto_sum_mul_atTop_nhds_one_sub_integral f (f:=F)
    (fun t _ => (hFd t).differentiableAt) (hc.continuousOn.locallyIntegrableOn measurableSet_Ici)
    hlim hdom ⟨Set.Ioi 1,Filter.Ioi_mem_atTop 1,hg⟩
  have hsum : Summable (fun n : ℕ => F n*f n) := by
    have hn := (summable_nat_add_iff 1).mpr (summable_one_div_nat_pow.mpr (by norm_num : 1 < 2))
    have hmajor : Summable (fun n : ℕ => A₄*C/(1+(n:ℝ))^2) := by
      simpa only [Nat.cast_add,Nat.cast_one,add_comm (1:ℝ),mul_one_div] using hn.mul_left (A₄*C)
    apply Summable.of_norm_bounded hmajor
    intro n
    exact decay_product (by positivity) hA₄ (hA₄' n (Nat.cast_nonneg n)) (hf n)
  have hlim₂ := (Filter.tendsto_add_atTop_iff_nat 1).mpr hsum.hasSum.tendsto_sum_nat
  simp only [Nat.range_succ_eq_Icc_zero] at hlim₂
  have hh := tendsto_nhds_unique hlim₂ he
  rw [zero_sub] at hh
  change (∑' n : ℕ, F n*f n)=_
  rw [hh]
  congr 1
  let G := fun v : ℝ => deriv H v*partialSum f (Y*v)
  have hid (t : ℝ) : deriv F t*∑ k ∈ Finset.Icc 0 ⌊t⌋₊, f k = Y⁻¹*G (Y⁻¹*t) := by
    rw [(hFd t).deriv,prefix_zero f h₀]
    dsimp [G]; rw [(hd _).deriv,show Y*(Y⁻¹*t)=t by field_simp,← div_eq_inv_mul]; ring
  simp_rw [hid]
  rw [integral_const_mul,integral_comp_mul_left_Ioi G 0 (inv_pos.mpr hY),mul_zero,inv_inv,smul_eq_mul]
  field_simp
  rfl

def coefficient (k n : ℕ) := ramanujanWeight k n*BHB.MT.kap2 n

private theorem coefficient_growth (k : ℕ) :
    ∀ n : ℕ, |coefficient k n| ≤ ((k.divisors.card:ℝ)*k)*(1+n)^2 := by
  intro n
  have hw : |ramanujanWeight k n| ≤ (k.divisors.card:ℝ)*k := by
    apply (Finset.abs_sum_le_sum_abs ..).trans
    calc
      _ ≤ ∑ _d ∈ k.divisors, (k:ℝ) := by
        apply Finset.sum_le_sum
        intro d hd
        split_ifs
        · rw [abs_mul,abs_of_nonneg (Nat.cast_nonneg (α:=ℝ) d)]
          have hm : |(μ (k/d):ℝ)| ≤ 1 := by exact_mod_cast (ArithmeticFunction.abs_moebius_le_one (n:=k/d))
          calc
            _ ≤ (1:ℝ)*d := mul_le_mul_of_nonneg_right hm (Nat.cast_nonneg _)
            _ ≤ (k:ℝ) := by rw [one_mul]; exact Nat.cast_le.mpr (Nat.divisor_le hd)
        · simp
      _ = _ := by simp
  unfold coefficient
  rw [abs_mul]
  exact mul_le_mul hw (BHB.MT.abs_kap2_le n) (abs_nonneg _) (by positivity)

private def cost (k : ℕ) := (k.divisors.card:ℝ)*(1+(Real.log k)^2)*(k:ℝ)^δ

theorem twisted_all_scales (hRH : RiemannHypothesis) :
    ∃ b c C : ℝ, 0 < C ∧ ∀ k : ℕ, Squarefree k → ∀ x : ℝ, 0 < x →
      |partialSum (coefficient k) x-x*principalPolynomial k b c (Real.log x)| ≤
        C*cost k*x^(1-δ) := by
  obtain ⟨b,c,C,hC,hS⟩ := shifted_all_scales hRH
  refine ⟨b,c,C,hC,?_⟩
  intro k hk x hx
  have hk₀ : 0 < (k:ℝ) := by exact_mod_cast Nat.pos_of_ne_zero hk.ne_zero
  unfold coefficient
  rw [twisted_prefix,principalPolynomial,Finset.mul_sum,← Finset.sum_sub_distrib]
  apply (Finset.abs_sum_le_sum_abs ..).trans
  calc
    _ ≤ ∑ _d ∈ k.divisors, C*(1+(Real.log k)^2)*(k:ℝ)^δ*x^(1-δ) := by
      apply Finset.sum_le_sum
      intro d hd
      have hdR : 0 < (d:ℝ) := by exact_mod_cast Nat.pos_of_mem_divisors hd
      have hdk : (d:ℝ) ≤ k := by exact_mod_cast Nat.divisor_le hd
      let u := x/d
      have hu : 0 < u := div_pos hx hdR
      have hdu : (d:ℝ)*u=x := by dsimp [u]; field_simp
      have hl : Real.log x-Real.log d=Real.log u := (Real.log_div hx.ne' hdR.ne').symm
      have hpow : (d:ℝ)*u^(1-δ) = (d:ℝ)^δ*x^(1-δ) := by
        rw [← hdu,Real.mul_rpow hdR.le hu.le,← mul_assoc,← Real.rpow_add hdR]; ring_nf
        rw [Real.rpow_one,mul_comm]
      have hscale : C*(1+(Real.log d)^2)*(d:ℝ)^δ ≤ C*(1+(Real.log k)^2)*(k:ℝ)^δ := by
        apply mul_le_mul _ (Real.rpow_le_rpow hdR.le hdk (by norm_num [δ])) (Real.rpow_nonneg hdR.le _) (by positivity)
        apply mul_le_mul_of_nonneg_left _ hC.le
        have h := mul_self_le_mul_self (Real.log_natCast_nonneg d) (Real.log_le_log hdR hdk)
        nlinarith only [h]
      have hterm := hS d (hk.squarefree_of_dvd (Nat.dvd_of_mem_divisors hd)) _ hu
      have hm : |(μ (k/d):ℝ)| ≤ 1 := by exact_mod_cast (ArithmeticFunction.abs_moebius_le_one (n:=k/d))
      rw [hl]
      let P := quadratic b c (Real.log u)+shiftFactor d
      let S := partialSum (fun j => BHB.MT.kap2 (d*j)) u
      change |((μ (k/d):ℝ)*d)*S-x*((μ (k/d):ℝ)*P)| ≤ _
      rw [show ((μ (k/d):ℝ)*d)*S-x*((μ (k/d):ℝ)*P)=(μ (k/d):ℝ)*(d*(S-u*P)) by rw [← hdu]; ring,
        abs_mul,abs_mul,abs_of_pos hdR]
      have h := mul_le_mul hm (mul_le_mul_of_nonneg_left hterm hdR.le)
        (mul_nonneg hdR.le (abs_nonneg _)) zero_le_one
      apply h.trans
      rw [one_mul]
      have he := congrArg (fun y => C*(1+(Real.log d)^2)*y) hpow
      nlinarith only [he,mul_le_mul_of_nonneg_right hscale (Real.rpow_nonneg hx.le (1-δ))]
    _ = _ := by simp [cost]; ring

private theorem integrable_sq_decay {g : ℝ → ℝ} (hm : Measurable g) {B : ℝ}
    (hg : ∀ t : ℝ, 0 < t → |g t| ≤ B/(1+t)^2) : IntegrableOn g (Set.Ioi 0) := by
  apply Integrable.mono' ((BHB.MT.SM1.integrableOn_inv_pow 0).const_mul B) hm.aestronglyMeasurable
  filter_upwards [ae_restrict_mem («μ»:=volume) (measurableSet_Ioi (a:=(0:ℝ)))] with t ht
  simpa only [Real.norm_eq_abs,Nat.zero_add,mul_one_div] using hg t ht

private theorem derivative_data {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) :
    Continuous (deriv H) ∧ ∀ j : ℕ, ∃ B : ℝ, 0 ≤ B ∧ ∀ t : ℝ, 0 ≤ t → |deriv H t| ≤ B/(1+t)^j := by
  obtain ⟨H',hd,hc,hdec⟩ := hH.deriv
  have he : deriv H=H' := funext fun t => (hd t).deriv
  rw [he]
  refine ⟨hc,?_⟩
  intro j
  obtain ⟨B,hB⟩ := hdec j
  refine ⟨|B|,abs_nonneg _,fun t ht => (hB t ht).trans (div_le_div_of_nonneg_right
    (le_abs_self _) (by positivity))⟩

def derivativeMoment (H : ℝ → ℝ) := ∫ t in Set.Ioi 0, |deriv H t| * t^(1-δ)

private theorem integrable_moment {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) :
    IntegrableOn (fun t : ℝ => |deriv H t| * t^(1-δ)) (Set.Ioi 0) := by
  obtain ⟨hc,hd⟩ := derivative_data hH
  obtain ⟨B,hB,hB'⟩ := hd 3
  apply integrable_sq_decay (hc.abs.measurable.mul (measurable_id.pow_const _)) (B:=B)
  intro t ht
  have hp : t^(1-δ) ≤ 1+t := by
    rcases le_or_gt t 1 with h | h
    · linarith [Real.rpow_le_one ht.le h (show 0 ≤ 1-δ by norm_num [δ])]
    · have h' := Real.rpow_le_rpow_of_exponent_le h.le (show 1-δ ≤ 1 by norm_num [δ])
      rw [Real.rpow_one] at h'; linarith
  have h := decay_product (j:=1) (f:=deriv H t) (g:=t^(1-δ)) (A:=B) (B:=1)
    (by linarith : 0 < 1+t) hB (hB' t ht.le) (by simpa [abs_of_nonneg (Real.rpow_nonneg ht.le _)] using hp)
  change |(|deriv H t| * t^(1-δ))| ≤ _
  simpa only [abs_mul,abs_abs,mul_one,abs_of_nonneg (Real.rpow_nonneg ht.le _)] using h

private theorem integrable_prefix {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) (k : ℕ) {Y : ℝ} (hY : 0 < Y) :
    IntegrableOn (fun t : ℝ => deriv H t*partialSum (coefficient k) (Y*t)) (Set.Ioi 0) := by
  obtain ⟨hc,hd⟩ := derivative_data hH
  obtain ⟨B,hB,hB'⟩ := hd 5
  have hm (f : ℕ → ℝ) : Measurable (partialSum f) :=
    (measurable_of_countable (f:=fun N : ℕ => ∑ n ∈ Finset.Ioc 0 N, f n)).comp Nat.measurable_floor
  let m := max 1 Y
  let C := (k.divisors.card:ℝ)*k
  have hC : 0 ≤ C := by dsimp [C]; positivity
  apply integrable_sq_decay (hc.measurable.mul ((hm _).comp (measurable_const.mul measurable_id)))
    (B:=B*(C*m^3))
  intro t ht
  have h₁ : 1 ≤ m := le_max_left ..
  have h₂ : Y ≤ m := le_max_right ..
  have hg : |partialSum (coefficient k) (Y*t)| ≤ C*m^3*(1+t)^3 := by
    apply (prefix_growth hC (coefficient_growth k) (mul_nonneg hY.le ht.le)).trans
    rw [mul_assoc C,← mul_pow]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity)
      (by nlinarith only [h₁,mul_le_mul_of_nonneg_right h₂ ht.le]) _) hC
  exact decay_product (by positivity) hB (hB' t ht.le) hg

def smoothMain (H : ℝ → ℝ) (k : ℕ) (b c Y : ℝ) :=
  -(∫ t in Set.Ioi 0, deriv H t*((Y*t)*principalPolynomial k b c (Real.log (Y*t))))

/-- Uniform smoothed asymptotic for the Ramanujan-weighted divisor coefficient
at the actual board profile, with an integrable derivative moment. -/
theorem smooth_principal_of_RH (hRH : RiemannHypothesis) :
    ∃ b c C : ℝ, 0 < C ∧ ∀ H : ℝ → ℝ, BHB.Arith.Adm H → ∀ k : ℕ, Squarefree k →
      ∀ Y : ℝ, 0 < Y →
        |(∑' n : ℕ, H (n/Y)*coefficient k n)-smoothMain H k b c Y| ≤
          C*cost k*Y^(1-δ)*derivativeMoment H := by
  obtain ⟨b,c,C,hC,hS⟩ := twisted_all_scales hRH
  refine ⟨b,c,C,hC,?_⟩
  intro H hH k hk Y hY
  let S := fun t => partialSum (coefficient k) (Y*t)
  let P := fun t : ℝ => (Y*t)*principalPolynomial k b c (Real.log (Y*t))
  let E := fun t => deriv H t*(S t-P t)
  let D := C*cost k*Y^(1-δ)
  have h₀ : coefficient k 0=0 := by simp [coefficient,BHB.MT.kap2]
  rw [smooth_abel hH _ h₀ (by positivity) (coefficient_growth k) hY]
  have hb (t : ℝ) (ht : 0 < t) : |E t| ≤ D*(|deriv H t| * t^(1-δ)) := by
    dsimp [E]; rw [abs_mul]
    have h := hS k hk (Y*t) (mul_pos hY ht)
    rw [Real.mul_rpow hY.le ht.le] at h
    have he := mul_le_mul_of_nonneg_left h (abs_nonneg (deriv H t))
    dsimp [D]; change |deriv H t| * |_ - _| ≤ _
    linarith only [he]
  have hi := (integrable_moment hH).const_mul D
  have hprefix := integrable_prefix hH k hY
  have hm : Measurable E := by
    have hpsum : Measurable (partialSum (coefficient k)) :=
      (measurable_of_countable (f:=fun N : ℕ => ∑ n ∈ Finset.Ioc 0 N, coefficient k n)).comp Nat.measurable_floor
    have hmP : Measurable P := by
      unfold P principalPolynomial quadratic
      fun_prop
    exact (derivative_data hH).1.measurable.mul
      ((hpsum.comp (measurable_const.mul measurable_id)).sub hmP)
  have hae : ∀ᵐ t ∂volume.restrict (Set.Ioi 0), ‖E t‖ ≤ D*(|deriv H t| * t^(1-δ)) := by
    filter_upwards [ae_restrict_mem («μ»:=volume) (measurableSet_Ioi (a:=(0:ℝ)))] with t ht
    exact (Real.norm_eq_abs _).le.trans (hb t ht)
  have hE := Integrable.mono' hi hm.aestronglyMeasurable hae
  have hI := MeasureTheory.norm_integral_le_of_norm_le hi hae
  rw [Real.norm_eq_abs,integral_const_mul] at hI
  have hPint : IntegrableOn (fun t => deriv H t*P t) (Set.Ioi 0) := by
    convert hprefix.sub hE using 1
    funext t; dsimp [S,E]; ring
  have hID : (∫ t in Set.Ioi 0, E t) = (∫ t in Set.Ioi 0, deriv H t*S t)-
      (∫ t in Set.Ioi 0, deriv H t*P t) := by
    simp only [E,mul_sub]
    exact integral_sub hprefix hPint
  change |-(∫ t in Set.Ioi 0, deriv H t*S t)- -(∫ t in Set.Ioi 0, deriv H t*P t)| ≤ _
  rw [neg_sub_neg,abs_sub_comm,← hID]
  exact hI

def logMoment (H : ℝ → ℝ) (j : ℕ) := -(∫ t in Set.Ioi 0, deriv H t*(t*(Real.log t)^j))

private theorem log_weight {t : ℝ} (ht : 0 < t) (j : ℕ) (hj : j ≤ 2) :
    |t*(Real.log t)^j| ≤ 20*(1+t)^3 := by
  rw [abs_mul,abs_of_pos ht,abs_pow]
  have hsq : t*|Real.log t|^2 ≤ 16*(1+t)^3 := by
    rcases le_or_gt 1 t with h | h
    · rw [abs_of_nonneg (Real.log_nonneg h)]
      have hs := mul_self_le_mul_self (Real.log_nonneg h) (Real.log_le_self ht.le)
      nlinarith only [mul_le_mul_of_nonneg_left hs ht.le,ht.le,sq_nonneg t,
        mul_nonneg ht.le (sq_nonneg t)]
    · have hr := Real.log_le_rpow_div (inv_nonneg.mpr ht.le) (show (0:ℝ)<1/2 by norm_num)
      have hh : |Real.log t| ≤ 2*t^(-(1/2):ℝ) := by
        rw [abs_of_nonpos (Real.log_nonpos ht.le h.le),← Real.log_inv,Real.rpow_neg_eq_inv_rpow]
        linarith
      have hs := mul_self_le_mul_self (abs_nonneg _) hh
      have he : t*(t^(-(1/2):ℝ)*t^(-(1/2):ℝ))=1 := by
        rw [← Real.rpow_add ht,show (-(1/2):ℝ)+ -(1/2)= -1 by norm_num,
          Real.rpow_neg_one,mul_inv_cancel₀ ht.ne']
      nlinarith only [mul_le_mul_of_nonneg_left hs ht.le,he,ht.le,sq_nonneg t,
        mul_nonneg ht.le (sq_nonneg t)]
  have h₁ : t ≤ (1+t)^3 := by nlinarith only [ht.le,sq_nonneg t,mul_nonneg ht.le (sq_nonneg t)]
  have h₃ : 0 ≤ (1+t)^3 := by positivity
  interval_cases j <;> try simp only [pow_zero,pow_one,mul_one]
  all_goals
    nlinarith only [h₁,h₃,hsq,mul_nonneg ht.le (sq_nonneg (|Real.log t|-1))]

private theorem logMoment_integrable {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) {j : ℕ} (hj : j ≤ 2) :
    IntegrableOn (fun t : ℝ => deriv H t*(t*(Real.log t)^j)) (Set.Ioi 0) := by
  obtain ⟨hc,hd⟩ := derivative_data hH
  obtain ⟨B,hB,hB'⟩ := hd 5
  apply integrable_sq_decay (hc.measurable.mul (measurable_id.mul (Real.measurable_log.pow_const j))) (B:=B*20)
  exact fun t ht => decay_product (by positivity) hB (hB' t ht.le) (log_weight ht j hj)

/-- The leading moment of each side is its mass. -/
theorem zeroth_logMoment {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) :
    logMoment H 0 = ∫ t in Set.Ioi 0, H t := by
  obtain ⟨H',hd,_,_⟩ := hH.deriv
  have hc : Continuous H := continuous_iff_continuousAt.mpr fun t => (hd t).continuousAt
  obtain ⟨A,hA⟩ := hH.decay 2
  have hHᵢ := integrable_sq_decay hc.measurable (B:=A) fun t ht => hA t ht.le
  have hgᵢ : IntegrableOn (fun t : ℝ => deriv H t*t) (Set.Ioi 0) := by
    simpa using logMoment_integrable hH (j:=0) (by norm_num)
  obtain ⟨B,hB⟩ := hH.decay 3
  have hL : Filter.Tendsto (fun t : ℝ => H t*t) Filter.atTop (nhds 0) := by
    have hl : Filter.Tendsto (fun t : ℝ => |B|/(1+t)^2) Filter.atTop (nhds 0) :=
      Filter.Tendsto.div_atTop tendsto_const_nhds ((Filter.tendsto_pow_atTop (by norm_num : 2 ≠ 0)).comp
        (Filter.tendsto_atTop_add_const_left _ _ Filter.tendsto_id))
    apply squeeze_zero_norm' _ hl
    filter_upwards [Filter.eventually_ge_atTop (0:ℝ)] with t ht
    rw [Real.norm_eq_abs]
    have h := decay_product (f:=H t) (g:=t) (j:=1) (A:=|B|) (B:=1) (by positivity : 0<1+t)
      (abs_nonneg B) ((hB t ht).trans (div_le_div_of_nonneg_right (le_abs_self B) (by positivity)))
      (by rw [pow_one,one_mul,abs_of_nonneg ht]; linarith)
    simpa using h
  have h := integral_Ioi_of_hasDerivAt_of_tendsto' (a:=0) (f:=fun t : ℝ => H t*t)
    (f':=fun t => deriv H t*t+H t)
    (fun t _ => ((hd t).mul (hasDerivAt_id t)).congr_deriv (by rw [(hd t).deriv]; simp))
    (hgᵢ.add hHᵢ) hL
  rw [integral_add hgᵢ hHᵢ,mul_zero,sub_zero] at h
  simp only [logMoment,pow_zero,mul_one]
  linarith only [h]

private theorem integrate_quadratic {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) {k : ℕ}
    {b c A B C Y : ℝ} (hY : 0 < Y)
    (hP : ∀ t : ℝ, principalPolynomial k b c t=A*t^2+B*t+C) :
    smoothMain H k b c Y = Y*((A*(Real.log Y)^2+B*Real.log Y+C)*logMoment H 0 +
      (2*A*Real.log Y+B)*logMoment H 1+A*logMoment H 2) := by
  let φ := fun (j : ℕ) (t : ℝ) => deriv H t*(t*(Real.log t)^j)
  let A₀ := A*(Real.log Y)^2+B*Real.log Y+C
  let A₁ := 2*A*Real.log Y+B
  have h₀ : IntegrableOn (fun t => (Y*A₀)*φ 0 t) (Set.Ioi 0) :=
    (logMoment_integrable hH (by norm_num : 0 ≤ 2)).const_mul _
  have h₁ : IntegrableOn (fun t => (Y*A₁)*φ 1 t) (Set.Ioi 0) :=
    (logMoment_integrable hH (by norm_num : 1 ≤ 2)).const_mul _
  have h₂ : IntegrableOn (fun t => (Y*A)*φ 2 t) (Set.Ioi 0) :=
    (logMoment_integrable hH (by norm_num : 2 ≤ 2)).const_mul _
  have he : (∫ t in Set.Ioi 0, deriv H t*((Y*t)*principalPolynomial k b c (Real.log (Y*t)))) =
      ∫ t in Set.Ioi 0, ((Y*A₀)*φ 0 t+(Y*A₁)*φ 1 t+(Y*A)*φ 2 t) := by
    apply setIntegral_congr_fun measurableSet_Ioi
    intro t ht
    dsimp only [φ,A₀,A₁]
    rw [hP,Real.log_mul hY.ne' (ne_of_gt ht)]; ring
  unfold smoothMain
  have h₀₁ : IntegrableOn (fun t => (Y*A₀)*φ 0 t+(Y*A₁)*φ 1 t) (Set.Ioi 0) := h₀.add h₁
  rw [he,integral_add h₀₁ h₂,integral_add h₀ h₁]
  simp only [integral_const_mul]
  change -((Y*A₀)*_+(Y*A₁)*_+(Y*A)*_) = Y*(A₀*logMoment H 0+A₁*logMoment H 1+A*logMoment H 2)
  dsimp only [logMoment,φ]; ring

theorem smooth_one {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) (b c : ℝ) {Y : ℝ} (hY : 0 < Y) :
    smoothMain H 1 b c Y =
      Y*(quadratic b c (Real.log Y)*(∫ t in Set.Ioi 0, H t)+
        (Real.log Y+b)*logMoment H 1+logMoment H 2/2) := by
  rw [integrate_quadratic hH (A:=1/2) (B:=b) (C:=c) hY (fun t => by rw [principal_one]; unfold quadratic; ring),
    zeroth_logMoment hH]
  unfold quadratic; ring

theorem smooth_prime {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) {p : ℕ} (hp : p.Prime)
    (b c : ℝ) {Y : ℝ} (hY : 0 < Y) : smoothMain H p b c Y =
      Y*((-(Real.log Y+b)*Real.log p+(Real.log p)^2/2+(1+1/((p:ℝ)-1))*(Real.log p)^2)*
        (∫ t in Set.Ioi 0, H t)-Real.log p*logMoment H 1) := by
  rw [integrate_quadratic hH (A:=0) (B:= -Real.log p)
    (C:= -b*Real.log p+(Real.log p)^2/2+(1+1/((p:ℝ)-1))*(Real.log p)^2) hY
    (fun t => by rw [principal_prime hp]; ring),zeroth_logMoment hH]
  ring

theorem smooth_two {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hne : p ≠ q) (b c : ℝ) {Y : ℝ} (hY : 0 < Y) :
    smoothMain H (p*q) b c Y = Y*(∫ t in Set.Ioi 0, H t)*Real.log p*Real.log q := by
  rw [integrate_quadratic hH (A:=0) (B:=0) (C:=Real.log p*Real.log q) hY
    (fun t => by rw [principal_two hp hq hne]; ring),zeroth_logMoment hH]
  ring

theorem smooth_vanish {k : ℕ} (hk : Squarefree k) (h₁ : k ≠ 1) (h₂ : ¬k.Prime)
    (h₃ : ∀ p q : ℕ, p.Prime → q.Prime → p*q ≠ k) (H : ℝ → ℝ) (b c Y : ℝ) :
    smoothMain H k b c Y=0 := by simp [smoothMain,principal_vanish hk h₁ h₂ h₃]

private theorem sum_divisors_over_totient {N : ℕ} {s : Finset ℕ} (hs : s ⊆ Finset.Icc 1 N) :
    (∑ k ∈ s, (k.divisors.card:ℝ)*(1+(Real.log k)^2)/k.totient) ≤
      (1+(Real.log N)^2)*(1+Real.log N)^4 := by
  let D := BHB.Arith.dtau 2
  calc
    _ ≤ ∑ k ∈ s, (1+(Real.log N)^2)*(D k^2/k) := by
      apply Finset.sum_le_sum
      intro k hk
      obtain ⟨h₁,hN⟩ := Finset.mem_Icc.mp (hs hk)
      have hkp : 0 < (k:ℝ) := by exact_mod_cast h₁
      have hφ : 0 < (k.totient:ℝ) := by exact_mod_cast Nat.totient_pos.mpr h₁
      have ht := BHB.Arith.div_totient_le h₁
      have hlog := Real.log_le_log hkp (Nat.cast_le.mpr hN)
      have hsq := mul_self_le_mul_self (Real.log_natCast_nonneg k) hlog
      have hD : 0 ≤ D k := BHB.Arith.dtau_nonneg .. 
      rw [← BHB.Arith.dtau_two]
      change D k*(1+(Real.log k)^2)/(k.totient:ℝ) ≤ _
      calc
        _ = (1+(Real.log k)^2)*(D k*((k:ℝ)/k.totient)/k) := by field_simp
        _ ≤ _ := mul_le_mul (by nlinarith only [hsq]) (div_le_div_of_nonneg_right
          ((mul_le_mul_of_nonneg_left ht hD).trans_eq (sq (D k)).symm) hkp.le) (by positivity) (by positivity)
    _ = (1+(Real.log N)^2)*∑ k ∈ s, D k^2/k := (Finset.mul_sum ..).symm
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply (Finset.sum_le_sum_of_subset_of_nonneg hs (fun k _ _ => by positivity)).trans
      exact BHB.Arith.sum_dtau_pow_div_le 2 2 N

def remainder (H : ℝ → ℝ) (k : ℕ) (b c Y : ℝ) :=
  (∑' n : ℕ, H (n/Y)*coefficient k n)-smoothMain H k b c Y

/-- Total principal-character error over bounded prime-label and mollifier
weights. The scale in the zero formula is obtained by taking X = T/(2π). -/
theorem principal_band_error (hRH : RiemannHypothesis) (H : ℝ → ℝ) (hH : BHB.Arith.Adm H) :
    ∃ b c C : ℝ, 0 ≤ C ∧ ∀ (X : ℝ), 0 < X → ∀ (N M : ℕ) (s q : Finset ℕ),
      s ⊆ Finset.Icc 1 N → (∀ k ∈ s, Squarefree k) → q ⊆ Finset.Icc 1 M →
      ∀ (a z : ℕ → ℝ), (∀ k ∈ s, |a k| ≤ 1) → (∀ p ∈ q, |z p| ≤ 1) →
      |∑ k ∈ s, ∑ p ∈ q, (a k*z p)/((k:ℝ)*k.totient)*remainder H k b c (k*X/p)| ≤
        C*X^(1-δ)*(M:ℝ)^δ*(1+Real.log M)*(1+(Real.log N)^2)*(1+Real.log N)^4 := by
  obtain ⟨b,c,C,hC,hR⟩ := smooth_principal_of_RH hRH
  let C' := C*derivativeMoment H
  have hC' : 0 ≤ C' := mul_nonneg hC.le (setIntegral_nonneg measurableSet_Ioi
    (fun u hu => mul_nonneg (abs_nonneg _) (Real.rpow_nonneg (le_of_lt hu) _)))
  refine ⟨b,c,C',hC',?_⟩
  intro X hX N M s q hs hsq hq a z ha hz
  let U := C'*X^(1-δ)*(M:ℝ)^δ
  let w := fun k : ℕ => (k.divisors.card:ℝ)*(1+(Real.log k)^2)/k.totient
  have hU : 0 ≤ U := by dsimp [U]; positivity
  have hw (k : ℕ) : 0 ≤ w k := by dsimp [w]; positivity
  have hpSum : (∑ p ∈ q, (1:ℝ)/p) ≤ 1+Real.log M :=
    (Finset.sum_le_sum_of_subset_of_nonneg hq (fun p _ _ => by positivity)).trans
      (BHB.Arith.sum_Icc_one_div_le_one_add_log M)
  have hbound (k : ℕ) (hk : k ∈ s) (p : ℕ) (hp : p ∈ q) :
      |(a k*z p)/((k:ℝ)*k.totient)*remainder H k b c (k*X/p)| ≤ (U*w k)*(1/p) := by
    have hk₁ := (Finset.mem_Icc.mp (hs hk)).1
    obtain ⟨hp₁,hpM⟩ := Finset.mem_Icc.mp (hq hp)
    have hkR : 0 < (k:ℝ) := by exact_mod_cast hk₁
    have hpR : 0 < (p:ℝ) := by exact_mod_cast hp₁
    have hφ : 0 < (k.totient:ℝ) := by exact_mod_cast Nat.totient_pos.mpr hk₁
    have h := hR H hH k (hsq k hk) ((k:ℝ)*X/p) (by positivity)
    have hweight : |a k*z p| ≤ 1 := by
      rw [abs_mul]; simpa only [one_mul] using mul_le_mul (ha _ hk) (hz _ hp) (abs_nonneg _) zero_le_one
    rw [abs_mul,abs_div,abs_of_pos (mul_pos hkR hφ)]
    apply (mul_le_mul (div_le_div_of_nonneg_right hweight (mul_pos hkR hφ).le) h (abs_nonneg _) (by positivity)).trans
    have he : (k:ℝ)^δ*((k:ℝ)*X/p)^(1-δ) = (k:ℝ)*X^(1-δ)*(p:ℝ)^δ/p := by
      rw [Real.div_rpow (mul_nonneg hkR.le hX.le) hpR.le,Real.mul_rpow hkR.le hX.le]
      rw [Real.rpow_sub hkR,Real.rpow_sub hpR,Real.rpow_one,Real.rpow_one]
      field_simp [(Real.rpow_pos_of_pos hkR δ).ne',(Real.rpow_pos_of_pos hpR δ).ne',hpR.ne']
    let V := C'*X^(1-δ)*w k/p
    have hV : 0 ≤ V := by dsimp [V]; positivity [hw k]
    have hMP := Real.rpow_le_rpow (Nat.cast_nonneg (α:=ℝ) p) (Nat.cast_le.mpr hpM) (show 0 ≤ δ by norm_num [δ])
    calc
      _ = V*(p:ℝ)^δ := by
        dsimp [V,w,C',cost]
        have hl := congrArg (fun t : ℝ => (1/((k:ℝ)*k.totient))*
          (C*(k.divisors.card:ℝ)*(1+(Real.log k)^2)*t)*derivativeMoment H) he
        convert hl using 1 <;> field_simp
      _ ≤ V*(M:ℝ)^δ := mul_le_mul_of_nonneg_left hMP hV
      _ = _ := by dsimp [V,U]; ring
  apply (Finset.abs_sum_le_sum_abs ..).trans
  calc
    _ ≤ ∑ k ∈ s, (U*w k)*(1+Real.log M) := by
      apply Finset.sum_le_sum
      intro k hk
      apply (Finset.abs_sum_le_sum_abs ..).trans
      apply (Finset.sum_le_sum (hbound k hk)).trans
      rw [← Finset.mul_sum]
      exact mul_le_mul_of_nonneg_left hpSum (mul_nonneg hU (hw k))
    _ = (U*(1+Real.log M))*(∑ k ∈ s, w k) := by
      rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intros; ring
    _ ≤ _ := by
      have h := mul_le_mul_of_nonneg_left (sum_divisors_over_totient hs)
        (show 0 ≤ U*(1+Real.log M) by positivity [Real.log_natCast_nonneg M])
      exact h.trans_eq (by dsimp [U]; ring)

/-- The aggregate error is o(T), uniformly over all the displayed prime-label and
mollifier coefficients, at X = T/(2π) and every fixed label exponent h < 1. -/
theorem principal_error_negligible (hRH : RiemannHypothesis) (H : ℝ → ℝ) (hH : BHB.Arith.Adm H)
    {θ h : ℝ} (hθ₀ : 0 ≤ θ) (hθ : θ ≤ 1) (hh₀ : 0 ≤ h) (hh : h < 1) :
    ∃ b c : ℝ, ∀ ε : ℝ, 0 < ε → ∀ᶠ T : ℝ in Filter.atTop, ∀ s q : Finset ℕ,
      s ⊆ Finset.Icc 1 ⌊T^θ⌋₊ → (∀ k ∈ s, Squarefree k) → q ⊆ Finset.Icc 1 ⌊T^h⌋₊ →
      ∀ a z : ℕ → ℝ, (∀ k ∈ s, |a k| ≤ 1) → (∀ p ∈ q, |z p| ≤ 1) →
      |∑ k ∈ s, ∑ p ∈ q, (a k*z p)/((k:ℝ)*k.totient)*
        remainder H k b c (k*(T/(2*Real.pi))/p)| ≤ ε*T := by
  obtain ⟨b,c,C,hC,hE⟩ := principal_band_error hRH H hH
  refine ⟨b,c,?_⟩
  intro ε hε
  let e := δ*(1-h)/14
  have he : 0 < e := by dsimp [e,δ]; positivity [sub_pos.mpr hh]
  let A := 1+1/e
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have ht : Filter.Tendsto (fun T : ℝ => C*A^7*T^(-(7*e))) Filter.atTop (nhds 0) := by
    have h := (tendsto_rpow_neg_atTop (show 0<7*e by positivity)).const_mul (C*A^7)
    simpa using h
  filter_upwards [Filter.eventually_ge_atTop (1:ℝ),ht.eventually (gt_mem_nhds hε)] with T hT hsmall
  intro s q hs hsq hq a z ha hz
  have hT₀ : 0 < T := by linarith
  have hπ : 0 < 2*Real.pi := by positivity
  have hX := div_pos hT₀ hπ
  have hXT : T/(2*Real.pi) ≤ T := div_le_self hT₀.le (by linarith [Real.pi_gt_three])
  have hbound := hE _ hX _ _ s q hs hsq hq a z ha hz
  apply hbound.trans
  let N := ⌊T^θ⌋₊
  let M := ⌊T^h⌋₊
  have hfloor (y : ℝ) (hy : 0 ≤ y) (hy' : y ≤ 1) :
      0 < (⌊T^y⌋₊:ℝ) ∧ (⌊T^y⌋₊:ℝ) ≤ T := by
    have h₁ := (Nat.one_le_floor_iff _).mpr (Real.one_le_rpow hT hy)
    have h₂ := Real.rpow_le_rpow_of_exponent_le hT hy'
    rw [Real.rpow_one] at h₂
    exact ⟨by exact_mod_cast h₁,(Nat.floor_le (Real.rpow_nonneg hT₀.le _)).trans h₂⟩
  have hN := hfloor θ hθ₀ hθ
  have hM := hfloor h hh₀ hh.le
  let L := 1+Real.log T
  have hL : 1 ≤ L := by dsimp [L]; linarith [Real.log_nonneg hT]
  have hlogN : 1+Real.log N ≤ L := by dsimp [N,L]; linarith [Real.log_le_log hN.1 hN.2]
  have hlogM : 1+Real.log M ≤ L := by dsimp [M,L]; linarith [Real.log_le_log hM.1 hM.2]
  have hlog₂ : 1+(Real.log N)^2 ≤ L^2 := by
    have hs := mul_self_le_mul_self (Real.log_natCast_nonneg N) (Real.log_le_log hN.1 hN.2)
    dsimp [L]; nlinarith only [hs,Real.log_nonneg hT]
  have hlog₄ : (1+Real.log N)^4 ≤ L^4 :=
    pow_le_pow_left₀ (by linarith [Real.log_natCast_nonneg N]) hlogN _
  have hMδ : (M:ℝ)^δ ≤ T^(h*δ) := by
    rw [Real.rpow_mul hT₀.le]
    exact Real.rpow_le_rpow (Nat.cast_nonneg _) (Nat.floor_le (Real.rpow_nonneg hT₀.le _)) (by norm_num [δ])
  have hXδ := Real.rpow_le_rpow hX.le hXT (show 0 ≤ 1-δ by norm_num [δ])
  have hscale : (T/(2*Real.pi))^(1-δ)*(M:ℝ)^δ ≤ T^(1-14*e) := by
    apply (mul_le_mul hXδ hMδ (Real.rpow_nonneg (Nat.cast_nonneg _) _) (Real.rpow_nonneg hT₀.le _)).trans_eq
    rw [← Real.rpow_add hT₀]; congr 1; dsimp [e]; ring
  have hlogpow : L^7 ≤ A^7*T^(7*e) := by
    have h := Real.log_le_rpow_div hT₀.le he
    have h' := Real.one_le_rpow hT he.le
    have hL' : L ≤ A*T^e := (add_le_add h' h).trans_eq (by dsimp [A]; ring)
    have hL₀ : 0 ≤ L := by linarith
    have hp := pow_le_pow_left₀ hL₀ hL' 7
    rw [mul_pow,← Real.rpow_natCast (T^e) 7,← Real.rpow_mul hT₀.le] at hp
    simpa only [Nat.cast_ofNat,mul_comm e (7:ℝ)] using hp
  have hprod : (1+Real.log M)*(1+(Real.log N)^2)*(1+Real.log N)^4 ≤ L^7 := by
    apply (mul_le_mul (mul_le_mul hlogM hlog₂ (by positivity) (by linarith)) hlog₄
      (by positivity) (by positivity [show 0 ≤ L by linarith])).trans_eq
    ring
  change C*(T/(2*Real.pi))^(1-δ)*(M:ℝ)^δ*(1+Real.log M)*(1+(Real.log N)^2)*(1+Real.log N)^4 ≤ _
  calc
    _ = C*((T/(2*Real.pi))^(1-δ)*(M:ℝ)^δ)*((1+Real.log M)*(1+(Real.log N)^2)*(1+Real.log N)^4) := by ring
    _ ≤ (C*T^(1-14*e))*(A^7*T^(7*e)) := mul_le_mul (mul_le_mul_of_nonneg_left hscale hC)
      (hprod.trans hlogpow) (by positivity [Real.log_natCast_nonneg M]) (by positivity)
    _ = (C*A^7*T^(-(7*e)))*T := by
      have hp : T^(1-14*e)*T^(7*e)=T^(-(7*e))*T := by
        rw [← Real.rpow_add hT₀]
        calc
          T^(1-14*e+7*e)=T^(-(7*e)+1) := by congr 1; ring
          _ = _ := by rw [Real.rpow_add hT₀,Real.rpow_one]
      linear_combination C*A^7*hp
    _ ≤ _ := mul_le_mul_of_nonneg_right (le_of_lt hsmall) hT₀.le

/-- Identification with the board's principal character at the physical label nP. -/
theorem rmean_label {k P : ℕ} (hk : Squarefree k) (hP : P.Coprime k) (n : ℕ) :
    BHB.rmean k (n*P)=ramanujanWeight k n/(k.totient:ℝ) := by
  let g := k.gcd n
  let q := k/g
  have hk₀ := Nat.pos_of_ne_zero hk.ne_zero
  have hgk : g ∣ k := Nat.gcd_dvd_left ..
  have hg₀ : 0 < g := Nat.gcd_pos_of_pos_left _ hk₀
  have hmul : q*g=k := Nat.div_mul_cancel hgk
  have hc : q.Coprime g := Nat.coprime_of_squarefree_mul (hmul.symm ▸ hk)
  have hq₀ : 0 < q := Nat.div_pos (Nat.le_of_dvd hk₀ hgk) hg₀
  have hds : k.divisors.filter (· ∣ n)=g.divisors := by
    ext d
    simp [g,Nat.mem_divisors,Nat.dvd_gcd_iff,hk.ne_zero,hg₀.ne']
  have hφg : ∑ d ∈ g.divisors, (μ (g/d):ℝ)*d=(g.totient:ℝ) := by
    simpa only [BHB.M2.psiG,mul_one] using BHB.M2.DI.psiG_one hg₀
  have hram : ramanujanWeight k n=(μ q:ℝ)*g.totient := by
    rw [ramanujanWeight,← Finset.sum_filter,hds,← hφg,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro d hd
    have hdg := Nat.dvd_of_mem_divisors hd
    have hqd : q.Coprime (g/d) := hc.coprime_dvd_right (Nat.div_dvd_of_dvd hdg)
    rw [show k/d=q*(g/d) by rw [← hmul,Nat.mul_div_assoc _ hdg],
      ArithmeticFunction.isMultiplicative_moebius.map_mul_of_coprime hqd,Int.cast_mul,mul_assoc]
  have hφk : k.totient=q.totient*g.totient := by rw [← hmul,Nat.totient_mul hc]
  have hmean : BHB.rmean k (n*P)=(μ q:ℝ)/q.totient := by
    unfold BHB.rmean; rw [hP.gcd_mul_right_cancel_right]
  rw [hmean,hram,hφk,Nat.cast_mul]
  have hφg₀ : (g.totient:ℝ) ≠ 0 := by exact_mod_cast (Nat.totient_pos.mpr hg₀).ne'
  field_simp [hφg₀]

theorem projected_remainder {k P : ℕ} (hk : Squarefree k) (hP : P.Coprime k)
    (H : ℝ → ℝ) (b c Y : ℝ) :
    (∑' n : ℕ, H (n/Y)*BHB.MT.kap2 n*BHB.rmean k (n*P))-
        smoothMain H k b c Y/k.totient = remainder H k b c Y/k.totient := by
  have he (n : ℕ) : H (n/Y)*BHB.MT.kap2 n*BHB.rmean k (n*P)=
      (H (n/Y)*coefficient k n)*(k.totient:ℝ)⁻¹ := by
    rw [rmean_label hk hP]; unfold coefficient; ring
  simp_rw [he]
  rw [tsum_mul_right]
  unfold remainder
  ring

end PrincipalSmoothing
end
end Src_PrincipalSmoothing

section Src_PrimeLabelPrefix

noncomputable section
open ReflectedPrincipal Real
open scoped BigOperators

namespace PrimeLabelPrefix

def primeLog (n : ℕ) : ℝ := if n.Prime then Real.log n else 0
def primeLogSq (n : ℕ) : ℝ := if n.Prime then (Real.log n)^2 else 0

private theorem prime_log_sum (x : ℝ) : partialSum primeLog x=Chebyshev.theta x := by
  simp only [partialSum,primeLog,below,Chebyshev.theta,Finset.sum_filter]

private theorem power_defect {x : ℝ} (hx : 1 ≤ x) :
    |partialSum weightedMangoldt x-partialSum primeLogSq x| ≤
      Real.log x*(Chebyshev.psi x-Chebyshev.theta x) := by
  have hd := Chebyshev.psi_sub_theta_eq_sum_not_prime x
  rw [hd,Finset.mul_sum]
  have he : partialSum weightedMangoldt x-partialSum primeLogSq x =
      ∑ n ∈ (below x).filter (fun n => ¬n.Prime), Real.log n*ArithmeticFunction.vonMangoldt n := by
    unfold partialSum
    rw [← Finset.sum_sub_distrib,Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro n _
    by_cases h : n.Prime
    · simp [weightedMangoldt,primeLogSq,h,ArithmeticFunction.vonMangoldt_apply_prime h]; ring
    · simp [weightedMangoldt,primeLogSq,h]
  rw [he,abs_of_nonneg (Finset.sum_nonneg fun n _ =>
    mul_nonneg (Real.log_natCast_nonneg n) ArithmeticFunction.vonMangoldt_nonneg)]
  apply Finset.sum_le_sum
  intro n hn
  obtain ⟨hn₀,hnx⟩ := Finset.mem_Ioc.mp (Finset.mem_filter.mp hn).1
  exact mul_le_mul_of_nonneg_right (Real.log_le_log (by exact_mod_cast hn₀)
    ((Nat.cast_le.mpr hnx).trans (Nat.floor_le (by linarith)))) ArithmeticFunction.vonMangoldt_nonneg

theorem ordinary_counts (hRH : RiemannHypothesis) :
    ∃ K : ℝ, 0 < K ∧ ∀ x : ℝ, 1 ≤ x →
      |partialSum primeLog x-x| ≤ K*x^(127/128:ℝ) ∧
      |partialSum primeLogSq x-(x*Real.log x-x)| ≤ K*x^(127/128:ℝ) := by
  obtain ⟨A,hA,hψ⟩ := psi_of_RH hRH
  obtain ⟨B,hB,hS⟩ := weighted_mangoldt_of_RH hRH
  refine ⟨129*A+B+256,by positivity,?_⟩
  intro x hx
  have hx₀ : 0 < x := by linarith
  let U := x^(127/128:ℝ)
  have hU : 0 ≤ U := Real.rpow_nonneg hx₀.le _
  have hlog := Real.log_nonneg hx
  have h₁ : x^(63/64:ℝ)*(1+Real.log x) ≤ 129*U := by
    have h := Real.log_le_rpow_div hx₀.le (show (0:ℝ)<1/128 by norm_num)
    have hl : 1+Real.log x ≤ 129*x^(1/128:ℝ) := by linarith [Real.one_le_rpow hx (show (0:ℝ)≤1/128 by norm_num)]
    have hp : x^(63/64:ℝ)*x^(1/128:ℝ)=U := by rw [←Real.rpow_add hx₀]; norm_num [U]
    nlinarith only [mul_le_mul_of_nonneg_left hl (Real.rpow_nonneg hx₀.le (63/64)),hp]
  let V := x^(1/8:ℝ)
  have hl : Real.log x ≤ 8*V := by dsimp [V]; linarith [Real.log_le_rpow_div hx₀.le (show (0:ℝ)<1/8 by norm_num)]
  have hs₁ : Real.sqrt x*V ≤ U := by
    rw [Real.sqrt_eq_rpow]; dsimp [V,U]; rw [← Real.rpow_add hx₀]
    exact Real.rpow_le_rpow_of_exponent_le hx (by norm_num)
  have hs₂ : Real.sqrt x*(V*V) ≤ U := by
    rw [Real.sqrt_eq_rpow]; dsimp [V,U]; rw [← Real.rpow_add hx₀,← Real.rpow_add hx₀]
    exact Real.rpow_le_rpow_of_exponent_le hx (by norm_num)
  have hdiff := Chebyshev.psi_sub_theta_le hx
  have hθψ : |Chebyshev.theta x-Chebyshev.psi x| ≤ 16*U := by
    rw [abs_of_nonpos (sub_nonpos.mpr (Chebyshev.theta_le_psi x))]
    nlinarith only [hdiff,mul_le_mul_of_nonneg_left hl (Real.sqrt_nonneg x),hs₁]
  have hW : |partialSum primeLogSq x-partialSum weightedMangoldt x| ≤ 128*U := by
    rw [abs_sub_comm]
    apply (power_defect hx).trans
    have h := mul_le_mul_of_nonneg_left hdiff hlog
    have hh := mul_le_mul_of_nonneg_left (mul_self_le_mul_self hlog hl) (Real.sqrt_nonneg x)
    nlinarith only [h,hh,hs₂]
  constructor
  · rw [prime_log_sum]
    apply ((abs_sub_le _ (Chebyshev.psi x) _).trans (add_le_add hθψ (hψ x hx))).trans
    nlinarith only [mul_le_mul_of_nonneg_left h₁ hA.le,mul_nonneg hB.le hU,hU]
  · apply ((abs_sub_le _ (partialSum weightedMangoldt x) _).trans (add_le_add hW (hS x hx))).trans
    nlinarith only [mul_nonneg hA.le hU,hU]

def primeHarm (x : ℝ) := partialSum (fun n => primeLog n/n) x
def primeHarmSq (x : ℝ) := partialSum (fun n => primeLogSq n/n) x

theorem ordinary_harmonic (hRH : RiemannHypothesis) :
    ∃ c₁ c₂ K : ℝ, 0 < K ∧ ∀ x : ℝ, 1 ≤ x →
      |primeHarm x-(Real.log x+c₁)| ≤ K*x^(-(1/128):ℝ) ∧
      |primeHarmSq x-((Real.log x)^2/2+c₂)| ≤ K*x^(-(1/128):ℝ) := by
  obtain ⟨C,hC,hA⟩ := ordinary_counts hRH
  have h₁ := harmonic_transfer (f:=primeLog) (by simp [primeLog]) (a:=0) (b:=1) (K:=C) (δ:=1/128)
    (by norm_num) (fun x hx => by norm_num; exact (hA x hx).1)
  have h₂ := harmonic_transfer (f:=primeLogSq) (by simp [primeLogSq]) (a:=1) (b:= -1) (K:=C) (δ:=1/128)
    (by norm_num) (fun x hx => by
      simpa only [one_mul,mul_add,mul_neg_one,sub_eq_add_neg,show (1+ -(1/128):ℝ)=127/128 by norm_num]
        using (hA x hx).2)
  obtain ⟨c₁,h₁⟩ := h₁
  obtain ⟨c₂,h₂⟩ := h₂
  refine ⟨c₁,c₂,C+C/(1/128),by positivity,?_⟩
  intro x hx
  constructor
  · simpa [primeHarm] using h₁ x hx
  · rw [show (Real.log x)^2/2=(1/2)*(Real.log x)^2 by ring]
    simpa [primeHarmSq] using h₂ x hx

/-- The unmasked, affine ordinary-prime label on a logarithmic interval. -/
def affineSum (a b L lo hi : ℝ) :=
  ∑ p ∈ (Finset.Ioc ⌊lo⌋₊ ⌊hi⌋₊).filter Nat.Prime, Real.log p/((p:ℝ)*L)*(a+b*Real.log p/L)

private theorem sum_range (f : ℕ → ℝ) {lo hi : ℝ} (h : lo ≤ hi) :
    (∑ p ∈ Finset.Ioc ⌊lo⌋₊ ⌊hi⌋₊, f p)=partialSum f hi-partialSum f lo := by
  have hu := Finset.sum_Ioc_consecutive f (Nat.zero_le ⌊lo⌋₊) (Nat.floor_le_floor h)
  unfold partialSum below
  linarith only [hu]

private theorem affine_eq (a b L : ℝ) {lo hi : ℝ} (h : lo ≤ hi) :
    affineSum a b L lo hi = a/L*(primeHarm hi-primeHarm lo)+b/L^2*(primeHarmSq hi-primeHarmSq lo) := by
  unfold affineSum primeHarm primeHarmSq
  rw [← sum_range _ h,← sum_range _ h,Finset.mul_sum,Finset.mul_sum,← Finset.sum_add_distrib,Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro p _
  by_cases hp : p.Prime <;> simp [primeLog,primeLogSq,hp]
  ring

/-- Uniform affine prime-label approximation, including both real end points.
The additive constants in the two harmonic sums cancel. -/
theorem affine_interval (hRH : RiemannHypothesis) :
    ∃ K : ℝ, 0 < K ∧ ∀ (a b L lo hi : ℝ), 0 < L → 1 ≤ lo → lo ≤ hi →
      |affineSum a b L lo hi-
        (a*(Real.log hi/L-Real.log lo/L)+b/2*((Real.log hi/L)^2-(Real.log lo/L)^2))| ≤
          K*(|a|/L+|b|/L^2)*lo^(-(1/128):ℝ) := by
  obtain ⟨c₁,c₂,C,hC,hA⟩ := ordinary_harmonic hRH
  refine ⟨2*C,by positivity,?_⟩
  intro a b L lo hi hL hl h
  have hhi := hl.trans h
  have hp := Real.rpow_le_rpow_of_nonpos (by linarith : 0 < lo) h (by norm_num : (-(1/128):ℝ) ≤ 0)
  let E := C*lo^(-(1/128):ℝ)
  have hpow := mul_le_mul_of_nonneg_left hp hC.le
  have h₁ : |(primeHarm hi-primeHarm lo)-(Real.log hi-Real.log lo)| ≤ 2*E := by
    rw [show (primeHarm hi-primeHarm lo)-(Real.log hi-Real.log lo) =
      (primeHarm hi-(Real.log hi+c₁))-(primeHarm lo-(Real.log lo+c₁)) by ring]
    exact (abs_sub ..).trans (by linarith only [((hA hi hhi).1.trans hpow),(hA lo hl).1])
  have h₂ : |(primeHarmSq hi-primeHarmSq lo)-((Real.log hi)^2/2-(Real.log lo)^2/2)| ≤ 2*E := by
    rw [show (primeHarmSq hi-primeHarmSq lo)-((Real.log hi)^2/2-(Real.log lo)^2/2) =
      (primeHarmSq hi-((Real.log hi)^2/2+c₂))-(primeHarmSq lo-((Real.log lo)^2/2+c₂)) by ring]
    exact (abs_sub ..).trans (by linarith only [((hA hi hhi).2.trans hpow),(hA lo hl).2])
  rw [affine_eq a b L h]
  set e₁ := (primeHarm hi-primeHarm lo)-(Real.log hi-Real.log lo)
  set e₂ := (primeHarmSq hi-primeHarmSq lo)-((Real.log hi)^2/2-(Real.log lo)^2/2)
  rw [show a/L*(primeHarm hi-primeHarm lo)+b/L^2*(primeHarmSq hi-primeHarmSq lo)-
      (a*(Real.log hi/L-Real.log lo/L)+b/2*((Real.log hi/L)^2-(Real.log lo/L)^2)) =
      a/L*e₁+b/L^2*e₂ by dsimp [e₁,e₂]; ring]
  apply (abs_add_le ..).trans
  rw [abs_mul,abs_mul,abs_div,abs_div,abs_of_pos hL,abs_of_pos (sq_pos_of_pos hL)]
  apply (add_le_add (mul_le_mul_of_nonneg_left h₁ (by positivity)) (mul_le_mul_of_nonneg_left h₂ (by positivity))).trans_eq
  dsimp [E]; ring

def maskedSum (m : ℕ) (a b L lo hi : ℝ) :=
  ∑ p ∈ ((Finset.Ioc ⌊lo⌋₊ ⌊hi⌋₊).filter Nat.Prime).filter (fun p => ¬p ∣ m),
    Real.log p/((p:ℝ)*L)*(a+b*Real.log p/L)

private theorem log_factors {m : ℕ} (hm : 0 < m) : ∑ p ∈ m.primeFactors, Real.log p ≤ Real.log m := by
  rw [← Real.log_prod (fun p hp => by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).ne_zero)]
  have hpos : 0 < ∏ p ∈ m.primeFactors, p :=
    Finset.prod_pos fun p hp => (Nat.prime_of_mem_primeFactors hp).pos
  rw [← Nat.cast_prod]
  exact Real.log_le_log (by exact_mod_cast hpos) (by exact_mod_cast Nat.le_of_dvd hm (Nat.prod_primeFactors_dvd m))

theorem excluded_labels {m : ℕ} (hm : 0 < m) (a b : ℝ) {lo hi L : ℝ}
    (hl : 1 ≤ lo) (hhi : 0 ≤ hi) (hL : 0 < L) (hhL : Real.log hi ≤ L) :
    |affineSum a b L lo hi-maskedSum m a b L lo hi| ≤
      (|a|+|b|)*Real.log m/(L*lo) := by
  let q := (Finset.Ioc ⌊lo⌋₊ ⌊hi⌋₊).filter Nat.Prime
  let z := fun p : ℕ => Real.log p/((p:ℝ)*L)*(a+b*Real.log p/L)
  let s := q.filter (· ∣ m)
  have h := Finset.sum_filter_add_sum_filter_not q (· ∣ m) z
  change |(∑ p ∈ q, z p)-∑ p ∈ q.filter (fun p => ¬p ∣ m), z p| ≤ _
  rw [show (∑ p ∈ q, z p)-(∑ p ∈ q.filter (fun p => ¬p ∣ m), z p)=∑ p ∈ s, z p by
    dsimp only [s]; linarith only [h]]
  have hs : s ⊆ m.primeFactors := fun p hp => by
    obtain ⟨hp₁,hp₂⟩ := Finset.mem_filter.mp hp
    exact Nat.mem_primeFactors.mpr ⟨(Finset.mem_filter.mp hp₁).2,hp₂,hm.ne'⟩
  have hsum : (∑ p ∈ s, Real.log p) ≤ Real.log m :=
    (Finset.sum_le_sum_of_subset_of_nonneg hs (fun p _ _ => Real.log_natCast_nonneg p)).trans (log_factors hm)
  let V := (|a|+|b|)/(L*lo)
  have hlo : 0 < lo := by linarith
  have hV : 0 ≤ V := by dsimp [V]; positivity
  apply (Finset.abs_sum_le_sum_abs ..).trans
  calc
    _ ≤ ∑ p ∈ s, Real.log p*V := by
      apply Finset.sum_le_sum
      intro p hp
      obtain ⟨hpq,_⟩ := Finset.mem_filter.mp hp
      obtain ⟨hpI,hpr⟩ := Finset.mem_filter.mp hpq
      obtain ⟨hpl,hph⟩ := Finset.mem_Ioc.mp hpI
      have hpR : 0 < (p:ℝ) := by exact_mod_cast hpr.pos
      have hlp : lo ≤ (p:ℝ) := (Nat.lt_of_floor_lt hpl).le
      have hlog := Real.log_natCast_nonneg p
      have hyp := (Nat.cast_le.mpr hph).trans (Nat.floor_le hhi)
      have hratio : Real.log p/L ≤ 1 := (div_le_one hL).mpr ((Real.log_le_log hpR hyp).trans hhL)
      have hw : |a+b*Real.log p/L| ≤ |a|+|b| := by
        rw [mul_div_assoc]
        apply (abs_add_le ..).trans
        rw [abs_mul,abs_of_nonneg (div_nonneg hlog hL.le)]
        exact add_le_add_right (by simpa only [mul_one] using mul_le_mul_of_nonneg_left hratio (abs_nonneg b)) _
      dsimp [z,V]
      rw [abs_mul,abs_of_nonneg (div_nonneg hlog (mul_pos hpR hL).le)]
      apply (mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_left hlog (mul_pos hlo hL)
        (mul_le_mul_of_nonneg_right hlp hL.le)) (abs_nonneg _)).trans
      apply (mul_le_mul_of_nonneg_left hw (div_nonneg hlog (mul_pos hlo hL).le)).trans_eq
      ring
    _ = (∑ p ∈ s, Real.log p)*V := (Finset.sum_mul ..).symm
    _ ≤ _ := (mul_le_mul_of_nonneg_right hsum hV).trans_eq (by dsimp [V]; ring)

/-- Uniform power saving for the ordinary-prime label after excluding every
prime dividing the cofactor. The elementary integral is exact for affine tapers. -/
theorem masked_affine_power (hRH : RiemannHypothesis) (a b : ℝ) {r γ : ℝ} (hr : 0 ≤ r) (hγ : 0 < γ) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ T : ℝ, 1 ≤ Real.log T → 0 < T → ∀ (m : ℕ), 0 < m → (m:ℝ) ≤ T^r →
      ∀ lo hi : ℝ, γ ≤ lo → lo ≤ hi → hi ≤ 1 →
        |maskedSum m a b (Real.log T) (T^lo) (T^hi) -
          (a*(hi-lo)+b/2*(hi^2-lo^2))| ≤ D*T^(-γ/128) := by
  obtain ⟨K,hK,hS⟩ := affine_interval hRH
  let C := |a|+|b|
  have hC : 0 ≤ C := by dsimp [C]; positivity
  refine ⟨(K+r)*C,by positivity,?_⟩
  intro T hlog hT m hm hmT lo hi hgl hlh hh
  have hT₁ : 1 ≤ T := by by_contra! h; linarith [Real.log_nonpos hT.le h.le]
  have hL : 0 < Real.log T := by linarith
  have hlo := hγ.le.trans hgl
  have h₁ := Real.one_le_rpow hT₁ hlo
  have h₂ := Real.rpow_le_rpow_of_exponent_le hT₁ hlh
  have hhi : Real.log (T^hi) ≤ Real.log T := by
    rw [Real.log_rpow hT]; nlinarith only [mul_le_mul_of_nonneg_right hh hL.le]
  have he := excluded_labels hm a b h₁ (Real.rpow_nonneg hT.le hi) hL hhi
  have hp := hS a b (Real.log T) (T^lo) (T^hi) hL h₁ h₂
  rw [Real.log_rpow hT,Real.log_rpow hT,mul_div_cancel_right₀ _ hL.ne',mul_div_cancel_right₀ _ hL.ne'] at hp
  have hpow : (T^lo)^(-(1/128):ℝ) ≤ T^(-γ/128) := by
    rw [← Real.rpow_mul hT.le]; apply Real.rpow_le_rpow_of_exponent_le hT₁; linarith
  have hcoeff : |a|/Real.log T+|b|/(Real.log T)^2 ≤ C := by
    exact add_le_add (div_le_self (abs_nonneg _) hlog)
      (div_le_self (abs_nonneg _) (one_le_pow₀ hlog))
  have hprefix : K*(|a|/Real.log T+|b|/(Real.log T)^2)*(T^lo)^(-(1/128):ℝ) ≤ K*C*T^(-γ/128) :=
    mul_le_mul (mul_le_mul_of_nonneg_left hcoeff hK.le) hpow (by positivity) (by positivity)
  have hlogm : Real.log m ≤ r*Real.log T := by
    have h := Real.log_le_log (show 0 < (m:ℝ) by exact_mod_cast hm) hmT
    simpa only [Real.log_rpow hT] using h
  have hinv : (T^lo)⁻¹ ≤ T^(-γ/128) := by
    rw [← Real.rpow_neg hT.le]
    exact Real.rpow_le_rpow_of_exponent_le hT₁ (by linarith)
  have hmask : C*Real.log m/(Real.log T*T^lo) ≤ r*C*T^(-γ/128) := by
    calc
      _ ≤ C*(r*Real.log T)/(Real.log T*T^lo) :=
        div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hlogm hC) (by positivity)
      _ = r*C*(T^lo)⁻¹ := by field_simp
      _ ≤ _ := mul_le_mul_of_nonneg_left hinv (mul_nonneg hr hC)
  rw [abs_sub_comm] at he
  exact ((abs_sub_le _ (affineSum a b (Real.log T) (T^lo) (T^hi)) _).trans
    (add_le_add (he.trans hmask) (hp.trans hprefix))).trans_eq (by ring)

private theorem higher_powers (hRH : RiemannHypothesis) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, 1 ≤ x →
      (∑ n ∈ (below x).filter (fun n => ¬ n.Prime), ArithmeticFunction.vonMangoldt n/n) ≤ C := by
  obtain ⟨c,_,K,hK,hH⟩ := ordinary_harmonic hRH
  refine ⟨Real.log 4+4+|c|+K,by positivity [Real.log_nonneg (by norm_num : (1:ℝ)≤4)],?_⟩
  intro x hx
  have h := (hH x hx).1
  have hp : x^(-(1/128):ℝ) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hx (by norm_num)
  have ht := Zeta23.Cheb.mertensFirst hx
  have he : (∑ n ∈ (below x).filter Nat.Prime, ArithmeticFunction.vonMangoldt n/n)=primeHarm x := by
    rw [Finset.sum_filter,primeHarm,partialSum]
    apply Finset.sum_congr rfl
    intro n _
    by_cases hn : n.Prime <;> simp [primeLog,hn,ArithmeticFunction.vonMangoldt_apply_prime]
  have hs := Finset.sum_filter_add_sum_filter_not (below x) Nat.Prime
    (fun n => ArithmeticFunction.vonMangoldt n/(n:ℝ))
  rw [he] at hs
  change |(∑ n ∈ below x, ArithmeticFunction.vonMangoldt n/n)-Real.log x| ≤ _ at ht
  linarith only [(abs_le.mp ht).2,(abs_le.mp h).1,hs,mul_le_mul_of_nonneg_left hp hK.le,neg_abs_le c]

/-- A single constant works for all profiles, scales and upper limits once the
profile and its derivative have the specified bounds on the integration interval. -/
theorem smooth_prime_interval (hRH : RiemannHypothesis) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (F : ℝ → ℝ), ContDiff ℝ 1 F → ∀ (y L B D : ℝ),
      0 ≤ y → 0 < L → 0 ≤ B → 0 ≤ D →
      (∀ v ∈ Set.Icc 0 y, |F v| ≤ B) → (∀ v ∈ Set.Icc 0 y, |deriv F v| ≤ D) →
      |(∑ p ∈ (below (Real.exp (L*y))).filter Nat.Prime, Real.log p/p*F (Real.log p/L)) -
        L*(∫ v in (0:ℝ)..y, F v)| ≤ C*(B+y*D) := by
  obtain ⟨A,hA,hM⟩ := BHB.MT.sum_vonMangoldt_div_C1
  obtain ⟨K,hK,hP⟩ := higher_powers hRH
  refine ⟨A+K,by linarith,?_⟩
  intro F hF y L B D hy hL hB hD hFb hFd
  let V := L*y
  let X := Real.exp V
  let G := fun t : ℝ => F (t/L)
  have hV : 0 ≤ V := mul_nonneg hL.le hy
  have hX : 1 ≤ X := Real.one_le_exp hV
  have hs : V/L=y := mul_div_cancel_left₀ _ hL.ne'
  have hmem {u : ℝ} (hu : u ∈ Set.Icc 0 V) : u/L ∈ Set.Icc 0 y :=
    ⟨div_nonneg hu.1 hL.le,(div_le_iff₀ hL).mpr (by dsimp [V] at hu; linarith only [hu.2])⟩
  have hG : ContDiff ℝ 1 G := hF.comp (contDiff_id.div_const L)
  have he := hM G hG V hV
  have hdG (u : ℝ) : deriv G u=deriv F (u/L)/L := by
    have h := (hF.differentiable (by decide)).differentiableAt (x:=u/L) |>.hasDerivAt
    exact ((h.comp u ((hasDerivAt_id u).div_const L)).congr_deriv (by ring)).deriv
  have hder : (∫ u in (0:ℝ)..V, |deriv G u|) ≤ y*D := by
    have h := intervalIntegral.integral_mono_on (μ:=MeasureTheory.volume) hV
      ((hG.continuous_deriv le_rfl).abs.intervalIntegrable ..) intervalIntegrable_const
      (g:=fun _ => D/L) (fun u hu => by
        rw [hdG,abs_div,abs_of_pos hL]
        exact div_le_div_of_nonneg_right (hFd _ (hmem hu)) hL.le)
    simpa only [intervalIntegral.integral_const,sub_zero,smul_eq_mul,V] using
      (h.trans_eq (by simp only [intervalIntegral.integral_const,sub_zero,smul_eq_mul,V]; field_simp))
  have hint : (∫ u in (0:ℝ)..V, G u)=L*(∫ v in (0:ℝ)..y, F v) := by
    dsimp only [G]; rw [intervalIntegral.integral_comp_div F hL.ne',zero_div,hs,smul_eq_mul]
  have hIG : |G V| ≤ B := by simpa only [G,hs] using hFb y ⟨hy,le_rfl⟩
  have hi : Finset.Icc 1 ⌊X⌋₊=below X := Finset.Icc_succ_left_eq_Ioc ..
  change |(∑ n ∈ Finset.Icc 1 ⌊X⌋₊, ArithmeticFunction.vonMangoldt n/n*G (Real.log n)) -
    (∫ u in (0:ℝ)..V, G u)| ≤ _ at he
  rw [hi,hint] at he
  let f := fun n : ℕ => ArithmeticFunction.vonMangoldt n/n*G (Real.log n)
  have hsum := Finset.sum_filter_add_sum_filter_not (below X) Nat.Prime f
  have hsel : (∑ p ∈ (below X).filter Nat.Prime, f p) =
      ∑ p ∈ (below X).filter Nat.Prime, Real.log p/p*F (Real.log p/L) := by
    apply Finset.sum_congr rfl
    intro p hp
    simp only [f,G,ArithmeticFunction.vonMangoldt_apply_prime (Finset.mem_filter.mp hp).2]
  have htail : |∑ n ∈ (below X).filter (fun n => ¬n.Prime), f n| ≤ K*B := by
    apply (Finset.abs_sum_le_sum_abs ..).trans
    calc
      _ ≤ ∑ n ∈ (below X).filter (fun n => ¬n.Prime), (ArithmeticFunction.vonMangoldt n/n)*B := by
        apply Finset.sum_le_sum
        intro n hn
        obtain ⟨hn₀,hnX⟩ := Finset.mem_Ioc.mp (Finset.mem_filter.mp hn).1
        have hnR : 0 < (n:ℝ) := by exact_mod_cast hn₀
        have hl : Real.log n ≤ V := (Real.log_le_iff_le_exp hnR).mpr
          ((Nat.cast_le.mpr hnX).trans (Nat.floor_le (by linarith : 0 ≤ X)))
        dsimp only [f,G]; rw [abs_mul,abs_of_nonneg (by positivity : 0 ≤ ArithmeticFunction.vonMangoldt n/n)]
        exact mul_le_mul_of_nonneg_left (hFb _ (hmem ⟨Real.log_natCast_nonneg n,hl⟩)) (by positivity)
      _ ≤ _ := by rw [← Finset.sum_mul]; exact mul_le_mul_of_nonneg_right (hP X hX) hB
  rw [← hsel]
  rw [show (∑ p ∈ (below X).filter Nat.Prime, f p) - L*(∫ v in (0:ℝ)..y, F v) =
      ((∑ n ∈ below X, f n)-L*(∫ v in (0:ℝ)..y, F v)) -
      (∑ n ∈ (below X).filter (fun n => ¬n.Prime), f n) by linarith only [hsum]]
  apply ((abs_sub ..).trans (add_le_add he htail)).trans
  nlinarith only [mul_le_mul_of_nonneg_left (add_le_add hIG hder) hA,
    mul_nonneg hK (mul_nonneg hy hD)]

def primesAt (L y : ℝ) := (below (Real.exp (L*y))).filter Nat.Prime
def weight (p : ℕ) := Real.log p/((p:ℝ)-1)

private theorem log_mem {L y : ℝ} (hL : 0 < L) {p : ℕ} (hp : p ∈ primesAt L y) :
    Real.log p/L ∈ Set.Icc 0 y := by
  have hpr := (Finset.mem_filter.mp hp).2
  have hn := (Finset.mem_Ioc.mp (Finset.mem_filter.mp hp).1).2
  refine ⟨div_nonneg (Real.log_natCast_nonneg _) hL.le,(div_le_iff₀ hL).mpr ?_⟩
  rw [mul_comm y L]
  exact (Real.log_le_iff_le_exp (by exact_mod_cast hpr.pos)).mpr
    ((Nat.cast_le.mpr hn).trans (Nat.floor_le (Real.exp_pos _).le))

private theorem nonnegative_weight {p : ℕ} (hp : p.Prime) : 0 ≤ weight p :=
  div_nonneg (Real.log_natCast_nonneg _) (by exact_mod_cast (show (0:ℤ) ≤ (p:ℤ)-1 by have := hp.one_lt; omega))

theorem totient_prime_interval (hRH : RiemannHypothesis) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (F : ℝ → ℝ), ContDiff ℝ 1 F → ∀ (y L B D : ℝ),
      0 ≤ y → 0 < L → 0 ≤ B → 0 ≤ D →
      (∀ v ∈ Set.Icc 0 y, |F v| ≤ B) → (∀ v ∈ Set.Icc 0 y, |deriv F v| ≤ D) →
      |(∑ p ∈ primesAt L y, weight p*F (Real.log p/L))-L*(∫ v in (0:ℝ)..y, F v)| ≤ C*(B+y*D) := by
  obtain ⟨K,hK,hS⟩ := smooth_prime_interval hRH
  refine ⟨K+6,by linarith,?_⟩
  intro F hF y L B D hy hL hB hD hF₀ hF₁
  have h := hS F hF y L B D hy hL hB hD hF₀ hF₁
  let q := primesAt L y
  have hcorr : |(∑ p ∈ q, weight p*F (Real.log p/L))-
      (∑ p ∈ q, Real.log p/p*F (Real.log p/L))| ≤ 6*B := by
    rw [← Finset.sum_sub_distrib]
    apply (Finset.abs_sum_le_sum_abs ..).trans
    calc
      _ ≤ ∑ p ∈ q, (Real.log p/p/p)*(2*B) := by
        apply Finset.sum_le_sum
        intro p hp
        have hpR : (2:ℝ) ≤ p := by exact_mod_cast (Finset.mem_filter.mp hp).2.two_le
        have hp₀ : 0 < (p:ℝ) := by linarith
        have hlog := Real.log_natCast_nonneg p
        have he : weight p-Real.log p/p=Real.log p/((p:ℝ)*(p-1)) := by
          unfold weight; field_simp [hp₀.ne',show (p:ℝ)-1 ≠ 0 by linarith]; ring
        rw [← sub_mul,abs_mul,he,abs_of_nonneg (div_nonneg hlog (by positivity [show (0:ℝ) ≤ p-1 by linarith]))]
        have hb : Real.log p/((p:ℝ)*(p-1)) ≤ 2*(Real.log p/p/p) := by
          field_simp [hp₀,show (0:ℝ)<p-1 by linarith]
          nlinarith only [mul_le_mul_of_nonneg_right hpR hlog]
        exact (mul_le_mul hb (hF₀ _ (log_mem hL hp)) (abs_nonneg _) (by positivity)).trans_eq (by ring)
      _ ≤ _ := by
        rw [← Finset.sum_mul]
        have hs := BHB.MT.sum_primes_log_div_sq_le ⌊Real.exp (L*y)⌋₊
        change (∑ p ∈ q, Real.log p/p/p)*(2*B) ≤ _
        rw [show Finset.Icc 1 ⌊Real.exp (L*y)⌋₊=below (Real.exp (L*y)) from
          Finset.Icc_succ_left_eq_Ioc ..] at hs
        exact (mul_le_mul_of_nonneg_right hs (by positivity : 0 ≤ 2*B)).trans_eq (by ring)
  apply ((abs_sub_le _ (∑ p ∈ q, Real.log p/p*F (Real.log p/L)) _).trans (add_le_add hcorr h)).trans
  nlinarith only [mul_nonneg hy hD]

/-- Ordered prime pairs, with both prime labels retained and the product cutoff
imposed in logarithmic coordinates. -/
def pairs (F : ℝ → ℝ) (L y : ℝ) :=
  ∑ p ∈ primesAt L y, weight p*
    ∑ q ∈ primesAt L (y-Real.log p/L), weight q*F (Real.log p/L+Real.log q/L)

theorem triangle_prime_sum (hRH : RiemannHypothesis) (F : ℝ → ℝ) (hF : ContDiff ℝ 1 F)
    {y : ℝ} (hy : 0 ≤ y) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 1 ≤ L →
      |pairs F L y-L^2*(∫ v in (0:ℝ)..y, v*F v)| ≤ C*L := by
  obtain ⟨K,hK,hI⟩ := totient_prime_interval hRH
  obtain ⟨B,hB⟩ := isCompact_Icc.bddAbove_image (f:=fun v => |F v|) hF.continuous.abs.continuousOn
  obtain ⟨D,hD⟩ := isCompact_Icc.bddAbove_image (f:=fun v => |deriv F v|) (hF.continuous_deriv le_rfl).abs.continuousOn
  have hFb (v : ℝ) (hv : v ∈ Set.Icc 0 y) : |F v| ≤ B := hB (Set.mem_image_of_mem _ hv)
  have hFd (v : ℝ) (hv : v ∈ Set.Icc 0 y) : |deriv F v| ≤ D := hD (Set.mem_image_of_mem _ hv)
  have hB₀ := (abs_nonneg _).trans (hFb 0 ⟨le_rfl,hy⟩)
  have hD₀ := (abs_nonneg _).trans (hFd 0 ⟨le_rfl,hy⟩)
  let G := fun u : ℝ => ∫ v in u..y, F v
  have hd (u : ℝ) : HasDerivAt G (-F u) u :=
    intervalIntegral.integral_hasDerivAt_left (hF.continuous.intervalIntegrable ..)
      hF.continuous.stronglyMeasurable.stronglyMeasurableAtFilter hF.continuous.continuousAt
  have hG : ContDiff ℝ 1 G := contDiff_one_iff_deriv.mpr ⟨fun u => (hd u).differentiableAt,
    hF.continuous.neg.congr fun u => (hd u).deriv.symm⟩
  have hG₀ (u : ℝ) (hu : u ∈ Set.Icc 0 y) : |G u| ≤ y*B := by
    have h := intervalIntegral.norm_integral_le_of_norm_le_const (f:=F) (a:=u) (b:=y)
      (fun t ht => by rw [Set.uIoc_of_le hu.2] at ht; exact hFb t ⟨hu.1.trans ht.1.le,ht.2⟩)
    simpa only [Real.norm_eq_abs,abs_of_nonneg (sub_nonneg.mpr hu.2),G] using h.trans
      (show B*|y-u| ≤ y*B by rw [abs_of_nonneg (sub_nonneg.mpr hu.2)]; nlinarith only [mul_nonneg hB₀ hu.1])
  have hG₁ (u : ℝ) (hu : u ∈ Set.Icc 0 y) : |deriv G u| ≤ B := by rw [(hd u).deriv,abs_neg]; exact hFb u hu
  have hmain : (∫ u in (0:ℝ)..y, G u) = ∫ u in (0:ℝ)..y, u*F u := by
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt (f:=fun u : ℝ => u*G u)
      (f':=fun u : ℝ => G u-u*F u) (a:=0) (b:=y)
      (fun u _ => ((hasDerivAt_id u).mul (hd u)).congr_deriv (by simp; ring))
      ((hG.continuous.sub (continuous_id.mul hF.continuous)).intervalIntegrable ..)
    have hi : IntervalIntegrable (fun u : ℝ => u*F u) MeasureTheory.volume 0 y :=
      (continuous_id.mul hF.continuous).intervalIntegrable ..
    rw [intervalIntegral.integral_sub (hG.continuous.intervalIntegrable ..) hi] at h
    have hg : G y=0 := by simp [G]
    rw [hg,mul_zero,zero_mul,sub_zero] at h
    linarith
  let A := K*(B+y*D)
  have hA : 0 ≤ A := by dsimp [A]; positivity
  refine ⟨A*(y+K)+K*(y*B+y*B),by positivity,?_⟩
  intro L hL
  have hL₀ : 0 < L := by linarith
  have hsum : (∑ p ∈ primesAt L y, weight p) ≤ L*y+K := by
    have h := hI (fun _ => 1) contDiff_const y L 1 0 hy hL₀ zero_le_one le_rfl
      (by simp) (by simp)
    simp only [mul_one,intervalIntegral.integral_const,sub_zero,smul_eq_mul,mul_zero,add_zero] at h
    linarith only [(abs_le.mp h).2]
  have hlocal {u : ℝ} (hu : u ∈ Set.Icc 0 y) :
      |(∑ q ∈ primesAt L (y-u), weight q*F (u+Real.log q/L))-L*G u| ≤ A := by
    let f := fun v => F (u+v)
    have hf : ContDiff ℝ 1 f := hF.comp (contDiff_const.add contDiff_id)
    have hd' (v : ℝ) : deriv f v=deriv F (u+v) := by
      have h := (hF.differentiable (by decide)).differentiableAt (x:=u+v) |>.hasDerivAt
      exact ((h.comp v ((hasDerivAt_id v).const_add u)).congr_deriv (by simp)).deriv
    have hmem (v : ℝ) (hv : v ∈ Set.Icc 0 (y-u)) : u+v ∈ Set.Icc 0 y := ⟨by linarith [hu.1,hv.1],by linarith [hv.2]⟩
    have h := hI f hf (y-u) L B D (sub_nonneg.mpr hu.2) hL₀ hB₀ hD₀
      (fun v hv => hFb _ (hmem v hv)) (fun v hv => (hd' v) ▸ hFd _ (hmem v hv))
    have hi : (∫ v in (0:ℝ)..(y-u), f v)=G u := by
      unfold f G; rw [intervalIntegral.integral_comp_add_left,add_zero,add_sub_cancel]
    rw [hi] at h
    apply h.trans
    dsimp [A]; nlinarith only [mul_nonneg (mul_nonneg hK hD₀) hu.1]
  let W := ∑ p ∈ primesAt L y, weight p*G (Real.log p/L)
  have hin : |pairs F L y-L*W| ≤ A*(L*y+K) := by
    dsimp only [pairs,W]
    rw [Finset.mul_sum,← Finset.sum_sub_distrib]
    apply (Finset.abs_sum_le_sum_abs ..).trans
    calc
      _ ≤ ∑ p ∈ primesAt L y, weight p*A := by
        apply Finset.sum_le_sum
        intro p hp
        rw [show L*(weight p*G (Real.log p/L))=weight p*(L*G (Real.log p/L)) by ring,← mul_sub,abs_mul,
          abs_of_nonneg (nonnegative_weight (Finset.mem_filter.mp hp).2)]
        exact mul_le_mul_of_nonneg_left (hlocal (log_mem hL₀ hp)) (nonnegative_weight (Finset.mem_filter.mp hp).2)
      _ ≤ _ := by rw [← Finset.sum_mul,mul_comm A]; exact mul_le_mul_of_nonneg_right hsum hA
  have hout := hI G hG y L (y*B) B hy hL₀ (mul_nonneg hy hB₀) hB₀ hG₀ hG₁
  rw [hmain] at hout
  have he : |L*W-L^2*(∫ v in (0:ℝ)..y, v*F v)| ≤ L*(K*(y*B+y*B)) := by
    rw [show L*W-L^2*(∫ v in (0:ℝ)..y, v*F v)=L*(W-L*(∫ v in (0:ℝ)..y,v*F v)) by ring,
      abs_mul,abs_of_pos hL₀]
    exact mul_le_mul_of_nonneg_left hout hL₀.le
  apply ((abs_sub_le _ (L*W) _).trans (add_le_add hin he)).trans
  nlinarith only [mul_le_mul_of_nonneg_left hL (mul_nonneg hA hK)]

/-- Half of the ordered sum after removing the repeated prime. -/
def distinctPairs (F : ℝ → ℝ) (L y : ℝ) :=
  (∑ p ∈ primesAt L y, weight p*
    ∑ q ∈ (primesAt L (y-Real.log p/L)).erase p, weight q*F (Real.log p/L+Real.log q/L))/2

private theorem squared_weights : ∃ A : ℝ, 0 ≤ A ∧ ∀ L y : ℝ,
    ∑ p ∈ primesAt L y, (weight p)^2 ≤ A := by
  obtain ⟨A,hA⟩ := BHB.MT.sum_prime_log_sq_corr
  refine ⟨|A|,abs_nonneg _,?_⟩
  intro L y
  have h := hA ⌊Real.exp (L*y)⌋₊
  rw [show Finset.Icc 1 ⌊Real.exp (L*y)⌋₊=below (Real.exp (L*y)) from
    Finset.Icc_succ_left_eq_Ioc ..] at h
  apply le_trans ?_ (h.trans (le_abs_self _))
  apply Finset.sum_le_sum
  intro p hp
  have hp₂ : (2:ℝ) ≤ p := by exact_mod_cast (Finset.mem_filter.mp hp).2.two_le
  have hp₀ : 0 < (p:ℝ) := by linarith
  unfold weight
  field_simp [hp₀,show 0 < (p:ℝ)-1 by linarith]
  nlinarith only [mul_nonneg (sq_nonneg (Real.log p)) (show (0:ℝ) ≤ p-1 by linarith)]

theorem distinct_pair_sum (hRH : RiemannHypothesis) (F : ℝ → ℝ) (hF : ContDiff ℝ 1 F)
    {y : ℝ} (hy : 0 ≤ y) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 1 ≤ L →
      |distinctPairs F L y-(L^2/2)*(∫ v in (0:ℝ)..y, v*F v)| ≤ C*L := by
  classical
  obtain ⟨K,hK,hT⟩ := triangle_prime_sum hRH F hF hy
  obtain ⟨A,hA,hsq⟩ := squared_weights
  obtain ⟨B,hB⟩ := isCompact_Icc.bddAbove_image (f:=fun v => |F v|) hF.continuous.abs.continuousOn
  have hFb (v : ℝ) (hv : v ∈ Set.Icc 0 y) : |F v| ≤ B := hB (Set.mem_image_of_mem _ hv)
  have hB₀ := (abs_nonneg _).trans (hFb 0 ⟨le_rfl,hy⟩)
  refine ⟨(K+A*B)/2,by positivity,?_⟩
  intro L hL
  have hL₀ : 0 < L := by linarith
  have hd : |pairs F L y-2*distinctPairs F L y| ≤ A*B := by
    unfold pairs distinctPairs
    rw [mul_div_cancel₀ _ (by norm_num : (2:ℝ) ≠ 0),← Finset.sum_sub_distrib]
    apply (Finset.abs_sum_le_sum_abs ..).trans
    calc
      _ ≤ ∑ p ∈ primesAt L y, (weight p)^2*B := by
        apply Finset.sum_le_sum
        intro p hp
        let s := primesAt L (y-Real.log p/L)
        let f := fun q : ℕ => weight q*F (Real.log p/L+Real.log q/L)
        change |weight p*(∑ q ∈ s, f q)-weight p*(∑ q ∈ s.erase p, f q)| ≤ _
        by_cases hps : p ∈ s
        · have he := Finset.sum_erase_add s f hps
          rw [← mul_sub,show (∑ q ∈ s, f q)-(∑ q ∈ s.erase p, f q)=f p by linarith only [he]]
          have ho := log_mem hL₀ hp
          have hi := log_mem hL₀ hps
          have harg : Real.log p/L+Real.log p/L ∈ Set.Icc 0 y := ⟨add_nonneg ho.1 ho.1,by linarith [hi.2]⟩
          dsimp only [f]
          rw [← mul_assoc,← sq,abs_mul,abs_of_nonneg (sq_nonneg _)]
          exact mul_le_mul_of_nonneg_left (hFb _ harg) (sq_nonneg _)
        · rw [Finset.erase_eq_of_notMem hps,sub_self,abs_zero]
          positivity
      _ ≤ _ := by rw [← Finset.sum_mul]; exact mul_le_mul_of_nonneg_right (hsq L y) hB₀
  have h := (abs_sub_le (2*distinctPairs F L y) (pairs F L y) _).trans
    (add_le_add (by simpa only [abs_sub_comm (2*distinctPairs F L y)] using hd) (hT L hL))
  rw [show 2*distinctPairs F L y-L^2*(∫ v in (0:ℝ)..y,v*F v)=
    2*(distinctPairs F L y-(L^2/2)*(∫ v in (0:ℝ)..y,v*F v)) by ring,abs_mul,abs_of_pos (by norm_num : (0:ℝ)<2)] at h
  nlinarith only [h,mul_le_mul_of_nonneg_left hL (mul_nonneg hA hB₀)]

private theorem fixed_prime_sum (hRH : RiemannHypothesis) (F : ℝ → ℝ) (hF : ContDiff ℝ 1 F)
    {y : ℝ} (hy : 0 ≤ y) : ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 0 < L →
    |(∑ p ∈ primesAt L y, weight p*F (Real.log p/L))-L*(∫ v in (0:ℝ)..y, F v)| ≤ C := by
  obtain ⟨K,hK,hS⟩ := totient_prime_interval hRH
  obtain ⟨B,hB⟩ := isCompact_Icc.bddAbove_image (f:=fun v => |F v|) hF.continuous.abs.continuousOn
  obtain ⟨D,hD⟩ := isCompact_Icc.bddAbove_image (f:=fun v => |deriv F v|) (hF.continuous_deriv le_rfl).abs.continuousOn
  have h₀ : (0:ℝ) ∈ Set.Icc 0 y := ⟨le_rfl,hy⟩
  have hB₀ := (abs_nonneg _).trans (hB (Set.mem_image_of_mem _ h₀))
  have hD₀ := (abs_nonneg _).trans (hD (Set.mem_image_of_mem _ h₀))
  exact ⟨_,mul_nonneg hK (add_nonneg hB₀ (mul_nonneg hy hD₀)),fun L hL =>
    hS F hF y L B D hy hL hB₀ hD₀ (fun _ hv => hB (Set.mem_image_of_mem _ hv))
      (fun _ hv => hD (Set.mem_image_of_mem _ hv))⟩

/-- The signed one- and two-prime residues. The negative prime sign comes from
the Möbius coefficient. The quantity c retains the lower-order profile moment. -/
def primeResidues (F : ℝ → ℝ) (L y x m c : ℝ) :=
  (∑ p ∈ primesAt L y, weight p*F (Real.log p/L)*
    (m*(L*(1-x)-Real.log p/2-weight p)+c))+m*distinctPairs F L y

/-- The first moment of the mollifier taper cancels between primes and products
of two distinct primes, uniformly in the outer logarithmic label x. -/
theorem prime_residues (hRH : RiemannHypothesis) (F : ℝ → ℝ) (hF : ContDiff ℝ 1 F)
    {y : ℝ} (hy : 0 ≤ y) (m c : ℝ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 1 ≤ L →
    ∀ x ∈ Set.Icc (0:ℝ) 1,
      |primeResidues F L y x m c-m*L^2*(1-x)*(∫ v in (0:ℝ)..y, F v)| ≤ C*L := by
  let G := fun v : ℝ => v*F v
  have hG : ContDiff ℝ 1 G := contDiff_id.mul hF
  let I := ∫ v in (0:ℝ)..y, F v
  let J := ∫ v in (0:ℝ)..y, G v
  obtain ⟨K,hK,hS⟩ := fixed_prime_sum hRH F hF hy
  obtain ⟨D,hD,hU⟩ := fixed_prime_sum hRH G hG hy
  obtain ⟨E,hE,hV⟩ := distinct_pair_sum hRH F hF hy
  obtain ⟨A,hA,hA'⟩ := squared_weights
  obtain ⟨B,hB⟩ := isCompact_Icc.bddAbove_image (f:=fun v => |F v|) hF.continuous.abs.continuousOn
  have hFb (v : ℝ) (hv : v ∈ Set.Icc 0 y) : |F v| ≤ B := hB (Set.mem_image_of_mem _ hv)
  have hB₀ := (abs_nonneg _).trans (hFb 0 ⟨le_rfl,hy⟩)
  refine ⟨|m| * (K+D/2+A*B+E)+|c| * (K+|I|),by positivity,?_⟩
  intro L hL x hx
  have hL₀ : 0 < L := by linarith
  let S := ∑ p ∈ primesAt L y, weight p*F (Real.log p/L)
  let U := ∑ p ∈ primesAt L y, weight p*G (Real.log p/L)
  let W := ∑ p ∈ primesAt L y, weight p^2*F (Real.log p/L)
  have h₁ : |S-L*I| ≤ K := hS L hL₀
  have h₂ : |U-L*J| ≤ D := hU L hL₀
  have h₃ : |distinctPairs F L y-(L^2/2)*J| ≤ E*L := hV L hL
  have h₄ : |W| ≤ A*B := by
    apply (Finset.abs_sum_le_sum_abs ..).trans
    calc
      _ ≤ ∑ p ∈ primesAt L y, weight p^2*B := by
        apply Finset.sum_le_sum
        intro p hp
        rw [abs_mul, abs_of_nonneg (sq_nonneg _)]
        exact mul_le_mul_of_nonneg_left (hFb _ (log_mem hL₀ hp)) (sq_nonneg _)
      _ ≤ _ := by rw [← Finset.sum_mul]; exact mul_le_mul_of_nonneg_right (hA' L y) hB₀
  have hS' : |S| ≤ (K+|I|)*L := by
    calc
      |S| = |(S-L*I)+L*I| := by ring_nf
      _ ≤ |S-L*I|+|L*I| := abs_add_le ..
      _ ≤ _ := by rw [abs_mul,abs_of_pos hL₀]; nlinarith only [h₁,mul_le_mul_of_nonneg_right hL hK]
  have he : primeResidues F L y x m c =
      m*(L*(1-x)*S-L/2*U-W+distinctPairs F L y)+c*S := by
    have hp : (∑ p ∈ primesAt L y, weight p*F (Real.log p/L)*
        (m*(L*(1-x)-Real.log p/2-weight p)+c)) =
        m*(L*(1-x)*S-L/2*U-W)+c*S := by
      dsimp only [S,U,W,G]
      simp only [mul_sub,Finset.mul_sum,← Finset.sum_sub_distrib,← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro p _
      field_simp [hL₀.ne']
    unfold primeResidues
    rw [hp]
    ring
  have hdiff : primeResidues F L y x m c-m*L^2*(1-x)*I =
      m*(L*(1-x)*(S-L*I)+(-(L/2))*(U-L*J)+(-W)+(distinctPairs F L y-(L^2/2)*J))+c*S := by
    rw [he]; ring
  have hfirst : |L*(1-x)*(S-L*I)| ≤ L*K := by
    rw [abs_mul,abs_of_nonneg (mul_nonneg hL₀.le (sub_nonneg.mpr hx.2))]
    exact mul_le_mul (by nlinarith only [mul_nonneg hL₀.le hx.1]) h₁ (abs_nonneg _) hL₀.le
  have hsecond : |(-(L/2))*(U-L*J)| ≤ L/2*D := by
    rw [abs_mul,abs_neg,abs_of_nonneg (by positivity : 0 ≤ L/2)]
    exact mul_le_mul_of_nonneg_left h₂ (by positivity)
  have hwL : A*B ≤ (A*B)*L := by simpa using mul_le_mul_of_nonneg_left hL (mul_nonneg hA hB₀)
  have hinner := ((abs_add_le ..).trans (add_le_add
    ((abs_add_le ..).trans (add_le_add ((abs_add_le ..).trans (add_le_add hfirst hsecond))
      (show abs (-W) ≤ (A*B)*L by rw [abs_neg]; exact h₄.trans hwL))) h₃))
  change |primeResidues F L y x m c-m*L^2*(1-x)*I| ≤ _
  rw [hdiff]
  apply (abs_add_le ..).trans
  rw [abs_mul,abs_mul c S]
  exact (add_le_add (mul_le_mul_of_nonneg_left hinner (abs_nonneg m))
    (mul_le_mul_of_nonneg_left hS' (abs_nonneg c))).trans_eq (by ring)

end PrimeLabelPrefix
end
end Src_PrimeLabelPrefix

section Src_PrincipalBand


noncomputable section
open Real ReflectedPrincipal PrincipalSmoothing PrimeLabelPrefix
open scoped BigOperators ArithmeticFunction ArithmeticFunction.Moebius

namespace PrincipalBand

private def pairTerm (F : ℝ → ℝ) (L : ℝ) (p q : ℕ) :=
  if p.Prime ∧ q.Prime ∧ p ≠ q then
    weight p*weight q*F (Real.log p/L+Real.log q/L) else 0

private def pairRow (F : ℝ → ℝ) (L : ℝ) (k : ℕ) :=
  ∑ p ∈ k.divisors, pairTerm F L p (k/p)

private theorem quotient_cut {L : ℝ} (hL : 0 < L) (y : ℝ) {p : ℕ} (hp : 0 < p) :
    Finset.Icc 1 (⌊exp (L*y)⌋₊/p) = below (exp (L*(y-Real.log p/L))) := by
  have hpr : 0 < (p:ℝ) := by exact_mod_cast hp
  have he : exp (L*(y-Real.log p/L))=exp (L*y)/p := by
    rw [mul_sub,mul_div_cancel₀ _ hL.ne',Real.exp_sub,Real.exp_log hpr]
  ext q
  simp only [below,Finset.mem_Icc,Finset.mem_Ioc,Nat.le_div_iff_mul_le hp,he,
    Nat.le_floor_iff (exp_pos _).le,Nat.le_floor_iff (div_nonneg (exp_pos _).le hpr.le),
    Nat.cast_mul,le_div_iff₀ hpr]
  rfl

private theorem reindex_pairs (F : ℝ → ℝ) {L : ℝ} (hL : 0 < L) (y : ℝ) :
    (∑ k ∈ below (exp (L*y)), pairRow F L k)=2*distinctPairs F L y := by
  classical
  let N := ⌊exp (L*y)⌋₊
  have hcut : Finset.Icc 1 N=below (exp (L*y)) := Finset.Icc_succ_left_eq_Ioc ..
  rw [← hcut]
  unfold pairRow
  rw [BHB.MTP.AQ.sum_Icc_sum_divisors,distinctPairs,mul_div_cancel₀ _ (by norm_num : (2:ℝ) ≠ 0)]
  rw [primesAt,Finset.sum_filter,← hcut]
  apply Finset.sum_congr rfl
  intro p hp
  rw [quotient_cut hL y (Finset.mem_Icc.mp hp).1]
  by_cases hpr : Nat.Prime p
  · rw [if_pos hpr,Finset.mul_sum]
    let s := below (exp (L*(y-Real.log p/L)))
    have he : (primesAt L (y-Real.log p/L)).erase p=s.filter (fun q => q.Prime ∧ p≠q) := by
      ext q; simp [primesAt,s,and_comm,and_assoc,ne_comm]
    rw [he,Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro q _
    by_cases h : q.Prime ∧ p≠q <;> simp [pairTerm,hpr,h,mul_assoc]
  · simp [hpr,pairTerm]

private theorem row_two (F : ℝ → ℝ) (L : ℝ) {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
    pairRow F L (p*q)=2*(weight p*weight q*F (Real.log (p*q:ℕ)/L)) := by
  classical
  have hn := Nat.mul_pos hp.pos hq.pos
  have hsub : ({p,q} : Finset ℕ) ⊆ (p*q).divisors := by
    intro a ha
    simp only [Finset.mem_insert,Finset.mem_singleton] at ha
    rcases ha with rfl|rfl <;> simp [Nat.mem_divisors,hn.ne']
  have hs : ∑ a ∈ ({p,q} : Finset ℕ), pairTerm F L a (p*q/a)=pairRow F L (p*q) := by
    apply Finset.sum_subset hsub
    intro a ha hnot
    by_cases hap : Nat.Prime a
    · have hd := hap.dvd_mul.mp (Nat.dvd_of_mem_divisors ha)
      have he : a=p ∨ a=q := hd.imp (Nat.prime_dvd_prime_iff_eq hap hp).mp (Nat.prime_dvd_prime_iff_eq hap hq).mp
      exact False.elim (hnot (by simpa using he))
    · simp [pairTerm,hap]
  rw [← hs,Finset.sum_insert (by simpa using hpq),Finset.sum_singleton]
  have hpr : (p:ℝ) ≠ 0 := by exact_mod_cast hp.ne_zero
  have hqr : (q:ℝ) ≠ 0 := by exact_mod_cast hq.ne_zero
  rw [Nat.mul_div_cancel_left _ hp.pos,Nat.mul_div_cancel _ hq.pos,pairTerm,pairTerm,
    if_pos ⟨hp,hq,hpq⟩,if_pos ⟨hq,hp,Ne.symm hpq⟩,Nat.cast_mul,Real.log_mul hpr hqr,
    add_div,add_comm (Real.log q/L)]
  ring

private theorem row_other (F : ℝ → ℝ) (L : ℝ) {k : ℕ}
    (hk : ∀ p q : ℕ, p.Prime → q.Prime → p ≠ q → p*q ≠ k) : pairRow F L k=0 := by
  apply Finset.sum_eq_zero
  intro p hp
  unfold pairTerm
  apply if_neg
  rintro ⟨ha,hb,hc⟩
  exact hk p (k/p) ha hb hc (Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors hp))

/-- The contribution at k>1 after division by the common physical scale A=X/P.
The board's principal divisor sum, its totient denominator and the signed
Möbius mollifier all appear at their original integer arguments. -/
def modulusTerm (F H : ℝ → ℝ) (L b c A : ℝ) (k : ℕ) :=
  if k=1 then 0 else
    (μ k:ℝ)*F (Real.log k/L)*smoothMain H k b c ((k:ℝ)*A) / ((k:ℝ)*A*k.totient)

private def single (F : ℝ → ℝ) (L x m c : ℝ) (p : ℕ) :=
  weight p*F (Real.log p/L)*(m*(L*(1-x)-Real.log p/2-weight p)+c)

private theorem modulus_split (F : ℝ → ℝ) {H : ℝ → ℝ} (hH : BHB.Arith.Adm H)
    (L x b c d : ℝ) {A : ℝ} (hA : 0 < A) (ha : Real.log A=L*(1-x)+d)
    (k : ℕ) : modulusTerm F H L b c A k =
      (if k.Prime then single F L x (∫ t in Set.Ioi 0, H t)
        ((∫ t in Set.Ioi 0, H t)*(b+d)+logMoment H 1) k else 0)+
      (∫ t in Set.Ioi 0, H t)*pairRow F L k/2 := by
  classical
  by_cases hex : ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p≠q ∧ p*q=k
  · obtain ⟨p,q,hp,hq,hpq,rfl⟩ := hex
    have hc := hp.coprime_iff_not_dvd.mpr (fun hd => hpq ((Nat.prime_dvd_prime_iff_eq hp hq).mp hd))
    have hnp := Nat.not_prime_mul hp.ne_one hq.ne_one
    have hn : p*q ≠ 1 := by have := hp.one_lt; have := hq.one_lt; nlinarith
    have hpr : 0 < (p:ℝ) := by exact_mod_cast hp.pos
    have hqr : 0 < (q:ℝ) := by exact_mod_cast hq.pos
    have hp₁ : 0 < (p:ℝ)-1 := by exact_mod_cast (show (0:ℤ)<(p:ℤ)-1 by have := hp.one_lt; omega)
    have hq₁ : 0 < (q:ℝ)-1 := by exact_mod_cast (show (0:ℤ)<(q:ℤ)-1 by have := hq.one_lt; omega)
    rw [modulusTerm,if_neg hn,if_neg hnp,zero_add,row_two F L hp hq hpq,
      smooth_two hH hp hq hpq b c (mul_pos (by exact_mod_cast Nat.mul_pos hp.pos hq.pos) hA),ArithmeticFunction.isMultiplicative_moebius.map_mul_of_coprime hc,
      ArithmeticFunction.moebius_apply_prime hp,ArithmeticFunction.moebius_apply_prime hq,
      Nat.totient_mul hc,Nat.totient_prime hp,Nat.totient_prime hq]
    simp only [Int.cast_mul,Int.cast_neg,Int.cast_one,Nat.cast_mul,Nat.cast_sub hp.one_lt.le,Nat.cast_sub hq.one_lt.le,Nat.cast_one,weight]
    field_simp [hpr.ne',hqr.ne',hA.ne',hp₁.ne',hq₁.ne']
  have hr := row_other F L (k:=k) (fun p q hp hq hne h => hex ⟨p,q,hp,hq,hne,h⟩)
  rw [hr,mul_zero,zero_div,add_zero]
  by_cases hp : Nat.Prime k
  · have hpr : 0 < (k:ℝ) := by exact_mod_cast hp.pos
    have hp₁ : 0 < (k:ℝ)-1 := by exact_mod_cast (show (0:ℤ)<(k:ℤ)-1 by have := hp.one_lt; omega)
    rw [if_pos hp,modulusTerm,if_neg hp.ne_one,ArithmeticFunction.moebius_apply_prime hp,
      smooth_prime hH hp b c (mul_pos hpr hA),Nat.totient_prime hp,Real.log_mul hpr.ne' hA.ne',ha]
    simp only [single,weight,Nat.cast_sub hp.one_lt.le,Nat.cast_one,Int.cast_neg,Int.cast_one]
    field_simp [hpr.ne',hA.ne',hp₁.ne']
    ring
  rw [if_neg hp,modulusTerm]
  split
  · rfl
  next hk =>
    by_cases hsq : Squarefree k
    · have hf (p q : ℕ) (hp : p.Prime) (hq : q.Prime) (he : p*q=k) : False := by
        by_cases hn : p=q
        · subst q
          have hc := (Nat.squarefree_mul_iff.mp (he ▸ hsq : Squarefree (p*p))).1
          exact hp.ne_one (by simpa [Nat.Coprime] using hc)
        · exact hex ⟨p,q,hp,hq,hn,he⟩
      rw [smooth_vanish hsq hk hp hf]; ring
    · simp [ArithmeticFunction.moebius_eq_zero_of_not_squarefree hsq]

theorem modulus_sum (F : ℝ → ℝ) {H : ℝ → ℝ} (hH : BHB.Arith.Adm H)
    {L : ℝ} (hL : 0 < L) (y x b c d : ℝ) {A : ℝ} (hA : 0 < A)
    (ha : Real.log A=L*(1-x)+d) :
    (∑ k ∈ below (exp (L*y)), modulusTerm F H L b c A k)=
      primeResidues F L y x (∫ t in Set.Ioi 0, H t)
        ((∫ t in Set.Ioi 0, H t)*(b+d)+logMoment H 1) := by
  simp_rw [modulus_split F hH L x b c d hA ha]
  rw [Finset.sum_add_distrib,← Finset.sum_filter,← Finset.sum_div,← Finset.mul_sum,
    reindex_pairs F hL y]
  unfold primeResidues single primesAt
  ring

theorem modulus_asymptotic (hRH : RiemannHypothesis) (F : ℝ → ℝ) (hF : ContDiff ℝ 1 F)
    {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) {y : ℝ} (hy : 0 ≤ y) (b c d : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 1 ≤ L → ∀ x ∈ Set.Icc (0:ℝ) 1,
      ∀ A : ℝ, 0 < A → Real.log A=L*(1-x)+d →
      |(∑ k ∈ below (exp (L*y)), modulusTerm F H L b c A k)-
        (∫ t in Set.Ioi 0, H t)*L^2*(1-x)*(∫ v in (0:ℝ)..y, F v)| ≤ C*L := by
  obtain ⟨C,hC,h⟩ := prime_residues hRH F hF hy (∫ t in Set.Ioi 0, H t)
    ((∫ t in Set.Ioi 0, H t)*(b+d)+logMoment H 1)
  exact ⟨C,hC,fun L hL x hx A hA ha => (modulus_sum F hH (by linarith) y x b c d hA ha) ▸ h L hL x hx⟩

/-- Main term of the principal divisor coefficient, including the unit modulus. -/
def principalMain (F H : ℝ → ℝ) (L y b c A : ℝ) :=
  ∑ k ∈ below (exp (L*y)), (μ k:ℝ)*F (Real.log k/L)*smoothMain H k b c ((k:ℝ)*A) /
    ((k:ℝ)*A*k.totient)

private theorem include_one (F H : ℝ → ℝ) {L y : ℝ} (hL : 0 < L) (hy : 0 ≤ y)
    (b c A : ℝ) : principalMain F H L y b c A =
      F 0*smoothMain H 1 b c A/A+∑ k ∈ below (exp (L*y)), modulusTerm F H L b c A k := by
  classical
  have ho : 1 ∈ below (exp (L*y)) := by
    simp [below,Nat.le_floor_iff (exp_pos _).le,mul_nonneg hL.le hy]
  have he (k : ℕ) : (μ k:ℝ)*F (Real.log k/L)*smoothMain H k b c ((k:ℝ)*A) /
        ((k:ℝ)*A*k.totient) =
      (if k=1 then F 0*smoothMain H 1 b c A/A else 0)+modulusTerm F H L b c A k := by
    by_cases hk : k=1
    · subst k; simp [modulusTerm]
    · simp [modulusTerm,hk]
  unfold principalMain
  simp_rw [he]
  rw [Finset.sum_add_distrib,Finset.sum_ite_eq',if_pos ho]

/-- At A=T/(2πP), take L=log T, x=log P/L and d=−log(2π).
The bound on the complete sum over moduli is uniform in x. -/
theorem principal_main_asymptotic (hRH : RiemannHypothesis) (F : ℝ → ℝ) (hF : ContDiff ℝ 1 F)
    {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) {y : ℝ} (hy : 0 ≤ y) (b c d : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 1 ≤ L → ∀ x ∈ Set.Icc (0:ℝ) 1,
      ∀ A : ℝ, 0 < A → Real.log A=L*(1-x)+d →
      |principalMain F H L y b c A-(∫ t in Set.Ioi 0, H t)*L^2*
        (F 0*(1-x)^2/2+(1-x)*(∫ v in (0:ℝ)..y, F v))| ≤ C*L := by
  let m := ∫ t in Set.Ioi 0, H t
  let I := ∫ v in (0:ℝ)..y, F v
  let B := F 0*(m*(d+b)+logMoment H 1)
  let D := F 0*(m*RamanujanPrincipal.quadratic b c d+(d+b)*logMoment H 1+logMoment H 2/2)
  obtain ⟨K,hK,h⟩ := modulus_asymptotic hRH F hF hH hy b c d
  refine ⟨K+|B|+|D|,by positivity,?_⟩
  intro L hL x hx A hA ha
  have hL₀ : 0 < L := by linarith
  let E := (∑ k ∈ below (exp (L*y)), modulusTerm F H L b c A k)-m*L^2*(1-x)*I
  have hE : |E| ≤ K*L := h L hL x hx A hA ha
  have he : principalMain F H L y b c A-m*L^2*(F 0*(1-x)^2/2+(1-x)*I) =
      E+L*(1-x)*B+D := by
    rw [include_one F H hL₀ hy b c A,smooth_one hH b c hA,ha]
    dsimp only [E,B,D,m,RamanujanPrincipal.quadratic]
    field_simp [hA.ne']; ring
  change |principalMain F H L y b c A-m*L^2*(F 0*(1-x)^2/2+(1-x)*I)| ≤ _
  rw [he]
  have hu : |L*(1-x)*B| ≤ L*|B| := by
    rw [abs_mul,abs_of_nonneg (mul_nonneg hL₀.le (sub_nonneg.mpr hx.2))]
    exact mul_le_mul_of_nonneg_right (by nlinarith only [mul_nonneg hL₀.le hx.1]) (abs_nonneg B)
  have hd : |D| ≤ |D| * L := by simpa using mul_le_mul_of_nonneg_left hL (abs_nonneg D)
  exact ((abs_add_le ..).trans (add_le_add ((abs_add_le ..).trans (add_le_add hE hu)) hd)).trans_eq (by ring)

def band (L l h : ℝ) := primesAt L h \ primesAt L l

theorem band_prefix (hRH : RiemannHypothesis) (J : ℝ → ℝ) (hJ : ContDiff ℝ 1 J)
    {l h : ℝ} (hl : 0 ≤ l) (hlh : l ≤ h) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ L : ℝ, 0 < L →
      |(∑ p ∈ band L l h, Real.log p/p*J (Real.log p/L))-L*(∫ v in l..h, J v)| ≤ K := by
  obtain ⟨C,hC,hS⟩ := smooth_prime_interval hRH
  obtain ⟨B,hB⟩ := isCompact_Icc.bddAbove_image (f:=fun v => |J v|) hJ.continuous.abs.continuousOn
  obtain ⟨D,hD⟩ := isCompact_Icc.bddAbove_image (f:=fun v => |deriv J v|) (hJ.continuous_deriv le_rfl).abs.continuousOn
  have h₀ : (0:ℝ) ∈ Set.Icc 0 h := ⟨le_rfl,hl.trans hlh⟩
  have hB₀ := (abs_nonneg _).trans (hB (Set.mem_image_of_mem _ h₀))
  have hD₀ := (abs_nonneg _).trans (hD (Set.mem_image_of_mem _ h₀))
  refine ⟨C*(B+h*D)+C*(B+l*D),by positivity [hl.trans hlh],?_⟩
  intro L hL
  have H (y : ℝ) (hy : 0 ≤ y) (hyh : y ≤ h) := hS J hJ y L B D hy hL hB₀ hD₀
    (fun v hv => hB (Set.mem_image_of_mem _ (show v ∈ Set.Icc 0 h from ⟨hv.1,hv.2.trans hyh⟩)))
    (fun v hv => hD (Set.mem_image_of_mem _ (show v ∈ Set.Icc 0 h from ⟨hv.1,hv.2.trans hyh⟩)))
  have hsub : primesAt L l ⊆ primesAt L h := by
    intro p hp
    obtain ⟨hp',hpr⟩ := Finset.mem_filter.mp hp
    exact Finset.mem_filter.mpr ⟨Finset.Ioc_subset_Ioc_right
      (Nat.floor_mono (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hlh hL.le))) hp',hpr⟩
  have hs := Finset.sum_sdiff (f:=fun p : ℕ => Real.log p/p*J (Real.log p/L)) hsub
  have hi : (∫ t in (0:ℝ)..l,J t)+(∫ t in l..h,J t)=∫ t in (0:ℝ)..h,J t :=
    intervalIntegral.integral_add_adjacent_intervals (hJ.continuous.intervalIntegrable ..)
      (hJ.continuous.intervalIntegrable ..)
  unfold band
  rw [eq_sub_of_add_eq hs,eq_sub_of_add_eq' hi]
  have hh' := H h (hl.trans hlh) le_rfl
  have hl' := H l hl hlh
  change |(∑ p ∈ primesAt L h, _)-(∑ p ∈ primesAt L l, _)-
    L*((∫ v in (0:ℝ)..h, J v)-(∫ v in (0:ℝ)..l, J v))| ≤ _
  rw [show (∑ p ∈ primesAt L h, Real.log p/p*J (Real.log p/L))-(∑ p ∈ primesAt L l, Real.log p/p*J (Real.log p/L))-
      L*((∫ v in (0:ℝ)..h,J v)-(∫ v in (0:ℝ)..l,J v)) =
      ((∑ p ∈ primesAt L h, Real.log p/p*J (Real.log p/L))-L*(∫ v in (0:ℝ)..h,J v))-
      ((∑ p ∈ primesAt L l, Real.log p/p*J (Real.log p/L))-L*(∫ v in (0:ℝ)..l,J v)) by ring]
  exact (abs_sub ..).trans (add_le_add hh' hl')

/-- Original quadratic outer taper divided by the outer prime. -/
def outerWeight (h L : ℝ) (p : ℕ) :=
  (Real.log p/L/h)*(1-Real.log p/L/h)/p

def scale (L : ℝ) (p : ℕ) := exp L/(2*Real.pi*p)

def density (F : ℝ → ℝ) (y v : ℝ) :=
  F 0*(1-v)^2/2+(1-v)*(∫ t in (0:ℝ)..y,F t)

theorem outer_principal (hRH : RiemannHypothesis) (F : ℝ → ℝ) (hF : ContDiff ℝ 1 F)
    {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) {y l h : ℝ} (hy : 0 ≤ y)
    (hl : 0 ≤ l) (hlh : l ≤ h) (hh : 0 < h) (hh₁ : h ≤ 1) (b c : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 1 ≤ L →
      |(∑ p ∈ band L l h, outerWeight h L p*principalMain F H L y b c (scale L p))-
        (∫ t in Set.Ioi 0, H t)*L^2*(∫ v in l..h, ((1-v/h)/h)*density F y v)| ≤ C*L := by
  let a := fun v : ℝ => (1-v/h)/h
  let J := fun v => a v*density F y v
  let m := ∫ t in Set.Ioi 0, H t
  have ha : ContDiff ℝ 1 a := (contDiff_const.sub (contDiff_id.div_const h)).div_const h
  have hJ : ContDiff ℝ 1 J := by dsimp [J,density]; fun_prop
  obtain ⟨A,hA,hW⟩ := band_prefix hRH a ha hl hlh
  obtain ⟨K,hK,hS⟩ := band_prefix hRH J hJ hl hlh
  obtain ⟨D,hD,hP⟩ := principal_main_asymptotic hRH F hF hH hy b c (-Real.log (2*Real.pi))
  let U := A+|∫ v in l..h,a v|
  have hU : 0 ≤ U := by dsimp [U]; positivity
  refine ⟨D*U+|m| * K,by positivity,?_⟩
  intro L hL
  have hL₀ : 0 < L := by linarith
  let S := band L l h
  let v := fun p : ℕ => Real.log p/L
  have hmem {p : ℕ} (hp : p ∈ S) : v p ∈ Set.Icc 0 h := by
    obtain ⟨hp',hpr⟩ := Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1
    have he := (Nat.le_floor_iff (exp_pos _).le).mp (Finset.mem_Ioc.mp hp').2
    refine ⟨div_nonneg (Real.log_natCast_nonneg _) hL₀.le,(div_le_iff₀ hL₀).mpr ?_⟩
    rw [mul_comm h]; exact (Real.log_le_iff_le_exp (by exact_mod_cast hpr.pos)).mpr he
  have hw (p : ℕ) : outerWeight h L p=(Real.log p/p)*a (v p)/L := by dsimp [outerWeight,a,v]; ring
  have hw₀ {p : ℕ} (hp : p ∈ S) : 0 ≤ outerWeight h L p := by
    rw [hw]
    have hx := hmem hp
    exact div_nonneg (mul_nonneg (div_nonneg (Real.log_natCast_nonneg _) (Nat.cast_nonneg _))
      (div_nonneg (sub_nonneg.mpr ((div_le_one hh).mpr hx.2)) hh.le)) hL₀.le
  have hmass : (∑ p ∈ S, outerWeight h L p) ≤ U := by
    simp_rw [hw]; rw [← Finset.sum_div,div_le_iff₀ hL₀]
    have hsum := (abs_le.mp (hW L hL₀)).2
    dsimp only [U]
    nlinarith only [hsum,mul_le_mul_of_nonneg_left (le_abs_self (∫ t in l..h,a t)) hL₀.le,
      mul_le_mul_of_nonneg_right hL hA]
  let V := ∑ p ∈ S, outerWeight h L p*(m*L^2*density F y (v p))
  have he : |(∑ p ∈ S, outerWeight h L p*principalMain F H L y b c (scale L p))-V| ≤ D*L*U := by
    dsimp only [V]; rw [← Finset.sum_sub_distrib]
    apply (Finset.abs_sum_le_sum_abs ..).trans
    calc
      _ ≤ ∑ p ∈ S, outerWeight h L p*(D*L) := by
        apply Finset.sum_le_sum
        intro p hp
        rw [← mul_sub,abs_mul,abs_of_nonneg (hw₀ hp)]
        have hpr := (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).2
        have hpR : 0 < (p:ℝ) := by exact_mod_cast hpr.pos
        have hs : 0 < scale L p := by unfold scale; positivity
        have hx := hmem hp
        have ht : Real.log (scale L p)=L*(1-v p)+(-Real.log (2*Real.pi)) := by
          rw [scale,Real.log_div (exp_pos _).ne' (by positivity),Real.log_exp,Real.log_mul (by positivity) hpR.ne']
          dsimp only [v]; field_simp [hL₀.ne']; ring
        exact mul_le_mul_of_nonneg_left (hP L hL _ ⟨hx.1,hx.2.trans hh₁⟩ _ hs ht) (hw₀ hp)
      _ ≤ _ := by rw [← Finset.sum_mul,mul_comm (D*L)]; exact mul_le_mul_of_nonneg_right hmass (mul_nonneg hD hL₀.le)
  have hv : V=m*L*(∑ p ∈ S, Real.log p/p*J (v p)) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro p _
    rw [hw]; dsimp only [J]; field_simp [hL₀.ne']
  have hs : |V-m*L^2*(∫ t in l..h,J t)| ≤ |m| * L*K := by
    rw [hv,show m*L*(∑ p ∈ S, Real.log p/p*J (v p))-m*L^2*(∫ t in l..h,J t)=
      (m*L)*((∑ p ∈ S, Real.log p/p*J (v p))-L*(∫ t in l..h,J t)) by ring,abs_mul,abs_mul m L,abs_of_pos hL₀]
    exact mul_le_mul_of_nonneg_left (hS L hL₀) (mul_nonneg (abs_nonneg _) hL₀.le)
  exact ((abs_sub_le _ V _).trans (add_le_add he hs)).trans_eq (by ring)

def mollifier (F : ℝ → ℝ) (L : ℝ) (k : ℕ) := (μ k:ℝ)*F (Real.log k/L)
def label (h L : ℝ) (p : ℕ) := (Real.log p/L/h)*(1-Real.log p/L/h)
def heightScale (L : ℝ) := exp L/(2*Real.pi)

/-- The principal character at nP in the reflected divisor packet. -/
def principalPacket (F H : ℝ → ℝ) (L y l h : ℝ) :=
  ∑ k ∈ below (exp (L*y)), ∑ p ∈ band L l h, mollifier F L k*label h L p/k*
    (∑' n : ℕ, H (n/(k*heightScale L/p))*BHB.MT.kap2 n*BHB.rmean k (n*p))

private theorem packet_error (F H : ℝ → ℝ) {L y l h : ℝ} (hL : 0 < L) (hyl : y ≤ l) (b c : ℝ) :
    principalPacket F H L y l h-heightScale L*
      (∑ p ∈ band L l h, outerWeight h L p*principalMain F H L y b c (scale L p)) =
    ∑ k ∈ (below (exp (L*y))).filter Squarefree, ∑ p ∈ band L l h,
      mollifier F L k*label h L p/((k:ℝ)*k.totient)*remainder H k b c (k*heightScale L/p) := by
  classical
  let s := below (exp (L*y))
  let q := band L l h
  let X := heightScale L
  have hX : 0 < X := by dsimp [X,heightScale]; positivity
  have hmain : heightScale L*(∑ p ∈ band L l h, outerWeight h L p*principalMain F H L y b c (scale L p)) =
      ∑ k ∈ s, ∑ p ∈ q, mollifier F L k*label h L p/k*
        (smoothMain H k b c (k*X/p)/k.totient) := by
    unfold principalMain
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro k hk
    apply Finset.sum_congr rfl
    intro p hp
    have hk₀ : 0 < (k:ℝ) := by exact_mod_cast (Finset.mem_Ioc.mp hk).1
    have hpr := (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).2
    have hp₀ : 0 < (p:ℝ) := by exact_mod_cast hpr.pos
    have ha : scale L p=X/p := by dsimp [X,scale,heightScale]; ring
    rw [ha,show (k:ℝ)*(X/p)=k*X/p by ring]
    change X*(label h L p/p*(mollifier F L k*smoothMain H k b c (k*X/p)/(k*X/p*k.totient)))=_
    field_simp [hk₀.ne',hp₀.ne',hX.ne',(show (k.totient:ℝ) ≠ 0 by
      exact_mod_cast (Nat.totient_pos.mpr (Finset.mem_Ioc.mp hk).1).ne')]
  rw [hmain,principalPacket,← Finset.sum_sub_distrib,Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro k hk
  rw [← Finset.sum_sub_distrib]
  by_cases hsq : Squarefree k
  · rw [if_pos hsq]
    apply Finset.sum_congr rfl
    intro p hp
    obtain ⟨hp₁,hp₂⟩ := Finset.mem_sdiff.mp hp
    have hpr := (Finset.mem_filter.mp hp₁).2
    have hpc : p.Coprime k := by
      apply hpr.coprime_iff_not_dvd.mpr
      intro hd
      apply hp₂
      exact Finset.mem_filter.mpr ⟨Finset.mem_Ioc.mpr ⟨hpr.pos,
        (Nat.le_of_dvd (Finset.mem_Ioc.mp hk).1 hd).trans ((Finset.mem_Ioc.mp hk).2.trans
          (Nat.floor_mono (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hyl hL.le))))⟩,hpr⟩
    rw [← mul_sub,projected_remainder hsq hpc]
    ring
  · rw [if_neg hsq]
    simp [mollifier,ArithmeticFunction.moebius_eq_zero_of_not_squarefree hsq]

/-- The complete one-sided principal divisor packet at the physical scale X.
Its error is at most C T log T while the displayed main term has scale T(log T)^2. -/
theorem principal_packet_asymptotic (hRH : RiemannHypothesis) (F : ℝ → ℝ) (hF : ContDiff ℝ 1 F)
    {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) {y l h : ℝ} (hy : 0 ≤ y) (hyl : y ≤ l)
    (hlh : l ≤ h) (hh : 0 < h) (hh₁ : h < 1) (hFb : ∀ v ∈ Set.Icc 0 y, |F v| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      |principalPacket F H (Real.log T) y l h-(T/(2*Real.pi))*(∫ t in Set.Ioi 0, H t)*
        (Real.log T)^2*(∫ v in l..h, ((1-v/h)/h)*density F y v)| ≤ C*T*Real.log T := by
  classical
  obtain ⟨b,c,hE⟩ := principal_error_negligible hRH H hH hy ((hyl.trans hlh).trans hh₁.le) hh.le hh₁
  obtain ⟨K,hK,hM⟩ := outer_principal hRH F hF hH hy (hy.trans hyl) hlh hh hh₁.le b c
  refine ⟨1+K,by positivity,?_⟩
  filter_upwards [hE 1 zero_lt_one,Filter.eventually_ge_atTop (exp 1)] with T hE' hT
  have hT₀ : 0 < T := (exp_pos _).trans_le hT
  let L := Real.log T
  let X := heightScale L
  have hL : 1 ≤ L := (Real.le_log_iff_exp_le hT₀).mpr hT
  have hL₀ : 0 < L := by linarith
  have hX : X=T/(2*Real.pi) := by dsimp [X,heightScale,L]; rw [Real.exp_log hT₀]
  have hX₀ : 0 ≤ X := by rw [hX]; positivity
  have hXT : X ≤ T := by rw [hX]; exact div_le_self hT₀.le (by linarith [Real.pi_gt_three])
  have hpow (u : ℝ) : exp (L*u)=T^u := (Real.rpow_def_of_pos hT₀ u).symm
  let s := (below (exp (L*y))).filter Squarefree
  let q := band L l h
  have hinc : s ⊆ Finset.Icc 1 ⌊T^y⌋₊ := by
    intro k hk
    rw [← hpow,show Finset.Icc 1 ⌊exp (L*y)⌋₊=below (exp (L*y)) from Finset.Icc_succ_left_eq_Ioc ..]
    exact (Finset.mem_filter.mp hk).1
  have hpinc : q ⊆ Finset.Icc 1 ⌊T^h⌋₊ := by
    intro p hp
    rw [← hpow,show Finset.Icc 1 ⌊exp (L*h)⌋₊=below (exp (L*h)) from Finset.Icc_succ_left_eq_Ioc ..]
    exact (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).1
  have hv {n : ℕ} {u : ℝ} (hn : n ∈ below (exp (L*u))) : Real.log n/L ∈ Set.Icc 0 u := by
    have hn₀ := (Finset.mem_Ioc.mp hn).1
    have hnu := (Nat.le_floor_iff (exp_pos _).le).mp (Finset.mem_Ioc.mp hn).2
    refine ⟨div_nonneg (Real.log_natCast_nonneg _) hL₀.le,(div_le_iff₀ hL₀).mpr ?_⟩
    rw [mul_comm u]; exact (Real.log_le_iff_le_exp (by exact_mod_cast hn₀)).mpr hnu
  have hw (k : ℕ) (hk : k ∈ s) : |mollifier F L k| ≤ 1 := by
    rw [mollifier,abs_mul]
    exact mul_le_one₀ (by exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n:=k))
      (abs_nonneg _) (hFb _ (hv (Finset.mem_filter.mp hk).1))
  have hz (p : ℕ) (hp : p ∈ q) : |label h L p| ≤ 1 := by
    have hx := hv (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).1
    have hu := div_nonneg hx.1 hh.le
    have hu' := (div_le_one hh).mpr hx.2
    rw [label,abs_of_nonneg (mul_nonneg hu (sub_nonneg.mpr hu'))]
    exact mul_le_one₀ hu' (sub_nonneg.mpr hu') (by linarith)
  let W := ∑ p ∈ q, outerWeight h L p*principalMain F H L y b c (scale L p)
  let V := (∫ t in Set.Ioi 0, H t)*L^2*(∫ v in l..h,((1-v/h)/h)*density F y v)
  have herr : |principalPacket F H L y l h-X*W| ≤ T := by
    rw [show principalPacket F H L y l h-X*W=_ from packet_error F H hL₀ hyl b c]
    simpa only [heightScale,Real.exp_log hT₀,one_mul,L] using hE' s q hinc
      (fun _ hk => (Finset.mem_filter.mp hk).2) hpinc _ _ hw hz
  have hmain : |X*W-X*V| ≤ T*(K*L) := by
    rw [← mul_sub,abs_mul,abs_of_nonneg hX₀]
    exact mul_le_mul hXT (hM L hL) (abs_nonneg _) hT₀.le
  have ha : (T/(2*Real.pi))*(∫ t in Set.Ioi 0, H t)*L^2*
      (∫ v in l..h,((1-v/h)/h)*density F y v)=X*V := by dsimp only [V]; rw [hX]; ring
  change |principalPacket F H L y l h-_| ≤ (1+K)*T*L
  rw [ha]
  apply ((abs_sub_le _ (X*W) _).trans (add_le_add herr hmain)).trans
  nlinarith only [mul_le_mul_of_nonneg_left hL hT₀.le]

def theta : ℝ := 4999999/10000000
def topExponent : ℝ := 999/1000
def taper (z v : ℝ) := 1+(z-1)*(v/theta)-z*(v/theta)^2

def primitive (a b c d v : ℝ) := a*v+(b/2)*v^2+(c/3)*v^3+(d/4)*v^4

lemma integrate_cubic (a b c d l h : ℝ) :
    (∫ t in l..h, a+b*t+c*t^2+d*t^3)=primitive a b c d h-primitive a b c d l := by
  apply intervalIntegral.integral_eq_sub_of_hasDerivAt
  · intro t _
    have hd := (((((hasDerivAt_id t).const_mul a).add (((hasDerivAt_id t).pow 2).const_mul (b/2))).add
      (((hasDerivAt_id t).pow 3).const_mul (c/3))).add (((hasDerivAt_id t).pow 4).const_mul (d/4)))
    apply hd.congr_deriv
    simp; ring
  · exact (by fun_prop : Continuous (fun t : ℝ => a+b*t+c*t^2+d*t^3)).intervalIntegrable ..

private def integralAt (z : ℝ) :=
  ∫ v in (1/2:ℝ)..topExponent, ((1-v/topExponent)/topExponent)*density (taper z) theta v

private theorem evaluate_at (z : ℝ) :
    integralAt z=primitive ((1/2+theta*(1/2+z/6))/topExponent)
      ((-1-theta*(1/2+z/6))/topExponent-(1/2+theta*(1/2+z/6))/topExponent^2)
      (1/(2*topExponent)+(1+theta*(1/2+z/6))/topExponent^2) (-1/(2*topExponent^2)) topExponent-
    primitive ((1/2+theta*(1/2+z/6))/topExponent)
      ((-1-theta*(1/2+z/6))/topExponent-(1/2+theta*(1/2+z/6))/topExponent^2)
      (1/(2*topExponent)+(1+theta*(1/2+z/6))/topExponent^2) (-1/(2*topExponent^2)) (1/2) := by
  have hf (v : ℝ) : taper z v=1+((z-1)/theta)*v+(-z/theta^2)*v^2+0*v^3 := by unfold taper; ring
  have hi : (∫ v in (0:ℝ)..theta, taper z v)=theta*(1/2+z/6) := by
    simp_rw [hf]
    rw [integrate_cubic]
    unfold primitive theta
    ring
  rw [← integrate_cubic]
  unfold integralAt density
  rw [hi]
  apply intervalIntegral.integral_congr
  intro v _
  unfold taper
  simp; ring

lemma taper_bound {z : ℝ} (hz : z ∈ Set.Icc (0:ℝ) 1) : ∀ v ∈ Set.Icc 0 theta, |taper z v| ≤ 1 := by
  intro v hv
  have ht : 0 < theta := by norm_num [theta]
  let u := v/theta
  have hu : 0 ≤ u := div_nonneg hv.1 ht.le
  have hu' : u ≤ 1 := (div_le_one ht).mpr hv.2
  have he : taper z v=(1-u)*(1+z*u) := by dsimp [taper,u]; ring
  rw [he,abs_of_nonneg (mul_nonneg (sub_nonneg.mpr hu') (by positivity [hz.1]))]
  nlinarith only [mul_nonneg (sub_nonneg.mpr hz.2) hu,mul_nonneg hz.1 (sq_nonneg u)]

private theorem for_taper (hRH : RiemannHypothesis) {H : ℝ → ℝ} (hH : BHB.Arith.Adm H)
    {z : ℝ} (hz : z ∈ Set.Icc (0:ℝ) 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      |principalPacket (taper z) H (Real.log T) theta (1/2) topExponent-
        (T/(2*Real.pi))*(∫ t in Set.Ioi 0, H t)*(Real.log T)^2*integralAt z| ≤ C*T*Real.log T := by
  apply principal_packet_asymptotic hRH _ (by unfold taper; fun_prop) hH (by norm_num [theta])
    (by norm_num [theta]) (by norm_num [topExponent]) (by norm_num [topExponent]) (by norm_num [topExponent])
  exact taper_bound hz

theorem divisor_packet_8539 (hRH : RiemannHypothesis) {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      |principalPacket (taper (39/50)) H (Real.log T) theta (1/2) topExponent-
        (T/(2*Real.pi))*(∫ t in Set.Ioi 0, H t)*(Real.log T)^2*
          (125263734612499937/5988006000000000000)| ≤ C*T*Real.log T := by
  have he : integralAt (39/50)=(125263734612499937/5988006000000000000:ℝ) := by
    rw [evaluate_at]; norm_num [primitive,theta,topExponent]
  exact he ▸ for_taper hRH hH (z:=39/50) (by constructor <;> norm_num)

theorem divisor_packet_8535 (hRH : RiemannHypothesis) {H : ℝ → ℝ} (hH : BHB.Arith.Adm H) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ T : ℝ in Filter.atTop,
      |principalPacket (taper (1/2)) H (Real.log T) theta (1/2) topExponent-
        (T/(2*Real.pi))*(∫ t in Set.Ioi 0, H t)*(Real.log T)^2*
          (14333748290279993/718560720000000000)| ≤ C*T*Real.log T := by
  have he : integralAt (1/2)=(14333748290279993/718560720000000000:ℝ) := by
    rw [evaluate_at]; norm_num [primitive,theta,topExponent]
  exact he ▸ for_taper hRH hH (z:=1/2) (by constructor <;> norm_num)

end PrincipalBand
