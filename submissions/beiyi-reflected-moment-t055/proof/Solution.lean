      fun_prop
    exact h1.add (h3.mul h2)
  have hf : Continuous (Function.uncurry (fun (x : ℂ × ℂ × ℂ × ℂ × ℂ) (V : ℝ) =>
      Taper78.BHB.MTP.AAm ly (x.1 + x.2.2.2.2) V * Taper78.BHB.MTP.QQm ly x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2 V)) :=
