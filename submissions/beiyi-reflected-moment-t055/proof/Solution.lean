/- Only an upper estimate for the explicit prime main term is required here. -/
noncomputable section
open Filter ShortProbe ShortProbe.RealResidual
namespace Taper78.BHB
def cP (θ : ℝ) := -(1/6-63*θ/100-3969*θ^2/10000+36271*θ/75000+3007/(10000*θ))
def c2 (θ : ℝ) := 1/3+63*θ/100+3969*θ^2/10000+3007/(30000*θ)
theorem cM_add_cP {θ : ℝ} (hθ : θ ≠ 0) : cM θ+cP θ=c2 θ := by
  unfold cM cP c2
  field_simp
  ring
end Taper78.BHB

namespace ReflectedMoments
theorem score_of_prime_main (hRH : RiemannHypothesis) (w : BHB.Weight) (hw : w.kap1 ≤ 1+1/10^7)
    (hp : ∀ δ > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
       (Taper78.BHB.MainP w.h lengthExponent T).re ≤
       Taper78.BHB.cP lengthExponent*w.kap1*T*Real.log T^3/(2*Real.pi)+δ*T*Real.log T^3) :
    Dyadic (85390845089/100000000000) ∧ Cumulative (85390845089/100000000000) := by
  let θ := lengthExponent
  have hθ : 0 < θ := by norm_num [θ,lengthExponent]
  have hθ' : θ < 1/2 := by norm_num [θ,lengthExponent]
  let ε : ℝ := 1/10^8
  let δ := ε/(8*Real.pi)
  have hδ : 0 < δ := by dsimp [δ,ε]; positivity
  apply score_of_second_78 hRH w hw
  filter_upwards [eventually_ge_atTop (2:ℝ),
    eventually_atTop.mpr (Taper78.BHB.S2_reduction hRH w hθ hθ' δ hδ),
    eventually_atTop.mpr (Taper78.BHB.PrimeLin_sub_MainP w hθ hθ' δ hδ),
    eventually_atTop.mpr (Taper78.BHB.M2inf_asymp hRH w hθ hθ' δ hδ),
    eventually_atTop.mpr (hp δ hδ)] with T hT h₁ h₂ h₃ h₄
  have hL : 0 < Real.log T := Real.log_pos (by linarith)
  have hD : 0 ≤ TMA.Dsc T := div_nonneg (mul_nonneg (by linarith) hL.le) (by positivity)
  have hπ := Real.pi_pos
  have hm : Taper78.BHB.S2 w.h θ T/Real.log T^2 ≤ (Taper78.BHB.c2 θ*w.kap1+ε)*TMA.Dsc T := by
    have a := (abs_le.mp h₁).2
    have hr (z y : ℂ) : z.re-y.re ≤ ‖z-y‖ := by simpa using Complex.re_le_norm (z-y)
    have b := (hr _ _).trans h₂
    have c := (abs_le.mp h₃).2
    change (Taper78.BHB.MainP w.h θ T).re ≤ Taper78.BHB.cP θ*w.kap1*T*Real.log T^3/(2*Real.pi)+δ*T*Real.log T^3 at h₄
    rw [← Taper78.BHB.cM_add_cP hθ.ne']
    apply (div_le_iff₀ (sq_pos_of_pos hL)).mpr
    dsimp [δ] at a b c h₄
    unfold TMA.Dsc
    field_simp at a b c h₄ ⊢
    nlinarith only [a,b,c,h₄]
  refine ⟨_,((Taper78.BHB.Red.summable_S2 hRH w hθ hT).hasSum.div_const (Real.log T^2)).congr_fun ?_,
    hm.trans (mul_le_mul_of_nonneg_right ?_ hD)⟩
  · intro z
    have det : mollified T z = (deriv riemannZeta z*Taper78.BHB.Bmol θ T z)/(Real.log T:ℂ) := by
      rw [← LowBand.molP_taper78]
      unfold LowBand.molP
      change _ * Taper78.BHB.Bmol θ T z = _
      ring
    rw [det,norm_div,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hL,div_pow]
    unfold TMA.cw
    ring
  · norm_num [Taper78.BHB.c2,θ,lengthExponent,ε]
    linarith only [hw]
end ReflectedMoments
#print axioms ReflectedMoments.score_of_prime_main
end
