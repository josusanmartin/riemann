  rw [← div_eq_mul_inv, le_div_iff₀ h1, mul_add, mul_one]
  linarith
lemma gMaj_le (u : ℝ) :
    gMaj u ≤ gammaM * (4 * (1 + (π * sep * (u - 1 / 2)) ^ 2)⁻¹
      + 4 * (1 + (π * sep * (u + 1 / 2)) ^ 2)⁻¹) := by
  unfold gMaj sincN
  rw [show π * (sep * (u - 1 / 2)) = π * sep * (u - 1 / 2) by ring,
    show π * (sep * (u + 1 / 2)) = π * sep * (u + 1 / 2) by ring]
