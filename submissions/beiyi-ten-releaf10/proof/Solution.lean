         (Nat.add (Nat.mul l1 (lo32 (hi32 v))) (Nat.mul lam (lo32 (hi32 vr)))) (Nat.add l1 lam) (Bool.rec (motive := fun _ => ℕ) 0 (Bool.rec (motive := fun _ => ℕ) 0 (Bool.rec (motive := fun _ => ℕ) 0 1 (ivIn2 gr eL eU r)) (ivIn2 g eL eU p)) (Nat.ble lam 1024)) (Nat.add o 24))
