   _ ≤ |h| ^ 5 / 100 + |h| ^ 3 / 6 := by rw [h3]; linarith
   _ ≤ |h| ^ 3 := by nlinarith [pow_nonneg h0 3]
theorem abs_sinc_sub_one_le {h : ℝ} (hh : |h| ≤ 1) : |Real.sinc h - 1| ≤ h ^ 2 := by
