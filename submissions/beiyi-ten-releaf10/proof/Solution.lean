lemma integral_tri_cos_of_ne {a : ℝ} (ha : a ≠ 0) :
    ∫ t in (0 : ℝ)..sep, (sep - t) * cos (a * t) = (1 - cos (a * sep)) / a ^ 2 := by
  have hd : ∀ t ∈ Set.uIcc (0 : ℝ) sep,
