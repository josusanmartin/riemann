/-! ###### kernel-cheap forms of the leaf's interval test and term decoder (am-cert, 2026-10-20)

`ivIn2` / `mokI2` are `ivIn` / `mokI` written as single `Bool.rec` chains: the kernel reduces `a && b` through `and`, its
match and `Bool.casesOn` on every use, so the chain form takes a quarter of the unfoldings; `mokI2_eq` is the bridge.
`dec4Q` is `dec4FH` with the grid point `gptQ` computed without forcing (the kernel's cache shares the repeated
subterms) and the next offset passed unforced.  A decoded field enters the leaf check only through the interval test, so
the elimination lemma `dec4Q_cov` is the same one-liner as `dec4FH_cov`. ###### -/

noncomputable section

namespace AMW.Cert.PCell

open AMW.Cert AMW.Cert.Pyr AMW.Cert.PyrD

/-- `ivIn` as one `Bool.rec` chain -/
def ivIn2 (v L U p : ℕ) : Bool :=
  Bool.rec (motive := fun _ => Bool) false (Bool.rec (motive := fun _ => Bool) false (Bool.rec (motive := fun _ => Bool) false
    (Bool.rec (motive := fun _ => Bool) false (Nat.ble U (ivB v)) (Nat.ble p U)) (Nat.ble L p)) (Nat.ble (ivA v) L)) (Nat.ble 1 (ivB v))

theorem ivIn2_eq (v L U p : ℕ) : ivIn2 v L U p = ivIn v L U p := by
  unfold ivIn2 ivIn
  generalize Nat.ble 1 (ivB v) = a; generalize Nat.ble (ivA v) L = b; generalize Nat.ble L p = c
  generalize Nat.ble p U = d; generalize Nat.ble U (ivB v) = e
  cases a <;> cases b <;> cases c <;> cases d <;> cases e <;> rfl

/-- `mokI` as one `Bool.rec` chain -/
def mokI2 (g : ℕ → ℕ) (L U k m p r : ℕ) : Bool :=
  Bool.rec (motive := fun _ => Bool) false
    (Bool.rec (motive := fun _ => Bool) false
      (Bool.rec (motive := fun _ => Bool) (ivIn2 (g r) L U r) true (Nat.beq (mw2 k m) 0))
      (Bool.rec (motive := fun _ => Bool) (ivIn2 (g p) L U p) true (Nat.beq (mw1 k m) 0)))
    (Nat.ble m 1024)

theorem mokI2_eq (g : ℕ → ℕ) (L U k m p r : ℕ) : mokI2 g L U k m p r = mokI g L U k m p r := by
  unfold mokI2 mokI
  rw [ivIn2_eq, ivIn2_eq]
  generalize Nat.ble m 1024 = a; generalize Nat.beq (mw1 k m) 0 = b; generalize ivIn (g p) L U p = c
  generalize Nat.beq (mw2 k m) 0 = d; generalize ivIn (g r) L U r = e
  cases a <;> cases b <;> cases c <;> cases d <;> cases e <;> rfl

/-- `gptF`'s clamped grid point for a grid shift `gs`, without forcing -/
def gq (L U jj gs : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ)
    (Bool.rec (motive := fun _ => ℕ) (Nat.shiftLeft (Nat.shiftRight (Nat.add L (Nat.shiftRight (Nat.mul (Nat.sub U L) (Nat.land jj 63)) 5)) gs) gs)
      (Nat.shiftLeft (Nat.shiftRight U gs) gs)
      (Nat.ble (Nat.shiftLeft (Nat.shiftRight U gs) gs) (Nat.shiftLeft (Nat.shiftRight (Nat.add L (Nat.shiftRight (Nat.mul (Nat.sub U L) (Nat.land jj 63)) 5)) gs) gs)))
    (Nat.shiftLeft (Nat.shiftRight (Nat.add L (Nat.sub (Nat.shiftLeft 1 gs) 1)) gs) gs)
    (Nat.ble (Nat.shiftLeft (Nat.shiftRight (Nat.add L (Nat.shiftRight (Nat.mul (Nat.sub U L) (Nat.land jj 63)) 5)) gs) gs)
      (Nat.shiftLeft (Nat.shiftRight (Nat.add L (Nat.sub (Nat.shiftLeft 1 gs) 1)) gs) gs))


/-- `gptQ` with the fine grid shift `fs` a parameter (`2^fs`; the `gptH` / `gptF` grid is `fs = 4`) -/
def gptQG (fs L U jj : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ)
    (Bool.rec (motive := fun _ => ℕ) (gq L U jj (Bool.rec (motive := fun _ => ℕ) 8 fs (Nat.beq (Nat.land (Nat.shiftRight jj 6) 1) 1)))
      U (Nat.beq jj 34))
    L (Nat.beq jj 33)

/-- `dec4Q` on `gptQG fs` (the decoder of a tree sized on the fine grid `2^fs`) -/
def dec4QG (fs lb w o L U : ℕ) (k : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ) : ℕ :=
  forceR (Nat.land (Nat.shiftRight w o) 3) fun a =>
  forceR (Bool.rec (motive := fun _ => ℕ)
      (Bool.rec (motive := fun _ => ℕ) 0 (Nat.land (Nat.shiftRight w (Nat.add o 16)) (Nat.sub (Nat.shiftLeft 1 lb) 1)) (Nat.beq a 3))
      (Nat.land (Nat.shiftRight w (Nat.add o 9)) (Nat.sub (Nat.shiftLeft 1 lb) 1)) (Nat.beq a 2)) fun lam =>
  forceR (Bool.rec (motive := fun _ => ℕ) (gptQG fs L U (Nat.land (Nat.shiftRight w (Nat.add o 2)) 127)) 0 (Nat.beq a 0)) fun p =>
  forceR (Bool.rec (motive := fun _ => ℕ) 0 (gptQG fs L U (Nat.land (Nat.shiftRight w (Nat.add o 9)) 127)) (Nat.beq a 3)) fun r =>
  k a (Nat.shiftLeft lam (Nat.sub 10 lb)) p r (Nat.add o (plenF lb a))


