    ∀ ε > (0 : ℝ), ∀ᶠ T in atTop,
      ((672062420409784826575809569323099245044283 / 1000000000000000000000000000000000000000000 - B) / (1 - c) - ε) * (Z.N T (2 * T) : ℝ)
        ≤ (Z.N0s T (2 * T) : ℝ) := by
