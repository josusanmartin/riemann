     ≤ ∫ u in Set.Icc (-(L/2)) (L/2), |h u * p u - h u| :=
       MeasureTheory.abs_integral_le_integral_abs
   _ ≤ ∫ u in Set.Icc (-(L/2)) (L/2), maj u := by
       apply MeasureTheory.setIntegral_mono_on
