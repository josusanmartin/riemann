       k (Nat.add (Nat.mul (Nat.sub 1024 lam) (lbF top bk eL (uc eL eU))) (Nat.mul lam (lo32 v))) (Nat.mul (Nat.mul lam (Nat.sub (hi32 (hi32 v)) 2000000000)) (Nat.sub p e0)) (Nat.mul (Nat.mul lam (Nat.sub 2000000000 (hi32 (hi32 v)))) (Nat.sub p e0)) (Nat.mul lam (lo32 (hi32 v))) lam (Bool.rec (motive := fun _ => ℕ) 0 (Bool.rec (motive := fun _ => ℕ) 0 1 (ivIn2 g eL eU p)) (Nat.ble lam 1024)) (Nat.add o 17))
