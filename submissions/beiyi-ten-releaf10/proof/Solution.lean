   rw [Finset.sum_eq_single (k / 2 - 1)]
   · rw [if_pos (by omega), show k / 2 - 1 + 1 = k / 2 by omega]
   · intro m _ hm; rw [if_neg]; omega
   · intro hm; exfalso; apply hm; rw [Finset.mem_range]; omega
