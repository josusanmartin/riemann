theorem forceR_cov {P : Prop} {a : ℕ} {k : ℕ → ℕ} (hk : ∀ x, k x ≠ 0 → P) (h : forceR a k ≠ 0) : P := by
  rw [forceR_eq] at h; exact hk _ h


