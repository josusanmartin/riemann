theorem integral_gMaj_cos (t : ℝ) (ht : sep ≤ |t|) :
    ∫ u, gMaj u * cos (2 * π * t * u) = 0 := by
  rw [integral_gMaj_mul_cos, FMaj_eq_zero ht]
