       k (Nat.mul 1024 (lo32 v)) (Nat.mul (Nat.mul 1024 (Nat.sub (hi32 (hi32 v)) 2000000000)) (Nat.sub p e0)) (Nat.mul (Nat.mul 1024 (Nat.sub 2000000000 (hi32 (hi32 v)))) (Nat.sub p e0)) (Nat.mul 1024 (lo32 (hi32 v))) 1024 (Bool.rec (motive := fun _ => ℕ) 0 1 (ivIn2 g eL eU p)) (Nat.add o 7))
