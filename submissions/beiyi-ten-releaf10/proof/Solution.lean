def pwD (x w : ℕ) : ℕ :=
  Nat.add (trip w) (Nat.add (Nat.shiftLeft (Nat.sub x (Nat.land (Nat.shiftRight w 96) 1048575)) 96)
    (Nat.shiftLeft (Nat.add x (Nat.shiftRight w 116)) 120))
inductive PTrD where
  | lf (j : ℕ) (L : List (ℕ × ℕ))
  | nd (k : ℕ) (l r : PTrD)
end AMW.Cert.PCell
end
