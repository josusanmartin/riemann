 ring
theorem abs_sc1_num_le {h : ℝ} (hh : |h| ≤ 1) : |h * Real.cos h - Real.sin h + h ^ 3 / 3| ≤ |h| ^ 4 / 8 := by
 have hc := Real.cos_bound hh
 have hs := Real.sin_bound hh
 have h0 := abs_nonneg h
