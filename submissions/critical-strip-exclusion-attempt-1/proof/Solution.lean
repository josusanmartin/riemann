theorem prod_lo_nat (a b : ℕ) {A B : ℝ} (hA : (a : ℝ) / DZ ≤ A) (hB : (b : ℝ) / DZ ≤ B) :
   ((Nat.div (Nat.mul a b) DZ : ℕ) : ℝ) / DZ ≤ A * B := by
