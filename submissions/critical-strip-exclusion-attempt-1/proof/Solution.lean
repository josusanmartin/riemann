lemma abs_Kfun_le_Kfun_zero (x : ℝ) : |Kfun x| ≤ Kfun 0 := AMW.abs_KfunAM_le x
lemma abs_kfun_le_one (x : ℝ) : |kfun x| ≤ 1 := by
 unfold kfun
 rw [abs_div]
