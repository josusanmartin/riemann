 · have h1 := ndiv_le (Nat.mul GAM0 c.BLZ) DZ (by norm_num [DZ])
   have e : ((Nat.mul GAM0 c.BLZ : ℕ) : ℝ) = (GAM0 : ℝ) * c.BLZ := by rw [Nat.mul_eq]; push_cast; ring
   rw [e] at h1
