 have h1 := ndiv_le (Nat.mul a b) DZ (by norm_num [DZ])
 have e : ((Nat.mul a b : ℕ) : ℝ) = (a : ℝ) * b := by rw [Nat.mul_eq]; push_cast; ring
 rw [e] at h1
 have ha : (0 : ℝ) ≤ (a : ℝ) / DZ := div_nonneg (Nat.cast_nonneg _) hD.le
