theorem integral_cos_sqrt2 :
   ∫ t in (-(1:ℝ)/2)..(1/2), Real.cos (Real.sqrt 2 * t) = Real.sqrt 2 * Real.sin (Real.sqrt 2 / 2) := by
 have hs : (0:ℝ) < Real.sqrt 2 := by positivity
