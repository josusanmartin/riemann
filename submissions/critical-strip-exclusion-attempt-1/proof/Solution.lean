theorem deleted_strips (Z : ZeroConfig) (H : PaperInputs Z) :
   ∀ ε > 0, ∀ᶠ T in atTop,
     (Z.N0s T (2 * T) : ℝ) - ε * (Z.N T (2 * T) : ℝ)
       ≤ ((retained Z (mtParams T) T).card : ℝ) := by
