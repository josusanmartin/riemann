  have hzhi : z ≤ (187 / 70 : ℝ) := by
    dsimp [z]; linarith [AMMajorant.pi_coarse.2]
  have hylo : (471 / 1000 : ℝ) ≤ y := by
    dsimp [y]; linarith [AMMajorant.pi_coarse.1]
  have hyhi : y ≤ (33 / 70 : ℝ) := by
    dsimp [y]; linarith [AMMajorant.pi_coarse.2]
