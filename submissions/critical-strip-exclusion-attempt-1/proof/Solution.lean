 · have hmem : u ∈ Ioo (-(L / 2 + L / 10)) (L / 2 + L / 10) := by
     rw [mem_Ioo]; constructor <;> linarith [neg_abs_le u, le_abs_self u]
   have hf : ContDiffAt ℝ 2 (fW L) u := (fW_contDiffOn hL).contDiffAt (isOpen_Ioo.mem_nhds hmem)
