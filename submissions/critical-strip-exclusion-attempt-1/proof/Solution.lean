  classical
  have hkij : (1 / 64 : ℝ) ≤ wfun (x i - x j) :=
    AMClosePair.kernel_square_ge hnear
  have hkji : (1 / 64 : ℝ) ≤ wfun (x j - x i) :=
    AMClosePair.kernel_square_ge (by simpa only [abs_sub_comm] using hnear)
