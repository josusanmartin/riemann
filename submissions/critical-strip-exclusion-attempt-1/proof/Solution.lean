 have hD := DZ_pos
 have hg := GAM_bounds
 have hB0 : (0 : ℝ) ≤ (c.BLZ : ℝ) / DZ := div_nonneg (Nat.cast_nonneg _) hD.le
 have hG0 : (0 : ℝ) ≤ (GAM0 : ℝ) / DZ := div_nonneg (Nat.cast_nonneg _) hD.le
