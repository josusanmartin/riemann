   unfold Tj; push_cast; ring_nf
 rw [e]
 by_cases hm : 2 * (m + 1) = k
 · rw [T0_near (per_j_pos hx hsep m), fv, if_pos hm, if_pos hm]; push_cast; ring
 · rw [T0_far (per_j_sep hx hsep m hm) (per_j_pos hx hsep m), fv, if_neg hm, if_neg hm]; push_cast; ring
