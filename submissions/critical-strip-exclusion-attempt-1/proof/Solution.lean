theorem two_pi_k_pos (n : ℕ) : 0 < 2 * π * ((n : ℝ) + 1) := by positivity
theorem integral_cos_k (n : ℕ) :
   ∫ t in (-(1:ℝ)/2)..(1/2), Real.cos (2 * π * ((n : ℝ) + 1) * t) = 0 := by
 rw [integral_cos_half (two_pi_k_pos n).ne']
 have : 2 * π * ((n : ℝ) + 1) / 2 = ((n + 1 : ℕ) : ℝ) * π := by push_cast; ring
