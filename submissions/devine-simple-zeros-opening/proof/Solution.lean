section Src_XuIntegratedFullScale
/-!
# Integrated RH-only distinct-zero theorem, full-scale retained-multiplicity route

Final module of the single-file assembly. The theorem itself,
`DevineXuJoint.distinct_856399404234_of_RH`, is stated and proved in `T2Simple8.FullScaleDistinct`:
under RH, at least
`17127988084695677740374459624784369347858974492211694521760654840900887 / (2 * 10^70)`
(`85.6399404234783887...%`) of the zeros of the Riemann zeta function, counted with multiplicity, are
distinct, in `(T, 2T]` and in `(0, T]`, as `T → ∞`.
-/
end Src_XuIntegratedFullScale


open scoped BigOperators
open Zeta23

private theorem opening_count_simple (hRH : RiemannHypothesis) (a b : ℝ) :
    2 * (Zeta23.N0star a b : ℝ) ≤ (Zeta23.Ncount a b : ℝ) + (Zeta23.Nsimple a b : ℝ) := by
  classical
  let F := (Zeta23.zerosIn_finite a b).toFinset
  have hd : Zeta23.Ndist a b = F.card := by
    unfold Zeta23.Ndist
    have hf : (F : Set ℂ) = Zeta23.zerosIn a b := Set.Finite.coe_toFinset _
    rw [← hf, Set.ncard_coe_finset]
  have hs : Zeta23.Nsimple a b = (F.filter (fun z => Zeta23.zeroMult z = 1)).card := by
    unfold Zeta23.Nsimple
    rw [← Set.ncard_coe_finset]
    congr 1
    ext z
    simp [F]
  have hn : (Zeta23.Ncount a b : ℝ) = ∑ z ∈ F, (Zeta23.zeroMult z : ℝ) := by
    unfold Zeta23.Ncount
    rw [finsum_mem_eq_finite_toFinset_sum _ (Zeta23.zerosIn_finite a b), Nat.cast_sum]
  have hsum : (∑ _z ∈ F, (2 : ℝ)) ≤
      ∑ z ∈ F, ((Zeta23.zeroMult z : ℝ) + if Zeta23.zeroMult z = 1 then 1 else 0) := by
    apply Finset.sum_le_sum
    intro z hz
    have hm : 1 ≤ Zeta23.zeroMult z :=
      Zeta23.zetaSeam.one_le_mult z ((Set.Finite.mem_toFinset (Zeta23.zerosIn_finite a b)).mp hz).1
    by_cases h : Zeta23.zeroMult z = 1
    · norm_num [h]
    · have hm' : (2 : ℝ) ≤ Zeta23.zeroMult z := by exact_mod_cast (show 2 ≤ Zeta23.zeroMult z by omega)
      simpa [h] using hm'
  rw [(Zeta23.RH_implies_all_on_line hRH a b).2, hd, hn, hs]
  simpa [Finset.sum_add_distrib, Finset.sum_boole, mul_comm] using hsum

theorem candidate_strict_improvement : currentRecordKappa < candidateKappa := by
  norm_num [currentRecordKappa, candidateKappa]

theorem candidate_critical_line_bound :
    ∀ ε > (0 : ℝ), ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (candidateKappa - ε) * (Zeta23.Ncount T (2 * T) : ℝ)
        ≤ Zeta23.Nsimple T (2 * T) := by
  intro ε hε
  obtain ⟨T₀, h⟩ := (DevineXuJoint.distinct_856399404234_of_RH _root_.riemannHypothesis).1 (ε / 2) (by positivity)
  refine ⟨T₀, fun T hT => ?_⟩
  have hD := h T hT
  have hS := opening_count_simple _root_.riemannHypothesis T (2 * T)
  have hN := Nat.cast_nonneg (α := ℝ) (Zeta23.Ncount T (2 * T))
  unfold candidateKappa
  linarith

theorem candidate_critical_line_bound_cumulative :
    ∀ ε > (0 : ℝ), ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (candidateKappa - ε) * (Zeta23.Ncount 0 T : ℝ)
        ≤ Zeta23.Nsimple 0 T := by
  intro ε hε
  obtain ⟨T₀, h⟩ := (DevineXuJoint.distinct_856399404234_of_RH _root_.riemannHypothesis).2 (ε / 2) (by positivity)
  refine ⟨T₀, fun T hT => ?_⟩
  have hD := h T hT
  have hS := opening_count_simple _root_.riemannHypothesis 0 T
  have hN := Nat.cast_nonneg (α := ℝ) (Zeta23.Ncount 0 T)
  unfold candidateKappa
  linarith

