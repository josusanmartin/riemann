/-!
# The RH-only distinct-zero bound 85.5579914687% in both windows (C1, TASK-0074)

The joint certificate of `XuJointCert` (generated from `cert-xu-nosx-sX0`) gives the simple-zero input weight
zero: `sX = 0`. The weighted-simple input of `final_855579914687_of_sX` is then the trivial bound
`0 ≤ ∑ c(z) 1_{m_z = 1}`, proved here from the summability and nonnegativity of the zero weight.
-/

noncomputable section

open Filter

namespace DevineXuJoint

/-- The weighted-simple input at `sX = 0`: the weighted count of simple zeros is nonnegative. -/
theorem hsX_trivial (hRH : RiemannHypothesis) :
    ∀ (w : BHB.Weight) (η : ℝ), 0 < η → ∀ᶠ T : ℝ in atTop, ∃ v : ℝ,
      HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z *
        sgl (Zeta23.zeroMult z)) v ∧ ((sX : ℝ) - η) * (w.kap1 * TMA.Dsc T) ≤ v := by
  intro w η hη
  filter_upwards [hDsc_lib, Filter.eventually_gt_atTop (0 : ℝ)] with T hD hT
  have hk1 : 1 ≤ w.kap1 := BHB.Final.one_le_kap1 w.toHeightWeight
  have hcw : ∀ z : Zeta23.zetaZeroConfig.carrier, 0 ≤ TMA.cw w.h T z :=
    fun z => TMA.cw_nonneg w.toHeightWeight T z
  have hs01 : ∀ n : ℕ, 0 ≤ sgl n ∧ sgl n ≤ 1 := fun n => by
    rcases sgl_cases n with ⟨_, h⟩ | ⟨_, h⟩ <;> rw [h] <;> norm_num
  have hsumm : Summable (fun z : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T z * sgl (Zeta23.zeroMult z)) := by
    refine Summable.of_nonneg_of_le (fun z => mul_nonneg (hcw z) (hs01 _).1) (fun z => ?_)
      (TMA.summable_cw hRH w.toHeightWeight hT)
    calc TMA.cw w.h T z * sgl (Zeta23.zeroMult z) ≤ TMA.cw w.h T z * 1 :=
          mul_le_mul_of_nonneg_left (hs01 _).2 (hcw z)
      _ = TMA.cw w.h T z := mul_one _
  refine ⟨_, hsumm.hasSum, ?_⟩
  have hv : 0 ≤ ∑' z : Zeta23.zetaZeroConfig.carrier, TMA.cw w.h T z * sgl (Zeta23.zeroMult z) :=
    tsum_nonneg fun z => mul_nonneg (hcw z) (hs01 _).1
  have hsX0 : (sX : ℝ) = 0 := by norm_num [sX]
  have hprod : 0 ≤ w.kap1 * TMA.Dsc T := mul_nonneg (by linarith) hD.le
  have hneg : ((sX : ℝ) - η) * (w.kap1 * TMA.Dsc T) ≤ 0 := by
    rw [hsX0]
    nlinarith
  linarith

/-- **85.5579914687% of the zeros are distinct and on the critical line, in both windows, under RH.** -/
theorem distinct_855579914687_of_RH (hRH : RiemannHypothesis) :
    (∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (855579914687 / 1000000000000 - ε) * (Zeta23.Ncount T (2 * T) : ℝ) ≤
        (Zeta23.N0star T (2 * T) : ℝ)) ∧
    (∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (855579914687 / 1000000000000 - ε) * (Zeta23.Ncount 0 T : ℝ) ≤
        (Zeta23.N0star 0 T : ℝ)) :=
  final_855579914687_of_sX hRH (hsX_trivial hRH)


