/-
Decoder for `#unpack_source` (pack/unpack/encode.py inserts this text after the imports of Solution.lean).

`#unpack_source n h "…" "…" …` decodes the string literals to `n` bytes of UTF-8 Lean source text with FNV-1a
checksum `h`, then elaborates that text command by command in the current environment, exactly as the frontend
does for the commands of a file: each command is parsed with the parser state of the current environment, scopes,
options and open declarations, elaborated with `elabCommandTopLevel`, and its messages and asynchronous tasks
(theorem proofs, linters) are passed on to the frontend, so any error in the text is an error of this file.
The decoder only produces source text; everything it produces is elaborated and kernel-checked like any other
command, so it cannot affect what the kernel sees.

Format (see pack/unpack/README.md): LZ77 with an adaptive binary range coder whose output digits are the 93
printable ASCII characters other than `"` and `\`.  Tokens: a literal byte (8 bits, binary tree with the previous
byte as context) or a match (length, and a distance unless it repeats the last distance), lengths and distances
in an adaptive Elias-gamma code.
-/
section
open Lean Elab Command

namespace PackedSource

/-- `93 ^ 4`: the range is renormalised (times 93, one digit read) whenever it drops below this. -/
def lo : Nat := 74805201
/-- `93 ^ 5`: the initial range. -/
def hi : Nat := 6956883693
/-- Bit lengths of encoded numbers are at most `nmax` (so numbers are below `2 ^ nmax`). -/
def nmax : Nat := 26

/-! Layout of the array of adaptive probabilities (11-bit probabilities of a 0 bit, initially 1/2). -/
def oMatch : Nat := 0                          -- 4 states × 256 previous bytes: match or literal
def oRep : Nat := oMatch + 4 * 256             -- 4 states: repeat the last distance?
def oLit : Nat := oRep + 4                     -- 256 previous bytes × 256 tree nodes: literal byte
def oLenU : Nat := oLit + 256 * 256            -- 2 contexts × nmax: bit length of a length (unary)
def oLenT : Nat := oLenU + 2 * nmax            -- 2 × nmax × 256: top 8 bits of a length below its leading 1
def oDistU : Nat := oLenT + 2 * nmax * 256     -- 4 contexts × nmax: bit length of a distance
def oDistT : Nat := oDistU + 4 * nmax          -- 4 × nmax × 16: top 4 bits of a distance below its leading 1
def nProbs : Nat := oDistT + 4 * nmax * 16

/-- Value of a digit character: `' '` .. `'~'` without `'"'` and `'\\'`, in ASCII order, are 0 .. 92. -/
@[inline] def digitVal (c : UInt8) : Nat :=
  let v := c.toNat - 32
  if c.toNat > 92 then v - 2 else if c.toNat > 34 then v - 1 else v

/-- State of the range decoder: input, read position, range, code (`code < rng`), probabilities. -/
structure Dec where
  src : ByteArray
  pos : Nat
  rng : Nat
  code : Nat
  pr : Array Nat

/-- Renormalise: one step suffices, since a decoded bit leaves `rng ≥ lo * 31 / 2048 > lo / 93`.
Digits after the end of the input read as 0. -/
@[inline] def Dec.norm (d : Dec) : Dec :=
  if d.rng < lo then
    let c := if d.pos < d.src.size then digitVal (d.src.get! d.pos) else 0
    { d with rng := d.rng * 93, code := d.code * 93 + c, pos := d.pos + 1 }
  else d

/-- One bit with the adaptive probability `pr[k]` (of a 0), which is then moved by 1/32 towards the bit. -/
@[inline] def Dec.bit (d : Dec) (k : Nat) : Bool × Dec :=
  let p := d.pr[k]!
  let bound := d.rng / 2048 * p
  if d.code < bound then
    (false, Dec.norm { d with rng := bound, pr := d.pr.set! k (p + (2048 - p) / 32) })
  else
    (true, Dec.norm { d with code := d.code - bound, rng := d.rng - bound, pr := d.pr.set! k (p - p / 32) })

/-- One bit with probability 1/2. -/
@[inline] def Dec.direct (d : Dec) : Bool × Dec :=
  let r := d.rng / 2
  if d.code < r then (false, Dec.norm { d with rng := r })
  else (true, Dec.norm { d with rng := r, code := d.code - r })

/-- A number `v ≥ 1`: its bit length `n` in unary (`n - 1` ones at models `u + i`, then a zero unless
`n = nmax`), then the `n - 1` bits of `v` below the leading 1 from the top, the first `tb` of them with the
binary tree of models at `t + (n - 1) * 2 ^ tb`, the others with probability 1/2. -/
def Dec.num (d : Dec) (u t tb : Nat) : Nat × Dec := Id.run do
  let mut d := d
  let mut n := 1
  for _ in [0:nmax - 1] do
    let (b, d') := d.bit (u + n - 1)
    d := d'
    if b then n := n + 1 else break
  let mut v := 1
  let mut m := 1
  for j in [0:n - 1] do
    if j < tb then
      let (b, d') := d.bit (t + (n - 1) * 2 ^ tb + m)
      d := d'
      m := 2 * m + b.toNat
      v := 2 * v + b.toNat
    else
      let (b, d') := d.direct
      d := d'
      v := 2 * v + b.toNat
  return (v, d)

/-- Decode `n` bytes from the digit characters `src`. -/
def decode (src : ByteArray) (n : Nat) : Except String ByteArray := Id.run do
  let mut code := 0
  for i in [0:6] do
    code := code * 93 + (if i < src.size then digitVal (src.get! i) else 0)
  let mut d : Dec := { src, pos := 6, rng := hi, code, pr := Array.replicate nProbs 1024 }
  let mut out := ByteArray.emptyWithCapacity n
  let mut st := 0      -- 0: after a literal, 1: after a match, 2: after a repeat match, 3: literal after a match
  let mut rep := 1     -- the last distance
  for _ in [0:n] do
    if out.size ≥ n then break
    let prev := if out.size = 0 then 0 else (out.get! (out.size - 1)).toNat
    let (isMatch, d') := d.bit (oMatch + st * 256 + prev)
    d := d'
    if !isMatch then
      let mut m := 1
      for _ in [0:8] do
        let (b, d') := d.bit (oLit + prev * 256 + m)
        d := d'
        m := 2 * m + b.toNat
      out := out.push (m - 256).toUInt8
      st := if st == 1 || st == 2 then 3 else 0
    else
      let (isRep, d') := d.bit (oRep + st)
      d := d'
      let c := isRep.toNat
      let (l, d') := d.num (oLenU + c * nmax) (oLenT + c * nmax * 256) 8
      d := d'
      let len := l + 1
      if !isRep then
        let lc := min (len - 2) 3
        let (r, d') := d.num (oDistU + lc * nmax) (oDistT + lc * nmax * 16) 4
        d := d'
        rep := r
      if rep > out.size || out.size + len > n then
        return .error s!"corrupt data at output byte {out.size}"
      let start := out.size - rep
      for i in [0:len] do
        out := out.push (out.get! (start + i))
      st := if isRep then 2 else 1
  if out.size != n then return .error s!"decoded {out.size} bytes, expected {n}"
  return .ok out

/-- FNV-1a (32 bits) of a byte array. -/
def checksum (b : ByteArray) : Nat := Id.run do
  let mut h : UInt32 := 2166136261
  for x in b do
    h := (h ^^^ x.toUInt32) * 16777619
  return h.toNat

/-- Elaborate `text` command by command in the current environment, as `Lean.Language.Lean.process` does for
the commands of a file: parse each command with the current environment, scopes, options and open declarations;
reset the per-command state (messages, snapshot tasks, info trees); run `elabCommandTopLevel` (which also runs the
linters) in a fresh command context.  The messages of each command (parse errors first), followed by its
asynchronous tasks (proofs, kernel checks, linters), are handed to the frontend as snapshot tasks of
`#unpack_source`, in the order of the commands; the frontend reports them and fails on any error, as for a plain
file.  Positions in messages refer to the decoded text.  With `infoTrees := false` no info trees are recorded
(they serve the language server, `.ilean` files and info-tree-based linters such as `unusedVariables`). -/
def runCommands (text : String) (fileName : String) (infoTrees : Bool) : CommandElabM Unit := do
  let ictx := Parser.mkInputContext text fileName
  let cancelTk? := (← read).cancelTk?
  let outerMsgs := (← get).messages
  let outerInfo := (← get).infoState.enabled
  modify fun s => { s with infoState.enabled := outerInfo && infoTrees }
  let mut tasks := (← get).snapshotTasks
  let mut ps : Parser.ModuleParserState := {}
  for _ in [0:text.utf8ByteSize + 1] do
    let s ← get
    let scope := s.scopes.head!
    let pmctx : Parser.ParserModuleContext :=
      { env := s.env, options := scope.opts, currNamespace := scope.currNamespace, openDecls := scope.openDecls }
    let beginPos := ps.pos
    let (cmd, ps', parseMsgs) := Parser.parseCommand ictx pmctx ps .empty
    ps := ps'
    if Parser.isTerminalCommand cmd then
      let mut msgs := parseMsgs
      unless cmd.isOfKind ``Parser.Command.eoi do
        msgs := msgs.add { fileName, pos := ictx.fileMap.toPosition beginPos, severity := .error,
                           data := "#unpack_source: `import` or `#exit` in the packed text" }
      let diagnostics ← Language.Snapshot.Diagnostics.ofMessageLog msgs
      tasks := tasks.push (.finished none (.mk { diagnostics } #[]))
      break
    set { s with messages := {}, snapshotTasks := #[] }
    withReader (fun _ => { fileName, fileMap := ictx.fileMap, cmdPos := beginPos, snap? := none, cancelTk? }) do
      withLoggingExceptions (getResetInfoTrees *> elabCommandTopLevel cmd)
    let s ← get
    let diagnostics ← Language.Snapshot.Diagnostics.ofMessageLog (parseMsgs ++ s.messages)
    tasks := tasks.push (.finished none (.mk { diagnostics } #[])) ++ s.snapshotTasks
  -- the info trees of the last command are not part of `#unpack_source`'s own info tree
  discard getResetInfoTrees
  modify fun s => { s with messages := outerMsgs, snapshotTasks := tasks, infoState.enabled := outerInfo }

/-- `#unpack_source [noinfo] n h "…" …`; `noinfo`: elaborate the decoded commands without info trees. -/
syntax (name := unpackCmd) "#unpack_source " (&"noinfo")? num num (str)+ : command

@[command_elab unpackCmd] def elabUnpack : CommandElab := fun stx => do
  let infoTrees := stx[1].isNone
  let some n := stx[2].isNatLit? | throwError "#unpack_source: length expected"
  let some h := stx[3].isNatLit? | throwError "#unpack_source: checksum expected"
  let mut src := ByteArray.empty
  for lit in stx[4].getArgs do
    let some s := lit.isStrLit? | throwError "#unpack_source: string literal expected"
    src := src ++ s.toUTF8
  match decode src n with
  | .error e => throwError "#unpack_source: {e}"
  | .ok bytes =>
    unless checksum bytes == h do throwError "#unpack_source: checksum mismatch"
    let some text := String.fromUTF8? bytes | throwError "#unpack_source: decoded bytes are not UTF-8"
    runCommands text ((← getFileName) ++ " (unpacked)") infoTrees

end PackedSource
end

