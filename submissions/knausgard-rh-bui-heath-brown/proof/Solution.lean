noncomputable section
namespace KnausgardThirdMoment

theorem onLineCount (a b : ℝ) : Zeta23.N0star a b = Zeta23.Ndist a b :=
  (Zeta23.RH_implies_all_on_line _root_.riemannHypothesis a b).2

theorem dyadic :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      ((142844914183271838785035521346505078433005235250696131382749896706763610613543817536842488633550231381119 / 167878659999888875382189217818946569202353145861770144550217596982294595321962505449011440000000000000000 : ℝ) - ε) * (Zeta23.Ncount T (2 * T) : ℝ) ≤ Zeta23.N0star T (2 * T) := by
  intro ε hε
  obtain ⟨T₀, h⟩ := BHB.distinct_dyadic_of_RH_opt _root_.riemannHypothesis ε hε
  refine ⟨T₀, fun T hT => ?_⟩
  rw [onLineCount]
  exact h T hT

theorem cumulative :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      ((142844914183271838785035521346505078433005235250696131382749896706763610613543817536842488633550231381119 / 167878659999888875382189217818946569202353145861770144550217596982294595321962505449011440000000000000000 : ℝ) - ε) * (Zeta23.Ncount 0 T : ℝ) ≤ Zeta23.N0star 0 T := by
  intro ε hε
  obtain ⟨T₀, h⟩ := BHB.distinct_cumulative_of_RH_opt _root_.riemannHypothesis ε hε
  refine ⟨T₀, fun T hT => ?_⟩
  rw [onLineCount]
  exact h T hT

end KnausgardThirdMoment
end

#print axioms BHB.distinct_dyadic_of_RH_opt
#print axioms KnausgardThirdMoment.dyadic
#print axioms KnausgardThirdMoment.cumulative

noncomputable section

theorem candidate_strict_improvement :
    currentRecordKappa < candidateKappa := by
  norm_num [currentRecordKappa, candidateKappa]

theorem candidate_critical_line_bound :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (candidateKappa - ε) * (Ncount T (2 * T) : ℝ) ≤ N0star T (2 * T) := by
  have e : candidateKappa = (142844914183271838785035521346505078433005235250696131382749896706763610613543817536842488633550231381119 / 167878659999888875382189217818946569202353145861770144550217596982294595321962505449011440000000000000000 : ℝ) := by norm_num [candidateKappa]
  rw [e]
  exact KnausgardThirdMoment.dyadic

theorem candidate_critical_line_bound_cumulative :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (candidateKappa - ε) * (Ncount 0 T : ℝ) ≤ N0star 0 T := by
  have e : candidateKappa = (142844914183271838785035521346505078433005235250696131382749896706763610613543817536842488633550231381119 / 167878659999888875382189217818946569202353145861770144550217596982294595321962505449011440000000000000000 : ℝ) := by norm_num [candidateKappa]
  rw [e]
  exact KnausgardThirdMoment.cumulative

end
