section Src_Distinct855_Main







noncomputable section
open Filter ComplexConjugate ShortProbe ShortProbe.RealResidual ReflectedStrip
open scoped BigOperators

namespace Distinct855

def shiftA : ℝ := 19837/39837

theorem shiftA_eq : shiftA = 1 - Kernel.wpsi0/2 := by norm_num [shiftA, Kernel.wpsi0]

def Phi (T : ℝ) (z : ℂ) : ℝ :=
  phiPoly (shortPrimes T z).re (shortPrimes T z).im ((Kernel.probePsi T z).re + shiftA)
    (Kernel.probePsi T z).im (mollified T z).re (mollified T z).im

def cost (T : ℝ) (z : ℂ) : ℝ := 1 + 1/10^12 - Phi T z

theorem cost_nonneg (T : ℝ) (z : ℂ) : 0 ≤ cost T z := by
  have := le_one (shortPrimes T z).re (shortPrimes T z).im ((Kernel.probePsi T z).re + shiftA)
    (Kernel.probePsi T z).im (mollified T z).re (mollified T z).im
  unfold cost Phi
  linarith

theorem conj_mixed (u w f : ℂ) :
    (f*conj ((861/250:ℂ)*w-u)).re = (861/250)*(f*conj w).re - (f*conj u).re := by
  have h : (861/250:ℂ) = ((861/250:ℝ):ℂ) := by push_cast; ring
  rw [h, map_sub, map_mul, Complex.conj_ofReal, mul_sub, Complex.sub_re, mul_left_comm,
    Complex.re_ofReal_mul]

theorem phi_expand (u w f : ℂ) :
    phiPoly u.re u.im (w.re + shiftA) w.im f.re f.im =
      (4295941883470777/5289955230000000:ℝ) + (-(97775766467/398370000000):ℝ)*u.re + (-(1346279/10000000):ℝ)*‖u‖^2 + (-(31125942977/199185000000):ℝ)*(u^2).re +
      (1916423/10000000:ℝ)*(u^2*conj u).re + (-(1187579/10000000):ℝ)*‖u‖^4 +
      (7882872421/13279000000:ℝ)*w.re + (-(1173537/2500000):ℝ)*‖w‖^2 + (1861787/5000000:ℝ)*(u*conj w).re +
      (1370837/10000000:ℝ)*(u^2*conj w).re +
      (9639760297/28455000000:ℝ)*f.re + (70029371/1230000000:ℝ)*(f*conj u).re + (31291/400000:ℝ)*(f*conj (u^2)).re +
      (-(382661/2460000):ℝ)*(f*conj ((861/250:ℂ)*w-u)).re + (-(1528773/10000000):ℝ)*‖f‖^2 := by
  have hn (z : ℂ) : ‖z‖^2 = z.re^2 + z.im^2 := by
    rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]; ring
  have h4 : ‖u‖^4 = (u.re^2 + u.im^2)^2 := by rw [show ‖u‖^4 = (‖u‖^2)^2 by ring, hn]
  rw [conj_mixed, h4, hn u, hn w, hn f]
  simp only [pow_two, Complex.mul_re, Complex.mul_im, Complex.conj_re, Complex.conj_im]
  unfold phiPoly shiftA
  ring

theorem zero_bound (hRH : RiemannHypothesis) :
    ∀ᶠ T : ℝ in atTop, ∀ z ∈ ThirdMoment.zerosFinset T (2*T),
      (Zeta23.zeroMult z:ℝ) - (Zeta23.zeroMult z:ℝ)*cost T z ≤ 1 := by
  filter_upwards [Kernel.local_bound_psi hRH (ε := 1/10^12) (by norm_num)] with T hl z hz
  have hm := ThirdMoment.one_le_mult_of_mem hz
  have hF : Zeta23.zeroMult z ≠ 1 → (mollified T z).re = 0 ∧ (mollified T z).im = 0 := by
    intro h
    let ρ : Zeta23.zetaZeroConfig.carrier := ⟨z,(ThirdMoment.mem_zerosFinset.mp hz).1⟩
    have hd := BHB.Red.deriv_zeta_eq_zero_of_mult_ne_one ρ h
    have h0 : mollified T z = 0 := by simp [mollified, show deriv riemannZeta z = 0 from hd]
    simp [h0]
  have hs : (Zeta23.zeroMult z:ℝ) ≤ 2 - 2*((Kernel.probePsi T z).re + shiftA) + 1/10^12 := by
    have := hl z hz
    unfold Kernel.wpsi0 at this
    unfold shiftA
    linarith
  have hb := mult_bound (Zeta23.zeroMult z) hm (x := (shortPrimes T z).re) (y := (shortPrimes T z).im)
    (t := (Kernel.probePsi T z).im) (by norm_num) (by norm_num) hF hs
  unfold cost Phi
  linarith

theorem centerU_eq : centerU = (-(263124905500005550000699999973/2400000000000000000000000000000):ℝ) := by norm_num [centerU, lengthExponent]

theorem energyU_eq : energyU = (231715550581251299375933500000374996706000081/2400000000000000000000000000000000000000000000:ℝ) := by norm_num [energyU, lengthExponent]

theorem smooth_cost (hRH : RiemannHypothesis) (w : BHB.Weight) (hw : w.kap1 ≤ 1+1/10^7) :
    ∀ᶠ T : ℝ in atTop, ∃ v : ℝ,
      HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z*cost T z) v ∧
      v ≤ (14463372221/100000000000)*TMA.Dsc T := by
  have hη : (0:ℝ) < 1/10^12 := by norm_num
  have hF2 := ReflectedMoments.second_of_prime_main hRH w hw (by
    intro δ hδ
    obtain ⟨T₀,h⟩ := Taper78.BHB.MainP_asymp hRH w
      (θ := lengthExponent) (by norm_num [lengthExponent]) (by norm_num [lengthExponent]) δ hδ
    exact ⟨T₀,fun T hT => sub_le_iff_le_add'.mp (abs_le.mp (h T hT)).2⟩)
  have hcoarse : ∀ᶠ T : ℝ in atTop, ∃ e : ℝ, HasSum (fun ρ : Zeta23.zetaZeroConfig.carrier =>
      TMA.cw w.h T ρ*‖mollified T ρ‖^2) e ∧ e ≤ 100*TMA.Dsc T := by
    filter_upwards [hF2, eventually_gt_atTop (1:ℝ)] with T ⟨e,he,h⟩ hT
    exact ⟨e,he,h.trans (mul_le_mul_of_nonneg_right (by norm_num) (PairMoments.dsc_nonneg hT))⟩
  have hFU := LowBand.lowband_cross hRH w (P := LowBand.taper78) (f := fun x => 1 - x / 5 - 9 * x ^ 2 / 20)
    (by unfold LowBand.taper78; fun_prop) (by fun_prop)
    (θ := lengthExponent) (s₀ := lengthExponent) (by norm_num [lengthExponent]) (by norm_num [lengthExponent])
    (by norm_num [lengthExponent]) (by norm_num [lengthExponent]) hη
  rw [LowBand.molP_taper78, LowBand.primePoly_short] at hFU
  filter_upwards [mass hRH w.toHeightWeight _ hη, short_mean hRH w.toHeightWeight _ hη,
    short_shift hRH w.toHeightWeight 0 hη, short_square hRH w.toHeightWeight hη,
    PairMoments.cube_moment hRH w.toHeightWeight _ hη, PairMoments.fourth_moment hRH w.toHeightWeight _ hη,
    psi_mean hRH w.toHeightWeight _ hη, psi_energy hRH w.toHeightWeight _ hη,
    short_psi hRH w.toHeightWeight _ hη, PairMoments.witness_moment hRH w.toHeightWeight _ hη,
    ReflectedMoments.first_78 hRH w, hFU, D9.cross_square hRH w hη, Kernel.full_mixed hRH w hw hcoarse, hF2,
    eventually_gt_atTop (1:ℝ)]
    with T ⟨m0,h0,b0⟩ ⟨m1,h1,b1⟩ ⟨m2,h2,b2⟩ ⟨m3,h3,b3⟩ ⟨m4,h4,b4⟩ ⟨m5,h5,b5⟩ ⟨m6,h6,b6⟩ ⟨m7,h7,b7⟩
      ⟨m8,h8,b8⟩ ⟨m9,h9,b9⟩ ⟨m10,h10,b10⟩ ⟨m11,h11,b11⟩ ⟨m12,h12,b12⟩ ⟨m13,h13,b13⟩ ⟨m14,h14,b14⟩ hT
  have h2' : HasSum (fun z : Zeta23.zetaZeroConfig.carrier => TMA.cw w.h T z*‖shortPrimes T z‖^2) m2 :=
    h2.congr_fun (fun z => by simp)
  refine ⟨_, (((((((((((((((h0.mul_left (99401334653451295523/528995523000000000000:ℝ)).add (h1.mul_left (97775766467/398370000000:ℝ))).add
      (h2'.mul_left (1346279/10000000:ℝ))).add (h3.mul_left (31125942977/199185000000:ℝ))).add (h4.mul_left (-(1916423/10000000):ℝ))).add
      (h5.mul_left (1187579/10000000:ℝ))).add (h6.mul_left (-(7882872421/13279000000):ℝ))).add (h7.mul_left (1173537/2500000:ℝ))).add
      (h8.mul_left (-(1861787/5000000):ℝ))).add (h9.mul_left (-(1370837/10000000):ℝ))).add (h10.mul_left (-(9639760297/28455000000):ℝ))).add
      (h11.mul_left (-(70029371/1230000000):ℝ))).add (h12.mul_left (-(31291/400000):ℝ))).add (h13.mul_left (382661/2460000:ℝ))).add
      (h14.mul_left (1528773/10000000:ℝ))).congr_fun (fun z => ?_), ?_⟩
  · simp only [cost, Phi]
    rw [phi_expand]
    ring
  · have hD := PairMoments.dsc_nonneg hT
    have hk1 := BHB.Final.one_le_kap1 w.toHeightWeight
    have hK1 : TMA.Dsc T ≤ w.kap1*TMA.Dsc T := by nlinarith
    have hK2 : w.kap1*TMA.Dsc T ≤ (1+1/10^7)*TMA.Dsc T := mul_le_mul_of_nonneg_right hw hD
    rw [centerU_eq] at b1 b4
    rw [energyU_eq] at b2 b4 b5
    rw [centerU_eq, Kernel.pairingPsi_eq] at b9
    rw [Kernel.M1psi_eq] at b6
    rw [Kernel.M2psi_eq] at b7
    rw [Kernel.pairingPsi_eq] at b8
    rw [LowBand.lowConst_U] at b11
    rw [D9.C₂_eq] at b12
    have hs := Kernel.stripCoefficient_nearHalf
    have b13' : m13 ≤ (w.kap1*(-(1014292/10000000:ℝ))+11/1000000)*TMA.Dsc T := by
      have := mul_le_mul_of_nonneg_left hs (by linarith : (0:ℝ) ≤ w.kap1)
      nlinarith
    obtain ⟨b0l,b0u⟩ := abs_le.mp b0
    obtain ⟨b1l,b1u⟩ := abs_le.mp b1
    obtain ⟨b4l,b4u⟩ := abs_le.mp b4
    obtain ⟨b5l,b5u⟩ := abs_le.mp b5
    obtain ⟨b6l,b6u⟩ := abs_le.mp b6
    obtain ⟨b8l,b8u⟩ := abs_le.mp b8
    obtain ⟨b9l,b9u⟩ := abs_le.mp b9
    obtain ⟨b11l,b11u⟩ := abs_le.mp b11
    obtain ⟨b12l,b12u⟩ := abs_le.mp b12
    norm_num at b10 b14
    linarith

theorem record (hRH : RiemannHypothesis) :
    ShortProbe.Dyadic (85536627778/100000000000) ∧ ShortProbe.Cumulative (85536627778/100000000000) := by
  obtain ⟨w,hw,_⟩ := BHB.exists_weight (ε := 1/10^7) (by norm_num)
  apply ShortProbe.intervals
  filter_upwards [smooth_cost hRH w hw, zero_bound hRH,
    eventually_atTop.mpr (BHB.Final.Dsc_le_Ncount (show (0:ℝ) < 1/10^12 by norm_num)),
    eventually_gt_atTop (0:ℝ)] with T ⟨v,hv,hv'⟩ hz hN hT
  rw [(Zeta23.RH_implies_all_on_line hRH _ _).2]
  have hs := PrimeVariance.sharp_majorized w.toHeightWeight hT (cost T) (cost T) (cost_nonneg T)
    (fun _ => le_rfl) hv
  have bound : MultiplicityProbe.count T - FejerBands.sharp T (cost T) ≤ (Zeta23.Ndist T (2*T):ℝ) := by
    have hsum := Finset.sum_le_sum (s := ThirdMoment.zerosFinset T (2*T)) hz
    simpa only [FejerBands.sharp, MultiplicityProbe.count, ThirdMoment.Ncount_eq, ThirdMoment.Ndist_eq,
      Nat.cast_sum, Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul, mul_one] using hsum
  change TMA.Dsc T ≤ (1+1/10^12)*MultiplicityProbe.count T at hN
  have hc : 0 ≤ MultiplicityProbe.count T := Nat.cast_nonneg _
  linarith

end Distinct855
end
end Src_Distinct855_Main


noncomputable section

theorem candidate_strict_improvement : currentRecordKappa < candidateKappa := by
  norm_num [currentRecordKappa, candidateKappa]

theorem candidate_critical_line_bound :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (candidateKappa - ε) * (Ncount T (2*T) : ℝ) ≤ N0star T (2*T) := by
  rw [show candidateKappa=(85536627778/100000000000:ℝ) by norm_num [candidateKappa]]
  exact (Distinct855.record _root_.riemannHypothesis).1

theorem candidate_critical_line_bound_cumulative :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (candidateKappa - ε) * (Ncount 0 T : ℝ) ≤ N0star 0 T := by
  rw [show candidateKappa=(85536627778/100000000000:ℝ) by norm_num [candidateKappa]]
  exact (Distinct855.record _root_.riemannHypothesis).2

end

