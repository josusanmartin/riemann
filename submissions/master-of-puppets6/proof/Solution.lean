  have hnum : (14 / 5 : ℝ) ≤ cos y + 2 * AMW.gamAM * z * sin y := by
    nlinarith only [hcos, hprod]
  have hden0 : 0 < 2 * z ^ 2 - 1 := by
    have h := mul_nonneg (sub_nonneg.mpr hzlo)
