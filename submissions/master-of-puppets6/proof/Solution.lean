      norm_num [Meshuggah.Majorant.cosPoly, mul_pow, h2, h4] <;> ring
lemma profile_upper {s : ℝ} (hs : |s| ≤ 1 / 2) :
    AMW.rhoAM * AMW.vAM s ≤
      (109 / 100) * (1075328262 / 1000000000 - s ^ 2 + s ^ 4 / 6) := by
  have hv0 : 0 ≤ AMW.vAM s := le_trans (by norm_num) (AMW.vAM_ge_core hs)
  have hv : AMW.vAM s ≤ 1075328262 / 1000000000 - s ^ 2 + s ^ 4 / 6 := by
    rw [AMW.vAM_eq]
    linarith [cos_core_upper s, (abs_le.mp (AMW.abs_pAM_le s)).2]
  exact (mul_le_mul_of_nonneg_right rho_le hv0).trans
    (mul_le_mul_of_nonneg_left hv (by norm_num))
                                                                                                          
                                                                                                               
                                                                        
lemma mul_cos_le (α y : ℝ) : α * cos y ≤ α + max 0 (-α) * (y ^ 2 / 2) := by
  rcases le_or_gt 0 α with h | h
  · have hc := Real.cos_le_one y
    have hm : 0 ≤ max 0 (-α) * (y ^ 2 / 2) := mul_nonneg (le_max_left _ _) (by positivity)
    nlinarith
  · have hc := Real.one_sub_sq_div_two_le_cos (x := y)
    rw [max_eq_right (by linarith)]
    nlinarith
lemma cos_reflect (k : ℕ) (a : ℝ) :
    cos (2 * π * k * a) = (-1) ^ k * cos (2 * π * k * (1 / 2 - a)) := by
  rw [show 2 * π * k * a = k * π - 2 * π * k * (1 / 2 - a) by ring, Real.cos_nat_mul_pi_sub]
lemma pAM_le_edge {s : ℝ} (hs1 : 9 / 20 ≤ |s|) (hs2 : |s| ≤ 1 / 2) :
    AMW.pAM s ≤ 9577405 / 1000000000 := by
  have hpi := Real.pi_lt_d4
  have hpi0 := Real.pi_pos
  set u : ℝ := 1 / 2 - |s| with hu
  have hu0 : 0 ≤ u := by linarith
  have hu1 : u ≤ 1 / 20 := by linarith
  have hterm : ∀ j ∈ Finset.range 12, (AMW.cAM (j + 1) : ℝ) * cos (AMW.ωAM (j + 1) * s)
      ≤ (-1) ^ (j + 1) * (AMW.cAM (j + 1) : ℝ)
        + max 0 (-((-1) ^ (j + 1) * (AMW.cAM (j + 1) : ℝ))) * (2 * 3.1416 ^ 2 * ((j : ℝ) + 1) ^ 2 / 400) := by
    intro j _
    have hj : (0 : ℝ) ≤ (j : ℝ) + 1 := by positivity
    have e : cos (AMW.ωAM (j + 1) * s) = (-1) ^ (j + 1) * cos (2 * π * ((j + 1 : ℕ) : ℝ) * u) := by
      rw [AMW.ωAM_succ, ← Real.cos_abs, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ 2 * π * ((j : ℝ) + 1)),
        show 2 * π * ((j : ℝ) + 1) * |s| = 2 * π * ((j + 1 : ℕ) : ℝ) * |s| by push_cast; ring, cos_reflect]
    rw [e, ← mul_assoc, mul_comm (AMW.cAM (j + 1) : ℝ)]
    refine (mul_cos_le _ _).trans ?_
    have hy : (2 * π * ((j + 1 : ℕ) : ℝ) * u) ^ 2 / 2 = 2 * π ^ 2 * ((j : ℝ) + 1) ^ 2 * u ^ 2 := by
      push_cast; ring
    have hp2 : π ^ 2 ≤ 3.1416 ^ 2 := pow_le_pow_left₀ hpi0.le hpi.le 2
    have hu2 : u ^ 2 ≤ 1 / 400 := by nlinarith
    have hj2 : 0 ≤ ((j : ℝ) + 1) ^ 2 := sq_nonneg _
    have hyb : (2 * π * ((j + 1 : ℕ) : ℝ) * u) ^ 2 / 2 ≤ 2 * 3.1416 ^ 2 * ((j : ℝ) + 1) ^ 2 / 400 := by
      rw [hy]
      have h1 : π ^ 2 * u ^ 2 ≤ 3.1416 ^ 2 * (1 / 400) :=
        mul_le_mul hp2 hu2 (sq_nonneg _) (by positivity)
      nlinarith [mul_le_mul_of_nonneg_left h1 hj2]
    linarith [mul_le_mul_of_nonneg_left hyb (le_max_left 0 (-((-1) ^ (j + 1) * (AMW.cAM (j + 1) : ℝ))))]
  refine (Finset.sum_le_sum hterm).trans ?_
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, AMW.cAM, AMW.cAMn]
  norm_num [max_def]
lemma profile_upper_edge {s : ℝ} (hs : |s| ≤ 1 / 2) (hs1 : 9 / 20 ≤ |s|) :
    AMW.rhoAM * AMW.vAM s ≤
      (109 / 100) * (1009577405 / 1000000000 - s ^ 2 + s ^ 4 / 6) := by
