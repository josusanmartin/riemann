 · simp [beq_false (show k ≠ 1 by omega), beq_false (show k ≠ 2 by omega), beq_false (show k ≠ 3 by omega), Nat.add_eq, Nat.mul_eq]
theorem mcnK_eq (f : ℕ → ℕ) (L0 k m p r : ℕ) : mcK f false L0 k m p r = mcnT f L0 k m p r := by
