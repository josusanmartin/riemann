     (Nat.add (chg f sg L0 (Nat.sub 1024 m) p) (chg f sg L0 m r)) (Nat.beq k 3))
   (chg f sg L0 m p) (Nat.beq k 2))
   (chg f sg L0 1024 p) (Nat.beq k 1)
def mslK (f : ℕ → ℕ) (k m p r : ℕ) : ℕ :=
