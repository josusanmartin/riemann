   have h1 := le_ndivc (Nat.sub a.p a.n) d hd
   have e : ((Nat.sub a.p a.n : ℕ) : ℝ) = (a.p : ℝ) - a.n := by
     rw [show Nat.sub a.p a.n = a.p - a.n from rfl, Nat.cast_sub h]
