theorem gram_re_eq (Z : ZeroConfig) {P : Params} (hP : P.Valid) (T : ℝ)
    (ha : 0 < (AMW.atAM P T).a T)
    (u v : Zeta23Ext.Bridge.retained Z (AMW.atAM P T) T) :
