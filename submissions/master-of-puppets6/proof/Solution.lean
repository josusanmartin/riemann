def slT (Q : ℕ) (SL : List ℕ) (a b : ℕ) : ℕ := SL.getD (a * (Q + 1) + b) 0
def SLok (Q : ℕ) (PR : List (ℕ × ℕ)) (SL : List ℕ) : Prop :=
