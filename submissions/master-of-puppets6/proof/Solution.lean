  have hgam : (4 / 5 : ℝ) ≤ AMW.gamAM := by
    linarith [AMW.G.gamAM_bounds.1]
  have hgam0 : 0 ≤ AMW.gamAM := by linarith
  have hgz : (4 / 5 : ℝ) * (8 / 3) ≤ AMW.gamAM * z :=
    mul_le_mul hgam hzlo (by norm_num) hgam0
  have hprod : ((4 / 5 : ℝ) * (8 / 3)) * (9 / 20) ≤
      (AMW.gamAM * z) * sin y :=
