    field_simp [AMW.K0AM_pos.ne', ne_of_gt hden0] <;> ring
  rw [heq, le_div_iff₀ hden0]
  nlinarith only [hnum, hdenhi]
lemma kernel_eq_KMT_add_correction (t : ℝ) :
    AMW.kfunAM t = AMW.KMT t / AMW.K0AM +
      AMW.rhoAM * ∑ n ∈ Finset.range 12, (AMW.cAM (n + 1) : ℝ) * AMW.Tj n t := by
  unfold AMW.kfunAM
  rw [AMW.K0AM_eq, AMW.KfunAM_eq_sinc, Finset.sum_range_succ',
    AMW.cAM_zero, AMW.ωAM_zero, one_mul]
  have hk : (sinc ((sqrt 2 - 2 * π * t) / 2) + sinc ((sqrt 2 + 2 * π * t) / 2)) / 2 =
      AMW.KMT t := rfl
  rw [hk]
  have hs : ∀ n ∈ Finset.range 12,
      (AMW.cAM (n + 1) : ℝ) *
        ((sinc ((AMW.ωAM (n + 1) - 2 * π * t) / 2) +
          sinc ((AMW.ωAM (n + 1) + 2 * π * t) / 2)) / 2) =
      (AMW.cAM (n + 1) : ℝ) * AMW.Tj n t := by
    intro n _
    rw [AMW.term_sinc]
    rfl
  rw [Finset.sum_congr rfl hs]
  unfold AMW.rhoAM
  ring
                                                                             
                                                                                                                     
                                                                       
lemma Tj_closed (n : ℕ) {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t < 1) :
    AMW.Tj n t = (-1) ^ (n + 1) * (t * sin (π * t)) / (π * (t ^ 2 - ((n : ℝ) + 1) ^ 2)) := by
  have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have ha : t - ((n : ℝ) + 1) ≠ 0 := by intro h; linarith
  have hb : t + ((n : ℝ) + 1) ≠ 0 := by intro h; linarith
  have hc : t ^ 2 - ((n : ℝ) + 1) ^ 2 ≠ 0 := by
    rw [show t ^ 2 - ((n : ℝ) + 1) ^ 2 = (t - ((n : ℝ) + 1)) * (t + ((n : ℝ) + 1)) by ring]
    exact mul_ne_zero ha hb
  have e1 : sin (π * (t - ((n : ℝ) + 1))) = (-1) ^ (n + 1) * sin (π * t) := by
    rw [show π * (t - ((n : ℝ) + 1)) = π * t - ((n + 1 : ℕ) : ℝ) * π by push_cast; ring,
      Real.sin_sub_nat_mul_pi]
  have e2 : sin (π * (t + ((n : ℝ) + 1))) = (-1) ^ (n + 1) * sin (π * t) := by
    rw [show π * (t + ((n : ℝ) + 1)) = π * t + ((n + 1 : ℕ) : ℝ) * π by push_cast; ring,
      Real.sin_add_nat_mul_pi]
  unfold AMW.Tj
  rw [Real.sinc_of_ne_zero (mul_ne_zero Real.pi_ne_zero ha),
    Real.sinc_of_ne_zero (mul_ne_zero Real.pi_ne_zero hb), e1, e2]
  have hpi := Real.pi_ne_zero
  field_simp
  ring
def bTs (n : ℕ) : ℝ := if n = 0 then 17 / 37 else (17 / 20) / ((157 / 50) * (((n : ℝ) + 1) ^ 2 - 289 / 400))
lemma Tj_abs_le_sep (n : ℕ) {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 17 / 20) : |AMW.Tj n t| ≤ bTs n := by
  have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hpi := Real.pi_gt_d2
  have hpi0 := Real.pi_pos
  rw [Tj_closed n ht0 (by linarith)]
  have hmt : 0 < ((n : ℝ) + 1) ^ 2 - t ^ 2 := by nlinarith
  have hden : 0 < π * (((n : ℝ) + 1) ^ 2 - t ^ 2) := mul_pos hpi0 hmt
  have habs : |(-1) ^ (n + 1) * (t * sin (π * t)) / (π * (t ^ 2 - ((n : ℝ) + 1) ^ 2))|
      = t * |sin (π * t)| / (π * (((n : ℝ) + 1) ^ 2 - t ^ 2)) := by
    rw [abs_div, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul, abs_mul, abs_of_nonneg ht0,
      show π * (t ^ 2 - ((n : ℝ) + 1) ^ 2) = -(π * (((n : ℝ) + 1) ^ 2 - t ^ 2)) by ring, abs_neg,
      abs_of_pos hden]
  rw [habs, div_le_iff₀ hden]
  rcases Nat.eq_zero_or_pos n with rfl | hpos
  · rw [show bTs 0 = 17 / 37 from if_pos rfl]
    simp only [Nat.cast_zero, zero_add, one_pow]
    have hs0 : 0 ≤ sin (π * t) := Real.sin_nonneg_of_nonneg_of_le_pi (by positivity) (by nlinarith)
    have hs1 : sin (π * t) ≤ π * (1 - t) := by
      have h := Real.sin_le (x := π - π * t) (by nlinarith)
      rw [Real.sin_pi_sub] at h
      linarith
    rw [abs_of_nonneg hs0]
    have h1 : t * sin (π * t) ≤ t * (π * (1 - t)) := mul_le_mul_of_nonneg_left hs1 ht0
    have h2 : 0 ≤ π * (1 - t) * (17 / 20 - t) := mul_nonneg (by nlinarith) (by linarith)
    nlinarith
  · have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hpos
    simp only [bTs, if_neg (Nat.pos_iff_ne_zero.mp hpos)]
    have hD : 0 < (157 / 50 : ℝ) * (((n : ℝ) + 1) ^ 2 - 289 / 400) := by nlinarith
    have hs : t * |sin (π * t)| ≤ 17 / 20 := by
      have := Real.abs_sin_le_one (π * t)
      nlinarith [abs_nonneg (sin (π * t))]
    have hDle : (157 / 50 : ℝ) * (((n : ℝ) + 1) ^ 2 - 289 / 400) ≤ π * (((n : ℝ) + 1) ^ 2 - t ^ 2) := by
      have h289 : t ^ 2 ≤ 289 / 400 := by nlinarith
      nlinarith
    rw [div_mul_eq_mul_div, le_div_iff₀ hD]
    nlinarith [mul_le_mul_of_nonneg_right hs hD.le, abs_nonneg (sin (π * t))]
lemma correction_abs_le {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 17 / 20) :
    |AMW.rhoAM * ∑ n ∈ Finset.range 12, (AMW.cAM (n + 1) : ℝ) * AMW.Tj n t|
      ≤ 187499999 / 2500000000 := by
  have hs : |∑ n ∈ Finset.range 12, (AMW.cAM (n + 1) : ℝ) * AMW.Tj n t|
      ≤ ∑ n ∈ Finset.range 12, |(AMW.cAM (n + 1) : ℝ)| * bTs n := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun n _ => ?_)
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_left (Tj_abs_le_sep n ht0 ht1) (abs_nonneg _)
  have hB : ∑ n ∈ Finset.range 12, |(AMW.cAM (n + 1) : ℝ)| * bTs n ≤ 8249086 / 1000000000 := by
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, AMW.cAM, AMW.cAMn, bTs]
    norm_num [abs_div]
  rw [abs_mul, abs_of_pos AMMajorant.rho_pos]
  have h := mul_le_mul_of_nonneg_left (hs.trans hB) AMMajorant.rho_pos.le
  nlinarith only [h, AMMajorant.rho_le]
lemma kernel_ge_nonneg {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 17 / 20) :
    (312500001 / 2500000000 : ℝ) ≤ AMW.kfunAM t := by
  have hbase := div_le_div_of_nonneg_right (KMT_ge_at_sep ht0 ht1) AMW.K0AM_pos.le
  have hcorr := (abs_le.mp (correction_abs_le ht0 ht1)).1
  rw [kernel_eq_KMT_add_correction]
  linarith [normalized_KMT_at_sep_ge]
theorem kernel_ge_one_eighth {t : ℝ} (ht : |t| ≤ 17 / 20) :
    (1 / 8 : ℝ) ≤ AMW.kfunAM t := by
  by_cases ht0 : 0 ≤ t
  · have h := kernel_ge_nonneg ht0 ((le_abs_self t).trans ht)
    linarith
  · have htneg : t < 0 := lt_of_not_ge ht0
    have h := kernel_ge_nonneg (neg_nonneg.mpr htneg.le)
      ((neg_le_abs t).trans ht)
    have he : AMW.kfunAM (-t) = AMW.kfunAM t := by
      unfold AMW.kfunAM
      rw [AMW.KfunAM_neg]
    rw [he] at h
    linarith
theorem kernel_square_ge {t : ℝ} (ht : |t| ≤ 17 / 20) :
    (1 / 64 : ℝ) ≤ AMW.kfunAM t ^ 2 := by
  have h := kernel_ge_one_eighth ht
  nlinarith [sq_nonneg (AMW.kfunAM t - 1 / 8)]
end Opeth.AMClosePair
