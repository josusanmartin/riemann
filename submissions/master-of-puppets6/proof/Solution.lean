 · simp [h, beq_false h]
theorem mvK_eq (top : ℕ) (bk : ℕ → ℕ) (f : ℕ → ℕ) (L U k m p r : ℕ) : mvK top bk f L U k m p r = mvT top bk f L U k m p r := by
