    _ ≤ (a * L ^ 2)⁻¹ * (L * (L * ((AMW.rhoAM * AMW.MAM)⁻¹ *
        ((1253 / 650) * ∑ i, z i ^ 2)))) := by
      apply mul_le_mul_of_nonneg_left _ (inv_nonneg.mpr hc.le)
      refine hB.trans ?_
      rw [hD]
