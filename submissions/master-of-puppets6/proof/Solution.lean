theorem card_near_le_k (ℓ k : ℕ) (i : Fin ℓ) :
    (univ.filter fun j : Fin ℓ =>
      i ≠ j ∧ (i : ℕ) ≤ (j : ℕ) + k ∧ (j : ℕ) ≤ (i : ℕ) + k).card ≤ 2 * k := by
