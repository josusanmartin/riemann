     · obtain ⟨k, hk, hk'⟩ := pieces_cover e m s h0 h1 h2
       exact ⟨k, by omega, hk'⟩
     · have hs : s = e m := le_antisymm h1 (by linarith [not_lt.mp h2])
       exact ⟨m, by omega, by rw [← hs]; linarith [not_lt.mp h2], le_of_eq hs.symm, hm⟩
