theorem cert_AM7_of (hcert : ∀ x0 x1 x2 x3 x4 x5 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 → 0 ≤ x5 →
      (AMW.Cert.AM7.cN : ℝ) / AMW.Cert.AM7.SA ≤ AMW.Cert.AM7.G x0 x1 x2 x3 x4 x5) :
    ∀ g : Fin 6 → ℝ, (∀ i, 0 ≤ g i) → ((787320 : ℝ) / 100000000) ≤ Fw W7 g := by
  intro g hg
  rw [Fw_W7]
  have h := hcert (g 0) (g 1) (g 2) (g 3) (g 4) (g 5) (hg 0) (hg 1) (hg 2) (hg 3) (hg 4) (hg 5)
  simp only [AMW.Cert.AM7.cN, AMW.Cert.AM7.SA] at h
  push_cast at h
  exact h

/-- `κ ≤ Phi_w' 7 c 133 B` below the rational `6734298129/10000000000` (from `HW_ge`) -/
theorem Phi_W7_ge {κ : ℝ} (hκ : κ ≤ (6734298129 : ℝ) / 10000000000) :
    κ ≤ Phi_w' 7 ((787320 : ℝ) / 100000000) 133 W7.B := by
  rw [W7_B]
  refine Phi_w'_ge (by norm_num) (by norm_num) ?_
  have h1 := mul_le_mul_of_nonneg_right hκ (show (0:ℝ) ≤ 1 - ((787320 : ℝ) / 100000000) * ((133 : ℝ) - 6) / 133 by norm_num)
  have h2 : (6734298129 : ℝ) / 10000000000 * (1 - ((787320 : ℝ) / 100000000) * ((133 : ℝ) - 6) / 133)
      ≤ 6721710925 / 10 ^ 10 - (199193 : ℝ) / 50000000 * ((133 : ℝ) - 6) / 133 := by norm_num
  push_cast
  linarith

/-- **The seven-point bound for the AM window**, from a certificate for `AM7.G`. -/
theorem dyadic_of {κ : ℝ} (hκ : κ ≤ (6734298129 : ℝ) / 10000000000)
    (hcert : ∀ x0 x1 x2 x3 x4 x5 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 → 0 ≤ x5 →
      (AMW.Cert.AM7.cN : ℝ) / AMW.Cert.AM7.SA ≤ AMW.Cert.AM7.G x0 x1 x2 x3 x4 x5) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (κ - ε) * (Zeta23.Ncount T (2 * T) : ℝ) ≤ Zeta23.N0star T (2 * T) :=
  am_dyadic W7_adm (by norm_num : (0 : ℝ) < (41849 : ℝ) / 100000000) W7_bmin (by norm_num) (m := 133)
    (by norm_num) (by norm_num) (Phi_W7_ge hκ) (cert_AM7_of hcert)

/-- The cumulative form. -/
theorem cumulative_of {κ : ℝ} (hκ : κ ≤ (6734298129 : ℝ) / 10000000000)
    (hcert : ∀ x0 x1 x2 x3 x4 x5 : ℝ, 0 ≤ x0 → 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 → 0 ≤ x5 →
      (AMW.Cert.AM7.cN : ℝ) / AMW.Cert.AM7.SA ≤ AMW.Cert.AM7.G x0 x1 x2 x3 x4 x5) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (κ - ε) * (Zeta23.Ncount 0 T : ℝ) ≤ Zeta23.N0star 0 T :=
  Zeta23.cumulative_of_dyadic Zeta23.zetaSeam Zeta23.paperInputs_zeta.RvM
    (fun _ _ _ => Zeta23.N0star_add' Zeta23.zetaSeam) (dyadic_of hκ hcert)

end RiemannFail

