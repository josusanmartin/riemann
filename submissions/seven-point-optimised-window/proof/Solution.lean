/-- the box `[l_r, u_r] / SC` satisfies the certificate inequality (or lies in the reflected half-space) -/
def Covered (l0 u0 l1 u1 l2 u2 l3 u3 l4 u4 l5 u5 : ℕ) : Prop :=
  ∀ g0 g1 g2 g3 g4 g5 : ℝ, (l0 : ℝ) / SC ≤ g0 → g0 ≤ (u0 : ℝ) / SC → (l1 : ℝ) / SC ≤ g1 → g1 ≤ (u1 : ℝ) / SC → (l2 : ℝ) / SC ≤ g2 → g2 ≤ (u2 : ℝ) / SC → (l3 : ℝ) / SC ≤ g3 → g3 ≤ (u3 : ℝ) / SC → (l4 : ℝ) / SC ≤ g4 → g4 ≤ (u4 : ℝ) / SC → (l5 : ℝ) / SC ≤ g5 → g5 ≤ (u5 : ℝ) / SC → (cN : ℝ) / SA ≤ G g0 g1 g2 g3 g4 g5 ∨ g5 < g0

theorem ee_or {C s : ℕ} {rest : Bool} (h : ee C s rest = true) : C ≤ s ∨ rest = true := by
  unfold ee at h
  cases hc : Nat.ble C s
  · rw [hc] at h; exact Or.inr h
  · exact Or.inl (by rw [← Nat.ble_eq, hc])

theorem ee_mono {C s t : ℕ} {rest : Bool} (h : ee C s rest = true) (k : rest = true → C ≤ t)
    (hst : s ≤ t) : C ≤ t := by
  rcases ee_or h with h | h
  · exact h.trans hst
  · exact k h

/-- beyond the cutoff `S` of a gap its pressure `b` alone pays -/
theorem cut_bound {b : ℝ} {S : ℕ} {g : ℝ} (hS : (cN : ℝ) * SC ≤ b * S) (hcut : (S : ℝ) / SC ≤ g)
    (hb : 0 ≤ b) : (cN : ℝ) / SA ≤ (b / (SA:ℝ)) * g := by
  have hSA : (0:ℝ) < SA := by norm_num [SA]
  have hSC : (0:ℝ) < SC := by norm_num [SC]
  rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSA]
  have h1 : (cN : ℝ) ≤ b * ((S : ℝ) / SC) := by
    rw [mul_div_assoc', le_div_iff₀ hSC]; exact hS
  exact h1.trans (mul_le_mul_of_nonneg_left hcut hb)

/-- inside the window `wfun ≥ 1/4`, so a pair weight `a ≥ 4 cN` alone pays -/
theorem win_bound {a x : ℝ} (ha : (cN : ℝ) * 4 ≤ a) (hw : (1 / 4 : ℝ) ≤ wfun x) :
    (cN : ℝ) / SA ≤ (a / (SA:ℝ)) * wfun x := by
  have hSA : (0:ℝ) < SA := by norm_num [SA]
  rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSA]
  have ha0 : 0 ≤ a := le_trans (by positivity) ha
  linarith [mul_le_mul_of_nonneg_left hw ha0]

