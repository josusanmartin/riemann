      rw [show Nat.sub (Nat.div (Nat.mul 2 (Nat.mul c.BLZ c.BLZ)) DZ) DZ = Nat.div (Nat.mul 2 (Nat.mul c.BLZ c.BLZ)) DZ - DZ
