    calc π * c.roff x ≤ ((PUN : ℝ) / E20) * ((c.RHI : ℝ) / DZ) := mul_le_mul pi_hi20 hr2 hr0 hP0
      _ = ((PUN : ℝ) * c.RHI / E20) / DZ := by ring
