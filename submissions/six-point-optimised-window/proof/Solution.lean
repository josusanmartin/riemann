    have e : ((Nat.mul 2 (Nat.mul c.BLZ c.BLZ) : ℕ) : ℝ) = 2 * (c.BLZ : ℝ) * c.BLZ := by
      rw [Nat.mul_eq, Nat.mul_eq]; push_cast; ring
