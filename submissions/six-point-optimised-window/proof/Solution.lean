/-- bit `t` of `T` -/
def bitOf (T t : ℕ) : Bool := Nat.beq (Nat.land (Nat.shiftRight T t) 1) 1


/-- the slope inequality at the point `q` with expansion set `T`, given the per-term reads and convexity flags:
