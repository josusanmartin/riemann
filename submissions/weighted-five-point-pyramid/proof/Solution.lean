/-! ###### module ICheck ###### -/

section

/-!
# Integer five-point checker

A kernel-evaluated checker for `c ≤ G5 p x y z u` on the nonnegative orthant. Coordinates are
naturals on the grid `n / 2^32`, weights are naturals scaled by `10^13`, and lower bounds for
`wfun` come from a range-minimum tree over cells verified by the record's `cell_sound`.
Recursion is written with recursors and comparisons with `Nat.ble`/`Nat.blt`, which the kernel
reduces directly. Root boxes are checked up to the mirror symmetry
`G5 p x y z u = G5 p u z y x`.
-/

noncomputable section

namespace Riemann.ICheck

open Zeta23Ext.Bridge Zeta23Ext.Bridge.ThreePoint

def Dg : ℕ := 4294967296

def Eg : ℕ := 10000000000000

def BIG : ℕ := 1000000000000000000000000000000

/-- A grid coordinate as a real number. -/
def toR (n : ℕ) : ℝ := (n : ℝ) / Dg

lemma Dg_pos : (0 : ℝ) < Dg := by norm_num [Dg]

lemma Eg_pos : (0 : ℝ) < Eg := by norm_num [Eg]

lemma toR_le_toR {a b : ℕ} : toR a ≤ toR b ↔ a ≤ b := by
  unfold toR
  rw [div_le_div_iff_of_pos_right Dg_pos]
  exact Nat.cast_le

lemma toR_nonneg (a : ℕ) : 0 ≤ toR a := div_nonneg (Nat.cast_nonneg _) Dg_pos.le

lemma toR_add (a b : ℕ) : toR (a + b) = toR a + toR b := by
  unfold toR; push_cast; ring

/-! ### Range-minimum tree over verified cells -/

/-- Leaves carry a grid interval `[lo, hi]`, a scaled bound `w`, and the record cell that
justifies it; nodes cache the minimum bound of their subtree. -/
inductive ST where
  | leaf (lo hi w : ℕ) (c : Cell)
  | node (lo hi mn : ℕ) (l r : ST)

namespace ST

def lo : ST → ℕ
  | leaf lo _ _ _ => lo
  | node lo _ _ _ _ => lo

def hi : ST → ℕ
  | leaf _ hi _ _ => hi
  | node _ hi _ _ _ => hi

def mn : ST → ℕ
  | leaf _ _ w _ => w
  | node _ _ mn _ _ => mn

def ok : ST → Bool
  | leaf lo hi w c =>
      c.ok && decide (c.L * (Dg : ℚ) ≤ (lo : ℚ)) && decide ((hi : ℚ) ≤ c.U * (Dg : ℚ))
        && decide ((w : ℚ) ≤ c.W * (Eg : ℚ))
  | node lo hi mn l r =>
      l.ok && r.ok && (l.hi == r.lo) && (lo == l.lo) && (hi == r.hi)
        && Nat.ble mn l.mn && Nat.ble mn r.mn

/-- Minimum bound over the cells meeting `[a, b]` (`BIG` when none does). -/
def q (t : ST) (a b : ℕ) : ℕ :=
  ST.rec (motive := fun _ => ℕ)
    (fun lo hi w _ => bif Nat.blt b lo || Nat.blt hi a then BIG else w)
    (fun lo hi mn _ _ ql qr =>
      bif Nat.blt b lo || Nat.blt hi a then BIG
      else bif Nat.ble a lo && Nat.ble hi b then mn else Nat.min ql qr)
    t

lemma q_leaf (lo hi w : ℕ) (c : Cell) (a b : ℕ) :
    (leaf lo hi w c).q a b = bif Nat.blt b lo || Nat.blt hi a then BIG else w := rfl

lemma q_node (lo hi mn : ℕ) (l r : ST) (a b : ℕ) :
    (node lo hi mn l r).q a b =
      bif Nat.blt b lo || Nat.blt hi a then BIG
      else bif Nat.ble a lo && Nat.ble hi b then mn else Nat.min (l.q a b) (r.q a b) := rfl

lemma leaf_bound {lo hi w : ℕ} {c : Cell} (h : (leaf lo hi w c).ok = true) (x : ℝ)
    (h1 : toR lo ≤ x) (h2 : x ≤ toR hi) : (w : ℝ) / Eg ≤ wfun x := by
  simp only [ok, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨hc, hL⟩, hU⟩, hW⟩ := h
  have hL' : (c.L : ℝ) * Dg ≤ lo := by exact_mod_cast hL
  have hU' : (hi : ℝ) ≤ c.U * Dg := by exact_mod_cast hU
  have hW' : (w : ℝ) ≤ c.W * Eg := by exact_mod_cast hW
  unfold toR at h1 h2
  rw [div_le_iff₀ Dg_pos] at h1
  rw [le_div_iff₀ Dg_pos] at h2
  have hx1 : (c.L : ℝ) ≤ x := by
    by_contra hcon; push Not at hcon; nlinarith [Dg_pos]
  have hx2 : x ≤ (c.U : ℝ) := by
    by_contra hcon; push Not at hcon; nlinarith [Dg_pos]
  have hcell := cell_sound c hc x hx1 hx2
  rw [div_le_iff₀ Eg_pos]
  nlinarith [Eg_pos]

theorem mn_sound : ∀ t : ST, t.ok = true → ∀ x : ℝ, toR t.lo ≤ x → x ≤ toR t.hi →
    (t.mn : ℝ) / Eg ≤ wfun x := by
  intro t
  induction t with
  | leaf lo hi w c => intro h x h1 h2; exact leaf_bound h x h1 h2
  | node a0 a1 a2 l r ihl ihr =>
    intro h x h1 h2
    simp only [ok, Bool.and_eq_true, beq_iff_eq, Nat.ble_eq] at h
    obtain ⟨⟨⟨⟨⟨⟨hl, hr⟩, hlr⟩, hlo⟩, hhi⟩, hml⟩, hmr⟩ := h
    simp only [ST.lo, ST.hi, ST.mn] at h1 h2 ⊢
    rcases le_total x (toR l.hi) with hx | hx
    · have := ihl hl x (hlo ▸ h1) hx
      have hm : (a2 : ℝ) ≤ l.mn := by exact_mod_cast hml
      calc (a2 : ℝ) / Eg ≤ l.mn / Eg := div_le_div_of_nonneg_right hm Eg_pos.le
        _ ≤ wfun x := this
    · have := ihr hr x (hlr ▸ hx) (hhi ▸ h2)
      have hm : (a2 : ℝ) ≤ r.mn := by exact_mod_cast hmr
      calc (a2 : ℝ) / Eg ≤ r.mn / Eg := div_le_div_of_nonneg_right hm Eg_pos.le
        _ ≤ wfun x := this

lemma not_out {a b lo hi : ℕ} {x : ℝ} (ha : toR a ≤ x) (hb : x ≤ toR b) (h1 : toR lo ≤ x)
    (h2 : x ≤ toR hi) : (Nat.blt b lo || Nat.blt hi a) = false := by
  have e1 : lo ≤ b := toR_le_toR.mp (h1.trans hb)
  have e2 : a ≤ hi := toR_le_toR.mp (ha.trans h2)
  have h3 : Nat.blt b lo = false := by rw [Bool.eq_false_iff, ne_eq, Nat.blt_eq]; omega
  have h4 : Nat.blt hi a = false := by rw [Bool.eq_false_iff, ne_eq, Nat.blt_eq]; omega
  rw [h3, h4]; rfl

theorem q_sound : ∀ t : ST, t.ok = true → ∀ (a b : ℕ) (x : ℝ), toR a ≤ x → x ≤ toR b →
    toR t.lo ≤ x → x ≤ toR t.hi → (t.q a b : ℝ) / Eg ≤ wfun x := by
  intro t
  induction t with
  | leaf lo hi w c =>
    intro h a b x ha hb h1 h2
    simp only [ST.lo, ST.hi] at h1 h2
    rw [q_leaf, not_out ha hb h1 h2]
    exact leaf_bound h x h1 h2
  | node lo hi mn l r ihl ihr =>
    intro h a b x ha hb h1 h2
    have h' := h
    simp only [ok, Bool.and_eq_true, beq_iff_eq, Nat.ble_eq] at h'
    obtain ⟨⟨⟨⟨⟨⟨hl, hr⟩, hlr⟩, hlo⟩, hhi⟩, hml⟩, hmr⟩ := h'
    simp only [ST.lo, ST.hi] at h1 h2
    rw [q_node, not_out ha hb h1 h2, cond_false]
    cases hin : (Nat.ble a lo && Nat.ble hi b)
    · rw [cond_false]
      rcases le_total x (toR l.hi) with hx | hx
      · have := ihl hl a b x ha hb (hlo ▸ h1) hx
        calc ((Nat.min (l.q a b) (r.q a b) : ℕ) : ℝ) / Eg ≤ (l.q a b : ℝ) / Eg :=
              div_le_div_of_nonneg_right (by exact_mod_cast Nat.min_le_left _ _) Eg_pos.le
          _ ≤ wfun x := this
      · have := ihr hr a b x ha hb (hlr ▸ hx) (hhi ▸ h2)
        calc ((Nat.min (l.q a b) (r.q a b) : ℕ) : ℝ) / Eg ≤ (r.q a b : ℝ) / Eg :=
              div_le_div_of_nonneg_right (by exact_mod_cast Nat.min_le_right _ _) Eg_pos.le
          _ ≤ wfun x := this
    · rw [cond_true]
      exact mn_sound (node lo hi mn l r) h x h1 h2

/-- Range query guarded by the table's domain; `0` outside it. -/
def qq (t : ST) (a b : ℕ) : ℕ := bif Nat.ble t.lo a && Nat.ble b t.hi then t.q a b else 0

theorem qq_sound (t : ST) (h : t.ok = true) (a b : ℕ) (x : ℝ) (ha : toR a ≤ x)
    (hb : x ≤ toR b) : (qq t a b : ℝ) / Eg ≤ wfun x := by
  unfold qq
  cases hin : (Nat.ble t.lo a && Nat.ble b t.hi)
  · simp only [cond_false, Nat.cast_zero, zero_div]; exact ThreePoint.wfun_nonneg x
  · simp only [cond_true]
    simp only [Bool.and_eq_true, Nat.ble_eq] at hin
    exact q_sound t h a b x ha hb ((toR_le_toR.mpr hin.1).trans ha) (hb.trans (toR_le_toR.mpr hin.2))

end ST

/-! ### Sound lower-bound oracles -/

/-- `lb a b / U` bounds `wfun` below on `[toR a, toR b]`. -/
def LBSound (U : ℕ) (lb : ℕ → ℕ → ℕ) : Prop :=
  ∀ a b (x : ℝ), toR a ≤ x → x ≤ toR b → (lb a b : ℝ) / U ≤ wfun x

theorem ST.qq_lbsound (t : ST) (h : t.ok = true) : LBSound Eg t.qq :=
  fun a b x ha hb => ST.qq_sound t h a b x ha hb

/-! ### Boxes and the leaf test -/

structure B5 where
  (xl xu yl yu zl zu ul uu : ℕ)
  deriving DecidableEq

def B5.mem (b : B5) (x y z u : ℝ) : Prop :=
  toR b.xl ≤ x ∧ x ≤ toR b.xu ∧ toR b.yl ≤ y ∧ y ≤ toR b.yu ∧ toR b.zl ≤ z ∧ z ≤ toR b.zu
    ∧ toR b.ul ≤ u ∧ u ≤ toR b.uu

/-- The scaled leaf inequality `C ≤ A·Σlo + B·T`, with an early exit after each group of terms. -/
def leafI (lb : ℕ → ℕ → ℕ) (A B C : ℕ) (b : B5) : Bool :=
  let s0 := A * (b.xl + b.yl + b.zl + b.ul)
  let t4 := 12 * lb (b.xl + b.yl + b.zl + b.ul) (b.xu + b.yu + b.zu + b.uu)
  let t3 := 6 * (lb (b.xl + b.yl + b.zl) (b.xu + b.yu + b.zu)
    + lb (b.yl + b.zl + b.ul) (b.yu + b.zu + b.uu))
  let t2 := 4 * (lb (b.xl + b.yl) (b.xu + b.yu) + lb (b.yl + b.zl) (b.yu + b.zu)
    + lb (b.zl + b.ul) (b.zu + b.uu))
  let t1 := 3 * (lb b.xl b.xu + lb b.yl b.yu + lb b.zl b.zu + lb b.ul b.uu)
  Nat.ble C s0 || Nat.ble C (s0 + B * t4) || Nat.ble C (s0 + B * (t4 + t3))
    || Nat.ble C (s0 + B * (t4 + t3 + t2)) || Nat.ble C (s0 + B * (t4 + t3 + t2 + t1))

lemma leafI_full {lb : ℕ → ℕ → ℕ} {A B C : ℕ} {b : B5} (h : leafI lb A B C b = true) :
    C ≤ A * (b.xl + b.yl + b.zl + b.ul)
      + B * (12 * lb (b.xl + b.yl + b.zl + b.ul) (b.xu + b.yu + b.zu + b.uu)
        + 6 * (lb (b.xl + b.yl + b.zl) (b.xu + b.yu + b.zu)
          + lb (b.yl + b.zl + b.ul) (b.yu + b.zu + b.uu))
        + 4 * (lb (b.xl + b.yl) (b.xu + b.yu) + lb (b.yl + b.zl) (b.yu + b.zu)
          + lb (b.zl + b.ul) (b.zu + b.uu))
        + 3 * (lb b.xl b.xu + lb b.yl b.yu + lb b.zl b.zu + lb b.ul b.uu)) := by
  simp only [leafI, Bool.or_eq_true, Nat.ble_eq] at h
  rcases h with (((h | h) | h) | h) | h
  · exact h.trans (Nat.le_add_right _ _)
  all_goals exact h.trans (Nat.add_le_add_left (Nat.mul_le_mul_left _ (by omega)) _)

/-- Each table term bounds its `wfun` term, scaled. -/
lemma term_le {U : ℕ} (hU : 0 < U) {lb : ℕ → ℕ → ℕ} (hlb : LBSound U lb) (a b : ℕ) (s : ℝ)
    (ha : toR a ≤ s) (hb : s ≤ toR b) : (lb a b : ℝ) ≤ U * wfun s := by
  have := hlb a b s ha hb
  have hU' : (0 : ℝ) < U := by exact_mod_cast hU
  rw [div_le_iff₀ hU'] at this
  linarith

theorem leaf_sound {U : ℕ} (hU : 0 < U) {lb : ℕ → ℕ → ℕ} (hlb : LBSound U lb)
    (cn cd p A B C : ℕ) (hcd : 0 < cd) (hp : 0 < p)
    (hA : A = 6 * U * cd) (hB : B = p * Dg * cd) (hC : C = 6 * cn * p * Dg * U)
    (b : B5) (h : leafI lb A B C b = true) (x y z u : ℝ) (hm : b.mem x y z u) :
    ((cn : ℝ) / cd) ≤ G5 (p : ℚ) x y z u := by
  obtain ⟨hx1, hx2, hy1, hy2, hz1, hz2, hu1, hu2⟩ := hm
  have hf := leafI_full h
  have w1 := term_le hU hlb _ _ x hx1 hx2
  have w2 := term_le hU hlb _ _ y hy1 hy2
  have w3 := term_le hU hlb _ _ z hz1 hz2
  have w4 := term_le hU hlb _ _ u hu1 hu2
  have w5 := term_le hU hlb (b.xl + b.yl) (b.xu + b.yu) (x + y)
    (by rw [toR_add]; linarith) (by rw [toR_add]; linarith)
  have w6 := term_le hU hlb (b.yl + b.zl) (b.yu + b.zu) (y + z)
    (by rw [toR_add]; linarith) (by rw [toR_add]; linarith)
  have w7 := term_le hU hlb (b.zl + b.ul) (b.zu + b.uu) (z + u)
    (by rw [toR_add]; linarith) (by rw [toR_add]; linarith)
  have w8 := term_le hU hlb (b.xl + b.yl + b.zl) (b.xu + b.yu + b.zu) (x + y + z)
    (by rw [toR_add, toR_add]; linarith) (by rw [toR_add, toR_add]; linarith)
  have w9 := term_le hU hlb (b.yl + b.zl + b.ul) (b.yu + b.zu + b.uu) (y + z + u)
    (by rw [toR_add, toR_add]; linarith) (by rw [toR_add, toR_add]; linarith)
  have w10 := term_le hU hlb (b.xl + b.yl + b.zl + b.ul) (b.xu + b.yu + b.zu + b.uu) (x + y + z + u)
    (by rw [toR_add, toR_add, toR_add]; linarith) (by rw [toR_add, toR_add, toR_add]; linarith)
  have hlo : ((b.xl : ℝ) + b.yl + b.zl + b.ul) ≤ Dg * (x + y + z + u) := by
    have := add_le_add (add_le_add (add_le_add hx1 hy1) hz1) hu1
    rw [← toR_add, ← toR_add, ← toR_add] at this
    unfold toR at this
    rw [div_le_iff₀ Dg_pos] at this
    push_cast at this
    linarith
  have hf' : (C : ℝ) ≤ A * ((b.xl + b.yl + b.zl + b.ul : ℕ) : ℝ)
      + B * (12 * (lb (b.xl + b.yl + b.zl + b.ul) (b.xu + b.yu + b.zu + b.uu) : ℝ)
        + 6 * ((lb (b.xl + b.yl + b.zl) (b.xu + b.yu + b.zu) : ℝ)
          + lb (b.yl + b.zl + b.ul) (b.yu + b.zu + b.uu))
        + 4 * ((lb (b.xl + b.yl) (b.xu + b.yu) : ℝ) + lb (b.yl + b.zl) (b.yu + b.zu)
          + lb (b.zl + b.ul) (b.zu + b.uu))
        + 3 * ((lb b.xl b.xu : ℝ) + lb b.yl b.yu + lb b.zl b.zu + lb b.ul b.uu)) := by
    exact_mod_cast hf
  subst hA hB hC
  push_cast at hf'
  have hcd' : (0 : ℝ) < cd := by exact_mod_cast hcd
  have hp' : (0 : ℝ) < p := by exact_mod_cast hp
  have hK : (0 : ℝ) < 6 * cd * p * Dg * U := by
    have := Dg_pos; have hU' : (0:ℝ) < U := (by exact_mod_cast hU); positivity
  have hG : (6 * cd * p * Dg * U : ℝ) * G5 (p : ℚ) x y z u
      = 6 * U * cd * (Dg * (x + y + z + u))
        + p * Dg * cd * (12 * (U * wfun (x + y + z + u))
          + 6 * (U * wfun (x + y + z) + U * wfun (y + z + u))
          + 4 * (U * wfun (x + y) + U * wfun (y + z) + U * wfun (z + u))
          + 3 * (U * wfun x + U * wfun y + U * wfun z + U * wfun u)) := by
    unfold G5
    push_cast
    field_simp
    ring
  have hB0 : (0 : ℝ) ≤ p * Dg * cd := by have := Dg_pos; positivity
  have hA0 : (0 : ℝ) ≤ 6 * U * cd := by positivity
  have key : (6 * cn * p * Dg * U : ℝ) ≤ (6 * cd * p * Dg * U) * G5 (p : ℚ) x y z u := by
    rw [hG]
    refine hf'.trans (add_le_add (mul_le_mul_of_nonneg_left hlo hA0)
      (mul_le_mul_of_nonneg_left ?_ hB0))
    linarith
  rw [div_le_iff₀ hcd']
  have : (6 * cn * p * Dg * U : ℝ) = (6 * p * Dg * U) * cn := by ring
  have h2 : (6 * cd * p * Dg * U : ℝ) * G5 (p : ℚ) x y z u
      = (6 * p * Dg * U) * (G5 (p : ℚ) x y z u * cd) := by ring
  rw [this, h2] at key
  have h6 : (0 : ℝ) < 6 * p * Dg * U := by have := Dg_pos; have hU' : (0:ℝ) < U := (by exact_mod_cast hU); positivity
  exact le_of_mul_le_mul_left key h6

/-! ### Bisection walk -/

def B5.cut (b : B5) : ℕ :=
  let w0 := b.xu - b.xl
  let w1 := 2 * (b.yu - b.yl)
  let w2 := 2 * (b.zu - b.zl)
  let w3 := b.uu - b.ul
  bif Nat.ble w1 w0 && Nat.ble w2 w0 && Nat.ble w3 w0 then 0
  else bif Nat.ble w2 w1 && Nat.ble w3 w1 then 1
  else bif Nat.ble w3 w2 then 2 else 3

def B5.lo (b : B5) : B5 :=
  Nat.casesOn (motive := fun _ => B5) b.cut { b with xu := (b.xl + b.xu) / 2 } fun k =>
  Nat.casesOn (motive := fun _ => B5) k { b with yu := (b.yl + b.yu) / 2 } fun k =>
  Nat.casesOn (motive := fun _ => B5) k { b with zu := (b.zl + b.zu) / 2 } fun _ =>
  { b with uu := (b.ul + b.uu) / 2 }

def B5.hi (b : B5) : B5 :=
  Nat.casesOn (motive := fun _ => B5) b.cut { b with xl := (b.xl + b.xu) / 2 } fun k =>
  Nat.casesOn (motive := fun _ => B5) k { b with yl := (b.yl + b.yu) / 2 } fun k =>
  Nat.casesOn (motive := fun _ => B5) k { b with zl := (b.zl + b.zu) / 2 } fun _ =>
  { b with ul := (b.ul + b.uu) / 2 }

lemma mem_cut (b : B5) (x y z u : ℝ) (h : b.mem x y z u) : b.lo.mem x y z u ∨ b.hi.mem x y z u := by
  obtain ⟨hx1, hx2, hy1, hy2, hz1, hz2, hu1, hu2⟩ := h
  unfold B5.lo B5.hi
  rcases b.cut with _ | _ | _ | _
  · rcases le_total x (toR ((b.xl + b.xu) / 2)) with hm | hm
    · left; exact ⟨hx1, hm, hy1, hy2, hz1, hz2, hu1, hu2⟩
    · right; exact ⟨hm, hx2, hy1, hy2, hz1, hz2, hu1, hu2⟩
  · rcases le_total y (toR ((b.yl + b.yu) / 2)) with hm | hm
    · left; exact ⟨hx1, hx2, hy1, hm, hz1, hz2, hu1, hu2⟩
    · right; exact ⟨hx1, hx2, hm, hy2, hz1, hz2, hu1, hu2⟩
  · rcases le_total z (toR ((b.zl + b.zu) / 2)) with hm | hm
    · left; exact ⟨hx1, hx2, hy1, hy2, hz1, hm, hu1, hu2⟩
    · right; exact ⟨hx1, hx2, hy1, hy2, hm, hz2, hu1, hu2⟩
  · rcases le_total u (toR ((b.ul + b.uu) / 2)) with hm | hm
    · left; exact ⟨hx1, hx2, hy1, hy2, hz1, hz2, hu1, hm⟩
    · right; exact ⟨hx1, hx2, hy1, hy2, hz1, hz2, hm, hu2⟩

/-- Evaluate `a` to a numeral before continuing (the kernel is call-by-name). -/
def forceN (a : ℕ) (k : ℕ → ℕ) : ℕ :=
  Nat.casesOn (motive := fun _ => ℕ) a (k 0) (fun n => k (Nat.succ n))

/-- Rebuild a box from its evaluated coordinates. -/
def forceB (b : B5) (k : B5 → ℕ) : ℕ :=
  forceN b.xl fun xl => forceN b.xu fun xu => forceN b.yl fun yl => forceN b.yu fun yu =>
  forceN b.zl fun zl => forceN b.zu fun zu => forceN b.ul fun ul => forceN b.uu fun uu =>
  k ⟨xl, xu, yl, yu, zl, zu, ul, uu⟩

/-- Walk the bit-encoded tree from bit `pos` (`1` = split, `0` = leaf); the position after the
subtree, or `0` if some leaf fails or fuel runs out. Positions start at `1`. -/
def walkI (lb : ℕ → ℕ → ℕ) (A B C bits : ℕ) (fuel : ℕ) : ℕ → B5 → ℕ :=
  Nat.rec (motive := fun _ => ℕ → B5 → ℕ)
    (fun _ _ => 0)
    (fun _ ih pos b0 => forceB b0 fun b =>
      bif bits.testBit pos then
        (let p' := ih (pos + 1) b.lo
         bif p' == 0 then 0 else ih p' b.hi)
      else bif leafI lb A B C b then pos + 1 else 0)
    fuel

lemma forceN_eq (a : ℕ) (k : ℕ → ℕ) : forceN a k = k a := by cases a <;> rfl

lemma forceB_eq (b : B5) (k : B5 → ℕ) : forceB b k = k b := by
  obtain ⟨xl, xu, yl, yu, zl, zu, ul, uu⟩ := b
  simp only [forceB, forceN_eq]

lemma walkI_succ (lb : ℕ → ℕ → ℕ) (A B C bits fuel pos : ℕ) (b : B5) :
    walkI lb A B C bits (fuel + 1) pos b =
      bif bits.testBit pos then
        (bif walkI lb A B C bits fuel (pos + 1) b.lo == 0 then 0
         else walkI lb A B C bits fuel (walkI lb A B C bits fuel (pos + 1) b.lo) b.hi)
      else bif leafI lb A B C b then pos + 1 else 0 := by
  have h : walkI lb A B C bits (fuel + 1) pos b = forceB b (fun b =>
      bif bits.testBit pos then
        (bif walkI lb A B C bits fuel (pos + 1) b.lo == 0 then 0
         else walkI lb A B C bits fuel (walkI lb A B C bits fuel (pos + 1) b.lo) b.hi)
      else bif leafI lb A B C b then pos + 1 else 0) := rfl
  rw [h, forceB_eq]

/-- A split node's walk from its children's walks (to chunk the kernel checks). -/
lemma walkI_split (lb : ℕ → ℕ → ℕ) (A B C bits fuel pos p1 p2 : ℕ) (b lo hi : B5)
    (hbit : bits.testBit pos = true) (hlo : b.lo = lo) (hhi : b.hi = hi)
    (h1 : walkI lb A B C bits fuel (pos + 1) lo = p1) (hp1 : p1 ≠ 0)
    (h2 : walkI lb A B C bits fuel p1 hi = p2) :
    walkI lb A B C bits (fuel + 1) pos b = p2 := by
  rw [walkI_succ, hbit, cond_true, hlo, hhi, h1]
  have : (p1 == 0) = false := by simpa using hp1
  rw [this, cond_false, h2]

theorem walk_sound {U : ℕ} (hU : 0 < U) {lb : ℕ → ℕ → ℕ} (hlb : LBSound U lb)
    (cn cd p A B C : ℕ) (hcd : 0 < cd) (hp : 0 < p)
    (hA : A = 6 * U * cd) (hB : B = p * Dg * cd) (hC : C = 6 * cn * p * Dg * U) (bits : ℕ) :
    ∀ (fuel pos : ℕ) (b : B5), walkI lb A B C bits fuel pos b ≠ 0 →
      ∀ x y z u : ℝ, b.mem x y z u → ((cn : ℝ) / cd) ≤ G5 (p : ℚ) x y z u := by
  intro fuel
  induction fuel with
  | zero => intro pos b h; exact absurd rfl h
  | succ fuel ih =>
    intro pos b h x y z u hm
    rw [walkI_succ] at h
    cases hbit : bits.testBit pos
    · rw [hbit, cond_false] at h
      cases hl : leafI lb A B C b
      · rw [hl, cond_false] at h; exact absurd rfl h
      · exact leaf_sound hU hlb cn cd p A B C hcd hp hA hB hC b hl x y z u hm
    · rw [hbit, cond_true] at h
      cases h0 : (walkI lb A B C bits fuel (pos + 1) b.lo == 0)
      · rw [h0, cond_false] at h
        have hlo : walkI lb A B C bits fuel (pos + 1) b.lo ≠ 0 := by
          simpa [beq_iff_eq] using h0
        rcases mem_cut b x y z u hm with hm' | hm'
        · exact ih (pos + 1) b.lo hlo x y z u hm'
        · exact ih _ b.hi h x y z u hm'
      · rw [h0, cond_true] at h; exact absurd rfl h

/-- The inequality holds on every point of the box. -/
def Covered (cn cd p : ℕ) (b : B5) : Prop :=
  ∀ x y z u : ℝ, b.mem x y z u → ((cn : ℝ) / cd) ≤ G5 (p : ℚ) x y z u

theorem covered_of_walk {U : ℕ} (hU : 0 < U) {lb : ℕ → ℕ → ℕ} (hlb : LBSound U lb)
    (cn cd p A B C : ℕ) (hcd : 0 < cd) (hp : 0 < p)
    (hA : A = 6 * U * cd) (hB : B = p * Dg * cd) (hC : C = 6 * cn * p * Dg * U)
    (bits fuel pos : ℕ) (b : B5) (h : walkI lb A B C bits fuel pos b ≠ 0) : Covered cn cd p b :=
  fun x y z u hm => walk_sound hU hlb cn cd p A B C hcd hp hA hB hC bits fuel pos b h x y z u hm

theorem covered_split {cn cd p : ℕ} {b lo hi : B5} (hlo : b.lo = lo) (hhi : b.hi = hi)
    (h1 : Covered cn cd p lo) (h2 : Covered cn cd p hi) : Covered cn cd p b := by
  intro x y z u hm
  rcases mem_cut b x y z u hm with h | h
  · rw [hlo] at h; exact h1 x y z u h
  · rw [hhi] at h; exact h2 x y z u h

/-! ### Cover of `[1/2, S]` and the root boxes -/

/-- Contiguous segments `(a, b, clear)` from `pos` to at least `SD`; a clear segment's table
bound reaches `thr / cd`. -/
def coverI (lb : ℕ → ℕ → ℕ) (thr cd : ℕ) : ℕ → ℕ → List (ℕ × ℕ × Bool) → Bool
  | pos, SD, [] => Nat.ble SD pos
  | pos, SD, (a, b, cl) :: rest =>
      (a == pos) && Nat.ble a b && (!cl || Nat.ble thr (cd * lb a b)) && coverI lb thr cd b SD rest

theorem cover_sound (lb : ℕ → ℕ → ℕ) (thr cd : ℕ) :
    ∀ (cov : List (ℕ × ℕ × Bool)) (pos SD : ℕ), coverI lb thr cd pos SD cov = true →
      ∀ v : ℝ, toR pos ≤ v → v < toR SD →
        ∃ s ∈ cov, toR s.1 ≤ v ∧ v ≤ toR s.2.1 ∧ (s.2.2 = true → thr ≤ cd * lb s.1 s.2.1) := by
  intro cov
  induction cov with
  | nil =>
    intro pos SD h v h1 h2
    simp only [coverI, Nat.ble_eq] at h
    exact absurd (h2.trans_le (toR_le_toR.mpr h)) (not_lt.mpr h1)
  | cons s rest ih =>
    obtain ⟨a, b, cl⟩ := s
    intro pos SD h v h1 h2
    simp only [coverI, Bool.and_eq_true, beq_iff_eq, Nat.ble_eq, Bool.or_eq_true,
      Bool.not_eq_true'] at h
    obtain ⟨⟨⟨ha, hab⟩, hcl⟩, hrest⟩ := h
    rcases le_total v (toR b) with hv | hv
    · refine ⟨(a, b, cl), List.mem_cons_self, ha ▸ h1, hv, fun hc => ?_⟩
      rcases hcl with hcl | hcl
      · rw [hcl] at hc; exact absurd hc Bool.false_ne_true
      · exact hcl
    · obtain ⟨s', hs', h'⟩ := ih b SD hrest v hv h2
      exact ⟨s', List.mem_cons_of_mem _ hs', h'⟩

def badOf (cov : List (ℕ × ℕ × Bool)) : List (ℕ × ℕ) :=
  cov.filterMap fun s => if s.2.2 then none else some (s.1, s.2.1)

lemma badOf_mem {cov : List (ℕ × ℕ × Bool)} {s : ℕ × ℕ × Bool} (hs : s ∈ cov)
    (he : s.2.2 = false) : (s.1, s.2.1) ∈ badOf cov := by
  unfold badOf
  rw [List.mem_filterMap]
  exact ⟨s, hs, by simp [he]⟩

def boxOf (bad : List (ℕ × ℕ)) (i j k l : ℕ) : B5 :=
  ⟨(bad.getD i (0, 0)).1, (bad.getD i (0, 0)).2, (bad.getD j (0, 0)).1, (bad.getD j (0, 0)).2,
    (bad.getD k (0, 0)).1, (bad.getD k (0, 0)).2, (bad.getD l (0, 0)).1, (bad.getD l (0, 0)).2⟩

lemma G5_mirror (p : ℚ) (x y z u : ℝ) : G5 p x y z u = G5 p u z y x := by
  unfold G5
  rw [show u + z + y + x = x + y + z + u by ring, show u + z + y = y + z + u by ring,
    show z + y + x = x + y + z by ring, show u + z = z + u by ring, show z + y = y + z by ring,
    show y + x = x + y by ring]
  ring

/-- Root tuples covered directly; the rest follow by mirror symmetry. -/
def Canon (i j k l : ℕ) : Prop := i < l ∨ (i = l ∧ j ≤ k)

theorem five_point_icheck {U : ℕ} (hU : 0 < U) {lb : ℕ → ℕ → ℕ} (hlb : LBSound U lb)
    (cov : List (ℕ × ℕ × Bool))
    (cn cd p SD : ℕ) (hcd : 0 < cd) (hp : 0 < p)
    (hS : cn * p * Dg ≤ cd * SD) (hwin : 200 * cn ≤ 19 * cd)
    (hcov : coverI lb (2 * cn * U) cd (Dg / 2) SD cov = true)
    (hroot : ∀ i j k l, i < (badOf cov).length → j < (badOf cov).length →
      k < (badOf cov).length → l < (badOf cov).length → Canon i j k l →
      Covered cn cd p (boxOf (badOf cov) i j k l)):
    ∀ x y z u : ℝ, 0 ≤ x → 0 ≤ y → 0 ≤ z → 0 ≤ u → ((cn : ℝ) / cd) ≤ G5 (p : ℚ) x y z u := by
  have hw := fun v : ℝ => ThreePoint.wfun_nonneg v
  have hcd' : (0 : ℝ) < cd := by exact_mod_cast hcd
  have hp' : (0 : ℝ) < p := by exact_mod_cast hp
  have hc0 : (0 : ℝ) ≤ (cn : ℝ) / cd := by positivity
  -- the generic case: every coordinate lies in a bad segment, or one term alone suffices
  have hsum : ∀ x y z u : ℝ, 0 ≤ x → 0 ≤ y → 0 ≤ z → 0 ≤ u → toR SD ≤ x + y + z + u →
      ((cn : ℝ) / cd) ≤ G5 (p : ℚ) x y z u := by
    intro x y z u hx hy hz hu hs
    have hS' : (cn : ℝ) * p * Dg ≤ cd * SD := by exact_mod_cast hS
    have : (cn : ℝ) / cd ≤ (1 / (p : ℝ)) * (x + y + z + u) := by
      unfold toR at hs
      rw [div_le_iff₀ Dg_pos] at hs
      rw [div_le_iff₀ hcd', one_div, inv_mul_eq_div, div_mul_eq_mul_div, le_div_iff₀ hp']
      nlinarith [Dg_pos]
    unfold G5
    push_cast
    linarith [hw x, hw y, hw z, hw u, hw (x + y), hw (y + z), hw (z + u), hw (x + y + z),
      hw (y + z + u), hw (x + y + z + u)]
  set bad := badOf cov with hbad
  have key : ∀ v : ℝ, 0 ≤ v → v < toR SD →
      (cn : ℝ) / cd ≤ 1/2 * wfun v ∨ ∃ i, i < bad.length ∧
        toR (bad.getD i (0, 0)).1 ≤ v ∧ v ≤ toR (bad.getD i (0, 0)).2 := by
    intro v hv0 hvS
    rcases le_total v (1/2 : ℝ) with hv | hv
    · left
      have hwv := wfun_window v hv0 hv
      have : (cn : ℝ) / cd ≤ 19 / 200 := by
        rw [div_le_iff₀ hcd']
        have : (200 * cn : ℝ) ≤ 19 * cd := by exact_mod_cast hwin
        linarith
      linarith
    · have hpos : toR (Dg / 2) = 1 / 2 := by norm_num [toR, Dg]
      obtain ⟨s, hs, h1, h2, hc⟩ := cover_sound lb _ cd cov _ SD hcov v (hpos ▸ hv) hvS
      cases he : s.2.2
      · right
        obtain ⟨i, hi, hsi⟩ := List.mem_iff_getElem.mp (badOf_mem hs he)
        refine ⟨i, hi, ?_, ?_⟩
        · rw [List.getD_eq_getElem _ _ hi, hsi]; exact h1
        · rw [List.getD_eq_getElem _ _ hi, hsi]; exact h2
      · left
        have hq := hc he
        have hq' : (2 * cn * U : ℝ) ≤ cd * lb s.1 s.2.1 := by exact_mod_cast hq
        have hU' : (0 : ℝ) < U := by exact_mod_cast hU
        have := term_le hU hlb s.1 s.2.1 v h1 h2
        rw [div_le_iff₀ hcd']
        nlinarith
  have hbox : ∀ i j k l, i < bad.length → j < bad.length → k < bad.length → l < bad.length →
      ∀ x y z u : ℝ, (boxOf bad i j k l).mem x y z u → ((cn : ℝ) / cd) ≤ G5 (p : ℚ) x y z u := by
    intro i j k l hi hj hk hl x y z u hm
    by_cases hcan : Canon i j k l
    · exact hroot i j k l hi hj hk hl hcan x y z u hm
    · have hcan' : Canon l k j i := by
        unfold Canon at hcan ⊢; push Not at hcan; omega
      rw [G5_mirror]
      obtain ⟨hx1, hx2, hy1, hy2, hz1, hz2, hu1, hu2⟩ := hm
      exact hroot l k j i hl hk hj hi hcan' u z y x ⟨hu1, hu2, hz1, hz2, hy1, hy2, hx1, hx2⟩
  intro x y z u hx hy hz hu
  by_cases hs : toR SD ≤ x + y + z + u
  · exact hsum x y z u hx hy hz hu hs
  push Not at hs
  have hxS : x < toR SD := by linarith
  have hyS : y < toR SD := by linarith
  have hzS : z < toR SD := by linarith
  have huS : u < toR SD := by linarith
  have hG : ∀ v : ℝ, (cn : ℝ) / cd ≤ 1/2 * wfun v → 1/2 * wfun v ≤ G5 (p : ℚ) x y z u →
      (cn : ℝ) / cd ≤ G5 (p : ℚ) x y z u := fun _ h1 h2 => h1.trans h2
  have hlin : (0 : ℝ) ≤ (1 / (p : ℝ)) * (x + y + z + u) := by positivity
  rcases key x hx hxS with hc | ⟨i, hi, hi1, hi2⟩
  · refine hc.trans ?_; unfold G5; push_cast
    linarith [hw y, hw z, hw u, hw (x + y), hw (y + z), hw (z + u), hw (x + y + z),
      hw (y + z + u), hw (x + y + z + u)]
  rcases key y hy hyS with hc | ⟨j, hj, hj1, hj2⟩
  · refine hc.trans ?_; unfold G5; push_cast
    linarith [hw x, hw z, hw u, hw (x + y), hw (y + z), hw (z + u), hw (x + y + z),
      hw (y + z + u), hw (x + y + z + u)]
  rcases key z hz hzS with hc | ⟨k, hk, hk1, hk2⟩
  · refine hc.trans ?_; unfold G5; push_cast
    linarith [hw x, hw y, hw u, hw (x + y), hw (y + z), hw (z + u), hw (x + y + z),
      hw (y + z + u), hw (x + y + z + u)]
  rcases key u hu huS with hc | ⟨l, hl, hl1, hl2⟩
  · refine hc.trans ?_; unfold G5; push_cast
    linarith [hw x, hw y, hw z, hw (x + y), hw (y + z), hw (z + u), hw (x + y + z),
      hw (y + z + u), hw (x + y + z + u)]
  exact hbox i j k l hi hj hk hl x y z u ⟨hi1, hi2, hj1, hj2, hk1, hk2, hl1, hl2⟩

end Riemann.ICheck

end

/-! ###### module CellI ###### -/

section

/-!
# Integer cell verification

`okI` recomputes the record's `Cell.ok` exactly: every quantity the record rounds to the
`10⁻¹²` grid is carried as its numerator over `S = 10¹²`. Cell endpoints are grid coordinates
over `G = 2³²` and the bound `W` is a numerator over `E = 10¹³`. The heavy arithmetic (Taylor
polynomials, products, rounding divisions) runs on naturals with direct `Nat` primitives, which
the kernel evaluates natively; integers appear only in the few signed steps.
-/

namespace Riemann.CellI

def S : ℕ := 1000000000000
def SS : ℕ := 1000000000000000000000000
def G : ℕ := 4294967296
def H31 : ℕ := 2147483648
def E : ℕ := 10000000000000
def PG : ℕ := 429496729600000000000000000000
def PLOS : ℕ := 314159265358979323846000000000000
def PHIS : ℕ := 314159265358979323847000000000000
def GLO2 : ℕ := 16549985814
def GHI2 : ℕ := 16549986036
def G10 : ℕ := 10000000000
def ERRD : ℕ := 5748019200
def KC0 : ℕ := 3628800 * SS ^ 5
def KC1 : ℕ := 1814400 * SS ^ 4
def KC2 : ℕ := 151200 * SS ^ 3
def KC3 : ℕ := 5040 * SS ^ 2
def KC4 : ℕ := 90 * SS
def KS0 : ℕ := 39916800 * SS ^ 5
def KS1 : ℕ := 6652800 * SS ^ 4
def KS2 : ℕ := 332640 * SS ^ 3
def KS3 : ℕ := 7920 * SS ^ 2
def KS4 : ℕ := 110 * SS
def D10 : ℕ := S ^ 10 * 3628800
def D11 : ℕ := S ^ 11 * 39916800
def E10 : ℕ := 13 * D10
def E11 : ℕ := 13 * D11
def D10E : ℕ := D10 * ERRD
def D11E : ℕ := D11 * ERRD

/-- `⌈a / d⌉`. -/
def cdiv (a d : ℕ) : ℕ := (a + (d - 1)) / d

/-- Horner forms of `taylorCosQ (T/S) · S¹⁰ · 10!` and `taylorSinQ (T/S) · S¹¹ · 11!` over
`s = T²`; every truncated subtraction is exact for `s ≤ S²`. -/
def cosH (s : ℕ) : ℕ := KC0 - s * (KC1 - s * (KC2 - s * (KC3 - s * (KC4 - s))))

def sinH (s : ℕ) : ℕ := KS0 - s * (KS1 - s * (KS2 - s * (KS3 - s * (KS4 - s))))

def cosN (T : ℕ) : ℕ := cosH (T * T)
def sinN (T : ℕ) : ℕ := T * sinH (T * T)

/-- `⌊(a − b)·S / d⌋` for naturals `a, b`, as an integer. -/
def floorSub (a b d : ℕ) : ℤ :=
  bif Nat.ble b a then Int.ofNat ((a - b) * S / d) else Int.neg (Int.ofNat (cdiv ((b - a) * S) d))

def rloN (Lg Ug k : ℕ) (side : Bool) : ℕ := bif side then Lg - k * H31 else k * H31 - Ug
def rhiN (Lg Ug k : ℕ) (side : Bool) : ℕ := bif side then Ug - k * H31 else k * H31 - Lg
def rloOk (Lg Ug k : ℕ) (side : Bool) : Bool :=
  bif side then Nat.ble (k * H31) Lg else Nat.ble Ug (k * H31)

def tlN (R : ℕ) : ℕ := PLOS * R / PG
def tuN (R : ℕ) : ℕ := cdiv (PHIS * R) PG
def ci1N (TU : ℕ) : ℕ := (cosN TU * ERRD - E10) * S / D10E
def ci2N (TL : ℕ) : ℕ := cdiv ((cosN TL * ERRD + E10) * S) D10E
def si1Z (TL : ℕ) : ℤ := floorSub (sinN TL * ERRD) E11 D11E
def si2N (TU : ℕ) : ℕ := cdiv ((sinN TU * ERRD + E11) * S) D11E
def blN (Lg : ℕ) : ℕ := PLOS * Lg / PG
def buN (Ug : ℕ) : ℕ := cdiv (PHIS * Ug) PG
def p2lN (BL : ℕ) : ℕ := GLO2 * BL / G10
def p2uN (BU : ℕ) : ℕ := cdiv (GHI2 * BU) G10
def dhiN (BU : ℕ) : ℕ := cdiv (2 * (BU * BU) - SS) S

/-- The signed steps, mirroring the record's `CX`, `SX`, `TLO`, `THI`, `NLO`. -/
def imulZI (e : ℤ) (I : ℤ × ℤ) : ℤ × ℤ := if 0 ≤ e then (e * I.1, e * I.2) else (e * I.2, e * I.1)
def iaddI (I J : ℤ × ℤ) : ℤ × ℤ := (I.1 + J.1, I.2 + J.2)
def isubI (I J : ℤ × ℤ) : ℤ × ℤ := (I.1 - J.2, I.2 - J.1)

def cxI (k : ℕ) (side : Bool) (CI SI : ℤ × ℤ) : ℤ × ℤ :=
  if side then isubI (imulZI (Zeta23Ext.Bridge.ThreePoint.csA k).1 CI)
    (imulZI (Zeta23Ext.Bridge.ThreePoint.csA k).2 SI)
  else iaddI (imulZI (Zeta23Ext.Bridge.ThreePoint.csA k).1 CI)
    (imulZI (Zeta23Ext.Bridge.ThreePoint.csA k).2 SI)

def sxI (k : ℕ) (side : Bool) (CI SI : ℤ × ℤ) : ℤ × ℤ :=
  if side then iaddI (imulZI (Zeta23Ext.Bridge.ThreePoint.csA k).2 CI)
    (imulZI (Zeta23Ext.Bridge.ThreePoint.csA k).1 SI)
  else isubI (imulZI (Zeta23Ext.Bridge.ThreePoint.csA k).2 CI)
    (imulZI (Zeta23Ext.Bridge.ThreePoint.csA k).1 SI)

def tloI (P2L P2U : ℕ) (SX : ℤ × ℤ) : ℤ := min ((P2L : ℤ) * SX.1) ((P2U : ℤ) * SX.1) / (S : ℤ)
def thiI (P2L P2U : ℕ) (SX : ℤ × ℤ) : ℤ :=
  -((-(max ((P2L : ℤ) * SX.2) ((P2U : ℤ) * SX.2))) / (S : ℤ))
def nloI (CX : ℤ × ℤ) (TLO THI : ℤ) : ℤ := max 0 (max (CX.1 - THI) (TLO - CX.2))

/-- The integer test, with every intermediate quantity passed as an argument. -/
def okF (Lg Ug Wn TL TU BL BU DHI : ℕ) (NLO : ℤ) (rok : Bool) : Bool :=
  Nat.ble Lg Ug && rok && Nat.ble TU S && Nat.ble TL S && Nat.blt SS (2 * (BL * BL))
    && Nat.ble SS (2 * (BU * BU)) && Nat.blt 0 DHI
    && Nat.ble (Wn * (DHI * DHI)) (E * (NLO.toNat * NLO.toNat))

def okT (Lg Ug Wn k : ℕ) (side : Bool) (TL TU BL BU : ℕ) : Bool :=
  okF Lg Ug Wn TL TU BL BU (dhiN BU)
    (nloI (cxI k side (ci1N TU, ci2N TL) (si1Z TL, si2N TU))
      (tloI (p2lN BL) (p2uN BU) (sxI k side (ci1N TU, ci2N TL) (si1Z TL, si2N TU)))
      (thiI (p2lN BL) (p2uN BU) (sxI k side (ci1N TU, ci2N TL) (si1Z TL, si2N TU))))
    (rloOk Lg Ug k side)

def okI (Lg Ug k : ℕ) (side : Bool) (Wn : ℕ) : Bool :=
  okT Lg Ug Wn k side (tlN (rloN Lg Ug k side)) (tuN (rhiN Lg Ug k side)) (blN Lg) (buN Ug)

end Riemann.CellI

end

/-! ###### module CellIProof ###### -/

section

/-!
# Soundness of the integer cell test

`okI_sound`: a cell passing `okI` is a record cell passing `Cell.ok`, so `cell_sound` bounds
`wfun` on it. Each integer quantity is shown equal to the record's rational one times `10¹²`.
-/

set_option maxRecDepth 100000

namespace Riemann.CellI

open Zeta23Ext.Bridge Zeta23Ext.Bridge.ThreePoint

/-- The record cell described by integer data. -/
def cellOf (Lg Ug k : ℕ) (side : Bool) (Wn : ℕ) : Cell :=
  ⟨(Lg : ℚ) / G, (Ug : ℚ) / G, k, side, (Wn : ℚ) / E⟩

local notation "SQ" => (1000000000000 : ℚ)

/-! ### Rounding -/

lemma cdiv_eq (a d : ℕ) : cdiv a d = (a + (d - 1)) / d := rfl

lemma cdiv_spec (a d : ℕ) (hd : 0 < d) : a ≤ d * cdiv a d ∧ d * cdiv a d < a + d := by
  rw [cdiv_eq]
  have h1 := Nat.div_add_mod (a + (d - 1)) d
  have h2 := Nat.mod_lt (a + (d - 1)) hd
  generalize (a + (d - 1)) / d = q at h1 ⊢
  generalize (a + (d - 1)) % d = r at h1 h2
  generalize d * q = m at h1 ⊢
  omega

lemma floorD_nat {x : ℚ} {a d : ℕ} (h : x * SQ = (a : ℚ) / d) :
    floorD x = ((a / d : ℕ) : ℚ) / SQ := by
  unfold floorD
  rw [h, Rat.floor_natCast_div_natCast,
    show ((a : ℤ) / (d : ℤ)) = ((a / d : ℕ) : ℤ) from (Int.natCast_div a d).symm,
    Int.cast_natCast]

lemma ceil_cdiv (a d : ℕ) (hd : 0 < d) : ⌈((a : ℚ) / d)⌉ = ((cdiv a d : ℕ) : ℤ) := by
  obtain ⟨h1, h2⟩ := cdiv_spec a d hd
  have hd' : (0 : ℚ) < d := by exact_mod_cast hd
  rw [Int.ceil_eq_iff]
  constructor
  · rw [lt_div_iff₀ hd']
    have : ((d * cdiv a d : ℕ) : ℚ) < a + d := by exact_mod_cast h2
    push_cast at this ⊢
    linarith
  · rw [div_le_iff₀ hd']
    have : (a : ℚ) ≤ ((d * cdiv a d : ℕ) : ℚ) := by exact_mod_cast h1
    push_cast at this ⊢
    linarith

lemma ceilD_nat {x : ℚ} {a d : ℕ} (hd : 0 < d) (h : x * SQ = (a : ℚ) / d) :
    ceilD x = ((cdiv a d : ℕ) : ℚ) / SQ := by
  unfold ceilD
  rw [h, ceil_cdiv a d hd]
  simp

lemma floorD_int {x : ℚ} {n : ℤ} {d : ℕ} (h : x * SQ = (n : ℚ) / d) :
    floorD x = ((n / (d : ℤ) : ℤ) : ℚ) / SQ := by
  unfold floorD
  rw [h, Rat.floor_intCast_div_natCast]

lemma ceilD_int {x : ℚ} {n : ℤ} {d : ℕ} (h : x * SQ = (n : ℚ) / d) :
    ceilD x = ((-((-n) / (d : ℤ)) : ℤ) : ℚ) / SQ := by
  unfold ceilD
  rw [h, Rat.ceil_intCast_div_natCast]

/-! ### The Taylor polynomials -/

lemma S_val : (S : ℚ) = SQ := by norm_num [S]
lemma SS_val : (SS : ℚ) = SQ ^ 2 := by norm_num [SS]

lemma cosH_exact (s : ℕ) (hs : s ≤ SS) :
    (cosH s : ℚ) = KC0 - s * (KC1 - s * (KC2 - s * (KC3 - s * (KC4 - s)))) := by
  have e4 : s ≤ KC4 := hs.trans (by norm_num [SS, KC4])
  have b4 : s * (KC4 - s) ≤ KC3 :=
    (Nat.mul_le_mul hs (Nat.sub_le _ _)).trans (by norm_num [SS, KC4, KC3])
  have b3 : s * (KC3 - s * (KC4 - s)) ≤ KC2 :=
    (Nat.mul_le_mul hs (Nat.sub_le _ _)).trans (by norm_num [SS, KC3, KC2])
  have b2 : s * (KC2 - s * (KC3 - s * (KC4 - s))) ≤ KC1 :=
    (Nat.mul_le_mul hs (Nat.sub_le _ _)).trans (by norm_num [SS, KC2, KC1])
  have b1 : s * (KC1 - s * (KC2 - s * (KC3 - s * (KC4 - s)))) ≤ KC0 :=
    (Nat.mul_le_mul hs (Nat.sub_le _ _)).trans (by norm_num [SS, KC1, KC0])
  unfold cosH
  rw [Nat.cast_sub b1, Nat.cast_mul, Nat.cast_sub b2, Nat.cast_mul, Nat.cast_sub b3, Nat.cast_mul,
    Nat.cast_sub b4, Nat.cast_mul, Nat.cast_sub e4]

lemma sinH_exact (s : ℕ) (hs : s ≤ SS) :
    (sinH s : ℚ) = KS0 - s * (KS1 - s * (KS2 - s * (KS3 - s * (KS4 - s)))) := by
  have e4 : s ≤ KS4 := hs.trans (by norm_num [SS, KS4])
  have b4 : s * (KS4 - s) ≤ KS3 :=
    (Nat.mul_le_mul hs (Nat.sub_le _ _)).trans (by norm_num [SS, KS4, KS3])
  have b3 : s * (KS3 - s * (KS4 - s)) ≤ KS2 :=
    (Nat.mul_le_mul hs (Nat.sub_le _ _)).trans (by norm_num [SS, KS3, KS2])
  have b2 : s * (KS2 - s * (KS3 - s * (KS4 - s))) ≤ KS1 :=
    (Nat.mul_le_mul hs (Nat.sub_le _ _)).trans (by norm_num [SS, KS2, KS1])
  have b1 : s * (KS1 - s * (KS2 - s * (KS3 - s * (KS4 - s)))) ≤ KS0 :=
    (Nat.mul_le_mul hs (Nat.sub_le _ _)).trans (by norm_num [SS, KS1, KS0])
  unfold sinH
  rw [Nat.cast_sub b1, Nat.cast_mul, Nat.cast_sub b2, Nat.cast_mul, Nat.cast_sub b3, Nat.cast_mul,
    Nat.cast_sub b4, Nat.cast_mul, Nat.cast_sub e4]

lemma cosH_ge (s : ℕ) (hs : s ≤ SS) : 1814400 * SS ^ 5 ≤ cosH s := by
  have h : s * (KC1 - s * (KC2 - s * (KC3 - s * (KC4 - s)))) ≤ SS * KC1 :=
    Nat.mul_le_mul hs (Nat.sub_le _ _)
  unfold cosH
  have : SS * KC1 + 1814400 * SS ^ 5 = KC0 := by norm_num [SS, KC1, KC0]
  omega

lemma sq_le_SS {T : ℕ} (hT : T ≤ S) : T * T ≤ SS :=
  (Nat.mul_le_mul hT hT).trans (by norm_num [S, SS])

lemma taylorCos_poly (t q : ℚ) (hq : q ≠ 0) :
    taylorCosQ (t / q) = (3628800 * (q ^ 2) ^ 5 - t * t * (1814400 * (q ^ 2) ^ 4 - t * t *
      (151200 * (q ^ 2) ^ 3 - t * t * (5040 * (q ^ 2) ^ 2 - t * t * (90 * q ^ 2 - t * t)))))
      / (q ^ 10 * 3628800) := by
  unfold taylorCosQ
  field_simp
  ring

lemma taylorSin_poly (t q : ℚ) (hq : q ≠ 0) :
    taylorSinQ (t / q) = t * (39916800 * (q ^ 2) ^ 5 - t * t * (6652800 * (q ^ 2) ^ 4 - t * t *
      (332640 * (q ^ 2) ^ 3 - t * t * (7920 * (q ^ 2) ^ 2 - t * t * (110 * q ^ 2 - t * t)))))
      / (q ^ 11 * 39916800) := by
  unfold taylorSinQ
  field_simp
  ring

lemma taylorCos_eq (T : ℕ) (hT : T ≤ S) :
    taylorCosQ ((T : ℚ) / SQ) = (cosN T : ℚ) / D10 := by
  unfold cosN
  rw [cosH_exact _ (sq_le_SS hT), taylorCos_poly _ _ (by norm_num)]
  have e0 : (KC0 : ℚ) = 3628800 * (SS : ℚ) ^ 5 := by unfold KC0; push_cast; ring
  have e1 : (KC1 : ℚ) = 1814400 * (SS : ℚ) ^ 4 := by unfold KC1; push_cast; ring
  have e2 : (KC2 : ℚ) = 151200 * (SS : ℚ) ^ 3 := by unfold KC2; push_cast; ring
  have e3 : (KC3 : ℚ) = 5040 * (SS : ℚ) ^ 2 := by unfold KC3; push_cast; ring
  have e4 : (KC4 : ℚ) = 90 * (SS : ℚ) := by unfold KC4; push_cast; ring
  have eD : (D10 : ℚ) = (S : ℚ) ^ 10 * 3628800 := by unfold D10; push_cast; ring
  rw [e0, e1, e2, e3, e4, eD, SS_val, S_val]
  push_cast
  ring

lemma taylorSin_eq (T : ℕ) (hT : T ≤ S) :
    taylorSinQ ((T : ℚ) / SQ) = (sinN T : ℚ) / D11 := by
  unfold sinN
  rw [Nat.cast_mul, sinH_exact _ (sq_le_SS hT), taylorSin_poly _ _ (by norm_num)]
  have e0 : (KS0 : ℚ) = 39916800 * (SS : ℚ) ^ 5 := by unfold KS0; push_cast; ring
  have e1 : (KS1 : ℚ) = 6652800 * (SS : ℚ) ^ 4 := by unfold KS1; push_cast; ring
  have e2 : (KS2 : ℚ) = 332640 * (SS : ℚ) ^ 3 := by unfold KS2; push_cast; ring
  have e3 : (KS3 : ℚ) = 7920 * (SS : ℚ) ^ 2 := by unfold KS3; push_cast; ring
  have e4 : (KS4 : ℚ) = 110 * (SS : ℚ) := by unfold KS4; push_cast; ring
  have eD : (D11 : ℚ) = (S : ℚ) ^ 11 * 39916800 := by unfold D11; push_cast; ring
  rw [e0, e1, e2, e3, e4, eD, SS_val, S_val]
  push_cast
  ring

/-! ### Interval arithmetic scales by `10¹²` -/

lemma SQ_pos : (0 : ℚ) < SQ := by norm_num

lemma imulZ_scale (e : ℤ) (a b : ℤ) :
    imulZ e ((a : ℚ) / SQ, (b : ℚ) / SQ) =
      (((imulZI e (a, b)).1 : ℚ) / SQ, ((imulZI e (a, b)).2 : ℚ) / SQ) := by
  unfold imulZ imulZI
  split_ifs <;> simp <;> constructor <;> ring

lemma iadd_scale (a b c d : ℤ) :
    iadd ((a : ℚ) / SQ, (b : ℚ) / SQ) ((c : ℚ) / SQ, (d : ℚ) / SQ) =
      (((iaddI (a, b) (c, d)).1 : ℚ) / SQ, ((iaddI (a, b) (c, d)).2 : ℚ) / SQ) := by
  unfold iadd iaddI; simp; constructor <;> ring

lemma isub_scale (a b c d : ℤ) :
    isub ((a : ℚ) / SQ, (b : ℚ) / SQ) ((c : ℚ) / SQ, (d : ℚ) / SQ) =
      (((isubI (a, b) (c, d)).1 : ℚ) / SQ, ((isubI (a, b) (c, d)).2 : ℚ) / SQ) := by
  unfold isub isubI; simp; constructor <;> ring

lemma pair_scale (I : ℤ × ℤ) : ((I.1 : ℚ) / SQ, (I.2 : ℚ) / SQ) =
    (((I.1 : ℤ) : ℚ) / SQ, ((I.2 : ℤ) : ℚ) / SQ) := rfl

/-! ### The cell's quantities -/

section Quantities

variable (Lg Ug k : ℕ) (side : Bool) (Wn : ℕ)


lemma G_eq : (G : ℚ) = 2 * H31 := by norm_num [G, H31]

lemma rloN_true : rloN Lg Ug k true = Lg - k * H31 := by rw [rloN, cond_true]
lemma rloN_false : rloN Lg Ug k false = k * H31 - Ug := by rw [rloN, cond_false]
lemma rhiN_true : rhiN Lg Ug k true = Ug - k * H31 := by rw [rhiN, cond_true]
lemma rhiN_false : rhiN Lg Ug k false = k * H31 - Lg := by rw [rhiN, cond_false]
lemma rloOk_true : rloOk Lg Ug k true = Nat.ble (k * H31) Lg := by rw [rloOk, cond_true]
lemma rloOk_false : rloOk Lg Ug k false = Nat.ble Ug (k * H31) := by rw [rloOk, cond_false]

lemma rlo_true : (cellOf Lg Ug k true Wn).rlo = (Lg : ℚ) / G - k / 2 := by
  unfold Cell.rlo Cell.A cellOf; exact if_pos rfl
lemma rlo_false : (cellOf Lg Ug k false Wn).rlo = (k : ℚ) / 2 - Ug / G := by
  unfold Cell.rlo Cell.A cellOf; exact if_neg Bool.false_ne_true
lemma rhi_true : (cellOf Lg Ug k true Wn).rhi = (Ug : ℚ) / G - k / 2 := by
  unfold Cell.rhi Cell.A cellOf; exact if_pos rfl
lemma rhi_false : (cellOf Lg Ug k false Wn).rhi = (k : ℚ) / 2 - Lg / G := by
  unfold Cell.rhi Cell.A cellOf; exact if_neg Bool.false_ne_true

lemma half_eq (k : ℕ) : ((k * H31 : ℕ) : ℚ) / G = k / 2 := by
  rw [G_eq]; have hH : (H31 : ℚ) ≠ 0 := by norm_num [H31]
  push_cast; field_simp

lemma rlo_eq (hr : rloOk Lg Ug k side = true) :
    (cellOf Lg Ug k side Wn).rlo = (rloN Lg Ug k side : ℚ) / G := by
  cases side
  · rw [rloOk_false, Nat.ble_eq] at hr
    rw [rlo_false, rloN_false, Nat.cast_sub hr, sub_div, half_eq]
  · rw [rloOk_true, Nat.ble_eq] at hr
    rw [rlo_true, rloN_true, Nat.cast_sub hr, sub_div, half_eq]

lemma rhi_eq (hr : rloOk Lg Ug k side = true) (hLU : Lg ≤ Ug) :
    (cellOf Lg Ug k side Wn).rhi = (rhiN Lg Ug k side : ℚ) / G := by
  cases side
  · rw [rloOk_false, Nat.ble_eq] at hr
    rw [rhi_false, rhiN_false, Nat.cast_sub (by omega), sub_div, half_eq]
  · rw [rloOk_true, Nat.ble_eq] at hr
    rw [rhi_true, rhiN_true, Nat.cast_sub (by omega), sub_div, half_eq]

lemma PG_pos : 0 < PG := by norm_num [PG]

lemma piLo_scale (R : ℕ) : piLoQ * ((R : ℚ) / G) * SQ = ((PLOS * R : ℕ) : ℚ) / (PG : ℕ) := by
  unfold piLoQ; simp only [PLOS, PG, G]; push_cast; ring

lemma piHi_scale (R : ℕ) : piHiQ * ((R : ℚ) / G) * SQ = ((PHIS * R : ℕ) : ℚ) / (PG : ℕ) := by
  unfold piHiQ; simp only [PHIS, PG, G]; push_cast; ring

lemma TL_eq (hr : rloOk Lg Ug k side = true) :
    (cellOf Lg Ug k side Wn).TL = (tlN (rloN Lg Ug k side) : ℚ) / SQ := by
  unfold Cell.TL
  rw [rlo_eq Lg Ug k side Wn hr, floorD_nat (piLo_scale _)]
  rfl

lemma TU_eq (hr : rloOk Lg Ug k side = true) (hLU : Lg ≤ Ug) :
    (cellOf Lg Ug k side Wn).TU = (tuN (rhiN Lg Ug k side) : ℚ) / SQ := by
  unfold Cell.TU
  rw [rhi_eq Lg Ug k side Wn hr hLU, ceilD_nat PG_pos (piHi_scale _)]
  rfl

lemma BL_eq : (cellOf Lg Ug k side Wn).BL = (blN Lg : ℚ) / SQ := by
  unfold Cell.BL
  rw [show (cellOf Lg Ug k side Wn).L = (Lg : ℚ) / G from rfl, floorD_nat (piLo_scale _)]
  rfl

lemma BU_eq : (cellOf Lg Ug k side Wn).BU = (buN Ug : ℚ) / SQ := by
  unfold Cell.BU
  rw [show (cellOf Lg Ug k side Wn).U = (Ug : ℚ) / G from rfl, ceilD_nat PG_pos (piHi_scale _)]
  rfl

lemma P2L_eq : (cellOf Lg Ug k side Wn).P2L = (p2lN (blN Lg) : ℚ) / SQ := by
  unfold Cell.P2L
  rw [BL_eq, floorD_nat (a := GLO2 * blN Lg) (d := G10)]
  · rfl
  · unfold gamLoQ; simp only [GLO2, G10]; push_cast; ring

lemma P2U_eq : (cellOf Lg Ug k side Wn).P2U = (p2uN (buN Ug) : ℚ) / SQ := by
  unfold Cell.P2U
  rw [BU_eq, ceilD_nat (a := GHI2 * buN Ug) (d := G10) (by norm_num [G10])]
  · rfl
  · unfold gamHiQ; simp only [GHI2, G10]; push_cast; ring

lemma D10E_pos : 0 < D10E := by unfold D10E D10 ERRD S; positivity
lemma D11E_pos : 0 < D11E := by unfold D11E D11 ERRD S; positivity

lemma cos_err_le (T : ℕ) (hT : T ≤ S) : E10 ≤ cosN T * ERRD := by
  have h := cosH_ge _ (sq_le_SS hT)
  unfold cosN
  have hS : S ^ 10 = SS ^ 5 := by
    rw [show SS = S ^ 2 by norm_num [S, SS], ← pow_mul]
  calc E10 = SS ^ 5 * 47174400 := by unfold E10 D10; rw [hS]; ring
    _ ≤ SS ^ 5 * (1814400 * ERRD) := Nat.mul_le_mul_left _ (by norm_num [ERRD])
    _ = 1814400 * SS ^ 5 * ERRD := by ring
    _ ≤ cosH (T * T) * ERRD := Nat.mul_le_mul_right _ h

lemma CI1_eq (T : ℕ) (hT : T ≤ S) :
    floorD (taylorCosQ ((T : ℚ) / SQ) - errQ) = (ci1N T : ℚ) / SQ := by
  rw [taylorCos_eq T hT]
  refine floorD_nat (a := (cosN T * ERRD - E10) * S) (d := D10E) ?_
  rw [Nat.cast_mul, Nat.cast_sub (cos_err_le T hT)]
  have hD : (D10 : ℚ) ≠ 0 := by unfold D10 S; positivity
  simp only [D10E, E10, errQ, ERRD]
  push_cast
  rw [S_val]
  field_simp
  try ring

lemma CI2_eq (T : ℕ) (hT : T ≤ S) :
    ceilD (taylorCosQ ((T : ℚ) / SQ) + errQ) = (ci2N T : ℚ) / SQ := by
  rw [taylorCos_eq T hT]
  refine ceilD_nat (a := (cosN T * ERRD + E10) * S) (d := D10E) D10E_pos ?_
  have hD : (D10 : ℚ) ≠ 0 := by unfold D10 S; positivity
  simp only [D10E, E10, errQ, ERRD]
  push_cast
  rw [S_val]
  field_simp
  try ring

lemma SI2_eq (T : ℕ) (hT : T ≤ S) :
    ceilD (taylorSinQ ((T : ℚ) / SQ) + errQ) = (si2N T : ℚ) / SQ := by
  rw [taylorSin_eq T hT]
  refine ceilD_nat (a := (sinN T * ERRD + E11) * S) (d := D11E) D11E_pos ?_
  have hD : (D11 : ℚ) ≠ 0 := by unfold D11 S; positivity
  simp only [D11E, E11, errQ, ERRD]
  push_cast
  rw [S_val]
  field_simp
  try ring

lemma SI1_eq (T : ℕ) (hT : T ≤ S) :
    floorD (taylorSinQ ((T : ℚ) / SQ) - errQ) = ((si1Z T : ℤ) : ℚ) / SQ := by
  rw [taylorSin_eq T hT]
  have hD : (D11 : ℚ) ≠ 0 := by unfold D11 S; positivity
  unfold si1Z floorSub
  cases hb : Nat.ble E11 (sinN T * ERRD)
  · rw [cond_false]
    have hlt : sinN T * ERRD ≤ E11 := by
      have h' : ¬ (E11 ≤ sinN T * ERRD) := by rw [← Nat.ble_eq, hb]; exact Bool.false_ne_true
      omega
    have hx : ((sinN T : ℚ) / D11 - errQ) * SQ
        = -(((E11 - sinN T * ERRD) * S : ℕ) : ℚ) / (D11E : ℕ) := by
      rw [Nat.cast_mul, Nat.cast_sub hlt]
      simp only [D11E, E11, errQ, ERRD]
      push_cast
      rw [S_val]
      field_simp
      try ring
    unfold floorD
    rw [hx, neg_div, Int.floor_neg, ceil_cdiv _ _ D11E_pos]
    rfl
  · rw [cond_true]
    have hle : E11 ≤ sinN T * ERRD := by rw [← Nat.ble_eq]; exact hb
    rw [floorD_nat (a := (sinN T * ERRD - E11) * S) (d := D11E)]
    · rw [Int.ofNat_eq_natCast, Int.cast_natCast]
    · rw [Nat.cast_mul, Nat.cast_sub hle]
      simp only [D11E, E11, errQ, ERRD]
      push_cast
      rw [S_val]
      field_simp
      try ring


lemma side_eq : (cellOf Lg Ug k side Wn).side = side := rfl
lemma k_eq : (cellOf Lg Ug k side Wn).k = k := rfl

/-- Abbreviations for the integer quantities of the cell. -/
abbrev TLv := tlN (rloN Lg Ug k side)
abbrev TUv := tuN (rhiN Lg Ug k side)
abbrev CIv : ℤ × ℤ := (ci1N (TUv Lg Ug k side), ci2N (TLv Lg Ug k side))
abbrev SIv : ℤ × ℤ := (si1Z (TLv Lg Ug k side), si2N (TUv Lg Ug k side))
abbrev CXv := cxI k side (CIv Lg Ug k side) (SIv Lg Ug k side)
abbrev SXv := sxI k side (CIv Lg Ug k side) (SIv Lg Ug k side)

lemma CI_eq (hr : rloOk Lg Ug k side = true) (hLU : Lg ≤ Ug) (hTU : TUv Lg Ug k side ≤ S)
    (hTL : TLv Lg Ug k side ≤ S) :
    (cellOf Lg Ug k side Wn).CI =
      (((CIv Lg Ug k side).1 : ℚ) / SQ, ((CIv Lg Ug k side).2 : ℚ) / SQ) := by
  unfold Cell.CI
  rw [TU_eq Lg Ug k side Wn hr hLU, TL_eq Lg Ug k side Wn hr, CI1_eq _ hTU, CI2_eq _ hTL]
  rw [Int.cast_natCast, Int.cast_natCast]

lemma SI_eq (hr : rloOk Lg Ug k side = true) (hLU : Lg ≤ Ug) (hTU : TUv Lg Ug k side ≤ S)
    (hTL : TLv Lg Ug k side ≤ S) :
    (cellOf Lg Ug k side Wn).SI =
      (((SIv Lg Ug k side).1 : ℚ) / SQ, ((SIv Lg Ug k side).2 : ℚ) / SQ) := by
  unfold Cell.SI
  rw [TU_eq Lg Ug k side Wn hr hLU, TL_eq Lg Ug k side Wn hr, SI1_eq _ hTL, SI2_eq _ hTU]
  rw [Int.cast_natCast]

lemma CX_eq (hr : rloOk Lg Ug k side = true) (hLU : Lg ≤ Ug) (hTU : TUv Lg Ug k side ≤ S)
    (hTL : TLv Lg Ug k side ≤ S) :
    (cellOf Lg Ug k side Wn).CX =
      (((CXv Lg Ug k side).1 : ℚ) / SQ, ((CXv Lg Ug k side).2 : ℚ) / SQ) := by
  unfold Cell.CX Cell.cA Cell.sA
  rw [CI_eq Lg Ug k side Wn hr hLU hTU hTL, SI_eq Lg Ug k side Wn hr hLU hTU hTL, k_eq]
  unfold CXv cxI
  cases side
  · rw [if_neg (show ¬ (cellOf Lg Ug k false Wn).side = true from Bool.false_ne_true),
      if_neg Bool.false_ne_true, imulZ_scale, imulZ_scale, iadd_scale]
  · rw [if_pos (show (cellOf Lg Ug k true Wn).side = true from rfl), if_pos rfl,
      imulZ_scale, imulZ_scale, isub_scale]

lemma SX_eq (hr : rloOk Lg Ug k side = true) (hLU : Lg ≤ Ug) (hTU : TUv Lg Ug k side ≤ S)
    (hTL : TLv Lg Ug k side ≤ S) :
    (cellOf Lg Ug k side Wn).SX =
      (((SXv Lg Ug k side).1 : ℚ) / SQ, ((SXv Lg Ug k side).2 : ℚ) / SQ) := by
  unfold Cell.SX Cell.cA Cell.sA
  rw [CI_eq Lg Ug k side Wn hr hLU hTU hTL, SI_eq Lg Ug k side Wn hr hLU hTU hTL, k_eq]
  unfold SXv sxI
  cases side
  · rw [if_neg (show ¬ (cellOf Lg Ug k false Wn).side = true from Bool.false_ne_true),
      if_neg Bool.false_ne_true, imulZ_scale, imulZ_scale, isub_scale]
  · rw [if_pos (show (cellOf Lg Ug k true Wn).side = true from rfl), if_pos rfl,
      imulZ_scale, imulZ_scale, iadd_scale]

lemma S_pos : 0 < S := by norm_num [S]

lemma prod_scale (p : ℕ) (x : ℤ) : ((p : ℚ) / SQ) * ((x : ℚ) / SQ) = (((p : ℤ) * x : ℤ) : ℚ) / SQ ^ 2 := by
  push_cast; ring

lemma TLO_eq (hr : rloOk Lg Ug k side = true) (hLU : Lg ≤ Ug) (hTU : TUv Lg Ug k side ≤ S)
    (hTL : TLv Lg Ug k side ≤ S) :
    (cellOf Lg Ug k side Wn).TLO =
      (tloI (p2lN (blN Lg)) (p2uN (buN Ug)) (SXv Lg Ug k side) : ℚ) / SQ := by
  unfold Cell.TLO
  rw [P2L_eq, P2U_eq, SX_eq Lg Ug k side Wn hr hLU hTU hTL, prod_scale, prod_scale,
    min_div_div_right (by positivity)]
  unfold tloI
  refine floorD_int (d := S) ?_
  rw [Int.cast_min, S_val]
  field_simp

lemma THI_eq (hr : rloOk Lg Ug k side = true) (hLU : Lg ≤ Ug) (hTU : TUv Lg Ug k side ≤ S)
    (hTL : TLv Lg Ug k side ≤ S) :
    (cellOf Lg Ug k side Wn).THI =
      (thiI (p2lN (blN Lg)) (p2uN (buN Ug)) (SXv Lg Ug k side) : ℚ) / SQ := by
  unfold Cell.THI
  rw [P2L_eq, P2U_eq, SX_eq Lg Ug k side Wn hr hLU hTU hTL, prod_scale, prod_scale,
    max_div_div_right (by positivity)]
  unfold thiI
  refine ceilD_int (d := S) ?_
  rw [Int.cast_max, S_val]
  field_simp

lemma max3_scale (a b : ℤ) :
    max (0 : ℚ) (max ((a : ℚ) / SQ) ((b : ℚ) / SQ)) = ((max 0 (max a b) : ℤ) : ℚ) / SQ := by
  rw [Int.cast_max, Int.cast_max, Int.cast_zero,
    show max (0 : ℚ) (max (a : ℚ) b) / SQ = max (0 / SQ) (max ((a : ℚ) / SQ) ((b : ℚ) / SQ)) by
      rw [max_div_div_right (by positivity), max_div_div_right (by positivity)],
    zero_div]

lemma NLO_eq (hr : rloOk Lg Ug k side = true) (hLU : Lg ≤ Ug) (hTU : TUv Lg Ug k side ≤ S)
    (hTL : TLv Lg Ug k side ≤ S) :
    (cellOf Lg Ug k side Wn).NLO =
      (nloI (CXv Lg Ug k side) (tloI (p2lN (blN Lg)) (p2uN (buN Ug)) (SXv Lg Ug k side))
        (thiI (p2lN (blN Lg)) (p2uN (buN Ug)) (SXv Lg Ug k side)) : ℚ) / SQ := by
  unfold Cell.NLO
  rw [CX_eq Lg Ug k side Wn hr hLU hTU hTL, TLO_eq Lg Ug k side Wn hr hLU hTU hTL,
    THI_eq Lg Ug k side Wn hr hLU hTU hTL, ← sub_div, ← sub_div, ← Int.cast_sub, ← Int.cast_sub,
    max3_scale]
  rfl

lemma DHI_eq (hBU : SS ≤ 2 * (buN Ug * buN Ug)) :
    (cellOf Lg Ug k side Wn).DHI = (dhiN (buN Ug) : ℚ) / SQ := by
  unfold Cell.DHI
  rw [BU_eq]
  refine ceilD_nat (a := 2 * (buN Ug * buN Ug) - SS) (d := S) S_pos ?_
  rw [Nat.cast_sub hBU, SS_val, S_val]
  push_cast
  field_simp
  try ring

end Quantities

theorem okI_ok (Lg Ug k : ℕ) (side : Bool) (Wn : ℕ) (h : okI Lg Ug k side Wn = true) :
    (cellOf Lg Ug k side Wn).ok = true := by
  unfold okI okT okF at h
  simp only [Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨hLU, hr⟩, hTU⟩, hTL⟩, hBL⟩, hBU⟩, hD⟩, hW⟩ := h
  have hSQ := SQ_pos
  unfold Cell.ok
  simp only [Bool.and_eq_true, decide_eq_true_eq]
  rw [rlo_eq Lg Ug k side Wn hr, TU_eq Lg Ug k side Wn hr hLU, TL_eq Lg Ug k side Wn hr, BL_eq,
    P2L_eq, DHI_eq Lg Ug k side Wn hBU]
  have hS : (S : ℚ) = SQ := S_val
  have hSS : (SS : ℚ) = SQ ^ 2 := SS_val
  refine ⟨⟨⟨⟨⟨⟨⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩, ?_⟩, ?_⟩, ?_⟩, ?_⟩, ?_⟩, ?_⟩
  · show (0 : ℚ) ≤ (Lg : ℚ) / G; positivity
  · show (Lg : ℚ) / G ≤ (Ug : ℚ) / G
    exact div_le_div_of_nonneg_right (by exact_mod_cast hLU) (by positivity)
  · positivity
  · rw [div_le_one hSQ, ← hS]; exact_mod_cast hTU
  · positivity
  · positivity
  · positivity
  · have : ((SS : ℕ) : ℚ) < ((2 * (blN Lg * blN Lg) : ℕ) : ℚ) := by exact_mod_cast hBL
    rw [hSS] at this; push_cast at this
    have e : 2 * ((blN Lg : ℚ) / SQ) * ((blN Lg : ℚ) / SQ) = 2 * ((blN Lg : ℚ) * blN Lg) / SQ ^ 2 := by
      ring
    rw [e, lt_div_iff₀ (by positivity)]
    linarith
  · have : (0 : ℚ) < dhiN (buN Ug) := by exact_mod_cast hD
    positivity
  · -- the bound: `Wn / E ≤ (NLO / DHI)²`
    rw [show (cellOf Lg Ug k side Wn).W = (Wn : ℚ) / E from rfl, Cell.Wc,
      NLO_eq Lg Ug k side Wn hr hLU hTU hTL, DHI_eq Lg Ug k side Wn hBU]
    set n := nloI (CXv Lg Ug k side) (tloI (p2lN (blN Lg)) (p2uN (buN Ug)) (SXv Lg Ug k side))
        (thiI (p2lN (blN Lg)) (p2uN (buN Ug)) (SXv Lg Ug k side)) with hn
    have hn0 : 0 ≤ n := by rw [hn]; unfold nloI; exact le_max_left _ _
    have hnt : ((n.toNat : ℕ) : ℚ) = (n : ℚ) := by
      rw [show ((n.toNat : ℕ) : ℚ) = ((n.toNat : ℤ) : ℚ) from rfl, Int.toNat_of_nonneg hn0]
    have hD' : (0 : ℚ) < dhiN (buN Ug) := by exact_mod_cast hD
    have hW' : ((Wn * (dhiN (buN Ug) * dhiN (buN Ug)) : ℕ) : ℚ) ≤ ((E * (n.toNat * n.toNat) : ℕ) : ℚ) := by
      exact_mod_cast hW
    push_cast at hW'
    rw [hnt] at hW'
    have hE : (0 : ℚ) < E := by norm_num [E]
    rw [div_div_div_cancel_right₀ hSQ.ne', div_pow, div_le_div_iff₀ hE (by positivity)]
    nlinarith

/-- Integer cells bound `wfun`: the analytic content is the record's `cell_sound`. -/
theorem cellI_sound (Lg Ug k : ℕ) (side : Bool) (Wn : ℕ) (h : okI Lg Ug k side Wn = true)
    (x : ℝ) (h1 : (Lg : ℝ) / G ≤ x) (h2 : x ≤ (Ug : ℝ) / G) : (Wn : ℝ) / E ≤ wfun x := by
  have := cell_sound (cellOf Lg Ug k side Wn) (okI_ok Lg Ug k side Wn h) x
    (by simp only [cellOf]; push_cast; exact h1) (by simp only [cellOf]; push_cast; exact h2)
  simpa [cellOf] using this

end Riemann.CellI

end

/-! ###### module PCheck ###### -/

section

/-!
# Pyramid lower-bound table

Entries are lower bounds for `wfun` on aligned dyadic cells, in units of `10⁻⁹`, packed `30` bits
each. Level `l` cell `g` is `[A0 + g·2^(32-l), A0 + (g+1)·2^(32-l)]` in grid units. Levels `0..6`
are stored densely in `C`. Block `j` (level-6 cell `j`) has its own constant `BK j`: its finest
level `r` in the low `5` bits, then levels `7..r` of its sub-pyramid. A query reads every cell
meeting `[a, b]` at a level `extra` steps finer than the query's width, each through the finest
stored cell containing it.
-/

namespace Riemann.PCheck

open Riemann.ICheck

def A0 : ℕ := 2147483648
def EB : ℕ := 30
def EM : ℕ := 1073741823

structure Table where
  (C : ℕ) (BK : ℕ → ℕ) (NU extra : ℕ)

namespace Table

def top (T : Table) : ℕ := Nat.add A0 (Nat.mul T.NU 4294967296)

/-- Field `i` of a packed natural. -/
def fld (X i : ℕ) : ℕ := Nat.land (Nat.shiftRight X (Nat.mul EB i)) EM

/-- Dense entry at level `l ≤ 6`, cell `g`. -/
def dense (T : Table) (l g : ℕ) : ℕ := fld T.C (Nat.add (Nat.mul T.NU (Nat.sub (Nat.shiftLeft 1 l) 1)) g)

/-- Finest level stored by block `j`. -/
def res (T : Table) (j : ℕ) : ℕ := Nat.land (T.BK j) 31

/-- Entry of block `j` at level `7 ≤ l ≤ res j`, local cell `i`. -/
def blk (T : Table) (j l i : ℕ) : ℕ :=
  fld (Nat.shiftRight (T.BK j) 5) (Nat.add (Nat.sub (Nat.shiftLeft 1 (Nat.sub l 6)) 2) i)

/-- Entry of a block with constant `X` at its level `l'`, for level-`l` cell `g` of block `j`. -/
def fineAt (X l' l g j : ℕ) : ℕ :=
  fld (Nat.shiftRight X 5) (Nat.add (Nat.sub (Nat.shiftLeft 1 (Nat.sub l' 6)) 2)
    (Nat.sub (Nat.shiftRight g (Nat.sub l l')) (Nat.shiftLeft j (Nat.sub l' 6))))

/-- The entry for level-`l` cell `g` (`l ≥ 7`) of block `j`, given the block's constant `X`. -/
def fineX (T : Table) (X l g j : ℕ) : ℕ :=
  bif Nat.ble (Nat.land X 31) 6 then T.dense 6 j
  else fineAt X (Nat.min l (Nat.land X 31)) l g j

/-- Evaluate `a` to a numeral before continuing (the kernel is call-by-name). -/
def force (a : ℕ) (k : ℕ → ℕ) : ℕ :=
  Nat.casesOn (motive := fun _ => ℕ) a (k 0) (fun n => k (Nat.succ n))

/-- The entry used for level-`l` cell `g`, looking up its block by its evaluated index. -/
def entry (T : Table) (l g : ℕ) : ℕ :=
  bif Nat.ble l 6 then T.dense l g
  else force (Nat.shiftRight g (Nat.sub l 6)) fun j => T.fineX (T.BK j) l g j

/-- The largest `k ≤ min 4 l` with `g` aligned to `2^k` and `g + 2^k - 1 ≤ ib`. -/
def alignK (l g ib : ℕ) : ℕ :=
  bif Nat.ble 4 l && Nat.beq (Nat.land g 15) 0 && Nat.ble (Nat.add g 16) (Nat.succ ib) then 4
  else bif Nat.ble 3 l && Nat.beq (Nat.land g 7) 0 && Nat.ble (Nat.add g 8) (Nat.succ ib) then 3
  else bif Nat.ble 2 l && Nat.beq (Nat.land g 3) 0 && Nat.ble (Nat.add g 4) (Nat.succ ib) then 2
  else bif Nat.ble 1 l && Nat.beq (Nat.land g 1) 0 && Nat.ble (Nat.add g 2) (Nat.succ ib) then 1
  else 0

/-- `min` of the entries over a cover of level-`l` cells `g..ib` by aligned dyadic blocks, each
read as one coarser entry (`BIG` for an empty range, `0` if the steps run out). -/
def dcov (T : Table) (l ib : ℕ) (steps : ℕ) : ℕ → ℕ :=
  Nat.rec (motive := fun _ => ℕ → ℕ) (fun g => bif Nat.blt ib g then BIG else 0)
    (fun _ ih g =>
      bif Nat.blt ib g then BIG
      else force (alignK l g ib) fun k =>
        Nat.min (force (Nat.sub l k) fun l' => force (Nat.shiftRight g k) fun g' => T.entry l' g')
          (ih (Nat.add g (Nat.shiftLeft 1 k))))
    steps

def lbI (T : Table) (l ia ib : ℕ) : ℕ :=
  bif Nat.blt (Nat.add ia (Nat.shiftLeft 1 T.extra)) ib then 0 else T.dcov l ib 12 ia

def lbL (T : Table) (l a b : ℕ) : ℕ :=
  force (Nat.shiftRight (Nat.sub a A0) (Nat.sub 32 l)) fun ia =>
    force (Nat.shiftRight (Nat.sub b A0) (Nat.sub 32 l)) fun ib => T.lbI l ia ib

/-- Bit length of `w < 2⁶⁴` by binary search, with operations both kernels evaluate natively. -/
def blA (w acc : ℕ) : ℕ := bif Nat.ble 1 w then Nat.succ acc else acc
def blB (w acc : ℕ) : ℕ := bif Nat.ble 2 w then blA (Nat.shiftRight w 1) (Nat.add acc 1) else blA w acc
def blC (w acc : ℕ) : ℕ := bif Nat.ble 4 w then blB (Nat.shiftRight w 2) (Nat.add acc 2) else blB w acc
def blD (w acc : ℕ) : ℕ := bif Nat.ble 16 w then blC (Nat.shiftRight w 4) (Nat.add acc 4) else blC w acc
def blE (w acc : ℕ) : ℕ := bif Nat.ble 256 w then blD (Nat.shiftRight w 8) (Nat.add acc 8) else blD w acc
def blF (w acc : ℕ) : ℕ :=
  bif Nat.ble 65536 w then blE (Nat.shiftRight w 16) (Nat.add acc 16) else blE w acc
def bitLen (w : ℕ) : ℕ :=
  bif Nat.ble 4294967296 w then blF (Nat.shiftRight w 32) 32 else blF w 0

def lb0 (T : Table) (a b : ℕ) : ℕ :=
  bif Nat.blt a A0 || Nat.ble T.top b || Nat.blt b a then 0
  else force (Nat.min 32 (Nat.sub (Nat.add 32 T.extra) (bitLen (Nat.sub b a)))) fun l => T.lbL l a b

/-- The lower-bound oracle. -/
def lb (T : Table) (a b : ℕ) : ℕ := force a fun a => force b fun b => T.lb0 a b

/-! ### Verification -/

/-- `f i` for every `i < n`. -/
def allBelow (n : ℕ) (f : ℕ → Bool) : Bool :=
  Nat.rec (motive := fun _ => Bool) true (fun k ih => ih && f k) n

/-- `f (a + i)` for every `i < n`. -/
def allFrom (a n : ℕ) (f : ℕ → Bool) : Bool :=
  Nat.rec (motive := fun _ => Bool) true (fun k ih => ih && f (Nat.add a k)) n

def forceB (a : ℕ) (k : ℕ → Bool) : Bool :=
  Nat.casesOn (motive := fun _ => Bool) a (k 0) (fun n => k (Nat.succ n))

/-- Left end of level-`l` cell `g`. -/
def cellLo (l g : ℕ) : ℕ := Nat.add A0 (Nat.shiftLeft g (Nat.sub 32 l))

/-- The record's anchor for a cell starting at `lo` (inside one quarter interval). -/
def anchK (lo : ℕ) : ℕ :=
  bif Nat.beq (Nat.land (Nat.shiftRight lo 30) 1) 0 then Nat.shiftRight lo 31
  else Nat.shiftRight (Nat.add (Nat.shiftRight lo 30) 1) 1
def anchS (lo : ℕ) : Bool := Nat.beq (Nat.land (Nat.shiftRight lo 30) 1) 0

/-- Entry `e` is certified on level-`l` cell `g` by the integer cell test. -/
def okLeaf (l g e : ℕ) : Bool :=
  forceB (cellLo l g) fun lo => forceB (Nat.add lo (Nat.shiftLeft 1 (Nat.sub 32 l))) fun hi =>
    forceB (Nat.mul e 10000) fun w => Riemann.CellI.okI lo hi (anchK lo) (anchS lo) w

/-- Every stored level of a refined block: finest cells certified, coarser cells below their
children, and the dense level-6 entry below the block's level-7 pair. -/
def blockOkX (T : Table) (X j : ℕ) : Bool :=
  bif Nat.ble (Nat.land X 31) 6 then okLeaf 6 j (T.dense 6 j)
  else
    allBelow (Nat.shiftLeft 1 (Nat.sub (Nat.land X 31) 6)) (fun i =>
      okLeaf (Nat.land X 31) (Nat.add (Nat.shiftLeft j (Nat.sub (Nat.land X 31) 6)) i)
        (fld (Nat.shiftRight X 5) (Nat.add (Nat.sub (Nat.shiftLeft 1 (Nat.sub (Nat.land X 31) 6)) 2) i)))
    && allFrom 7 (Nat.sub (Nat.land X 31) 7) (fun l =>
      allBelow (Nat.shiftLeft 1 (Nat.sub l 6)) (fun i =>
        Nat.ble (fld (Nat.shiftRight X 5) (Nat.add (Nat.sub (Nat.shiftLeft 1 (Nat.sub l 6)) 2) i))
          (Nat.min (fld (Nat.shiftRight X 5) (Nat.add (Nat.sub (Nat.shiftLeft 1 (Nat.sub (Nat.succ l) 6)) 2) (Nat.mul 2 i)))
            (fld (Nat.shiftRight X 5) (Nat.add (Nat.sub (Nat.shiftLeft 1 (Nat.sub (Nat.succ l) 6)) 2) (Nat.succ (Nat.mul 2 i)))))))
    && Nat.ble (T.dense 6 j) (Nat.min (fld (Nat.shiftRight X 5) 0) (fld (Nat.shiftRight X 5) 1))

def blockOk (T : Table) (j : ℕ) : Bool := T.blockOkX (T.BK j) j

/-- The dense levels `0..5`, each entry below its two children. -/
def denseOk (T : Table) : Bool :=
  allBelow 6 fun l => allBelow (Nat.mul T.NU (Nat.shiftLeft 1 l)) fun g =>
    Nat.ble (T.dense l g) (Nat.min (T.dense (Nat.succ l) (Nat.mul 2 g)) (T.dense (Nat.succ l) (Nat.succ (Nat.mul 2 g))))


end Table

end Riemann.PCheck

end

/-! ###### module PCheckProof ###### -/

section

/-!
# Soundness of the pyramid table

`Table.lb_sound`: if the table's blocks and dense levels verify, its lower-bound oracle is sound.
Entries are certified on cells by the integer cell test, propagate to coarser cells as minima
over two children, and to finer cells by containment.
-/

namespace Riemann.PCheck

open Riemann.ICheck Zeta23Ext.Bridge Zeta23Ext.Bridge.ThreePoint

namespace Table

/-! ### Loops and forcing -/

lemma allBelow_spec {n : ℕ} {f : ℕ → Bool} (h : allBelow n f = true) : ∀ i < n, f i = true := by
  induction n with
  | zero => intro i hi; exact absurd hi (Nat.not_lt_zero _)
  | succ n ih =>
    intro i hi
    have h' : (allBelow n f && f n) = true := h
    rw [Bool.and_eq_true] at h'
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
    · exact ih h'.1 i hi
    · exact h'.2

lemma allFrom_spec {a n : ℕ} {f : ℕ → Bool} (h : allFrom a n f = true) :
    ∀ i < n, f (a + i) = true := by
  induction n with
  | zero => intro i hi; exact absurd hi (Nat.not_lt_zero _)
  | succ n ih =>
    intro i hi
    have h' : (allFrom a n f && f (Nat.add a n)) = true := h
    rw [Bool.and_eq_true] at h'
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
    · exact ih h'.1 i hi
    · exact h'.2

lemma allFrom_add (a n m : ℕ) (f : ℕ → Bool) :
    allFrom a (n + m) f = (allFrom a n f && allFrom (a + n) m f) := by
  induction m with
  | zero => show allFrom a n f = (allFrom a n f && true); rw [Bool.and_true]
  | succ m ih =>
    show (allFrom a (n + m) f && f (Nat.add a (n + m))) =
      (allFrom a n f && (allFrom (a + n) m f && f (Nat.add (a + n) m)))
    rw [ih, Bool.and_assoc, show Nat.add a (n + m) = Nat.add (a + n) m by
      show a + (n + m) = a + n + m; omega]

lemma forceB_eq (a : ℕ) (k : ℕ → Bool) : forceB a k = k a := by cases a <;> rfl

lemma force_eq (a : ℕ) (k : ℕ → ℕ) : force a k = k a := by cases a <;> rfl

/-! ### Cells -/

/-- `e / 10⁹` bounds `wfun` below on level-`l` cell `g`. -/
def CellSound (l g e : ℕ) : Prop :=
  ∀ x : ℝ, toR (cellLo l g) ≤ x → x ≤ toR (cellLo l (g + 1)) → (e : ℝ) / 1000000000 ≤ wfun x

lemma shl_eq (g s : ℕ) : Nat.shiftLeft g s = g * 2 ^ s := Nat.shiftLeft_eq g s

lemma shr_eq (g k : ℕ) : Nat.shiftRight g k = g / 2 ^ k := Nat.shiftRight_eq_div_pow g k

lemma cellLo_eq (l g : ℕ) : cellLo l g = A0 + g * 2 ^ (32 - l) := by
  unfold cellLo
  rw [Nat.add_eq, Nat.sub_eq, shl_eq]

lemma cellLo_succ (l g : ℕ) : cellLo l (g + 1) = cellLo l g + 2 ^ (32 - l) := by
  rw [cellLo_eq, cellLo_eq]; ring

lemma cellLo_mono {l g h : ℕ} (hgh : g ≤ h) : cellLo l g ≤ cellLo l h := by
  rw [cellLo_eq, cellLo_eq]
  exact Nat.add_le_add_left (Nat.mul_le_mul_right _ hgh) _

lemma cellLo_child (l g : ℕ) (hl : l < 32) : cellLo (l + 1) (2 * g) = cellLo l g := by
  rw [cellLo_eq, cellLo_eq]
  have : 32 - l = (32 - (l + 1)) + 1 := by omega
  rw [this, pow_succ]; ring

lemma cellLo_child' (l g : ℕ) (hl : l < 32) : cellLo (l + 1) (2 * g + 2) = cellLo l (g + 1) := by
  rw [show 2 * g + 2 = 2 * (g + 1) by ring, cellLo_child l (g + 1) hl]

lemma G_eq_Dg : (Riemann.CellI.G : ℝ) = Dg := by norm_num [Riemann.CellI.G, Dg]

/-- A certified finest cell. -/
lemma okLeaf_sound {l g e : ℕ} (h : okLeaf l g e = true) : CellSound l g e := by
  intro x h1 h2
  unfold okLeaf at h
  rw [forceB_eq, forceB_eq, forceB_eq] at h
  have hhi : Nat.add (cellLo l g) (Nat.shiftLeft 1 (Nat.sub 32 l)) = cellLo l (g + 1) := by
    rw [cellLo_succ, Nat.add_eq, Nat.sub_eq, shl_eq, one_mul]
  rw [hhi] at h
  have := Riemann.CellI.cellI_sound _ _ _ _ _ h x
    (by rw [G_eq_Dg]; exact h1) (by rw [G_eq_Dg]; exact h2)
  have e1 : ((Nat.mul e 10000 : ℕ) : ℝ) / Riemann.CellI.E = (e : ℝ) / 1000000000 := by
    simp only [Nat.mul_eq, Riemann.CellI.E]; push_cast; ring
  rw [e1] at this
  exact this

/-- A cell below both children's bounds. -/
lemma merge_sound {l g e e1 e2 : ℕ} (hl : l < 32) (h1 : CellSound (l + 1) (2 * g) e1)
    (h2 : CellSound (l + 1) (2 * g + 1) e2) (he : e ≤ min e1 e2) : CellSound l g e := by
  intro x hx1 hx2
  have hU : (0 : ℝ) < 1000000000 := by norm_num
  rcases le_total x (toR (cellLo (l + 1) (2 * g + 1))) with hm | hm
  · have := h1 x (by rw [cellLo_child l g hl]; exact hx1) hm
    have he' : (e : ℝ) ≤ e1 := by exact_mod_cast he.trans (min_le_left _ _)
    exact (div_le_div_of_nonneg_right he' hU.le).trans this
  · have := h2 x hm (by rw [show 2 * g + 1 + 1 = 2 * g + 2 by ring, cellLo_child' l g hl]; exact hx2)
    have he' : (e : ℝ) ≤ e2 := by exact_mod_cast he.trans (min_le_right _ _)
    exact (div_le_div_of_nonneg_right he' hU.le).trans this

/-- A finer cell inherits the bound of a containing coarser cell. -/
lemma contain_sound {l l' g e : ℕ} (hll : l' ≤ l) (hl : l ≤ 32)
    (h : CellSound l' (g >>> (l - l')) e) : CellSound l g e := by
  intro x hx1 hx2
  have hk : 32 - l' = (32 - l) + (l - l') := by omega
  have hlo : cellLo l' (g >>> (l - l')) ≤ cellLo l g := by
    rw [cellLo_eq, cellLo_eq, Nat.shiftRight_eq_div_pow, hk, pow_add]
    apply Nat.add_le_add_left
    calc g / 2 ^ (l - l') * (2 ^ (32 - l) * 2 ^ (l - l'))
        = g / 2 ^ (l - l') * 2 ^ (l - l') * 2 ^ (32 - l) := by ring
      _ ≤ g * 2 ^ (32 - l) := Nat.mul_le_mul_right _ (Nat.div_mul_le_self _ _)
  have hhi : cellLo l (g + 1) ≤ cellLo l' (g >>> (l - l') + 1) := by
    rw [cellLo_eq, cellLo_eq, Nat.shiftRight_eq_div_pow, hk, pow_add]
    apply Nat.add_le_add_left
    have : g + 1 ≤ (g / 2 ^ (l - l') + 1) * 2 ^ (l - l') := by
      have := Nat.lt_div_mul_add (a := g) (Nat.two_pow_pos (l - l'))
      linarith [Nat.div_add_mod g (2 ^ (l - l'))]
    calc (g + 1) * 2 ^ (32 - l) ≤ (g / 2 ^ (l - l') + 1) * 2 ^ (l - l') * 2 ^ (32 - l) :=
          Nat.mul_le_mul_right _ this
      _ = (g / 2 ^ (l - l') + 1) * (2 ^ (32 - l) * 2 ^ (l - l')) := by ring
  exact h x ((toR_le_toR.mpr hlo).trans hx1) (hx2.trans (toR_le_toR.mpr hhi))

/-! ### Blocks and dense levels -/

/-- Stored entry of a block constant `X` at level `l`, local cell `i`. -/
def blkv (X l i : ℕ) : ℕ := fld (Nat.shiftRight X 5) (Nat.add (Nat.sub (Nat.shiftLeft 1 (Nat.sub l 6)) 2) i)

lemma shl_one (k : ℕ) : Nat.shiftLeft 1 k = 2 ^ k := by rw [shl_eq, one_mul]

lemma land31_le (X : ℕ) : Nat.land X 31 ≤ 31 := Nat.and_le_right

lemma child_idx (j l i : ℕ) (hl : 6 ≤ l) :
    2 * ((j <<< (l - 6)) + i) = (j <<< (l + 1 - 6)) + 2 * i ∧
    2 * ((j <<< (l - 6)) + i) + 1 = (j <<< (l + 1 - 6)) + (2 * i + 1) := by
  rw [Nat.shiftLeft_eq, Nat.shiftLeft_eq, show l + 1 - 6 = (l - 6) + 1 by omega, pow_succ]
  constructor <;> ring

theorem block_sound (T : Table) (j : ℕ) (h : T.blockOk j = true) :
    CellSound 6 j (T.dense 6 j) ∧
      (7 ≤ Nat.land (T.BK j) 31 → ∀ l, 7 ≤ l → l ≤ Nat.land (T.BK j) 31 → ∀ i < 2 ^ (l - 6),
        CellSound l ((j <<< (l - 6)) + i) (blkv (T.BK j) l i)) := by
  set X := T.BK j with hX
  set r := Nat.land X 31 with hr
  unfold blockOk blockOkX at h
  rw [← hX] at h
  cases hb : Nat.ble (Nat.land X 31) 6
  · rw [hb, cond_false] at h
    rw [Bool.and_eq_true, Bool.and_eq_true] at h
    obtain ⟨⟨hfin, hmid⟩, hd⟩ := h
    have r7 : 7 ≤ r := by
      have : ¬ (Nat.land X 31 ≤ 6) := by rw [← Nat.ble_eq, hb]; exact Bool.false_ne_true
      omega
    have r31 : r ≤ 31 := land31_le X
    -- finest level
    have fin : ∀ i < 2 ^ (r - 6), CellSound r ((j <<< (r - 6)) + i) (blkv X r i) := by
      intro i hi
      have := allBelow_spec hfin i (by rw [shl_one]; exact hi)
      refine okLeaf_sound ?_
      rw [show (j <<< (r - 6)) + i = Nat.add (Nat.shiftLeft j (Nat.sub (Nat.land X 31) 6)) i from rfl]
      exact this
    -- coarser levels, downward
    have step : ∀ d, d ≤ r - 7 → ∀ i < 2 ^ (r - d - 6),
        CellSound (r - d) ((j <<< (r - d - 6)) + i) (blkv X (r - d) i) := by
      intro d
      induction d with
      | zero => intro _ i hi; simpa using fin i hi
      | succ d ih =>
        intro hd i hi
        set l := r - (d + 1) with hl
        have hl7 : 7 ≤ l := by omega
        have hl1 : r - d = l + 1 := by omega
        have hmid' := allFrom_spec hmid (l - 7) (by simp only [Nat.sub_eq]; omega)
        rw [show 7 + (l - 7) = l by omega] at hmid'
        have hle := allBelow_spec hmid' i (by rw [shl_one]; exact hi)
        rw [Nat.ble_eq] at hle
        have c1 := ih (by omega) (2 * i) (by rw [hl1, show l + 1 - 6 = (l - 6) + 1 by omega, pow_succ]; omega)
        have c2 := ih (by omega) (2 * i + 1) (by rw [hl1, show l + 1 - 6 = (l - 6) + 1 by omega, pow_succ]; omega)
        rw [hl1] at c1 c2
        obtain ⟨e1, e2⟩ := child_idx j l i (by omega)
        rw [← e1] at c1
        rw [← e2] at c2
        exact merge_sound (by omega) c1 c2 hle
    refine ⟨?_, fun _ l hl7 hlr i hi => ?_⟩
    · have c7 := step (r - 7) le_rfl
      rw [show r - (r - 7) = 7 by omega] at c7
      have c0 := c7 0 (by norm_num)
      have c1 := c7 1 (by norm_num)
      rw [show (j <<< (7 - 6)) + 0 = 2 * j by rw [Nat.shiftLeft_eq]; ring] at c0
      rw [show (j <<< (7 - 6)) + 1 = 2 * j + 1 by rw [Nat.shiftLeft_eq]; ring] at c1
      rw [Nat.ble_eq] at hd
      exact merge_sound (l := 6) (by norm_num) c0 c1 hd
    · have := step (r - l) (by omega) i (by rw [show r - (r - l) - 6 = l - 6 by omega]; exact hi)
      rwa [show r - (r - l) = l by omega] at this
  · rw [hb, cond_true] at h
    refine ⟨okLeaf_sound h, fun h7 => ?_⟩
    have : Nat.land X 31 ≤ 6 := by rw [← Nat.ble_eq]; exact hb
    omega

theorem dense_sound (T : Table) (hd : T.denseOk = true)
    (hb : ∀ j < T.NU * 64, T.blockOk j = true) :
    ∀ l ≤ 6, ∀ g < T.NU * 2 ^ l, CellSound l g (T.dense l g) := by
  have key : ∀ d ≤ 6, ∀ g < T.NU * 2 ^ (6 - d), CellSound (6 - d) g (T.dense (6 - d) g) := by
    intro d
    induction d with
    | zero => intro _ g hg; exact (block_sound T g (hb g (by simpa using hg))).1
    | succ d ih =>
      intro hd6 g hg
      set l := 6 - (d + 1) with hl
      have hl1 : 6 - d = l + 1 := by omega
      have hrow := allBelow_spec hd l (by omega)
      have hle := allBelow_spec hrow g (by rw [shl_one]; simpa [Nat.mul_eq] using hg)
      rw [Nat.ble_eq] at hle
      have e2 : T.NU * 2 ^ (l + 1) = 2 * (T.NU * 2 ^ l) := by ring
      have c1 := ih (by omega) (2 * g) (by rw [hl1, e2]; omega)
      have c2 := ih (by omega) (2 * g + 1) (by rw [hl1, e2]; omega)
      rw [hl1] at c1 c2
      exact merge_sound (by omega) c1 c2 hle
  intro l hl g hg
  have := key (6 - l) (by omega) g (by rwa [show 6 - (6 - l) = l by omega])
  rwa [show 6 - (6 - l) = l by omega] at this

/-! ### Entries and runs -/

lemma block_lt (T : Table) {l g : ℕ} (h6 : 6 ≤ l) (hg : g < T.NU * 2 ^ l) :
    g / 2 ^ (l - 6) < T.NU * 64 := by
  rw [Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _)]
  calc g < T.NU * 2 ^ l := hg
    _ = T.NU * 64 * 2 ^ (l - 6) := by
      rw [show l = 6 + (l - 6) by omega, pow_add]; norm_num; ring_nf

theorem fine_sound (T : Table) (hb : ∀ j < T.NU * 64, T.blockOk j = true)
    {l g : ℕ} (h7 : 7 ≤ l) (hl : l ≤ 32) (hg : g < T.NU * 2 ^ l) :
    CellSound l g (T.fineX (T.BK (Nat.shiftRight g (Nat.sub l 6))) l g (Nat.shiftRight g (Nat.sub l 6))) := by
  set j := Nat.shiftRight g (Nat.sub l 6) with hj
  have hjd : j = g / 2 ^ (l - 6) := by rw [hj, shr_eq, Nat.sub_eq]
  obtain ⟨h6, hfine⟩ := block_sound T j (hb j (hjd ▸ block_lt T (by omega) hg))
  unfold fineX
  set X := T.BK j with hX
  cases hr : Nat.ble (Nat.land X 31) 6
  · rw [cond_false]
    have r7 : 7 ≤ Nat.land X 31 := by
      have : ¬ (Nat.land X 31 ≤ 6) := by rw [← Nat.ble_eq, hr]; exact Bool.false_ne_true
      omega
    set l' := Nat.min l (Nat.land X 31) with hl'
    have hl'7 : 7 ≤ l' := by rw [hl']; exact le_min h7 r7
    have hl'l : l' ≤ l := Nat.min_le_left _ _
    have hl'r : l' ≤ Nat.land X 31 := Nat.min_le_right _ _
    set G' := g >>> (l - l') with hG'
    have hjG : j = G' >>> (l' - 6) := by
      rw [hjd, hG', ← Nat.shiftRight_add, show l - l' + (l' - 6) = l - 6 by omega,
        Nat.shiftRight_eq_div_pow]
    have hdm : (j <<< (l' - 6)) + (G' - (j <<< (l' - 6))) = G' ∧
        G' - (j <<< (l' - 6)) < 2 ^ (l' - 6) := by
      rw [hjG, Nat.shiftRight_eq_div_pow, Nat.shiftLeft_eq]
      have h1 := Nat.div_add_mod G' (2 ^ (l' - 6))
      have h2 := Nat.mod_lt G' (Nat.two_pow_pos (l' - 6))
      constructor
      · rw [mul_comm] at h1; omega
      · rw [mul_comm] at h1; omega
    have hc := hfine r7 l' hl'7 hl'r _ hdm.2
    rw [hdm.1] at hc
    have hval : fineAt X l' l g j = blkv X l' (G' - (j <<< (l' - 6))) := by
      unfold fineAt blkv
      rw [show Nat.sub (Nat.shiftRight g (Nat.sub l l')) (Nat.shiftLeft j (Nat.sub l' 6))
          = G' - (j <<< (l' - 6)) by rw [Nat.sub_eq, Nat.sub_eq, Nat.sub_eq, hG']; rfl]
    rw [hval]
    exact contain_sound hl'l hl hc
  · rw [cond_true]
    have e6 : g >>> (l - 6) = j := by rw [Nat.shiftRight_eq_div_pow, hjd]
    exact contain_sound (l' := 6) (by omega) hl (by rw [e6]; exact h6)

/-- A run of consecutive cells covers every point between its ends. -/
lemma run_cover (l : ℕ) (x : ℝ) : ∀ n g, toR (cellLo l g) ≤ x → x ≤ toR (cellLo l (g + n + 1)) →
    ∃ k ≤ n, toR (cellLo l (g + k)) ≤ x ∧ x ≤ toR (cellLo l (g + k + 1)) := by
  intro n
  induction n with
  | zero => intro g h1 h2; exact ⟨0, le_rfl, by simpa using h1, by simpa using h2⟩
  | succ n ih =>
    intro g h1 h2
    rcases le_total x (toR (cellLo l (g + 1))) with hx | hx
    · exact ⟨0, Nat.zero_le _, by simpa using h1, by simpa using hx⟩
    · obtain ⟨k, hk, hk1, hk2⟩ := ih (g + 1) hx (by rw [show g + 1 + n + 1 = g + (n + 1) + 1 by ring]; exact h2)
      exact ⟨k + 1, by omega, by rwa [show g + (k + 1) = g + 1 + k by ring],
        by rwa [show g + (k + 1) + 1 = g + 1 + k + 1 by ring]⟩

/-! ### The oracle -/


lemma bound_of {v e l c : ℕ} {x : ℝ} (hv : v ≤ e) (hc : CellSound l c e)
    (h1 : toR (cellLo l c) ≤ x) (h2 : x ≤ toR (cellLo l (c + 1))) :
    (v : ℝ) / ((1000000000 : ℕ) : ℝ) ≤ wfun x := by
  have := hc x h1 h2
  have hv' : (v : ℝ) ≤ e := by exact_mod_cast hv
  rw [Nat.cast_ofNat]
  exact (div_le_div_of_nonneg_right hv' (by norm_num)).trans this

lemma shr_between {a c b s j : ℕ} (hac : a ≤ c) (hcb : c ≤ b) (ha : a / 2 ^ s = j) (hb : b / 2 ^ s = j) :
    c / 2 ^ s = j :=
  le_antisymm (hb ▸ Nat.div_le_div_right hcb) (ha ▸ Nat.div_le_div_right hac)



lemma alignK_spec (l g ib : ℕ) : alignK l g ib ≤ l ∧ g % 2 ^ alignK l g ib = 0 := by
  unfold alignK
  have h15 : ∀ g : ℕ, Nat.land g 15 = g % 16 := fun g => by
    rw [show (15 : ℕ) = 2 ^ 4 - 1 by norm_num]; exact Nat.and_two_pow_sub_one_eq_mod g 4
  have h7 : ∀ g : ℕ, Nat.land g 7 = g % 8 := fun g => by
    rw [show (7 : ℕ) = 2 ^ 3 - 1 by norm_num]; exact Nat.and_two_pow_sub_one_eq_mod g 3
  have h3 : ∀ g : ℕ, Nat.land g 3 = g % 4 := fun g => by
    rw [show (3 : ℕ) = 2 ^ 2 - 1 by norm_num]; exact Nat.and_two_pow_sub_one_eq_mod g 2
  have h1 : ∀ g : ℕ, Nat.land g 1 = g % 2 := fun g => by
    rw [show (1 : ℕ) = 2 ^ 1 - 1 by norm_num]; exact Nat.and_two_pow_sub_one_eq_mod g 1
  cases e4 : (Nat.ble 4 l && Nat.beq (Nat.land g 15) 0 && Nat.ble (Nat.add g 16) (Nat.succ ib))
  · rw [cond_false]
    cases e3 : (Nat.ble 3 l && Nat.beq (Nat.land g 7) 0 && Nat.ble (Nat.add g 8) (Nat.succ ib))
    · rw [cond_false]
      cases e2 : (Nat.ble 2 l && Nat.beq (Nat.land g 3) 0 && Nat.ble (Nat.add g 4) (Nat.succ ib))
      · rw [cond_false]
        cases e1 : (Nat.ble 1 l && Nat.beq (Nat.land g 1) 0 && Nat.ble (Nat.add g 2) (Nat.succ ib))
        · rw [cond_false]; exact ⟨Nat.zero_le _, Nat.mod_one g⟩
        · rw [cond_true]
          simp only [Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq, h1] at e1
          exact ⟨e1.1.1, by simpa using e1.1.2⟩
      · rw [cond_true]
        simp only [Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq, h3] at e2
        exact ⟨e2.1.1, by simpa using e2.1.2⟩
    · rw [cond_true]
      simp only [Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq, h7] at e3
      exact ⟨e3.1.1, by simpa using e3.1.2⟩
  · rw [cond_true]
    simp only [Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq, h15] at e4
    exact ⟨e4.1.1, by simpa using e4.1.2⟩

/-- Every entry of the table is sound on its cell. -/
theorem entry_sound (T : Table) (hd : T.denseOk = true) (hb : ∀ j < T.NU * 64, T.blockOk j = true)
    {l g : ℕ} (hl : l ≤ 32) (hg : g < T.NU * 2 ^ l) : CellSound l g (T.entry l g) := by
  unfold entry
  cases h6 : Nat.ble l 6
  · rw [cond_false, force_eq]
    have h7 : 7 ≤ l := by
      have : ¬ (l ≤ 6) := by rw [← Nat.ble_eq, h6]; exact Bool.false_ne_true
      omega
    exact fine_sound T hb h7 hl hg
  · rw [cond_true]
    exact dense_sound T hd hb l (by rw [← Nat.ble_eq]; exact h6) g hg

/-- The dyadic cover's minimum bounds `wfun` on every level-`l` cell between `g` and `ib`. -/
theorem dcov_sound (T : Table) (hd : T.denseOk = true) (hb : ∀ j < T.NU * 64, T.blockOk j = true)
    {l ib : ℕ} (hl : l ≤ 32) (hib : ib < T.NU * 2 ^ l) {x : ℝ} :
    ∀ steps g c, g ≤ c → c ≤ ib → toR (cellLo l c) ≤ x → x ≤ toR (cellLo l (c + 1)) →
      ((T.dcov l ib steps g : ℕ) : ℝ) / ((1000000000 : ℕ) : ℝ) ≤ wfun x := by
  intro steps
  induction steps with
  | zero =>
    intro g c hgc hcb _ _
    show (((bif Nat.blt ib g then BIG else 0 : ℕ)) : ℝ) / _ ≤ _
    have : Nat.blt ib g = false := by
      rw [Bool.eq_false_iff, ne_eq, Nat.blt_eq]; omega
    rw [this, cond_false, Nat.cast_zero, zero_div]
    exact ThreePoint.wfun_nonneg x
  | succ n ih =>
    intro g c hgc hcb h1 h2
    have hne : Nat.blt ib g = false := by rw [Bool.eq_false_iff, ne_eq, Nat.blt_eq]; omega
    show (((bif Nat.blt ib g then BIG else force (alignK l g ib) fun k =>
        Nat.min (force (Nat.sub l k) fun l' => force (Nat.shiftRight g k) fun g' => T.entry l' g')
          (T.dcov l ib n (Nat.add g (Nat.shiftLeft 1 k))) : ℕ)) : ℝ) / _ ≤ _
    rw [hne, cond_false, force_eq, force_eq, force_eq]
    obtain ⟨hkl, hal⟩ := alignK_spec l g ib
    set k := alignK l g ib
    rw [shl_eq, one_mul, Nat.sub_eq]
    rcases lt_or_ge c (g + 2 ^ k) with hc | hc
    · -- `c` lies in the aligned block read as one coarse entry
      have hck : c >>> k = Nat.shiftRight g k := by
        rw [Nat.shiftRight_eq_div_pow, shr_eq]
        have hq : g = 2 ^ k * (g / 2 ^ k) := by
          have := Nat.div_add_mod g (2 ^ k); rw [hal] at this; omega
        obtain ⟨t, ht, rfl⟩ : ∃ t, t < 2 ^ k ∧ c = g + t := ⟨c - g, by omega, by omega⟩
        conv_lhs => rw [hq]
        rw [show 2 ^ k * (g / 2 ^ k) + t = t + 2 ^ k * (g / 2 ^ k) by ring,
          Nat.add_mul_div_left _ _ (Nat.two_pow_pos k), Nat.div_eq_of_lt ht, zero_add]
      have hdom : Nat.shiftRight g k < T.NU * 2 ^ (l - k) := by
        rw [← hck, Nat.shiftRight_eq_div_pow, Nat.div_lt_iff_lt_mul (Nat.two_pow_pos k),
          mul_assoc, ← pow_add, show l - k + k = l by omega]
        omega
      have hs := entry_sound T hd hb (by omega) hdom
      rw [← hck] at hs
      have hc' := contain_sound (l := l) (l' := l - k) (g := c) (by omega) hl
        (by rw [show l - (l - k) = k by omega]; exact hs)
      rw [hck] at hc'
      exact bound_of (Nat.min_le_left _ _) hc' h1 h2
    · have := ih (Nat.add g (2 ^ k)) c (by simp only [Nat.add_eq]; exact hc) hcb h1 h2
      exact (div_le_div_of_nonneg_right (by exact_mod_cast Nat.min_le_right _ _) (by norm_num)).trans this

theorem lbI_sound (T : Table) (hd : T.denseOk = true) (hb : ∀ j < T.NU * 64, T.blockOk j = true)
    {l ia ib c : ℕ} {x : ℝ} (hl : l ≤ 32) (h1 : toR (cellLo l c) ≤ x) (h2 : x ≤ toR (cellLo l (c + 1)))
    (hac : ia ≤ c) (hcb : c ≤ ib) (hdom : ib < T.NU * 2 ^ l) :
    ((T.lbI l ia ib : ℕ) : ℝ) / ((1000000000 : ℕ) : ℝ) ≤ wfun x := by
  unfold lbI
  cases hw : Nat.blt (Nat.add ia (Nat.shiftLeft 1 T.extra)) ib
  · rw [cond_false]; exact dcov_sound T hd hb hl hdom 12 ia c hac hcb h1 h2
  · rw [cond_true, Nat.cast_zero, zero_div]; exact ThreePoint.wfun_nonneg x

theorem lb_sound (T : Table) (hd : T.denseOk = true) (hb : ∀ j < T.NU * 64, T.blockOk j = true) :
    LBSound 1000000000 T.lb := by
  intro a b x ha hb'
  have triv : ((0 : ℕ) : ℝ) / ((1000000000 : ℕ) : ℝ) ≤ wfun x := by
    rw [Nat.cast_zero, zero_div]; exact ThreePoint.wfun_nonneg x
  unfold lb
  rw [force_eq, force_eq]
  unfold lb0
  cases h1 : (Nat.blt a A0 || Nat.ble T.top b || Nat.blt b a)
  swap
  · rw [cond_true]; exact triv
  rw [cond_false, force_eq]
  rw [Bool.or_eq_false_iff, Bool.or_eq_false_iff] at h1
  obtain ⟨⟨hA, hT⟩, hab⟩ := h1
  have hA' : A0 ≤ a := by
    have : ¬ a < A0 := by rw [← Nat.blt_eq, hA]; exact Bool.false_ne_true
    omega
  have hT' : b < T.top := by
    have : ¬ T.top ≤ b := by rw [← Nat.ble_eq, hT]; exact Bool.false_ne_true
    omega
  have hab' : a ≤ b := by
    have : ¬ b < a := by rw [← Nat.blt_eq, hab]; exact Bool.false_ne_true
    omega
  set l := Nat.min 32 (Nat.sub (Nat.add 32 T.extra) (bitLen (Nat.sub b a))) with hl
  have hl32 : l ≤ 32 := Nat.min_le_left _ _
  unfold lbL
  rw [force_eq, force_eq]
  set ia := Nat.shiftRight (Nat.sub a A0) (Nat.sub 32 l) with hia
  set ib := Nat.shiftRight (Nat.sub b A0) (Nat.sub 32 l) with hib
  have hs : (2 : ℕ) ^ (32 - l) > 0 := Nat.two_pow_pos _
  have hia' : ia = (a - A0) / 2 ^ (32 - l) := by rw [hia, shr_eq, Nat.sub_eq, Nat.sub_eq]
  have hib' : ib = (b - A0) / 2 ^ (32 - l) := by rw [hib, shr_eq, Nat.sub_eq, Nat.sub_eq]
  have hiab : ia ≤ ib := by rw [hia', hib']; exact Nat.div_le_div_right (by omega)
  -- the cells ia..ib cover [a, b]
  have hlo : toR (cellLo l ia) ≤ x := by
    refine le_trans (toR_le_toR.mpr ?_) ha
    rw [cellLo_eq, hia']
    have := Nat.div_mul_le_self (a - A0) (2 ^ (32 - l))
    omega
  have hhi : x ≤ toR (cellLo l (ia + (ib - ia) + 1)) := by
    refine le_trans hb' (toR_le_toR.mpr ?_)
    rw [show ia + (ib - ia) = ib by omega, cellLo_eq, hib']
    have := Nat.lt_div_mul_add (a := b - A0) hs
    rw [Nat.add_mul, one_mul]
    omega
  obtain ⟨k, hk, hk1, hk2⟩ := run_cover l x (ib - ia) ia hlo hhi
  have hdom : ib < T.NU * 2 ^ l := by
    rw [hib', Nat.div_lt_iff_lt_mul hs]
    have htop : T.top = A0 + T.NU * 4294967296 := by unfold top; rw [Nat.add_eq, Nat.mul_eq]
    rw [mul_assoc, ← pow_add, show l + (32 - l) = 32 by omega]
    norm_num
    omega
  exact lbI_sound T hd hb hl32 hk1 hk2 (by omega) (by omega) hdom

end Table

end Riemann.PCheck

end

/-! ###### module Assemble ###### -/

section

/-!
# Assembly

The five-point certificate from a verified pyramid table, and the facts about `HD 1` the
submission layer needs.
-/

noncomputable section

namespace Riemann.Assemble

open Riemann.ICheck Riemann.PCheck Zeta23Ext.Bridge Zeta23Ext.Bridge.ThreePoint

lemma allFrom_chain {a n m : ℕ} {f : ℕ → Bool} (h1 : Table.allFrom a n f = true)
    (h2 : Table.allFrom (a + n) m f = true) : Table.allFrom a (n + m) f = true := by
  rw [Table.allFrom_add, h1, h2]; rfl

lemma blocks_of {T : Table} {N : ℕ} (h : Table.allFrom 0 N T.blockOk = true)
    (hN : T.NU * 64 ≤ N) : ∀ j < T.NU * 64, T.blockOk j = true := by
  intro j hj
  have := Table.allFrom_spec h j (by omega)
  rwa [Nat.zero_add] at this

/-- The five-point certificate `c ≤ F 5 p` from a verified table, cover, and covered roots. -/
theorem five_cert (T : Table) (hd : T.denseOk = true) (hb : ∀ j < T.NU * 64, T.blockOk j = true)
    (cov : List (ℕ × ℕ × Bool)) (cn cd p SD : ℕ) (hcd : 0 < cd) (hp : 0 < p)
    (hS : cn * p * Dg ≤ cd * SD) (hwin : 200 * cn ≤ 19 * cd)
    (hcov : coverI T.lb (2 * cn * 1000000000) cd (Dg / 2) SD cov = true)
    (hroot : ∀ i j k l, i < (badOf cov).length → j < (badOf cov).length →
      k < (badOf cov).length → l < (badOf cov).length → Canon i j k l →
      Covered cn cd p (boxOf (badOf cov) i j k l)) :
    ∀ g : Fin (5 - 1) → ℝ, (∀ i, 0 ≤ g i) → ((cn : ℝ) / cd) ≤ F 5 p g := by
  intro g hg
  have h := five_point_icheck (U := 1000000000) (by norm_num) (T.lb_sound hd hb) cov cn cd p SD
    hcd hp hS hwin hcov hroot (g 0) (g 1) (g 2) (g 3) (hg 0) (hg 1) (hg 2) (hg 3)
  rw [F5_eq]
  unfold G5 at h
  push_cast at h ⊢
  linarith

/-- `(√2)⁻¹ = √2/2`. -/
theorem inv_sqrt_two : (Real.sqrt 2)⁻¹ = Real.sqrt 2 / 2 := by
  have hne : Real.sqrt 2 ≠ 0 := (Real.sqrt_pos.mpr (by norm_num)).ne'
  rw [inv_eq_one_div, div_eq_div_iff hne two_ne_zero, one_mul,
    Real.mul_self_sqrt (by norm_num : (0:ℝ) ≤ 2)]

theorem HD_one_eq_gam : Zeta23.ThmD.HD 1 = 3 / 2 - gam := by
  rw [Zeta23.ThmD.HD_one, inv_sqrt_two]
  unfold gam
  ring

/-- `H = HD 1` enclosed to `1.1·10⁻⁸`. -/
theorem HD_one_bounds :
    (6725006982 / 10000000000 : ℝ) ≤ Zeta23.ThmD.HD 1 ∧ Zeta23.ThmD.HD 1 ≤ 6725007093 / 10000000000 := by
  have hg := gam_bounds
  rw [HD_one_eq_gam]
  norm_num at hg ⊢
  constructor <;> linarith [hg.1, hg.2]

/-- Simple on-line zeros are among the distinct on-line zeros. -/
theorem N0simple_le_N0star (T₁ T₂ : ℝ) : Zeta23.N0simple T₁ T₂ ≤ Zeta23.N0star T₁ T₂ := by
  refine Set.ncard_le_ncard Set.inter_subset_left ?_
  refine (Zeta23.zetaSeam.finite_window T₁ T₂).subset ?_
  rintro ρ ⟨⟨h1, h2, h3⟩, _⟩
  exact ⟨h1, h2, h3⟩

end Riemann.Assemble

end

/-! ###### module WCheck ###### -/

section

/-!
# Weighted five-point checker

The weighted functional, scaled to integers:
`LW x y z u = Σ_r P_r·Dg·x_r + Σ_{i<j} W_ij·U·wfun(x_i + … + x_{j-1})`.
A leaf certifies `C ≤ LW` on a box from `C ≤ Σ P_r·lo_r + Σ W_ij·e_ij`, with `e_ij` read from a
sound lower-bound oracle in units of `1/U`. The walk is generic in the leaf test.
-/

noncomputable section

namespace Riemann.WCheck

open Riemann.ICheck Zeta23Ext.Bridge Zeta23Ext.Bridge.ThreePoint

/-- Pressures `P_r` and pair weights `W_ij` of the integer-scaled functional. -/
structure Wts where
  (p0 p1 p2 p3 w01 w12 w23 w34 w02 w13 w24 w03 w14 w04 : ℕ)

def LW (V : Wts) (U : ℕ) (x y z u : ℝ) : ℝ :=
  V.p0 * (Dg * x) + V.p1 * (Dg * y) + V.p2 * (Dg * z) + V.p3 * (Dg * u)
    + V.w01 * (U * wfun x) + V.w12 * (U * wfun y) + V.w23 * (U * wfun z) + V.w34 * (U * wfun u)
    + V.w02 * (U * wfun (x + y)) + V.w13 * (U * wfun (y + z)) + V.w24 * (U * wfun (z + u))
    + V.w03 * (U * wfun (x + y + z)) + V.w14 * (U * wfun (y + z + u))
    + V.w04 * (U * wfun (x + y + z + u))

/-! ### Generic walk -/

/-- Walk the bit-encoded tree (`1` = split, `0` = leaf) from bit `pos`, testing leaves with
`leaf`; the position after the subtree, or `0` on failure. -/
def walkG (leaf : B5 → Bool) (bits : ℕ) (fuel : ℕ) : ℕ → B5 → ℕ :=
  Nat.rec (motive := fun _ => ℕ → B5 → ℕ)
    (fun _ _ => 0)
    (fun _ ih pos b0 => forceB b0 fun b =>
      bif bits.testBit pos then
        (let p' := ih (pos + 1) b.lo
         bif p' == 0 then 0 else ih p' b.hi)
      else bif leaf b then pos + 1 else 0)
    fuel

lemma walkG_succ (leaf : B5 → Bool) (bits fuel pos : ℕ) (b : B5) :
    walkG leaf bits (fuel + 1) pos b =
      bif bits.testBit pos then
        (bif walkG leaf bits fuel (pos + 1) b.lo == 0 then 0
         else walkG leaf bits fuel (walkG leaf bits fuel (pos + 1) b.lo) b.hi)
      else bif leaf b then pos + 1 else 0 := by
  have h : walkG leaf bits (fuel + 1) pos b = forceB b (fun b =>
      bif bits.testBit pos then
        (bif walkG leaf bits fuel (pos + 1) b.lo == 0 then 0
         else walkG leaf bits fuel (walkG leaf bits fuel (pos + 1) b.lo) b.hi)
      else bif leaf b then pos + 1 else 0) := rfl
  rw [h, forceB_eq]

/-- A property certified at leaves and closed under splitting holds on any walked box. -/
theorem walkG_sound (leaf : B5 → Bool) (P : B5 → Prop) (hleaf : ∀ b, leaf b = true → P b)
    (hsplit : ∀ b, P b.lo → P b.hi → P b) (bits : ℕ) :
    ∀ fuel pos b, walkG leaf bits fuel pos b ≠ 0 → P b := by
  intro fuel
  induction fuel with
  | zero => intro pos b h; exact absurd rfl h
  | succ fuel ih =>
    intro pos b h
    rw [walkG_succ] at h
    cases hbit : bits.testBit pos
    · rw [hbit, cond_false] at h
      cases hl : leaf b
      · rw [hl, cond_false] at h; exact absurd rfl h
      · exact hleaf b hl
    · rw [hbit, cond_true] at h
      cases h0 : (walkG leaf bits fuel (pos + 1) b.lo == 0)
      · rw [h0, cond_false] at h
        have hlo : walkG leaf bits fuel (pos + 1) b.lo ≠ 0 := by simpa [beq_iff_eq] using h0
        exact hsplit b (ih _ _ hlo) (ih _ _ h)
      · rw [h0, cond_true] at h; exact absurd rfl h

/-! ### Leaves -/

/-- `C ≤ Σ P_r lo_r + Σ W_ij e_ij`, with an early exit after each group of terms. -/
def leafW (lb : ℕ → ℕ → ℕ) (V : Wts) (C : ℕ) (b : B5) : Bool :=
  let s0 := V.p0 * b.xl + V.p1 * b.yl + V.p2 * b.zl + V.p3 * b.ul
  let t4 := V.w04 * lb (b.xl + b.yl + b.zl + b.ul) (b.xu + b.yu + b.zu + b.uu)
  let t3 := V.w03 * lb (b.xl + b.yl + b.zl) (b.xu + b.yu + b.zu)
    + V.w14 * lb (b.yl + b.zl + b.ul) (b.yu + b.zu + b.uu)
  let t2 := V.w02 * lb (b.xl + b.yl) (b.xu + b.yu) + V.w13 * lb (b.yl + b.zl) (b.yu + b.zu)
    + V.w24 * lb (b.zl + b.ul) (b.zu + b.uu)
  let t1 := V.w01 * lb b.xl b.xu + V.w12 * lb b.yl b.yu + V.w23 * lb b.zl b.zu
    + V.w34 * lb b.ul b.uu
  Nat.ble C s0 || Nat.ble C (s0 + t4) || Nat.ble C (s0 + (t4 + t3))
    || Nat.ble C (s0 + (t4 + t3 + t2)) || Nat.ble C (s0 + (t4 + t3 + t2 + t1))

/-- The integer functional bounds `C` below on the box. -/
def CoveredW (V : Wts) (U C : ℕ) (b : B5) : Prop :=
  ∀ x y z u : ℝ, b.mem x y z u → (C : ℝ) ≤ LW V U x y z u

lemma lw_term {U : ℕ} (hU : 0 < U) {lb : ℕ → ℕ → ℕ} (hlb : LBSound U lb) (wt a b : ℕ) (s : ℝ)
    (ha : toR a ≤ s) (hb : s ≤ toR b) : ((wt * lb a b : ℕ) : ℝ) ≤ wt * (U * wfun s) := by
  have := hlb a b s ha hb
  have hU' : (0 : ℝ) < U := by exact_mod_cast hU
  rw [div_le_iff₀ hU'] at this
  push_cast
  exact mul_le_mul_of_nonneg_left (by linarith) (Nat.cast_nonneg _)

lemma lw_lin (wt a : ℕ) (s : ℝ) (ha : toR a ≤ s) : ((wt * a : ℕ) : ℝ) ≤ wt * (Dg * s) := by
  unfold toR at ha
  rw [div_le_iff₀ Dg_pos] at ha
  push_cast
  exact mul_le_mul_of_nonneg_left (by linarith) (Nat.cast_nonneg _)

theorem leafW_sound {U : ℕ} (hU : 0 < U) {lb : ℕ → ℕ → ℕ} (hlb : LBSound U lb) (V : Wts) (C : ℕ)
    (b : B5) (h : leafW lb V C b = true) : CoveredW V U C b := by
  intro x y z u hm
  obtain ⟨hx1, hx2, hy1, hy2, hz1, hz2, hu1, hu2⟩ := hm
  have hf : C ≤ V.p0 * b.xl + V.p1 * b.yl + V.p2 * b.zl + V.p3 * b.ul
      + (V.w04 * lb (b.xl + b.yl + b.zl + b.ul) (b.xu + b.yu + b.zu + b.uu)
        + (V.w03 * lb (b.xl + b.yl + b.zl) (b.xu + b.yu + b.zu)
          + V.w14 * lb (b.yl + b.zl + b.ul) (b.yu + b.zu + b.uu))
        + (V.w02 * lb (b.xl + b.yl) (b.xu + b.yu) + V.w13 * lb (b.yl + b.zl) (b.yu + b.zu)
          + V.w24 * lb (b.zl + b.ul) (b.zu + b.uu))
        + (V.w01 * lb b.xl b.xu + V.w12 * lb b.yl b.yu + V.w23 * lb b.zl b.zu
          + V.w34 * lb b.ul b.uu)) := by
    simp only [leafW, Bool.or_eq_true, Nat.ble_eq] at h
    rcases h with (((h | h) | h) | h) | h <;> omega
  have e1 := lw_term hU hlb V.w01 _ _ x hx1 hx2
  have e2 := lw_term hU hlb V.w12 _ _ y hy1 hy2
  have e3 := lw_term hU hlb V.w23 _ _ z hz1 hz2
  have e4 := lw_term hU hlb V.w34 _ _ u hu1 hu2
  have e5 := lw_term hU hlb V.w02 (b.xl + b.yl) (b.xu + b.yu) (x + y)
    (by rw [toR_add]; linarith) (by rw [toR_add]; linarith)
  have e6 := lw_term hU hlb V.w13 (b.yl + b.zl) (b.yu + b.zu) (y + z)
    (by rw [toR_add]; linarith) (by rw [toR_add]; linarith)
  have e7 := lw_term hU hlb V.w24 (b.zl + b.ul) (b.zu + b.uu) (z + u)
    (by rw [toR_add]; linarith) (by rw [toR_add]; linarith)
  have e8 := lw_term hU hlb V.w03 (b.xl + b.yl + b.zl) (b.xu + b.yu + b.zu) (x + y + z)
    (by rw [toR_add, toR_add]; linarith) (by rw [toR_add, toR_add]; linarith)
  have e9 := lw_term hU hlb V.w14 (b.yl + b.zl + b.ul) (b.yu + b.zu + b.uu) (y + z + u)
    (by rw [toR_add, toR_add]; linarith) (by rw [toR_add, toR_add]; linarith)
  have e10 := lw_term hU hlb V.w04 (b.xl + b.yl + b.zl + b.ul) (b.xu + b.yu + b.zu + b.uu)
    (x + y + z + u) (by rw [toR_add, toR_add, toR_add]; linarith)
    (by rw [toR_add, toR_add, toR_add]; linarith)
  have l1 := lw_lin V.p0 b.xl x hx1
  have l2 := lw_lin V.p1 b.yl y hy1
  have l3 := lw_lin V.p2 b.zl z hz1
  have l4 := lw_lin V.p3 b.ul u hu1
  have hf' : (C : ℝ) ≤ ((V.p0 * b.xl : ℕ) : ℝ) + ((V.p1 * b.yl : ℕ) : ℝ) + ((V.p2 * b.zl : ℕ) : ℝ)
      + ((V.p3 * b.ul : ℕ) : ℝ)
      + (((V.w04 * lb (b.xl + b.yl + b.zl + b.ul) (b.xu + b.yu + b.zu + b.uu) : ℕ) : ℝ)
        + (((V.w03 * lb (b.xl + b.yl + b.zl) (b.xu + b.yu + b.zu) : ℕ) : ℝ)
          + ((V.w14 * lb (b.yl + b.zl + b.ul) (b.yu + b.zu + b.uu) : ℕ) : ℝ))
        + (((V.w02 * lb (b.xl + b.yl) (b.xu + b.yu) : ℕ) : ℝ)
          + ((V.w13 * lb (b.yl + b.zl) (b.yu + b.zu) : ℕ) : ℝ)
          + ((V.w24 * lb (b.zl + b.ul) (b.zu + b.uu) : ℕ) : ℝ))
        + (((V.w01 * lb b.xl b.xu : ℕ) : ℝ) + ((V.w12 * lb b.yl b.yu : ℕ) : ℝ)
          + ((V.w23 * lb b.zl b.zu : ℕ) : ℝ) + ((V.w34 * lb b.ul b.uu : ℕ) : ℝ))) := by
    exact_mod_cast hf
  unfold LW
  linarith

theorem coveredW_split {V : Wts} {U C : ℕ} {b lo hi : B5} (hlo : b.lo = lo) (hhi : b.hi = hi)
    (h1 : CoveredW V U C lo) (h2 : CoveredW V U C hi) : CoveredW V U C b := by
  intro x y z u hm
  rcases mem_cut b x y z u hm with h | h
  · rw [hlo] at h; exact h1 x y z u h
  · rw [hhi] at h; exact h2 x y z u h

theorem coveredW_of_walk {U : ℕ} (hU : 0 < U) {lb : ℕ → ℕ → ℕ} (hlb : LBSound U lb) (V : Wts)
    (C bits fuel pos : ℕ) (b : B5) (h : walkG (leafW lb V C) bits fuel pos b ≠ 0) :
    CoveredW V U C b :=
  walkG_sound (leafW lb V C) (CoveredW V U C) (fun b hb => leafW_sound hU hlb V C b hb)
    (fun b h1 h2 => coveredW_split rfl rfl h1 h2) bits fuel pos b h

/-! ### The whole orthant -/

/-- Mirror-symmetric weights: `LW` is invariant under reversing the gaps. -/
structure Wts.Symm (V : Wts) : Prop where
  (p03 : V.p0 = V.p3) (p12 : V.p1 = V.p2) (w0134 : V.w01 = V.w34) (w1223 : V.w12 = V.w23)
  (w0224 : V.w02 = V.w24) (w0314 : V.w03 = V.w14)

lemma LW_mirror {V : Wts} (hV : V.Symm) (U : ℕ) (x y z u : ℝ) :
    LW V U x y z u = LW V U u z y x := by
  unfold LW
  rw [hV.p03, hV.p12, hV.w0134, hV.w1223, hV.w0224, hV.w0314,
    show u + z + y + x = x + y + z + u by ring, show u + z + y = y + z + u by ring,
    show z + y + x = x + y + z by ring, show u + z = z + u by ring, show z + y = y + z by ring,
    show y + x = x + y by ring]
  ring

/-- Clear segments: the smallest single-gap weight alone reaches `C`. -/
def coverW (lb : ℕ → ℕ → ℕ) (C Wm : ℕ) : ℕ → ℕ → List (ℕ × ℕ × Bool) → Bool
  | pos, SD, [] => Nat.ble SD pos
  | pos, SD, (a, b, cl) :: rest =>
      (a == pos) && Nat.ble a b && (!cl || Nat.ble C (Wm * lb a b)) && coverW lb C Wm b SD rest

theorem coverW_sound (lb : ℕ → ℕ → ℕ) (C Wm : ℕ) :
    ∀ (cov : List (ℕ × ℕ × Bool)) (pos SD : ℕ), coverW lb C Wm pos SD cov = true →
      ∀ v : ℝ, toR pos ≤ v → v < toR SD →
        ∃ s ∈ cov, toR s.1 ≤ v ∧ v ≤ toR s.2.1 ∧ (s.2.2 = true → C ≤ Wm * lb s.1 s.2.1) := by
  intro cov
  induction cov with
  | nil =>
    intro pos SD h v h1 h2
    simp only [coverW, Nat.ble_eq] at h
    exact absurd (h2.trans_le (toR_le_toR.mpr h)) (not_lt.mpr h1)
  | cons s rest ih =>
    obtain ⟨a, b, cl⟩ := s
    intro pos SD h v h1 h2
    simp only [coverW, Bool.and_eq_true, beq_iff_eq, Nat.ble_eq, Bool.or_eq_true,
      Bool.not_eq_true'] at h
    obtain ⟨⟨⟨ha, hab⟩, hcl⟩, hrest⟩ := h
    rcases le_total v (toR b) with hv | hv
    · refine ⟨(a, b, cl), List.mem_cons_self, ha ▸ h1, hv, fun hc => ?_⟩
      rcases hcl with hcl | hcl
      · rw [hcl] at hc; exact absurd hc Bool.false_ne_true
      · exact hcl
    · obtain ⟨s', hs', h'⟩ := ih b SD hrest v hv h2
      exact ⟨s', List.mem_cons_of_mem _ hs', h'⟩

theorem five_point_wcheck {U : ℕ} (hU : 0 < U) {lb : ℕ → ℕ → ℕ} (hlb : LBSound U lb) (V : Wts)
    (hV : V.Symm) (cov : List (ℕ × ℕ × Bool)) (C Wm Pm SD : ℕ)
    (hWm : Wm ≤ V.w01 ∧ Wm ≤ V.w12 ∧ Wm ≤ V.w23 ∧ Wm ≤ V.w34)
    (hPm : Pm ≤ V.p0 ∧ Pm ≤ V.p1 ∧ Pm ≤ V.p2 ∧ Pm ≤ V.p3)
    (hS : C ≤ Pm * SD) (hwin : 100 * C ≤ 19 * Wm * U)
    (hcov : coverW lb C Wm (Dg / 2) SD cov = true)
    (hroot : ∀ i j k l, i < (badOf cov).length → j < (badOf cov).length →
      k < (badOf cov).length → l < (badOf cov).length → Canon i j k l →
      CoveredW V U C (boxOf (badOf cov) i j k l)) :
    ∀ x y z u : ℝ, 0 ≤ x → 0 ≤ y → 0 ≤ z → 0 ≤ u → (C : ℝ) ≤ LW V U x y z u := by
  have hw := fun v : ℝ => ThreePoint.wfun_nonneg v
  have hU' : (0 : ℝ) < U := by exact_mod_cast hU
  have hDg := Dg_pos
  -- every term of `LW` is nonnegative on the orthant
  have hnn : ∀ x y z u : ℝ, 0 ≤ x → 0 ≤ y → 0 ≤ z → 0 ≤ u →
      0 ≤ (V.p0 : ℝ) * (Dg * x) ∧ 0 ≤ (V.p1 : ℝ) * (Dg * y) ∧ 0 ≤ (V.p2 : ℝ) * (Dg * z)
        ∧ 0 ≤ (V.p3 : ℝ) * (Dg * u) := by
    intro x y z u hx hy hz hu
    refine ⟨by positivity, by positivity, by positivity, by positivity⟩
  have hwt : ∀ (k : ℕ) (s : ℝ), 0 ≤ (k : ℝ) * (U * wfun s) := fun k s => by
    have := hw s; positivity
  -- large total gap: the pressure term alone reaches `C`
  have hsum : ∀ x y z u : ℝ, 0 ≤ x → 0 ≤ y → 0 ≤ z → 0 ≤ u → toR SD ≤ x + y + z + u →
      (C : ℝ) ≤ LW V U x y z u := by
    intro x y z u hx hy hz hu hs
    have hS' : (C : ℝ) ≤ Pm * SD := by exact_mod_cast hS
    unfold toR at hs
    rw [div_le_iff₀ Dg_pos] at hs
    have hp : (Pm : ℝ) * SD ≤ V.p0 * (Dg * x) + V.p1 * (Dg * y) + V.p2 * (Dg * z) + V.p3 * (Dg * u) := by
      have h0 : (Pm : ℝ) ≤ V.p0 := by exact_mod_cast hPm.1
      have h1 : (Pm : ℝ) ≤ V.p1 := by exact_mod_cast hPm.2.1
      have h2 : (Pm : ℝ) ≤ V.p2 := by exact_mod_cast hPm.2.2.1
      have h3 : (Pm : ℝ) ≤ V.p3 := by exact_mod_cast hPm.2.2.2
      have hPm0 : (0 : ℝ) ≤ Pm := Nat.cast_nonneg _
      nlinarith [mul_le_mul_of_nonneg_right h0 (mul_nonneg hDg.le hx),
        mul_le_mul_of_nonneg_right h1 (mul_nonneg hDg.le hy),
        mul_le_mul_of_nonneg_right h2 (mul_nonneg hDg.le hz),
        mul_le_mul_of_nonneg_right h3 (mul_nonneg hDg.le hu)]
    unfold LW
    linarith [hwt V.w01 x, hwt V.w12 y, hwt V.w23 z, hwt V.w34 u, hwt V.w02 (x + y),
      hwt V.w13 (y + z), hwt V.w24 (z + u), hwt V.w03 (x + y + z), hwt V.w14 (y + z + u),
      hwt V.w04 (x + y + z + u)]
  set bad := badOf cov with hbad
  -- one coordinate in a clear segment or the window: its single-gap term alone reaches `C`
  have key : ∀ v : ℝ, 0 ≤ v → v < toR SD →
      (C : ℝ) ≤ Wm * (U * wfun v) ∨ ∃ i, i < bad.length ∧
        toR (bad.getD i (0, 0)).1 ≤ v ∧ v ≤ toR (bad.getD i (0, 0)).2 := by
    intro v hv0 hvS
    rcases le_total v (1/2 : ℝ) with hv | hv
    · left
      have hwv := wfun_window v hv0 hv
      have hwin' : (100 * C : ℝ) ≤ 19 * Wm * U := by exact_mod_cast hwin
      have hWm0 : (0 : ℝ) ≤ Wm := Nat.cast_nonneg _
      nlinarith [mul_le_mul_of_nonneg_left hwv (mul_nonneg hWm0 hU'.le)]
    · have hpos : toR (Dg / 2) = 1 / 2 := by norm_num [toR, Dg]
      obtain ⟨s, hs, h1, h2, hc⟩ := coverW_sound lb C Wm cov _ SD hcov v (hpos ▸ hv) hvS
      cases he : s.2.2
      · right
        obtain ⟨i, hi, hsi⟩ := List.mem_iff_getElem.mp (badOf_mem hs he)
        refine ⟨i, hi, ?_, ?_⟩
        · rw [List.getD_eq_getElem _ _ hi, hsi]; exact h1
        · rw [List.getD_eq_getElem _ _ hi, hsi]; exact h2
      · left
        have hq : (C : ℝ) ≤ ((Wm * lb s.1 s.2.1 : ℕ) : ℝ) := by exact_mod_cast hc he
        exact hq.trans (lw_term hU hlb Wm s.1 s.2.1 v h1 h2)
  have hbox : ∀ i j k l, i < bad.length → j < bad.length → k < bad.length → l < bad.length →
      ∀ x y z u : ℝ, (boxOf bad i j k l).mem x y z u → (C : ℝ) ≤ LW V U x y z u := by
    intro i j k l hi hj hk hl x y z u hm
    by_cases hcan : Canon i j k l
    · exact hroot i j k l hi hj hk hl hcan x y z u hm
    · have hcan' : Canon l k j i := by
        unfold Canon at hcan ⊢; push Not at hcan; omega
      rw [LW_mirror hV]
      obtain ⟨hx1, hx2, hy1, hy2, hz1, hz2, hu1, hu2⟩ := hm
      exact hroot l k j i hl hk hj hi hcan' u z y x ⟨hu1, hu2, hz1, hz2, hy1, hy2, hx1, hx2⟩
  intro x y z u hx hy hz hu
  by_cases hs : toR SD ≤ x + y + z + u
  · exact hsum x y z u hx hy hz hu hs
  push Not at hs
  obtain ⟨h0, h1, h2, h3⟩ := hnn x y z u hx hy hz hu
  have hWm1 : ∀ s : ℝ, (Wm : ℝ) * (U * wfun s) ≤ V.w01 * (U * wfun s) := fun s =>
    mul_le_mul_of_nonneg_right (by exact_mod_cast hWm.1) (by have := hw s; positivity)
  have hWm2 : ∀ s : ℝ, (Wm : ℝ) * (U * wfun s) ≤ V.w12 * (U * wfun s) := fun s =>
    mul_le_mul_of_nonneg_right (by exact_mod_cast hWm.2.1) (by have := hw s; positivity)
  have hWm3 : ∀ s : ℝ, (Wm : ℝ) * (U * wfun s) ≤ V.w23 * (U * wfun s) := fun s =>
    mul_le_mul_of_nonneg_right (by exact_mod_cast hWm.2.2.1) (by have := hw s; positivity)
  have hWm4 : ∀ s : ℝ, (Wm : ℝ) * (U * wfun s) ≤ V.w34 * (U * wfun s) := fun s =>
    mul_le_mul_of_nonneg_right (by exact_mod_cast hWm.2.2.2) (by have := hw s; positivity)
  have rest := fun (s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 : ℝ) =>
    And.intro (hwt V.w01 s1) (And.intro (hwt V.w12 s2) (And.intro (hwt V.w23 s3)
      (And.intro (hwt V.w34 s4) (And.intro (hwt V.w02 s5) (And.intro (hwt V.w13 s6)
        (And.intro (hwt V.w24 s7) (And.intro (hwt V.w03 s8) (And.intro (hwt V.w14 s9)
          (hwt V.w04 s10)))))))))
  obtain ⟨r1, r2, r3, r4, r5, r6, r7, r8, r9, r10⟩ :=
    rest x y z u (x + y) (y + z) (z + u) (x + y + z) (y + z + u) (x + y + z + u)
  rcases key x hx (by linarith) with hc | ⟨i, hi, hi1, hi2⟩
  · unfold LW; linarith [hWm1 x]
  rcases key y hy (by linarith) with hc | ⟨j, hj, hj1, hj2⟩
  · unfold LW; linarith [hWm2 y]
  rcases key z hz (by linarith) with hc | ⟨k, hk, hk1, hk2⟩
  · unfold LW; linarith [hWm3 z]
  rcases key u hu (by linarith) with hc | ⟨l, hl, hl1, hl2⟩
  · unfold LW; linarith [hWm4 u]
  exact hbox i j k l hi hj hk hl x y z u ⟨hi1, hi2, hj1, hj2, hk1, hk2, hl1, hl2⟩

end Riemann.WCheck

end

/-! ###### module WAssemble ###### -/

section

/-!
# Weighted assembly

`Fw` of a five-point weight certificate written out, and the step from the integer-scaled
bound `C ≤ LW` on the orthant to the certificate `c ≤ Fw W` that `n_point_bound_w'` consumes.
-/

noncomputable section

namespace Riemann.WAssemble

open Riemann.ICheck Riemann.WCheck Zeta23Ext.Bridge Zeta23Ext.Bridge.ThreePoint Zeta23Ext.BridgeW

/-- The weighted five-point functional, written out. -/
lemma Fw_five (W : WCert 5) (g : Fin (5 - 1) → ℝ) :
    Fw W g = W.b 0 * g 0 + W.b 1 * g 1 + W.b 2 * g 2 + W.b 3 * g 3
      + W.a 0 1 * wfun (g 0) + W.a 1 2 * wfun (g 1) + W.a 2 3 * wfun (g 2) + W.a 3 4 * wfun (g 3)
      + W.a 0 2 * wfun (g 0 + g 1) + W.a 1 3 * wfun (g 1 + g 2) + W.a 2 4 * wfun (g 2 + g 3)
      + W.a 0 3 * wfun (g 0 + g 1 + g 2) + W.a 1 4 * wfun (g 1 + g 2 + g 3)
      + W.a 0 4 * wfun (g 0 + g 1 + g 2 + g 3) := by
  have s4 : ∀ f : Fin (5 - 1) → ℝ, ∑ i, f i = f 0 + f 1 + f 2 + f 3 := fun f => by
    show ∑ i : Fin 4, f i = f 0 + f 1 + f 2 + f 3
    exact Fin.sum_univ_four f
  simp only [Fw, ptsN, s4, Fin.sum_univ_five, Fin.isValue]
  norm_num
  ring_nf

/-- From `C ≤ LW V U` on the orthant to `C/K ≤ Fw W` when `LW V U = K · Fw W`. -/
theorem cert_of_LW (V : Wts) (U C K : ℕ) (hK : 0 < K) (W : WCert 5)
    (hLW : ∀ x y z u : ℝ, 0 ≤ x → 0 ≤ y → 0 ≤ z → 0 ≤ u → (C : ℝ) ≤ LW V U x y z u)
    (hrel : ∀ g : Fin (5 - 1) → ℝ, LW V U (g 0) (g 1) (g 2) (g 3) = K * Fw W g) :
    ∀ g : Fin (5 - 1) → ℝ, (∀ i, 0 ≤ g i) → ((C : ℝ) / K) ≤ Fw W g := by
  intro g hg
  have h := hLW (g 0) (g 1) (g 2) (g 3) (hg 0) (hg 1) (hg 2) (hg 3)
  rw [hrel] at h
  have hK' : (0 : ℝ) < K := by exact_mod_cast hK
  rw [div_le_iff₀ hK']
  linarith

end Riemann.WAssemble

end

